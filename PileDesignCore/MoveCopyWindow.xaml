<Window x:Class="PileDesignCore.MoveCopyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PileDesignCore"
        d:DataContext="{d:DesignInstance Type=local:MoveCopyViewModel}"
        mc:Ignorable="d"
        Title="MoveCopyWindow" Height="100" Width="310">
    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid>
        <StackPanel>
            <GroupBox Header="コピー/移動" HorizontalAlignment="Left" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="コピー" HorizontalAlignment="Left" Width="50" GroupName="Operation" IsChecked="{Binding IsCopySelected}"/>
                    <RadioButton Content="移動" HorizontalAlignment="Left" Width="50" GroupName="Operation" IsChecked="{Binding IsMoveSelected}"/>
                </StackPanel>
            </GroupBox>
            <StackPanel Orientation="Horizontal">
                
                <Label Content="dX" Width="50" HorizontalContentAlignment="Right"/>
                <TextBox Text="{Binding DX, StringFormat={}{0:+0.00;-0.00;±0.00}}" Width="50"/>
                <Label Content="dY" Width="50" HorizontalContentAlignment="Right"/>
                <TextBox Text="{Binding DY, StringFormat={}{0:+0.00;-0.00;±0.00}}" Width="50"/>
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsCopySelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Label Content="回数" Width="50" HorizontalContentAlignment="Right"/>
                    <TextBox x:Name="TextBoxRepetitionNumber" Text="{Binding RepetitionNumber}" Width="50" TextChanged="TextBoxRepetitionNumber_TextChanged"/>                    
                </StackPanel>

            </StackPanel>
            <StackPanel Orientation="Horizontal"  HorizontalAlignment="Right">

                <Button Content="Ok" Width="60" Click="OkButton_Click"/>
                <Button Content="Cancel" Width="60" Click="CancelButton_Click"/>

            </StackPanel>
        </StackPanel>


    </Grid>
</Window>
