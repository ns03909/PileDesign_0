<Window x:Class="PileDesignCore.FundamentalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PileDesignCore"
        mc:Ignorable="d"
        Title="FundamentalWindow" Height="400" Width="850">
    <Grid Margin="20,20,20,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <StackPanel Orientation="Horizontal">
                <Label Content="基準標高" HorizontalAlignment="Left" Height="30" VerticalAlignment="Top" Width="100" HorizontalContentAlignment="Right"/>
                <TextBox x:Name="textBoxRefLevel" HorizontalAlignment="Left" Height="30" 
                    TextWrapping="Wrap" VerticalAlignment="Top" Width="100">
                    <TextBox.Text>
                        <Binding Path="RefLevel" UpdateSourceTrigger="PropertyChanged">
                            <Binding.ValidationRules>
                                <local:StringMaxLengthValidationRule MaxLength="3" />
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                    <TextBox.ToolTip>
                        <ToolTip>
                            <TextBlock>
                                <Run>3文字まで</Run>
                            </TextBlock>
                        </ToolTip>
                    </TextBox.ToolTip>
                </TextBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="荷重組合せ係数" HorizontalAlignment="Left" Height="30"  VerticalAlignment="Top" Width="100" HorizontalContentAlignment="Right"/>
                <TextBox x:Name="TextBoxLoadCombinationFactor" HorizontalAlignment="Left" Height="30" 
                         TextWrapping="Wrap" VerticalAlignment="Top" Width="100" TextInput="TextBoxLoadCombinationFactor_TextInput" TextChanged="TextBoxLoadCombinationFactor_TextChanged">
                    <TextBox.Text>
                        <Binding Path="LoadCombinationFactor" UpdateSourceTrigger="PropertyChanged" StringFormat='{}{0:#.##}'>
                            <Binding.ValidationRules>
                                <local:FactorValidationRule />
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                    <TextBox.ToolTip>
                        <ToolTip>
                            <TextBlock>
                            <Run>0.5から1.0までの数値を入力</Run><LineBreak/>
                            <Run>Tb/Tg＜1：1.0</Run><LineBreak/>
                            <Run>Tb/Tg≒1：0.5～1.0</Run><LineBreak/>
                            <Run>1＜Tb/Tg：0.5</Run>
                            </TextBlock>
                        </ToolTip>
                    </TextBox.ToolTip>
                </TextBox>
            </StackPanel>

            <DataGrid x:Name="DataGridLoadCombination" Height="100" Loaded="DataGrid_Loaded" AutoGenerateColumns="False"
                        CanUserAddRows="False" Width="300" ColumnWidth="100" HorizontalContentAlignment="Stretch"
                        ItemsSource="{Binding LoadCombinations}">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="α1" Binding="{Binding Alpha1}" IsReadOnly="True" Foreground="Gray" Width="*"/>
                    <DataGridTextColumn Header="β1" Binding="{Binding Beta1}" IsReadOnly="True" Foreground="Gray" Width="*"/>
                    <DataGridTextColumn Header="β2" Binding="{Binding Beta2}" IsReadOnly="True" Foreground="Gray" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <Label Content="α1：杭曲げモーメント最大時の地盤変位／地盤変位の最大値"
                    HorizontalAlignment="Left" Height="30"/>
            <Label Content="β1：杭曲げモーメント最大時の上部構造慣性力／上部構造慣性力の最大値"
                    HorizontalAlignment="Left" Height="30"/>
            <Label Content="β2：杭曲げモーメント最大時の基礎部慣性力／基礎部慣性力の最大値"
                    HorizontalAlignment="Left" Height="30"/>
        </StackPanel>

        <Canvas x:Name="CanvasLoadCombination"  Grid.Column="1" HorizontalAlignment="Center" />

        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal">
            <Button x:Name="ButtonOk" Content="Ok" HorizontalAlignment="Left"  VerticalAlignment="Top" Height="30" Width="100" Click="ButtonOK_Click"/>
            <Button x:Name="ButtonCancel" Content="Cancel" HorizontalAlignment="Left"  VerticalAlignment="Top" Height="30" Width="100" Click="ButtonCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
