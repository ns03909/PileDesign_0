<Window x:Class="PileDesignCore.AxialForceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PileDesignCore"
        mc:Ignorable="d"
        Title="軸力編集" Height="200" Width="300">
    <Grid>
        <StackPanel>
            <GroupBox Header="編集モード">
                <StackPanel>
                    <RadioButton Content="差し替え（一定値）" IsChecked="{Binding IsReplaceValueMode}" />
                    <RadioButton Content="加算（一定値）" IsChecked="{Binding IsAddValueMode}" />
                </StackPanel>
            </GroupBox>
            <ComboBox x:Name="ComboBoxAllLoadCases" Width="100" HorizontalAlignment="Left"
                ItemsSource="{Binding LoadCases}" SelectedItem="{Binding SelectedLoadCase}">
            </ComboBox>
            <StackPanel Orientation="Horizontal">
                <TextBox Text="{Binding AxialForce}" Width="100" />
                <Label Content="kN" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Ok" Width="60" Click="OkButton_Click" />
                <Button Content="Cancel" Width="60" Click="CancelButton_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
