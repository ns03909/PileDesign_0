<Window x:Class="PileDesignCore.EmbedmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        
        mc:Ignorable="d"
        Title="EmbedmentWindow" Height="450" Width="800">
    <!--xmlns:local="clr-namespace:PileDesignCore" d:DataContext="{d:DesignInstance Type=local:EmbedmentViewModel}"-->
    <Grid>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="地盤符号" HorizontalAlignment="Left" Height="25" VerticalAlignment="Top" Width="100"/>
                <ComboBox x:Name="ComboBoxEmbedmentGroundReference" HorizontalAlignment="Left" Height="25" VerticalAlignment="Top" Width="100"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="上端標高(m)" HorizontalAlignment="Left" Height="25" VerticalAlignment="Top" Width="100"/>
                <!--<TextBox Text="{Binding DataContextFundamental.RefLevel}" Height="25" Width="50" TextChanged="TextBox_TextChanged" HorizontalAlignment="Left"/>-->
                <TextBox Text="{Binding DataContextFundamental.RefLevel}" Height="25" Width="50" HorizontalAlignment="Left"/>
                <TextBox x:Name="TextBoxTopAltitude" HorizontalAlignment="Left" Height="25" VerticalAlignment="Top" Width="50" >
                    <Binding Path="TopAltitude" UpdateSourceTrigger="PropertyChanged" StringFormat="{}{0:+0.00;-0.00;±0.00}"/>
                </TextBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="区分数" HorizontalAlignment="Left" Height="25"  VerticalAlignment="Top" Width="100"/>
                <ComboBox x:Name="ComboBoxEmbedmentNums" HorizontalAlignment="Left" Height="25" VerticalAlignment="Top" Width="100" SelectionChanged="ComboBoxEmbedmentNums_SelectionChanged" >
                    <ComboBoxItem Content="0"/>
                    <ComboBoxItem Content="1"/>
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="3"/>
                    <ComboBoxItem Content="4"/>
                    <ComboBoxItem Content="5"/>
                </ComboBox>
            </StackPanel>
        
            <DataGrid x:Name="DataGridEmbedment" ItemsSource="{Binding EmbedmentCollection}" HorizontalAlignment="Left" VerticalAlignment="Top" Width="608"
                      Loaded="DataGrid_Loaded" AutoGenerateColumns="False" CanUserAddRows="False" >
                <DataGrid.Columns>
                    <DataGridTextColumn Header="区分番号" Binding="{Binding No}" Width="*"/>
                    <DataGridTextColumn Header="厚さ" Binding="{Binding LayerThickness, StringFormat={}{0:0.000}}"  Width="*"/>
                    <DataGridTextColumn Header="上端標高" Binding="{Binding TopAltitude, StringFormat={}{0:+0.00;-0.00;±0.00}}" IsReadOnly="True"  Width="*"/>
                    <DataGridTextColumn Header="下端標高" Binding="{Binding BottomAltitude, StringFormat={}{0:+0.00;-0.00;±0.00}}" IsReadOnly="True"   Width="*" />
                    <DataGridTextColumn Header="X1(m)" Binding="{Binding X1, StringFormat={}{0:0.000}}"  Width="*"/>
                    <DataGridTextColumn Header="X2(m)" Binding="{Binding X2, StringFormat={}{0:0.000}}"  Width="*"/>
                    <DataGridTemplateColumn Header="dX(m)" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DX, StringFormat={}{0:0.000}}" Background="Gray" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <!-- Use a TextBox for editing, set IsReadOnly to true, and set the background color to gray -->
                                <TextBox Text="{Binding DX, StringFormat={}{0:+0.000}}" IsReadOnly="True" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Y1(m)" Binding="{Binding Y1, StringFormat={}{0:0.000}}"  Width="*"/>
                    <DataGridTextColumn Header="Y2(m)" Binding="{Binding Y2, StringFormat={}{0:0.000}}"  Width="*"/>
                    <DataGridTemplateColumn Header="dY(m)" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DY, StringFormat={}{0:0.000}}" Background="Gray" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <!-- Use a TextBox for editing, set IsReadOnly to true, and set the background color to gray -->
                                <TextBox Text="{Binding DY, StringFormat={}{0:0.000}}" IsReadOnly="True"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <!--<DataGridTextColumn Header="dY(m)" Binding="{Binding DY, StringFormat={}{0:#.##}}" />-->
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ButtonOk" Content="OK" Height="30" VerticalAlignment="Top" Width="100" Click="ButtonOk_Click"/>
                <Button x:Name="ButtonCancel" Content="Cancel" Height="30" VerticalAlignment="Top" Width="100" Click="ButtonCancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
