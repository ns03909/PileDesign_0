<Window x:Class="PileDesignCore.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PileDesignCore"
        xmlns:h="clr-namespace:HelixToolkit.Wpf;assembly=HelixToolkit.Wpf"
        xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:linq="clr-namespace:System.Linq;assembly=System.Core"
        mc:Ignorable="d"
        Title="杭検討プログラム α-0.0" Height="800" Width="1200" WindowState="Maximized"
        >

    <Window.Resources>
        <local:PileTopAltitudeConverter x:Key="PileTopAltitudeConverterInstance" />
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <ContextMenu x:Key="NodeContextMenu">
            <MenuItem Header="コピー／移動" Click="MoveCopyMenuItem_Click"/>
            <MenuItem Header="プロパティ変更／追加" Click="EditPileMenuItem_Click"/>
            <!--<MenuItem Header="杭頭レベル" Click="PileTopLevelMenuItem_Click"/>
            <MenuItem Header="杭符号" Click="PileReferenceMenuItem_Click"/>
            <MenuItem Header="地盤符号" Click="GroundReferenceMenuItem_Click"/>
            <MenuItem Header="群杭係数" Click="PileGroupFactorMenuItem_Click"/>
            <MenuItem Header="削除" Click="DeleteMenuItem_Click"/>
            <MenuItem Header="杭軸力" Click="AxialForceItem_Click"/>
            <MenuItem Header="前/後方杭" Click="IsFrontPileItem_Click"/>-->
            <MenuItem Header="選択解除" Click="SelectionCancelMenuItem_Click"/>
        </ContextMenu>

        <!-- 共通のスタイルを定義 -->
        <Style x:Key="RightAlignedTextBlockStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <Style x:Key="RightAlignedDataCellStyle" TargetType="DataGridCell">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <!-- Style for ComboBox elements to right-align text -->
        <Style x:Key="RightAlignedComboBoxStyle" TargetType="ComboBox">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <!-- Style for ComboBox items to right-align text -->
        <Style x:Key="RightAlignedComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <x:Array x:Key="ItemsSourceList" Type="{x:Type sys:Int32}">
        </x:Array>

    </Window.Resources>

    <!--<Window.DataContext>
        <local:ApplicationViewModel/>
    </Window.DataContext>-->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <!--<RowDefinition Height="*"/>-->
        </Grid.RowDefinitions>

        <StackPanel Orientation="Vertical"  Grid.Row="0" Margin="0,0,0,0" Grid.RowSpan="1">

            <Menu Margin="0,0,0,5">
                <MenuItem Header="ファイル">
                    <MenuItem Header="開く" Click="OnOpenClick"/>
                    <MenuItem Header="保存" Click="OnSaveClick"/>
                    <MenuItem Header="Wordファイル出力" Click="OnSaveWordFileClick"/>
                    <!--<MenuItem Header="雛形"/>-->
                </MenuItem>
                <MenuItem Header="編集"/>
                <MenuItem Header="ヘルプ" Click="OnHelpClick">
                </MenuItem>
            </Menu>

            <StackPanel Orientation="Horizontal">
                <Button x:Name="ButtonFundamental" Content="基本事項" Width="70" Margin="10,0,0,0" Click="ButtonFundamental_Click"/>
                <Button x:Name="ButtonLoadCase" Content="荷重条件" Width="70" Margin="10,0,0,0" Click="ButtonLoadCase_Click"/>
                <Button x:Name="ButtonGround" Content="地盤" Width="70" Margin="10,0,0,0" Click="ButtonGround_Click"/>
                <Button x:Name="ButtonPileBody" Content="杭体" Width="70" Margin="10,0,0,0" Click="ButtonPileBody_Click"/>
                <!--<Button x:Name="ButtonPileLayout" Content="杭配置・軸力" Width="103" Margin="10,0,0,0" Click="ButtonPileLayout_Click"/>
                <Button x:Name="ButtonEmbedment" Content="根入れ" Width="100" Margin="10,0,0,0" Click="ButtonEmbedment_Click"/>-->
            </StackPanel>
        </StackPanel>

        <avalonDock:DockingManager x:Name="dockingManager" Grid.Row="1" Grid.RowSpan="2">
            <avalonDock:LayoutRoot>
                <avalonDock:LayoutPanel Orientation="Horizontal">
                    <avalonDock:LayoutAnchorablePane DockWidth="150">
                        <avalonDock:LayoutAnchorable Title="ツリーメニュー" CanClose="False" CanHide="False">
                            <TreeView Name ="treeView" >
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <TextBlock Text="{Binding Name}" />
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </avalonDock:LayoutAnchorable>
                    </avalonDock:LayoutAnchorablePane>
                    <avalonDock:LayoutDocumentPaneGroup>
                        <avalonDock:LayoutDocumentPane >
                            <avalonDock:LayoutDocument Title="杭配置" CanClose="False" x:Name="PileLayoutDocument">
                                <StackPanel>
                                    <ToolBar>
                                        <Button x:Name="ButtonAddPile" Content="杭配置追加" VerticalAlignment="Top" Click="ButtonAddPile_Click"/>
                                    </ToolBar>

                                    <DataGrid x:Name="DataGridPileLayout" ItemsSource="{Binding PileLayoutViewModel.PileLayoutCollection, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedItem="{Binding PileLayoutViewModel.SelectedItem, Mode=TwoWay}"
                                        AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False" Height ="400" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                        LoadingRow="DataGridPileLayout_LoadingRow"
                                        CellEditEnding="DataGridPileLayout_CellEditEnding"
                                        MouseRightButtonDown="DataGridPileLayout_MouseRightButtonDown">
                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                <Setter Property="Foreground" Value="#62B0E2" />
                                            </Style>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Binding="{Binding PileNumber}" ElementStyle="{StaticResource RightAlignedTextBlockStyle}">
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="配置" TextAlignment="Center"/>
                                                        <TextBlock Text="番号" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Width="*" Binding="{Binding X, StringFormat=N3}" ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50">
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="X" TextAlignment="Center"/>
                                                        <TextBlock Text="(m)" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Width="*" Binding="{Binding Y, StringFormat=N3}" ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50">
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="Y" TextAlignment="Center"/>
                                                        <TextBlock Text="(m)" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Binding="{Binding PileTopAltitude, Converter={StaticResource PileTopAltitudeConverterInstance}, StringFormat={}{0:+0.00;-0.00;±0.00}}" Width="*"
                                                                ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50">
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="杭頭" TextAlignment="Center"/>
                                                        <TextBlock Text="レベル" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="{Binding FundamentalViewModel.RefLevel, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" TextAlignment="Center"/>
                                                        <TextBlock Text="(m)" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <DataGridComboBoxColumn Width="*" x:Name="ColumnPileBodyNo" SelectedItemBinding="{Binding PileBodyNo}"
                                                                    ItemsSource="{Binding Source={StaticResource ItemsSourceList}}"
                                                                    MinWidth="50"
                                                                    ElementStyle="{StaticResource RightAlignedComboBoxStyle}"
                                                                    EditingElementStyle="{StaticResource RightAlignedComboBoxStyle}">
                                                <DataGridComboBoxColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="杭" TextAlignment="Center"/>
                                                        <TextBlock Text="番号" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridComboBoxColumn.Header>
                                            </DataGridComboBoxColumn>

                                            <DataGridComboBoxColumn Width="*" x:Name="ColumnGroundNo" SelectedItemBinding="{Binding GroundNo}"
                                                                    ItemsSource="{Binding Source={StaticResource ItemsSourceList}}"
                                                                    MinWidth="50"
                                                                    ElementStyle="{StaticResource RightAlignedComboBoxStyle}"
                                                                    EditingElementStyle="{StaticResource RightAlignedComboBoxStyle}">
                                                <DataGridComboBoxColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="地盤" TextAlignment="Center"/>
                                                        <TextBlock Text="番号" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridComboBoxColumn.Header>
                                            </DataGridComboBoxColumn>

                                            <DataGridTextColumn Binding="{Binding GroupPileFactor, StringFormat=N3}" Width="*"  MinWidth="50">
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="群杭" TextAlignment="Center"/>
                                                        <TextBlock Text="係数" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridTextColumn.Header>
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                        <Setter Property="TextAlignment" Value="Right"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Binding="{Binding DistanceFactor, StringFormat=N3}" Width="*"
                                                                ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50">
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="杭間隔" TextAlignment="Center"/>
                                                        <TextBlock Text="比" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <DataGridTemplateColumn Width="*" Header="削除" MinWidth="50">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button
                                                            x:Name="ButtonPileLayoutDelete"
                                                            Click="ButtonPileLayoutDelete_Click"
                                                            Content="削除"
                                                            Tag="{Binding}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </avalonDock:LayoutDocument>

                            <avalonDock:LayoutDocument Title="杭軸力" CanClose="False" x:Name="PileAxialForceDocument">
                                <StackPanel>
                                    <ToolBar>
                                        <Border BorderBrush="Gray" BorderThickness="0.5" Padding="2" Margin="2">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="レベル1地震変動軸力"></TextBlock>
                                                <RadioButton x:Name="RadioButtonIsElastic" GroupName="GroupIsElastic" Content="線形" IsChecked="true"
                                                    Checked="RadioButtonIsElastic_Checked" Unchecked="RadioButtonIsElastic_Checked"/>
                                                <RadioButton GroupName="GroupIsElastic" Content="非線形"/>

                                            </StackPanel>
                                        </Border>
                                        <Separator/>

                                        <Button x:Name="ButtonEInput" Content="転倒モーメント簡易入力"/>
                                    </ToolBar>


                                    <DataGrid x:Name="DataGridPileAxialForce" ItemsSource="{Binding PileLayoutViewModel.PileLayoutCollection, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedItem="{Binding PileLayoutViewModel.SelectedItem, Mode=TwoWay}" 
                                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False" Height ="400"
                                          CellEditEnding="DataGridPileAxialForce_CellEditEnding"
                                          MouseRightButtonDown="DataGridPileLayout_MouseRightButtonDown"
                                          AutoGeneratingColumn="DataGridPileLayout_AutoGeneratingColumn">
                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                <Setter Property="Foreground" Value="#62B0E2" />
                                            </Style>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Binding="{Binding PileNumber}" IsReadOnly="True" Foreground="Gray" MinWidth="50">
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="配置" TextAlignment="Center"/>
                                                        <TextBlock Text="番号" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Width="*" IsReadOnly="True" Binding="{Binding X, StringFormat=N3}"
                                                                ElementStyle="{StaticResource RightAlignedTextBlockStyle}" Foreground="Gray" MinWidth="50">
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="X" TextAlignment="Center"/>
                                                        <TextBlock Text="(m)" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn  Width="*" IsReadOnly="True" Binding="{Binding Y, StringFormat=N3}"
                                                                 ElementStyle="{StaticResource RightAlignedTextBlockStyle}" Foreground="Gray" MinWidth="50">
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="Y" TextAlignment="Center"/>
                                                        <TextBlock Text="(m)" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Width="*" Binding="{Binding AxialForceVL, StringFormat=N1}"
                                                                ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50">
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="VL" TextAlignment="Center"/>
                                                        <TextBlock Text="(kN)" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Binding="{Binding AxialForceVLAdditional, StringFormat=N1}"
                                                                ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50">
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="VLadd" TextAlignment="Center"/>
                                                        <TextBlock Text="(kN)" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Width="*" Binding="{Binding AxialForceEX, StringFormat=N1}"
                                                                ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50">
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="EX" TextAlignment="Center"/>
                                                        <TextBlock Text="(kN)" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Width="*" Binding="{Binding AxialForceEY, StringFormat=N1}"
                                                                ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50">
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="EY" TextAlignment="Center"/>
                                                        <TextBlock Text="(kN)" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Width="*" Binding="{Binding AxialForceLevel1s[0], StringFormat=N1}"
                                                                ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50">
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="1-1" TextAlignment="Center"/>
                                                        <TextBlock Text="(kN)" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Width="*" Binding="{Binding AxialForceLevel1s[1], StringFormat=N1}"
                                                                ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50">
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="1-2" TextAlignment="Center"/>
                                                        <TextBlock Text="(kN)" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Width="*" Binding="{Binding AxialForceLevel1s[2], StringFormat=N1}"
                                                                ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50">
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="1-3" TextAlignment="Center"/>
                                                        <TextBlock Text="(kN)" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Width="*" Binding="{Binding AxialForceLevel1s[3], StringFormat=N1}"
                                                                ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50">
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="1-4" TextAlignment="Center"/>
                                                        <TextBlock Text="(kN)" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Width="*" Binding="{Binding AxialForceLevel2s[0], StringFormat=N1}"
                                                                ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50">
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="2-1" TextAlignment="Center"/>
                                                        <TextBlock Text="(kN)" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Width="*" Binding="{Binding AxialForceLevel2s[1], StringFormat=N1}"
                                                                ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50">
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="2-2" TextAlignment="Center"/>
                                                        <TextBlock Text="(kN)" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Width="*" Binding="{Binding AxialForceLevel2s[2], StringFormat=N1}"
                                                                ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50">
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="2-3" TextAlignment="Center"/>
                                                        <TextBlock Text="(kN)" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Width="*" Binding="{Binding AxialForceLevel2s[3], StringFormat=N1}"
                                                                ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50">
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="2-4" TextAlignment="Center"/>
                                                        <TextBlock Text="(kN)" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                        </DataGrid.Columns>
                                    </DataGrid>

                                </StackPanel>
                            </avalonDock:LayoutDocument>

                            <avalonDock:LayoutDocument Title="前/後方杭" CanClose="False">
                                <StackPanel>
                                    <ToolBar>
                                        <Button x:Name ="ButtonAutoIsFrontPiles" Content="自動選別"/>
                                    </ToolBar>

                                    <DataGrid x:Name="DataGridIsFrontPile" ItemsSource="{Binding PileLayoutViewModel.PileLayoutCollection, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedItem="{Binding PileLayoutViewModel.SelectedItem, Mode=TwoWay}"
                                        AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False" Height ="400"
                                        CellEditEnding="DataGridIsFrontPile_CellEditEnding"
                                        MouseRightButtonDown="DataGridPileLayout_MouseRightButtonDown">

                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                <Setter Property="Foreground" Value="#62B0E2" />
                                            </Style>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Binding="{Binding PileNumber}" IsReadOnly="True" Foreground="Gray" MinWidth="50">
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="配置" TextAlignment="Center"/>
                                                        <TextBlock Text="番号" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Width="50" IsReadOnly="True" Binding="{Binding X, StringFormat=N3}"  Foreground="Gray" ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50">
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="X" TextAlignment="Center"/>
                                                        <TextBlock Text="(m)" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Width="50" IsReadOnly="True" Binding="{Binding Y, StringFormat=N3}"  Foreground="Gray" ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50">
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="Y" TextAlignment="Center"/>
                                                        <TextBlock Text="(m)" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>
                                            <DataGridCheckBoxColumn Header="方向1" Width="50" Binding="{Binding IsFrontPiles[0]}" MinWidth="50"/>
                                            <DataGridCheckBoxColumn Header="方向2" Width="50" Binding="{Binding IsFrontPiles[1]}" MinWidth="50"/>
                                            <DataGridCheckBoxColumn Header="方向3" Width="50" Binding="{Binding IsFrontPiles[2]}" MinWidth="50"/>
                                            <DataGridCheckBoxColumn Header="方向4" Width="50" Binding="{Binding IsFrontPiles[3]}" MinWidth="50"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                </StackPanel>
                            </avalonDock:LayoutDocument>

                            <avalonDock:LayoutDocument Title="根入部" CanClose="False">
                                <StackPanel>
                                    <ToolBar>
                                        <!--<Border BorderBrush="Gray" BorderThickness="0.5">
                                            <StackPanel Orientation="Horizontal">-->
                                        <Label Content="地盤符号"/>
                                        <ComboBox x:Name="ComboBoxEmbedmentGroundReference" 
                                                      ItemsSource="{Binding GroundLayerViewModel.GroundRefs}" SelectedItem="{Binding EmbedmentViewModel.GroundRef, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <!--</StackPanel>
                                        </Border>-->
                                        <Separator></Separator>
                                        <!--<Border BorderBrush="Gray" BorderThickness="0.5">
                                            <StackPanel Orientation="Horizontal">-->
                                        <Label Content="上端標高(m)" />
                                        <TextBox Text="{Binding FundamentalViewModel.RefLevel}" IsReadOnly="True" Foreground="Gray"/>
                                        <TextBox x:Name="TextBoxTopAltitude" >
                                            <Binding Path="EmbedmentViewModel.TopAltitude" UpdateSourceTrigger="PropertyChanged" StringFormat="{}{0:+0.00;-0.00;±0.00}"/>
                                        </TextBox>
                                        <!--</StackPanel>
                                        </Border>-->
                                        <Separator></Separator>
                                        <!--<Border BorderBrush="Gray" BorderThickness="0.5">
                                            <StackPanel Orientation="Horizontal">-->
                                        <Label Content="区分数" />
                                        <ComboBox x:Name="ComboBoxEmbedmentNums" SelectionChanged="ComboBoxEmbedmentNums_SelectionChanged">
                                            <ComboBoxItem Content="0" IsSelected ="True"/>
                                            <ComboBoxItem Content="1"/>
                                            <ComboBoxItem Content="2"/>
                                            <ComboBoxItem Content="3"/>
                                            <ComboBoxItem Content="4"/>
                                            <ComboBoxItem Content="5"/>
                                        </ComboBox>
                                        <!--</StackPanel>
                                        </Border>-->
                                    </ToolBar>

                                    <DataGrid x:Name="DataGridEmbedment" ItemsSource="{Binding EmbedmentViewModel.EmbedmentCollection , Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Loaded="DataGrid_Loaded" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False"  
                                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" 
                                              CellEditEnding="DataGridEmbedment_CellEditEnding">
                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                <Setter Property="Foreground" Value="#62B0E2" />
                                            </Style>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Binding="{Binding No}" Width="*" MinWidth="60" IsReadOnly="True" Foreground="Gray">
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="区分" TextAlignment="Center"/>
                                                        <TextBlock Text="番号" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Binding="{Binding LayerThickness, StringFormat={}{0:0.000}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                Width="*"  ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="60" >
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="厚さ"   TextAlignment="Center" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="(m)"  TextAlignment="Center" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Binding="{Binding TopAltitude, StringFormat={}{0:+0.00;-0.00;±0.00}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                IsReadOnly="True" Foreground="Gray" Width="*" ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="60">
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="上端標高"   TextAlignment="Center" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="(m)" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn  Binding="{Binding BottomAltitude, StringFormat={}{0:+0.00;-0.00;±0.00}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 IsReadOnly="True" Foreground="Gray" Width="*" ElementStyle="{StaticResource RightAlignedTextBlockStyle}"  MinWidth="60">
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="下端標高"  TextAlignment="Center" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="(m)" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Binding="{Binding X1, StringFormat={}{0:0.000}}"  ElementStyle="{StaticResource RightAlignedTextBlockStyle}"
                                                                Width="*" MinWidth="50">
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="X1"  TextAlignment="Center" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="(m)" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Binding="{Binding X2, StringFormat={}{0:0.000}}"  ElementStyle="{StaticResource RightAlignedTextBlockStyle}"
                                                                Width="*" MinWidth="50">
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="X2" TextAlignment="Center"/>
                                                        <TextBlock Text="(m)" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Binding="{Binding Y1, StringFormat={}{0:0.000}}"   ElementStyle="{StaticResource RightAlignedTextBlockStyle}"
                                                                Width="*" MinWidth="50">
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="Y1" TextAlignment="Center"/>
                                                        <TextBlock Text="(m)" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Binding="{Binding Y2, StringFormat={}{0:0.000}}" ElementStyle="{StaticResource RightAlignedTextBlockStyle}"
                                                                Width="*" MinWidth="50">
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="Y2" TextAlignment="Center"/>
                                                        <TextBlock Text="(m)" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <DataGridTemplateColumn Width="*" MinWidth="50" CellStyle="{StaticResource RightAlignedDataCellStyle}">
                                                <DataGridTemplateColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="dX" TextAlignment="Center"/>
                                                        <TextBlock Text="(m)" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridTemplateColumn.Header>

                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding DX, StringFormat={}{0:0.000}}" Foreground="Gray" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Width="*" MinWidth="50" CellStyle="{StaticResource RightAlignedDataCellStyle}">
                                                <DataGridTemplateColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="dY" TextAlignment="Center"/>
                                                        <TextBlock Text="(m)" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridTemplateColumn.Header>
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding DY, StringFormat={}{0:0.000}}" Foreground="Gray"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                        </DataGrid.Columns>
                                    </DataGrid>

                                </StackPanel>
                            </avalonDock:LayoutDocument>

                            <avalonDock:LayoutDocument Title="通り心" CanClose="False">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Toolbar with Add Button -->
                                    <ToolBar Grid.Row="0" Grid.Column="0">
                                        <Button x:Name="ButtonAddGridX" Content="Y軸平行通り心追加" VerticalAlignment="Top" Click="ButtonAddGridX_Click"/>
                                    </ToolBar>

                                    <!-- DataGrid for GridX items -->
                                    <DataGrid x:Name="DataGridGridX" ItemsSource="{Binding PileLayoutViewModel.GridX, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Grid.Row="1" Grid.Column="0"
                                              AutoGenerateColumns="False"
                                              CellEditEnding="DataGridGridX_CellEditEnding"
                                              >
                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                <Setter Property="Foreground" Value="#62B0E2" />
                                            </Style>
                                        </DataGrid.ColumnHeaderStyle>

                                        <DataGrid.Columns>

                                            <!-- Column for Name -->
                                            <DataGridTextColumn Binding="{Binding Name}" ElementStyle="{StaticResource RightAlignedTextBlockStyle}" Width="*" MinWidth="50">
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="通り名" TextAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <!-- Column for Spacing -->
                                            <DataGridTextColumn Binding="{Binding Spacing, StringFormat=N3}" Width="*" MinWidth="50">
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="dX" TextAlignment="Center"/>
                                                        <TextBlock Text="(m)" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <!-- Column for Coord -->
                                            <DataGridTextColumn Binding="{Binding Coord, StringFormat=N3}" Width="*" ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50">
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="X" TextAlignment="Center"/>
                                                        <TextBlock Text="(m)" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <!-- Column for Delete Button -->
                                            <DataGridTemplateColumn Width="*" Header="削除" MinWidth="50">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button
                                                            x:Name="ButtonGridXDelete"
                                                            Click="ButtonGridXDelete_Click"
                                                            Content="削除"
                                                            Tag="{Binding}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <ToolBar Grid.Row="0" Grid.Column="1">
                                        <Button x:Name="ButtonAddGridY" Content="X軸平行通り心追加" VerticalAlignment="Top" Click="ButtonAddGridY_Click"/>
                                    </ToolBar>

                                    <DataGrid x:Name="DataGridGridY"  ItemsSource="{Binding PileLayoutViewModel.GridY, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Grid.Row="1" Grid.Column="1"
                                         AutoGenerateColumns="False"
                                              CellEditEnding="DataGridGridY_CellEditEnding"
                                              PreviewKeyDown="DataGridGridY_PreviewKeyDown">

                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                <Setter Property="Foreground" Value="#62B0E2" />
                                            </Style>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50">
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="通り名" TextAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Binding="{Binding Spacing, StringFormat=N3}" Width="*" MinWidth="50">
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="dY" TextAlignment="Center"/>
                                                        <TextBlock Text="(m)" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn  Binding="{Binding Coord, StringFormat=N3}" Width="*" ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50">
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="Y" TextAlignment="Center"/>
                                                        <TextBlock Text="(m)" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <DataGridTemplateColumn Header="削除" Width="*"  MinWidth="50">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button
                                                            x:Name="ButtonGridYDelete"
                                                            Click="ButtonGridYDelete_Click"
                                                            Content="削除"
                                                            Tag="{Binding}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </avalonDock:LayoutDocument>
                        </avalonDock:LayoutDocumentPane>
                        <avalonDock:LayoutDocumentPane>
                            <avalonDock:LayoutDocument Title="上面ビュー" CanClose="False">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <ToolBar Grid.Row="0">
                                        <!--<Border BorderBrush="Gray" BorderThickness="0.5">
                                            <StackPanel Orientation="Horizontal">-->
                                        <TextBlock Text="ラベル内容" VerticalAlignment="Center"></TextBlock>
                                        <ComboBox x:Name="ComboBoxLabelContent" SelectionChanged="ComboBoxLabelContent_SelectionChanged">
                                            <ComboBoxItem Content="配置番号" IsSelected="True"/>
                                            <ComboBoxItem Content="杭頭レベル(m)"/>
                                            <ComboBoxItem Content="杭符号"/>
                                            <ComboBoxItem Content="地盤符号"/>
                                            <ComboBoxItem Content="群杭係数"/>
                                            <ComboBoxItem Content="VL(kN)"/>
                                            <ComboBoxItem Content="VLadd(kN)"/>
                                            <ComboBoxItem Content="E1(kN)"/>
                                            <ComboBoxItem Content="E2(kN)"/>
                                            <ComboBoxItem Content="1-1(kN)"/>
                                            <ComboBoxItem Content="1-2(kN)"/>
                                            <ComboBoxItem Content="1-3(kN)"/>
                                            <ComboBoxItem Content="1-4(kN)"/>
                                            <ComboBoxItem Content="2-1(kN)"/>
                                            <ComboBoxItem Content="2-2(kN)"/>
                                            <ComboBoxItem Content="2-3(kN)"/>
                                            <ComboBoxItem Content="2-4(kN)"/>
                                            <ComboBoxItem Content="前後1"/>
                                            <ComboBoxItem Content="前後2"/>
                                            <ComboBoxItem Content="前後3"/>
                                            <ComboBoxItem Content="前後4"/>
                                        </ComboBox>
                                        <Separator/>
                                        <TextBlock Text="ラベルサイズ" VerticalAlignment="Center"></TextBlock>
                                        <ComboBox x:Name="ComboBoxLabelSize" SelectionChanged="ComboBoxLabelSize_SelectionChanged">
                                            <ComboBoxItem Content="7"/>
                                            <ComboBoxItem Content="8"/>
                                            <ComboBoxItem Content="9"/>
                                            <ComboBoxItem Content="10" IsSelected="True"/>
                                            <ComboBoxItem Content="11"/>
                                            <ComboBoxItem Content="12"/>
                                            <ComboBoxItem Content="13"/>
                                            <ComboBoxItem Content="14"/>
                                            <ComboBoxItem Content="15"/>
                                            <ComboBoxItem Content="16"/>
                                        </ComboBox>
                                        <!--</StackPanel>
                                        </Border>-->
                                    </ToolBar>


                                    <Canvas x:Name="CanvasLayout" Background="white" Opacity="1" Grid.Row="1"
                                      MouseLeftButtonDown="CanvasLayout_MouseLeftButtonDown"
                                      MouseLeftButtonUp="CanvasLayout_MouseLeftButtonUp"
                                      MouseMove="CanvasLayout_MouseMove"
                                      MouseRightButtonDown="CanvasLayout_MouseRightButtonDown"
                                      MouseLeave="CanvasLayout_MouseLeave"
                                      MouseWheel="CanvasLayout_MouseWheel"
                                      MouseDown="CanvasLayout_MouseDown"
                                      MouseUp="CanvasLayout_MouseUp"
                                      SizeChanged="CanvasLayout_SizeChanged"/>
                                </Grid>
                            </avalonDock:LayoutDocument>

                            <avalonDock:LayoutDocument Title="3Dビュー" CanClose="False">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <ToolBar Grid.Row="0">
                                        <ComboBox x:Name="HelixViewComboBox" SelectionChanged="HelixViewComboBox_SelectionChanged">
                                            <ComboBoxItem Content="平行ビュー"/>
                                            <ComboBoxItem Content="透視ビュー" IsSelected="True"/>
                                        </ComboBox>
                                        <ComboBox SelectionChanged="HelixViewComboBoxViewStyle_SelectionChanged">
                                            <ComboBoxItem Content="レンダリング" IsSelected="True"/>
                                            <ComboBoxItem Content="ワイヤフレーム"/>
                                        </ComboBox>

                                        <ToggleButton Content="XYZ軸" IsChecked="True"
                                                      Checked="ToggleButtonXYZAxes_Checked" Unchecked="ToggleButtonXYZAxes_UnClicked"></ToggleButton>
                                        <ToggleButton Content="XYグリッド" IsChecked="True"
                                                      Checked="ToggleButtonXYGrid_Checked" Unchecked="ToggleButtonXYGrid_UnClicked"></ToggleButton>

                                        <Button x:Name="HelixViewportSaveImage"   Content="画像保存" Margin="0" Click="HelixViewportSaveImageButton_Click" />
                                    </ToolBar>

                                    <!--<h:HelixViewport3D x:Name="HelixViewport" ShowCoordinateSystem="True" Grid.Row="1"
                                                       MouseLeftButtonDown="HelixViewport_MouseLeftButtonDown">
                                        --><!-- 背景色を設定します（必要に応じて変更可能） --><!--
                                        <h:HelixViewport3D.Background>
                                            <SolidColorBrush Color="White" />
                                        </h:HelixViewport3D.Background>

                                        <h:HelixViewport3D.ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="カメラの操作方法" FontWeight="Bold"/>
                                                <TextBlock Text="視点直交方向移動：Shift+右ボタンドラッグ or ホイールドラッグ"/>
                                                <TextBlock Text="視点方向移動：Ctrl+右ボタンドラッグ or ホイール回転"/>
                                                <TextBlock Text="回転：右ボタンドラッグ"/>
                                                <TextBlock Text="焦点ズーム：Alt+右ボタンドラッグ"/>
                                            </StackPanel>
                                        </h:HelixViewport3D.ToolTip>

                                    </h:HelixViewport3D>-->
                                </Grid>
                            </avalonDock:LayoutDocument>

                            <avalonDock:LayoutDocument Title="側面ビュー" CanClose="False">

                            </avalonDock:LayoutDocument>

                        </avalonDock:LayoutDocumentPane>
                    </avalonDock:LayoutDocumentPaneGroup>
                </avalonDock:LayoutPanel >
            </avalonDock:LayoutRoot>
        </avalonDock:DockingManager>

    </Grid>
</Window>