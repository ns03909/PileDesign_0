<Window x:Class="PileDesignCore.PileTopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PileDesignCore"
        mc:Ignorable="d"
        Title="PileTopWindow" Height="675" Width="1200">
    <Window.DataContext>
        <local:PileTopViewModel />
    </Window.DataContext>
    <Window.Resources>
        <local:VisibilityConverter x:Key="VisibilityConverter"/>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="杭頭タイプ" Width="100"/>
                <TextBox Width="100" Text="{Binding SelectedPileTopType, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="True" Foreground="Gray"/>
            </StackPanel>

            <GroupBox Header="パイルキャップ">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="Fc" Width="100"/>
                        <TextBox x:Name="TextBoxPileCapFc" Width="100"
                                 Text="{Binding PileCapFc, UpdateSourceTrigger=PropertyChanged}"
                                 HorizontalContentAlignment="Right"/>
                        <!--TextChanged="TextBoxPileCapFc_TextChanged"-->
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="γ" Width="100"/>
                        <TextBox x:Name="TextBoxPileCapGamma" Width="100"
                                 Text="{Binding PileCapGamma, UpdateSourceTrigger=PropertyChanged}"
                                 HorizontalContentAlignment="Right"/>
                        <!--TextChanged="TextBoxPileCapGamma_TextChanged"-->
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="Ec" Width="100"/>
                        <TextBox x:Name="TextBoxPileCapEc" Width="100"
                                 Text="{Binding PileCapEc, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N0}'}"
                                 IsReadOnly="True" Foreground="Gray" 
                                 HorizontalContentAlignment="Right"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="キャプテンパイル" Visibility="{Binding SelectedPileTopType,
                    Converter={StaticResource VisibilityConverter},
                    ConverterParameter='キャプテンパイル工法'}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="PCリング" Width="100"/>
                        <ComboBox x:Name="ComboBoxPCRing" Width="100"
                                  ItemsSource="{Binding PCRingOption}" SelectedItem="{Binding CaptainPile.SelectedPCRingName, UpdateSourceTrigger=PropertyChanged}"
                                  SelectionChanged="ComboBoxPCRingChanged"  HorizontalContentAlignment="Right">
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="絞り率ν" Width="100"/>

                        <ComboBox x:Name="ComboBoxContractionRatio" Width="100" ItemsSource="{Binding CaptainPile.ContractionRatioOption}"
                                    SelectedItem="{Binding CaptainPile.Nu, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Right" SelectionChanged="ComboBoxContractionRatioSelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat={}{0:F2}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <CheckBox x:Name="CheckBoxHasTensionAnchors" Content= "引張定着筋" 
                        IsChecked="{Binding CaptainPile.CTPTensionRebars.HasTensionRebars, UpdateSourceTrigger=PropertyChanged}"
                              Checked="CheckBoxHasTensionAnchorsChecked" Unchecked="CheckBoxHasTensionAnchorsUnchecked"/>

                    <GroupBox Header="引張定着筋" Visibility="{Binding ElementName=CheckBoxHasTensionAnchors, Path=IsChecked,
                        Converter={StaticResource BooleanToVisibilityConverter}}">

                        <StackPanel>
                            <GroupBox Header="配置">
                                <StackPanel>
                                    <RadioButton x:Name="RadioButtonSquare" Content="正方形配置" IsChecked="True" Checked="RadioButton_Checked" Unchecked="RadioButton_Unchecked"/>
                                    <RadioButton x:Name="RadioButtonCircle" Content="円形配置" IsChecked="False" Checked="RadioButton_Checked" Unchecked="RadioButton_Unchecked"/>
                                </StackPanel>
                            </GroupBox>

                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="ComboBoxBarNumberSquare" Width="100"
                                    ItemsSource="{Binding CaptainPile.CTPTensionRebars.CaptainPileTensionBarNumberOption_square, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedItem="{Binding CaptainPile.CTPTensionRebars.SelectedBarNumberSquare}"
                                    Visibility="Collapsed"  SelectionChanged="ComboBoxSelectionChanged">
                                </ComboBox>

                                <ComboBox x:Name="ComboBoxBarNumberCircle" Width="100"
                                    ItemsSource="{Binding CaptainPile.CTPTensionRebars.CaptainPileTensionBarNumberOption_circle, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedItem="{Binding CaptainPile.CTPTensionRebars.SelectedBarNumberCircle}"
                                    Visibility="Collapsed" SelectionChanged="ComboBoxSelectionChanged">
                                </ComboBox>

                                <Label Content="-"/>

                                <ComboBox x:Name="ComboBoxTensionAnchorDia" Width="100"
                                    ItemsSource="{Binding CaptainPile.CTPTensionRebars.TensionAnchorDiaOption, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedItem="{Binding CaptainPile.CTPTensionRebars.SelectedTensionAnchorDia}" SelectionChanged="ComboBoxSelectionChanged">
                                </ComboBox>
                                <ComboBox x:Name="ComboBoxTensionAnchoGrade" Width="100"
                                    ItemsSource="{Binding CaptainPile.CTPTensionRebars.TensionAnchorGradeOption, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedItem="{Binding CaptainPile.CTPTensionRebars.SelectedTensionAnchorGrade}">
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">

                                <Label Content="TB" Width="100" Visibility="{Binding CaptainPile.CTPTensionRebars.IsSquareArrangement,
                                                Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <Label Content="TD" Width="100" Visibility="{Binding CaptainPile.CTPTensionRebars.IsCircleArrangement,
                                                Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBox x:Name="TextBoxTDorTB" Width="100" Text="{Binding CaptainPile.CTPTensionRebars.TDorTB, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="True" Foreground="Gray"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="FTパイル" Visibility="{Binding SelectedPileTopType,
                    Converter={StaticResource VisibilityConverter},
                    ConverterParameter='FT-Pile構法'}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="FTキャップ"/>
                        <ComboBox x:Name="ComboBoxFTCap" Width="100"
                            ItemsSource="{Binding FTCapOption}"
                            SelectedItem="{Binding SelectedFTCap, UpdateSourceTrigger=PropertyChanged}"
                            SelectionChanged="ComboBoxFTCapChanged" />
                    </StackPanel>

                    <CheckBox x:Name="CheckBoxHasFTTensionAnchors" Content="引張定着筋"
                              IsChecked="{Binding FTPile.FTPileTensionBars.IsTensionType, UpdateSourceTrigger=PropertyChanged}"
                              Checked="CheckBoxHasFTTensionAnchorsChecked" Unchecked="CheckBoxHasFTTensionAnchorsUnchecked"/>

                    <GroupBox Header="引張定着筋" Visibility="{Binding ElementName=CheckBoxHasFTTensionAnchors, Path=IsChecked,
                        Converter={StaticResource BooleanToVisibilityConverter}}">

                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="TextBoxFTTensionNum"
                                         Text="{Binding FTPile.FTPileTensionBars.TensionAnchorNum, UpdateSourceTrigger=PropertyChanged}"
                                         Width="100" TextChanged="TextBoxFTTensionNumChanged"/>
                                <Label Content="-"/>
                                <ComboBox x:Name="ComboBoxFTTensionBar" Width="100"
                                        ItemsSource="{Binding FTPile.FTPileTensionBars.TensionAnchorGradeOption}"
                                        SelectedItem="{Binding FTPile.FTPileTensionBars.SelectedTensionAnchorGrade, UpdateSourceTrigger=PropertyChanged}">
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </GroupBox>

            <Label Content="諸元"/>
            <DataGrid x:Name="DrawGridSpecifications" ItemsSource="{Binding SelectedPileTopSpecification}"  AutoGenerateColumns="False" CanUserSortColumns="False">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="Foreground" Value="#62B0E2" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="項目" Width="2*" Binding="{Binding Item}" IsReadOnly="True" Foreground="Gray"/>
                    <DataGridTextColumn Header="記号" Width="*" Binding="{Binding Mark}" IsReadOnly="True" Foreground="Gray"/>
                    <DataGridTextColumn Header="値" Width="*" Binding="{Binding Value}" IsReadOnly="True" Foreground="Gray">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="単位" Width="*" Binding="{Binding Unit}" IsReadOnly="True" Foreground="Gray"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Orientation="Horizontal">
                <Button x:Name="ButtonOk" Content="Ok" HorizontalAlignment="Left" Height="25" VerticalAlignment="Top" Width="100" Click="ButtonOk_Click"/>
                <Button x:Name="ButtonCancel" Content="Cancel" HorizontalAlignment="Left" Height="25" VerticalAlignment="Top" Width="100" Click="ButtonCancel_Click"/>
            </StackPanel>

        </StackPanel>

        <StackPanel Grid.Column="1">

            <GroupBox Header="上面図" Grid.Column="1">
                <Canvas x:Name="Canvas" Height="300" Width="300" Background="Transparent" Opacity="0.5" MouseRightButtonDown="Canvas_MouseRightButtonDown">
                    <Canvas.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="画像コピー" Click="ImageCopyMenuItem_Click"/>
                            <MenuItem Header="画像保存" Click="ImageSaveMenuItem_Click"/>
                        </ContextMenu>
                    </Canvas.ContextMenu>
                </Canvas>
            </GroupBox>
            <StackPanel Orientation="Horizontal">
                <GroupBox Header="MNインタラクション">
                    <WindowsFormsHost Name="ChartMN" Height="300" Width="300"/>
                </GroupBox>
                <GroupBox Header="θMインタラクション">
                    <WindowsFormsHost Name="ChartThetaM" Height="300"  Width="300"/>
                </GroupBox>
            </StackPanel>

        </StackPanel>
        
    </Grid>
</Window>
