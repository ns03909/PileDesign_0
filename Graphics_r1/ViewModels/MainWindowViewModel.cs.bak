        [RelayCommand]
        private async Task MoveCopyPiles()
        {
            try
            {
                // ・ｽI・ｽ・ｽﾟ点情報ﾈゑｿｽ・ｽ鼾・ｿｽﾍ擾ｿｽ情報・~情報ﾄ・ｿｽ・ｽb・ｽZ・ｽ[・ｽW・ｽ\・ｽ・ｽ
                if (CurrentInputModel == null ||
                CurrentInputModel.PileLayoutItems == null ||
                !CurrentInputModel.PileLayoutItems.Any(p => p.IsSelected))
                {
                    MessageBox.Show("杭配置情報I根入部・ｽ・ｽﾄゑｿｽ・ｽﾜゑｿｽ・ｽ・ｽB", "確認", MessageBoxButton.OK, MessageBoxImage.Information);
                    return;
                }

                // Undo・ｽ|・ｽC情報g・ｽ・ｽﾇ会ｿｽ
                _undoManager.SaveState(CurrentInputModel.DeepCopy());

                // MoveWindow情報C情報X・ｽ^情報X根入部・ｽﾄ表・ｽ・ｽ
                MoveCopyWindow moveCopyWindow = new();

                var tcs = new TaskCompletionSource<bool>();
                moveCopyWindow.MoveCopyCompleted += async (sender, e) =>
                {
                    await MoveCopyWindow_MoveCopyCompletedAsync(sender, e);
                    tcs.SetResult(true);
                };

                moveCopyWindow.ShowDialog(); // 情報[・ｽ_情報_・ｽC・ｽA情報O・ｽﾆゑｿｽ・ｽﾄ表・ｽ・ｽ

                // ・ｽ・ｽ ・ｽﾒ機・ｽJ・ｽ[・ｽ\根入部\・ｽ・ｽ
                Mouse.OverrideCursor = Cursors.Wait;
                try
                {
                    await tcs.Task; // ・ｽｯ奇ｿｽ・ｽﾉ奇ｿｽ根入部ﾒゑｿｽ

                    // コレクション自体の変更通知
                    OnPropertyChanged(nameof(GroupPileSettlementXmin));
                    OnPropertyChanged(nameof(GroupPileSettlementXmax));
                    OnPropertyChanged(nameof(GroupPileSettlementYmin));
                    OnPropertyChanged(nameof(GroupPileSettlementYmax));

                    // 変更: デバウンスで更新
                    RequestUpdateWindow();
                    UpdateTreeView();
                }
                finally
                {
                    // ・ｽ・ｽ ・ｽJ・ｽ[・ｽ\根入部情報ﾉ戻ゑｿｽ
                    Mouse.OverrideCursor = null;
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show($"杭体移難ｿｽ・ｽE根入部情報ﾉエ情報[根入部根入部・ｽﾜゑｿｽ情報B\n{ex.Message}", "エラー", MessageBoxButton.OK, MessageBoxImage.Error);
            }
        }

        private async Task MoveCopyWindow_MoveCopyCompletedAsync(object sender, MoveCopyEventArgs e)
        {
            // ・ｽV根入部・ｽE・ｽB情報h・ｽE・ｽﾅの托ｿｽ・ｽ・ｽﾌ鯉ｿｽ・ｽﾊゑｿｽ根入部根入部
            if (e.IsMove)
                MoveNodes(e.DX, e.DY);// ・ｽﾚ難ｿｽ根入部ﾌ擾ｿｽ・ｽ・ｽ
            else if (e.IsCopy)
                await CopyNodesAsync(e.DX, e.DY, e.RepetitionNumber); // 根入部根入部ﾌ擾ｿｽ・ｽ・ｽ
        }

