        // 情報ﾍチ・ｽF・ｽb・ｽN
        [RelayCommand]
        public void OnAxialForceCheck()
        {
            if (CurrentInputModel == null || CurrentInputModel.PileLayoutItems == null || CurrentInputModel.PileLayoutItems.Count == 0)
            {
                MessageBox.Show("杭配置根入部・ｽﾝゑｿｽ・ｽﾜゑｿｽ・ｽ・ｽB", "確認", MessageBoxButton.OK, MessageBoxImage.Information);
                return;
            }

            bool hasWarning = false;
            string warningMessage = "・ｽﾈ会ｿｽ・ｽﾌ搾ｿｽ・ｽﾚに厄ｿｽ閧ｪ根入部ﾜゑｿｽ:\n";

            foreach (var pileLayout in CurrentInputModel.PileLayoutItems)
            {
                var force = pileLayout.AxialForceVL;

                for (int i = 0; i < CurrentInputModel.PileBodies[pileLayout.PileBodyNo - 1].PileBodySegments.Count; i++)
                {
                    var pileSection = CurrentInputModel.PileBodies[pileLayout.PileBodyNo - 1].PileBodySegments[i].PileSection;

                    if (pileSection.FactoredServiceNmax < force)
                    {
                        hasWarning = true;
                        warningMessage += $"- 杭配置・ｽﾔ搾ｿｽ{i + 1} ・ｽﾗ重・ｽP・ｽ[・ｽX:VL:\n ・ｽg・ｽp情報E情報ﾍ適・ｽp・ｽﾍ茨ｿｽMax{pileSection.FactoredServiceNmax:N0}kN < {force:N0}kN\n";
                    }
                    if (force < pileSection.FactoredServiceNmin)
                    {
                        hasWarning = true;
                        warningMessage += $"- 杭配置・ｽﾔ搾ｿｽ{i + 1} ・ｽﾗ重・ｽP・ｽ[・ｽX:VL:\n {force:N0}kN < ・ｽg・ｽp情報E情報ﾍ適・ｽp・ｽﾍ茨ｿｽMin{pileSection.FactoredServiceNmin:N0}kN\n";
                    }
                }
            }

            if (hasWarning)
                MessageBox.Show(warningMessage, "・ｽx・ｽ・ｽ", MessageBoxButton.OK, MessageBoxImage.Information);
            else
                MessageBox.Show("・ｽe杭配置・ｽﾌ趣ｿｽ・ｽﾍは各・ｽf・ｽﾊの趣ｿｽ・ｽﾍ適・ｽp・ｽﾍ囲難ｿｽ・ｽﾅゑｿｽ・ｽB", "情報", MessageBoxButton.OK, MessageBoxImage.Information);
        }

