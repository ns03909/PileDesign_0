        // 要素分割解除確認メソッド
        public bool CheckAndResetElementSplit(string text)
        {
            if (IsElementSplit == true)
            {
                MessageBoxResult result = MessageBox.Show(
                    $"{text}・ｽ・ｽﾒ集・ｽA・ｽm・ｽ閧ｷ・ｽ・ｽﾉは、情報ﾍ済みの要・ｽf根入部根入部ﾑ、" +
                    $"\n・ｽ・ｽﾍ鯉ｿｽ・ｽﾊゑｿｽ情報ﾝゑｿｽ・ｽ・ｽ鼾・ｿｽﾍ会ｿｽﾍ鯉ｿｽ・ｽﾊゑｿｽ・ｽ尞懶ｿｽ情報K・ｽv根入部・ｽ・ｽﾜゑｿｽ・ｽB" +
                    $"\n・ｽ・ｽ・ｵ情報ﾅゑｿｽ情報B",
                    "確認",
                    MessageBoxButton.OKCancel,
                    MessageBoxImage.Warning);

                if (result == MessageBoxResult.Cancel)
                    return false;
                else
                {
                    IsElementSplit = false;
                    IsVerticalAnalysisDone = false;
                    IsHorizontalAnalysisDone = false;
                    // 変更済（追加の箇所で適用）
                    RequestUpdateWindow();
                }
            }
            return true;
        }

