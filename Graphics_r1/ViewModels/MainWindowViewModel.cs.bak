        [RelayCommand]
        public void OpenChangWindow()
        {
            // ChangViewModel ・ｽﾉ鯉ｿｽ・ｽﾝゑｿｽ InputModel ・ｽ酷根入部ﾄ作成
            var vm = new ChangViewModel(CurrentInputModel);
            //var win = new ChangWindow();
            var win = new ChangWindow { DataContext = vm };

            // ・ｽC・ｽx情報g・ｽn情報h根入部ﾝ抵ｿｽ
            if (vm is ICloseable closeableViewModel)
            {
                if (win.IsLoaded && win.IsVisible)
                    win.Close();
            }

            try
            {
                // ・ｽ・ｽ ・ｽd・ｽv: ・ｽ_・ｽC・ｽA情報O情報J情報O・ｽﾉ鯉ｿｽ・ｽﾝのフ・ｽH・ｽ[・ｽJ・ｽX情報N情報A
                // 根入部ﾉゑｿｽ・ｽ IME/TextStore 根入部根入部・ｽACOMException 根入部・ｽ・ｽﾅゑｿｽ・ｽ・ｽ
                var focusedElement = Keyboard.FocusedElement;
                if (focusedElement is TextBox)
                {
                    // ・ｽt・ｽH・ｽ[・ｽJ・ｽX・ｽ・ｽ MainWindow ・ｽﾉ移難ｿｽ
                    Application.Current.MainWindow?.Focus();

                    // Dispatcher ・ｽ・ｽ UI 情報X・ｽV根入部 IME 根入部根入部骼橸ｿｽﾔゑｿｽ^根入部
                    Application.Current.Dispatcher.Invoke(
                        System.Windows.Threading.DispatcherPriority.Background,
                        new Action(() => { }));
                }

                win.ShowDialog();
            }
            catch (Exception ex)
            {
                MessageBox.Show($"・ｽ_・ｽC・ｽA情報O・ｽﾌ表根入部・ｽﾉエ情報[根入部根入部・ｽﾜゑｿｽ・ｽ・ｽ: {ex.Message}", "エラー", MessageBoxButton.OK, MessageBoxImage.Error);
            }

            // 変更済（追加の箇所で適用）
            UpdateWindowImmediate();
            UpdateTreeView();
        }

