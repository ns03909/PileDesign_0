    <ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:common="clr-namespace:PileDesign.Common"
                    xmlns:svg="http://sharpvectors.codeplex.com/runtime/"
                    xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
                    xmlns:wpfMath="clr-namespace:WpfMath.Controls;assembly=WpfMath"
                    xmlns:Fluent="urn:fluent-ribbon"
                    >

    <!-- ═══════════════════════ デザイントークン (v29 集約) ═══════════════════════ -->
    <!-- カラー定義: 全画面で参照する基本色。テーマ変更時はここを書き換えれば全反映 -->
    <Color x:Key="PrimaryAccentColor">#62B0E2</Color>           <!-- ライトブルー (見出し / 強調 / 選択) -->
    <Color x:Key="PrimaryAccentDarkColor">#FF62B0E2</Color>     <!-- 同 (アルファ付き) -->
    <Color x:Key="PrimaryAccentLightColor">#EAF5FB</Color>      <!-- 極薄ティント (ホバー背景, 縞) -->
    <Color x:Key="PrimaryAccentMediumColor">#C7E1F2</Color>     <!-- 薄ティント (選択背景) -->
    <Color x:Key="ErrorColor">#E53935</Color>                   <!-- 赤 (エラー) -->
    <Color x:Key="WarningColor">#F57C00</Color>                 <!-- 橙 (警告) -->
    <Color x:Key="ReadOnlyColor">#999999</Color>                <!-- ダークグレー (読取専用) -->
    <Color x:Key="MutedTextColor">#555555</Color>               <!-- 補足テキスト -->
    <Color x:Key="LogBackgroundColor">#F5F5F5</Color>           <!-- ログ背景 -->
    <Color x:Key="LogForegroundColor">#333333</Color>           <!-- ログ本文 -->
    <Color x:Key="SubtleBackgroundColor">#FAFAFA</Color>        <!-- 微薄背景 -->
    <Color x:Key="SurfaceMutedColor">#F0F0F0</Color>            <!-- 弱めグレー (見出し帯, 無効行) -->
    <Color x:Key="SurfaceBorderColor">#E0E0E0</Color>           <!-- 罫線・区切り (薄) -->
    <Color x:Key="StatusSuccessColor">#2E7D32</Color>           <!-- 成功 (解析済み, OK インジケータ) -->
    <Color x:Key="StatusInfoColor">#1565C0</Color>              <!-- 情報 (編集済, アクティブ) -->
    <Color x:Key="StatusWarningDarkColor">#E65100</Color>       <!-- 強い警告 (未保存, 注意喚起) -->

    <!-- ブラシ定義 (Foreground / Background での参照用) -->
    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="{StaticResource PrimaryAccentColor}"/>
    <SolidColorBrush x:Key="PrimaryAccentDarkBrush" Color="{StaticResource PrimaryAccentDarkColor}"/>
    <SolidColorBrush x:Key="PrimaryAccentLightBrush" Color="{StaticResource PrimaryAccentLightColor}"/>
    <SolidColorBrush x:Key="PrimaryAccentMediumBrush" Color="{StaticResource PrimaryAccentMediumColor}"/>

    <!-- ─── Fluent.Ribbon Accent override (NikkenSkyBlue 統一) ───
         Fluent.Ribbon 11 Light.Blue テーマの濃青アクセントを NikkenSkyBlue に置換。
         キー名は Fluent.Ribbon/Themes/Themes/Theme.Template.xaml (GitHub) を参照。
         - Highlight / AccentColor 系: 一般ハイライト用
         - RibbonTabItem.Border: 選択タブの下線色 (= 確認済みで動作)
         - RibbonTabControl.Content.Border: タブと内容領域の境界線
         注: RibbonTabItem.Active.Background / Selected.Background は塗りつぶしになるため上書き禁止
         -->
    <Color x:Key="Fluent.Ribbon.Colors.HighlightColor">#62B0E2</Color>
    <Color x:Key="Fluent.Ribbon.Colors.AccentBaseColor">#62B0E2</Color>
    <Color x:Key="Fluent.Ribbon.Colors.AccentColor">#62B0E2</Color>
    <SolidColorBrush x:Key="Fluent.Ribbon.Brushes.HighlightBrush" Color="#62B0E2"/>
    <SolidColorBrush x:Key="Fluent.Ribbon.Brushes.AccentBaseColorBrush" Color="#62B0E2"/>
    <SolidColorBrush x:Key="Fluent.Ribbon.Brushes.AccentColorBrush" Color="#62B0E2"/>
    <SolidColorBrush x:Key="Fluent.Ribbon.Brushes.AccentColorBrush80" Color="#CC62B0E2"/>
    <SolidColorBrush x:Key="Fluent.Ribbon.Brushes.AccentColorBrush60" Color="#9962B0E2"/>
    <SolidColorBrush x:Key="Fluent.Ribbon.Brushes.AccentColorBrush40" Color="#6662B0E2"/>
    <SolidColorBrush x:Key="Fluent.Ribbon.Brushes.AccentColorBrush20" Color="#3362B0E2"/>

    <!-- Fluent.Ribbon 11 の正確なキー名 (Theme.Template.xaml 参照、Brush suffix なし)。
         選択タブの下線は RibbonTabItem.Border または RibbonTabControl.Content.Border で描画される。 -->
    <SolidColorBrush x:Key="Fluent.Ribbon.Brushes.Highlight" Color="#62B0E2"/>
    <SolidColorBrush x:Key="Fluent.Ribbon.Brushes.RibbonTabItem.Border" Color="#62B0E2"/>
    <SolidColorBrush x:Key="Fluent.Ribbon.Brushes.RibbonTabControl.Content.Border" Color="#62B0E2"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ReadOnlyBrush" Color="{StaticResource ReadOnlyColor}"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}"/>
    <SolidColorBrush x:Key="LogBackgroundBrush" Color="{StaticResource LogBackgroundColor}"/>
    <SolidColorBrush x:Key="LogForegroundBrush" Color="{StaticResource LogForegroundColor}"/>
    <SolidColorBrush x:Key="SubtleBackgroundBrush" Color="{StaticResource SubtleBackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="{StaticResource SurfaceMutedColor}"/>
    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="{StaticResource SurfaceBorderColor}"/>
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="{StaticResource StatusSuccessColor}"/>
    <SolidColorBrush x:Key="StatusInfoBrush" Color="{StaticResource StatusInfoColor}"/>
    <SolidColorBrush x:Key="StatusWarningDarkBrush" Color="{StaticResource StatusWarningDarkColor}"/>

    <!-- 共通 hover / pressed 色 (DataGridCell / Button / TabItem / GroupBox 等で参照) -->
    <SolidColorBrush x:Key="ControlHoverBackground" Color="#E8F4FB"/>
    <SolidColorBrush x:Key="ControlPressedBackground" Color="#CFE6F4"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#C8C8C8"/>
    <SolidColorBrush x:Key="ControlBorderHoverBrush" Color="{StaticResource PrimaryAccentColor}"/>
    <SolidColorBrush x:Key="ControlBorderFocusBrush" Color="{StaticResource PrimaryAccentColor}"/>
    <SolidColorBrush x:Key="ControlDisabledBackground" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="ControlDisabledForeground" Color="#A0A0A0"/>

    <!-- Nikken カラー (限界状態などの分類色) -->
    <Color x:Key="NikkenSkyBlueColor">#62B0E2</Color>
    <Color x:Key="NikkenPaleRedColor">#E95541</Color>
    <Color x:Key="NikkenRedColor">#D82531</Color>
    <Color x:Key="NikkenDeepBlueColor">#3271AD</Color>
    <Color x:Key="NikkenYellowColor">#F7B515</Color>
    <Color x:Key="NikkenGreenColor">#238966</Color>
    <SolidColorBrush x:Key="NikkenSkyBlueBrush" Color="{StaticResource NikkenSkyBlueColor}"/>
    <SolidColorBrush x:Key="NikkenPaleRedBrush" Color="{StaticResource NikkenPaleRedColor}"/>
    <SolidColorBrush x:Key="NikkenRedBrush" Color="{StaticResource NikkenRedColor}"/>
    <SolidColorBrush x:Key="NikkenDeepBlueBrush" Color="{StaticResource NikkenDeepBlueColor}"/>
    <SolidColorBrush x:Key="NikkenYellowBrush" Color="{StaticResource NikkenYellowColor}"/>
    <SolidColorBrush x:Key="NikkenGreenBrush" Color="{StaticResource NikkenGreenColor}"/>
    <!-- 限界状態の意味的エイリアス: 使用限界=DeepBlue, 損傷限界=Green, 終局限界=PaleRed -->
    <SolidColorBrush x:Key="ServiceLimitBrush" Color="{StaticResource NikkenDeepBlueColor}"/>
    <SolidColorBrush x:Key="DamageLimitBrush" Color="{StaticResource NikkenGreenColor}"/>
    <SolidColorBrush x:Key="UltimateLimitBrush" Color="{StaticResource NikkenPaleRedColor}"/>

    <!-- 数式コントロール (WpfMath.FormulaControl) の共通スタイル: 全画面でラベル列に流用 -->
    <Style x:Key="FormulaControlStyle" TargetType="wpfMath:FormulaControl">
        <Setter Property="Scale" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- タイポグラフィ Style -->
    <!-- セクション見出し (左ペインの見出し等)。
         既存の HorizontalCalculationWindow のローカル "SectionHeader" と互換。-->
    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryAccentBrush}"/>
        <Setter Property="Margin" Value="0,10,0,4"/>
        <Setter Property="Padding" Value="0,0,0,2"/>
    </Style>

    <Style x:Key="SectionSubHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeaderStyle}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="Black"/>
    </Style>

    <Style x:Key="FormLabelStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,2,8,2"/>
    </Style>

    <Style x:Key="MutedTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style x:Key="ErrorTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="WarningTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
    </Style>

    <Style x:Key="SvgIconStyle" TargetType="svgc:SvgViewbox">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
    </Style>
    
    <Style x:Key="CustomDataGridCellStyle" TargetType="DataGridCell">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ControlHoverBackground}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryAccentBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="White"/>
                <Setter Property="BorderThickness" Value="0.75"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ControlHoverBackground}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="IsEditing" Value="True"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ========== ダイアログボタン共通スタイル ==========
         OK / 実行 / 保存 / キャンセル / 閉じる の見た目とキーボード操作を統一する。
         今日 (2026-05-18〜19) のダイアログ統一作業を再利用可能なリソース化。

         使い方:
           <Button Content="保存(_S)" Style="{StaticResource PrimaryDialogButtonStyle}"
                   IsDefault="True" Click="OkButton_Click"/>
           <Button Content="キャンセル(_C)" Style="{StaticResource DialogCancelButtonStyle}"
                   IsCancel="True" Click="CancelButton_Click"/>

         注意:
           - x:Name="OkButton" を付けて Loaded で OkButton.Focus() すれば初期フォーカスも設定可
           - IsDefault / IsCancel は WPF 標準機能なのでスタイルでは触らない
    -->
    <Style x:Key="PrimaryDialogButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinWidth" Value="100"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background" Value="{StaticResource PrimaryAccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="DialogSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinWidth" Value="100"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <Style x:Key="DialogCancelButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinWidth" Value="100"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="12,4"/>
    </Style>

    <!-- DataGridComboBoxColumn 用 CellStyle:
         デフォルトは IsSelected=True → IsEditing=True を強制するため、ComboBox 列では
         EditingElement (空のドロップダウン) に切り替わり選択値が見えなくなる。
         このスタイルは IsEditing 強制をスキップし、選択時は背景+文字色で視認性を維持する。
         DataGridComboBoxColumn.CellStyle に明示適用すること。 -->
    <Style x:Key="ComboBoxDataGridCellStyle" TargetType="DataGridCell">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ControlHoverBackground}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryAccentBrush}"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- DataGrid 既定: 行交互背景 (zebra) と選択モード等の共通設定。
         AlternatingRowBackground は SubtleBackgroundBrush (#FAFAFA) で控えめに。
         <DataGrid.AlternatingRowBackground><ImageBrush/></DataGrid.AlternatingRowBackground>
         の inline 上書きが効いている既存グリッドは zebra 無効化が維持される。 -->
    <Style TargetType="DataGrid">
        <Setter Property="SelectionUnit" Value="CellOrRowHeader"/>
        <Setter Property="SelectionMode" Value="Extended"/>
        <Setter Property="ClipboardCopyMode" Value="ExcludeHeader"/>
        <Setter Property="RowBackground" Value="White"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource SubtleBackgroundBrush}"/>
    </Style>

    <!-- DataGrid 列ヘッダー: 全 DataGrid で太さ・配置・パディングを統一。
         Foreground は色付き Header Style (GreenHeaderStyle 等) や個別 inline で
         上書きできるよう設定しない。各 keyed/inline Style 側で
         BasedOn="{StaticResource {x:Type DataGridColumnHeader}}" を指定して
         FontWeight 等を継承する. -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="6,4"/>
    </Style>


    <Style TargetType="{x:Type common:EnhancedDataGrid}"
           BasedOn="{StaticResource {x:Type DataGrid}}"/>

    <!-- ═══ アニメーション (B.8) ═══
         FadeInOnAppearStyle: opt-in。Border / Grid / Panel 等に
         `Style="{StaticResource FadeInOnAppearStyle}"` を指定すると、
         非表示→表示への遷移時に 180ms の opacity 0→1 アニメーションが走る。
         既存要素には影響しない (個別適用). -->
    <Style x:Key="FadeInOnAppearStyle" TargetType="FrameworkElement">
        <Style.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" Duration="0:0:0.18"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Border 専用版 (上の FrameworkElement 版は Border の暗黙 Style と
         衝突しにくいよう型を絞った別キー). -->
    <Style x:Key="FadeInBorderStyle" TargetType="Border">
        <Style.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" Duration="0:0:0.18"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══ INotifyDataErrorInfo 連動の検証エラー表示 ═══
         BaseModel が AddError("...") した瞬間にバインド先 TextBox が
         赤縁になり ToolTip にエラーメッセージが出る。
         opt-in (StaticResource 参照) なので既存 TextBox には影響しない。
    -->
    <Style x:Key="ValidatedTextBoxStyle" TargetType="TextBox">
        <Style.Triggers>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
                <Setter Property="BorderThickness" Value="1.5"/>
                <Setter Property="ToolTip"
                        Value="{Binding RelativeSource={RelativeSource Self},
                                Path=(Validation.Errors)/ErrorContent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══ 数値入力 TextBox (B+C) ═══
         common:NumericInput 添付プロパティ + ValidatedTextBoxStyle (赤縁) を結合。
         整数欄は IntegerTextBoxStyle, 小数欄は DecimalTextBoxStyle を使う。
         範囲制限が必要なら inline で common:NumericInput.Min / .Max を上書きできる:
           <TextBox Style="{StaticResource IntegerTextBoxStyle}"
                    common:NumericInput.Min="1" common:NumericInput.Max="64"/>
    -->
    <Style x:Key="IntegerTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource ValidatedTextBoxStyle}">
        <Setter Property="common:NumericInput.Mode" Value="Integer"/>
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
    </Style>

    <Style x:Key="SignedIntegerTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource ValidatedTextBoxStyle}">
        <Setter Property="common:NumericInput.Mode" Value="SignedInteger"/>
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
    </Style>

    <Style x:Key="DecimalTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource ValidatedTextBoxStyle}">
        <Setter Property="common:NumericInput.Mode" Value="Decimal"/>
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
    </Style>

    <Style x:Key="SignedDecimalTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource ValidatedTextBoxStyle}">
        <Setter Property="common:NumericInput.Mode" Value="SignedDecimal"/>
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
    </Style>

    <!-- 指数表記 (1.0E-5, -2.5e+10 等) を許容。収束判定値などで使用。 -->
    <Style x:Key="ScientificDecimalTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource ValidatedTextBoxStyle}">
        <Setter Property="common:NumericInput.Mode" Value="ScientificDecimal"/>
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
    </Style>

    <!-- ═══ DataGrid 数値セル EditingElementStyle ═══
         DataGridTextColumn の EditingElementStyle に指定すると、
         セル編集モードに入ったときの TextBox に NumericInput フィルタが適用される。
         Min/Max は inline で個別カラムに指定可:
           <DataGridTextColumn EditingElementStyle="{StaticResource IntegerEditingTextBoxStyle}">
             <DataGridTextColumn.EditingElementStyle>
               <Style TargetType="TextBox" BasedOn="{StaticResource IntegerEditingTextBoxStyle}">
                 <Setter Property="common:NumericInput.Min" Value="0"/>
               </Style>
             </DataGridTextColumn.EditingElementStyle>
           </DataGridTextColumn>
         BasedOn は無いことに注意 (DataGrid セル TextBox は内側の Padding 等を持たないため). -->
    <Style x:Key="IntegerEditingTextBoxStyle" TargetType="TextBox">
        <Setter Property="common:NumericInput.Mode" Value="Integer"/>
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
    </Style>

    <Style x:Key="DecimalEditingTextBoxStyle" TargetType="TextBox">
        <Setter Property="common:NumericInput.Mode" Value="Decimal"/>
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
    </Style>

    <Style x:Key="SignedDecimalEditingTextBoxStyle" TargetType="TextBox">
        <Setter Property="common:NumericInput.Mode" Value="SignedDecimal"/>
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
    </Style>

    <!-- ═══════════════════════ B.4-Lite テーマ統一 ═══════════════════════
         RibbonWindow ブロッカーで ModernWpf フル導入は困難。代替として
         既存パレット (PrimaryAccentBrush #62B0E2) で Fluent 風の暗黙 Style を
         全画面に展開する。実装方針:
           - Button / TextBox / GroupBox / TabItem に暗黙 Style (TargetType のみ)
           - ControlTemplate を最小限に書き換え、Hover/Focus に accent 色
           - 角丸 (CornerRadius=2〜4)、薄いボーダー、滑らかな状態遷移
           - x:Key 付き Style に明示的に切替えた箇所は影響を受けない

         実装中の留意点:
           - DataGridCell の Background は既に PrimaryAccentBrush を使う暗黙 Trigger あり
             (CustomDataGridCellStyle は keyed なので別)。Button 等の hover も同色系で統一
           - ComboBox は内部 Template が複雑なので暗黙置換しない (リスク回避)
    -->

    <!-- 注: 当初 Button / TextBox / ToggleButton にも暗黙 Custom Template を置いていたが、
         (a) Ribbon 内の通常 Button にも適用されてアイコン枠が中途半端に出る
         (b) DataGrid 編集セル内 TextBox に角丸ボーダーが付き、未編集セルと不整合
         (c) 通り心の「選」ボタン等、小型ボタンに MinHeight=22 / Padding=8,3 が大きすぎる
         という不具合があった。再導入版では:
           - サイズ系 Setter (MinHeight / Padding / Cursor) を一切設定せず、親 / 既存 inline 値を尊重
           - Custom Template でフラット見た目 + accent hover のみ提供
           - リボン領域は RibbonButton の独自 Style がここを上書きするので非干渉
         TextBox / ToggleButton は依然として撤去のまま (DataGrid 編集セルや
         Ribbon ToggleButton への副作用が大きいため). -->

    <!-- Button: フラット, 細いボーダー, accent hover。サイズはノータッチ -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource LogForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlHoverBackground}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ControlBorderHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlPressedBackground}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ControlBorderHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlDisabledBackground}"/>
                            <Setter Property="Foreground" Value="{StaticResource ControlDisabledForeground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ToggleButton: Button と同じフラット見た目 + IsChecked=True で accent 反転。
         サイズはノータッチ (前回失敗の反省: MinHeight 等を入れると Ribbon
         内部 ToggleButton や小型 ToggleButton が崩れる)。
         RibbonToggleButton は Ribbon 側の独自 implicit Style に上書きされる。 -->
    <Style TargetType="ToggleButton">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource LogForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlHoverBackground}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ControlBorderHoverBrush}"/>
                        </Trigger>
                        <!-- IsChecked: 藄ティント背景 + アクセント枠 + アクセント太字
                             以前は PrimaryAccentBrush 全面塗りだったが視覚的に主張しすぎる問題があり、
                             境界線と文字色でアクセント、背景は極薄ティントに変更 (2026-05-19) -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryAccentLightBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource PrimaryAccentBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlDisabledBackground}"/>
                            <Setter Property="Foreground" Value="{StaticResource ControlDisabledForeground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TabItem: 上にあるタブの選択状態を accent カラーで明示 -->
    <Style TargetType="TabItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#555555"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="MinWidth" Value="60"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <ContentPresenter Content="{Binding}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent" BorderThickness="0,0,0,2"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlHoverBackground}"/>
                            <Setter Property="Foreground" Value="#222222"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="White"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource PrimaryAccentBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource ControlDisabledForeground}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- GroupBox: ヘッダーに accent 色 + 細い境界線 -->
    <Style TargetType="GroupBox">
        <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,8,6,6"/>
        <Setter Property="Margin" Value="0,3"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryAccentBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Padding="6,2,6,3" Margin="0,0,0,0">
                            <ContentPresenter ContentSource="Header"
                                              TextElement.FontWeight="SemiBold"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <Border Grid.Row="1"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 粒度区分 (粘性土 / 砂質土 / 礫質土) を選択 ComboBox の文字色で識別するスタイル -->
    <!-- GroundWindow.xaml で定義済みのものをグローバル化したもの。各 Window から参照可能 -->
    <Style x:Key="GranularityClassComboBoxStyle" TargetType="ComboBox"
           BasedOn="{StaticResource {x:Type ComboBox}}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding SelectedValue, RelativeSource={RelativeSource Self}}" Value="粘性土">
                <Setter Property="Foreground" Value="SaddleBrown"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding SelectedValue, RelativeSource={RelativeSource Self}}" Value="砂質土">
                <Setter Property="Foreground" Value="SandyBrown"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding SelectedValue, RelativeSource={RelativeSource Self}}" Value="礫質土">
                <Setter Property="Foreground" Value="DarkGreen"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ═══════════════════════ Fluent.Ribbon カスタムチューニング ═══════════════════════
         Light.Blue テーマ (App.xaml で読込) をベースに、ブランド色 (NikkenSkyBlue #62B0E2)
         を活かす微調整を加える。テーマ自体は変えず、暗黙 Style で部分上書きする方針。
         - RibbonGroupBox.Header: ライト青みの太字 (グループ境界が際立つ)
         - RibbonTabItem 選択中: NikkenSkyBlue 下線 (アクティブタブが見やすい)
         - 角丸 / 余白の微調整は控えめに (テーマと整合)
    -->
    <Style TargetType="{x:Type Fluent:RibbonGroupBox}">
        <Setter Property="Foreground" Value="{StaticResource PrimaryAccentDarkBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}"/>
    </Style>
    <!--
        補足: Fluent:RibbonTabItem の選択時下線は Fluent.Ribbon 内部の ControlTemplate で
        制御されているため、暗黙 Style での Background 上書きは効かないことが多い。
        必要に応じてリソース上書き (Fluent:Ribbon.Brushes.*) を試す手があるが、
        テーマ全体に影響するため今回は範囲を限定し、Foreground / FontWeight 系のみ調整。
    -->
    <Style TargetType="{x:Type Fluent:RibbonTabItem}">
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{StaticResource PrimaryAccentDarkBrush}"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource PrimaryAccentDarkBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══════════════════════ ComboBox フラット白スタイル ═══════════════════════
         WPF 標準 (Aero) の ComboBox は灰色グラデーションだが、Fluent.Ribbon の
         メニュー側 ComboBox は白フラット。本スタイルは両者の見た目を「白フラット」
         に統一する。implicit (キー無し) で全 ComboBox に適用。
         keyed style (GranularityClassComboBoxStyle 等) は BasedOn でこのスタイルを継承。
    -->
    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="bg"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            SnapsToDevicePixels="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="1"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="#555555"
                                                  Stretch="None"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="6,2,20,2"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          IsHitTestVisible="False"
                                          SnapsToDevicePixels="True"/>
                        <TextBox x:Name="PART_EditableTextBox"
                                 Margin="6,2,20,2"
                                 HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                 VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                 Background="Transparent"
                                 Foreground="{TemplateBinding Foreground}"
                                 BorderThickness="0"
                                 Visibility="Collapsed"
                                 IsReadOnly="{TemplateBinding IsReadOnly}"
                                 Focusable="True"/>
                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Slide">
                            <Border Background="White"
                                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                                    BorderThickness="1"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer SnapsToDevicePixels="True"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto">
                                    <!-- ItemsPresenter は GroupStyle (CollectionViewSource.GroupDescriptions) を
                                         尊重して項目をレンダリングする。StackPanel IsItemsHost ではグループが
                                         展開されず先頭グループの先頭要素しか表示されない問題があった。 -->
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"
                                                    SnapsToDevicePixels="True"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource ReadOnlyBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- (Button implicit スタイルは Styles.xaml:341 で既に定義済み — 重複削除) -->

    <!-- ComboBox の項目スタイル (ホバー: 極薄ライトブルー、選択: 薄ライトブルー) -->
    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="bg"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{StaticResource PrimaryAccentLightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{StaticResource PrimaryAccentMediumBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════ 右寄せ・見出し (各ウィンドウの重複を集約) ═══════════════ -->
    <!--
        以前は同じスタイルが画面ごとに書かれており、YellowHeaderStyle は 6 箇所で
        既に中身が食い違っていた。直したつもりが一部の画面に効かない状態だったので、
        ここに 1 つずつ置く。

        右寄せの 2 系統は名前が似ているが別物なので、統合せずに両方置く。
          ・RightAlignedTextBlockStyle … 枠内で右に寄せる  (HorizontalAlignment + TextAlignment)
          ・RightAlignTextBlockStyle   … 文字だけ右に寄せる (TextAlignment のみ)
        枠いっぱいに広がるセルでは前者、幅が内容に追従する場所では後者、という使い分け。
    -->

    <Style x:Key="RightAlignedTextBlockStyle" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="TextAlignment" Value="Right"/>
    </Style>

    <Style x:Key="RightAlignTextBlockStyle" TargetType="TextBlock">
        <Setter Property="TextAlignment" Value="Right"/>
    </Style>

    <!-- 杭要素分割の表だけは縦中央にも寄せる (行の高さが内容でばらつくため) -->
    <Style x:Key="RightAlignCenteredTextBlockStyle" TargetType="TextBlock"
           BasedOn="{StaticResource RightAlignTextBlockStyle}">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="RightAlignedCell" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Margin" Value="4,0"/>
    </Style>

    <Style x:Key="RightAlignedDataCellStyle" TargetType="DataGridCell">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
    </Style>

    <Style x:Key="YellowHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Foreground" Value="{StaticResource NikkenYellowBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
</ResourceDictionary>