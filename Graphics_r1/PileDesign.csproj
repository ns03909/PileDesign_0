<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
	<Nullable>enable</Nullable>

	<!-- 警告ベースライン: 既存の C# 警告は段階的に解消するため「警告のまま」許容するが、
	     上記リストに含まれない「新種」の警告は即エラーで止めて回帰を防ぐ。
	     コードを修正したら下記リストから該当コードを削除して strict 化する。
	     2026-04-29 baseline (全 6076 警告 → 29 種類のコードを許容)。-->
	<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	<!-- 解消済: CS0067 CS0108 CS0169 CS0414 CS1717 CS8073 CS8321 CS8621 CS8765 CS8767 CS9113 (2026-04-29) / CS0168 CS0219 (2026-05-11) -->
	<WarningsNotAsErrors>CS0162;CS0649;CS4014;CS8600;CS8601;CS8602;CS8603;CS8604;CS8605;CS8612;CS8618;CS8619;CS8622;CS8625;CS8629;NU1701</WarningsNotAsErrors>
    <OutputType>WinExe</OutputType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>

    <!-- アプリケーションアイコン -->
    <ApplicationIcon>Icons\ApplicationIcon\ApplicationIcon.ico</ApplicationIcon>

    <!-- バージョン管理 -->
    <Version>1.0.11-beta</Version>
    <AssemblyVersion>1.0.11.0</AssemblyVersion>
    <FileVersion>1.0.11.0</FileVersion>
    <InformationalVersion>1.0.11-beta</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- Release時のPDB除外（publish時のサイズ削減） -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- テストプロジェクトからinternalクラスにアクセス可能にする -->
  <ItemGroup>
    <InternalsVisibleTo Include="TestProject1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="PileNode.cs" />
    <Compile Remove="RestoringForce.cs" />
    <Compile Remove="ViewModels\LoadCaseCommon.cs" />
  </ItemGroup>

  <!--
    Icons/ -> Help/icons/ build-time sync.
    Single edit location: Icons/ (the original WPF icon folder).
    Before each build, mirror Icons/X to Help/icons/X for every filename present in Help/icons/
    (the 92 icons referenced by help.html). help.html keeps using relative 'icons/X.png' paths.
    Icons/-only files (287) stay where they are.
    Note: Help/icons/ remains tracked in git so users without a recent build still see icons in the help.
  -->
  <Target Name="SyncIconsToHelpIcons" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <_HelpIconDest Include="Help\icons\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_HelpIconDest -> 'Icons\%(Filename)%(Extension)')" DestinationFiles="@(_HelpIconDest)" SkipUnchangedFiles="true" OverwriteReadOnlyFiles="true" />
  </Target>

