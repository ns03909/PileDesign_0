<Window x:Class="PileDesign.Views.FoundationBeamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PileDesign.Views"
        xmlns:models="clr-namespace:PileDesign.Models.InputData"
        mc:Ignorable="d"
        Title="基礎梁入力" Height="650" Width="900"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <ObjectDataProvider x:Key="ConnectionModeEnum" MethodName="GetValues" ObjectType="{x:Type models:FoundationBeamConnectionMode}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:FoundationBeamConnectionMode"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 接続モード選択 -->
        <GroupBox Grid.Row="0" Header="接続モード" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="10">
                <TextBlock Text="接続方式:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Width="200" SelectedItem="{Binding ConnectionMode, Mode=TwoWay}"
                          ItemsSource="{Binding Source={StaticResource ConnectionModeEnum}}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0}">
                                        <Binding />
                                    </MultiBinding>
                                </TextBlock.Text>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="RigidBody">
                                                <Setter Property="Text" Value="剛体連結"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding}" Value="RigidFloor">
                                                <Setter Property="Text" Value="剛床連結"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </GroupBox>

        <!-- 基礎梁節点 -->
        <GroupBox Grid.Row="1" Header="基礎梁節点" Margin="0,0,0,5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0" ItemsSource="{Binding Nodes}"
                          SelectedItem="{Binding SelectedNode}" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" Margin="5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="No" Binding="{Binding No}" IsReadOnly="True" Width="50"/>
                        <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="120"/>
                        <DataGridTextColumn Header="X (m)" Binding="{Binding X, StringFormat=N3}" Width="*"/>
                        <DataGridTextColumn Header="Y (m)" Binding="{Binding Y, StringFormat=N3}" Width="*"/>
                        <DataGridTextColumn Header="Z (m)" Binding="{Binding Z, StringFormat=N3}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
                    <Button Content="追加" Width="80" Margin="0,0,5,0" Command="{Binding AddNodeCommand}"/>
                    <Button Content="削除" Width="80" Click="DeleteNodeButton_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- 基礎梁要素 -->
        <GroupBox Grid.Row="2" Header="基礎梁要素" Margin="0,5,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0" ItemsSource="{Binding Beams}"
                          SelectedItem="{Binding SelectedBeam}" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" Margin="5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="No" Binding="{Binding No}" IsReadOnly="True" Width="50"/>
                        <DataGridTextColumn Header="断面名" Binding="{Binding SectionName}" Width="100"/>
                        <DataGridTextColumn Header="I端節点" Binding="{Binding NodeI_No}" Width="70"/>
                        <DataGridTextColumn Header="J端節点" Binding="{Binding NodeJ_No}" Width="70"/>
                        <DataGridTextColumn Header="幅 (m)" Binding="{Binding Width, StringFormat=N3}" Width="80"/>
                        <DataGridTextColumn Header="高さ (m)" Binding="{Binding Height, StringFormat=N3}" Width="80"/>
                        <DataGridTextColumn Header="ヤング係数 (kN/m²)" Binding="{Binding YoungModulus, StringFormat=E2}" Width="*"/>
                        <DataGridTextColumn Header="せん断係数 (kN/m²)" Binding="{Binding ShearModulus, StringFormat=E2}" Width="*"/>
                        <DataGridTextColumn Header="アングルβ (°)" Binding="{Binding AngleBeta, StringFormat=N1}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
                    <Button Content="追加" Width="80" Margin="0,0,5,0" Command="{Binding AddBeamCommand}"/>
                    <Button Content="削除" Width="80" Click="DeleteBeamButton_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- OK/Cancel ボタン -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="100" Margin="0,0,10,0" Command="{Binding OkCommand}" IsDefault="True"/>
            <Button Content="キャンセル" Width="100" Command="{Binding CancelCommand}" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
