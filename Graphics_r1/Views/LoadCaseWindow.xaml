<Window x:Class="PileDesign.Views.LoadCaseWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PileDesign.ViewModels"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:svg="http://sharpvectors.codeplex.com/runtime/"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        xmlns:common="clr-namespace:PileDesign.Common"
        xmlns:conv="clr-namespace:PileDesign.Converters"
        xmlns:controls="clr-namespace:WpfMath.Controls;assembly=WpfMath"
        d:DataContext="{d:DesignInstance Type=local:LoadCaseViewModel}"
        mc:Ignorable="d"
        Title="荷重" Height="700" Width="1000" WindowState="Maximized"
        SizeChanged="Window_SizeChanged"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <!-- 追加: Ctrl+Enter で OkCommand を実行 -->
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding OkCommand}" />
        <!-- 追加: Esc で CancelCommand を実行 -->
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <common:BindingProxy x:Key="ViewModelProxy" Data="{Binding}" />
        <conv:CountLargerVisibilityConverter x:Key="CountLargerVisibilityConverter"/>
        <conv:CountSmallerVisibilityConverter x:Key="CountSmallerVisibilityConverter"/>
        <conv:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
        <conv:DoubleEqualsToVisibilityConverter x:Key="DoubleEqualsToVisibilityConverter"/>
        <conv:DoubleNotEqualsToVisibilityConverter x:Key="DoubleNotEqualsToVisibilityConverter"/>
        <conv:LoadCaseLevelToColorConverter x:Key="LoadCaseLevelToColorConverter"/>

        <!-- FormulaControlに適用するスタイルを定義 -->
        <Style x:Key="FormulaControlStyle" TargetType="controls:FormulaControl">
            <Setter Property="Scale" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RightAlignedTextBlockStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <Style x:Key="RightAlignedDataCellStyle" TargetType="DataGridCell">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <Style x:Key="RightAlignedGreyTextBlockStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="Gray"/>
        </Style>

        <ContextMenu x:Key="CommonDataGridContextMenu" Opened="ContextMenu_Opened">
            <MenuItem Click="ExportCsvFromContextMenu_Click">
                <MenuItem.Icon>
                    <svgc:SvgViewbox Source="/Icons/CSVFileOutput.svg" Style="{StaticResource SvgIconStyle}"/>
                </MenuItem.Icon>
                <MenuItem.Header>
                    <TextBlock Text="CSVファイル出力"/>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem Header="コピー" Command="{Binding CopyDataGridSelectionCommand}"
                      CommandParameter="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="※各荷重条件における杭軸力はメイン画面左ペインの「杭」/「軸力」タブで入力します" Grid.Row="0"/>
        <TabControl x:Name="MainTabControl" Grid.Row="1">
            <TabItem x:Name="TabItemOverlap" Header="上部構造・基礎部、地盤の作用の重ね合わせ">
                <Grid x:Name="OverlapContent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="150"/>
                    </Grid.RowDefinitions>

                    <Canvas x:Name="LoadCombinationCanvas" 
                            Grid.Row="1" Grid.Column="0" Grid.RowSpan="2"
                            Background="AliceBlue" Margin="10,10,10,10"/>

                    <Grid  Grid.Row="1" Grid.Column="1" Margin="10,10, 10,10" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                            <Run Text="α"/>
                            <Run Text="L" BaselineAlignment="Subscript" FontSize="10"/>
                        </TextBlock>
                        <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center">
                            <Run Text="：杭曲げモーメント最大時の地盤変位／地盤変位の最大値"/>
                        </TextBlock>

                        <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
                            <Run Text="D"/>
                        </TextBlock>
                        <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center">
                            <Run Text="：地盤変位の最大値"/>
                        </TextBlock>

                        <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">
                            <Run Text="β"/>
                            <Run Text="U" BaselineAlignment="Subscript" FontSize="10"/>
                        </TextBlock>

                        <TextBlock  Grid.Row="2" Grid.Column="2" VerticalAlignment="Center">
                            <Run Text="：杭曲げモーメント最大時の上部構造慣性力／上部構造慣性力の最大値"/>
                        </TextBlock>

                        <TextBlock Grid.Row="3" Grid.Column="1" VerticalAlignment="Center">
                            <Run Text="P"/>
                            <Run Text="s" BaselineAlignment="Subscript" FontSize="10"/>
                        </TextBlock>

                        <TextBlock  Grid.Row="3" Grid.Column="2" VerticalAlignment="Center">
                            <Run Text="：上部構造慣性力の最大値"/>
                        </TextBlock>

                        <TextBlock Grid.Row="4" Grid.Column="1" VerticalAlignment="Center">
                            <Run Text="β"/>
                            <Run Text="L" BaselineAlignment="Subscript" FontSize="10"/>
                        </TextBlock>

                        <TextBlock  Grid.Row="4" Grid.Column="2" VerticalAlignment="Center">
                            <Run Text="：杭曲げモーメント最大時の基礎部慣性力／基礎部慣性力の最大値"/>
                        </TextBlock>

                        <TextBlock Grid.Row="5" Grid.Column="1" VerticalAlignment="Center">
                            <Run Text="P"/>
                            <Run Text="f" BaselineAlignment="Subscript" FontSize="10"/>
                        </TextBlock>

                        <TextBlock  Grid.Row="5" Grid.Column="2" VerticalAlignment="Center">
                            <Run Text="：基礎部慣性力の最大値"/>
                        </TextBlock>


                        <Grid Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Foreground="Red" Text="・" VerticalAlignment="Top"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Foreground="Red" TextWrapping="Wrap"
                                Text="上部構造慣性力および基礎部慣性力は慣性力中心位置に作用させます。"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Foreground="Red" Text="・" VerticalAlignment="Top"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Foreground="Red" TextWrapping="Wrap"
                                Text="転倒モーメントは各杭への軸方向力の直接入力により生じさせます。"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Foreground="Red" Text="・" VerticalAlignment="Top"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Foreground="Red" TextWrapping="Wrap"
                                Text="現状、各杭に入力する軸方向力は、"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Foreground="Red"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Foreground="Red" TextWrapping="Wrap">
                                <Run Text="上部構造変動成分、基礎部変動成分を分けておらず、それぞれ"/>
                                <Run Text="β"/>
                                <Run Text="U" BaselineAlignment="Subscript" FontSize="10"/>
                                <Run Text="、"/>
                                <Run Text="β"/>
                                <Run Text="L" BaselineAlignment="Subscript" FontSize="10"/>
                                <Run Text="の乗算を考慮しません。"/>
                            </TextBlock>
                            <TextBlock Grid.Row="4" Grid.Column="1" Foreground="Red" TextWrapping="Wrap"
                                Text="(杭軸力はすべての重ね合わせケースで同一)"/>
                        </Grid>

                    </Grid>

                    <StackPanel Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center">
                            <Run Text="基礎指針'19　表6.6.2　建物の固有周期"/>
                            <Run Text="T"/>
                            <Run Text="b" BaselineAlignment="Subscript" FontSize="10"/>
                            <Run Text="と地盤の固有周期"/>
                            <Run Text="T"/>
                            <Run Text="g" BaselineAlignment="Subscript" FontSize="10"/>
                            <Run Text="の比と低減係数"/>
                        </TextBlock>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border BorderThickness="1" BorderBrush="#888"  Grid.Row="0" Grid.Column="0">

                            </Border>
                            <Border BorderThickness="1" BorderBrush="#888"  Grid.Row="0" Grid.Column="1">
                                <TextBlock Text="低減係数" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border BorderThickness="1" BorderBrush="#888" Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="上部構造慣性力と地盤変位の位相" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border BorderThickness="1" BorderBrush="#888" Grid.Row="0" Grid.Column="3">
                                <TextBlock Text="重ね合わせケース数" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <Border BorderThickness="1" BorderBrush="#888"  Grid.Row="1" Grid.Column="0">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                                <controls:FormulaControl Formula="T_b/T_g \lt 1" Style="{StaticResource FormulaControlStyle}" HorizontalContentAlignment="Right"/>
                                </TextBlock>
                            </Border>
                            <Border BorderThickness="1" BorderBrush="#888"  Grid.Row="1" Grid.Column="1">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                                <controls:FormulaControl Formula="\alpha_L=\beta_U=\beta_L=1" Style="{StaticResource FormulaControlStyle}" HorizontalContentAlignment="Right"/>
                                </TextBlock>
                            </Border>
                            <Border BorderThickness="1" BorderBrush="#888" Grid.Row="1" Grid.Column="2">
                                <TextBlock Text="同位相" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border BorderThickness="1" BorderBrush="#888" Grid.Row="1" Grid.Column="3">
                                <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <Border BorderThickness="1" BorderBrush="#888"  Grid.Row="2" Grid.RowSpan="2" Grid.Column="0">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                                <controls:FormulaControl Formula="T_b/T_g \approx  1" Style="{StaticResource FormulaControlStyle}" HorizontalContentAlignment="Right"/>
                                </TextBlock>
                            </Border>
                            <Border BorderThickness="1" BorderBrush="#888"  Grid.Row="2" Grid.Column="1">
                                <StackPanel>
                                    <TextBlock Text="地盤変位が卓越"/>
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <controls:FormulaControl Formula="\alpha_L=\beta_L=1, 0.5 \lt \beta_U \lt 1" Style="{StaticResource FormulaControlStyle}" HorizontalContentAlignment="Right"/>
                                    </TextBlock>
                                </StackPanel>

                            </Border>
                            <Border BorderThickness="1" BorderBrush="#888" Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="同位相および逆位相" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border BorderThickness="1" BorderBrush="#888" Grid.Row="2" Grid.RowSpan="2" Grid.Column="3">
                                <TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <Border BorderThickness="1" BorderBrush="#888"  Grid.Row="3" Grid.Column="1">
                                <StackPanel>
                                    <TextBlock Text="上部構造慣性力が卓越"/>
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <controls:FormulaControl Formula="\beta_U=1,0.5 \lt \alpha_L=\beta_L \lt 1" Style="{StaticResource FormulaControlStyle}" HorizontalContentAlignment="Right"/>
                                    </TextBlock>
                                </StackPanel>

                            </Border>
                            <Border BorderThickness="1" BorderBrush="#888" Grid.Row="3" Grid.Column="2">
                                <TextBlock Text="同位相および逆位相" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>


                            <Border BorderThickness="1" BorderBrush="#888"  Grid.Row="4" Grid.RowSpan="2" Grid.Column="0">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                                <controls:FormulaControl Formula="T_b/T_g \gt  1" Style="{StaticResource FormulaControlStyle}" HorizontalContentAlignment="Right"/>
                                </TextBlock>
                            </Border>
                            <Border BorderThickness="1" BorderBrush="#888"  Grid.Row="4" Grid.Column="1">
                                <StackPanel>
                                    <TextBlock Text="地盤変位が卓越"/>
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <controls:FormulaControl Formula="\alpha_L=\beta_L=1, \beta_U=0.5" Style="{StaticResource FormulaControlStyle}" HorizontalContentAlignment="Right"/>
                                    </TextBlock>
                                </StackPanel>

                            </Border>
                            <Border BorderThickness="1" BorderBrush="#888" Grid.Row="4" Grid.Column="2">
                                <TextBlock Text="同位相および逆位相" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <Border BorderThickness="1" BorderBrush="#888"  Grid.Row="5" Grid.Column="1">
                                <StackPanel>
                                    <TextBlock Text="上部構造慣性力が卓越"/>
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <controls:FormulaControl Formula="\beta_U=1,  \alpha_L=\beta_L =0.5" Style="{StaticResource FormulaControlStyle}" HorizontalContentAlignment="Right"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border BorderThickness="1" BorderBrush="#888" Grid.Row="4" Grid.RowSpan="2" Grid.Column="3">
                                <TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <Border BorderThickness="1" BorderBrush="#888" Grid.Row="5" Grid.Column="2">
                                <TextBlock Text="同位相および逆位相" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">

                        <Slider x:Name="SliderLoadCombinationFactor" HorizontalAlignment="Center"
                            Minimum="0.5" Maximum="1.0" TickFrequency="0.1" 
                            Value="{Binding LoadCombinationFactor, UpdateSourceTrigger=PropertyChanged}"
                            VerticalAlignment="Center" Width="100"  
                            TickPlacement="BottomRight" IsSnapToTickEnabled="True">

                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="ValueChanged">
                                    <i:InvokeCommandAction Command="{Binding SliderValueChangedCommand}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>

                            <Slider.ToolTip>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="0.5から1.0までの数値を入力"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Tb/Tg＜1" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="：" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="1.0" HorizontalAlignment="Center"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Tb/Tg≒1" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="：" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="0.5～1.0" HorizontalAlignment="Center"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="1＜Tb/Tg" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="：" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="0.5" HorizontalAlignment="Center"/>
                                </Grid>

                            </Slider.ToolTip>
                        </Slider>
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="0.5" HorizontalAlignment="Center"/>
                            <!--<TextBlock Grid.Column="1" Text="0.6" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="0.7" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="0.8" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="0.9" HorizontalAlignment="Center"/>-->
                            <TextBlock Grid.Column="5" Text="1.0" HorizontalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <common:EnhancedDataGrid Grid.Row="3" Grid.Column ="1"  x:Name="DataGridLoadCombination"  AutoGenerateColumns="False"
                        CanUserAddRows="False" 
                        LoadingRow="DataGrid_LoadingRow_Numbering"
                        VerticalAlignment="Center"
                        ItemsSource="{Binding LoadCombinations}" 
                        CellStyle="{StaticResource CustomDataGridCellStyle}"
                        CellEditEnding="DataGridLoadCombination_CellEditEnding"
                        Margin="50,10,50,10">

                        <i:Interaction.Behaviors>
                            <common:DataGridSingleClickEditBehavior />
                        </i:Interaction.Behaviors>

                        <common:EnhancedDataGrid.AlternatingRowBackground>
                            <ImageBrush/>
                        </common:EnhancedDataGrid.AlternatingRowBackground>

                        <common:EnhancedDataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </common:EnhancedDataGrid.ColumnHeaderStyle>

                        <common:EnhancedDataGrid.ContextMenu>
                            <StaticResource ResourceKey="CommonDataGridContextMenu"/>
                        </common:EnhancedDataGrid.ContextMenu>

                        <common:EnhancedDataGrid.Columns>

                            <DataGridCheckBoxColumn Binding="{Binding IsApplicable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                Header="適用" Width="*" />

                            <DataGridTextColumn Width="*" Binding="{Binding Alpha1, StringFormat=N1}" IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}">
                                <DataGridTextColumn.Header>
                                    <TextBlock>
                                    <Run Text="α"/>
                                    <Run Text="L" BaselineAlignment="Subscript" FontSize="10"/>
                                        
                                    </TextBlock>
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Width="*" Binding="{Binding Beta1, StringFormat=N1}" IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}">
                                <DataGridTextColumn.Header>
                                    <TextBlock>
                                    <Run Text="β"/>
                                    <Run Text="U" BaselineAlignment="Subscript" FontSize="10"/>
                                    </TextBlock>
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Width="*" Binding="{Binding Beta2, StringFormat=N1}" IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}">
                                <DataGridTextColumn.Header>
                                    <TextBlock>
                                    <Run Text="β"/>
                                    <Run Text="L" BaselineAlignment="Subscript" FontSize="10"/>
                                    </TextBlock>
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                        </common:EnhancedDataGrid.Columns>
                    </common:EnhancedDataGrid>
                </Grid>
            </TabItem>

            <TabItem x:Name="TabItemLoadCase" Header="荷重ケース">

                <Grid x:Name="LoadCaseContent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0" Grid.Column="0">
                        <GroupBox.Header>
                            <TextBlock Text="レベル1地震荷重" FontWeight="Bold"/>
                        </GroupBox.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="共通入力" Foreground="{StaticResource PrimaryAccentBrush}" Grid.Row="0" Grid.Column="0"/>

                            <common:EnhancedDataGrid x:Name="DataGridCommonLoadCase1"
                                ItemsSource="{Binding LoadCasesLevel1Common, UpdateSourceTrigger=LostFocus}"
                                AutoGenerateColumns="False" CanUserAddRows="False"
                                ScrollViewer.VerticalScrollBarVisibility="Visible"
                                LoadingRow="DataGrid_LoadingRow_Numbering"
                                CellStyle="{StaticResource CustomDataGridCellStyle}"
                                CellEditEnding="DataGridCommonLoadCase1_CellEditEnding"
                                Grid.Row="1" Grid.Column="0">

                                <common:EnhancedDataGrid.AlternatingRowBackground>
                                    <ImageBrush/>
                                </common:EnhancedDataGrid.AlternatingRowBackground>

                                <common:EnhancedDataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryAccentBrush}" />
                                    </Style>
                                </common:EnhancedDataGrid.ColumnHeaderStyle>

                                <common:EnhancedDataGrid.ContextMenu>
                                    <StaticResource ResourceKey="CommonDataGridContextMenu"/>
                                </common:EnhancedDataGrid.ContextMenu>

                                <common:EnhancedDataGrid.Columns>
                                    <DataGridTextColumn Width="0.5*" IsReadOnly="true">
                                        <DataGridTextColumn.CellStyle>
                                            <Style TargetType="DataGridCell">
                                                <Setter Property="Background" Value="LightGray"/>
                                            </Style>
                                        </DataGridTextColumn.CellStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Width="*" IsReadOnly="true">
                                        <DataGridTextColumn.CellStyle>
                                            <Style TargetType="DataGridCell">
                                                <Setter Property="Background" Value="LightGray"/>
                                            </Style>
                                        </DataGridTextColumn.CellStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Width="*" IsReadOnly="true">
                                        <DataGridTextColumn.CellStyle>
                                            <Style TargetType="DataGridCell">
                                                <Setter Property="Background" Value="LightGray"/>
                                            </Style>
                                        </DataGridTextColumn.CellStyle>
                                    </DataGridTextColumn>

                                    <DataGridTemplateColumn Width="*">
                                        <DataGridTemplateColumn.Header>
                                            <StackPanel>
                                                <TextBlock Text="地盤" TextAlignment="Center"/>
                                                <TextBlock Text="非線形性" TextAlignment="Center"/>
                                            </StackPanel>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <CheckBox IsChecked="{Binding IsSoilNonLinear, UpdateSourceTrigger=PropertyChanged}"
                                                        HorizontalAlignment="Center" Height="18"/>
                                                    <Button x:Name="CommonLoadCase1IsSoilNonLinearButton" Content="適用"
