                                        <DataGridTextColumn Width="*" Binding="{Binding [0], StringFormat=N1}" IsReadOnly="True"
                                            ElementStyle="{StaticResource RightAlignedGreyTextBlockStyle}" MinWidth="50">
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Width="*" Binding="{Binding [1], StringFormat=N1}" IsReadOnly="True"
                                            ElementStyle="{StaticResource RightAlignedGreyTextBlockStyle}" MinWidth="50">
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Width="*" Binding="{Binding [2], StringFormat=N1}" IsReadOnly="True"
                                            ElementStyle="{StaticResource RightAlignedGreyTextBlockStyle}" MinWidth="50">
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Width="*" Binding="{Binding [3], StringFormat=N1}" IsReadOnly="True"
                                            ElementStyle="{StaticResource RightAlignedGreyTextBlockStyle}" MinWidth="50">
                                        </DataGridTextColumn>
                                    </common:EnhancedDataGrid.Columns>
                                </common:EnhancedDataGrid>
                            </Grid>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,4,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ButtonOk" Content="保存 (Ctrl+Enter)" HorizontalAlignment="Left"
                        VerticalAlignment="Top" Height="30" Width="150" Command="{Binding OkCommand}"/>
                <Button x:Name="ButtonCancel" Content="キャンセル (Esc)" HorizontalAlignment="Left"
                        VerticalAlignment="Top" Height="30" Width="150" Command="{Binding CancelCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>


</Window>
