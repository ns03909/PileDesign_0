<UserControl x:Class="PileDesign.Views.Controls.MaterialOptionRadioPair"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:PileDesign.Converters"
             x:Name="Root">
    <UserControl.Resources>
        <!-- InverseBool の TwoWay ペアはアンチェック時にも逆値を書き戻し、ウィンドウ再表示時に
             無限ループ → StackOverflow の危険があるため BoolEquals (チェック時のみ書く) に統一 -->
        <conv:BoolEqualsConverter x:Key="BoolEquals"/>

        <!-- 式サブテキスト: 未指定なら行ごと折りたたむ -->
        <Style x:Key="FormulaTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- 見出し + ヘルプリンク（無効化グループの影響を受けない） -->
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="{Binding Header, ElementName=Root}" FontWeight="SemiBold"/>
            <TextBlock Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center">
                <Hyperlink Click="HelpLink_Click" ToolTip="ヘルプの詳細説明を開く">ヘルプ</Hyperlink>
            </TextBlock>
        </StackPanel>

        <!-- 無効な理由: 灰色のラジオだけでは「なぜ変わらないのか」が読めないため、
             無効のときに限って理由を出す（AreRadiosEnabled の外に置き、灰色にしない） -->
        <TextBlock Margin="12,2,0,1" TextWrapping="Wrap" FontSize="11" Foreground="#A15C00"
                   Text="{Binding DisabledReason, ElementName=Root}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AreRadiosEnabled, ElementName=Root}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <!-- 理由が未指定なら、無効でも行を出さない（後勝ちのため最後に置く） -->
                        <Trigger Property="Text" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Text" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel IsEnabled="{Binding AreRadiosEnabled, ElementName=Root}">
            <!-- 既定（基礎部材の強度と変形性能）側 -->
            <RadioButton GroupName="{Binding GroupName, ElementName=Root}" Margin="12,1,0,1"
                         IsChecked="{Binding IsAlternativeSelected, ElementName=Root, Converter={StaticResource BoolEquals}, ConverterParameter=False}"
                         ToolTip="{Binding DefaultToolTip, ElementName=Root}">
                <StackPanel>
                    <TextBlock Text="{Binding DefaultText, ElementName=Root}" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource FormulaTextStyle}"
                               Text="{Binding DefaultFormula, ElementName=Root}"/>
                </StackPanel>
            </RadioButton>

            <!-- 代替オプション側 -->
            <RadioButton GroupName="{Binding GroupName, ElementName=Root}" Margin="12,1,0,1"
                         IsChecked="{Binding IsAlternativeSelected, ElementName=Root, Converter={StaticResource BoolEquals}, ConverterParameter=True}"
                         ToolTip="{Binding AlternativeToolTip, ElementName=Root}">
                <StackPanel>
                    <TextBlock Text="{Binding AlternativeText, ElementName=Root}" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource FormulaTextStyle}"
                               Text="{Binding AlternativeFormula, ElementName=Root}"/>
                </StackPanel>
            </RadioButton>
        </StackPanel>
    </StackPanel>
</UserControl>
