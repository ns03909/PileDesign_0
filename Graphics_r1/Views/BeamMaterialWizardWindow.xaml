<Window x:Class="PileDesign.Views.BeamMaterialWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PileDesign.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:BeamMaterialWizardViewModel}"
        Title="材料ウィザード" Height="500" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 材料No選択 -->
        <GroupBox Grid.Row="0" Header="編集対象" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="5">
                <Label Content="材料No" Width="80" HorizontalContentAlignment="Right"/>
                <ComboBox x:Name="ComboBoxMaterialNo" Width="100"
                          SelectionChanged="ComboBoxMaterialNo_SelectionChanged"/>
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="1">
            <GroupBox Header="入力パラメータ" Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Label Content="名称" Width="200" HorizontalContentAlignment="Right"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalContentAlignment="Right"
                                 GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Label Content="コンクリート強度 Fc (N/mm²)" Width="200" HorizontalContentAlignment="Right"/>
                        <TextBox x:Name="TextBoxFc" Text="{Binding Fc, StringFormat=N2}" Width="100" HorizontalContentAlignment="Right"
                                 GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                 TextChanged="TextBox_TextChanged"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Label Content="単位重量 γ (kN/m³)" Width="200" HorizontalContentAlignment="Right"/>
                        <TextBox x:Name="TextBoxGamma" Text="{Binding Gamma, StringFormat=N2}" Width="100" HorizontalContentAlignment="Right"
                                 GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                 TextChanged="TextBox_TextChanged"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Label Content="ポアソン比 ν" Width="200" HorizontalContentAlignment="Right"/>
                        <TextBox x:Name="TextBoxPoissonRatio" Text="{Binding PoissonRatio, StringFormat=N3}" Width="100" HorizontalContentAlignment="Right"
                                 GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                 TextChanged="TextBox_TextChanged"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="計算結果" Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Label Content="ヤング係数 Ec (N/mm²)" Width="200" HorizontalContentAlignment="Right"/>
                        <TextBox Text="{Binding Ec, StringFormat=N2, Mode=OneWay}" Width="100" HorizontalContentAlignment="Right"
                                 IsReadOnly="True" Background="LightGray"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Label Content="せん断弾性係数 G (N/mm²)" Width="200" HorizontalContentAlignment="Right"/>
                        <TextBox Text="{Binding G, StringFormat=N2, Mode=OneWay}" Width="100" HorizontalContentAlignment="Right"
                                 IsReadOnly="True" Background="LightGray"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="2" Margin="0,10,0,0">
            <Button Content="適用" Width="80" Click="ApplyButton_Click" Margin="0,0,5,0"
                    ToolTip="現在の設定を適用して編集を続けます"/>
            <Button Content="OK" Width="80" Click="OkButton_Click" IsDefault="True" Margin="0,0,5,0"
                    ToolTip="現在の設定を適用して閉じます"/>
            <Button Content="Cancel" Width="80" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
