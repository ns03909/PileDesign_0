<Window x:Class="PileDesign.Views.HistoryPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="clr-namespace:PileDesign.Common"
        Title="編集履歴"
        Width="420" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        common:EscapeKeyBehavior.Enable="True">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <TextBlock Grid.Row="0" Text="編集履歴" FontSize="16" FontWeight="SemiBold"
                   Foreground="{StaticResource PrimaryAccentBrush}" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" x:Name="SubText" Foreground="#888" FontSize="11" Margin="0,0,0,8"/>

        <!-- 履歴リスト -->
        <Border Grid.Row="2" BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1" CornerRadius="3">
            <ListBox x:Name="HistoryListBox" BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     SelectionChanged="HistoryListBox_SelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding IndexLabel}" Foreground="#999" FontSize="11"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" Foreground="{Binding TitleBrush}"
                                           FontWeight="{Binding FontWeight}"/>
                                <TextBlock Text="{Binding Description}" Foreground="#888" FontSize="11"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding TimeText}" Foreground="#999" FontSize="11"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <TextBlock Grid.Column="3" Text="◀ 現在" Foreground="{StaticResource PrimaryAccentBrush}"
                                       FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"
                                       Margin="8,0,0,0"
                                       Visibility="{Binding IsCurrentVisibility}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- フッター -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="HintText" Text="クリックでその状態へジャンプ"
                       Foreground="#888" FontSize="11" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Content="閉じる" IsCancel="True" Padding="12,4"/>
        </Grid>
    </Grid>
</Window>
