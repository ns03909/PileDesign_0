                            <i:EventTrigger EventName="PreviewKeyDown">
                                <!--<i:InvokeCommandAction Command="{Binding PileBodyTextChangedCommand}" CommandParameter="{Binding ElementName=TextBoxPileTopAltitude}" />-->
                                <i:InvokeCommandAction Command="{Binding PileBodyTextChangedCommand}"/>

                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </TextBox>
                    <TextBlock Text="m"/>
                </StackPanel>

