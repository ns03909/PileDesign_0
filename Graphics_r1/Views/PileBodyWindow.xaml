                    <ComboBoxItem Content="L1"/>
                    <ComboBoxItem Content="L2"/>
                </ComboBox>
            </StackPanel>


            <StackPanel Visibility="{Binding IsGroundLayerOverwrapped, 
                    Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="地盤No" Width="50"/>
                    <ComboBox ItemsSource="{Binding InputModel.GroundsInputCountList}" SelectedItem="{Binding SelectedGroundNo}" Width="50">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding PileBodyTextChangedCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
