                    <TextBlock Text="杭先端N値" Width="75"/>
                    <TextBox Text="{Binding TemporarySoilPile.PileToeNValue, StringFormat=N1, Mode=OneWay}" 
                             IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}" Width="50"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
