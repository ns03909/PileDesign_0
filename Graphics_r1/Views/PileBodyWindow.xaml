                    <TextBox Text="{Binding TemporarySoilPile.PileToeNValueAverageRangeLowerAltitude, StringFormat=N1, Mode=OneWay}" 
                             IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}" Width="50"/>
                    <TextBlock Text="m" Width="50"/>
                </StackPanel>-->

                <StackPanel>
                    <!-- 地盤描画ペイン: SettlementWindow と統一した列幅 (ラベル *, 数式 40, 値 60, 単位 48) -->
                    <Grid Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
