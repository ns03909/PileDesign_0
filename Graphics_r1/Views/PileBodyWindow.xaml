                                    <Binding Path="InputModel.FundamentalInput.ReferenceAltitude"/>
                                </MultiBinding>
                            </TextBox.Text>
                        </TextBox>
                        <TextBlock Grid.Row="10" Grid.Column="3" Text="m" FontSize="11" Margin="2,0,0,0"/>
                        <TextBlock Grid.Row="11" Grid.Column="1" Text="Z=" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
                        <TextBox Grid.Row="11" Grid.Column="2" Text="{Binding TemporarySoilPile.PileToeNValueAverageRangeUpperAltitude, Mode=OneWay, StringFormat=N3}" IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}" HorizontalContentAlignment="Right" FontSize="11"/>
                        <TextBlock Grid.Row="11" Grid.Column="3" Text="m" FontSize="11" Margin="2,0,0,0"/>

                        <!-- 杭先端: ラベル RowSpan=2 + 標高/Z= -->
                        <TextBlock Grid.Row="12" Grid.RowSpan="2" Grid.Column="0"
                            Text="杭先端" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="12" Grid.Column="1" Text="標高=" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
                        <TextBox Grid.Row="12" Grid.Column="2" IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}" HorizontalContentAlignment="Right" FontSize="11">
                            <TextBox.Text>
                                <MultiBinding Converter="{StaticResource ZElevationConverter}" StringFormat="{}{0:N3}" Mode="OneWay">
                                    <Binding Path="TemporarySoilPile.PileBottomAltitude"/>
                                    <Binding Path="InputModel.FundamentalInput.ReferenceAltitude"/>
                                </MultiBinding>
                            </TextBox.Text>
                        </TextBox>
                        <TextBlock Grid.Row="12" Grid.Column="3" Text="m" FontSize="11" Margin="2,0,0,0"/>
                        <TextBlock Grid.Row="13" Grid.Column="1" Text="Z=" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
                        <TextBox Grid.Row="13" Grid.Column="2" Text="{Binding TemporarySoilPile.PileBottomAltitude, Mode=OneWay, StringFormat=N3}" IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}" HorizontalContentAlignment="Right" FontSize="11"/>
                        <TextBlock Grid.Row="13" Grid.Column="3" Text="m" FontSize="11" Margin="2,0,0,0"/>

                        <!-- 平均N値算定範囲 下端: ラベル RowSpan=2 + 標高/Z= -->
                        <TextBlock Grid.Row="14" Grid.RowSpan="2" Grid.Column="0"
                            Text="平均N値算定範囲 下端" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="14" Grid.Column="1" Text="標高=" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
                        <TextBox Grid.Row="14" Grid.Column="2" IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}" HorizontalContentAlignment="Right" FontSize="11">
                            <TextBox.Text>
                                <MultiBinding Converter="{StaticResource ZElevationConverter}" StringFormat="{}{0:N3}" Mode="OneWay">
                                    <Binding Path="TemporarySoilPile.PileToeNValueAverageRangeLowerAltitude"/>
                                    <Binding Path="InputModel.FundamentalInput.ReferenceAltitude"/>
                                </MultiBinding>
                            </TextBox.Text>
                        </TextBox>
                        <TextBlock Grid.Row="14" Grid.Column="3" Text="m" FontSize="11" Margin="2,0,0,0"/>
                        <TextBlock Grid.Row="15" Grid.Column="1" Text="Z=" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
                        <TextBox Grid.Row="15" Grid.Column="2" Text="{Binding TemporarySoilPile.PileToeNValueAverageRangeLowerAltitude, Mode=OneWay, StringFormat=N3}" IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}" HorizontalContentAlignment="Right" FontSize="11"/>
                        <TextBlock Grid.Row="15" Grid.Column="3" Text="m" FontSize="11" Margin="2,0,0,0"/>

                        <TextBlock Grid.Row="16" Grid.Column="0" Text="杭先端支持力度"/>
                        <controls:FormulaControl Grid.Row="16" Grid.Column="1" Formula="q_{pu}" Style="{StaticResource FormulaControlStyle}" HorizontalContentAlignment="Right"/>
                        <TextBox Grid.Row="16" Grid.Column="2"
                             Text="{Binding TemporarySoilPile.Qpu, Mode=OneWay, StringFormat=N0}"
                             IsReadOnly="True" Foreground="Gray" HorizontalContentAlignment="Right"/>
                        <TextBlock Grid.Row="16" Grid.Column="3"><Run Text="kN/m"/><Run Text="2" BaselineAlignment="Superscript" FontSize="9"/></TextBlock>

                        <TextBlock Grid.Row="17" Grid.Column="0" Text="杭先端面積"/>
                        <controls:FormulaControl Grid.Row="17" Grid.Column="1" Formula="A_p" Style="{StaticResource FormulaControlStyle}" HorizontalContentAlignment="Right"/>
                        <TextBox Grid.Row="17" Grid.Column="2"
                             Text="{Binding TemporarySoilPile.Ap, Mode=OneWay, StringFormat=N3}"
                             IsReadOnly="True" Foreground="Gray" HorizontalContentAlignment="Right"/>
                        <TextBlock Grid.Row="17" Grid.Column="3"><Run Text="m"/><Run Text="2" BaselineAlignment="Superscript" FontSize="9"/></TextBlock>

                        <TextBlock Grid.Row="18" Grid.Column="0" Text="極限先端支持力"/>
                        <controls:FormulaControl Grid.Row="18" Grid.Column="1" Formula="R_{pu}" Style="{StaticResource FormulaControlStyle}" HorizontalContentAlignment="Right"/>
                        <TextBox Grid.Row="18" Grid.Column="2"
                             Text="{Binding TemporarySoilPile.Rpu, Mode=OneWay, StringFormat=N0}"
                             IsReadOnly="True" Foreground="Gray" HorizontalContentAlignment="Right"/>
                        <TextBlock Grid.Row="18" Grid.Column="3" Text="kN"/>


                        <TextBlock Grid.Row="24" Grid.Column="0" Text="極限周面抵抗力"/>
                        <controls:FormulaControl Grid.Row="24" Grid.Column="1" Formula="R_{fu}" Style="{StaticResource FormulaControlStyle}" HorizontalContentAlignment="Right"/>
                        <TextBox Grid.Row="24" Grid.Column="2"
                             Text="{Binding TemporarySoilPile.Rfu, Mode=OneWay, StringFormat=N0}" IsReadOnly="True"
                             Foreground="Gray" HorizontalContentAlignment="Right"/>
                        <TextBlock Grid.Row="24" Grid.Column="3" Text="kN"/>


                        <TextBlock Grid.Row="25" Grid.Column="0" Text="終局限界引抜力" Foreground="{StaticResource UltimateLimitBrush}"/>
                        <controls:FormulaControl Grid.Row="25" Grid.Column="1" Formula="R_{t,UL}" Style="{StaticResource FormulaControlStyle}" HorizontalContentAlignment="Right" Foreground="{StaticResource UltimateLimitBrush}"/>
                        <TextBox Grid.Row="25" Grid.Column="2"
                             Text="{Binding TemporarySoilPile.Rt_ULS, Mode=OneWay, StringFormat=N0}" IsReadOnly="True"
                             Foreground="{StaticResource UltimateLimitBrush}" HorizontalContentAlignment="Right"/>
                        <TextBlock Grid.Row="25" Grid.Column="3" Text="kN" Foreground="{StaticResource UltimateLimitBrush}"/>


                        <TextBlock Grid.Row="26" Grid.Column="0" Text="{Binding Converter={StaticResource LimitStateLabelConverter}, ConverterParameter=損傷限界引抜力, FallbackValue=損傷限界引抜力}" Foreground="{StaticResource DamageLimitBrush}"/>
                        <controls:FormulaControl Grid.Row="26" Grid.Column="1" Formula="R_{t,DL}" Style="{StaticResource FormulaControlStyle}" HorizontalContentAlignment="Right" Foreground="{StaticResource DamageLimitBrush}"/>
                        <TextBox Grid.Row="26" Grid.Column="2"
                             Text="{Binding TemporarySoilPile.Rt_DLS, Mode=OneWay, StringFormat=N0}" IsReadOnly="True"
                             Foreground="{StaticResource DamageLimitBrush}" HorizontalContentAlignment="Right"/>
                        <TextBlock Grid.Row="26" Grid.Column="3" Text="kN" Foreground="{StaticResource DamageLimitBrush}"/>


                        <TextBlock Grid.Row="27" Grid.Column="0" Text="{Binding Converter={StaticResource LimitStateLabelConverter}, ConverterParameter=使用限界引抜力, FallbackValue=使用限界引抜力}" Foreground="{StaticResource ServiceLimitBrush}"/>
                        <controls:FormulaControl Grid.Row="27" Grid.Column="1" Formula="R_{t,SL}" Style="{StaticResource FormulaControlStyle}" HorizontalContentAlignment="Right" Foreground="{StaticResource ServiceLimitBrush}"/>
                        <TextBox Grid.Row="27" Grid.Column="2"
                             Text="{Binding TemporarySoilPile.Rt_SLS, Mode=OneWay, StringFormat=N0}" IsReadOnly="True"
                             Foreground="{StaticResource ServiceLimitBrush}" HorizontalContentAlignment="Right"/>
                        <TextBlock Grid.Row="27" Grid.Column="3" Text="kN" Foreground="{StaticResource ServiceLimitBrush}"/>


                        <TextBlock Grid.Row="28" Grid.Column="0" Text="{Binding Converter={StaticResource LimitStateLabelConverter}, ConverterParameter=使用限界支持力, FallbackValue=使用限界支持力}" Foreground="{StaticResource ServiceLimitBrush}"/>
                        <controls:FormulaControl Grid.Row="28" Grid.Column="1" Formula="R_{SL}" Style="{StaticResource FormulaControlStyle}" HorizontalContentAlignment="Right" Foreground="{StaticResource ServiceLimitBrush}"/>
                        <TextBox Grid.Row="28" Grid.Column="2"
                             Text="{Binding TemporarySoilPile.R_SLS, Mode=OneWay, StringFormat=N0}" IsReadOnly="True"
                             Foreground="{StaticResource ServiceLimitBrush}" HorizontalContentAlignment="Right"/>
                        <TextBlock Grid.Row="28" Grid.Column="3" Text="kN" Foreground="{StaticResource ServiceLimitBrush}"/>


                        <TextBlock Grid.Row="29" Grid.Column="0" Text="{Binding Converter={StaticResource LimitStateLabelConverter}, ConverterParameter=損傷限界支持力, FallbackValue=損傷限界支持力}" Foreground="{StaticResource DamageLimitBrush}"/>
                        <controls:FormulaControl Grid.Row="29" Grid.Column="1" Formula="R_{DL}" Style="{StaticResource FormulaControlStyle}" HorizontalContentAlignment="Right" Foreground="{StaticResource DamageLimitBrush}"/>
                        <TextBox Grid.Row="29" Grid.Column="2"
                             Text="{Binding TemporarySoilPile.R_DLS, Mode=OneWay, StringFormat=N0}" IsReadOnly="True"
                             Foreground="{StaticResource DamageLimitBrush}" HorizontalContentAlignment="Right"/>
                        <TextBlock Grid.Row="29" Grid.Column="3" Text="kN" Foreground="{StaticResource DamageLimitBrush}"/>


                        <TextBlock Grid.Row="30" Grid.Column="0" Text="終局限界支持力" Foreground="{StaticResource UltimateLimitBrush}"/>
                        <controls:FormulaControl Grid.Row="30" Grid.Column="1" Formula="R_{UL}" Style="{StaticResource FormulaControlStyle}" HorizontalContentAlignment="Right" Foreground="{StaticResource UltimateLimitBrush}"/>
                        <TextBox Grid.Row="30" Grid.Column="2"
                             Text="{Binding TemporarySoilPile.R_ULS, Mode=OneWay, StringFormat=N0}" IsReadOnly="True"
                             Foreground="{StaticResource UltimateLimitBrush}" HorizontalContentAlignment="Right"/>
                        <TextBlock Grid.Row="30" Grid.Column="3" Text="kN" Foreground="{StaticResource UltimateLimitBrush}"/>

                    </Grid>
                </StackPanel>
            </StackPanel>
        </StackPanel>
                                </ScrollViewer>
                            </avalonDock:LayoutAnchorable>
                        </avalonDock:LayoutDocumentPane>
                    </avalonDock:LayoutDocumentPaneGroup>
                </avalonDock:LayoutPanel>
            </avalonDock:LayoutRoot>
        </avalonDock:DockingManager>

        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ペイン最大化ボタン (左側): ペインをアンドックして最大化、再押下で元の位置にドック -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="アンドック・最大化:" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                <Button x:Name="ButtonMaximizeInput" Content="杭体入力" Height="26" Padding="8,0" Margin="0,0,4,0"
                        ToolTip="杭体入力ペインをアンドックして最大化 / もう一度押すと元の位置にドック"/>
                <Button x:Name="ButtonMaximizeShape" Content="杭姿図" Height="26" Padding="8,0" Margin="0,0,4,0"
                        ToolTip="杭姿図ペインをアンドックして最大化 / もう一度押すと元の位置にドック"/>
                <Button x:Name="ButtonMaximizeResult" Content="地盤描画" Height="26" Padding="8,0" Margin="0,0,4,0"
                        ToolTip="地盤描画ペインをアンドックして最大化 / もう一度押すと元の位置にドック"/>
            </StackPanel>

            <!-- OK / キャンセルボタン (右側) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                <!-- このウィンドウの説明への入口 -->
                <ctrl:HelpLinkButton Anchor="section-pile-body-input" ScrollToTitle="「杭体」入力"
                                     Text="このウィンドウのヘルプ" Margin="0,0,16,0"
                                     VerticalAlignment="Center"/>
                <Button x:Name="ButtonOk" Content="保存(_S)" HorizontalAlignment="Left"
                        VerticalAlignment="Top" Height="30" Width="150" Command="{Binding OkCommand}"
                        IsDefault="True"
                        ToolTip="変更を保存して閉じます (Enter / Ctrl+Enter / Alt+S)"/>
                <Button x:Name="ButtonCancel" Content="キャンセル(_C)" HorizontalAlignment="Left"
                        VerticalAlignment="Top" Height="30" Width="150" Command="{Binding CancelCommand}"
                        IsCancel="True"
                        ToolTip="変更を破棄して閉じます (Esc / Alt+C)"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

    