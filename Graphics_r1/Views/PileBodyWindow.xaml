<Window x:Class="PileDesign.Views.PileBodyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:PileDesign.Views.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PileDesign.ViewModels"
        xmlns:conv="clr-namespace:PileDesign.Converters"
        xmlns:common="clr-namespace:PileDesign.Common"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
        d:DataContext="{d:DesignInstance Type=local:PileBodyViewModel}"
        mc:Ignorable="d"
        xmlns:svg="http://sharpvectors.codeplex.com/runtime/"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        xmlns:controls="clr-namespace:WpfMath.Controls;assembly=WpfMath"
        Title="杭体" WindowState="Maximized"
        Loaded="PileBodyWindow_Loaded"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <!-- 追加: Ctrl+Enter で OkCommand を実行 -->
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding OkCommand}" />
        <!-- 追加: Esc で CancelCommand を実行 -->
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <conv:VisibilityConverter x:Key="VisibilityConverter"/>
        <conv:ZElevationConverter x:Key="ZElevationConverter"/>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:HeightToMaxHeightConverter x:Key="HeightToMaxHeightConverter" />
        <conv:IntToZeroBasedIndexConverter x:Key="IntToZeroBasedIndexConverter"/>
        <conv:PileToeDiameterLabelConverter x:Key="PileToeDiameterLabelConverter"/>
        <conv:LimitStateLabelConverter x:Key="LimitStateLabelConverter"/>


        <!-- 共通フォームスタイル（Window.Resources に追加） -->
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="Width" Value="100"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource PrimaryAccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinWidth" Value="70"/>
        </Style>

        <Style x:Key="FormComboBoxStyle" TargetType="ComboBox"
               BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinWidth" Value="70"/>
        </Style>

        <Style x:Key="FormButtonStyle" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinWidth" Value="70"/>
        </Style>

        <!-- 追加: セパレータ用スタイル（Window.Resources 内） -->
        <Style x:Key="VerticalSeparatorStyle" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="Background" Value="#DDDDDD"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Height" Value="28"/>
        </Style>

        <!-- 小さな横間隔を統一するための簡易スタイル -->
        <Style x:Key="SmallRightMargin" TargetType="FrameworkElement">
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>


        <!-- DataGridCellのスタイルを定義 -->
        <Style x:Key="RightAlignedCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style x:Key="RightAlignedEditingStyle" TargetType="TextBox">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <common:LastItemTemplateSelector x:Key="LastItemTemplateSelector">
            <common:LastItemTemplateSelector.DefaultTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}"/>
                </DataTemplate>
            </common:LastItemTemplateSelector.DefaultTemplate>
            <common:LastItemTemplateSelector.LastItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Foreground="Red" Background="Yellow"/>
                </DataTemplate>
            </common:LastItemTemplateSelector.LastItemTemplate>
        </common:LastItemTemplateSelector>

        <!-- SvgViewboxコントロール用のスタイルを定義 -->
        <Style x:Key="SvgIconStyle" TargetType="svgc:SvgViewbox">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
        </Style>

        <Style x:Key="SvgIconStyle24" TargetType="svgc:SvgViewbox">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- v29 (2026-04-27): GroundWindow と同じ AvalonDock 構造に統一。
             3 ペイン (杭体入力 / 杭姿図 / 計算結果) を可変幅でドッキング、
             ユーザーがドラッグで列幅調整・タブ化・アンドック可能。
             固定 2:1:1 グリッドで右ペインの計算結果が見えなくなる問題を解消。-->
        <avalonDock:DockingManager x:Name="dockingManager" Grid.Row="0">
            <avalonDock:LayoutRoot>
                <avalonDock:LayoutPanel Orientation="Horizontal">
                    <!-- 杭体入力ペイン -->
                    <avalonDock:LayoutDocumentPaneGroup x:Name="PileBodyInputPaneGroup" DockWidth="0.5*">
                        <avalonDock:LayoutDocumentPane>
                            <avalonDock:LayoutAnchorable x:Name="InputTab" Title="杭体入力" CanClose="False" CanHide="False">
                                <!-- HorizontalScrollBarVisibility="Disabled" にすることで、内側の DataGrid の
                                     Width="*" 列がペイン幅にフィットする (Auto だと幅が無限と解釈され Width=* が縮退)。-->
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <StackPanel.ToolTip>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="杭体番号" HorizontalAlignment="Center" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"/>
                        <TextBlock Text="#" Grid.Row="1" Grid.Column="0"/>
                        <TextBlock Text=": 既存データ" Grid.Row="1" Grid.Column="1"/>
                        <TextBlock Text="#(New)" Grid.Row="2" Grid.Column="0"/>
                        <TextBlock Text=": 新規データ" Grid.Row="2" Grid.Column="1"/>
                    </Grid>
                </StackPanel.ToolTip>


                <!--<TextBlock Text="杭体番号" Width="100" HorizontalAlignment="Left" Background="{StaticResource PrimaryAccentBrush}"/>-->
                <Label Content="_杭体番号" Target="{Binding ElementName=ComboBoxPileBodyNo}" 
                        HorizontalAlignment="Left"/>
                <ComboBox x:Name="ComboBoxPileBodyNo"
                        Style="{StaticResource FormComboBoxStyle}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        SelectedItem="{Binding SelectedPileBodyNoItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ItemsSource="{Binding PileBodiesCountPlusOneList}" 
                        DropDownOpened="ComboBox_DropDownOpened"
                        SelectionChanged="ComboBoxPileBodyNoSelectionChanged">

                </ComboBox>
                <!-- セパレータ -->
                <Border Style="{StaticResource VerticalSeparatorStyle}"/>

                <Label Content="_杭体符号" Target="{Binding ElementName=TextBoxPileBodyRef}" 
                        HorizontalAlignment="Left"/>
                <TextBox x:Name="TextBoxPileBodyRef" Style="{StaticResource FormTextBoxStyle}"
                         HorizontalAlignment="Left" VerticalAlignment="Center" 
                         Text="{Binding PileBody.PileBodyRef, UpdateSourceTrigger=LostFocus}"
                         PreviewKeyDown="TextBox_PreviewKeyDown"
                         PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                         PreviewLostKeyboardFocus="TextBox_PreviewLostKeyboardFocus">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="TextChanged">
                            <i:InvokeCommandAction Command="{Binding PileBodyTextChangedCommand}"
                                               CommandParameter="{Binding Text, ElementName=TextBoxPileBodyRef}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <!-- セパレータ -->
                <Border Style="{StaticResource VerticalSeparatorStyle}"/>
                <Button Content="削除" Command="{Binding DeletePileBodyCommand}"/>
                
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="杭体タイプ" Width="100"/>
                <ComboBox x:Name="ComboBoxPileBodyType"
                          HorizontalAlignment="Left" 
                          VerticalAlignment="Center" 
                          Width="200" 
                          SelectedItem="{Binding PileBody.PileBodyType, UpdateSourceTrigger=PropertyChanged}"
                          DropDownOpened="ComboBox_DropDownOpened"
                          ItemsSource="{Binding PileBody.PileBodyTypeOption}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="SelectionChanged">
                            <i:InvokeCommandAction Command="{Binding PileBodyTypeSelectionChangedCommand}"
                                                   CommandParameter="{Binding SelectedItem, ElementName=ComboBoxPileBodyType}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </ComboBox>
                <TextBlock Text="鋼管杭未対応" Margin="10,0,0,0" Foreground="Red"/>
            </StackPanel>
            <GroupBox Header="杭頭">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="杭頭接合タイプ" Width="100"/>

                    <ComboBox x:Name="ComboBoxPileTopType" 
                          SelectedItem ="{Binding PileBody.PileTopType, UpdateSourceTrigger=PropertyChanged}"
                          Width="150"
                          ItemsSource="{Binding PileBody.PileTopTypeOption, UpdateSourceTrigger=PropertyChanged}"
                          DropDownOpened="ComboBox_DropDownOpened">

                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding PileTopTypeSelectionChangedCommand}"
                                                   CommandParameter="{Binding}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </ComboBox>

                    <Button x:Name="ButtonEditPileHead"
                        Content="杭頭編集"
                        Command="{Binding EditPileHeadCommand}">
                    </Button>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="杭体区間">
                <StackPanel>
                    <ToolBar>
                        <Button x:Name="ButtonAddGroundLayer" Content="区間追加" HorizontalAlignment="Left"
                                Command="{Binding AddSegmentCommand}"
                                Background="{StaticResource PrimaryAccentBrush}" Foreground="White"/>
                    </ToolBar>

                    <common:EnhancedDataGrid x:Name="DataGridPileBody" CanUserSortColumns="False" MinHeight="120" MaxHeight="240"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Loaded="DataGrid_Loaded" AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              ItemsSource="{Binding PileBody.PileBodySegments, UpdateSourceTrigger=LostFocus}"
                              LoadingRow="DataGridPileBody_LoadingRow" HorizontalAlignment="Stretch"
                              CellEditEnding="DataGridPileBody_CellEditEnding"
                              CellStyle="{StaticResource CustomDataGridCellStyle}"
                              BeginningEdit="DataGrid_BeginningEdit"
                              >

                        <common:EnhancedDataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryAccentBrush}" />
                            </Style>
                        </common:EnhancedDataGrid.ColumnHeaderStyle>
                        <common:EnhancedDataGrid.Columns>
                            <DataGridTextColumn  Width="0.5*" Binding="{Binding SegmentLength, UpdateSourceTrigger=PropertyChanged}">
                                <DataGridTextColumn.Header>
                                    <StackPanel>
                                        <TextBlock Text="区間長" HorizontalAlignment="Center"/>
                                        <TextBlock Text="(m)" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.ElementStyle>
                                    <StaticResource ResourceKey="RightAlignedCellStyle"/>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <StaticResource ResourceKey="RightAlignedEditingStyle"/>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            
                            <DataGridTextColumn  Width="0.5*" Binding="{Binding SegmentDepth, UpdateSourceTrigger=PropertyChanged}" 
                                                IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}">
                                <DataGridTextColumn.Header>
                                    <StackPanel>
                                        <TextBlock Text="下端" HorizontalAlignment="Center"/>
                                        <TextBlock Text="深さ" HorizontalAlignment="Center"/>
                                        <TextBlock Text="(m)" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.ElementStyle>
                                    <StaticResource ResourceKey="RightAlignedCellStyle"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            
                            <DataGridTemplateColumn Width="*" Header="杭断面編集">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button x:Name="ButtonPileSectionEdit"
                                            Content="杭断面編集"
                                            Command="{Binding DataContext.EditPileSectionCommand, 
                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTextColumn Header="杭断面タイプ"  Width="*" Binding="{Binding PileSection.PileSectionType, 
                                UpdateSourceTrigger=PropertyChanged}"
                                                IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}"/>
                            
                            <DataGridTextColumn Header="杭断面概要" Width="*" Binding="{Binding PileSection.PileDescription, 
                                UpdateSourceTrigger=PropertyChanged}"
                                                IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}"/>

                            <!--削除ボタンの表示-->
                            <DataGridTemplateColumn Width="*" Header="区間削除" >
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button
                                    x:Name="ButtonDelete"
                                    Command="{Binding DataContext.DeletePileBodySegmentCommand, 
                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                    Content="区間削除"
                                    Tag="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </common:EnhancedDataGrid.Columns>
                    </common:EnhancedDataGrid>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="杭先端">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="杭工法" Width="150"/>

                        <ComboBox SelectedItem="{Binding PileBody.PileConstructionType, 
                                    UpdateSourceTrigger=PropertyChanged}"
                                  Width="150"
                                  ItemsSource="{Binding PileBody.PileConstructionTypeOption, 
                                    UpdateSourceTrigger=PropertyChanged}"
                                  DropDownOpened="ComboBox_DropDownOpened">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="SelectionChanged">
                                    <i:InvokeCommandAction Command="{Binding PileConstructionTypeSelectionChangedCommand}"
                                                           CommandParameter="{Binding}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </ComboBox>

                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding PileBody.PileConstructionType, Converter={StaticResource PileToeDiameterLabelConverter}}"
                                   Width="200" HorizontalAlignment="Right"/>
                        <TextBox x:Name="TextBoxPileToeDia"
                                 Width="100" HorizontalContentAlignment="Right"
                                 PreviewKeyDown="TextBox_PreviewKeyDown"
                                 PreviewLostKeyboardFocus="TextBox_PreviewLostKeyboardFocus"
                                 PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown">

                            <!-- Hybridニーディングの根固め部径 D3 は e×D1 の導出値なので手入力させない -->
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PileBody.PileConstructionType}"
                                                     Value="埋込み杭（Hybridニーディング）">
                                            <Setter Property="IsReadOnly" Value="True"/>
                                            <Setter Property="Background" Value="#F0F0F0"/>
                                            <Setter Property="Foreground" Value="#555555"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>

                            <TextBox.Text>
                                <Binding Path="PileBody.PileToeDia" UpdateSourceTrigger="LostFocus" 
                                         ValidatesOnDataErrors="True" StringFormat="N1">
                                    <Binding.ValidationRules>
                                        <common:RangeValidationRule Min="300" Max="100000" />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>

                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="TextChanged">
                                    <i:InvokeCommandAction Command="{Binding PileBodyTextChangedCommand}"
                                                            CommandParameter="{Binding Text, ElementName=TextBoxPileToeDia}" />
                                </i:EventTrigger>
                                <i:EventTrigger EventName="GotFocus">
                                    <i:InvokeCommandAction Command="{Binding TextBoxGotFocusCommand}"
                                                            CommandParameter="{Binding ElementName=TextBoxPileToeDia}" />
                                </i:EventTrigger>
                                <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                    <i:InvokeCommandAction Command="{Binding TextBoxPreviewMouseLeftButtonDownCommand}"
                                                            CommandParameter="{Binding ElementName=TextBoxPileToeDia}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>

                            <TextBox.ToolTip>
                                <ToolTip>
                                    <TextBlock>
                                        <Run>場所打ちコンクリート杭：先端径</Run><LineBreak/>
                                        <Run>埋込み杭：根固め部径</Run><LineBreak/>
                                        <Run>埋込み杭（Smart-MAGNUM）：拡大根固め部径 Den</Run><LineBreak/>
                                        <Run>回転貫入杭：羽根径</Run><LineBreak/>
                                        <Run>打込み杭：軸径</Run>
                                    </TextBlock>
                                </ToolTip>
                            </TextBox.ToolTip>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Visibility="{Binding PileBody.PileConstructionType,
                            Converter={StaticResource VisibilityConverter},
                            ConverterParameter='場所打ちコンクリート杭'}">
                        <TextBlock Text="場所打ち拡底杭先端立ち上がり (mm)" Width="200" />
                        <TextBox Width="100" HorizontalContentAlignment="Right" 
                                 PreviewKeyDown="TextBox_PreviewKeyDown"
                                 PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                 >
                            <TextBox.Text>
                                <Binding Path="PileBody.InsituPileToeHeight" UpdateSourceTrigger="LostFocus" ValidatesOnDataErrors="True">
                                    <Binding.ValidationRules>
                                        <common:RangeValidationRule Min="0" Max="1000" />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Visibility="{Binding PileBody.PileConstructionType,
                            Converter={StaticResource VisibilityConverter},
                            ConverterParameter='場所打ちコンクリート杭'}">
                        <TextBlock Text="場所打ち拡底杭杭先端角度" Width="200"/>
                        <TextBox Width="100" HorizontalContentAlignment="Right" 
                                 PreviewKeyDown="TextBox_PreviewKeyDown"
                                 PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                 >
                            <TextBox.Text>
                                <Binding Path="PileBody.InsituPileToeAngle" UpdateSourceTrigger="LostFocus" ValidatesOnDataErrors="True">
                                    <Binding.ValidationRules>
                                        <common:RangeValidationRule Min="0" Max="60" />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Visibility="{Binding PileBody.PileConstructionType,
                            Converter={StaticResource VisibilityConverter},
                            ConverterParameter='埋込み杭（プレボーリング）,埋込み杭（中掘り）'}">
                        <TextBlock Text="既製コンクリート杭根固め高さ径比" Width="200"/>
                        <TextBox Width="100" HorizontalContentAlignment="Right" 
                                 PreviewKeyDown="TextBox_PreviewKeyDown"
                                 PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                 >
                            <TextBox.Text>
                                <Binding Path="PileBody.PrecastConcretePileToeHeightRatio" UpdateSourceTrigger="LostFocus" ValidatesOnDataErrors="True">
                                    <Binding.ValidationRules>
                                        <common:RangeValidationRule Min="1" Max="5" />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                    </StackPanel>

                    <!-- Smart-MAGNUM 工法（ジャパンパイル）専用入力。
                         拡大根固め部径 Den は上の「拡大根固め部径Den (mm)」欄（PileToeDia）を使う。
                         節部径 Don / Dos は杭区間の断面から自動導出するため入力欄を設けていない。 -->
                    <StackPanel Visibility="{Binding PileBody.PileConstructionType,
                            Converter={StaticResource VisibilityConverter},
                            ConverterParameter='埋込み杭（Smart-MAGNUM）'}">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="杭下拡大根固め部長さLL (m)" Width="200"/>
                            <TextBox Width="100" HorizontalContentAlignment="Right"
                                     PreviewKeyDown="TextBox_PreviewKeyDown"
                                     PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown">
                                <TextBox.Text>
                                    <Binding Path="PileBody.SmartMagnumLL" UpdateSourceTrigger="LostFocus"
                                             ValidatesOnDataErrors="True" StringFormat="N2">
                                        <Binding.ValidationRules>
                                            <common:RangeValidationRule Min="0" Max="2" />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                                <TextBox.ToolTip>
                                    <ToolTip>
                                        <TextBlock>
                                            <Run>杭先端から下方への拡大根固め部の長さ。適用範囲 0〜2m。</Run><LineBreak/>
                                            <Run>先端支持力係数 α の LL' は LL ≤ 0.5m のとき 0 になります。</Run>
                                        </TextBlock>
                                    </ToolTip>
                                </TextBox.ToolTip>
                            </TextBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="杭周面部の掘削径Des (mm)" Width="200"/>
                            <TextBox Width="100" HorizontalContentAlignment="Right"
                                     PreviewKeyDown="TextBox_PreviewKeyDown"
                                     PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown">
                                <TextBox.Text>
                                    <Binding Path="PileBody.SmartMagnumDes" UpdateSourceTrigger="LostFocus"
                                             ValidatesOnDataErrors="True" StringFormat="N1">
                                        <Binding.ValidationRules>
                                            <common:RangeValidationRule Min="0" Max="2500" />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                                <TextBox.ToolTip>
                                    <ToolTip>
                                        <TextBlock>
                                            <Run>拡翼掘削部の掘削径。0 は拡大掘削なし（拡大比 ωs = 1.00）を意味します。</Run><LineBreak/>
                                            <Run>拡大比 ωs = Des / Dss は節杭の区間にのみ効きます。</Run>
                                        </TextBlock>
                                    </ToolTip>
                                </TextBox.ToolTip>
                            </TextBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="拡翼掘削部長さ (m)" Width="200"/>
                            <TextBox Width="100" HorizontalContentAlignment="Right"
                                     PreviewKeyDown="TextBox_PreviewKeyDown"
                                     PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown">
                                <TextBox.Text>
                                    <Binding Path="PileBody.SmartMagnumWingLength" UpdateSourceTrigger="LostFocus"
                                             ValidatesOnDataErrors="True" StringFormat="N2">
                                        <Binding.ValidationRules>
                                            <common:RangeValidationRule Min="0" Max="70" />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                                <TextBox.ToolTip>
                                    <ToolTip>
                                        <TextBlock>
                                            <Run>杭下拡大根固め部長さ LL を含む長さで、杭下拡大根固め部の下端から上方へ測ります。</Run><LineBreak/>
                                            <Run>この範囲に掛かる杭区間の周面摩擦にのみ拡大比 ωs が適用されます。</Run>
                                        </TextBlock>
                                    </ToolTip>
                                </TextBox.ToolTip>
                            </TextBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="周面強化型" Width="200"/>
                            <CheckBox IsChecked="{Binding PileBody.SmartMagnumIsReinforcedCircum}"
                                      VerticalAlignment="Center">
                                <CheckBox.ToolTip>
                                    <ToolTip>
                                        <TextBlock>
                                            <Run>チェックなし＝標準型、チェックあり＝周面強化型。</Run><LineBreak/>
                                            <Run>周面摩擦力係数 β（砂質・礫質）と γ（粘土質）が切り替わります。</Run>
                                        </TextBlock>
                                    </ToolTip>
                                </CheckBox.ToolTip>
                            </CheckBox>
                        </StackPanel>

                        <!-- 記号の定義・適用範囲・計算例は工法カタログ (ジャパンパイル) を参照 -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Width="200"/>
                            <TextBlock VerticalAlignment="Center">
                                <Hyperlink NavigateUri="https://www.japanpile.co.jp/method/pdf/smart-magnum.pdf"
                                           RequestNavigate="Hyperlink_RequestNavigate"
                                           ToolTip="ジャパンパイルの Smart-MAGNUM 工法カタログ (PDF) を既定のブラウザで開きます">
                                    <Run Text="工法カタログ (PDF) を開く"/>
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <!-- Hybridニーディング工法（三谷セキサン）専用入力。
                         根固め部径 D3 は設計拡径比 e と節部径 D1 から D3 = e·D1 と決まるため、
                         上の径の欄は導出値の表示になる。 -->
                    <StackPanel Visibility="{Binding PileBody.PileConstructionType,
                            Converter={StaticResource VisibilityConverter},
                            ConverterParameter='埋込み杭（Hybridニーディング）'}">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="節部径 D1 (mm)" Width="200"/>
                            <TextBlock Text="{Binding PileBody.HybridD1, StringFormat=N1}"
                                       Width="100" TextAlignment="Right" VerticalAlignment="Center"
                                       Foreground="#555555">
                                <TextBlock.ToolTip>
                                    <ToolTip>
                                        <TextBlock>
                                            <Run Text="杭体最下段の区間の断面から自動的に決まります"/><LineBreak/>
                                            <Run Text="(節杭は節部径、ストレート杭は公称外径)。"/><LineBreak/>
                                            <Run Text="先端有効断面積 Ap = π·D1²/4、根固め部径 D3 = e·D1、"/><LineBreak/>
                                            <Run Text="杭周固定部の掘削径 es·D1 の基準になります。"/>
                                        </TextBlock>
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="設計拡径比 e" Width="200"/>
                            <TextBox Width="100" HorizontalContentAlignment="Right"
                                     PreviewKeyDown="TextBox_PreviewKeyDown"
                                     PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown">
                                <TextBox.Text>
                                    <Binding Path="PileBody.HybridExpansionRatio" UpdateSourceTrigger="LostFocus"
                                             ValidatesOnDataErrors="True" StringFormat="N1">
                                        <Binding.ValidationRules>
                                            <common:RangeValidationRule Min="1.0" Max="2.0" />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                                <TextBox.ToolTip>
                                    <ToolTip>
                                        <TextBlock>
                                            <Run Text="根固め部径 D3 の節部径 D1 に対する比。1.0〜2.0 の 0.1 刻み。"/><LineBreak/>
                                            <Run Text="先端支持力係数 α を決めます (砂質・礫質 200e(e+0.2) / 粘土質 200e²)。"/>
                                        </TextBlock>
                                    </ToolTip>
                                </TextBox.ToolTip>
                            </TextBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="設計掘削径比 es" Width="200"/>
                            <TextBox Width="100" HorizontalContentAlignment="Right"
                                     PreviewKeyDown="TextBox_PreviewKeyDown"
                                     PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown">
                                <TextBox.Text>
                                    <Binding Path="PileBody.HybridExcavationRatio" UpdateSourceTrigger="LostFocus"
                                             ValidatesOnDataErrors="True" StringFormat="N1">
                                        <Binding.ValidationRules>
                                            <common:RangeValidationRule Min="1.0" Max="2.0" />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                                <TextBox.ToolTip>
                                    <ToolTip>
                                        <TextBlock>
                                            <Run Text="杭周固定部の掘削径の節部径 D1 に対する比。1.0 は軸部を拡大掘削しないことを意味します。"/><LineBreak/>
                                            <Run Text="適用範囲は 1.0〜2.0 (e が 1.7 以上のときは 1.0〜1.6)、かつ es ≦ e。"/><LineBreak/>
                                            <Run Text="摩擦強化型のときだけ節杭区間の周面摩擦力係数に掛かります。"/>
                                        </TextBlock>
                                    </ToolTip>
                                </TextBox.ToolTip>
                            </TextBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="杭下長 Lu (m)" Width="200"/>
                            <TextBox Width="100" HorizontalContentAlignment="Right"
                                     PreviewKeyDown="TextBox_PreviewKeyDown"
                                     PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown">
                                <TextBox.Text>
                                    <Binding Path="PileBody.HybridPileBelowLength" UpdateSourceTrigger="LostFocus"
                                             ValidatesOnDataErrors="True" StringFormat="N2">
                                        <Binding.ValidationRules>
                                            <common:RangeValidationRule Min="0" Max="5" />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                                <TextBox.ToolTip>
                                    <ToolTip>
                                        <TextBlock>
                                            <Run Text="先端支持力算定位置から杭先端までの長さ。この区間は杭周面摩擦力の対象外になります。"/><LineBreak/>
                                            <Run Text="カタログは節部径・拡径比によって異なるとして値を公表していないため入力としています。"/><LineBreak/>
                                            <Run Text="メーカーに確認した値を入力してください。0 のままだと先端支持力算定位置は杭先端と同じになります。"/>
                                        </TextBlock>
                                    </ToolTip>
                                </TextBox.ToolTip>
                            </TextBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="摩擦強化型" Width="200"/>
                            <CheckBox IsChecked="{Binding PileBody.HybridIsFrictionEnhanced}"
                                      VerticalAlignment="Center">
                                <CheckBox.ToolTip>
                                    <ToolTip>
                                        <TextBlock>
                                            <Run Text="チェックなし＝標準型、チェックあり＝摩擦強化型。"/><LineBreak/>
                                            <Run Text="節杭区間の周面摩擦力係数 β・γ が切り替わり、設計掘削径比 es が掛かります。"/><LineBreak/>
                                            <Run Text="カタログでは標準型と摩擦強化型の併用はしません。"/>
                                        </TextBlock>
                                    </ToolTip>
                                </CheckBox.ToolTip>
                            </CheckBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Width="200"/>
                            <TextBlock VerticalAlignment="Center">
                                <Hyperlink NavigateUri="https://www.m-sekisan.co.jp/download/pdf/cat_HybridKneading.pdf"
                                           RequestNavigate="Hyperlink_RequestNavigate"
                                           ToolTip="三谷セキサンの Hybrid ニーディング工法カタログ (PDF) を既定のブラウザで開きます">
                                    <Run Text="工法カタログ (PDF) を開く"/>
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Visibility="{Binding PileBody.PileBodyType,
                          Converter={StaticResource VisibilityConverter},
                          ConverterParameter='既製コンクリート杭'}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding PileBody.PileConstructionType,
                                    Converter={StaticResource VisibilityConverter},
                                    ConverterParameter='打込み杭'}">
                                <TextBlock Text="杭先端形状" Width="150" HorizontalAlignment="Right"/>
                                <ComboBox x:Name ="ComboBoxConcreteTipStyle" Text="{Binding PileBody.PileTipStyle , UpdateSourceTrigger=PropertyChanged}"  Width="100"
                                    ItemsSource="{Binding PileBody.TipStyleOption, UpdateSourceTrigger=PropertyChanged}">
