                    <TextBlock Text="液状化" FontWeight="Bold"/>
                </ToggleButton>
                <ComboBox SelectedIndex="{Binding SelectedSeismicLevelIndex}"
                          IsEnabled="{Binding IsGroundLayerOverwrapped}"
