<Window x:Class="PileDesign.Views.PileBodyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PileDesign.ViewModels"
        xmlns:conv="clr-namespace:PileDesign.Converters"
        xmlns:common="clr-namespace:PileDesign.Common"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
        d:DataContext="{d:DesignInstance Type=local:PileBodyViewModel}"
        mc:Ignorable="d"
        xmlns:svg="http://sharpvectors.codeplex.com/runtime/"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        xmlns:controls="clr-namespace:WpfMath.Controls;assembly=WpfMath"
        Title="杭体" WindowState="Maximized"
        Loaded="PileBodyWindow_Loaded"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <!-- 追加: Ctrl+Enter で OkCommand を実行 -->
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding OkCommand}" />
        <!-- 追加: Esc で CancelCommand を実行 -->
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <conv:VisibilityConverter x:Key="VisibilityConverter"/>
        <conv:ZElevationConverter x:Key="ZElevationConverter"/>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:HeightToMaxHeightConverter x:Key="HeightToMaxHeightConverter" />
        <conv:IntToZeroBasedIndexConverter x:Key="IntToZeroBasedIndexConverter"/>


        <!-- 共通フォームスタイル（Window.Resources に追加） -->
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="Width" Value="100"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource PrimaryAccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinWidth" Value="70"/>
        </Style>

        <Style x:Key="FormComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinWidth" Value="70"/>
        </Style>

        <Style x:Key="FormButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinWidth" Value="70"/>
        </Style>

        <!-- 追加: セパレータ用スタイル（Window.Resources 内） -->
        <Style x:Key="VerticalSeparatorStyle" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="Background" Value="#DDDDDD"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Height" Value="28"/>
        </Style>

        <!-- 小さな横間隔を統一するための簡易スタイル -->
        <Style x:Key="SmallRightMargin" TargetType="FrameworkElement">
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>


        <!-- DataGridCellのスタイルを定義 -->
        <Style x:Key="RightAlignedCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style x:Key="RightAlignedEditingStyle" TargetType="TextBox">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <common:LastItemTemplateSelector x:Key="LastItemTemplateSelector">
            <common:LastItemTemplateSelector.DefaultTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}"/>
                </DataTemplate>
            </common:LastItemTemplateSelector.DefaultTemplate>
            <common:LastItemTemplateSelector.LastItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Foreground="Red" Background="Yellow"/>
                </DataTemplate>
            </common:LastItemTemplateSelector.LastItemTemplate>
        </common:LastItemTemplateSelector>

        <!-- SvgViewboxコントロール用のスタイルを定義 -->
        <Style x:Key="SvgIconStyle" TargetType="svgc:SvgViewbox">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
        </Style>

        <Style x:Key="SvgIconStyle24" TargetType="svgc:SvgViewbox">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- v29 (2026-04-27): GroundWindow と同じ AvalonDock 構造に統一。
             3 ペイン (杭体入力 / 杭姿図 / 計算結果) を可変幅でドッキング、
             ユーザーがドラッグで列幅調整・タブ化・アンドック可能。
             固定 2:1:1 グリッドで右ペインの計算結果が見えなくなる問題を解消。-->
        <avalonDock:DockingManager x:Name="dockingManager" Grid.Row="0">
            <avalonDock:LayoutRoot>
                <avalonDock:LayoutPanel Orientation="Horizontal">
                    <!-- 杭体入力ペイン -->
                    <avalonDock:LayoutDocumentPaneGroup x:Name="PileBodyInputPaneGroup" DockWidth="0.5*">
                        <avalonDock:LayoutDocumentPane>
                            <avalonDock:LayoutAnchorable x:Name="InputTab" Title="杭体入力" CanClose="False" CanHide="False">
                                <!-- HorizontalScrollBarVisibility="Disabled" にすることで、内側の DataGrid の
                                     Width="*" 列がペイン幅にフィットする (Auto だと幅が無限と解釈され Width=* が縮退)。-->
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <StackPanel.ToolTip>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="杭体番号" HorizontalAlignment="Center" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"/>
                        <TextBlock Text="#" Grid.Row="1" Grid.Column="0"/>
                        <TextBlock Text=": 既存データ" Grid.Row="1" Grid.Column="1"/>
                        <TextBlock Text="#(New)" Grid.Row="2" Grid.Column="0"/>
                        <TextBlock Text=": 新規データ" Grid.Row="2" Grid.Column="1"/>
                    </Grid>
                </StackPanel.ToolTip>


                <!--<TextBlock Text="杭体番号" Width="100" HorizontalAlignment="Left" Background="{StaticResource PrimaryAccentBrush}"/>-->
                <Label Content="_杭体番号" Target="{Binding ElementName=ComboBoxPileBodyNo}" 
                        HorizontalAlignment="Left"/>
                <ComboBox x:Name="ComboBoxPileBodyNo"
                        Style="{StaticResource FormComboBoxStyle}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        SelectedItem="{Binding SelectedPileBodyNoItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ItemsSource="{Binding PileBodiesCountPlusOneList}" 
                        DropDownOpened="ComboBox_DropDownOpened"
                        SelectionChanged="ComboBoxPileBodyNoSelectionChanged">

                </ComboBox>
                <!-- セパレータ -->
                <Border Style="{StaticResource VerticalSeparatorStyle}"/>

                <Label Content="_杭体符号" Target="{Binding ElementName=TextBoxPileBodyRef}" 
                        HorizontalAlignment="Left"/>
                <TextBox x:Name="TextBoxPileBodyRef" Style="{StaticResource FormTextBoxStyle}"
                         HorizontalAlignment="Left" VerticalAlignment="Center" 
                         Text="{Binding PileBody.PileBodyRef, UpdateSourceTrigger=LostFocus}"
                         PreviewKeyDown="TextBox_PreviewKeyDown"
                         PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                         PreviewLostKeyboardFocus="TextBox_PreviewLostKeyboardFocus">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="TextChanged">
                            <i:InvokeCommandAction Command="{Binding PileBodyTextChangedCommand}"
                                               CommandParameter="{Binding Text, ElementName=TextBoxPileBodyRef}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <!-- セパレータ -->
                <Border Style="{StaticResource VerticalSeparatorStyle}"/>
                <Button Content="削除" Command="{Binding DeletePileBodyCommand}"/>
                
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="杭体タイプ" Width="100"/>
                <ComboBox x:Name="ComboBoxPileBodyType"
                          HorizontalAlignment="Left" 
                          VerticalAlignment="Center" 
                          Width="200" 
                          SelectedItem="{Binding PileBody.PileBodyType, UpdateSourceTrigger=PropertyChanged}"
                          DropDownOpened="ComboBox_DropDownOpened"
                          ItemsSource="{Binding PileBody.PileBodyTypeOption}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="SelectionChanged">
                            <i:InvokeCommandAction Command="{Binding PileBodyTypeSelectionChangedCommand}"
                                                   CommandParameter="{Binding SelectedItem, ElementName=ComboBoxPileBodyType}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </ComboBox>
                <TextBlock Text="鋼管杭未対応" Margin="10,0,0,0" Foreground="Red"/>
            </StackPanel>
            <GroupBox Header="杭頭">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="杭頭接合タイプ" Width="100"/>

                    <ComboBox x:Name="ComboBoxPileTopType" 
                          SelectedItem ="{Binding PileBody.PileTopType, UpdateSourceTrigger=PropertyChanged}"
                          Width="150"
                          ItemsSource="{Binding PileBody.PileTopTypeOption, UpdateSourceTrigger=PropertyChanged}"
                          DropDownOpened="ComboBox_DropDownOpened">

                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding PileTopTypeSelectionChangedCommand}"
                                                   CommandParameter="{Binding}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </ComboBox>

                    <Button x:Name="ButtonEditPileHead"
                        Content="杭頭編集"
                        Command="{Binding EditPileHeadCommand}">
                    </Button>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="杭体区間">
                <StackPanel>
                    <ToolBar>
                        <Button x:Name="ButtonAddGroundLayer" Content="区間追加" HorizontalAlignment="Left"
                                Command="{Binding AddSegmentCommand}"
                                Background="{StaticResource PrimaryAccentBrush}" Foreground="White"/>
                    </ToolBar>

                    <common:EnhancedDataGrid x:Name="DataGridPileBody" MinHeight="120" MaxHeight="240"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Loaded="DataGrid_Loaded" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserSortColumns="False"
                              ItemsSource="{Binding PileBody.PileBodySegments, UpdateSourceTrigger=LostFocus}"
                              LoadingRow="DataGridPileBody_LoadingRow" HorizontalAlignment="Stretch"
                              CellEditEnding="DataGridPileBody_CellEditEnding"
                              CellStyle="{StaticResource CustomDataGridCellStyle}"
                              BeginningEdit="DataGrid_BeginningEdit"
                              common:DataGridNavigationBehavior.Enable="True">

                        <common:EnhancedDataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryAccentBrush}" />
                            </Style>
                        </common:EnhancedDataGrid.ColumnHeaderStyle>
                        <common:EnhancedDataGrid.Columns>
                            <DataGridTextColumn  Width="0.5*" Binding="{Binding SegmentLength, UpdateSourceTrigger=PropertyChanged}">
                                <DataGridTextColumn.Header>
                                    <StackPanel>
                                        <TextBlock Text="区間長" HorizontalAlignment="Center"/>
                                        <TextBlock Text="(m)" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.ElementStyle>
                                    <StaticResource ResourceKey="RightAlignedCellStyle"/>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <StaticResource ResourceKey="RightAlignedEditingStyle"/>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            
                            <DataGridTextColumn  Width="0.5*" Binding="{Binding SegmentDepth, UpdateSourceTrigger=PropertyChanged}" 
                                                IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}">
                                <DataGridTextColumn.Header>
                                    <StackPanel>
                                        <TextBlock Text="下端" HorizontalAlignment="Center"/>
                                        <TextBlock Text="深さ" HorizontalAlignment="Center"/>
                                        <TextBlock Text="(m)" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.ElementStyle>
                                    <StaticResource ResourceKey="RightAlignedCellStyle"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            
                            <DataGridTemplateColumn Width="*" Header="杭断面編集">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button x:Name="ButtonPileSectionEdit"
                                            Content="杭断面編集"
                                            Command="{Binding DataContext.EditPileSectionCommand, 
                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTextColumn Header="杭断面タイプ"  Width="*" Binding="{Binding PileSection.PileSectionType, 
                                UpdateSourceTrigger=PropertyChanged}"
                                                IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}"/>
                            
                            <DataGridTextColumn Header="杭断面概要" Width="*" Binding="{Binding PileSection.PileDescription, 
                                UpdateSourceTrigger=PropertyChanged}"
                                                IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}"/>

                            <!--削除ボタンの表示-->
                            <DataGridTemplateColumn Width="*" Header="区間削除" >
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button
                                    x:Name="ButtonDelete"
                                    Command="{Binding DataContext.DeletePileBodySegmentCommand, 
                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                    Content="区間削除"
                                    Tag="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </common:EnhancedDataGrid.Columns>
                    </common:EnhancedDataGrid>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="杭先端">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="杭工法" Width="150"/>

                        <ComboBox SelectedItem="{Binding PileBody.PileConstructionType, 
                                    UpdateSourceTrigger=PropertyChanged}"
                                  Width="150"
                                  ItemsSource="{Binding PileBody.PileConstructionTypeOption, 
                                    UpdateSourceTrigger=PropertyChanged}"
                                  DropDownOpened="ComboBox_DropDownOpened">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="SelectionChanged">
                                    <i:InvokeCommandAction Command="{Binding PileConstructionTypeSelectionChangedCommand}"
                                                           CommandParameter="{Binding}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </ComboBox>

                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="杭先端径d (mm)" Width="200" HorizontalAlignment="Right"/>
                        <TextBox x:Name="TextBoxPileToeDia"
                                 Width="100" HorizontalContentAlignment="Right"
                                 PreviewKeyDown="TextBox_PreviewKeyDown"
                                 PreviewLostKeyboardFocus="TextBox_PreviewLostKeyboardFocus"
                                 PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown">

                            <TextBox.Text>
                                <Binding Path="PileBody.PileToeDia" UpdateSourceTrigger="LostFocus" 
                                         ValidatesOnDataErrors="True" StringFormat="N1">
                                    <Binding.ValidationRules>
                                        <common:RangeValidationRule Min="300" Max="100000" />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>

                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="TextChanged">
                                    <i:InvokeCommandAction Command="{Binding PileBodyTextChangedCommand}"
                                                            CommandParameter="{Binding Text, ElementName=TextBoxPileToeDia}" />
                                </i:EventTrigger>
                                <i:EventTrigger EventName="GotFocus">
                                    <i:InvokeCommandAction Command="{Binding TextBoxGotFocusCommand}"
                                                            CommandParameter="{Binding ElementName=TextBoxPileToeDia}" />
                                </i:EventTrigger>
                                <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                    <i:InvokeCommandAction Command="{Binding TextBoxPreviewMouseLeftButtonDownCommand}"
                                                            CommandParameter="{Binding ElementName=TextBoxPileToeDia}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>

                            <TextBox.ToolTip>
                                <ToolTip>
                                    <TextBlock>
                                        <Run>場所打ちコンクリート杭：先端径</Run><LineBreak/>
                                        <Run>埋込み杭：根固め部径</Run><LineBreak/>
                                        <Run>回転貫入杭：羽根径</Run><LineBreak/>
                                        <Run>打込み杭：軸径</Run>
                                    </TextBlock>
                                </ToolTip>
                            </TextBox.ToolTip>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Visibility="{Binding PileBody.PileConstructionType,
                            Converter={StaticResource VisibilityConverter},
                            ConverterParameter='場所打ちコンクリート杭'}">
                        <TextBlock Text="場所打ち拡底杭先端立ち上がり (mm)" Width="200" />
                        <TextBox Width="100" HorizontalContentAlignment="Right" 
                                 PreviewKeyDown="TextBox_PreviewKeyDown"
                                 PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                 >
                            <TextBox.Text>
                                <Binding Path="PileBody.InsituPileToeHeight" UpdateSourceTrigger="LostFocus" ValidatesOnDataErrors="True">
                                    <Binding.ValidationRules>
                                        <common:RangeValidationRule Min="0" Max="1000" />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Visibility="{Binding PileBody.PileConstructionType,
                            Converter={StaticResource VisibilityConverter},
                            ConverterParameter='場所打ちコンクリート杭'}">
                        <TextBlock Text="場所打ち拡底杭杭先端角度" Width="200"/>
                        <TextBox Width="100" HorizontalContentAlignment="Right" 
                                 PreviewKeyDown="TextBox_PreviewKeyDown"
                                 PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                 >
                            <TextBox.Text>
                                <Binding Path="PileBody.InsituPileToeAngle" UpdateSourceTrigger="LostFocus" ValidatesOnDataErrors="True">
                                    <Binding.ValidationRules>
                                        <common:RangeValidationRule Min="0" Max="60" />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Visibility="{Binding PileBody.PileConstructionType,
                            Converter={StaticResource VisibilityConverter},
                            ConverterParameter='埋込み杭（プレボーリング）,埋込み杭（中掘り）'}">
                        <TextBlock Text="既製コンクリート杭根固め高さ径比" Width="200"/>
                        <TextBox Width="100" HorizontalContentAlignment="Right" 
                                 PreviewKeyDown="TextBox_PreviewKeyDown"
                                 PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                 >
                            <TextBox.Text>
                                <Binding Path="PileBody.PrecastConcretePileToeHeightRatio" UpdateSourceTrigger="LostFocus" ValidatesOnDataErrors="True">
                                    <Binding.ValidationRules>
                                        <common:RangeValidationRule Min="1" Max="5" />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Visibility="{Binding PileBody.PileBodyType,
                          Converter={StaticResource VisibilityConverter},
                          ConverterParameter='既製コンクリート杭'}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding PileBody.PileConstructionType,
                                    Converter={StaticResource VisibilityConverter},
                                    ConverterParameter='打込み杭'}">
                                <TextBlock Text="杭先端形状" Width="150" HorizontalAlignment="Right"/>
                                <ComboBox x:Name ="ComboBoxConcreteTipStyle" Text="{Binding PileBody.PileTipStyle , UpdateSourceTrigger=PropertyChanged}"  Width="100"
                                    ItemsSource="{Binding PileBody.TipStyleOption, UpdateSourceTrigger=PropertyChanged}">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="SelectionChanged">
                                            <i:InvokeCommandAction Command="{Binding RecalculateTipNonPermabilityCommand}"/>
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Visibility="{Binding PileBody.PileTipStyle,
                                        Converter={StaticResource VisibilityConverter},
                                        ConverterParameter='開端杭'}">
                                    <TextBlock Text="支持層への根入れ深さLB(m)" Width="200" HorizontalAlignment="Right"/>
                                    <TextBox x:Name="TextBoxEmbedmentIntoBearingSoil" Text="{Binding PileBody.EmbedmentIntoBearingSoil}" Width="100"
                                             HorizontalContentAlignment="Right" 
                                             PreviewKeyDown="TextBox_PreviewKeyDown"
                                             PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="TextChanged">
                                                <i:InvokeCommandAction Command="{Binding RecalculateTipNonPermabilityCommand}"/>
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </TextBox>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Visibility="{Binding PileBody.PileTipStyle,
                                        Converter={StaticResource VisibilityConverter},
                                        ConverterParameter='開端杭'}">
                                    <TextBlock Text="杭の内径dI(m)" Width="200" HorizontalAlignment="Right"/>
                                    <TextBox x:Name="TextBoxPileInnerDia"  Text="{Binding PileBody.PileInnerDia}" Width="100" HorizontalContentAlignment="Right"
                                             PreviewKeyDown="TextBox_PreviewKeyDown"
                                             PreviewLostKeyboardFocus="TextBox_PreviewLostKeyboardFocus"
                                             PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="TextChanged">
                                                <i:InvokeCommandAction Command="{Binding RecalculateTipNonPermabilityCommand}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </TextBox>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Visibility="{Binding PileBody.PileTipStyle,
                                        Converter={StaticResource VisibilityConverter},
                                        ConverterParameter='開端杭'}">
                                    <TextBlock Text="杭先端閉塞効率" Width="200" HorizontalAlignment="Right"/>
                                    <TextBox x:Name="TextBoxPrecastPileTipNonPermeability" HorizontalAlignment="Left" VerticalAlignment="Center"
                                         Width="100" Text="{Binding PileBody.TipNonPermability }"  HorizontalContentAlignment="Right"
                                             IsReadOnly = "true" Foreground="gray">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="TextChanged">
                                                <i:InvokeCommandAction Command="{Binding RecalculateTipNonPermabilityCommand}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                        <TextBox.ToolTip>
                                            <ToolTip>
                                                <TextBlock>
                                                    <Run>打込み杭(閉端杭)：1.0</Run><LineBreak/>
                                                    <Run>打込み杭(閉端杭)：</Run><LineBreak/>
                                                    <Run>2≦(LB/DI)≦5の場合 η=0.16(LB/dI)</Run><LineBreak/>
                                                    <Run>5＜(LB/DI)の場合η=0.80</Run><LineBreak/>
                                                    <Run>LB：支持層への根入れ長さ(m)</Run><LineBreak/>
                                                    <Run>dI：杭の内径(m)</Run>
                                                </TextBlock>
                                            </ToolTip>
                                        </TextBox.ToolTip>
                                    </TextBox>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Visibility="{Binding PileBody.PileBodyType,
                          Converter={StaticResource VisibilityConverter},
                          ConverterParameter='鋼管杭'}">
                        <StackPanel Orientation="Horizontal" Visibility="{Binding PileBody.PileConstructionType,
                            Converter={StaticResource VisibilityConverter},
                            ConverterParameter='回転貫入杭'}">
                            <TextBlock Text="杭先端形状" Width="100" HorizontalAlignment="Right"/>
                            <ComboBox x:Name ="ComboBoxSteelTipStyle" Text="{Binding PileBody.PileTipStyle, UpdateSourceTrigger=PropertyChanged}"  Width="150"
                              ItemsSource="{Binding PileBody.TipStyleOption}"
                                      DropDownOpened="ComboBox_DropDownOpened">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="SelectionChanged">
                                        <i:InvokeCommandAction Command="{Binding RecalculateTipNonPermabilityCommand}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </ComboBox>
                            <TextBlock Text="杭先端閉塞効率" Width="100" HorizontalAlignment="Right"/>
                            <TextBox x:Name="TextBoxSteelPileTipNonPermeability" HorizontalAlignment="Left" VerticalAlignment="Center"
                             Width="100"  HorizontalContentAlignment="Right" PreviewKeyDown="TextBox_PreviewKeyDown"
                                     PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                     Text="{Binding PileBody.TipNonPermability }" IsReadOnly = "true" Foreground="gray">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="TextChanged">
                                        <i:InvokeCommandAction Command="{Binding RecalculateTipNonPermabilityCommand}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                                <TextBox.ToolTip>
                                    <ToolTip>
                                        <TextBlock>
                                            <Run>回転貫入杭(閉端杭)：1.0</Run><LineBreak/>
                                            <Run>回転貫入杭(開端杭)：0.8</Run><LineBreak/>
                                        </TextBlock>
                                    </ToolTip>
                                </TextBox.ToolTip>
                            </TextBox>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

        </StackPanel>
                                </ScrollViewer>
                            </avalonDock:LayoutAnchorable>
                        </avalonDock:LayoutDocumentPane>
                    </avalonDock:LayoutDocumentPaneGroup>

                    <!-- 杭姿図ペイン -->
                    <avalonDock:LayoutDocumentPaneGroup x:Name="PileShapeImagePaneGroup" DockWidth="0.25*">
                        <avalonDock:LayoutDocumentPane>
                            <avalonDock:LayoutAnchorable x:Name="ShapeTab" Title="杭姿図" CanClose="False" CanHide="False">
                                <Canvas x:Name="Canvas"/>
                            </avalonDock:LayoutAnchorable>
                        </avalonDock:LayoutDocumentPane>
                    </avalonDock:LayoutDocumentPaneGroup>

                    <!-- 地盤描画ペイン -->
                    <avalonDock:LayoutDocumentPaneGroup x:Name="ResultPaneGroup" DockWidth="0.25*">
                        <avalonDock:LayoutDocumentPane>
                            <avalonDock:LayoutAnchorable x:Name="ResultTab" Title="地盤描画" CanClose="False" CanHide="False">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,4,8,4">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                
                <ToggleButton ToolTip="地盤表示" IsChecked="{Binding IsGroundLayerOverwrapped}">
                    <svgc:SvgViewbox Source="/Icons/SoilLayerVisible.svg" Style="{StaticResource SvgIconStyle24}"/>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="Checked">
                            <i:InvokeCommandAction Command="{Binding PileBodyTextChangedCommand}" />
                        </i:EventTrigger>
                        <i:EventTrigger EventName="Unchecked">
                            <i:InvokeCommandAction Command="{Binding PileBodyTextChangedCommand}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </ToggleButton>
            </StackPanel>


            <StackPanel Visibility="{Binding IsGroundLayerOverwrapped, 
                    Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="地盤No" Width="50"/>
                    <ComboBox ItemsSource="{Binding InputModel.GroundsInputCountList}" SelectedItem="{Binding SelectedGroundNo}" Width="50">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding PileBodyTextChangedCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="地表Z" Width="50"/>
                    <TextBlock Text="{Binding SelectedGroundInput.GroundTopAltitude, StringFormat='{}{0:+0.000;-0.00;+0.000}', UpdateSourceTrigger=LostFocus}" Width="50"/>
                    <TextBlock Text="m"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="杭頭Z" Width="50"/>
                    <TextBox Text="{Binding PileTopAltitude, StringFormat='{}{0:+0.000;-0.00;+0.000}'}" Width="50"
                             KeyDown="PileTopAltitude_KeyDown" 
                             PreviewKeyDown="TextBox_PreviewKeyDown"
                             PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="PreviewLostKeyboardFocus">
                                <i:InvokeCommandAction Command="{Binding PileBodyTextChangedCommand}" />
                            </i:EventTrigger>

                            <i:EventTrigger EventName="PreviewKeyDown">
                                <!--<i:InvokeCommandAction Command="{Binding PileBodyTextChangedCommand}" CommandParameter="{Binding ElementName=TextBoxPileTopAltitude}" />-->
                                <i:InvokeCommandAction Command="{Binding PileBodyTextChangedCommand}"/>

                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </TextBox>
                    <TextBlock Text="m"/>
                </StackPanel>

                <!--<StackPanel Orientation="Horizontal">
                    <TextBlock Text="杭先端N値" Width="75"/>
                    <TextBox Text="{Binding TemporarySoilPile.PileToeNValue, StringFormat=N1, Mode=OneWay}" 
                             IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}" Width="50"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="杭先端平均N値算定範囲上端レベル" Width="200"/>
                    <TextBox Text="{Binding TemporarySoilPile.PileToeNValueAverageRangeUpperAltitude, StringFormat=N1, Mode=OneWay}" 
                             IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}" Width="50"/>
                    <TextBlock Text="m" Width="50"/>
                </StackPanel>

                
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="杭先端平均N値算定範囲下端レベル" Width="200"/>
                    <TextBox Text="{Binding TemporarySoilPile.PileToeNValueAverageRangeLowerAltitude, StringFormat=N1, Mode=OneWay}" 
                             IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}" Width="50"/>
                    <TextBlock Text="m" Width="50"/>
                </StackPanel>-->

                <StackPanel>
                    <!-- 地盤描画ペイン: SettlementWindow と統一した列幅 (ラベル *, 数式 40, 値 60, 単位 48) -->
                    <Grid Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <!-- 上下 2 行構成 (標高/Z) のため +3 行 -->
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>

                        <!--<TextBlock Grid.Row="10" Grid.Column="0" Text="既製杭先端閉塞率" />
                        <TextBox  Grid.Row="10" Grid.Column="2" 
                             Text="{Binding PileBody.TipNonPermability, UpdateSourceTrigger=PreviewLostKeyboardFocus}"
                             HorizontalContentAlignment="Right"
                            PreviewLostKeyboardFocus="OnPileBodyPreviewLostKeyboardFocus" />

                        <TextBlock  Grid.Row="11" Grid.Column="0" 
                            Text="鋼管杭先端閉塞率" />
                        <TextBox  Grid.Row="11" Grid.Column="2" 
                             Text="{Binding PileBody.TipNonPermability, 
                        UpdateSourceTrigger=PreviewLostKeyboardFocus}"
                          
                             HorizontalContentAlignment="Right"
                            PreviewLostKeyboardFocus="OnPileBodyPreviewLostKeyboardFocus" />-->

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="杭先端径"/>
                        <controls:FormulaControl Grid.Row="8" Grid.Column="1" Formula="D" Style="{StaticResource FormulaControlStyle}" HorizontalContentAlignment="Right"/>
                        <TextBox Grid.Row="8" Grid.Column="2"
                            Text="{Binding TemporarySoilPile.D, Mode=OneWay, StringFormat=N3}"
                            IsReadOnly="True" Foreground="Gray"
                            HorizontalContentAlignment="Right"
                            PreviewLostKeyboardFocus="TextBox_PreviewLostKeyboardFocus"
                            PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"/>
                        <TextBlock Grid.Row="8" Grid.Column="3" Text="m"/>


                        <TextBlock Grid.Row="9" Grid.Column="0" Text="杭先端平均N値"/>
                        <controls:FormulaControl Grid.Row="9" Grid.Column="1" Formula="\overline{N}" Style="{StaticResource FormulaControlStyle}" HorizontalContentAlignment="Right"/>
                        <TextBox Grid.Row="9" Grid.Column="2"
                             Text="{Binding TemporarySoilPile.PileToeNValue, Mode=OneWay, StringFormat=N1}" IsReadOnly="True"
                             Foreground="Gray" HorizontalContentAlignment="Right"/>


                        <!-- 平均N値算定範囲 上端: ラベル RowSpan=2 + 標高/Z= サブ行 -->
                        <TextBlock Grid.Row="10" Grid.RowSpan="2" Grid.Column="0"
                            Text="平均N値算定範囲 上端" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="10" Grid.Column="1" Text="標高=" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
                        <TextBox Grid.Row="10" Grid.Column="2" IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}" HorizontalContentAlignment="Right" FontSize="11">
                            <TextBox.Text>
                                <MultiBinding Converter="{StaticResource ZElevationConverter}" StringFormat="{}{0:N3}" Mode="OneWay">
                                    <Binding Path="TemporarySoilPile.PileToeNValueAverageRangeUpperAltitude"/>
                                    <Binding Path="InputModel.FundamentalInput.ReferenceAltitude"/>
                                </MultiBinding>
                            </TextBox.Text>
                        </TextBox>
                        <TextBlock Grid.Row="10" Grid.Column="3" Text="m" FontSize="11" Margin="2,0,0,0"/>
                        <TextBlock Grid.Row="11" Grid.Column="1" Text="Z=" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
                        <TextBox Grid.Row="11" Grid.Column="2" Text="{Binding TemporarySoilPile.PileToeNValueAverageRangeUpperAltitude, Mode=OneWay, StringFormat=N3}" IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}" HorizontalContentAlignment="Right" FontSize="11"/>
                        <TextBlock Grid.Row="11" Grid.Column="3" Text="m" FontSize="11" Margin="2,0,0,0"/>

                        <!-- 杭先端: ラベル RowSpan=2 + 標高/Z= -->
                        <TextBlock Grid.Row="12" Grid.RowSpan="2" Grid.Column="0"
                            Text="杭先端" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="12" Grid.Column="1" Text="標高=" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
                        <TextBox Grid.Row="12" Grid.Column="2" IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}" HorizontalContentAlignment="Right" FontSize="11">
                            <TextBox.Text>
                                <MultiBinding Converter="{StaticResource ZElevationConverter}" StringFormat="{}{0:N3}" Mode="OneWay">
                                    <Binding Path="TemporarySoilPile.PileBottomAltitude"/>
                                    <Binding Path="InputModel.FundamentalInput.ReferenceAltitude"/>
                                </MultiBinding>
                            </TextBox.Text>
                        </TextBox>
                        <TextBlock Grid.Row="12" Grid.Column="3" Text="m" FontSize="11" Margin="2,0,0,0"/>
                        <TextBlock Grid.Row="13" Grid.Column="1" Text="Z=" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
                        <TextBox Grid.Row="13" Grid.Column="2" Text="{Binding TemporarySoilPile.PileBottomAltitude, Mode=OneWay, StringFormat=N3}" IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}" HorizontalContentAlignment="Right" FontSize="11"/>
                        <TextBlock Grid.Row="13" Grid.Column="3" Text="m" FontSize="11" Margin="2,0,0,0"/>

                        <!-- 平均N値算定範囲 下端: ラベル RowSpan=2 + 標高/Z= -->
                        <TextBlock Grid.Row="14" Grid.RowSpan="2" Grid.Column="0"
                            Text="平均N値算定範囲 下端" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="14" Grid.Column="1" Text="標高=" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
                        <TextBox Grid.Row="14" Grid.Column="2" IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}" HorizontalContentAlignment="Right" FontSize="11">
                            <TextBox.Text>
                                <MultiBinding Converter="{StaticResource ZElevationConverter}" StringFormat="{}{0:N3}" Mode="OneWay">
                                    <Binding Path="TemporarySoilPile.PileToeNValueAverageRangeLowerAltitude"/>
                                    <Binding Path="InputModel.FundamentalInput.ReferenceAltitude"/>
                                </MultiBinding>
                            </TextBox.Text>
                        </TextBox>
                        <TextBlock Grid.Row="14" Grid.Column="3" Text="m" FontSize="11" Margin="2,0,0,0"/>
                        <TextBlock Grid.Row="15" Grid.Column="1" Text="Z=" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
                        <TextBox Grid.Row="15" Grid.Column="2" Text="{Binding TemporarySoilPile.PileToeNValueAverageRangeLowerAltitude, Mode=OneWay, StringFormat=N3}" IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}" HorizontalContentAlignment="Right" FontSize="11"/>
                        <TextBlock Grid.Row="15" Grid.Column="3" Text="m" FontSize="11" Margin="2,0,0,0"/>

                        <TextBlock Grid.Row="16" Grid.Column="0" Text="杭先端支持力度"/>
                        <controls:FormulaControl Grid.Row="16" Grid.Column="1" Formula="q_{pu}" Style="{StaticResource FormulaControlStyle}" HorizontalContentAlignment="Right"/>
                        <TextBox Grid.Row="16" Grid.Column="2"
                             Text="{Binding TemporarySoilPile.Qpu, Mode=OneWay, StringFormat=N0}"
                             IsReadOnly="True" Foreground="Gray" HorizontalContentAlignment="Right"/>
                        <TextBlock Grid.Row="16" Grid.Column="3"><Run Text="kN/m"/><Run Text="2" BaselineAlignment="Superscript" FontSize="9"/></TextBlock>

                        <TextBlock Grid.Row="17" Grid.Column="0" Text="杭先端面積"/>
                        <controls:FormulaControl Grid.Row="17" Grid.Column="1" Formula="A_p" Style="{StaticResource FormulaControlStyle}" HorizontalContentAlignment="Right"/>
                        <TextBox Grid.Row="17" Grid.Column="2"
                             Text="{Binding TemporarySoilPile.Ap, Mode=OneWay, StringFormat=N3}"
                             IsReadOnly="True" Foreground="Gray" HorizontalContentAlignment="Right"/>
                        <TextBlock Grid.Row="17" Grid.Column="3"><Run Text="m"/><Run Text="2" BaselineAlignment="Superscript" FontSize="9"/></TextBlock>

                        <TextBlock Grid.Row="18" Grid.Column="0" Text="極限先端支持力"/>
                        <controls:FormulaControl Grid.Row="18" Grid.Column="1" Formula="R_{pu}" Style="{StaticResource FormulaControlStyle}" HorizontalContentAlignment="Right"/>
                        <TextBox Grid.Row="18" Grid.Column="2"
                             Text="{Binding TemporarySoilPile.Rpu, Mode=OneWay, StringFormat=N0}"
                             IsReadOnly="True" Foreground="Gray" HorizontalContentAlignment="Right"/>
                        <TextBlock Grid.Row="18" Grid.Column="3" Text="kN"/>


                        <TextBlock Grid.Row="24" Grid.Column="0" Text="極限周面抵抗力"/>
                        <controls:FormulaControl Grid.Row="24" Grid.Column="1" Formula="R_{fu}" Style="{StaticResource FormulaControlStyle}" HorizontalContentAlignment="Right"/>
                        <TextBox Grid.Row="24" Grid.Column="2"
                             Text="{Binding TemporarySoilPile.Rfu, Mode=OneWay, StringFormat=N0}" IsReadOnly="True"
                             Foreground="Gray" HorizontalContentAlignment="Right"/>
                        <TextBlock Grid.Row="24" Grid.Column="3" Text="kN"/>


                        <TextBlock Grid.Row="25" Grid.Column="0" Text="終局限界引抜力" Foreground="{StaticResource UltimateLimitBrush}"/>
                        <controls:FormulaControl Grid.Row="25" Grid.Column="1" Formula="R_{t,UL}" Style="{StaticResource FormulaControlStyle}" HorizontalContentAlignment="Right" Foreground="{StaticResource UltimateLimitBrush}"/>
                        <TextBox Grid.Row="25" Grid.Column="2"
                             Text="{Binding TemporarySoilPile.Rt_ULS, Mode=OneWay, StringFormat=N0}" IsReadOnly="True"
                             Foreground="{StaticResource UltimateLimitBrush}" HorizontalContentAlignment="Right"/>
                        <TextBlock Grid.Row="25" Grid.Column="3" Text="kN" Foreground="{StaticResource UltimateLimitBrush}"/>


                        <TextBlock Grid.Row="26" Grid.Column="0" Text="損傷限界引抜力" Foreground="{StaticResource DamageLimitBrush}"/>
                        <controls:FormulaControl Grid.Row="26" Grid.Column="1" Formula="R_{t,DL}" Style="{StaticResource FormulaControlStyle}" HorizontalContentAlignment="Right" Foreground="{StaticResource DamageLimitBrush}"/>
                        <TextBox Grid.Row="26" Grid.Column="2"
                             Text="{Binding TemporarySoilPile.Rt_DLS, Mode=OneWay, StringFormat=N0}" IsReadOnly="True"
                             Foreground="{StaticResource DamageLimitBrush}" HorizontalContentAlignment="Right"/>
                        <TextBlock Grid.Row="26" Grid.Column="3" Text="kN" Foreground="{StaticResource DamageLimitBrush}"/>


                        <TextBlock Grid.Row="27" Grid.Column="0" Text="使用限界引抜力" Foreground="{StaticResource ServiceLimitBrush}"/>
                        <controls:FormulaControl Grid.Row="27" Grid.Column="1" Formula="R_{t,SL}" Style="{StaticResource FormulaControlStyle}" HorizontalContentAlignment="Right" Foreground="{StaticResource ServiceLimitBrush}"/>
                        <TextBox Grid.Row="27" Grid.Column="2"
                             Text="{Binding TemporarySoilPile.Rt_SLS, Mode=OneWay, StringFormat=N0}" IsReadOnly="True"
                             Foreground="{StaticResource ServiceLimitBrush}" HorizontalContentAlignment="Right"/>
                        <TextBlock Grid.Row="27" Grid.Column="3" Text="kN" Foreground="{StaticResource ServiceLimitBrush}"/>


                        <TextBlock Grid.Row="28" Grid.Column="0" Text="使用限界支持力" Foreground="{StaticResource ServiceLimitBrush}"/>
                        <controls:FormulaControl Grid.Row="28" Grid.Column="1" Formula="R_{SL}" Style="{StaticResource FormulaControlStyle}" HorizontalContentAlignment="Right" Foreground="{StaticResource ServiceLimitBrush}"/>
                        <TextBox Grid.Row="28" Grid.Column="2"
                             Text="{Binding TemporarySoilPile.R_SLS, Mode=OneWay, StringFormat=N0}" IsReadOnly="True"
                             Foreground="{StaticResource ServiceLimitBrush}" HorizontalContentAlignment="Right"/>
                        <TextBlock Grid.Row="28" Grid.Column="3" Text="kN" Foreground="{StaticResource ServiceLimitBrush}"/>


                        <TextBlock Grid.Row="29" Grid.Column="0" Text="損傷限界支持力" Foreground="{StaticResource DamageLimitBrush}"/>
                        <controls:FormulaControl Grid.Row="29" Grid.Column="1" Formula="R_{DL}" Style="{StaticResource FormulaControlStyle}" HorizontalContentAlignment="Right" Foreground="{StaticResource DamageLimitBrush}"/>
                        <TextBox Grid.Row="29" Grid.Column="2"
                             Text="{Binding TemporarySoilPile.R_DLS, Mode=OneWay, StringFormat=N0}" IsReadOnly="True"
                             Foreground="{StaticResource DamageLimitBrush}" HorizontalContentAlignment="Right"/>
                        <TextBlock Grid.Row="29" Grid.Column="3" Text="kN" Foreground="{StaticResource DamageLimitBrush}"/>


                        <TextBlock Grid.Row="30" Grid.Column="0" Text="終局限界支持力" Foreground="{StaticResource UltimateLimitBrush}"/>
                        <controls:FormulaControl Grid.Row="30" Grid.Column="1" Formula="R_{UL}" Style="{StaticResource FormulaControlStyle}" HorizontalContentAlignment="Right" Foreground="{StaticResource UltimateLimitBrush}"/>
                        <TextBox Grid.Row="30" Grid.Column="2"
                             Text="{Binding TemporarySoilPile.R_ULS, Mode=OneWay, StringFormat=N0}" IsReadOnly="True"
                             Foreground="{StaticResource UltimateLimitBrush}" HorizontalContentAlignment="Right"/>
                        <TextBlock Grid.Row="30" Grid.Column="3" Text="kN" Foreground="{StaticResource UltimateLimitBrush}"/>

                    </Grid>
                </StackPanel>
            </StackPanel>
        </StackPanel>
                                </ScrollViewer>
                            </avalonDock:LayoutAnchorable>
                        </avalonDock:LayoutDocumentPane>
                    </avalonDock:LayoutDocumentPaneGroup>
                </avalonDock:LayoutPanel>
            </avalonDock:LayoutRoot>
        </avalonDock:DockingManager>

        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ペイン最大化ボタン (左側): ペインをアンドックして最大化、再押下で元の位置にドック -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="アンドック・最大化:" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                <Button x:Name="ButtonMaximizeInput" Content="杭体入力" Height="26" Padding="8,0" Margin="0,0,4,0"
                        ToolTip="杭体入力ペインをアンドックして最大化 / もう一度押すと元の位置にドック"/>
                <Button x:Name="ButtonMaximizeShape" Content="杭姿図" Height="26" Padding="8,0" Margin="0,0,4,0"
                        ToolTip="杭姿図ペインをアンドックして最大化 / もう一度押すと元の位置にドック"/>
                <Button x:Name="ButtonMaximizeResult" Content="地盤描画" Height="26" Padding="8,0" Margin="0,0,4,0"
                        ToolTip="地盤描画ペインをアンドックして最大化 / もう一度押すと元の位置にドック"/>
            </StackPanel>

            <!-- OK / キャンセルボタン (右側) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                <Button x:Name="ButtonOk" Content="保存 (Ctrl+Enter)" HorizontalAlignment="Left"
                        VerticalAlignment="Top" Height="30" Width="150" Command="{Binding OkCommand}"/>
                <Button x:Name="ButtonCancel" Content="キャンセル (Esc)" HorizontalAlignment="Left"
                        VerticalAlignment="Top" Height="30" Width="150" Command="{Binding CancelCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

    