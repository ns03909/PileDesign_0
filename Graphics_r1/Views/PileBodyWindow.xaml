                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding PileBodyTextChangedCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="地表Z" Width="50"/>
                    <TextBlock Text="{Binding InputModel.FundamentalInput.RefLevel}"/>
                    <TextBlock Text="{Binding SelectedGroundInput.GroundTopAltitude, StringFormat='{}{0:+0.000;-0.00;+0.000}', UpdateSourceTrigger=LostFocus}" Width="50"/>
