<Window x:Class="PileDesign.Views.AnalysisPreflightDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="解析実行の確認"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="White">
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="RootContent" Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.18"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
    <Grid x:Name="RootContent" Margin="20" Opacity="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="&#x25B6;" Foreground="{StaticResource PrimaryAccentBrush}"
                       FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock x:Name="HeaderText" Text="水平解析を実行します"
                       FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 説明 -->
        <TextBlock Grid.Row="1" Text="以下の内容で解析を実行します。問題なければ「実行」を押してください。"
                   Foreground="#555" Margin="0,0,0,12" TextWrapping="Wrap"/>

        <!-- サマリーカード -->
        <Border Grid.Row="2" Background="#F8F9FA" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1"
                CornerRadius="4" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="総ステップ数" Foreground="#555" Margin="0,2"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TotalStepsText" FontWeight="SemiBold" Margin="0,2"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="荷重ケース数" Foreground="#555" Margin="0,2"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LoadCaseCountText" Margin="0,2"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="荷重組合せ数" Foreground="#555" Margin="0,2"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="CombinationCountText" Margin="0,2"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="逆方向組合せ" Foreground="#555" Margin="0,2"/>
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="CounterLoadingText" Margin="0,2"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="杭の非線形 ON" Foreground="#555" Margin="0,2"/>
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="NonLinearText" Margin="0,2"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="ケース並列度" Foreground="#555" Margin="0,2"/>
                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="ParallelismText" Margin="0,2"/>
            </Grid>
        </Border>

        <!-- 入力警告（注意レベル、ある場合のみ表示） -->
        <Border Grid.Row="3" x:Name="WarningBox" Visibility="Collapsed"
                Background="#FFFBEA" BorderBrush="#E0B400" BorderThickness="1"
                CornerRadius="4" Padding="14,10" Margin="0,12,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="&#x26A0;" Foreground="#B07A00" FontSize="16" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="WarningHeader" Text="入力に注意点があります"
                               FontWeight="SemiBold" Foreground="#8A6200"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <ItemsControl x:Name="WarningList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <TextBlock Text="&#x2022;" Foreground="#8A6200" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding}" Foreground="#5C4500" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="このまま実行することもできますが、必要に応じて入力を見直してください。"
                           Foreground="#8A6200" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- フッター -->
        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox Grid.Column="0" x:Name="DoNotShowAgainCheckBox"
                      Content="次回から表示しない" Foreground="#888"
                      VerticalAlignment="Center"/>
            <Button Grid.Column="1" x:Name="CancelButton" Content="キャンセル(_C)" IsCancel="True"
                    Style="{StaticResource DialogCancelButtonStyle}"
                    ToolTip="Esc / Alt+C / Tab で選択して Space"/>
            <Button Grid.Column="2" x:Name="OkButton" Content="実行(_E)" IsDefault="True"
                    Click="OkButton_Click"
                    Style="{StaticResource PrimaryDialogButtonStyle}"
                    ToolTip="Enter / Alt+E / Tab で選択して Space"/>
        </Grid>
    </Grid>
</Window>
