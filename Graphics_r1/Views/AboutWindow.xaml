<Window x:Class="PileDesign.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="バージョン情報"
        SizeToContent="Height"
        Width="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">

    <Border Padding="20">
        <StackPanel>

            <!-- アプリ名とバージョン -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/Icons/cover.png" Width="44" Height="44"
                       Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Top"/>
                <StackPanel>
                    <TextBlock Text="杭基礎検討プログラム" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="VersionText" FontSize="13" Margin="0,2,0,0"/>
                    <TextBlock x:Name="BetaNote" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="試用段階 (beta) の版です。計算内容・画面ともに変わる可能性があります。"/>
                </StackPanel>
            </StackPanel>

            <Separator Margin="0,16,0,12"/>

            <!-- 環境 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="ビルド日" Margin="0,0,12,4"
                           Foreground="{StaticResource MutedTextBrush}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="BuildDateText" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="実行環境" Margin="0,0,12,4"
                           Foreground="{StaticResource MutedTextBrush}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="RuntimeText" Margin="0,0,0,4"/>

                <!-- 不具合の連絡時に要る場所。パスは選択してコピーできるようにする -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="ログの保存先" Margin="0,0,12,4"
                           Foreground="{StaticResource MutedTextBrush}"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="LogPathText" Margin="0,0,0,4"
                         IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         Padding="0" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="自動保存の保存先" Margin="0,0,12,0"
                           Foreground="{StaticResource MutedTextBrush}"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="AutoSavePathText"
                         IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         Padding="0" TextWrapping="Wrap"/>
            </Grid>

            <Separator Margin="0,14,0,12"/>

            <TextBlock Text="基礎地盤研究会" FontSize="11"
                       Foreground="{StaticResource MutedTextBrush}"/>

            <!-- ボタン -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="ButtonReleaseNotes" Content="更新履歴を見る(_H)"
                        Height="30" MinWidth="140" Margin="0,0,8,0"
                        ToolTip="ヘルプの「更新履歴」を開きます。"
                        Click="ButtonReleaseNotes_Click"/>
                <Button x:Name="ButtonOpenLogFolder" Content="ログの場所を開く(_L)"
                        Height="30" MinWidth="140" Margin="0,0,8,0"
                        ToolTip="不具合をお知らせいただくときに、このフォルダの内容が手掛かりになります。"
                        Click="ButtonOpenLogFolder_Click"/>
                <Button x:Name="ButtonClose" Content="閉じる(_C)"
                        Height="30" MinWidth="100"
                        IsDefault="True" IsCancel="True"
                        Click="ButtonClose_Click"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
