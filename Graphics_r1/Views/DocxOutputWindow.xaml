<Window x:Class="PileDesign.Views.DocxOutputWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:local="clr-namespace:PileDesign.ViewModels"
xmlns:conv="clr-namespace:PileDesign.Converters"
xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
xmlns:svg="http://sharpvectors.codeplex.com/runtime/"
xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
xmlns:common="clr-namespace:PileDesign.Common"
mc:Ignorable="d"
Title="計算書出力設定" Height="560" Width="640"
common:EscapeKeyBehavior.Enable="True"
WindowStartupLocation="CenterOwner">

    <!-- DataContext は code-behind で渡される MainWindowViewModel を直接利用する。
         ここで <local:MainWindowViewModel/> を書くと一時 VM が生成され、
         AutoSaveService 等の購読/タイマーが残って共有状態を汚す不具合があったため削除。
         d:DataContext は XAML デザイナーの IntelliSense 用 (実行時には影響なし) -->
    <d:Window.DataContext>
        <local:MainWindowViewModel/>
    </d:Window.DataContext>

    <Window.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:BooleanNegationConverter x:Key="BooleanNegationConverter" />
        <conv:IntEqualsConverter x:Key="IntEqualsConverter"/>
        <conv:BoolEqualsConverter x:Key="BoolEqualsConverter"/>
        <conv:LimitStateLabelConverter x:Key="LimitStateLabelConverter"/>
        <conv:LoadCaseLevelToColorConverter x:Key="LoadCaseLevelToColorConverter"/>
        <Style x:Key="SvgIconStyle" TargetType="svgc:SvgViewbox">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
        </Style>

        <!-- 解析未完了時に無効化するCheckBoxスタイル -->
        <Style x:Key="AnalysisRequiredCheckBox" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- メインコンテンツ: 左右2カラム -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 左カラム: 解析ケース設定 ===== -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <GroupBox Header="荷重ケース レベル1" Margin="0,0,0,4">
                        <common:EnhancedDataGrid ItemsSource="{Binding CurrentInputModel.LoadCasesInput.LoadCasesLevel1}"
                                  AutoGenerateColumns="False" HeadersVisibility="None" CanUserAddRows="False"
                                  MaxHeight="120" VerticalScrollBarVisibility="Auto">
                            <common:EnhancedDataGrid.Columns>
                                <DataGridTemplateColumn Width="*" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding LoadName}" Foreground="{Binding Level, Converter={StaticResource LoadCaseLevelToColorConverter}}" Margin="4,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsApplicableForDocxDisplay, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                      IsEnabled="{Binding IsAnalyzed}" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </common:EnhancedDataGrid.Columns>
                        </common:EnhancedDataGrid>
                    </GroupBox>

                    <GroupBox Header="荷重ケース レベル2" Margin="0,0,0,4">
                        <common:EnhancedDataGrid ItemsSource="{Binding CurrentInputModel.LoadCasesInput.LoadCasesLevel2}"
                                  AutoGenerateColumns="False" HeadersVisibility="None" CanUserAddRows="False"
                                  MaxHeight="120" VerticalScrollBarVisibility="Auto">
                            <common:EnhancedDataGrid.Columns>
                                <DataGridTemplateColumn Width="*" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding LoadName}" Foreground="{Binding Level, Converter={StaticResource LoadCaseLevelToColorConverter}}" Margin="4,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsApplicableForDocxDisplay, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                      IsEnabled="{Binding IsAnalyzed}" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </common:EnhancedDataGrid.Columns>
                        </common:EnhancedDataGrid>
                    </GroupBox>

                    <GroupBox Header="荷重組合せ" Margin="0,0,0,4">
                        <common:EnhancedDataGrid ItemsSource="{Binding CurrentInputModel.LoadCasesInput.LoadCombinations}"
                                  AutoGenerateColumns="False" HeadersVisibility="None" CanUserAddRows="False"
                                  MaxHeight="80" VerticalScrollBarVisibility="Auto">
                            <common:EnhancedDataGrid.Columns>
                                <DataGridTemplateColumn Width="*" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" Margin="4,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsApplicableForDocxDisplay, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                      IsEnabled="{Binding IsAnalyzed}" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </common:EnhancedDataGrid.Columns>
                        </common:EnhancedDataGrid>
                    </GroupBox>

                    <GroupBox Header="液状化" Margin="0,0,0,4" Padding="4">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="液状化あり" IsChecked="{Binding DocxOutput.IncludeOutputLiquefactionYes, Mode=TwoWay}"
                                      IsEnabled="{Binding DocxOutput.IsLiquefactionYesAnalyzed}" Margin="0,0,15,0"/>
                            <CheckBox Content="液状化なし" IsChecked="{Binding DocxOutput.IncludeOutputLiquefactionNo, Mode=TwoWay}"
                                      IsEnabled="{Binding DocxOutput.IsLiquefactionNoAnalyzed}"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="計算書レベル" Margin="0,0,0,4" Padding="4">
                        <StackPanel>
                            <RadioButton Content="簡易（数式説明なし）" GroupName="CalculationReportLevel"
                                         IsChecked="{Binding DocxOutput.CalculationReportLevel, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1, Mode=TwoWay}" />
                            <RadioButton Content="詳細（数式説明あり）" GroupName="CalculationReportLevel" Margin="0,2,0,0"
                                         IsChecked="{Binding DocxOutput.CalculationReportLevel, Converter={StaticResource IntEqualsConverter}, ConverterParameter=2, Mode=TwoWay}" />
                        </StackPanel>
                    </GroupBox>

                </StackPanel>
            </ScrollViewer>

            <!-- ===== 右カラム: 出力項目選択 ===== -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <GroupBox Header="入力データ" Margin="0,0,0,4" Padding="4">
                        <StackPanel>
                            <CheckBox Content="基本設定" IsChecked="{Binding DocxOutput.IncludeFundamental, Mode=TwoWay}" Margin="0,2"/>
                            <CheckBox Content="荷重条件" IsChecked="{Binding DocxOutput.IncludeLoadCondition, Mode=TwoWay}" Margin="0,2"/>
                            <CheckBox Content="杭体 (杭体明細表を含む)" IsChecked="{Binding DocxOutput.IncludePileBodies, Mode=TwoWay}" Margin="0,2"/>
                            <CheckBox Content="杭配置 (テーブル)" IsChecked="{Binding DocxOutput.IncludePileLayoutTable, Mode=TwoWay}" Margin="0,2"/>
                            <CheckBox Content="杭軸力" IsChecked="{Binding DocxOutput.IncludePileAxialLoad, Mode=TwoWay}" Margin="0,2"/>
                            <CheckBox Content="前後方杭" IsChecked="{Binding DocxOutput.IncludeIsFrontPile, Mode=TwoWay}" Margin="0,2"/>
                            <CheckBox Content="検討方針 (杭頭接続仮定を含む)" IsChecked="{Binding DocxOutput.IncludeDesignApproach, Mode=TwoWay}" Margin="0,2"/>
                            <CheckBox Content="計算条件・仮定 (材料モデル化オプション等)" IsChecked="{Binding DocxOutput.IncludeAssumptions, Mode=TwoWay}" Margin="0,2"/>
                            <CheckBox Content="地盤情報" IsChecked="{Binding DocxOutput.IncludeGroundInformation, Mode=TwoWay}" Margin="0,2"/>
                            <CheckBox Content="液状化検討" IsChecked="{Binding DocxOutput.IncludeLiquefaction, Mode=TwoWay}" Margin="0,2"/>
                            <CheckBox Content="杭配置図" IsChecked="{Binding DocxOutput.IncludePileLocationMap, Mode=TwoWay}" Margin="0,2"/>
                            <CheckBox Content="杭軸力図" IsChecked="{Binding DocxOutput.IncludePileAxialLoadMap, Mode=TwoWay}" Margin="0,2"/>
                            <CheckBox Content="前方杭・後方杭設定図" IsChecked="{Binding DocxOutput.IncludeIsFrontMap, Mode=TwoWay}" Margin="0,2"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="地盤グラフ" Margin="0,0,0,4" Padding="4">
                        <StackPanel>
                            <CheckBox Content="N値分布グラフ" IsChecked="{Binding DocxOutput.IncludeNValueGraph, Mode=TwoWay}" Margin="0,2"/>
                            <CheckBox Content="粘着力 Cu グラフ" IsChecked="{Binding DocxOutput.IncludeCuGraph, Mode=TwoWay}" Margin="0,2"/>
                            <CheckBox Content="S波速度 Vs グラフ" IsChecked="{Binding DocxOutput.IncludeVsGraph, Mode=TwoWay}" Margin="0,2"/>
                            <CheckBox Content="変形係数 Es グラフ" IsChecked="{Binding DocxOutput.IncludeEsGraph, Mode=TwoWay}" Margin="0,2"/>
                            <CheckBox Content="液状化安全率 FL グラフ" IsChecked="{Binding DocxOutput.IncludeFLGraph, Mode=TwoWay}" Margin="0,2"/>
                            <CheckBox Content="任意地盤変位グラフ" IsChecked="{Binding DocxOutput.IncludeGroundDisplacementGraph, Mode=TwoWay}" Margin="0,2"/>
                            <CheckBox Content="応答スペクトルグラフ" IsChecked="{Binding DocxOutput.IncludeResponseSpectrumGraph, Mode=TwoWay}" Margin="0,2"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="杭の図・諸元" Margin="0,0,0,4" Padding="4">
                        <StackPanel>
                            <CheckBox Content="杭姿図 (杭体ごと)" IsChecked="{Binding DocxOutput.IncludePileElevation, Mode=TwoWay}" Margin="0,2"/>
                            <CheckBox Content="杭断面図 (配筋詳細)" IsChecked="{Binding DocxOutput.IncludePileSectionDiagram, Mode=TwoWay}" Margin="0,2"/>
                            <CheckBox Content="杭頭上面図" IsChecked="{Binding DocxOutput.IncludePileTopView, Mode=TwoWay}" Margin="0,2"/>
                            <CheckBox Content="杭頭諸元テーブル" IsChecked="{Binding DocxOutput.IncludePileTopSpecs, Mode=TwoWay}" Margin="0,2"/>
                            <CheckBox Content="軸力制限テーブル" IsChecked="{Binding DocxOutput.IncludeAxialLimitTable, Mode=TwoWay}" Margin="0,2"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="要素分割" Margin="0,0,0,4" Padding="4">
                        <StackPanel>
                            <CheckBox Content="要素分割杭姿図 (分割点付き)" IsChecked="{Binding DocxOutput.IncludeElementDivisionPileShape, Mode=TwoWay}" Margin="0,2"/>
                            <CheckBox Content="水平地盤反力分布グラフ" IsChecked="{Binding DocxOutput.IncludeHorizontalSoilReactionGraph, Mode=TwoWay}" Margin="0,2"/>
                            <CheckBox Content="土圧合力ばね分布グラフ" IsChecked="{Binding DocxOutput.IncludeDoatsuGoryokuBaneGraph, Mode=TwoWay}" Margin="0,2"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="支持力" Margin="0,0,0,4" Padding="4">
                        <CheckBox Content="支持力検討" IsChecked="{Binding DocxOutput.IncludeVertical, Mode=TwoWay}"
                                  IsEnabled="{Binding IsVerticalAnalysisDone}"
                                  ToolTip="単杭沈下解析が未完了の場合は灰色"/>
                    </GroupBox>

                    <GroupBox Header="水平検討" Margin="0,0,0,4" Padding="4">
                        <StackPanel>
                            <!-- 親: 解析未完了時に灰色 (子は親+解析の AND で IsEnabled 制御) -->
                            <CheckBox Content="水平検討" IsChecked="{Binding DocxOutput.IncludeHorizontal, Mode=TwoWay}" Margin="0,2"
                                      IsEnabled="{Binding IsHorizontalAnalysisDone}"/>
                            <!-- 表示順 (ユーザー指定):
                                 M-φ → M-θ → N-M → N-Q → 杭の変位・応力ダイアグラム
                                 → 杭頭Mマップ → 杭頭Qマップ → 解析サマリーレポート → 検定結果 -->
                            <CheckBox Content="M-φ関係" IsChecked="{Binding DocxOutput.IncludeHorizontal_MPhi, Mode=TwoWay}" Margin="15,2,0,2"
                                      IsEnabled="{Binding DocxOutput.CanEditHorizontalChildren}"/>
                            <CheckBox Content="M-θ関係" IsChecked="{Binding DocxOutput.IncludeHorizontal_MTheta, Mode=TwoWay}" Margin="15,2,0,2"
                                      IsEnabled="{Binding DocxOutput.CanEditHorizontalChildren}"/>
                            <CheckBox Content="N-M関係" IsChecked="{Binding DocxOutput.IncludeHorizontal_NMinT, Mode=TwoWay}" Margin="15,2,0,2"
                                      IsEnabled="{Binding DocxOutput.CanEditHorizontalChildren}"/>
                            <CheckBox Content="N-Q関係" IsChecked="{Binding DocxOutput.IncludeHorizontal_QNInT, Mode=TwoWay}" Margin="15,2,0,2"
                                      IsEnabled="{Binding DocxOutput.CanEditHorizontalChildren}"/>
                            <!-- 杭の変位・応力ダイアグラム (3 連グラフ: 変位 / せん断力 / 曲げモーメント) -->
                            <!-- 変位列は常に出力。せん断/曲げ列の有無を以下 2 個で個別 ON/OFF -->
                            <TextBlock Text="杭の変位・応力ダイアグラム" Margin="15,6,0,2"
                                       FontWeight="SemiBold" Foreground="#444"/>
                            <CheckBox Content="└ 曲げモーメント列を含める" IsChecked="{Binding DocxOutput.IncludeHorizontal_Bending, Mode=TwoWay}" Margin="30,2,0,2"
                                      IsEnabled="{Binding DocxOutput.CanEditHorizontalChildren}"
                                      ToolTip="3 連グラフの 3 列目 (曲げモーメント) を出力するか"/>
                            <CheckBox Content="└ せん断力列を含める" IsChecked="{Binding DocxOutput.IncludeHorizontal_Shear, Mode=TwoWay}" Margin="30,2,0,2"
                                      IsEnabled="{Binding DocxOutput.CanEditHorizontalChildren}"
                                      ToolTip="3 連グラフの 2 列目 (せん断力) を出力するか"/>
                            <CheckBox Content="└ 限界状態線を重ねて描画" IsChecked="{Binding DocxOutput.IncludeHorizontal_StressLimitState, Mode=TwoWay}"
                                      Margin="30,2,0,2"
                                      IsEnabled="{Binding DocxOutput.CanEditHorizontalChildren}"
                                      ToolTip="{Binding Converter={StaticResource LimitStateLabelConverter}, ConverterParameter=レベル1→損傷限界、レベル2+グレードS→損傷限界、レベル2+グレードA→安全限界 (低減後値) を自動選択, FallbackValue=レベル1→損傷限界、レベル2+グレードS→損傷限界、レベル2+グレードA→安全限界 (低減後値) を自動選択}"/>
                            <StackPanel Margin="30,0,0,2" IsEnabled="{Binding DocxOutput.CanEditHorizontalChildren}">
                                <TextBlock Text="└ まとめ方" FontSize="11" Foreground="#555"/>
                                <!-- 正負 2 つの TwoWay ライター (BooleanNegation) はウィンドウ再表示時に
                                     GroupName static テーブル経由で相互解除の無限ループ → StackOverflow を
                                     起こすため、「チェック時のみ書く」BoolEqualsConverter に統一 (2026-08-11) -->
                                <RadioButton Content="杭ごとに個別" GroupName="PileStressGrouping" Margin="15,2,0,0"
                                             IsChecked="{Binding DocxOutput.GroupPileStressBySoilPile, Mode=TwoWay, Converter={StaticResource BoolEqualsConverter}, ConverterParameter=False}"/>
                                <RadioButton Content="杭地盤セットごとにまとめる" GroupName="PileStressGrouping" Margin="15,2,0,0"
                                             IsChecked="{Binding DocxOutput.GroupPileStressBySoilPile, Mode=TwoWay, Converter={StaticResource BoolEqualsConverter}, ConverterParameter=True}"/>
                            </StackPanel>

                            <CheckBox Content="杭頭Mマップ" IsChecked="{Binding DocxOutput.IncludePileHeadMomentMap, Mode=TwoWay}" Margin="15,6,0,2"
                                      IsEnabled="{Binding DocxOutput.CanEditHorizontalChildren}"/>
                            <CheckBox Content="杭頭Qマップ" IsChecked="{Binding DocxOutput.IncludePileHeadShearMap, Mode=TwoWay}" Margin="15,2,0,2"
                                      IsEnabled="{Binding DocxOutput.CanEditHorizontalChildren}"/>
                            <CheckBox Content="解析サマリーレポート" IsChecked="{Binding DocxOutput.IncludeAnalysisSummaryReport, Mode=TwoWay}" Margin="15,2,0,2"
                                      IsEnabled="{Binding DocxOutput.CanEditHorizontalChildren}"/>
                            <CheckBox Content="検定結果（NGのみ）" IsChecked="{Binding DocxOutput.IncludeHorizontal_NGReport, Mode=TwoWay}" Margin="15,2,0,2"
                                      IsEnabled="{Binding DocxOutput.CanEditHorizontalChildren}"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="沈下検討" Margin="0,0,0,4" Padding="4">
                        <StackPanel>
                            <!-- 沈下検討は支持力検討 (IncludeVertical) の子。
                                 荷重沈下曲線・杭頭/杭先端沈下曲線・杭周面抵抗力グラフ・沈下詳細表は
                                 すべて「沈下検討」内で出力されます。 -->
                            <CheckBox Content="沈下検討（荷重-沈下曲線・周面抵抗・沈下表を含む）" IsChecked="{Binding DocxOutput.IncludeSettlement, Mode=TwoWay}" Margin="0,2"
                                      IsEnabled="{Binding DocxOutput.CanEditVerticalChildren}"
                                      ToolTip="支持力検討 ON かつ 単杭沈下解析完了で編集可"/>
                            <!-- 群杭沈下/基礎梁考慮 は独立 (各々の解析完了でガード) -->
                            <CheckBox Content="群杭沈下マップ" IsChecked="{Binding DocxOutput.IncludeGroupPileSettlement, Mode=TwoWay}" Margin="0,2"
                                      IsEnabled="{Binding IsGroupPileSettlementAnalysisDone}"/>
                            <CheckBox Content="単杭沈下解析（基礎梁考慮）結果" IsChecked="{Binding DocxOutput.IncludeVerticalBeamResults, Mode=TwoWay}" Margin="0,2"
                                      IsEnabled="{Binding IsVerticalBeamAnalysisDone}"/>
                        </StackPanel>
                    </GroupBox>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ボタン行: 左に一括選択、右に作成/キャンセル -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="全選択" Width="90" Command="{Binding DocxOutput.SelectAllDocxSectionsCommand}"
                        Padding="8,4" Margin="0,0,8,0"
                        ToolTip="出力項目・荷重ケースをすべて選択します（解析が未完了の項目は無効のまま）"/>
                <Button Content="全解除" Width="90" Command="{Binding DocxOutput.DeselectAllDocxSectionsCommand}"
                        Padding="8,4"
                        ToolTip="出力項目・荷重ケースをすべて解除します"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkButton" Content="計算書作成(_O)" Width="120" Click="OkButton_Click"
                        Padding="8,4" Margin="0,0,8,0"
                        IsDefault="True"
                        ToolTip="選択した項目で計算書を出力します (Enter / Alt+O)"/>
                <Button Content="キャンセル(_C)" Width="120" Click="CancelButton_Click" Padding="8,4"
                        IsCancel="True"
                        ToolTip="出力せずに閉じます (Esc / Alt+C)"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
