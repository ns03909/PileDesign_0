<Window x:Class="PileDesign.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PileDesign.ViewModels"
        xmlns:common="clr-namespace:PileDesign.Common"
        xmlns:controls="clr-namespace:WpfMath.Controls;assembly=WpfMath"
        mc:Ignorable="d"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="ヘルプ" Height="500" Width="800"
        common:EscapeKeyBehavior.Enable="True">
    <Window.Resources>
        <!-- Paragraphに適用するスタイルを定義 -->
        <Style TargetType="Paragraph">
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <!-- TableCellに罫線を適用するスタイルを定義 -->
        <Style TargetType="TableCell">
            <Setter Property="Background" Value="{StaticResource PrimaryAccentBrush}"/>
            <Setter Property="Foreground" Value =" white"/>
            <!--<Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="0.5"/>-->
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- Paragraphに適用するスタイルを定義 -->

        <!-- Paragraphに適用するスタイルを定義 -->

        <!-- FormulaControlに適用するスタイルを定義 -->
        <Style x:Key="FormulaControlStyle" TargetType="controls:FormulaControl">
            <Setter Property="Scale" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </Window.Resources>
    <wv2:WebView2 Name="HelpWebView" />
</Window>
