                        <Paragraph Style="{StaticResource BoldMiddleParagraphStyle}">
                            群杭の沈下
                        </Paragraph>

                        <BlockUIContainer>
                            <controls:FormulaControl Formula="\Delta S_E = S_E - S_E'=q\frac{B}{E_S} I_S" Style="{StaticResource FormulaControlStyle}"/>
                        </BlockUIContainer>

                        <BlockUIContainer>
                            <controls:FormulaControl Formula="I_s = (1-\nu_s^2) F_1 + (1-\nu_s - 2 \nu_s^2) F_2" Style="{StaticResource FormulaControlStyle}"/>
                        </BlockUIContainer>

                        <BlockUIContainer>
                            <controls:FormulaControl Formula="F_1 = \frac{1}{\pi}\left[l \log_e \frac{(1+\sqrt{l^2+1})\sqrt{l^2+d^2}}{l(1+\sqrt{l^2+d^2+1})}
