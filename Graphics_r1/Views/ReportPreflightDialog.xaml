<Window x:Class="PileDesign.Views.ReportPreflightDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="計算書を作成する前の確認"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="White">
    <!-- 計算書を作る前に、未実施の解析・入力変更前の結果・NG・判定できない項目をまとめて見せる (MainWindowViewModel.ReportPreflight.cs)。
         項目の右のボタンで確認先 (ダッシュボード・水平解析の画面) へ移る (計算書は作らない)。 -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="ReportPreflightBoolToVisibility"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="&#x25B6;" Foreground="{StaticResource PrimaryAccentBrush}"
                       FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="計算書を作成する前に確認してください" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,10"
                   Text="このまま作成することもできます。確認先へ移ると、計算書は作成せずにその画面を開きます。"/>

        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="1" Padding="10" CornerRadius="3">
            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ItemsControl x:Name="ItemList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Mark}" FontWeight="Bold" Foreground="#8A6200"/>
                                <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap"/>
                                <Button Grid.Column="2" Content="{Binding TargetText}" AutomationProperties.Name="{Binding TargetText}" Margin="8,0,0,0" Padding="6,0" VerticalAlignment="Top"
                                        Click="TargetButton_Click" Tag="{Binding}"
                                        ToolTip="計算書は作成せずに、この画面を開きます"
                                        Visibility="{Binding HasTarget, Converter={StaticResource ReportPreflightBoolToVisibility}}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="ProceedButton" Content="このまま作成(_O)" Style="{StaticResource PrimaryDialogButtonStyle}"
                    IsDefault="True" Click="ProceedButton_Click"/>
            <Button Content="キャンセル(_C)" Style="{StaticResource DialogCancelButtonStyle}" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
