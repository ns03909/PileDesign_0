<Window x:Class="PileDesign.Views.EvaluationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:common="clr-namespace:PileDesign.Common"
        xmlns:conv="clr-namespace:PileDesign.Converters"
        mc:Ignorable="d"
        Title="検定" Height="600" Width="900"
        MaxWidth="{x:Static SystemParameters.MaximizedPrimaryScreenWidth}"
        MaxHeight="{x:Static SystemParameters.MaximizedPrimaryScreenHeight}"
        WindowStartupLocation="CenterOwner"
        common:EscapeKeyBehavior.Enable="True">
    <Window.Resources>
        <conv:IntEqualsConverter x:Key="IntEqualsConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ToolBar Grid.Row="0" Padding="5">
            <Button Content="低減前水平解析" Command="{Binding EvaluateUnfactoredCommand}" Padding="10,2"/>
            <Separator/>
            <Button Content="低減後水平解析" Command="{Binding EvaluateFactoredCommand}" Padding="10,2"/>
            <Separator/>
            <RadioButton Content="NGのみ"
                         IsChecked="{Binding DisplayFilter, Converter={StaticResource IntEqualsConverter}, ConverterParameter=0}"
                         VerticalAlignment="Center" Margin="5,0"/>
            <RadioButton Content="OKのみ"
                         IsChecked="{Binding DisplayFilter, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1}"
                         VerticalAlignment="Center" Margin="5,0"/>
            <RadioButton Content="OK/NG"
                         IsChecked="{Binding DisplayFilter, Converter={StaticResource IntEqualsConverter}, ConverterParameter=2}"
                         VerticalAlignment="Center" Margin="5,0"/>
            <Separator/>
            <Button Content="ファイルに出力" Command="{Binding ExportCommand}" Padding="10,2"/>
        </ToolBar>

        <!-- 要約: 一番厳しいところ (支配ケース) を 1 行で示す。
             「NG が 3 件」だけでは、どこをどれだけ直せばよいかが分からないため。 -->
        <Border Grid.Row="1" Padding="10,6" BorderThickness="0,0,0,1"
                BorderBrush="{StaticResource ControlBorderBrush}">
            <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource StatusSuccessBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasNg}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <TabControl Grid.Row="2">

            <!-- 検定比の降順。一番厳しいところが先頭に来る。 -->
            <TabItem Header="一覧（検定比順）">
                <common:EnhancedDataGrid ItemsSource="{Binding DisplayItems}"
                                         AutoGenerateColumns="False"
                                         IsReadOnly="True"
                                         CanUserAddRows="False"
                                         CanUserDeleteRows="False"
                                         CanUserSortColumns="True"
                                         HeadersVisibility="Column"
                                         GridLinesVisibility="Horizontal"
                                         SelectionUnit="CellOrRowHeader"
                                         SelectionMode="Extended"
                                         ClipboardCopyMode="IncludeHeader">
                    <common:EnhancedDataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOk}" Value="False">
                                    <Setter Property="Background" Value="#FFF4F4"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </common:EnhancedDataGrid.RowStyle>
                    <common:EnhancedDataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Ratio, StringFormat=N2}" Width="70">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="検定比" ToolTip="応答値 ÷ 限界値。1 を超えると NG"/>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Binding="{Binding StatusLabel}" Width="50">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="判定" ToolTip="限界値を超えていれば NG"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>

                        <DataGridTextColumn Binding="{Binding Category}" Width="150">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="検定項目" ToolTip="何を照査しているか"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>

                        <DataGridTextColumn Binding="{Binding TargetDescription}" Width="180">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="対象" ToolTip="どの杭のどこか"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>

                        <DataGridTextColumn Binding="{Binding ConditionDescription}" Width="*">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="荷重条件" ToolTip="荷重ケース / 荷重組合せ / 液状化の有無"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>

                        <DataGridTextColumn Binding="{Binding Response, StringFormat=N3}" Width="100">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="応答値" ToolTip="解析から得た値"/>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Binding="{Binding Limit, StringFormat=N3}" Width="100">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="限界値" ToolTip="これを超えると NG"/>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Binding="{Binding Unit}" Width="55">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="単位" ToolTip="応答値・限界値の単位"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>

                        <DataGridTextColumn Binding="{Binding AxialForce, StringFormat=N1}" Width="90">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="軸力(kN)" ToolTip="限界値の前提となった軸力。杭体曲げのみ（圧縮が正）"/>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </common:EnhancedDataGrid.Columns>
                </common:EnhancedDataGrid>
            </TabItem>

            <!-- 計算書に載るものと同じテキスト -->
            <TabItem Header="テキスト（計算書と同じ）">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBox Text="{Binding EvaluationText, Mode=OneWay}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             FontFamily="Consolas"
                             FontSize="12"
                             Background="{StaticResource LogBackgroundBrush}"
                             Foreground="{StaticResource LogForegroundBrush}"
                             Padding="10"
                             BorderThickness="0"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
