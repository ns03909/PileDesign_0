<Window x:Class="PileDesign.Views.MoveCopyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PileDesign.ViewModels"
        xmlns:conv="clr-namespace:PileDesign.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:MoveCopyViewModel}"
        Title="MoveCopyWindow" Height="150" Width="350">

    <Window.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="EmphasizedRadioButtonStyle" TargetType="RadioButton">
            <!--<Setter Property="FontSize" Value="20"/>-->
            <!--<Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="Black"/>-->
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <!--<Setter Property="Foreground" Value="DarkBlue"/>-->
                    <!--<Setter Property="Background" Value="Aqua"/>-->
                    <!--<Setter Property="FontSize" Value="28"/>-->
                    <Setter Property="FontWeight" Value="ExtraBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>
        <StackPanel  Grid.Row="0">
            <GroupBox Header="コピー/移動" HorizontalAlignment="Left" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <!--<RadioButton Content="コピー" HorizontalAlignment="Left" Width="50" GroupName="Operation" IsChecked="{Binding IsCopySelected}"/>
                    <RadioButton Content="移動" HorizontalAlignment="Left" Width="50" GroupName="Operation" IsChecked="{Binding IsMoveSelected}"/>-->
                    <RadioButton Content="コピー" HorizontalAlignment="Left" Width="50" GroupName="Operation" 
                        IsChecked="{Binding IsCopySelected}" Checked="RadioButton_Checked" Style="{StaticResource EmphasizedRadioButtonStyle}"/>
                    <RadioButton Content="移動" HorizontalAlignment="Left" Width="50" GroupName="Operation" 
                        IsChecked="{Binding IsMoveSelected}" Checked="RadioButton_Checked" Style="{StaticResource EmphasizedRadioButtonStyle}"/>
                </StackPanel>
            </GroupBox>
            <StackPanel Orientation="Horizontal">
                <Label Content="dX" Width="50" HorizontalContentAlignment="Right"/>
                <TextBox Text="{Binding DX, StringFormat={}{0:+0.00;-0.00;+0.00}}" Width="50" HorizontalContentAlignment="Right"
                         GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"/>
                <Label Content="dY" Width="50" HorizontalContentAlignment="Right"/>
                <TextBox Text="{Binding DY, StringFormat={}{0:+0.00;-0.00;+0.00}}" Width="50" HorizontalContentAlignment="Right"
                       GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"/>

                <StackPanel Orientation="Horizontal" Visibility="{Binding IsCopySelected, 
                    Converter={StaticResource BooleanToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}">
                    <!--<StackPanel Orientation="Horizontal">-->
                        <Label Content="回数" Width="50" HorizontalContentAlignment="Right" />
                    <TextBox x:Name="TextBoxRepetitionNumber" Text="{Binding RepetitionNumber}"
                             Width="50" HorizontalContentAlignment="Right" TextChanged="TextBoxRepetitionNumber_TextChanged"
                             GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"/>
                </StackPanel>
            </StackPanel>
            
        <!--<Button Content="2節点差分取得モード開始"
        Command="{Binding StartNodePairSelectionCommand}"
        Margin="4"/>

        <Button Content="キャンセル"
        Command="{Binding CancelNodePairSelectionCommand}"
        Margin="4"
        Visibility="{Binding IsNodePairSelectionMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <TextBlock Text="キャンバス上で節点を2つクリックしてください"
           Foreground="Orange"
           Margin="4"
           Visibility="{Binding IsNodePairSelectionMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>-->
        </StackPanel>

        

        <StackPanel Orientation="Horizontal"  HorizontalAlignment="Right" Grid.Row="1">

            <Button Content="Ok" Width="60" Click="OkButton_Click"/>
            <Button Content="Cancel" Width="60" Click="CancelButton_Click"/>

        </StackPanel>
    </Grid>
</Window>
