<Window x:Class="PileDesign.Views.ElementDivisionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PileDesign.ViewModels"
        xmlns:models="clr-namespace:PileDesign.Models" 
        xmlns:conv="clr-namespace:PileDesign.Converters"
        xmlns:common="clr-namespace:PileDesign.Common"
        xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        d:DataContext="{d:DesignInstance Type=local:ElementDivisionViewModel}"
        mc:Ignorable="d"
        Title="要素分割ウィンドウ" Height="650" Width="650"
        Loaded="ElementDivisionWindow_Loaded">

    <Window.Resources>
        <local:DoubleLessThanConverter x:Key="DoubleLessThanConverter"/>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:BoolToBrushConverter x:Key="BoolToBrushConverter"/>

        <!--CheckBoxのスタイル定義-->
        <Style x:Key="GrayCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="Gray"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="Gray"/>
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="False">
                    <Setter Property="Foreground" Value="Gray"/>
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="{x:Null}">
                    <Setter Property="Foreground" Value="Gray"/>
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RightAlignTextBlockStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 特定の列ヘッダーの色を変更するスタイル -->
        <Style x:Key="GreenHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="#238966"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="YellowHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="#F7B515"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DeepBlueHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="#3271AD"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PaleRedHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="#E95541"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CrimsonHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="#D82531"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GranularityClassTextBlockStyle" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SoilType}" Value="粘性土">
                    <Setter Property="Foreground" Value="DarkRed"/>
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SoilType}" Value="砂質土">
                    <Setter Property="Foreground" Value="DarkOrange"/>
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SoilType}" Value="礫質土">
                    <Setter Property="Foreground" Value="DarkGreen"/>
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 上にランプ表示行を追加 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- ランプ -->
            <RowDefinition Height="*"/>    <!-- 既存 TabControl -->
            <RowDefinition Height="auto"/> <!-- 下部ボタン -->
        </Grid.RowDefinitions>

        <!-- ランプ群（タイトル直下） -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="8" VerticalAlignment="Center" HorizontalAlignment="Left">
            <!-- 土層-杭セットランプ -->
            <ItemsControl ItemsSource="{Binding SoilPileLampStates}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:LampState}">
                        <Button Width="18" Height="18" Margin="2" Click="SoilPileLamp_Click" ToolTip="土層-杭セットを開く">
                            <Ellipse Width="14" Height="14" Fill="{Binding IsOn, Converter={StaticResource BoolToBrushConverter}}" Stroke="Black" StrokeThickness="0.5"/>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 根入れセットランプ（単一または複数に対応） -->
            <ItemsControl ItemsSource="{Binding EmbedmentLampStates}" Margin="12,0,0,0"
              Visibility="{Binding IsDoatsuGoryokuBaneVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:LampState}">
                        <Button Width="18" Height="18" Margin="2" Click="EmbedmentLamp_Click" ToolTip="土層-根入れセットを開く">
                            <Ellipse Width="14" Height="14" Fill="{Binding IsOn, Converter={StaticResource BoolToBrushConverter}}" Stroke="Black" StrokeThickness="0.5"/>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding SoilLayerPileSetCount, StringFormat=  (全 {0} セット)}" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 既存 TabControl を下に移動、名前を付与 -->
        <TabControl x:Name="MainTabControl" Grid.Row="1" SelectionChanged="TabControl_SelectionChange">
            <TabItem Header="土層-杭セット">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Row="0">

                        <TextBlock Text="土層-杭セットNo." Width="100"/>
                        <ComboBox x:Name="ComboBoxSoilPile"
                        SelectedItem="{Binding SelectedSoilPileNo, UpdateSourceTrigger=LostFocus}"
                        ItemsSource="{Binding SoilPileNumberOption, UpdateSourceTrigger=LostFocus}"
                        HorizontalContentAlignment="Right" Width="50"
                        SelectionChanged="ComboBoxSoilPile_SelectionChanged"/>
                        <TextBlock Text="{Binding SoilLayerPileSetCount, StringFormat=（全土層-杭セット数: {0}）}"/>
                    </StackPanel>

                    <avalonDock:DockingManager x:Name="dockingManager" Background="White" Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                        <avalonDock:LayoutRoot>
                        <avalonDock:LayoutPanel Orientation="Horizontal">
                            <avalonDock:LayoutDocumentPaneGroup DockWidth="*" Orientation="Horizontal">
                                <avalonDock:LayoutDocumentPane DockWidth="*" DockMinWidth="100">
                                    <avalonDock:LayoutAnchorable Title="要素分割"  CanClose="False" CanFloat="true" CanHide="False">
                                        <ContentControl>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                    <!--<StackPanel Orientation="Horizontal" Grid.Row="0">
                                                    </StackPanel>-->

                                                <StackPanel Orientation="Horizontal" Grid.Row="1">
                                                    <TextBlock Text="地盤No." Width="175"/>
                                                    <TextBox Text="{Binding PileGroundNo, UpdateSourceTrigger=LostFocus}"
                                                    Foreground="gray" IsReadOnly="true"  Width="100" HorizontalContentAlignment="Right"/>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" Grid.Row="2">
                                                    <TextBlock Text="杭No." Width="175"/>
                                                    <TextBox Text="{Binding PileBodyNo, UpdateSourceTrigger=LostFocus}"
                                                    Foreground="gray" IsReadOnly="true" Width="100" HorizontalContentAlignment="Right"/>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" Grid.Row="3">
                                                    <TextBlock Text="杭頭レベル" Width="175"/>
                                                    <TextBox Text="{Binding Z, StringFormat='{}{0:+0.00;-0.00;+0.00}', UpdateSourceTrigger=LostFocus}"
                                                    Foreground="gray" IsReadOnly="true" Width="100" HorizontalContentAlignment="Right"/>
                                                    <TextBlock Text="m"/>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" Grid.Row="4">
                                                    <TextBlock Text="杭下端レベル" Width="175"/>
                                                    <TextBox Text="{Binding PileBottomAltitude, StringFormat='{}{0:+0.00;-0.00;+0.00}', UpdateSourceTrigger=LostFocus}"
                                                    Foreground="gray" IsReadOnly="true" Width="100" HorizontalContentAlignment="Right"/>
                                                    <TextBlock Text="m"/>
                                                </StackPanel>

                                                <GroupBox Header="自動要素分割" Grid.Row="5">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="杭頭～第二節点最大距離(m)" Width="175"/>
                                                            <TextBox x:Name="TextFirstDistance" Text="{Binding FirstDistance, StringFormat='N2'}"
                                                            HorizontalContentAlignment="Right" Width="100"></TextBox>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="最大節点間距離(m)" Width="175"/>
                                                            <TextBox x:Name="MaxSpacing" Text="{Binding MaxPileSpacing, StringFormat='N2'}"
                                                            HorizontalContentAlignment="Right" Width="100"></TextBox>
                                                        </StackPanel>

                                                        <Button x:Name="ButtonAuto" Content="自動要素分割実行" Width="100"
                                                        Command="{Binding AutoZsCommand}"
                                                        HorizontalAlignment="Left"/>
                                                    </StackPanel>
                                                </GroupBox>

                                                <StackPanel Grid.Row="6">
                                                    <Button x:Name="ButtonResetPile" Content="初期化" Command="{Binding ResetPileCommand}"/>
                                                    <Button x:Name="ButtonAddZs" Content="選択行下への行追加" Command="{Binding AddZsCommand}"/>
                                                <!--</ToolBar>-->
                                                </StackPanel>

                                                <common:EnhancedDataGrid x:Name="DataGridZs" AutoGenerateColumns="False" HorizontalAlignment="Left"
                                                        CanUserAddRows="False" CanUserSortColumns="False"
                                                        ItemsSource="{Binding SelectedZDataItems, UpdateSourceTrigger=PropertyChanged}"
                                                        SelectedItem="{Binding SelectedZDataItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        SelectionUnit="FullRow"
                                                        SelectionMode="Single"
                                                        CellEditEnding="DataGridZs_CellEditEnding"
                                                        BeginningEdit="DataGridZs_BeginningEdit"
                                                        SelectionChanged="DataGridZs_SelectionChanged"
                                                        ScrollViewer.VerticalScrollBarVisibility="Visible"
                                                        ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                        LoadingRow="DataGrid_LoadingRow_Numbering"
                                                        RowEditEnding="DataGridZs_RowEditEnding"
                                                        CellStyle="{StaticResource CustomDataGridCellStyle}"
                                                        Grid.Row="7">

                                                    <DataGrid.AlternatingRowBackground>
                                                        <ImageBrush/>
                                                    </DataGrid.AlternatingRowBackground>
                                                    <DataGrid.Style>
                                                        <Style/>
                                                    </DataGrid.Style>
                                                    <DataGrid.ColumnHeaderStyle>
                                                        <Style TargetType="DataGridColumnHeader">
                                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                            <Setter Property="Foreground" Value="#62B0E2" />
                                                        </Style>
                                                    </DataGrid.ColumnHeaderStyle>

                                                    <DataGrid.Columns>

                                                        <DataGridTemplateColumn Header="削除" Width="50">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <Button x:Name="ButtonZsDelete" 
                                                                            Command="{Binding DataContext.DeleteZsCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                            CommandParameter="{Binding}" Content="削除"/>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>

                                                        <DataGridTextColumn x:Name="Z" Binding="{Binding Z, StringFormat='{}{0:0.00}', UpdateSourceTrigger=LostFocus}"
                                                                        ElementStyle="{StaticResource RightAlignTextBlockStyle}" Width="50">
                                                            <DataGridTextColumn.Header>
                                                                <StackPanel>
                                                                    <TextBlock Text="Z" TextAlignment="Center"/>
                                                                    <TextBlock Text="(m)" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                                </StackPanel>
                                                            </DataGridTextColumn.Header>
                                                        </DataGridTextColumn>

                                                        <DataGridTextColumn Binding="{Binding IsChangeable, UpdateSourceTrigger=LostFocus}" IsReadOnly="True" Foreground="Gray"
                                                                        ElementStyle="{StaticResource RightAlignTextBlockStyle}" Width="50">
                                                            <DataGridTextColumn.Header>
                                                                <StackPanel>
                                                                    <TextBlock Text="変更" TextAlignment="Center"/>
                                                                    <TextBlock Text="可否" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                                </StackPanel>
                                                            </DataGridTextColumn.Header>
                                                        </DataGridTextColumn>

                                                        <DataGridTextColumn Binding="{Binding GroundDisp1, StringFormat=N1, UpdateSourceTrigger=LostFocus}" IsReadOnly="True" Foreground="Gray"
                                                                        ElementStyle="{StaticResource RightAlignTextBlockStyle}" Width="50">
                                                            <DataGridTextColumn.Header>
                                                                <StackPanel>
                                                                    <TextBlock Text="地盤" TextAlignment="Center"/>
                                                                    <TextBlock Text="変位" TextAlignment="Center"/>
                                                                    <TextBlock Text="レベル1" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                                </StackPanel>
                                                            </DataGridTextColumn.Header>
                                                        </DataGridTextColumn>
                                                        <DataGridTextColumn Binding="{Binding GroundDisp2, StringFormat=N1, UpdateSourceTrigger=LostFocus}" IsReadOnly="True" Foreground="Gray"
                                                                        ElementStyle="{StaticResource RightAlignTextBlockStyle}" Width="50" HeaderStyle="{StaticResource DeepBlueHeaderStyle}">
                                                            <DataGridTextColumn.Header>
                                                                <StackPanel>
                                                                    <TextBlock Text="地盤" TextAlignment="Center"/>
                                                                    <TextBlock Text="変位" TextAlignment="Center"/>
                                                                    <TextBlock Text="レベル2" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                                </StackPanel>
                                                            </DataGridTextColumn.Header>
                                                        </DataGridTextColumn>

                                                        <DataGridTextColumn Binding="{Binding GroundDisp1L, StringFormat=N1, UpdateSourceTrigger=LostFocus}" IsReadOnly="True" Foreground="Gray"
                                                                    ElementStyle="{StaticResource RightAlignTextBlockStyle}" Width="50">
                                                            <DataGridTextColumn.Header>
                                                                <StackPanel>
                                                                    <TextBlock Text="液状化" TextAlignment="Center"/>
                                                                    <TextBlock Text="地盤" TextAlignment="Center"/>
                                                                    <TextBlock Text="変位" TextAlignment="Center"/>
                                                                    <TextBlock Text="レベル1" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                                </StackPanel>
                                                            </DataGridTextColumn.Header>
                                                        </DataGridTextColumn>

                                                        <DataGridTextColumn Binding="{Binding GroundDisp2L, StringFormat=N1, UpdateSourceTrigger=LostFocus}" IsReadOnly="True" Foreground="Gray"
                                                                    ElementStyle="{StaticResource RightAlignTextBlockStyle}" Width="50" HeaderStyle="{StaticResource DeepBlueHeaderStyle}">
                                                            <DataGridTextColumn.Header>
                                                                <StackPanel>
                                                                    <TextBlock Text="液状化" TextAlignment="Center"/>
                                                                    <TextBlock Text="地盤" TextAlignment="Center"/>
                                                                    <TextBlock Text="変位" TextAlignment="Center"/>
                                                                    <TextBlock Text="レベル2" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                                </StackPanel>
                                                            </DataGridTextColumn.Header>
                                                        </DataGridTextColumn>
                                                    </DataGrid.Columns>
                                                </common:EnhancedDataGrid>
                                            </Grid>
                                        </ContentControl>
                                    </avalonDock:LayoutAnchorable>
                                </avalonDock:LayoutDocumentPane>
                                <avalonDock:LayoutDocumentPane DockWidth="*" DockMinWidth="100">

                                    <avalonDock:LayoutAnchorable Title="杭姿図" CanClose="False" CanFloat="True" CanHide="False">
                                        <ContentControl>
                                            <Canvas x:Name="Canvas"/>
                                        </ContentControl>

                                    </avalonDock:LayoutAnchorable>
                                </avalonDock:LayoutDocumentPane>
                            </avalonDock:LayoutDocumentPaneGroup>
                            <avalonDock:LayoutDocumentPaneGroup DockWidth="*" Orientation="Vertical">
                                <avalonDock:LayoutDocumentPane DockMinWidth="50">
                                    <avalonDock:LayoutAnchorable Title="水平地盤反力" CanClose="False" CanFloat="True" CanHide="False">
                                        <ContentControl>

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <StackPanel Orientation="Horizontal" Grid.Row="0">
                                                    <TextBlock Text="確認用群杭影響係数ξ [0.0-1.0]" Width="200"/>
                                                    <TextBox Text="{Binding Xi, StringFormat=N2, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" 
                                                            Width="50" HorizontalContentAlignment="Right"
                                                            TextChanged="XiROnB_TextChanged"/>
                                                    <Slider Value="{Binding Xi, UpdateSourceTrigger=PropertyChanged}" Minimum="0.1" Maximum="1" Width="50"/>

                                                    <TextBlock Text="確認用杭間隔比R/B" Width="200"/>
                                                    <TextBox Text="{Binding ROnB, StringFormat=N2, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" 
                                                            Width="50" HorizontalContentAlignment="Right"
                                                            ToolTip="後方杭の塑性地盤反力を求めるパラメータとしてのみ。群杭係数には連動せず、別途指定する。"
                                                            TextChanged="XiROnB_TextChanged"/>
                                                    <Slider Value="{Binding ROnB, UpdateSourceTrigger=PropertyChanged}" Minimum="1" Maximum="10" Width="50"/>
                                                </StackPanel>

                                                <TextBlock Text="基準水平地盤反力係数と塑性水平地盤反力度（上段：要素上端の値，下段：要素下端の値）" Grid.Row="1"/>

                                                <common:EnhancedDataGrid x:Name="horizon" AutoGenerateColumns="False" HorizontalAlignment="Left" Height="300"
                                                        CanUserAddRows="False" CanUserSortColumns="False"
                                                        ItemsSource="{Binding SelectedHorizontalSoilReactions, UpdateSourceTrigger=PropertyChanged}"
                                                        SelectedItem="{Binding SelectedLayeronDataGrid, UpdateSourceTrigger=PropertyChanged}"
                                                        ScrollViewer.VerticalScrollBarVisibility="Visible" 
                                                        LoadingRow="DataGrid_LoadingRow_Numbering"
                                                        RowEditEnding="DataGridZs_RowEditEnding"
                                                        CellStyle="{StaticResource CustomDataGridCellStyle}"
                                                        Grid.Row="2"
                                                        SelectedCellsChanged="Horizon_SelectedCellsChanged"
                                                        CurrentCellChanged="Horizon_CurrentCellChanged">

                                                    <DataGrid.AlternatingRowBackground>
                                                        <ImageBrush/>
                                                    </DataGrid.AlternatingRowBackground>
                                                    <DataGrid.Style>
                                                        <Style/>
                                                    </DataGrid.Style>

                                                    <DataGrid.ColumnHeaderStyle>
                                                        <Style TargetType="DataGridColumnHeader">
                                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                            <Setter Property="Foreground" Value="#62B0E2" />
                                                        </Style>
                                                    </DataGrid.ColumnHeaderStyle>

                                                    <DataGrid.Columns>

                                                        <DataGridTemplateColumn Width="auto">
                                                            <DataGridTemplateColumn.Header>
                                                                <StackPanel>
                                                                    <TextBlock Text="Z" TextAlignment="Center"/>
                                                                    <TextBlock Text="(m)" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                                </StackPanel>
                                                            </DataGridTemplateColumn.Header>
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate >
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding ZTop, StringFormat=N2, UpdateSourceTrigger=LostFocus}"
                                                                                HorizontalAlignment="Right" Foreground="Gray"/>
                                                                        <TextBlock Text="{Binding ZBtm, StringFormat=N2, UpdateSourceTrigger=LostFocus}"
                                                                                HorizontalAlignment="Right" Foreground="Gray"/>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>

                                                        <DataGridTextColumn Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" IsReadOnly="True" Foreground="Gray"
                                                                ElementStyle="{StaticResource RightAlignTextBlockStyle}" Width="auto">
                                                            <DataGridTextColumn.Header>
                                                                <StackPanel>
                                                                    <TextBlock Text="土質" TextAlignment="Center"/>
                                                                    <TextBlock Text="名" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                                </StackPanel>
                                                            </DataGridTextColumn.Header>
                                                        </DataGridTextColumn>

                                                        <DataGridTextColumn Binding="{Binding SoilType, UpdateSourceTrigger=LostFocus}" IsReadOnly="True"
                                                                ElementStyle="{StaticResource GranularityClassTextBlockStyle}">
                                                            <DataGridTextColumn.Header>
                                                                <StackPanel>
                                                                    <TextBlock Text="土層" TextAlignment="Center"/>
                                                                    <TextBlock Text="分類" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                                </StackPanel>
                                                            </DataGridTextColumn.Header>
                                                        </DataGridTextColumn>

                                                        <DataGridTextColumn Binding="{Binding Gamma, StringFormat=N1, UpdateSourceTrigger=LostFocus}" IsReadOnly="True" Foreground="Gray"
                                                                ElementStyle="{StaticResource RightAlignTextBlockStyle}" Width="auto">
                                                            <DataGridTextColumn.Header>
                                                                <StackPanel>
                                                                    <TextBlock Text="単位体積" TextAlignment="Center"/>
                                                                    <TextBlock Text="重量γ" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                                    <TextBlock Text="(kN/m3)" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                                </StackPanel>
                                                            </DataGridTextColumn.Header>
                                                        </DataGridTextColumn>

                                                        <DataGridTextColumn Binding="{Binding NValue, StringFormat=N1, UpdateSourceTrigger=LostFocus}" IsReadOnly="True" Foreground="Gray"
                                                                ElementStyle="{StaticResource RightAlignTextBlockStyle}" Width="auto">
                                                            <DataGridTextColumn.Header>
                                                                <StackPanel>
                                                                    <TextBlock Text="N値" TextAlignment="Center"/>
                                                                    <TextBlock Text="" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                                </StackPanel>
                                                            </DataGridTextColumn.Header>
                                                        </DataGridTextColumn>

                                                        <DataGridTextColumn Binding="{Binding Phi, StringFormat=N1, UpdateSourceTrigger=LostFocus}" IsReadOnly="True" Foreground="Gray"
                                                                ElementStyle="{StaticResource RightAlignTextBlockStyle}" Width="50">
                                                            <DataGridTextColumn.Header>
                                                                <StackPanel>
                                                                    <TextBlock Text="摩擦角" TextAlignment="Center"/>
                                                                    <TextBlock Text="φ" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                                </StackPanel>
                                                            </DataGridTextColumn.Header>
                                                        </DataGridTextColumn>

                                                        <DataGridTextColumn Binding="{Binding Cu, StringFormat=N2, UpdateSourceTrigger=LostFocus}" IsReadOnly="True" Foreground="Gray"
                                                                ElementStyle="{StaticResource RightAlignTextBlockStyle}" Width="auto">
                                                            <DataGridTextColumn.Header>
                                                                <StackPanel>
                                                                    <TextBlock Text="粘着力" TextAlignment="Center"/>
                                                                    <TextBlock Text="C" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                                    <TextBlock Text="kN/m2" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                                </StackPanel>
                                                            </DataGridTextColumn.Header>
                                                        </DataGridTextColumn>

                                                        <DataGridTextColumn Binding="{Binding E0, StringFormat=N0, UpdateSourceTrigger=LostFocus}" IsReadOnly="True" Foreground="Gray"
                                                                ElementStyle="{StaticResource RightAlignTextBlockStyle}" Width="auto">
                                                            <DataGridTextColumn.Header>
                                                                <StackPanel>
                                                                    <TextBlock Text="変形係数" TextAlignment="Center"/>
                                                                    <TextBlock Text="E" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                                    <TextBlock Text="kN/m2" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                                </StackPanel>
                                                            </DataGridTextColumn.Header>
                                                        </DataGridTextColumn>

                                                        <DataGridTextColumn Binding="{Binding B, StringFormat=N2, UpdateSourceTrigger=LostFocus}" IsReadOnly="True" Foreground="Gray"
                                                                ElementStyle="{StaticResource RightAlignTextBlockStyle}" Width="auto">
                                                            <DataGridTextColumn.Header>
                                                                <StackPanel>
                                                                    <TextBlock Text="杭径" TextAlignment="Center"/>
                                                                    <TextBlock Text="B" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                                    <TextBlock Text="m" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                                </StackPanel>
                                                            </DataGridTextColumn.Header>
                                                        </DataGridTextColumn>

                                                        <DataGridTextColumn Binding="{Binding Kh0, StringFormat=N0, UpdateSourceTrigger=LostFocus}" IsReadOnly="True" Foreground="Gray"
                                                                ElementStyle="{StaticResource RightAlignTextBlockStyle}" Width="auto">
                                                            <DataGridTextColumn.Header>
                                                                <StackPanel>
                                                                    <TextBlock Text="基準水平地盤" TextAlignment="Center"/>
                                                                    <TextBlock Text="反力係数kh0" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                                    <TextBlock Text="kN/m3" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                                </StackPanel>
                                                            </DataGridTextColumn.Header>
                                                        </DataGridTextColumn>

                                                        <DataGridTemplateColumn Width="auto">
                                                            <DataGridTemplateColumn.Header>
                                                                <StackPanel>
                                                                    <TextBlock Text="塑性地盤反力" TextAlignment="Center"/>
                                                                    <TextBlock Text="前方杭py" TextAlignment="Center"/>
                                                                    <TextBlock Text="(kN/m2)" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                                </StackPanel>
