<Window x:Class="PileDesign.Views.ShortcutKeysWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ショートカットキー一覧"
        SizeToContent="Height"
        Width="560"
        MinWidth="480"
        MaxWidth="{x:Static SystemParameters.PrimaryScreenWidth}"
        MaxHeight="{x:Static SystemParameters.PrimaryScreenHeight}"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown"
        
        Deactivated="Window_Deactivated">
    <Border Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="ショートカットキー一覧" FontWeight="Bold" Margin="0,0,0,8"/>

            <DataGrid x:Name="GridShortcuts"
                      Grid.Row="1"
                      HeadersVisibility="Column"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="False"
                      CanUserSortColumns="False"
                      IsReadOnly="True"
                      Margin="0,0,0,8"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      MaxHeight="480">
                <!-- 長文は省略表示（折り返しなし） -->
                <DataGrid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        <Setter Property="TextWrapping" Value="NoWrap"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <!-- 可変幅（優先的に広く使う） -->
                    <DataGridTextColumn Header="機能" Binding="{Binding Name}" Width="*" MinWidth="240"/>
                    <!-- 必要最小限（Auto） -->
                    <DataGridTextColumn Header="ショートカット" Binding="{Binding Shortcut}" Width="Auto" MinWidth="140"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="2" Text="Esc で閉じます" Foreground="Gray" HorizontalAlignment="Right"/>
        </Grid>
    </Border>
</Window>