<Window x:Class="PileDesign.Views.InputVisualizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="入力データの確認"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowActivated="False"
        Focusable="False"
        Topmost="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- すりガラス調パネル (白〜薄シアン、低不透明) — 背景が白でも黒でも馴染む -->
        <LinearGradientBrush x:Key="GlassPanelBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#80FAFEFF" Offset="0"/>
            <GradientStop Color="#60E4F2FA" Offset="0.5"/>
            <GradientStop Color="#70D6E8F2" Offset="1"/>
        </LinearGradientBrush>

        <!-- 内側パネル (キー枠/マウス枠) — 上にもう一段薄い白を重ねて凹凸感 -->
        <LinearGradientBrush x:Key="InnerPanelBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#50FFFFFF" Offset="0"/>
            <GradientStop Color="#30E6F2FA" Offset="1"/>
        </LinearGradientBrush>

        <!-- シアン系のアクセントボーダー (ホログラフィック寄りに鮮やかさ維持) -->
        <LinearGradientBrush x:Key="AccentBorderBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E054D7FF" Offset="0"/>
            <GradientStop Color="#7033A0E0" Offset="1"/>
        </LinearGradientBrush>

        <!-- 個別キー (Ctrl/Shift/Alt) のスタイル -->
        <Style x:Key="KeyBorderStyle" TargetType="Border">
            <Setter Property="MinWidth" Value="38"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderBrush" Value="#7066B0E0"/>
            <Setter Property="BorderThickness" Value="0.8"/>
        </Style>
        <Style x:Key="KeyTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#1F3744"/>
        </Style>
    </Window.Resources>

    <!-- 外側 Margin はドロップシャドウ用の余白 -->
    <Grid Margin="14">
        <!-- 主パネル: 半透明グラスフィルム + シアン発光 -->
        <Border x:Name="RootBorder"
                CornerRadius="14"
                Background="{StaticResource GlassPanelBrush}"
                BorderBrush="{StaticResource AccentBorderBrush}"
                BorderThickness="1"
                Padding="8,6,8,8">
            <Border.Effect>
                <!-- シアン色のソフトな外周発光 (すりガラス越しに滲む光) -->
                <DropShadowEffect BlurRadius="22" ShadowDepth="0"
                                  Color="#54D7FF" Opacity="0.55"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 内側ハイライトライン (上部に細い反射 — 白の鏡面反射) -->
                <Border Grid.Row="0" Grid.RowSpan="3"
                        CornerRadius="13"
                        BorderThickness="1,1,1,0"
                        IsHitTestVisible="False"
                        Margin="0,0,0,0">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#A0FFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="0.5"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                </Border>

                <!-- タイトルバー (ドラッグハンドル) -->
                <Grid x:Name="DragHandle" Grid.Row="0" Margin="0,0,0,4" Height="18"
                      Background="Transparent"
                      Cursor="SizeAll"
                      MouseLeftButtonDown="DragHandle_MouseLeftButtonDown"
                      MouseMove="DragHandle_MouseMove"
                      MouseLeftButtonUp="DragHandle_MouseLeftButtonUp">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="⋮⋮"
                               FontSize="13" Foreground="#5A8AAB"
                               VerticalAlignment="Center" Margin="2,0,6,0"/>
                    <TextBlock Grid.Column="1" Text="INPUT"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="#5A8AAB"
                               VerticalAlignment="Center"/>
                    <Border x:Name="CloseButton" Grid.Column="2"
                            Width="18" Height="18"
                            CornerRadius="9"
                            Background="Transparent"
                            Cursor="Hand"
                            MouseLeftButtonUp="CloseButton_MouseLeftButtonUp"
                            MouseEnter="CloseButton_MouseEnter"
                            MouseLeave="CloseButton_MouseLeave">
                        <TextBlock Text="✕" FontSize="10" Foreground="#5A8AAB"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- キーボード + マウス -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">

                    <!-- キーボードイラスト -->
                    <Border CornerRadius="8" Padding="4"
                            Margin="0,0,6,0"
                            BorderBrush="#5066B0E0"
                            BorderThickness="0.8"
                            Background="{StaticResource InnerPanelBrush}">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="CtrlKey" Style="{StaticResource KeyBorderStyle}">
                                <Border.Background>
                                    <SolidColorBrush x:Name="CtrlKeyBrush" Color="#80E8F4FC"/>
                                </Border.Background>
                                <TextBlock Text="Ctrl" Style="{StaticResource KeyTextStyle}"/>
                            </Border>
                            <Border x:Name="ShiftKey" Style="{StaticResource KeyBorderStyle}">
                                <Border.Background>
                                    <SolidColorBrush x:Name="ShiftKeyBrush" Color="#80E8F4FC"/>
                                </Border.Background>
                                <TextBlock Text="Shift" Style="{StaticResource KeyTextStyle}"/>
                            </Border>
                            <Border x:Name="AltKey" Style="{StaticResource KeyBorderStyle}" MinWidth="34">
                                <Border.Background>
                                    <SolidColorBrush x:Name="AltKeyBrush" Color="#80E8F4FC"/>
                                </Border.Background>
                                <TextBlock Text="Alt" Style="{StaticResource KeyTextStyle}"/>
                            </Border>
                            <Border x:Name="CurrentKeyBorder" Style="{StaticResource KeyBorderStyle}"
                                    MinWidth="44" Visibility="Hidden">
                                <Border.Background>
                                    <SolidColorBrush x:Name="CurrentKeyBrush" Color="#80E8F4FC"/>
                                </Border.Background>
                                <TextBlock x:Name="CurrentKeyText" Style="{StaticResource KeyTextStyle}"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- マウスイラスト -->
                    <Border CornerRadius="8" Padding="6"
                            BorderBrush="#5066B0E0"
                            BorderThickness="0.8"
                            Background="{StaticResource InnerPanelBrush}">
                        <Grid Width="40" Height="46">
                            <!-- マウス本体 (完全卵形, 上下同 R=14, 4/5 サイズ) -->
                            <Border CornerRadius="14"
                                    BorderBrush="#80539FCC" BorderThickness="0.8"
                                    Width="30" Height="46"
                                    HorizontalAlignment="Center" VerticalAlignment="Top">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#A0F4FBFF" Offset="0"/>
                                        <GradientStop Color="#80D4E5F2" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- 左ボタン本体 (R=12, 本体カーブから 2px オフセット) -->
                            <Path HorizontalAlignment="Left" VerticalAlignment="Top"
                                  Margin="7,2,0,0"
                                  Stretch="None"
                                  Fill="#A0FAFEFF"
                                  Data="M 12,0 A 12,12 0 0 0 0,12 L 0,30 A 12,12 0 0 0 12,42 Z"/>

                            <!-- 右ボタン本体 -->
                            <Path HorizontalAlignment="Left" VerticalAlignment="Top"
                                  Margin="21,2,0,0"
                                  Stretch="None"
                                  Fill="#A0FAFEFF"
                                  Data="M 0,0 A 12,12 0 0 1 12,12 L 12,30 A 12,12 0 0 1 0,42 Z"/>

                            <!-- 左ボタン 押下ハイライト (上側 2/5 ≈ y=0..17 / 全 42) -->
                            <Path x:Name="LeftMouseButton"
                                  HorizontalAlignment="Left" VerticalAlignment="Top"
                                  Margin="7,2,0,0"
                                  Stretch="None"
                                  Data="M 12,0 A 12,12 0 0 0 0,12 L 0,17 L 12,17 Z">
                                <Path.Fill>
                                    <SolidColorBrush x:Name="LeftMouseBrush" Color="Transparent"/>
                                </Path.Fill>
                            </Path>

                            <!-- 右ボタン 押下ハイライト -->
                            <Path x:Name="RightMouseButton"
                                  HorizontalAlignment="Left" VerticalAlignment="Top"
                                  Margin="21,2,0,0"
                                  Stretch="None"
                                  Data="M 0,0 A 12,12 0 0 1 12,12 L 12,17 L 0,17 Z">
                                <Path.Fill>
                                    <SolidColorBrush x:Name="RightMouseBrush" Color="Transparent"/>
                                </Path.Fill>
                            </Path>

                            <!-- 中ボタン (ホイール) ※ 3px 上 -->
                            <Border x:Name="MiddleMouseButton"
                                    Width="5" Height="14"
                                    HorizontalAlignment="Center" VerticalAlignment="Top"
                                    Margin="0,6,0,0"
                                    CornerRadius="2.5"
                                    BorderBrush="#9066B0E0" BorderThickness="0.8">
                                <Border.Background>
                                    <SolidColorBrush x:Name="MiddleMouseBrush" Color="#B0CFE5F2"/>
                                </Border.Background>
                            </Border>

                            <!-- ホイール上下矢印 (上矢印は下矢印と同じギャップになるよう -4) -->
                            <TextBlock x:Name="WheelUpArrow" Text="▲"
                                       FontSize="8"
                                       HorizontalAlignment="Center" VerticalAlignment="Top"
                                       Margin="0,-4,0,0">
                                <TextBlock.Foreground>
                                    <SolidColorBrush x:Name="WheelUpBrush" Color="#A88FB7CC"/>
                                </TextBlock.Foreground>
                            </TextBlock>
                            <TextBlock x:Name="WheelDownArrow" Text="▼"
                                       FontSize="8"
                                       HorizontalAlignment="Center" VerticalAlignment="Top"
                                       Margin="0,19,0,0">
                                <TextBlock.Foreground>
                                    <SolidColorBrush x:Name="WheelDownBrush" Color="#A88FB7CC"/>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
