<Window x:Class="PileDesign.Views.PileSectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
       
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:local="clr-namespace:PileDesign.ViewModels"
        xmlns:conv="clr-namespace:PileDesign.Converters"
        xmlns:common="clr-namespace:PileDesign.Common"
        mc:Ignorable="d"
        xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
        d:DataContext="{d:DesignInstance Type=local:PileSectionViewModel}"
        Title="杭断面" Height="800" Width="1300" WindowState="Maximized"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">
    <!--Loaded="PileSectionWindow_Loaded"-->
    <!---->
    <!--削除-->
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <!-- 追加: Ctrl+Enter で OkCommand を実行 -->
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding OkCommand}" />
        <!-- 追加: Esc で CancelCommand を実行 -->
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <conv:VisibilityConverter x:Key="VisibilityConverter"/>
        <conv:MultiplyConverter x:Key="MultiplyConverter"/>

        <!-- DataGridCellのスタイルを定義 -->
        <!--<Style x:Key="CustomDataGridCellStyle" TargetType="DataGridCell">
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryAccentBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="White"/>
                    <Setter Property="BorderThickness" Value="0.75"/>
                </Trigger>
            </Style.Triggers>
        </Style>-->

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <avalonDock:DockingManager x:Name="dockingManager" Grid.Row="0">
            <avalonDock:LayoutRoot>
                <avalonDock:LayoutPanel Orientation="Horizontal" DockWidth="1.0*">
                    <avalonDock:LayoutDocumentPaneGroup Orientation="Vertical" DockWidth="0.5*">
                        <avalonDock:LayoutDocumentPane>
                            <avalonDock:LayoutAnchorable Title="入力" CanClose="False" CanHide="False">
                                <StackPanel Orientation="Vertical" Grid.Column="0">

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="杭体番号" Width="100" HorizontalAlignment="Right"/>
                                        <TextBox Text="{Binding PileBodyNo}" TextAlignment="Right" IsReadOnly="True" Width="50" Foreground="Gray"/>
                                        <TextBlock Text="区間番号" Width="100" HorizontalAlignment="Right"/>
                                        <TextBox Text="{Binding PileSegmentNo}" TextAlignment="Right" IsReadOnly="True" Width="50" Foreground="Gray"/>
                                        <TextBlock Text="杭体タイプ" Width="100" HorizontalAlignment="Right"/>
                                        <TextBox Text="{Binding PileSection.PileBodyType}" IsReadOnly="True" Width="150" Foreground="Gray"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Visibility="{Binding PileSection.PileBodyType,
                                        Converter={StaticResource VisibilityConverter},
                                        ConverterParameter='場所打ち鋼管コンクリート杭'}">
                                        <TextBlock Text="部位" Width="100"/>
                                        <ComboBox SelectedItem="{Binding PileSection.PileSectionType, UpdateSourceTrigger=PropertyChanged}" Width="150"
                                                  ItemsSource="{Binding PileSection.InsituSteelPileSectionTypeOption}"
                                                  DropDownOpened="ComboBox_DropDownOpened"
                                                  SelectionChanged="ComboBox_SelectionChanged"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Visibility="{Binding PileSection.PileBodyType,
                                        Converter={StaticResource VisibilityConverter},
                                        ConverterParameter='既製コンクリート杭'}">
                                        <TextBlock Text="既製コンクリート杭断面タイプ" HorizontalAlignment="Left" VerticalAlignment="Top" Width="150"/>
                                        <ComboBox SelectedItem="{Binding PileSection.PileSectionType, UpdateSourceTrigger=PropertyChanged}"
                                            ItemsSource="{Binding PileSection.PreCastConcretePileSectionTypeOption}"
                                                  Height="25" VerticalAlignment="Top" Width="100"
                                                  DropDownOpened="ComboBox_DropDownOpened"
                                                  SelectionChanged="ComboBoxPrecastConcretePileType_SelectionChanged"/>

                                        <StackPanel Orientation="Horizontal" Visibility="{Binding PileSection.PileSectionType,
                                            Converter={StaticResource VisibilityConverter},
                                            ConverterParameter='PHC杭'}">

                                            <ComboBox x:Name="ComboBoxPHCPileType" 
                                                      SelectedItem="{Binding PileSection.SelectedPrecastPile.Name, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{Binding PileSection.PHCOption}" Width="150"
                                                      DropDownOpened="ComboBox_DropDownOpened"
                                                       SelectionChanged="ComboBox_PileSectionSelectionChanged"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Visibility="{Binding PileSection.PileSectionType,
                                            Converter={StaticResource VisibilityConverter},
                                            ConverterParameter='PRC杭'}">

                                            <ComboBox x:Name="ComboBoxPRCPileType" 
                                                      SelectedItem="{Binding PileSection.SelectedPrecastPile.Name, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{Binding PileSection.PRCOption}" Width="150"
                                                      DropDownOpened="ComboBox_DropDownOpened"
                                                       SelectionChanged="ComboBox_PileSectionSelectionChanged"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Visibility="{Binding PileSection.PileSectionType,
                                            Converter={StaticResource VisibilityConverter},
                                            ConverterParameter='SC杭'}">

                                            <ComboBox x:Name="ComboBoxSCPileType" 
                                                      SelectedItem="{Binding PileSection.SelectedPrecastPile.Name, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{Binding PileSection.SCOption}" Width="150"
                                                      DropDownOpened="ComboBox_DropDownOpened"
                                                       SelectionChanged="ComboBox_PileSectionSelectionChanged"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="腐食深さ (mm)" Width="150" HorizontalAlignment="Right"/>
                                                <TextBox Text="{Binding PileSection.CorrosionDepth, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N1}'}"
                                                     Width="50" TextAlignment="Right"
                                                     GotFocus="TextBox_GotFocus"
                                                     PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                     PreviewKeyDown="TextBox_PreviewKeyDown"
                                                     TextChanged="TextBox_TextChanged"
                                                     LostFocus="TextBox_LostFocus"/>                                                
                                            </StackPanel>

                                        </StackPanel>
                                    </StackPanel>


                                    <StackPanel Orientation="Horizontal" Visibility="{Binding PileSection.PileBodyType,
                                        Converter={StaticResource VisibilityConverter},
                                        ConverterParameter='鋼管杭'}">
                                        <TextBlock Text="鋼管杭断面タイプ" HorizontalAlignment="Left"  VerticalAlignment="Top" Width="150"/>
                                        <ComboBox SelectedItem="{Binding PileSection.SelectedSteelPipe, UpdateSourceTrigger=PropertyChanged}"
                                            ItemsSource="{Binding PileSection.SteelPipePileSectionTypeOption}" VerticalAlignment="Top" Width="100"
                                                  DropDownOpened="ComboBox_DropDownOpened" 
                                                  SelectionChanged="ComboBoxSteelPileType_SelectionChanged"/>
                                    </StackPanel>

                                    <StackPanel>
                                        <StackPanel Visibility="{Binding PileSection.PileBodyType,
                                            Converter={StaticResource VisibilityConverter},
                                            ConverterParameter='場所打ち鋼管コンクリート杭'}">
                                            <GroupBox Header="鋼管" Visibility="{Binding PileSection.PileSectionType,
                                                Converter={StaticResource VisibilityConverter},
                                                ConverterParameter='鋼管コンクリート部'}">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text ="外径×管厚 (mm)" Width="150" HorizontalAlignment="Right"/>
                                                        <TextBox Text="{Binding PileSection.PipeDia, StringFormat='{}{0:N0}', UpdateSourceTrigger=LostFocus}"
                                                                 Width="50" TextAlignment="Right" 
                                                                 HorizontalContentAlignment="Right"
                                                                 GotFocus="TextBox_GotFocus"
                                                                 PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                                 PreviewKeyDown="TextBox_PreviewKeyDown"
                                                                 TextChanged="TextBox_TextChanged"
                                                                 LostFocus="TextBox_LostFocus"/>
                                                        <TextBlock Text ="×" Width="20" HorizontalAlignment="Center"/>
                                                        <TextBox  Text="{Binding PileSection.PipeTs, UpdateSourceTrigger=LostFocus}" Width="50" TextAlignment="Right"
                                                                 GotFocus="TextBox_GotFocus"
                                                                 PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                                 PreviewKeyDown="TextBox_PreviewKeyDown"
                                                                 TextChanged="TextBox_TextChanged"
                                                                  LostFocus="TextBox_LostFocus"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text ="規格" Width="100" HorizontalAlignment="Right"/>
                                                        <ComboBox  SelectedItem="{Binding  PileSection.PipeGrade, UpdateSourceTrigger=PropertyChanged}"
                                                                   Width="100" ItemsSource="{Binding PileSection.PipeGradeOption}"
                                                                   DropDownOpened="ComboBox_DropDownOpened" 
                                                                   SelectionChanged="ComboBox_SelectionChanged"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="腐食深さ (mm)" Width="100" HorizontalAlignment="Right"/>
                                                        <TextBox Text="{Binding PileSection.CorrosionDepth, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N1}'}"
                                                             Width="50" TextAlignment="Right"
                                                             GotFocus="TextBox_GotFocus"
                                                             PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                             PreviewKeyDown="TextBox_PreviewKeyDown"
                                                             TextChanged="TextBox_TextChanged"
                                                             LostFocus="TextBox_LostFocus"/>
                                                    </StackPanel>

                                                </StackPanel>
                                            </GroupBox>
                                        </StackPanel>
                                    </StackPanel>

                                    <GroupBox Header="コンクリート" Visibility="{Binding PileSection.PileBodyType,
                                            Converter={StaticResource VisibilityConverter},
                                            ConverterParameter='場所打ち鉄筋コンクリート杭'}">
                                        <StackPanel>

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="杭径 (mm)" Width="150" HorizontalAlignment="Right"/>
                                                <TextBox Text="{Binding PileSection.ConcreteOutDia, StringFormat='{}{0:N0}', UpdateSourceTrigger=LostFocus}"
                                                         Width="50" TextAlignment="Right"
                                                         GotFocus="TextBox_GotFocus"
                                                         PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                         PreviewKeyDown="TextBox_PreviewKeyDown"
                                                         PreviewLostKeyboardFocus="TextBox_PreviewLostKeyboardFocus"
                                                         TextChanged="TextBox_TextChanged"
                                                         LostFocus="TextBox_LostFocus"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Width="150" HorizontalAlignment="Right"><Run Text="設計基準強度F"/><Run Text="c" BaselineAlignment="Subscript" FontSize="9"/><Run Text=" (N/mm"/><Run Text="2" BaselineAlignment="Superscript" FontSize="9"/><Run Text=")"/></TextBlock>
                                                <TextBox  Text="{Binding PileSection.ConcreteFc, UpdateSourceTrigger=LostFocus}"
                                                          Width="50"  TextAlignment="Right"
                                                          GotFocus="TextBox_GotFocus" 
                                                          PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                          PreviewKeyDown="TextBox_PreviewKeyDown"
                                                          TextChanged="TextBox_TextChanged"
                                                          LostFocus="TextBox_LostFocus"/>
                                                <TextBlock Width="150"  HorizontalAlignment="Right"><Run Text="単位体積重量γ (kN/m"/><Run Text="3" BaselineAlignment="Superscript" FontSize="9"/><Run Text=")"/></TextBlock>
                                                <TextBox  Text="{Binding PileSection.ConcreteGamma, UpdateSourceTrigger=LostFocus}"
                                                          Width="50" TextAlignment="Right"
                                                          GotFocus="TextBox_GotFocus" 
                                                          PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                          PreviewKeyDown="TextBox_PreviewKeyDown"
                                                          PreviewLostKeyboardFocus="TextBox_PreviewLostKeyboardFocus"
                                                          TextChanged="TextBox_TextChanged"
                                                          LostFocus="TextBox_LostFocus"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="施工品質管理係数ξ"  Width="150"  HorizontalAlignment="Right"/>
                                                <TextBox Width="50" HorizontalContentAlignment="Right"
                                                         GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                         PreviewKeyDown="TextBox_PreviewKeyDown"
                                                         PreviewLostKeyboardFocus="TextBox_PreviewLostKeyboardFocus"
                                                         TextChanged="TextBox_TextChanged">
                                                    <TextBox.Text>
                                                        <Binding Path="PileSection.ConcreteGsi" StringFormat='{}{0:N2}' UpdateSourceTrigger="LostFocus" >
                                                            <Binding.ValidationRules>
                                                                <!--<local:NumericRangeValidationRule Minimum="0" Maximum="1"/>-->
                                                                <local:FactorValidationRule />
                                                            </Binding.ValidationRules>
                                                        </Binding>
                                                    </TextBox.Text>

                                                </TextBox>
                                                <TextBlock Width="150"  HorizontalAlignment="Right"><Run Text="縦弾性係数 (N/mm"/><Run Text="2" BaselineAlignment="Superscript" FontSize="9"/><Run Text=")"/></TextBlock>
                                                <TextBox Text="{Binding PileSection.ConcreteE, StringFormat='{}{0:N0}'}" Width="50"
                                                         TextAlignment="Right" Foreground="{StaticResource ReadOnlyBrush}" IsReadOnly="True"
                                                         PreviewKeyDown="TextBox_PreviewKeyDown"
                                                         PreviewLostKeyboardFocus="TextBox_PreviewLostKeyboardFocus"
                                                         TextChanged="TextBox_TextChanged"
                                                         LostFocus="TextBox_LostFocus"/>

                                            </StackPanel>
                                        </StackPanel>
                                    </GroupBox>

                                    <StackPanel Visibility="{Binding PileSection.PileBodyType,
                                        Converter={StaticResource VisibilityConverter},
                                        ConverterParameter='場所打ち鋼管コンクリート杭'}">

                                        <GroupBox Header="コンクリート" Visibility="{Binding PileSection.PileSectionType,
                                            Converter={StaticResource VisibilityConverter},
                                            ConverterParameter='鉄筋コンクリート部'}">
                                            <StackPanel>

                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="杭径 (mm)" Width="150" HorizontalAlignment="Right"/>
                                                    <TextBox Text="{Binding PileSection.ConcreteOutDia, StringFormat='{}{0:N0}', UpdateSourceTrigger=LostFocus}"
                                                             Width="50" TextAlignment="Right"
                                                             GotFocus="TextBox_GotFocus" 
                                                             PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                             PreviewKeyDown="TextBox_PreviewKeyDown"
                                                             PreviewLostKeyboardFocus="TextBox_PreviewLostKeyboardFocus"
                                                             TextChanged="TextBox_TextChanged"
                                                             LostFocus="TextBox_LostFocus"/>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Width="150" HorizontalAlignment="Right"><Run Text="設計基準強度F"/><Run Text="c" BaselineAlignment="Subscript" FontSize="9"/><Run Text=" (N/mm"/><Run Text="2" BaselineAlignment="Superscript" FontSize="9"/><Run Text=")"/></TextBlock>
                                                    <TextBox  Text="{Binding PileSection.ConcreteFc, UpdateSourceTrigger=LostFocus}" Width="50" TextAlignment="Right"
                                                              GotFocus="TextBox_GotFocus"
                                                              PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                              PreviewKeyDown="TextBox_PreviewKeyDown"
                                                              TextChanged="TextBox_TextChanged"
                                                              LostFocus="TextBox_LostFocus"/>
                                                    <TextBlock Width="150"  HorizontalAlignment="Right"><Run Text="単位体積重量γ (kN/m"/><Run Text="3" BaselineAlignment="Superscript" FontSize="9"/><Run Text=")"/></TextBlock>
                                                    <TextBox  Text="{Binding PileSection.ConcreteGamma, UpdateSourceTrigger=LostFocus}" Width="50" TextAlignment="Right"
                                                              GotFocus="TextBox_GotFocus" 
                                                              PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                              PreviewKeyDown="TextBox_PreviewKeyDown"
                                                              PreviewLostKeyboardFocus="TextBox_PreviewLostKeyboardFocus"
                                                              TextChanged="TextBox_TextChanged"
                                                              LostFocus="TextBox_LostFocus"/>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="施工品質管理係数ξ"  Width="150"  HorizontalAlignment="Right"/>
                                                    <TextBox Width="50" TextAlignment="Right"
                                                             GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                             PreviewKeyDown="TextBox_PreviewKeyDown"
                                                             PreviewLostKeyboardFocus="TextBox_PreviewLostKeyboardFocus"
                                                             TextChanged="TextBox_TextChanged"
                                                             LostFocus="TextBox_LostFocus">
                                                        <TextBox.Text>
                                                            <Binding Path="PileSection.ConcreteGsi" StringFormat='{}{0:N2}' UpdateSourceTrigger="LostFocus" >
                                                                <Binding.ValidationRules>
                                                                    <!--<local:NumericRangeValidationRule Minimum="0" Maximum="1"/>-->
                                                                    <local:FactorValidationRule />
                                                                </Binding.ValidationRules>
                                                            </Binding>
                                                        </TextBox.Text>
                                                    </TextBox>
                                                    <TextBlock Width="150"  HorizontalAlignment="Right"><Run Text="縦弾性係数 (N/mm"/><Run Text="2" BaselineAlignment="Superscript" FontSize="9"/><Run Text=")"/></TextBlock>
                                                    <TextBox  Text="{Binding PileSection.ConcreteE, StringFormat='{}{0:N0}'}" Width="50" TextAlignment="Right" Foreground="Gray"
                                                              IsReadOnly="True"
                                                              PreviewKeyDown="TextBox_PreviewKeyDown"
                                                              PreviewLostKeyboardFocus="TextBox_PreviewLostKeyboardFocus"
                                                              TextChanged="TextBox_TextChanged"
                                                              LostFocus="TextBox_LostFocus"/>
                                                </StackPanel>

                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding PileSection.PileBodyType,
                                        Converter={StaticResource VisibilityConverter},
                                        ConverterParameter='場所打ち鋼管コンクリート杭'}">

                                        <GroupBox Header="コンクリート" Visibility="{Binding PileSection.PileSectionType,
                                            Converter={StaticResource VisibilityConverter},
                                            ConverterParameter='鋼管コンクリート部'}">
                                            <StackPanel>

                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Width="150" HorizontalAlignment="Right"><Run Text="設計基準強度F"/><Run Text="c" BaselineAlignment="Subscript" FontSize="9"/><Run Text=" (N/mm"/><Run Text="2" BaselineAlignment="Superscript" FontSize="9"/><Run Text=")"/></TextBlock>
                                                    <TextBox  Text="{Binding PileSection.ConcreteFc, UpdateSourceTrigger=LostFocus}" Width="50" TextAlignment="Right"
                                                              GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                              PreviewKeyDown="TextBox_PreviewKeyDown"
                                                              PreviewLostKeyboardFocus="TextBox_PreviewLostKeyboardFocus"
                                                              TextChanged="TextBox_TextChanged"
                                                              LostFocus="TextBox_LostFocus"/>
                                                    <TextBlock Width="150"  HorizontalAlignment="Right"><Run Text="単位体積重量γ (kN/m"/><Run Text="3" BaselineAlignment="Superscript" FontSize="9"/><Run Text=")"/></TextBlock>
                                                    <TextBox  Text="{Binding PileSection.ConcreteGamma, UpdateSourceTrigger=LostFocus}" Width="50" TextAlignment="Right"
                                                              GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                              PreviewKeyDown="TextBox_PreviewKeyDown"
                                                              PreviewLostKeyboardFocus="TextBox_PreviewLostKeyboardFocus"
                                                              TextChanged="TextBox_TextChanged"
                                                              LostFocus="TextBox_LostFocus"/>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="施工品質管理係数ξ"  Width="150"  HorizontalAlignment="Right"/>
                                                    <TextBox Width="50" TextAlignment="Right"
                                                             GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                             PreviewKeyDown="TextBox_PreviewKeyDown"
                                                             PreviewLostKeyboardFocus="TextBox_PreviewLostKeyboardFocus"
                                                             TextChanged="TextBox_TextChanged"
                                                             LostFocus="TextBox_LostFocus">
                                                        <TextBox.Text>
                                                            <Binding Path="PileSection.ConcreteGsi" StringFormat='{}{0:N2}' UpdateSourceTrigger="LostFocus" >
                                                                <Binding.ValidationRules>
                                                                    <!--<local:NumericRangeValidationRule Minimum="0" Maximum="1"/>-->
                                                                    <local:FactorValidationRule />
                                                                </Binding.ValidationRules>
                                                            </Binding>
                                                        </TextBox.Text>
                                                    </TextBox>
                                                    <TextBlock Width="150"  HorizontalAlignment="Right"><Run Text="縦弾性係数 (N/mm"/><Run Text="2" BaselineAlignment="Superscript" FontSize="9"/><Run Text=")"/></TextBlock>
                                                    <TextBox Text="{Binding PileSection.ConcreteE, StringFormat=N0, UpdateSourceTrigger=LostFocus}" Width="50"
                                                             TextAlignment="Right" Foreground="{StaticResource ReadOnlyBrush}" IsReadOnly="True"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>

                                    <GroupBox Header="主筋" Visibility="{Binding PileSection.PileBodyType,
                                        Converter={StaticResource VisibilityConverter},
                                        ConverterParameter='場所打ち鉄筋コンクリート杭'}">
                                        <StackPanel>

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text ="本数-呼び径" Width="100" HorizontalAlignment="Right"/>
                                                <TextBox  Text="{Binding PileSection.MainBarNum, UpdateSourceTrigger=LostFocus}" Width="50" TextAlignment="Right"
                                                          GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                          PreviewKeyDown="TextBox_PreviewKeyDown"
                                                          PreviewLostKeyboardFocus="TextBox_PreviewLostKeyboardFocus"
                                                          TextChanged="TextBox_TextChanged"
                                                          LostFocus="TextBox_LostFocus"/>
                                                <TextBlock Text ="-" Width="20"  HorizontalAlignment="Center"/>
                                                <ComboBox SelectedItem="{Binding PileSection.MainBarSize, UpdateSourceTrigger=PropertyChanged}"
                                                          ItemsSource="{Binding PileSection.MainBarSizeOption}" Width="50"
                                                          DropDownOpened="ComboBox_DropDownOpened" 
                                                          SelectionChanged="ComboBox_SelectionChanged"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text ="規格" Width="100"  HorizontalAlignment="Right"/>
                                                <ComboBox  SelectedItem="{Binding PileSection.MainBarSpec, UpdateSourceTrigger=PropertyChanged}"
                                                           ItemsSource="{Binding PileSection.MainBarSpecOption}" Width="100"
                                                           DropDownOpened="ComboBox_DropDownOpened" 
                                                           SelectionChanged="ComboBox_SelectionChanged"/>

                                                <TextBlock Text ="重心かぶり厚 (mm)" Width="150"  HorizontalAlignment="Right"/>
                                                <TextBox  Text="{Binding PileSection.MainBarCenterCover, UpdateSourceTrigger=LostFocus}" Width="50" TextAlignment="Right"
                                                          GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                          PreviewKeyDown="TextBox_PreviewKeyDown"
                                                          PreviewLostKeyboardFocus="TextBox_PreviewLostKeyboardFocus"
                                                          TextChanged="TextBox_TextChanged"
                                                          LostFocus="TextBox_LostFocus"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </GroupBox>

                                    <StackPanel>

                                        <GroupBox Header="主筋" Visibility="{Binding PileSection.PileBodyType,
                                            Converter={StaticResource VisibilityConverter},
                                            ConverterParameter='場所打ち鋼管コンクリート杭'}">
                                            <StackPanel>

                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text ="本数-呼び径" Width="100" HorizontalAlignment="Right"/>
                                                    <TextBox  Text="{Binding PileSection.MainBarNum, UpdateSourceTrigger=LostFocus}" Width="50" TextAlignment="Right"
                                                              GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                              PreviewKeyDown="TextBox_PreviewKeyDown"
                                                              PreviewLostKeyboardFocus="TextBox_PreviewLostKeyboardFocus"
                                                              TextChanged="TextBox_TextChanged"
                                                              LostFocus="TextBox_LostFocus"/>
                                                    <TextBlock Text ="-" Width="20"  HorizontalAlignment="Center"/>
                                                    <ComboBox  SelectedItem="{Binding PileSection.MainBarSize, UpdateSourceTrigger=PropertyChanged}"
                                                               ItemsSource="{Binding PileSection.MainBarSizeOption}" Width="50"
                                                               DropDownOpened="ComboBox_DropDownOpened" 
                                                               SelectionChanged="ComboBox_SelectionChanged"/>

                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text ="規格" Width="100"  HorizontalAlignment="Right"/>
                                                    <ComboBox  SelectedItem="{Binding PileSection.MainBarSpec, UpdateSourceTrigger=PropertyChanged}"
                                                               ItemsSource="{Binding PileSection.MainBarSpecOption}" Width="100"
                                                               DropDownOpened="ComboBox_DropDownOpened" 
                                                               SelectionChanged="ComboBox_SelectionChanged"/>

                                                    <TextBlock Text ="重心かぶり厚 (mm)" Width="150"  HorizontalAlignment="Right"/>
                                                    <TextBox  Text="{Binding PileSection.MainBarCenterCover, UpdateSourceTrigger=LostFocus}" Width="50" TextAlignment="Right"
                                                              GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                              PreviewKeyDown="TextBox_PreviewKeyDown"
                                                              PreviewLostKeyboardFocus="TextBox_PreviewLostKeyboardFocus"
                                                              TextChanged="TextBox_TextChanged"
                                                              LostFocus="TextBox_LostFocus"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>

                                    <GroupBox Header="せん断補強筋" Visibility="{Binding PileSection.PileBodyType,
                                            Converter={StaticResource VisibilityConverter},
                                            ConverterParameter='場所打ち鉄筋コンクリート杭'}">
                                        <StackPanel>

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text ="補強筋径@間隔 (mm)" Width="150" HorizontalAlignment="Right"/>

                                                <ComboBox  SelectedItem="{Binding PileSection.HoopSize, UpdateSourceTrigger=PropertyChanged}" Width="50"
                                                           ItemsSource="{Binding PileSection.MainBarSizeOption}"
                                                           DropDownOpened="ComboBox_DropDownOpened" 
                                                           SelectionChanged="ComboBox_SelectionChanged"/>
                                                <TextBlock Text ="@" Width="20"/>
                                                <TextBox  Text="{Binding PileSection.HoopSpacing, UpdateSourceTrigger=LostFocus}" Width="50" TextAlignment="Right"
                                                          GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                          PreviewKeyDown="TextBox_PreviewKeyDown"
                                                          PreviewLostKeyboardFocus="TextBox_PreviewLostKeyboardFocus"
                                                          TextChanged="TextBox_TextChanged"
                                                          LostFocus="TextBox_LostFocus"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text ="規格" Width="100"  HorizontalAlignment="Right"/>
                                                <ComboBox  SelectedItem="{Binding PileSection.HoopSpec, UpdateSourceTrigger=PropertyChanged}"
                                                           ItemsSource="{Binding PileSection.MainBarSpecOption}" Width="100"
                                                           DropDownOpened="ComboBox_DropDownOpened" 
