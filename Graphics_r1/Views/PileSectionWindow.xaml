                                                 LostFocus="TextBox_LostFocus"/>
                                    </StackPanel>

                                </Grid>
                            </avalonDock:LayoutAnchorable>

                        </avalonDock:LayoutDocumentPane>

                    </avalonDock:LayoutDocumentPaneGroup>
                </avalonDock:LayoutPanel>
            </avalonDock:LayoutRoot>
        </avalonDock:DockingManager>

        <Grid Grid.Row="1" Margin="8,4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="アンドック・最大化:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource MutedTextBrush}" />
                <Button x:Name="ButtonMaximizeInput" Content="入力" Tag="Input"
                        Height="28" MinWidth="70" Margin="0,0,4,0"
                        ToolTip="入力ペインをアンドックして最大化 / もう一度押すと元の位置にドック" />
                <Button x:Name="ButtonMaximizeSpecs" Content="諸元" Tag="Specs"
                        Height="28" MinWidth="70" Margin="0,0,4,0"
                        ToolTip="諸元ペインをアンドックして最大化 / もう一度押すと元の位置にドック" />
                <Button x:Name="ButtonMaximizeAxialLimit" Content="軸力制限" Tag="AxialLimit"
                        Height="28" MinWidth="70" Margin="0,0,4,0"
                        ToolTip="軸力制限ペインをアンドックして最大化 / もう一度押すと元の位置にドック" />
                <Button x:Name="ButtonMaximizeSectionView" Content="断面図" Tag="SectionView"
                        Height="28" MinWidth="70" Margin="0,0,4,0"
                        ToolTip="断面図ペインをアンドックして最大化 / もう一度押すと元の位置にドック" />
                <Button x:Name="ButtonMaximizeNM" Content="N-M" Tag="NM"
                        Height="28" MinWidth="60" Margin="0,0,4,0"
                        ToolTip="N-M関係ペインをアンドックして最大化 / もう一度押すと元の位置にドック" />
                <Button x:Name="ButtonMaximizeMPhi" Content="M-φ" Tag="MPhi"
                        Height="28" MinWidth="60" Margin="0,0,4,0"
                        ToolTip="M-φ関係ペインをアンドックして最大化 / もう一度押すと元の位置にドック" />
                <Button x:Name="ButtonMaximizeMTheta" Content="M-θ" Tag="MTheta"
                        Height="28" MinWidth="60" Margin="0,0,4,0"
                        ToolTip="M-θ関係ペインをアンドックして最大化 / もう一度押すと元の位置にドック" />
                <Button x:Name="ButtonMaximizeNQ" Content="N-Q" Tag="NQ"
                        Height="28" MinWidth="60" Margin="0,0,4,0"
                        ToolTip="N-Q関係ペインをアンドックして最大化 / もう一度押すと元の位置にドック" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="ButtonOk"
                        Content="保存(_S)"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" Height="30" Width="150"
                        Command="{Binding OkCommand}"
                        IsDefault="True"
                        ToolTip="変更を保存して閉じます (Enter / Ctrl+Enter / Alt+S)" />
                <Button x:Name="ButtonCancel"
                        Content="キャンセル(_C)"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" Height="30" Width="150"
                        Command="{Binding CancelCommand}"
                        IsCancel="True"
                        ToolTip="変更を破棄して閉じます (Esc / Alt+C)" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
