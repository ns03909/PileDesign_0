                                    <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Left" Margin="10,0,0,0">
                                        <Button Content="CSV出力" Click="ExportScatterCsv_Click" Width="120" Height="30" Margin="0,0,10,0"/>
                                        
                                        <TextBlock Text="地震レベル" VerticalAlignment="Center" Margin="10,0,5,0"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <RadioButton Content="1" GroupName="SeismicLevel" IsChecked="{Binding IsSeismicLevel1, Mode=TwoWay}" Margin="0,0,6,0"/>
                                            <RadioButton Content="2" GroupName="SeismicLevel" IsChecked="{Binding IsSeismicLevel2, Mode=TwoWay}"/>
                                        </StackPanel>
                                        <TextBlock Text="M/(Qd)"/>
                                        <Slider Minimum="1" Maximum="3" Value="{Binding MonQd, UpdateSourceTrigger=PropertyChanged}" Width="30" Margin="0,0,10,0"/>
                                        <TextBox Text="{Binding MonQd, UpdateSourceTrigger=PropertyChanged}" Width="30" TextAlignment="Right"
                                                 GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                 PreviewKeyDown="TextBox_PreviewKeyDown"
                                                 PreviewLostKeyboardFocus="TextBox_PreviewLostKeyboardFocus"
                                                 TextChanged="TextBox_TextChanged"
                                                 LostFocus="TextBox_LostFocus"/>
                                        <TextBlock Text="{Binding CrosshairPositionText_NQ}" Margin="10,0,0,0" FontSize="14"/>
                                    </StackPanel>

                                </Grid>
                            </avalonDock:LayoutAnchorable>
                            
                        </avalonDock:LayoutDocumentPane>

                    </avalonDock:LayoutDocumentPaneGroup>
                </avalonDock:LayoutPanel>
            </avalonDock:LayoutRoot>
        </avalonDock:DockingManager>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="1">
            <!--<Button x:Name="ButtonOk" Content="Ok" HorizontalAlignment="Left" Height="25" VerticalAlignment="Top" Width="100" Command="{Binding OkCommand}"/>
            <Button x:Name="ButtonCancel" Content="Cancel" HorizontalAlignment="Left" Height="25" VerticalAlignment="Top" Width="100" Command="{Binding CancelCommand}"/>-->
            <Button x:Name="ButtonOk"
            Content="保存 (Ctrl+Enter)"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" Height="30" Width="150"
            Command="{Binding OkCommand}" />
            <Button x:Name="ButtonCancel"
            Content="キャンセル (Esc)"
            HorizontalAlignment="Center"
VerticalAlignment="Center" Height="30" Width="150"
            Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</Window>
