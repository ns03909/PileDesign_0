                                              KeyTip="E1"
                                              Command="{Binding Example5PileCommand}"
                                              ToolTip="基礎指針'19 計算例5 直接基礎の即時沈下量（PHC杭φ600 L=14m 12本付き）"
                                              ImageSource="pack://application:,,,/Icons/cover.png"/>
