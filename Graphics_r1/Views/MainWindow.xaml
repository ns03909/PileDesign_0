                                                    <views:QuickHintBubble HintText="Step 5 杭配置：「杭配置追加」ボタンで杭を追加" />
                                                </Popup>

                                                <Popup x:Name="QuickHintPopup2"
                                                        PlacementTarget="{Binding ElementName=Canvas3DLayout}"
