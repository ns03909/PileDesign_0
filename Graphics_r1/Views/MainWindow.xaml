                    <Fluent:ToggleButton Header="ツール"
                                                ToolTip="右ツール群の表示/非表示"
                                                IsChecked="{Binding IsRightToolbarVisible}"
                                                LargeIcon="pack://application:,,,/Icons/ToolVisible.png"
                                                Icon="pack://application:,,,/Icons/ToolVisible.png"/>
                </Fluent:RibbonGroupBox>

                <Fluent:RibbonGroupBox Header="説明用" ToolTip="説明用">
                    <Fluent:ToggleButton Header="INPUT 表示"
                        ToolTip="マウス・キーボード入力状態を画面右下に表示 (F12)"
                        IsChecked="{Binding IsInputVisualizerVisible}"
                        LargeIcon="pack://application:,,,/Icons/Mouse.png"
                        Icon="pack://application:,,,/Icons/Mouse.png"/>
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>

            <Fluent:RibbonTabItem Header="ヘルプ(H)" KeyTip="H">
                <Fluent:RibbonGroupBox Header="ヘルプ" ToolTip="ヘルプ">
                    <Fluent:Button x:Name="RibbonButtonQuickStart"
                                 Header="クイック スタート"
                                 ToolTip="入力から解析までの流れを、順を追って説明します。はじめての方はここから。"
                                 Command="{Binding OpenQuickStartHelpCommand}"
                                 LargeIcon="pack://application:,,,/Icons/Help.png"
                                 Icon="pack://application:,,,/Icons/Help.png"
                                 KeyTip="K"/>
                    <Fluent:Button x:Name="RibbonButtonHelp"
                                 Header="ヘルプ"
                                         ToolTip="ヘルプ (F1)"
                                 Command="{Binding OpenHelpWindowCommand}"
                                 LargeIcon="pack://application:,,,/Icons/Help.png"
                                 Icon="pack://application:,,,/Icons/Help.png"/>
                    <Fluent:Button x:Name="RibbonButtonHelpChat"
                                 Header="ヘルプ チャット"
                                 ToolTip="質問入力でヘルプを検索"
                                 Command="{Binding OpenHelpChatWindowCommand}"
                                 LargeIcon="pack://application:,,,/Icons/HelpChat.png"
                                 Icon="pack://application:,,,/Icons/HelpChat.png"/>
                    <Fluent:ToggleButton x:Name="RibbonToggleQuickHint"
                                   Header="クイック ヒント"
                                               ToolTip="クイックヒント (Shift + F1)"
