                                                        <svgc:SvgViewbox Source="/Icons/SelectedInactive.svg" Style="{StaticResource SvgIconStyle16}"/>
                                                    </Button>
                                                    <Button Grid.Row="1" Grid.Column="3"
                                                        Padding="0"
                                                        Style="{StaticResource LargeIconToolTipButtonStyle}"
                                                        Tag="アクティブ反転"
                                                        Click="InvertActiveNodesButton_click">
                                                        <svgc:SvgViewbox Source="/Icons/InvertActive.svg" Style="{StaticResource SvgIconStyle16}"/>
                                                    </Button>
                                                    <!--<Button Grid.Row="1" Grid.Column="0" Padding="0" ToolTip="すべてアクティブ (Ctrl + A)" Click="ShowAllNodesButton_Click">
                                                        <svgc:SvgViewbox Source="/Icons/ActiveAll.svg" Style="{StaticResource SvgIconStyle16}"/>
                                                    </Button>-->
                                                    <!--<Button Grid.Row="1" Grid.Column="1" Padding="0" ToolTip="アクティブ (F2)" Click="ShowSelectedNodesButton_Click">
                                                        <svgc:SvgViewbox Source="/Icons/SelectedActive.svg" Style="{StaticResource SvgIconStyle16}"/>
                                                    </Button>-->
                                                    <!--<Button Grid.Row="1" Grid.Column="2" Padding="0" ToolTip="非アクティブ (Shift + F2)" Click="ShowUnselectedNodesButton_Click">
                                                        <svgc:SvgViewbox Source="/Icons/SelectedInactive.svg" Style="{StaticResource SvgIconStyle16}"/>
                                                    </Button>-->
                                                    <!--<Button Grid.Row="1" Grid.Column="3" Padding="0" ToolTip="アクティブ反転" Click="InvertActiveNodesButton_click">
                                                        <svgc:SvgViewbox Source="/Icons/InvertActive.svg" Style="{StaticResource SvgIconStyle16}"/>
                                                    </Button>-->

                                                    <!-- 行2: 選択操作 -->
                                                    <Button Grid.Row="2" Grid.Column="0"
                                                        Padding="0"
                                                        Style="{StaticResource LargeIconToolTipButtonStyle}"
                                                        Tag="すべて選択 (Ctrl + Shift + A)"
                                                        Click="SelectAllNodesButton_Click">
                                                        <svgc:SvgViewbox Source="/Icons/SelectAll.svg" Style="{StaticResource SvgIconStyle16}"/>
                                                    </Button>
                                                    <Button Grid.Row="2" Grid.Column="1"
                                                        Padding="0"
                                                        Style="{StaticResource LargeIconToolTipButtonStyle}"
                                                        Tag="全選択解除 (Esc)"
                                                        Click="DeselectAllNodesButton_Click">
                                                        <svgc:SvgViewbox Source="/Icons/DeselectAll.svg" Style="{StaticResource SvgIconStyle16}"/>
                                                    </Button>
                                                    <!--<Button Grid.Row="2" Grid.Column="0" Padding="0" ToolTip="すべて選択 (Ctrl + Shift + A)" Click="SelectAllNodesButton_Click">
                                                        <svgc:SvgViewbox Source="/Icons/SelectAll.svg" Style="{StaticResource SvgIconStyle16}"/>
                                                    </Button>-->
                                                    <!--<Button Grid.Row="2" Grid.Column="1" Padding="0" ToolTip="全選択解除 (Esc)" Click="DeselectAllNodesButton_Click">
                                                        <svgc:SvgViewbox Source="/Icons/DeselectAll.svg" Style="{StaticResource SvgIconStyle16}"/>
                                                    </Button>-->
                                                </Grid>
                                            </Border>


                                            <!-- ウィンドウ関連ミニパネル -->
                                            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" 
                                                    Margin="4,2,0,0"
                                                    Padding="4"
                                                    Background="#12DCDCDC"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Panel.ZIndex="15">
                                                <Grid>
                                                    <!-- 行定義拡張: 0=荷重ケース,1=組み合わせ,2=液状化トグル,3=解析結果トグル,4=解析内容選択 -->
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition />
                                                        <RowDefinition />
                                                        <RowDefinition />
                                                        <RowDefinition />
                                                        <RowDefinition />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition />
                                                        <ColumnDefinition />
                                                        <ColumnDefinition />
                                                        <ColumnDefinition />
                                                        <ColumnDefinition />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- 行0: 入力 -->
                                                    <Button x:Name="ButtonFundamentalWindow0" Grid.Row="0" Grid.Column="0"
                                                        Padding="0"
                                                        Style="{StaticResource LargeIconToolTipButtonStyle}"
                                                        Tag="基本設定"
                                                        Command="{Binding OpenFundamentalWindowCommand}">
                                                        <svgc:SvgViewbox Source="/Icons/FundamentalWindow.svg" Style="{StaticResource SvgIconStyle16}"/>
                                                    </Button>
                                                    <Button Grid.Row="0" Grid.Column="1"
                                                        Padding="0"
                                                        Style="{StaticResource LargeIconToolTipButtonStyle}"
                                                        Tag="荷重条件"
                                                        Command="{Binding OpenLoadCaseWindowCommand}">
                                                        <svgc:SvgViewbox Source="/Icons/LoadCaseWindow.svg" Style="{StaticResource SvgIconStyle16}"/>
                                                    </Button>
                                                    <Button Grid.Row="0" Grid.Column="2"
                                                        Padding="0"
                                                        Style="{StaticResource LargeIconToolTipButtonStyle}"
                                                        Tag="地盤"
                                                        Command="{Binding OpenGroundWindowCommand}">
                                                        <svgc:SvgViewbox Source="/Icons/GroundWindow.svg" Style="{StaticResource SvgIconStyle16}"/>
                                                    </Button>
                                                    <Button Grid.Row="0" Grid.Column="3"
                                                        Padding="0"
                                                        Style="{StaticResource LargeIconToolTipButtonStyle}"
                                                        Tag="杭体"
                                                        Command="{Binding OpenPileBodyWindowCommand}">
                                                        <svgc:SvgViewbox Source="/Icons/PileBodyWindow.svg" Style="{StaticResource SvgIconStyle16}"/>
                                                    </Button>
                                                    <Button x:Name="ButtonAxialVerification0" Grid.Row="0" Grid.Column="4"
                                                        Padding="0"
                                                        Style="{StaticResource LargeIconToolTipButtonStyle}"
                                                        Tag="軸力確認"
                                                        Command="{Binding AxialForceCheckCommand}">
                                                        <svgc:SvgViewbox Source="/Icons/AxialForceVeirification.svg" Style="{StaticResource SvgIconStyle16}"/>
                                                    </Button>
                                                   

                                                    <!-- 追加: 要素分割（状態でアイコン切替） -->

                                                    <!-- 行1: 要素分割 -->
                                                    <Button Grid.Row="1" Grid.Column="0"
                                                        Padding="0"
                                                        Style="{StaticResource ElementDivisionButtonStyle}"
                                                        Command="{Binding OpenElementDivisionWindowCommand}"/>

                                                    <!-- 行1: 水平解析 -->
                                                    <Button Grid.Row="1" Grid.Column="1"
                                                        Padding="0"
                                                        Style="{StaticResource LargeIconToolTipButtonStyle}"
                                                        Tag="水平解析"
                                                        Command="{Binding OpenLateralLoadAnalysisWindowCommand}"
                                                        IsEnabled="{Binding IsElementSplit}">
                                                        <svgc:SvgViewbox Source="/Icons/LateralLoadAnalysisWindow.svg"
                                                        Style="{StaticResource SvgIconStyle16}"/>
                                                    </Button>

                                                    <!-- 行1: 単杭沈下解析 -->
                                                    <Button Grid.Row="1" Grid.Column="2"
                                                        Padding="0"
                                                        Style="{StaticResource LargeIconToolTipButtonStyle}"
                                                        Tag="単杭沈下解析"
                                                        Command="{Binding OpenSettlementWindowCommand}"
                                                        IsEnabled="{Binding IsElementSplit}">
                                                        <svgc:SvgViewbox Source="/Icons/SettlementWindow.svg"
                                                        Style="{StaticResource SvgIconStyle16}"/>
                                                    </Button>

                                                    <!-- 行1: 群杭沈下解析 -->
                                                    <Button Grid.Row="1" Grid.Column="3"
                                                        Padding="0"
                                                        Style="{StaticResource LargeIconToolTipButtonStyle}"
                                                        Tag="群杭沈下解析"
                                                        Command="{Binding PileGroupSettlementAnalysisCommand}">
                                                            <svgc:SvgViewbox Source="/Icons/GroupPileSettlement.svg"
                                                            Style="{StaticResource SvgIconStyle16}"/>
                                                    </Button>
                                                    
                                                </Grid>
                                            </Border>

                                            <!-- 荷重関連ミニパネル -->
                                            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" 
                                                    Margin="4,2,0,0"
                                                    Padding="4"
                                                    Background="#12DCDCDC"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Panel.ZIndex="15">
                                                <Grid>
                                                    <!-- 行定義拡張: 0=荷重ケース,1=組み合わせ,2=液状化トグル,3=解析結果トグル,4=解析内容選択 -->
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <Grid Grid.Row="0">
                                                        <!-- 荷重ケース -->
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ComboBox Grid.Column="0"
                                                              ItemsSource="{Binding LoadCaseNameOption}"
                                                              SelectedItem="{Binding SelectedLoadCaseName}"
                                                              ToolTip="荷重ケース">
                                                            <i:Interaction.Triggers>
                                                                <i:EventTrigger EventName="SelectionChanged">
                                                                    <i:InvokeCommandAction Command="{Binding UpdateViewCommand}"/>
                                                                </i:EventTrigger>
                                                            </i:Interaction.Triggers>
                                                        </ComboBox>
                                                        <!-- 置換前の2つの液状化/非液状化トグルを削除し、この単一トグルを配置 -->
                                                        <ToggleButton x:Name="LiquefactionStateToggle"
                                                            Grid.Column="1"
                                                            IsChecked="{Binding IsLiquefaction}">
                                                            <ToggleButton.Visibility>
                                                                <MultiBinding Converter="{StaticResource LoadCaseNameInSeismicCasesToVisibilityConverter}">
                                                                    <Binding Path="SelectedLoadCaseName"/>
                                                                    <Binding Path="CurrentInputModel.LoadCasesInput.AllSeismicLoadCases"/>
                                                                </MultiBinding>
                                                            </ToggleButton.Visibility>
                                                            <ToggleButton.Style>
                                                                <Style TargetType="ToggleButton"
                                                                        BasedOn="{StaticResource LargeIconToolTipToggleButtonStyle}">
                                                                    <!-- 初期(非液状化) -->
                                                                    <Setter Property="Content">
                                                                        <Setter.Value>
                                                                            <svgc:SvgViewbox Source="/Icons/NonLiquefaction.svg"
                                                                                Style="{StaticResource SvgIconStyle16}"/>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Setter Property="Tag" Value="非液状化状態"/>
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsChecked" Value="True">
                                                                            <Setter Property="Content">
                                                                                <Setter.Value>
                                                                                    <svgc:SvgViewbox Source="/Icons/Liquefaction.svg"
                                                                                        Style="{StaticResource SvgIconStyle16}"/>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                            <Setter Property="Tag" Value="液状化状態"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ToggleButton.Style>
                                                        </ToggleButton>
                                                    </Grid>

                                                    <!-- 組み合わせケース -->
                                                    <ComboBox Grid.Row="1"
                                                              ItemsSource="{Binding LoadCombinationNameOption}"
                                                              SelectedItem="{Binding SelectedLoadCombinationName}">
