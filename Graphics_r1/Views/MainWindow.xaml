                                               SmallImageSource="pack://application:,,,/Icons/TickMarkVisible.png"
                                               ToolTip="Z軸に平行なビュー、Z軸に垂直なビューのときの5m間隔の目盛の表示／非表示を切り替えます。"/>
                    <ribbon:RibbonToggleButton Label="通り心" IsChecked="{Binding IsGridLineVisible}"
                                               LargeImageSource="pack://application:,,,/Icons/GridVisible.png"
                                               SmallImageSource="pack://application:,,,/Icons/GridVisible.png"
                                               ToolTip="定義した通り心の表示／非表示を切り替えます。"/>
                    <ribbon:RibbonToggleButton Label="XYZ軸" IsChecked="{Binding IsXYZAxesVisible}"
                                               LargeImageSource="pack://application:,,,/Icons/AxesVisible.png"
                                               SmallImageSource="pack://application:,,,/Icons/AxesVisible.png"
                                               ToolTip="XYZ座標軸の表示／非表示を切り替えます。"/>
                </ribbon:RibbonGroup>

                <!-- 形状関連 -->
                <ribbon:RibbonGroup Header="形状関連" SmallImageSource="pack://application:,,,/Icons/WireFrameVisible.png">
                    <!-- その他 -->
                    <ribbon:RibbonToggleButton Label="慣性力作用点" ToolTip="慣性力作用点の表示／非表示を切り替えます。"
                                                IsChecked="{Binding IsActionPointVisible}"
                                                SmallImageSource="pack://application:,,,/Icons/LateralLoadActionPointVisible.png"/>
                    <ribbon:RibbonToggleButton Label="連結" ToolTip="連結線の表示／非表示を切り替えます。"
                                                IsChecked="{Binding IsRigidFloorVisible}"
                                                SmallImageSource="pack://application:,,,/Icons/IsRigidConnectionVisible.png"/>
                    <!-- 節点系 -->
                    <ribbon:RibbonSplitButton Label="節点" IsCheckable="True" IsChecked="{Binding IsNodeVisible}"
                                              ribbon:RibbonControlService.ToolTipTitle="節点"
                                              ribbon:RibbonControlService.ToolTipDescription="節点の表示／非表示を切り替えます。▼メニューから接続用節点の表示を個別に制御できます。"
                                              LargeImageSource="pack://application:,,,/Icons/NodeVisible.png"
                                              SmallImageSource="pack://application:,,,/Icons/NodeVisible.png">
                        <ribbon:RibbonMenuItem Header="接続用節点" ToolTip="基礎梁接続用節点（杭頭+ΔZc位置）の表示/非表示"
                                               IsCheckable="True" IsChecked="{Binding IsConnectingNodeVisible}"
