                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="IsEnabled" Value="True"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding DataContext.IsForcedDisplacementVisible, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/>
                                            <Condition Binding="{Binding DataContext.IsDisplacementDiagramRatioApplicable, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
