                                                         Width="30" HorizontalContentAlignment="Right" VerticalAlignment="Center"
                                                         PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                         KeyDown="TextBox_KeyDown"/>
                                            </StackPanel>
                                        </StackPanel>

