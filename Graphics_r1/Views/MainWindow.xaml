                                <Setter Property="LargeImageSource" Value="pack://application:,,,/Icons/SettlementWithBeamWindow.png"/>
                                <Setter Property="SmallImageSource" Value="pack://application:,,,/Icons/SettlementWithBeamWindow.png"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVerticalBeamAnalysisDone}" Value="True">
                                        <Setter Property="Label" Value="基礎梁考慮沈下解析(済◎)"/>
                                        <Setter Property="Foreground" Value="#1565C0"/>
                                        <Setter Property="LargeImageSource" Value="pack://application:,,,/Icons/SettlementWithBeamWindowDone.png"/>
                                        <Setter Property="SmallImageSource" Value="pack://application:,,,/Icons/SettlementWithBeamWindowDone.png"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ribbon:RibbonButton.Style>
                    </ribbon:RibbonButton>
                </ribbon:RibbonGroup>

                <ribbon:RibbonGroup Header="群杭沈下解析">
                    <ribbon:RibbonButton x:Name="RibbonButtonGroupPileSettlement"
                     Click="ButtonGroupPileSettlement_Click"
                     ToolTip="スタインブレナー近似式による即時沈下量を計算します。群杭荷重タブで荷重面・土層を設定してください。">
                        <ribbon:RibbonButton.Style>
                            <Style TargetType="ribbon:RibbonButton">
                                <Setter Property="Label" Value="群杭沈下解析"/>
                                <Setter Property="LargeImageSource" Value="pack://application:,,,/Icons/GroupPileSettlement.png"/>
                                <Setter Property="SmallImageSource" Value="pack://application:,,,/Icons/GroupPileSettlement.png"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGroupPileSettlementAnalysisDone}" Value="True">
                                        <Setter Property="Label" Value="群杭沈下解析(済●)"/>
                                        <Setter Property="Foreground" Value="#E65100"/>
                                        <Setter Property="LargeImageSource" Value="pack://application:,,,/Icons/GroupPileSettlementDone.png"/>
                                        <Setter Property="SmallImageSource" Value="pack://application:,,,/Icons/GroupPileSettlementDone.png"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ribbon:RibbonButton.Style>
                    </ribbon:RibbonButton>
                </ribbon:RibbonGroup>


            </ribbon:RibbonTab>

            <ribbon:RibbonTab x:Name="AnalysisResultRibbonTab" Header="解析結果(R)" KeyTip="R">
                <ribbon:RibbonGroup Header="解析結果表示">
                    <ribbon:RibbonToggleButton Label="杭・梁要素"
                        ToolTip="杭・梁要素の解析結果表示/非表示"
                        IsChecked="{Binding IsAnalysisResultVisible}"
                        IsEnabled="{Binding HasAnyAnalysisResult}"
                        LargeImageSource="pack://application:,,,/Icons/AnalysisResult.png"
                        SmallImageSource="pack://application:,,,/Icons/AnalysisResult.png"/>

                    <ComboBox Width="100"
                          SelectedItem="{Binding AnalysisResultContent}"
                          ribbon:RibbonControlService.Label="内容"
                             Visibility="{Binding IsAnalysisResultVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ComboBox.Resources>
                            <!-- カテゴリ（沈下解析結果／水平解析結果）でグループ化 -->
                            <CollectionViewSource x:Key="GroupedAnalysisContents"
                                                  Source="{Binding AnalysisResultContentOption}">
                                <CollectionViewSource.GroupDescriptions>
                                    <PropertyGroupDescription Converter="{StaticResource AnalysisContentCategoryConverter}"/>
                                </CollectionViewSource.GroupDescriptions>
                            </CollectionViewSource>
                        </ComboBox.Resources>
                        <ComboBox.ItemsSource>
                            <Binding Source="{StaticResource GroupedAnalysisContents}"/>
                        </ComboBox.ItemsSource>
                        <ComboBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Background="#FF62B0E2" Padding="6,3">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ComboBox.GroupStyle>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding ComboBox3DAnalysisResultContent_OnSelectionChangedCommand}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </ComboBox>

                    <!-- 沈下種別 -->
                    <ComboBox Width="100"
                          ItemsSource="{Binding AnalysisResultSettlementOption}"
                          SelectedItem="{Binding AnalysisResultSettlementType}"
                          ribbon:RibbonControlService.Label="沈下種別">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox">
                                <!-- 既定は非表示 -->
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsAnalysisResultVisible}" Value="True"/>
                                            <Condition Binding="{Binding AnalysisResultContent}" Value="沈下量"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsAnalysisResultVisible}" Value="True"/>
                                            <Condition Binding="{Binding AnalysisResultContent}" Value="沈下部材角"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsAnalysisResultVisible}" Value="True"/>
                                            <Condition Binding="{Binding AnalysisResultContent}" Value="沈下反力"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsAnalysisResultVisible}" Value="True"/>
                                            <Condition Binding="{Binding AnalysisResultContent}" Value="沈下応力"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding ComboBox3DAnalysisResultContent_OnSelectionChangedCommand}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </ComboBox>

                    <!-- 梁応力 / 沈下応力 -->
                    <ComboBox Width="100"
                          ItemsSource="{Binding AnalysisResultBeamForceOption}"
                          SelectedItem="{Binding AnalysisResultBeamForceType}"
                          ribbon:RibbonControlService.Label="梁応力">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsAnalysisResultVisible}" Value="True"/>
                                            <Condition Binding="{Binding AnalysisResultContent}" Value="梁応力（水平）"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsAnalysisResultVisible}" Value="True"/>
                                            <Condition Binding="{Binding AnalysisResultContent}" Value="沈下応力"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding ComboBox3DAnalysisResultContent_OnSelectionChangedCommand}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </ComboBox>

                    <!-- 節点変位 -->
                    <ComboBox Width="100"
                          ItemsSource="{Binding AnalysisResultNodeDisplacementOption}"
                          SelectedItem="{Binding AnalysisResultNodeDisplacementType}"
                          ribbon:RibbonControlService.Label="節点変位">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsAnalysisResultVisible}" Value="True"/>
                                            <Condition Binding="{Binding AnalysisResultContent}" Value="節点変位（水平）"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding ComboBox3DAnalysisResultContent_OnSelectionChangedCommand}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </ComboBox>

                    <!-- 地盤反力 -->
                    <ComboBox Width="100"
                          ItemsSource="{Binding AnalysisResultSoilSpringOption}"
                          SelectedItem="{Binding AnalysisResultSoilSpringType}"
                          ribbon:RibbonControlService.Label="地盤反力">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsAnalysisResultVisible}" Value="True"/>
                                            <Condition Binding="{Binding AnalysisResultContent}" Value="地盤反力（水平）"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding ComboBox3DAnalysisResultContent_OnSelectionChangedCommand}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </ComboBox>
                    <ribbon:RibbonToggleButton Label="群杭グリッド変位"
                               ToolTip="群杭グリッド変位表示"
                               IsChecked="{Binding IsGroupPileGridDeformationVisible}"
                               LargeImageSource="pack://application:,,,/Icons/GroupPileContorVisible.png"
                               SmallImageSource="pack://application:,,,/Icons/GroupPileContorVisible.png"/>
                </ribbon:RibbonGroup>
                
                <ribbon:RibbonGroup Header="値表示">
                    <CheckBox Content="値表示" IsChecked="{Binding IsResultValueVisible}"/>
                    <CheckBox Content="要素中間"
                          IsChecked="{Binding IsMidSpanResultValueVisibleOnly}"
                          IsEnabled="{Binding IsResultValueVisible}"/>
                    <CheckBox Content="杭頭"
                          IsChecked="{Binding IsPileTopResultValueVisibleOnly}"
                          IsEnabled="{Binding IsResultValueVisible}"/>

                    <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsResultValueVisible}">
                        <TextBlock Text="位置" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Slider Width="70" Minimum="0" Maximum="20"
                            Value="{Binding TextPositionAdjuster, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Width="35" HorizontalContentAlignment="Right" Margin="4,0,0,0"
                             Text="{Binding TextPositionAdjuster, StringFormat=N1, UpdateSourceTrigger=PropertyChanged}"
                             PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                             KeyDown="TextBox_KeyDown"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" IsEnabled="{Binding IsResultValueVisible}">
                        <TextBlock Text="小数" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Slider Width="70" Minimum="0" Maximum="5"
                            Value="{Binding DecimalPlaces, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Width="35" HorizontalContentAlignment="Right" Margin="4,0,0,0"
                             Text="{Binding DecimalPlaces, UpdateSourceTrigger=PropertyChanged}"
                             PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                             KeyDown="TextBox_KeyDown"/>
                    </StackPanel>
                </ribbon:RibbonGroup>

                <ribbon:RibbonGroup Header="ダイアグラムスケール">
                    <StackPanel Orientation="Vertical" Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="応力" VerticalAlignment="Center" Width="28"/>
                            <Slider Width="70" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                    TickFrequency="0.1" IsSnapToTickEnabled="False"
                                    Value="{Binding ForceDiagramRatio}"
                                    ToolTip="モデル範囲に対する最大ダイアグラム長の比率"/>
                            <TextBox Text="{Binding ForceDiagramRatio, StringFormat=N2, UpdateSourceTrigger=LostFocus}"
                                     VerticalAlignment="Center" Width="35" Margin="4,0,0,0" HorizontalContentAlignment="Right"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsDisplacementDiagramRatioApplicable, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="変位" VerticalAlignment="Center" Width="28"/>
                            <Slider Width="70" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                    TickFrequency="0.1" IsSnapToTickEnabled="False"
                                    Value="{Binding DisplacementDiagramRatio}"
                                    ToolTip="モデル範囲に対する最大変位ダイアグラム長の比率"/>
                            <TextBox Text="{Binding DisplacementDiagramRatio, StringFormat=N2, UpdateSourceTrigger=LostFocus}"
                                     VerticalAlignment="Center" Width="35" Margin="4,0,0,0" HorizontalContentAlignment="Right"/>
                        </StackPanel>
                    </StackPanel>
                </ribbon:RibbonGroup>

                <ribbon:RibbonGroup Header="バブル">
                    <ribbon:RibbonSplitButton Label="バブル表示" IsCheckable="True"
                                              IsChecked="{Binding IsBubbleVisible}"
                                              LargeImageSource="pack://application:,,,/Icons/BubbleVisible.png"
                                              SmallImageSource="pack://application:,,,/Icons/BubbleVisible.png"
                                              ribbon:RibbonControlService.ToolTipTitle="バブル表示"
                                              ribbon:RibbonControlService.ToolTipDescription="沈下解析結果の表示時に、各杭位置に沈下量に比例した円（バブル）をカラーコードで描画します。平面ビューでの表示に適しています。">
                        <StackPanel Orientation="Horizontal" Margin="4">
                            <TextBlock Text="径" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <Slider Width="100" Minimum="0" Maximum="200"
                                Value="{Binding BubbleDia, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Width="35" HorizontalContentAlignment="Right"
                                 Text="{Binding BubbleDia, StringFormat=N0, UpdateSourceTrigger=LostFocus}"
                                 PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                 KeyDown="TextBox_KeyDown"/>
                        </StackPanel>
                    </ribbon:RibbonSplitButton>
                </ribbon:RibbonGroup>


                <ribbon:RibbonGroup Header="矢印">
                    <ribbon:RibbonSplitButton Label="矢印表示" IsCheckable="True"
                                              IsChecked="{Binding IsArrowVisible}"
                                              LargeImageSource="pack://application:,,,/Icons/ArrowVisible.png"
                                              SmallImageSource="pack://application:,,,/Icons/ArrowVisible.png"
                                              ribbon:RibbonControlService.ToolTipTitle="矢印表示"
                                              ribbon:RibbonControlService.ToolTipDescription="沈下解析結果の表示時に、各杭位置に沈下量に比例した矢印をカラーコードで描画します。立面ビューでの表示に適しています。">
                        <StackPanel Margin="4">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="全長" VerticalAlignment="Center" Margin="0,0,4,0" Width="28"/>
                                <Slider Width="100" Minimum="0" Maximum="200"
                                    Value="{Binding ArrowLength, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Width="35" HorizontalContentAlignment="Right"
                                     Text="{Binding ArrowLength, StringFormat=N0, UpdateSourceTrigger=LostFocus}"
                                     PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                     KeyDown="TextBox_KeyDown"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="頭長" VerticalAlignment="Center" Margin="0,0,4,0" Width="28"/>
                                <Slider Width="100" Minimum="0" Maximum="50"
                                    Value="{Binding ArrowHeadLength, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Width="35" HorizontalContentAlignment="Right"
                                     Text="{Binding ArrowHeadLength, StringFormat=N0, UpdateSourceTrigger=LostFocus}"
                                     PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                     KeyDown="TextBox_KeyDown"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="頭径" VerticalAlignment="Center" Margin="0,0,4,0" Width="28"/>
                                <Slider Width="100" Minimum="0" Maximum="20"
                                    Value="{Binding ArrowHeadDia, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Width="35" HorizontalContentAlignment="Right"
                                     Text="{Binding ArrowHeadDia, StringFormat=N0, UpdateSourceTrigger=LostFocus}"
                                     PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                     KeyDown="TextBox_KeyDown"/>
                            </StackPanel>
                        </StackPanel>
                    </ribbon:RibbonSplitButton>
                </ribbon:RibbonGroup>

                <ribbon:RibbonGroup Header="変形後">
                    <ribbon:RibbonToggleButton Label="変形後形状"
                                   IsChecked="{Binding IsDeformedElementVisible}"
                                   LargeImageSource="pack://application:,,,/Icons/DeformedElementVisible.png"
                                   SmallImageSource="pack://application:,,,/Icons/DeformedElementVisible.png"
                                   ToolTip="水平解析結果の変形後形状を描画します。&#x0a;杭体形状ONの場合は変形後の杭体断面も表示します。&#x0a;梁断面形状ONの場合は変形後の基礎梁断面も表示します。&#x0a;解析結果表示がOFFでも独立して動作します。"/>
                </ribbon:RibbonGroup>

                <ribbon:RibbonGroup Header="グラフ・テーブル">
                    <ribbon:RibbonButton Label="グラフ出力"
                             ToolTip="杭変位応力グラフ・沈下曲線などの結果グラフウィンドウを開きます。"
                             Command="{Binding OpenGraphWindowCommand}"
                             LargeImageSource="pack://application:,,,/Icons/Graph.png"
                             SmallImageSource="pack://application:,,,/Icons/Graph.png"/>
                    <ribbon:RibbonButton Label="テーブル出力"
                             ToolTip="解析結果をテーブル形式で表示します。"
                             Command="{Binding OpenTableWindowCommand}"
                             LargeImageSource="pack://application:,,,/Icons/Table.png"
                             SmallImageSource="pack://application:,,,/Icons/Table.png"/>
                </ribbon:RibbonGroup>

                <ribbon:RibbonGroup Header="ログ">
                    <ribbon:RibbonButton Label="ログ表示"
                             ToolTip="解析ログウィンドウを開きます。"
                             Command="{Binding OpenLogWindowCommand}"
                             LargeImageSource="pack://application:,,,/Icons/Log.png"
                             SmallImageSource="pack://application:,,,/Icons/Log.png"/>
                </ribbon:RibbonGroup>

                <ribbon:RibbonGroup Header="検定">
                    <ribbon:RibbonButton Label="検定"
                             ToolTip="解析結果の検定ウィンドウを開きます。"
                             Command="{Binding OpenEvaluationWindowCommand}"
                             LargeImageSource="pack://application:,,,/Icons/Check.png"
                             SmallImageSource="pack://application:,,,/Icons/Check.png"/>
                </ribbon:RibbonGroup>

                <!-- テキスト（表示タブと同じ） -->
                <ribbon:RibbonGroup Header="テキスト" SmallImageSource="pack://application:,,,/Icons/LabelSize.png">
                    <ribbon:RibbonButton
                     LargeImageSource="pack://application:,,,/Icons/LabelSize.png"
                     SmallImageSource="pack://application:,,,/Icons/LabelSize.png"
                     ToolTip="テキストサイズを変更します。"
                     IsHitTestVisible="False" Focusable="False"/>
                    <ComboBox Width="50"
                      ItemsSource="{Binding LabelSizeOption}"
                      SelectedItem="{Binding LabelSize}"
                      ribbon:RibbonControlService.Label="サイズ">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding ComboBox3DLabelSize_OnSelectionChangedCommand}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </ComboBox>
                </ribbon:RibbonGroup>

            </ribbon:RibbonTab>


            <ribbon:RibbonTab Header="ツール(T)" KeyTip="T">
                <ribbon:RibbonGroup Header="サブプログラム">
                    <ribbon:RibbonButton Label="Chang" ToolTip="Chang"
                        Command="{Binding OpenChangWindowCommand}"
                        LargeImageSource="pack://application:,,,/Icons/ChangPile.png"
                        SmallImageSource="pack://application:,,,/Icons/ChangPile.png"/>
                </ribbon:RibbonGroup>

                <ribbon:RibbonGroup Header="ライブラリ">
                    <ribbon:RibbonButton Label="杭断面ライブラリ" ToolTip="杭ライブラリを確認"
                        Command="{Binding OpenPileSectionLibraryWindowCommand}"
                        LargeImageSource="pack://application:,,,/Icons/PileSectionLibrary.png"
                        SmallImageSource="pack://application:,,,/Icons/PileSectionLibrary.png"/>
                </ribbon:RibbonGroup>

                <ribbon:RibbonGroup Header="画像">
                    <ribbon:RibbonButton Label="画像コピー(x1.0)"
                             ToolTip="現在の画面を画像としてクリップボードにコピー（等倍）"
                             Command="{Binding ImageCopyCommand}"
                             LargeImageSource="pack://application:,,,/Icons/CopyPicture1.png"
                             SmallImageSource="pack://application:,,,/Icons/CopyPicture1.png"
                             CommandParameter="1.0"/>
                    <ribbon:RibbonButton Label="画像コピー(x2.0)"
                             ToolTip="現在の画面を画像としてクリップボードにコピー（2倍解像度）"
                             Command="{Binding ImageCopyCommand}"
                             LargeImageSource="pack://application:,,,/Icons/CopyPicture2.png"
                             SmallImageSource="pack://application:,,,/Icons/CopyPicture2.png"
                             CommandParameter="2.0"/>
                    <ribbon:RibbonButton Label="画像保存(x1.0)"
                             ToolTip="現在の画面を画像ファイルとして保存（等倍）"
                             Command="{Binding ImageSaveCommand}"
                             LargeImageSource="pack://application:,,,/Icons/SavePicture1.png"
                             SmallImageSource="pack://application:,,,/Icons/SavePicture1.png"
                             CommandParameter="1.0"/>
                    <ribbon:RibbonButton Label="画像保存(x2.0)"
                             ToolTip="現在の画面を画像ファイルとして保存（2倍解像度）"
                             Command="{Binding ImageSaveCommand}"
                             LargeImageSource="pack://application:,,,/Icons/SavePicture2.png"
                             SmallImageSource="pack://application:,,,/Icons/SavePicture2.png"
                             CommandParameter="2.0"/>
                </ribbon:RibbonGroup>

                <ribbon:RibbonGroup Header="エクスポート">
                    <ribbon:RibbonButton Label="3dm出力"
                        ToolTip="杭・根入れ部・基礎梁の3Dモデルを Rhino 3D (.3dm) ファイルにエクスポート"
                        Command="{Binding Export3dmFileCommand}"
                        LargeImageSource="pack://application:,,,/Icons/rhino8-.png"
                        SmallImageSource="pack://application:,,,/Icons/rhino8-.png"/>
                    <ribbon:RibbonButton Label="DXF(3D)"
                        ToolTip="杭・根入れ部・基礎梁の3Dモデルを DXF ファイルにエクスポート"
                        Command="{Binding ExportDxfFileCommand}"
                        LargeImageSource="pack://application:,,,/Icons/dxf.png"
                        SmallImageSource="pack://application:,,,/Icons/dxf.png"/>
                    <ribbon:RibbonButton Label="DXF(伏図)"
                        ToolTip="杭伏図（通り心・寸法・杭位置・基礎梁）を2D DXFファイルにエクスポート"
                        Command="{Binding ExportDxfPlanFileCommand}"
                        LargeImageSource="pack://application:,,,/Icons/dxf.png"
                        SmallImageSource="pack://application:,,,/Icons/dxf.png"/>
                    <ribbon:RibbonButton Label="MGT出力"
                        ToolTip="FEM解析モデルを midas iGen / Gen MGT テキスト形式でエクスポート（非線形地盤ばね・慣性力・強制変位・荷重組み合わせを含む）"
                        Command="{Binding ExportMgtFileCommand}"
                        LargeImageSource="pack://application:,,,/Icons/mgtFile.png"
                        SmallImageSource="pack://application:,,,/Icons/mgtFile.png"/>
                </ribbon:RibbonGroup>


            </ribbon:RibbonTab>

            <ribbon:RibbonTab Header="ウィンドウ(W)" KeyTip="W">
                <ribbon:RibbonGroup Header="パネル">
                    <ribbon:RibbonToggleButton x:Name="LeftTabsToggle"
                                         Label="データタブ"
                                         ToolTip="データタブ（一般節点～群杭荷重）の表示/非表示"
                                         IsChecked="True"
                                         Click="ToggleLeftTabs_Click"
                                         LargeImageSource="pack://application:,,,/Icons/DataTabVisible.png"
                                         SmallImageSource="pack://application:,,,/Icons/DataTabVisible.png"/>
                    <ribbon:RibbonToggleButton x:Name="InputDataPanelToggle"
                                         Label="入力データ"
                                         ToolTip="入力データパネルの表示/非表示"
                                         IsChecked="True"
                                         Click="ToggleInputDataPanel_Click"
                                         LargeImageSource="pack://application:,,,/Icons/InputDataVisible.png"
                                         SmallImageSource="pack://application:,,,/Icons/InputDataVisible.png"/>
                    <ribbon:RibbonToggleButton x:Name="PropertiesPanelToggle"
                                         Label="プロパティ"
                                         ToolTip="プロパティパネルの表示/非表示"
                                         IsChecked="True"
                                         Click="TogglePropertiesPanel_Click"
                                         LargeImageSource="pack://application:,,,/Icons/PropertyVisible.png"
                                         SmallImageSource="pack://application:,,,/Icons/PropertyVisible.png"/>
                    <ribbon:RibbonToggleButton x:Name="MinimapPanelToggle"
                                         Label="ミニマップ"
                                         ToolTip="ミニマップパネルの表示/非表示"
                                         IsChecked="True"
                                         Click="ToggleMinimapPanel_Click"
                                         LargeImageSource="pack://application:,,,/Icons/MiniMapVisible.png"
                                         SmallImageSource="pack://application:,,,/Icons/MiniMapVisible.png"/>
                </ribbon:RibbonGroup>
                <ribbon:RibbonGroup Header="3Dビュー">
                    <ribbon:RibbonToggleButton Label="ビューキューブ"
                                                ToolTip="ビューキューブの表示/非表示"
                                                IsChecked="{Binding IsViewCubeVisible}"
                                                LargeImageSource="pack://application:,,,/Icons/ViewCubeVisible.png"
                                                SmallImageSource="pack://application:,,,/Icons/ViewCubeVisible.png"/>
                    <ribbon:RibbonToggleButton Label="ツール"
                                                ToolTip="右ツール群の表示/非表示"
                                                IsChecked="{Binding IsRightToolbarVisible}"
                                                LargeImageSource="pack://application:,,,/Icons/ToolVisible.png"
                                                SmallImageSource="pack://application:,,,/Icons/ToolVisible.png"/>
                </ribbon:RibbonGroup>

                <ribbon:RibbonGroup Header="説明用">
                    <ribbon:RibbonToggleButton Label="入力状況表示"
                        ToolTip="マウス・キーボード入力状態を画面右下に表示"
                        IsChecked="{Binding IsInputVisualizerVisible}"
                        LargeImageSource="pack://application:,,,/Icons/Mouse.png"
                        SmallImageSource="pack://application:,,,/Icons/Mouse.png"/>
                </ribbon:RibbonGroup>
            </ribbon:RibbonTab>

            <ribbon:RibbonTab Header="ヘルプ(H)" KeyTip="H">
                <ribbon:RibbonGroup Header="ヘルプ">
                    <ribbon:RibbonButton x:Name="RibbonButtonHelp"
                                 Label="ヘルプ"
                                         ToolTip="ヘルプ (F1)"
                                 Command="{Binding OpenHelpWindowCommand}"
                                 LargeImageSource="pack://application:,,,/Icons/Help.png"
                                 SmallImageSource="pack://application:,,,/Icons/Help.png"/>
                    <ribbon:RibbonToggleButton x:Name="RibbonToggleQuickHint"
                                   Label="クイックヒント"
                                               ToolTip="クイックヒント (Shift + F1)"
                                   IsChecked="{Binding IsQuickHintVisible}"
                                   LargeImageSource="pack://application:,,,/Icons/QuickHint.png"
                                   SmallImageSource="pack://application:,,,/Icons/QuickHint.png"
                                   Checked="QuickHintToggle_Checked"
                                   Unchecked="QuickHintToggle_Unchecked"
                                   KeyTip="Q"/>
                    <ribbon:RibbonButton x:Name="RibbonButtonShortcutKeys"
                                 Label="ショートカット"
                                 ToolTip="ショートカット (Ctrl + /)"
                                 Command="{Binding OpenShortcutKeysWindowCommand}"
                                 LargeImageSource="pack://application:,,,/Icons/ShortcutKeys.png"
                                 SmallImageSource="pack://application:,,,/Icons/ShortcutKeys.png"
                                 />
                    <ribbon:RibbonButton Label="検証"
                                 ToolTip="設計例によるプログラムの検証"
                                 Command="{Binding OpenVerificationWindowCommand}"
                                 LargeImageSource="pack://application:,,,/Icons/Verification.png"
                                 SmallImageSource="pack://application:,,,/Icons/Verification.png"/>
                </ribbon:RibbonGroup>
            </ribbon:RibbonTab>
        </ribbon:Ribbon>

        <avalonDock:DockingManager x:Name="dockingManager" Grid.Row="1">
            <avalonDock:LayoutRoot>
                <avalonDock:LayoutPanel Orientation="Horizontal">
                    <avalonDock:LayoutAnchorablePane DockWidth="Auto">
                        <avalonDock:LayoutAnchorable x:Name="inputDataAnchorable" Title="入力データ"
                                                     CanClose="False" CanHide="True" CanAutoHide="True" AutoHideWidth="250">
                            <TreeView x:Name="TreeViewControl" ItemsSource="{Binding CTreeViewData}">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate DataType="{x:Type local:CTreeViewData}"
                                                              ItemsSource="{Binding Children}">
                                        <TextBlock Text="{Binding Name}" Foreground="{Binding TextColor}"/>
                                        <HierarchicalDataTemplate.ItemTemplate>
                                            <HierarchicalDataTemplate DataType="{x:Type local:CTreeViewData}"
                                                                      ItemsSource="{Binding Children}">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{Binding TextColor}"/>

                                                <HierarchicalDataTemplate.ItemTemplate>
                                                    <HierarchicalDataTemplate DataType="{x:Type local:CTreeViewData}"                      
                                                                  ItemsSource="{Binding Children}">
                                                        <TextBlock Text="{Binding Name}"
                                                                    Foreground="{Binding TextColor}"/>

                                                    </HierarchicalDataTemplate>
                                                </HierarchicalDataTemplate.ItemTemplate>
                                            </HierarchicalDataTemplate>
                                        </HierarchicalDataTemplate.ItemTemplate>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </avalonDock:LayoutAnchorable>
                    </avalonDock:LayoutAnchorablePane>

                    <avalonDock:LayoutDocumentPaneGroup x:Name="leftTabsGroup" DockWidth="1*">
                        <avalonDock:LayoutDocumentPane>

                            <!-- 一般節点タブ -->
                            <avalonDock:LayoutDocument Title="一般節点" CanClose="False" x:Name="InputNodeLayoutDocument">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- ツールバー -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
                                        <Button
                                                Command="{Binding AddInputNodeCommand}"
                                                ToolTip="新しい一般節点を追加します">
                                                <svgc:SvgViewbox Source="/Icons/AddGeneralNode.svg"
                                                Style="{StaticResource SvgIconStyle24}"/>
                                        </Button>
                                        <Button
                                                Command="{Binding DeleteDuplicateInputNodesCommand}"
                                                ToolTip="同一座標の重複する一般節点を削除します（梁要素の参照は自動で付け替えます）">
                                                <svgc:SvgViewbox Source="/Icons/MergeNodes.svg"
                                                Style="{StaticResource SvgIconStyle24}"/>
                                        </Button>
                                        <Button ToolTip="X優先整列（X昇順→Y昇順）"
                                                Command="{Binding SortInputNodesXFirstCommand}"
                                                Width="32" Height="32" Padding="0">
                                            <svgc:SvgViewbox Source="/Icons/SortXY.svg" Style="{StaticResource SvgIconStyle24}"/>
                                        </Button>
                                        <Button ToolTip="Y優先整列（Y昇順→X昇順）"
                                                Command="{Binding SortInputNodesYFirstCommand}"
                                                Width="32" Height="32" Padding="0">
                                            <svgc:SvgViewbox Source="/Icons/SortYX.svg" Style="{StaticResource SvgIconStyle24}"/>
                                        </Button>
                                    </StackPanel>

                                    <!-- 注記 -->
                                    <TextBlock Grid.Row="1" Margin="5,0,5,4" TextWrapping="Wrap" Foreground="Gray" FontSize="11"
                                               Text="※杭と梁要素（基礎梁）との連結部には一般節点は使いません。杭配置のΔZcオフセットされた接合節点に梁要素（基礎梁）をつなげてください。"/>

                                    <!-- DataGrid -->
                                    <common:EnhancedDataGrid x:Name="DataGridInputNodes"
                                              Grid.Row="2"
                                              ItemsSource="{Binding CurrentInputModel.InputNodes, UpdateSourceTrigger=LostFocus}"
                                              SelectionChanged="DataGridInputNodes_SelectionChanged"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              CanUserSortColumns="True"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto"
                                              LoadingRow="DataGridInputNodes_LoadingRow_Numbering"
                                              CellEditEnding="DataGridInputNodes_CellEditEnding"
                                              BeginningEdit="DataGridInputNodes_BeginningEdit"
                                              common:DataGridNavigationBehavior.Enable="True"
                                              EnableRowVirtualization="True"
                                              EnableColumnVirtualization="True"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling"
                                              ScrollViewer.CanContentScroll="True"
                                              FrozenColumnCount="2"
                                              VerticalAlignment="Top"
                                              CellStyle="{StaticResource CustomDataGridCellStyle}">
                                        <DataGrid.AlternatingRowBackground>
                                            <ImageBrush/>
                                        </DataGrid.AlternatingRowBackground>

                                        <!--CSVファイル出力等-->
                                        <DataGrid.ContextMenu>
                                            <StaticResource ResourceKey="CommonDataGridContextMenu"/>
                                        </DataGrid.ContextMenu>

                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                <Setter Property="Foreground" Value="#62B0E2" />
                                            </Style>
                                        </DataGrid.ColumnHeaderStyle>

                                        <DataGrid.Columns>
                                            <DataGridTextColumn Width="*" Binding="{Binding X, StringFormat=N3, Mode=TwoWay}" ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50">
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="X" TextAlignment="Center"/>
                                                        <TextBlock Text="(m)" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Width="*" Binding="{Binding Y, StringFormat=N3, Mode=TwoWay}" ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50">
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="Y" TextAlignment="Center"/>
                                                        <TextBlock Text="(m)" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Width="*" Binding="{Binding Z, StringFormat=N3, Mode=TwoWay}" ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50">
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="Z" TextAlignment="Center"/>
                                                        <TextBlock Text="(m)" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Width="*" Binding="{Binding Type}" IsReadOnly="True" MinWidth="60">
                                                <DataGridTextColumn.Header>
                                                    <TextBlock Text="タイプ" TextAlignment="Center"/>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="50">
                                                <DataGridCheckBoxColumn.Header>
                                                    <TextBlock Text="選択" TextAlignment="Center"/>
                                                </DataGridCheckBoxColumn.Header>
                                            </DataGridCheckBoxColumn>

                                            <DataGridTemplateColumn Width="*" Header="削除" MinWidth="50">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button
                                                            x:Name="ButtonInputNodeDelete"
                                                            Click="ButtonInputNodeDelete_Click"
                                                            Content="削除"
                                                            Tag="{Binding}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </common:EnhancedDataGrid>
                                </Grid>
                            </avalonDock:LayoutDocument>

                            <avalonDock:LayoutDocument Title="梁要素"
                                                       x:Name="GeneralBeamElementDocument"
                                                       CanClose="False">
                                <TabControl>
                                    <!-- 材料タブ -->
                                    <TabItem Header="材料" ToolTip="梁材料を編集します">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!-- ツールバー -->
                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2">
                                                <Button 
                                                        Command="{Binding OpenMaterialWizardCommand}"
                                                        ToolTip="コンクリート強度から材料特性を自動計算します">
                                                        <svgc:SvgViewbox Source="/Icons/MaterialWizard.svg"
                                                        Style="{StaticResource SvgIconStyle24}"/>
                                                     </Button>
                                            </StackPanel>


                                            <!-- 材料一覧DataGrid -->
                                            <GroupBox Grid.Row="1" Header="材料一覧" Margin="2">
                                        <common:EnhancedDataGrid x:Name="DataGridBeamMaterials"
                                                ItemsSource="{Binding CurrentInputModel.FoundationBeamInput.Materials, UpdateSourceTrigger=PropertyChanged}"
                                                AutoGenerateColumns="False"
                                                CanUserAddRows="True"
                                                LoadingRow="DataGrid_LoadingRow_Numbering"
                                                CellEditEnding="DataGridBeamMaterialsOrSections_CellEditEnding"
                                                CellStyle="{StaticResource CustomDataGridCellStyle}"
                                                common:DataGridNavigationBehavior.Enable="True">

                                            <DataGrid.ContextMenu>
                                                <StaticResource ResourceKey="CommonDataGridContextMenu"/>
                                            </DataGrid.ContextMenu>

                                            <DataGrid.ColumnHeaderStyle>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                    <Setter Property="Foreground" Value="#62B0E2" />
                                                </Style>
                                            </DataGrid.ColumnHeaderStyle>

                                            <DataGrid.Columns>
                                                <DataGridTextColumn Binding="{Binding No, StringFormat=N0}"
                                                                ElementStyle="{StaticResource RightAlignedTextBlockStyle}" Width="50">
                                                    <DataGridTextColumn.Header>
                                                        <TextBlock Text="No" TextAlignment="Center"/>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Binding="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                                                Width="*">
                                                    <DataGridTextColumn.Header>
                                                        <TextBlock Text="名称" TextAlignment="Center"/>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Binding="{Binding YoungModulus, Converter={StaticResource StressUnitConverter}, StringFormat=N2, UpdateSourceTrigger=LostFocus}"
                                                                ElementStyle="{StaticResource RightAlignedTextBlockStyle}" Width="*">
                                                    <DataGridTextColumn.Header>
                                                        <StackPanel>
                                                            <TextBlock Text="ヤング" TextAlignment="Center"/>
                                                                    <TextBlock Text="係数" TextAlignment="Center"/>
                                                                    <TextBlock Text="N/mm²" TextAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Binding="{Binding ShearModulus, Converter={StaticResource StressUnitConverter}, StringFormat=N2, Mode=OneWay}"
                                                                IsReadOnly="True"
                                                                ElementStyle="{StaticResource ReadOnlyRightAlignedTextBlockStyle}" Width="*">
                                                    <DataGridTextColumn.Header>
                                                                <StackPanel>
                                                                    <TextBlock Text="せん断" TextAlignment="Center"/>
                                                                    <TextBlock Text="弾性係数" TextAlignment="Center"/>
                                                                    <TextBlock Text="N/mm²" TextAlignment="Center"/>
                                                                </StackPanel>
                                                        
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Binding="{Binding PoissonRatio, StringFormat=N3, UpdateSourceTrigger=LostFocus}"
                                                                ElementStyle="{StaticResource RightAlignedTextBlockStyle}" Width="*">
                                                    <DataGridTextColumn.Header>
                                                        <TextBlock Text="ポアソン比" TextAlignment="Center"/>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                                <DataGridTemplateColumn Width="60" Header="削除">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="削除"
                                                                Command="{Binding DataContext.DeleteBeamMaterialCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </common:EnhancedDataGrid>
                                    </GroupBox>
                                </Grid>
                            </TabItem>

                            <!-- 断面タブ -->
                            <TabItem Header="断面" ToolTip="梁断面を編集します">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- ツールバー -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2">
                                        <Button Command="{Binding OpenSectionWizardCommand}"
                                                ToolTip="断面ウィザード：断面寸法から断面性能を自動計算します"
                                                Margin="2">
                                            <svgc:SvgViewbox Source="/Icons/SectionWizard.svg"
                                                             Style="{StaticResource SvgIconStyle24}"/>
                                        </Button>
                                        <Button Command="{Binding ClearAllTorsionalStiffnessCommand}"
                                                ToolTip="全断面ねじり剛性無視：すべての断面のIxx係数を0.0に設定し、ねじり剛性を無視します"
                                                Margin="2"
                                                Padding="5,2">
                                            <svgc:SvgViewbox Source="/Icons/BeamTwistStiffness0.svg"
                                                             Style="{StaticResource SvgIconStyle24}"/>
                                        </Button>
                                    </StackPanel>


                                            <GroupBox Grid.Row="1" Header="断面一覧" Margin="2">
                                        <common:EnhancedDataGrid x:Name="DataGridBeamSections"
                                                ItemsSource="{Binding CurrentInputModel.FoundationBeamInput.Sections, UpdateSourceTrigger=PropertyChanged}"
                                                AutoGenerateColumns="False"
                                                CanUserAddRows="True"
                                                LoadingRow="DataGrid_LoadingRow_Numbering"
                                                CellEditEnding="DataGridBeamMaterialsOrSections_CellEditEnding"
                                                CellStyle="{StaticResource CustomDataGridCellStyle}"
                                                common:DataGridNavigationBehavior.Enable="True"
                                                HorizontalScrollBarVisibility="Auto"
                                                VerticalScrollBarVisibility="Auto">

                                            <DataGrid.ContextMenu>
                                                <StaticResource ResourceKey="CommonDataGridContextMenu"/>
                                            </DataGrid.ContextMenu>

                                            <DataGrid.ColumnHeaderStyle>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                    <Setter Property="Foreground" Value="#62B0E2" />
                                                </Style>
                                            </DataGrid.ColumnHeaderStyle>

                                            <DataGrid.Columns>
                                                <DataGridTextColumn Binding="{Binding No, StringFormat=N0}"
                                                                ElementStyle="{StaticResource RightAlignedTextBlockStyle}" Width="35" MinWidth="35">
                                                    <DataGridTextColumn.Header>
                                                        <TextBlock Text="No" TextAlignment="Center"/>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Binding="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                                                Width="80" MinWidth="60">
                                                    <DataGridTextColumn.Header>
                                                        <TextBlock Text="名称" TextAlignment="Center"/>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Binding="{Binding Width, StringFormat=N3, UpdateSourceTrigger=LostFocus}"
                                                                ElementStyle="{StaticResource RightAlignedTextBlockStyle}" Width="55" MinWidth="50">
                                                    <DataGridTextColumn.Header>
                                                        <TextBlock Text="幅(m)" TextAlignment="Center"/>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Binding="{Binding Height, StringFormat=N3, UpdateSourceTrigger=LostFocus}"
                                                                ElementStyle="{StaticResource RightAlignedTextBlockStyle}" Width="55" MinWidth="50">
                                                    <DataGridTextColumn.Header>
                                                        <TextBlock Text="高さ(m)" TextAlignment="Center"/>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                                <!-- 増減係数 -->
                                                <DataGridTextColumn Binding="{Binding AFactor, StringFormat=N3, UpdateSourceTrigger=LostFocus}"
                                                                ElementStyle="{StaticResource RightAlignedTextBlockStyle}" Width="55" MinWidth="50">
                                                    <DataGridTextColumn.Header>
                                                        <TextBlock Text="係数A" TextAlignment="Center"/>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Binding="{Binding AyFactor, StringFormat=N3, UpdateSourceTrigger=LostFocus}"
                                                                ElementStyle="{StaticResource RightAlignedTextBlockStyle}" Width="55" MinWidth="50">
                                                    <DataGridTextColumn.Header>
                                                        <TextBlock Text="係数Ay" TextAlignment="Center"/>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Binding="{Binding AzFactor, StringFormat=N3, UpdateSourceTrigger=LostFocus}"
                                                                ElementStyle="{StaticResource RightAlignedTextBlockStyle}" Width="55" MinWidth="50">
                                                    <DataGridTextColumn.Header>
                                                        <TextBlock Text="係数Az" TextAlignment="Center"/>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Binding="{Binding IxxFactor, StringFormat=N3, UpdateSourceTrigger=LostFocus}"
                                                                ElementStyle="{StaticResource RightAlignedTextBlockStyle}" Width="55" MinWidth="50">
                                                    <DataGridTextColumn.Header>
                                                        <TextBlock Text="係数Ixx" TextAlignment="Center"/>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Binding="{Binding IyyFactor, StringFormat=N3, UpdateSourceTrigger=LostFocus}"
                                                                ElementStyle="{StaticResource RightAlignedTextBlockStyle}" Width="55" MinWidth="50">
                                                    <DataGridTextColumn.Header>
                                                        <TextBlock Text="係数Iyy" TextAlignment="Center"/>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Binding="{Binding IzzFactor, StringFormat=N3, UpdateSourceTrigger=LostFocus}"
                                                                ElementStyle="{StaticResource RightAlignedTextBlockStyle}" Width="55" MinWidth="50">
                                                    <DataGridTextColumn.Header>
                                                        <TextBlock Text="係数Izz" TextAlignment="Center"/>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                                <!-- 断面諸元（読み取り専用） -->
                                                <DataGridTextColumn Binding="{Binding Area, StringFormat=E3}" IsReadOnly="True"
                                                                ElementStyle="{StaticResource ReadOnlyRightAlignedTextBlockStyle}" Width="75" MinWidth="70">
                                                    <DataGridTextColumn.Header>
                                                        <TextBlock Text="A(m²)" TextAlignment="Center"/>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Binding="{Binding ShearAreaY, StringFormat=E3}" IsReadOnly="True"
                                                                ElementStyle="{StaticResource ReadOnlyRightAlignedTextBlockStyle}" Width="75" MinWidth="70">
                                                    <DataGridTextColumn.Header>
                                                        <TextBlock Text="Ay(m²)" TextAlignment="Center"/>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Binding="{Binding ShearAreaZ, StringFormat=E3}" IsReadOnly="True"
                                                                ElementStyle="{StaticResource ReadOnlyRightAlignedTextBlockStyle}" Width="75" MinWidth="70">
                                                    <DataGridTextColumn.Header>
                                                        <TextBlock Text="Az(m²)" TextAlignment="Center"/>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Binding="{Binding TorsionalMoment, StringFormat=E3}" IsReadOnly="True"
                                                                ElementStyle="{StaticResource ReadOnlyRightAlignedTextBlockStyle}" Width="75" MinWidth="70">
                                                    <DataGridTextColumn.Header>
                                                        <TextBlock Text="Ixx(m⁴)" TextAlignment="Center"/>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Binding="{Binding MomentOfInertiaYY, StringFormat=E3}" IsReadOnly="True"
                                                                ElementStyle="{StaticResource ReadOnlyRightAlignedTextBlockStyle}" Width="75" MinWidth="70">
                                                    <DataGridTextColumn.Header>
                                                        <TextBlock Text="Iyy(m⁴)" TextAlignment="Center"/>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Binding="{Binding MomentOfInertiaZZ, StringFormat=E3}" IsReadOnly="True"
                                                                ElementStyle="{StaticResource ReadOnlyRightAlignedTextBlockStyle}" Width="75" MinWidth="70">
                                                    <DataGridTextColumn.Header>
                                                        <TextBlock Text="Izz(m⁴)" TextAlignment="Center"/>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                                <DataGridTemplateColumn Width="60" Header="削除">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="削除"
                                                                Command="{Binding DataContext.DeleteBeamSectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </common:EnhancedDataGrid>
                                    </GroupBox>
                                </Grid>
                            </TabItem>

                                <!-- 梁要素タブ -->
                                <TabItem Header="梁要素" ToolTip="梁要素を編集します">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0">
                                            <TextBlock Margin="4,2" Foreground="#888" FontSize="11" TextWrapping="Wrap"
                                                       Text="※梁要素を追加するには、&#x0a;Canvas上で梁要素追加モード(Alt+1)にし、&#x0a;杭接合節点、一般節点をクリックしてください。"/>
                                            <StackPanel Orientation="Horizontal" Margin="4,2" >
                                                <Button ToolTip="要素番号昇順で整列"
                                                        Command="{Binding SortBeamsByNoCommand}">
                                                    <svgc:SvgViewbox Source="/Icons/SortNo.svg" Style="{StaticResource SvgIconStyle24}"/>
                                                </Button>
                                                <Button ToolTip="I端節点昇順→J端節点昇順で整列"
                                                        Command="{Binding SortBeamsByNodeCommand}">
                                                    <svgc:SvgViewbox Source="/Icons/SortIJ.svg" Style="{StaticResource SvgIconStyle24}"/>
                                                </Button>
