                                               Icon="pack://application:,,,/Icons/IsAxialLoadVisible.png" SizeDefinition="Small, Small, Small"/>
                    <!-- ダイアグラムスケール（応力）は右端「テキスト・ダイアグラムスケール」グループに統合済み -->
                </Fluent:RibbonGroupBox>
                
                <!-- 土層・土質点関連: 2 列 × 3 行のレイアウト -->
                <Fluent:RibbonGroupBox Header="土層・土質点" ToolTip="土層・土質点" Icon="pack://application:,,,/Icons/SurroundingSoilVisible.png">
                    <StackPanel Orientation="Vertical">
                        <!-- 1 行目: 杭周土層 / 値表示 -->
                        <StackPanel Orientation="Horizontal">
                            <Fluent:ToggleButton Header="杭周 土層" ToolTip="杭周土層の表示／非表示を切り替えます。"
                                                 IsChecked="{Binding IsGroundVisible}"
                                                 LargeIcon="pack://application:,,,/Icons/SurroundingSoilVisible.png"
                                                 Icon="pack://application:,,,/Icons/SurroundingSoilVisible.png"
                                                 SizeDefinition="Small, Small, Small"/>
                            <Fluent:ToggleButton Header="値表示" Margin="2,0,0,0"
                                                 ToolTip="土層・土質点のパラメータの値の表示／非表示を切り替えます。"
                                                 IsChecked="{Binding IsSoilValueVisible}"
                                                 Icon="pack://application:,,,/Icons/GroundParameterValueVisible.png"
                                                 SizeDefinition="Small, Small, Small"/>
                        </StackPanel>
                        <!-- 2 行目: 土層 / 土層パラメータ -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Fluent:ToggleButton Header="土層"
                                                 ToolTip="土層パラメータ（密度・粘着力・Vs・Es・平均N値）の表示／非表示"
                                                 IsChecked="{Binding IsSoilLayerParamDisplayEnabled}"
                                                 Icon="pack://application:,,,/Icons/GroundLayerParametersVisible.png"
                                                 SizeDefinition="Small, Small, Small"/>
                            <ComboBox Width="70" Margin="2,0,0,0" VerticalAlignment="Center"
                                      ItemsSource="{Binding SoilParamDisplayOptions}"
                                      SelectedItem="{Binding SelectedSoilParamDisplay}"
                                      IsEnabled="{Binding IsSoilLayerParamDisplayEnabled}"/>
                        </StackPanel>
                        <!-- 3 行目: 土質点 / 土質点パラメータ -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Fluent:ToggleButton Header="土質点"
                                                 ToolTip="土質点パラメータ（N値・Vs0・Fc）の表示／非表示"
                                                 IsChecked="{Binding IsSoilMassParamDisplayEnabled}"
                                                 Icon="pack://application:,,,/Icons/GroundPointParametersVisible.png"
                                                 SizeDefinition="Small, Small, Small"/>
                            <ComboBox Width="70" Margin="2,0,0,0" VerticalAlignment="Center"
                                      ItemsSource="{Binding SoilMassParamDisplayOptions}"
                                      SelectedItem="{Binding SelectedSoilMassParamDisplay}"
                                      IsEnabled="{Binding IsSoilMassParamDisplayEnabled}"/>
                        </StackPanel>
                    </StackPanel>
                </Fluent:RibbonGroupBox>

                <!-- 地盤変位 -->
                <Fluent:RibbonGroupBox Header="地盤変位" ToolTip="地盤変位" Icon="pack://application:,,,/Icons/IsForcedDispVisible.png">
                    <Fluent:ToggleButton Header="地盤 変位" ToolTip="地盤変位の表示／非表示を切り替えます。"
                                                   IsChecked="{Binding IsForcedDisplacementVisible}"
                                                   LargeIcon="pack://application:,,,/Icons/IsForcedDispVisible.png"
                                                   Icon="pack://application:,,,/Icons/IsForcedDispVisible.png" SizeDefinition="Small, Small, Small"/>
                    <!-- ダイアグラムスケール（変位）は右端「テキスト・ダイアグラムスケール」グループに統合済み -->
                </Fluent:RibbonGroupBox>

                <!-- 群杭沈下ビュー -->
                <Fluent:RibbonGroupBox Header="群杭沈下" ToolTip="群杭沈下" Icon="pack://application:,,,/Icons/IsSettlementGridVisible.png">
                    <Fluent:ToggleButton Header="群杭沈下グリッド" ToolTip="群杭沈下グリッド表示"
                               IsChecked="{Binding IsGroupPileGridVisible}"
                               Icon="pack://application:,,,/Icons/IsSettlementGridVisible.png" SizeDefinition="Small, Small, Small"/>
                    <Fluent:ToggleButton Header="群杭沈下土層" ToolTip="群杭沈下用土層表示（水平視）"
                               IsChecked="{Binding IsSettlementGroundVisible}"
                               Icon="pack://application:,,,/Icons/SoilLayerVisible.png" SizeDefinition="Small, Small, Small"/>
                    <Fluent:ToggleButton Header="群杭沈下荷重面" ToolTip="群杭沈下用荷重面表示"
                               IsChecked="{Binding IsSettlementLoadVisible}"
                               Icon="pack://application:,,,/Icons/LoadingPlaneVisible.png" SizeDefinition="Small, Small, Small"/>
                </Fluent:RibbonGroupBox>

                <!-- XYZ平行軸グループは目盛・通り心に統合済み -->

                <!-- 選択・表示 (Small icons のみ) -->
                <Fluent:RibbonGroupBox Header="選択・表示" ToolTip="選択・表示" Icon="pack://application:,,,/Icons/ActiveAll.png">
                    <Fluent:Button ToolTip="すべて選択 (Ctrl + A)"
                             Click="SelectAllNodesButton_Click"
                             Icon="pack://application:,,,/Icons/SelectAll.png" SizeDefinition="Small, Small, Small"/>
                    <Fluent:Button ToolTip="全選択解除 (Esc)"
                             Click="DeselectAllNodesButton_Click"
                             Icon="pack://application:,,,/Icons/DeselectAll.png" SizeDefinition="Small, Small, Small"/>
                    <Separator/>
                    <Fluent:Button ToolTip="すべてアクティブ (Ctrl + Shift + A)"
                             Click="ShowAllNodesButton_Click"
                             Icon="pack://application:,,,/Icons/ActiveAll.png" SizeDefinition="Small, Small, Small"/>
                    <Fluent:Button ToolTip="選択のみアクティブ (F2)"
                             Click="ShowSelectedNodesButton_Click"
                             Icon="pack://application:,,,/Icons/SelectedActive.png" SizeDefinition="Small, Small, Small"/>
                    <Fluent:Button ToolTip="選択を非アクティブ (Shift + F2)"
                             Click="ShowUnselectedNodesButton_Click"
                             Icon="pack://application:,,,/Icons/SelectedInactive.png" SizeDefinition="Small, Small, Small"/>
                    <Fluent:Button ToolTip="アクティブ反転"
                             Click="InvertActiveNodesButton_click"
                             Icon="pack://application:,,,/Icons/InvertActive.png" SizeDefinition="Small, Small, Small"/>
                </Fluent:RibbonGroupBox>


                <!-- ビュー切替 (Small icons のみ) -->
                <Fluent:RibbonGroupBox Header="ビュー切替" ToolTip="ビュー切替" Icon="pack://application:,,,/Icons/ZoomFit.png">
                    <Fluent:Button Header="ズームフィット" Command="{Binding ZoomFitCommand}"
                                         Icon="pack://application:,,,/Icons/ZoomFit.png"
                                         ToolTip="ズームフィット (ctrl + 0)" SizeDefinition="Small, Small, Small"/>
                    <Fluent:Button Header="平面" Command="{Binding ViewXYPlaneCommand}"
                                         Icon="pack://application:,,,/Icons/TopView.png"
                                         ToolTip="平面 (Ctrl + Shift + T)" SizeDefinition="Small, Small, Small"/>
                    <Fluent:Button Header="正面" Command="{Binding ViewXZPlaneCommand}"
                                         Icon="pack://application:,,,/Icons/FrontView.png"
                                         ToolTip="正面 (Ctrl + Shift + F)" SizeDefinition="Small, Small, Small"/>
                    <Fluent:Button Header="右面" Command="{Binding ViewYZPlaneCommand}"
                                         Icon="pack://application:,,,/Icons/RightView.png"
                                         ToolTip="右面 (Ctrl + Shift + R)" SizeDefinition="Small, Small, Small"/>
                    <Fluent:Button Header="アイソメ" Command="{Binding ViewIsometricCommand}"
                                         Icon="pack://application:,,,/Icons/IsometricView.png"
                                         ToolTip="アイソメ (Ctrl + Shift + I)" SizeDefinition="Small, Small, Small"/>
                </Fluent:RibbonGroupBox>


                <!-- 値表示・ダイアグラムスケール・テキスト 統合グループ（右端、解析結果タブと同じ） -->
                <Fluent:RibbonGroupBox Header="テキスト・値表示"
                                    ToolTip="テキスト・値表示"
                                    LargeIcon="pack://application:,,,/Icons/LabelSize.png"
                                    Icon="pack://application:,,,/Icons/LabelSize.png">
                    <StackPanel Orientation="Horizontal">
                        <!-- ===== 1 列目: テキストサイズ / 位置 / 小数桁 ===== -->
                        <StackPanel Orientation="Vertical" Margin="0,0,10,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="pack://application:,,,/Icons/LabelSize.png"
                                       Width="16" Height="16" Margin="0,0,12,0"
                                       VerticalAlignment="Center"
                                       ToolTip="テキストサイズ"/>
                                <ComboBox Width="70"
                                          ItemsSource="{Binding LabelSizeOption}"
                                          SelectedItem="{Binding LabelSize}"
                                          ToolTip="テキストサイズ">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="SelectionChanged">
                                            <i:InvokeCommandAction Command="{Binding ComboBox3DLabelSize_OnSelectionChangedCommand}"/>
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" IsEnabled="{Binding IsResultValueVisible}">
                                <Image Source="pack://application:,,,/Icons/AdjustTextPositions.png"
                                       Width="16" Height="16" Margin="0,0,12,0"
                                       VerticalAlignment="Center"
                                       ToolTip="位置調整"/>
                                <Slider Width="70" Minimum="0" Maximum="20"
                                    Value="{Binding TextPositionAdjuster, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Width="35" HorizontalContentAlignment="Right" Margin="4,0,0,0"
                                     Text="{Binding TextPositionAdjuster, StringFormat=N1, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                     KeyDown="TextBox_KeyDown"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" IsEnabled="{Binding IsResultValueVisible}">
                                <Image Source="pack://application:,,,/Icons/DecimalPoint.png"
                                       Width="16" Height="16" Margin="0,0,12,0"
                                       VerticalAlignment="Center"
                                       ToolTip="小数桁数"/>
                                <Slider Width="70" Minimum="0" Maximum="5"
                                    Value="{Binding DecimalPlaces, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Width="35" HorizontalContentAlignment="Right" Margin="4,0,0,0"
                                     Text="{Binding DecimalPlaces, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                     KeyDown="TextBox_KeyDown"/>
                            </StackPanel>
                        </StackPanel>

                        <Separator Margin="0,2" Background="#DDD" Width="1" HorizontalAlignment="Center"/>

                        <!-- ===== 2 列目: 値表示チェック群 / 上面図モードチェック群 (最大 2 行) ===== -->
                        <StackPanel Orientation="Vertical" Margin="10,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Content="値表示" IsChecked="{Binding IsResultValueVisible}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox Width="105"
                                          ItemsSource="{Binding ResultValueDisplayModeOptions}"
                                          SelectedItem="{Binding SelectedResultValueDisplayMode}"
                                          IsEnabled="{Binding IsResultValueVisible}"
                                          ToolTip="表示する値の範囲: 全表示 / 要素中間のみ / 杭頭のみ / 各杭MaxMinのみ"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Image Source="pack://application:,,,/Icons/LoadForceScale.png"
                                       Width="14" Height="14" Margin="0,0,4,0"
                                       VerticalAlignment="Center"
                                       ToolTip="応力表示"/>
                                <CheckBox Content="杭"
                                          IsChecked="{Binding IsPileStressVisible}"
                                          ToolTip="杭体・RigidLink の応力ダイアグラムを表示。OFF で非表示 (上面図モードと併用で基礎梁応力だけが見える)。"
                                          Margin="0,0,6,0"/>
                                <CheckBox Content="基礎梁"
                                          IsChecked="{Binding IsFoundationBeamStressVisible}"
                                          ToolTip="基礎梁の応力ダイアグラムを表示。OFF で非表示。"
                                          Margin="0,0,4,0"/>
                                <CheckBox Content="水平"
                                          IsChecked="{Binding IsFoundationBeamStressRotatedToHorizontal}"
                                          ToolTip="基礎梁の鉛直方向成分 (My/Qz など) を梁軸まわりに 90° 回転して水平面に表示。上面図 (+Z) で確認しやすくなります。"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Image Source="pack://application:,,,/Icons/DisplacementScale.png"
                                       Width="14" Height="14" Margin="0,0,4,0"
                                       VerticalAlignment="Center"
                                       ToolTip="変位表示"/>
                                <CheckBox Content="杭"
                                          IsChecked="{Binding IsPileDisplacementVisible}"
                                          ToolTip="杭体・RigidLink・根入れ部の変位ダイアグラムを表示。OFF で非表示。"
                                          Margin="0,0,6,0"/>
                                <CheckBox Content="基礎梁"
                                          IsChecked="{Binding IsFoundationBeamDisplacementVisible}"
                                          ToolTip="基礎梁の変位ダイアグラムを表示。OFF で非表示。"/>
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>
                </Fluent:RibbonGroupBox>

                <!-- ダイアグラムスケール（応力 / 変位） -->
                <Fluent:RibbonGroupBox Header="ダイアグラムスケール"
                                    ToolTip="ダイアグラムスケール"
                                    LargeIcon="pack://application:,,,/Icons/LoadForceScale.png"
                                    Icon="pack://application:,,,/Icons/LoadForceScale.png">
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Icons/LoadForceScale.png"
                                   Width="16" Height="16" Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   ToolTip="ダイアグラムスケール（応力）"/>
                            <Slider Width="70" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                    TickFrequency="0.1" IsSnapToTickEnabled="False"
                                    Value="{Binding ForceDiagramRatio}"
                                    ToolTip="モデル範囲に対する最大ダイアグラム長の比率"/>
                            <TextBox Text="{Binding ForceDiagramRatio, StringFormat=N2, UpdateSourceTrigger=LostFocus}"
                                     VerticalAlignment="Center" Width="35" Margin="4,0,0,0" HorizontalContentAlignment="Right"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                Visibility="{Binding IsDisplacementDiagramRatioApplicable, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Image Source="pack://application:,,,/Icons/DisplacementScale.png"
                                   Width="16" Height="16" Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   ToolTip="ダイアグラムスケール（変位）"/>
                            <Slider Width="70" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                    TickFrequency="0.1" IsSnapToTickEnabled="False"
                                    Value="{Binding DisplacementDiagramRatio}"
                                    ToolTip="モデル範囲に対する最大変位ダイアグラム長の比率"/>
                            <TextBox Text="{Binding DisplacementDiagramRatio, StringFormat=N2, UpdateSourceTrigger=LostFocus}"
                                     VerticalAlignment="Center" Width="35" Margin="4,0,0,0" HorizontalContentAlignment="Right"/>
                        </StackPanel>
                    </StackPanel>
                </Fluent:RibbonGroupBox>

            </Fluent:RibbonTabItem>

            <Fluent:RibbonTabItem Header="解析条件/解析(S)" KeyTip="S">
                <Fluent:RibbonGroupBox Header="解析条件設定" ToolTip="解析条件設定">
                    <!-- ツールチップの Step 番号はヘルプ「クイックスタートガイド」に合わせる。
                         リボン・クイックヒント・ヘルプで手順が食い違わないようにするため。 -->
                    <Fluent:Button x:Name="ButtonFundamental"
                         Header="基本 設定"
                         ToolTip="基本設定 (Ctrl+E)&#x0A;Z=0 の標高や材料モデルなど、プロジェクト全体に効く設定です。"
                         Command="{Binding OpenFundamentalWindowCommand}"
                         LargeIcon="pack://application:,,,/Icons/FundamentalWindow.png"
                         Icon="pack://application:,,,/Icons/FundamentalWindow.png"/>

                    <Fluent:Button x:Name="RibbonButtonLoadCase"
                         Header="荷重"
                         ToolTip="Step 2: 荷重条件の設定&#x0A;地震時に建物から杭基礎に伝わる慣性力の大きさと作用位置を決めます。"
                         Command="{Binding OpenLoadCaseWindowCommand}"
                         LargeIcon="pack://application:,,,/Icons/LoadCaseWindow.png"
                         Icon="pack://application:,,,/Icons/LoadCaseWindow.png"/>

                    <Fluent:Button x:Name="RibbonButtonGround"
                         Header="地盤"
                         ToolTip="Step 3: 地盤条件の設定&#x0A;土層・N 値・地盤変位など、杭を支える地盤側の条件を決めます。"
                         PreviewMouseDown="ButtonGround_PreviewMouseDown"
                         Command="{Binding OpenGroundWindowCommand}"
                         LargeIcon="pack://application:,,,/Icons/GroundWindow.png"
                         Icon="pack://application:,,,/Icons/GroundWindow.png"/>

                    <Fluent:Button x:Name="RibbonButtonPileBody"
                         Header="杭体"
                         ToolTip="Step 4: 杭体の設定&#x0A;杭種・杭径・区間ごとの断面を決めます。"
                         PreviewMouseDown="ButtonPileBody_PreviewMouseDown"
                         Command="{Binding OpenPileBodyWindowCommand}"
                         LargeIcon="pack://application:,,,/Icons/PileBodyWindow.png"
                         Icon="pack://application:,,,/Icons/PileBodyWindow.png"/>

                    <Fluent:Button x:Name="RibbonButtonAxialForceCheck"
                         Header="軸力 確認"
                         ToolTip="Step 6 の確認: 杭軸力&#x0A;「杭」→「軸力」タブで入力した各杭の軸力を一覧で見直します。"
                         PreviewMouseDown="ButtonPileBody_PreviewMouseDown"
                         Command="{Binding AxialForceCheckCommand}"
                         LargeIcon="pack://application:,,,/Icons/AxialForceVeirification.png"
                         Icon="pack://application:,,,/Icons/AxialForceVeirification.png"/>

                    <Fluent:Button x:Name="RibbonButtonExecuteAnalyse"
                             ToolTip="Step 7: 杭要素分割 (F4)&#x0A;杭を解析用の要素に分け、地盤ばねを割り当てます。水平解析と沈下解析の前提です。"
                             Command="{Binding OpenElementDivisionWindowCommand}">
                        <Fluent:Button.Style>
                            <Style TargetType="Fluent:Button">
                                <!-- 未分割時（既定） -->
                                <Setter Property="Header" Value="杭要素&#x0A;分割"/>
                                <Setter Property="LargeIcon" Value="pack://application:,,,/Icons/ElementDivisionWindow.png"/>
                                <Setter Property="Icon" Value="pack://application:,,,/Icons/ElementDivisionWindow.png"/>
                                <Style.Triggers>
                                    <!-- 分割済み時に差し替え (他の解析ボタンと同じ ✓ フォーマット) -->
                                    <DataTrigger Binding="{Binding IsElementSplit}" Value="True">
                                        <Setter Property="Header" Value="杭要素&#x0A;分割 ✓"/>
                                        <Setter Property="Foreground" Value="{StaticResource NikkenSkyBlueBrush}"/>
                                        <Setter Property="LargeIcon" Value="pack://application:,,,/Icons/ElementDivisionWindowDone.png"/>
                                        <Setter Property="Icon" Value="pack://application:,,,/Icons/ElementDivisionWindowDone.png"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Fluent:Button.Style>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>

                <Fluent:RibbonGroupBox Header="水平解析" ToolTip="水平解析">
                    <!-- 有効/無効はコマンドの CanExecute (杭要素分割済みか) に任せる。
                         IsEnabled を別途書くと、ボタンとキーボードで条件が二重管理になる。 -->
                    <Fluent:Button x:Name="RibbonButtonLateralLoadAnalysisSettlement"
                         ToolTip="Step 8: 水平解析の実行 (F5)&#x0A;杭要素分割が済んでいると押せます。"
                         Command="{Binding OpenLateralLoadAnalysisWindowCommand}">
                        <Fluent:Button.Style>
                            <Style TargetType="Fluent:Button">
                                <Setter Property="Header" Value="水平解析"/>
                                <Setter Property="LargeIcon" Value="pack://application:,,,/Icons/LateralLoadAnalysisWindow.png"/>
                                <Setter Property="Icon" Value="pack://application:,,,/Icons/LateralLoadAnalysisWindow.png"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHorizontalAnalysisDone}" Value="True">
                                        <Setter Property="Header" Value="水平解析 ✓"/>
                                        <Setter Property="Foreground" Value="{StaticResource StatusSuccessBrush}"/>
                                        <Setter Property="LargeIcon" Value="pack://application:,,,/Icons/LateralLoadAnalysisWindowDone.png"/>
                                        <Setter Property="Icon" Value="pack://application:,,,/Icons/LateralLoadAnalysisWindowDone.png"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Fluent:Button.Style>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>

                <Fluent:RibbonGroupBox Header="単杭沈下解析" ToolTip="単杭沈下解析">
                    <Fluent:Button x:Name="RibbonButtonSettlement"
                         PreviewMouseDown="ButtonButtonSettlement_PreviewMouseDown"
                         Command="{Binding OpenSettlementWindowCommand}"
                         ToolTip="各杭の荷重-沈下関係を計算します。杭要素分割が前提です。">
                        <Fluent:Button.Style>
                            <Style TargetType="Fluent:Button">
                                <Setter Property="Header" Value="単杭沈下&#x0A;解析"/>
                                <Setter Property="LargeIcon" Value="pack://application:,,,/Icons/SettlementWindow.png"/>
                                <Setter Property="Icon" Value="pack://application:,,,/Icons/SettlementWindow.png"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVerticalAnalysisDone}" Value="True">
                                        <Setter Property="Header" Value="単杭沈下&#x0A;解析 ✓"/>
                                        <Setter Property="Foreground" Value="{StaticResource StatusInfoBrush}"/>
                                        <Setter Property="LargeIcon" Value="pack://application:,,,/Icons/SettlementWindowDone.png"/>
                                        <Setter Property="Icon" Value="pack://application:,,,/Icons/SettlementWindowDone.png"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Fluent:Button.Style>
                    </Fluent:Button>

                    <Fluent:Button x:Name="RibbonButtonVerticalBeamCalculation"
                         Command="{Binding OpenVerticalBeamCalculationCommand}"
                         ToolTipService.ShowOnDisabled="True"
                         ToolTip="基礎梁の剛性を考慮した単杭沈下解析です。基礎梁を含むモデルで単杭沈下解析を実行したときに押下可能となります。">
                        <Fluent:Button.Style>
                            <Style TargetType="Fluent:Button">
                                <Setter Property="Header" Value="単杭沈下解析&#x0A;（基礎梁考慮）"/>
                                <Setter Property="LargeIcon" Value="pack://application:,,,/Icons/SettlementWithBeamWindow.png"/>
                                <Setter Property="Icon" Value="pack://application:,,,/Icons/SettlementWithBeamWindow.png"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVerticalBeamAnalysisDone}" Value="True">
                                        <Setter Property="Header" Value="単杭沈下解析&#x0A;（基礎梁考慮） ✓"/>
                                        <Setter Property="Foreground" Value="{StaticResource StatusInfoBrush}"/>
                                        <Setter Property="LargeIcon" Value="pack://application:,,,/Icons/SettlementWithBeamWindowDone.png"/>
                                        <Setter Property="Icon" Value="pack://application:,,,/Icons/SettlementWithBeamWindowDone.png"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Fluent:Button.Style>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>

                <Fluent:RibbonGroupBox Header="群杭沈下解析" ToolTip="群杭沈下解析">
                    <Fluent:Button x:Name="RibbonButtonGroupPileSettlement"
                     Click="ButtonGroupPileSettlement_Click"
                     ToolTip="スタインブレナー近似式による即時沈下量を計算します。群杭沈下タブで荷重面・土層を設定してください。">
                        <Fluent:Button.Style>
                            <Style TargetType="Fluent:Button">
                                <Setter Property="Header" Value="群杭沈下&#x0A;解析（一般）"/>
                                <Setter Property="LargeIcon" Value="pack://application:,,,/Icons/GroupPileSettlement.png"/>
                                <Setter Property="Icon" Value="pack://application:,,,/Icons/GroupPileSettlement.png"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGroupPileSettlementAnalysisDone}" Value="True">
                                        <Setter Property="Header" Value="群杭沈下&#x0A;解析（一般） ✓"/>
                                        <Setter Property="Foreground" Value="{StaticResource StatusWarningDarkBrush}"/>
                                        <Setter Property="LargeIcon" Value="pack://application:,,,/Icons/GroupPileSettlementDone.png"/>
                                        <Setter Property="Icon" Value="pack://application:,,,/Icons/GroupPileSettlementDone.png"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Fluent:Button.Style>
                    </Fluent:Button>

                    <Fluent:Button x:Name="RibbonButtonGroupPileSettlementWithBeam"
                                   Command="{Binding OpenGroupSettlementWithBeamWindowCommand}"
                                   ToolTipService.ShowOnDisabled="True"
                                   ToolTip="基礎梁の剛性を考慮して、矩形荷重 (個別矩形) を反復で再分配しながらスタインブレナー沈下を解く解析です。基礎梁が定義されているモデルで実行可能となります。">
                        <Fluent:Button.Style>
                            <Style TargetType="Fluent:Button">
                                <Setter Property="Header" Value="群杭沈下&#x0A;解析（反復）"/>
                                <Setter Property="LargeIcon" Value="pack://application:,,,/Icons/GroupPileSettlementWithBeamWindow.png"/>
                                <Setter Property="Icon" Value="pack://application:,,,/Icons/GroupPileSettlementWithBeamWindow.png"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasGroupSettlementBeamAwareCases}" Value="True">
                                        <Setter Property="Header" Value="群杭沈下&#x0A;解析（反復） ✓"/>
                                        <Setter Property="Foreground" Value="{StaticResource StatusWarningDarkBrush}"/>
                                        <Setter Property="LargeIcon" Value="pack://application:,,,/Icons/GroupPileSettlementWithBeamWindowDone.png"/>
                                        <Setter Property="Icon" Value="pack://application:,,,/Icons/GroupPileSettlementWithBeamWindowDone.png"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Fluent:Button.Style>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>


            </Fluent:RibbonTabItem>

            <Fluent:RibbonTabItem x:Name="AnalysisResultRibbonTab" Header="解析結果(R)" KeyTip="R">
                <Fluent:RibbonGroupBox Header="解析結果表示" ToolTip="解析結果表示">
                    <Fluent:ToggleButton Header="杭・梁 要素"
                        ToolTip="杭・梁要素の解析結果表示/非表示"
                        IsChecked="{Binding IsAnalysisResultVisible}"
                        IsEnabled="{Binding HasAnyAnalysisResult}"
                        LargeIcon="pack://application:,,,/Icons/AnalysisResult.png"
                        Icon="pack://application:,,,/Icons/AnalysisResult.png"/>

                    <Fluent:ComboBox Header="内容" Width="100"
                          SelectedItem="{Binding AnalysisResultContent}"
                             Visibility="{Binding IsAnalysisResultVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Fluent:ComboBox.Resources>
                            <!-- カテゴリ（沈下解析結果／水平解析結果）でグループ化 -->
                            <CollectionViewSource x:Key="GroupedAnalysisContents"
                                                  Source="{Binding AnalysisResultContentOption}">
                                <CollectionViewSource.GroupDescriptions>
                                    <PropertyGroupDescription Converter="{StaticResource AnalysisContentCategoryConverter}"/>
                                </CollectionViewSource.GroupDescriptions>
                            </CollectionViewSource>
                        </Fluent:ComboBox.Resources>
                        <Fluent:ComboBox.ItemsSource>
                            <Binding Source="{StaticResource GroupedAnalysisContents}"/>
                        </Fluent:ComboBox.ItemsSource>
                        <Fluent:ComboBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource PrimaryAccentDarkBrush}" Padding="6,3">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </Fluent:ComboBox.GroupStyle>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding ComboBox3DAnalysisResultContent_OnSelectionChangedCommand}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </Fluent:ComboBox>

                    <!-- 沈下種別 -->
                    <Fluent:ComboBox Header="沈下種別" Width="100"
                          ItemsSource="{Binding AnalysisResultSettlementOption}"
                          SelectedItem="{Binding AnalysisResultSettlementType}">
                        <Fluent:ComboBox.Style>
                            <Style TargetType="ComboBox">
                                <!-- 既定は非表示 -->
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsAnalysisResultVisible}" Value="True"/>
                                            <Condition Binding="{Binding AnalysisResultContent}" Value="沈下量"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsAnalysisResultVisible}" Value="True"/>
                                            <Condition Binding="{Binding AnalysisResultContent}" Value="沈下部材角"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsAnalysisResultVisible}" Value="True"/>
                                            <Condition Binding="{Binding AnalysisResultContent}" Value="沈下反力"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsAnalysisResultVisible}" Value="True"/>
                                            <Condition Binding="{Binding AnalysisResultContent}" Value="沈下応力"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Fluent:ComboBox.Style>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding ComboBox3DAnalysisResultContent_OnSelectionChangedCommand}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </Fluent:ComboBox>

                    <!-- 梁応力 / 沈下応力 -->
                    <Fluent:ComboBox Header="梁応力" Width="100"
                          ItemsSource="{Binding AnalysisResultBeamForceOption}"
                          SelectedItem="{Binding AnalysisResultBeamForceType}"
                          ItemContainerStyle="{StaticResource ResultSymbolItemStyle}">
                        <Fluent:ComboBox.Style>
                            <Style TargetType="ComboBox">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsAnalysisResultVisible}" Value="True"/>
                                            <Condition Binding="{Binding AnalysisResultContent}" Value="梁応力（水平）"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsAnalysisResultVisible}" Value="True"/>
                                            <Condition Binding="{Binding AnalysisResultContent}" Value="沈下応力"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Fluent:ComboBox.Style>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding ComboBox3DAnalysisResultContent_OnSelectionChangedCommand}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </Fluent:ComboBox>

                    <!-- 節点変位 -->
                    <Fluent:ComboBox Header="節点変位" Width="100"
                          ItemsSource="{Binding AnalysisResultNodeDisplacementOption}"
                          SelectedItem="{Binding AnalysisResultNodeDisplacementType}"
                          ItemContainerStyle="{StaticResource ResultSymbolItemStyle}">
                        <Fluent:ComboBox.Style>
                            <Style TargetType="ComboBox">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsAnalysisResultVisible}" Value="True"/>
                                            <Condition Binding="{Binding AnalysisResultContent}" Value="節点変位（水平）"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Fluent:ComboBox.Style>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding ComboBox3DAnalysisResultContent_OnSelectionChangedCommand}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </Fluent:ComboBox>

                    <!-- 地盤反力 -->
                    <Fluent:ComboBox Header="地盤反力" Width="100"
                          ItemsSource="{Binding AnalysisResultSoilSpringOption}"
                          SelectedItem="{Binding AnalysisResultSoilSpringType}"
                          ItemContainerStyle="{StaticResource ResultSymbolItemStyle}">
                        <Fluent:ComboBox.Style>
                            <Style TargetType="ComboBox">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsAnalysisResultVisible}" Value="True"/>
                                            <Condition Binding="{Binding AnalysisResultContent}" Value="地盤反力（水平）"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsAnalysisResultVisible}" Value="True"/>
                                            <Condition Binding="{Binding AnalysisResultContent}" Value="地盤反力（分布）"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Fluent:ComboBox.Style>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding ComboBox3DAnalysisResultContent_OnSelectionChangedCommand}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </Fluent:ComboBox>
                    <Fluent:ToggleButton Header="群杭グリッド 変位"
                               ToolTip="群杭グリッド変位表示"
                               IsChecked="{Binding IsGroupPileGridDeformationVisible}"
                               IsEnabled="{Binding HasGroupSettlementCaseRecords}"
                               LargeIcon="pack://application:,,,/Icons/GroupPileContorVisible.png"
                               Icon="pack://application:,,,/Icons/GroupPileContorVisible.png"/>
                </Fluent:RibbonGroupBox>
                
                <Fluent:RibbonGroupBox Header="バブル" ToolTip="バブル">
                    <Fluent:SplitButton Header="バブル 表示" IsCheckable="True"
                                              IsChecked="{Binding IsBubbleVisible}"
                                              LargeIcon="pack://application:,,,/Icons/BubbleVisible.png"
                                              Icon="pack://application:,,,/Icons/BubbleVisible.png">
                        <Fluent:SplitButton.IsEnabled>
                            <MultiBinding Converter="{StaticResource AnyBoolConverter}">
                                <Binding Path="IsVerticalAnalysisDone"/>
                                <Binding Path="IsGroupPileSettlementAnalysisDone"/>
                                <Binding Path="IsHorizontalAnalysisDone"/>
                            </MultiBinding>
                        </Fluent:SplitButton.IsEnabled>
                        <Fluent:SplitButton.ToolTip>
                            <Fluent:ScreenTip Title="バブル表示"
                                              Text="解析結果の表示時に、各位置に値に比例した円（バブル）をカラーコードで描画します。&#x0a;・沈下解析: 各杭位置に沈下量バブル&#x0a;・水平解析の地盤反力 (RZ など): 各杭節点に反力バブル&#x0a;ビュー方向に依存せず真円で表示されるため、3D ビューでも読み取りやすいです。"/>
                        </Fluent:SplitButton.ToolTip>
                        <StackPanel Orientation="Horizontal" Margin="4">
                            <TextBlock Text="径" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <Slider Width="100" Minimum="0" Maximum="200"
                                Value="{Binding BubbleDia, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Width="35" HorizontalContentAlignment="Right"
                                 Text="{Binding BubbleDia, StringFormat=N0, UpdateSourceTrigger=LostFocus}"
                                 PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                 KeyDown="TextBox_KeyDown"/>
                        </StackPanel>
                    </Fluent:SplitButton>
                </Fluent:RibbonGroupBox>


                <Fluent:RibbonGroupBox Header="矢印" ToolTip="矢印">
                    <Fluent:SplitButton Header="矢印 表示" IsCheckable="True"
                                              IsChecked="{Binding IsArrowVisible}"
                                              LargeIcon="pack://application:,,,/Icons/ArrowVisible.png"
                                              Icon="pack://application:,,,/Icons/ArrowVisible.png">
                        <Fluent:SplitButton.IsEnabled>
                            <MultiBinding Converter="{StaticResource AnyBoolConverter}">
                                <Binding Path="IsVerticalAnalysisDone"/>
                                <Binding Path="IsGroupPileSettlementAnalysisDone"/>
                            </MultiBinding>
                        </Fluent:SplitButton.IsEnabled>
                        <Fluent:SplitButton.ToolTip>
                            <Fluent:ScreenTip Title="矢印表示"
                                              Text="沈下解析結果の表示時に、各杭位置に沈下量に比例した矢印をカラーコードで描画します。立面ビューでの表示に適しています。"/>
                        </Fluent:SplitButton.ToolTip>
                        <StackPanel Margin="4">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="全長" VerticalAlignment="Center" Margin="0,0,4,0" Width="28"/>
                                <Slider Width="100" Minimum="0" Maximum="200"
                                    Value="{Binding ArrowLength, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Width="35" HorizontalContentAlignment="Right"
                                     Text="{Binding ArrowLength, StringFormat=N0, UpdateSourceTrigger=LostFocus}"
                                     PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                     KeyDown="TextBox_KeyDown"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="頭長" VerticalAlignment="Center" Margin="0,0,4,0" Width="28"/>
                                <Slider Width="100" Minimum="0" Maximum="50"
                                    Value="{Binding ArrowHeadLength, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Width="35" HorizontalContentAlignment="Right"
                                     Text="{Binding ArrowHeadLength, StringFormat=N0, UpdateSourceTrigger=LostFocus}"
                                     PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                     KeyDown="TextBox_KeyDown"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="頭径" VerticalAlignment="Center" Margin="0,0,4,0" Width="28"/>
                                <Slider Width="100" Minimum="0" Maximum="20"
                                    Value="{Binding ArrowHeadDia, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Width="35" HorizontalContentAlignment="Right"
                                     Text="{Binding ArrowHeadDia, StringFormat=N0, UpdateSourceTrigger=LostFocus}"
                                     PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                     KeyDown="TextBox_KeyDown"/>
                            </StackPanel>
                        </StackPanel>
                    </Fluent:SplitButton>
                </Fluent:RibbonGroupBox>

                <Fluent:RibbonGroupBox Header="変形後" ToolTip="変形後">
                    <Fluent:ToggleButton Header="変形後 形状"
                                   IsChecked="{Binding IsDeformedElementVisible}"
                                   LargeIcon="pack://application:,,,/Icons/DeformedElementVisible.png"
                                   Icon="pack://application:,,,/Icons/DeformedElementVisible.png"
                                   ToolTip="水平解析結果の変形後形状を描画します。&#x0a;杭体形状ONの場合は変形後の杭体断面も表示します。&#x0a;梁断面形状ONの場合は変形後の基礎梁断面も表示します。&#x0a;解析結果表示がOFFでも独立して動作します。">
                        <Fluent:ToggleButton.IsEnabled>
                            <MultiBinding Converter="{StaticResource AnyBoolConverter}">
                                <Binding Path="IsHorizontalAnalysisDone"/>
                                <Binding Path="IsVerticalAnalysisDone"/>
                                <Binding Path="IsGroupPileSettlementAnalysisDone"/>
                            </MultiBinding>
                        </Fluent:ToggleButton.IsEnabled>
                    </Fluent:ToggleButton>
                </Fluent:RibbonGroupBox>

                <Fluent:RibbonGroupBox Header="グラフ・テーブル" ToolTip="グラフ・テーブル">
                    <Fluent:Button Header="グラフ 出力"
                             ToolTip="杭変位応力グラフ・沈下曲線などの結果グラフウィンドウを開きます。"
                             Command="{Binding OpenGraphWindowCommand}"
                             LargeIcon="pack://application:,,,/Icons/Graph.png"
                             Icon="pack://application:,,,/Icons/Graph.png"/>
                    <Fluent:Button Header="テーブル 出力"
                             ToolTip="解析結果をテーブル形式で表示します。"
                             Command="{Binding OpenTableWindowCommand}"
                             LargeIcon="pack://application:,,,/Icons/Table.png"
                             Icon="pack://application:,,,/Icons/Table.png"/>
                </Fluent:RibbonGroupBox>

                <Fluent:RibbonGroupBox Header="ログ" ToolTip="ログ">
                    <Fluent:Button Header="ログ 表示"
                             ToolTip="解析ログウィンドウを開きます。"
                             Command="{Binding OpenLogWindowCommand}"
                             LargeIcon="pack://application:,,,/Icons/Log.png"
                             Icon="pack://application:,,,/Icons/Log.png"/>
                </Fluent:RibbonGroupBox>

                <Fluent:RibbonGroupBox Header="検定" ToolTip="検定">
                    <Fluent:Button Header="検定"
                             ToolTip="解析結果の検定ウィンドウを開きます。"
                             Command="{Binding OpenEvaluationWindowCommand}"
                             LargeIcon="pack://application:,,,/Icons/Check.png"
                             Icon="pack://application:,,,/Icons/Check.png"/>
                </Fluent:RibbonGroupBox>

                <!-- 値表示・テキスト 統合グループ（右端、ダイアグラムスケールは別出） -->
                <Fluent:RibbonGroupBox Header="テキスト・値表示"
                                    ToolTip="テキスト・値表示"
                                    LargeIcon="pack://application:,,,/Icons/LabelSize.png"
                                    Icon="pack://application:,,,/Icons/LabelSize.png">
                    <StackPanel Orientation="Horizontal">
                        <!-- ===== 1 列目: テキストサイズ / 位置 / 小数桁 ===== -->
                        <StackPanel Orientation="Vertical" Margin="0,0,10,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="pack://application:,,,/Icons/LabelSize.png"
                                       Width="16" Height="16" Margin="0,0,12,0"
                                       VerticalAlignment="Center"
                                       ToolTip="テキストサイズ"/>
                                <ComboBox Width="70"
                                          ItemsSource="{Binding LabelSizeOption}"
                                          SelectedItem="{Binding LabelSize}"
                                          ToolTip="テキストサイズ">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="SelectionChanged">
                                            <i:InvokeCommandAction Command="{Binding ComboBox3DLabelSize_OnSelectionChangedCommand}"/>
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" IsEnabled="{Binding IsResultValueVisible}">
                                <Image Source="pack://application:,,,/Icons/AdjustTextPositions.png"
                                       Width="16" Height="16" Margin="0,0,12,0"
                                       VerticalAlignment="Center"
                                       ToolTip="位置調整"/>
                                <Slider Width="70" Minimum="0" Maximum="20"
                                    Value="{Binding TextPositionAdjuster, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Width="35" HorizontalContentAlignment="Right" Margin="4,0,0,0"
                                     Text="{Binding TextPositionAdjuster, StringFormat=N1, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                     KeyDown="TextBox_KeyDown"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" IsEnabled="{Binding IsResultValueVisible}">
                                <Image Source="pack://application:,,,/Icons/DecimalPoint.png"
                                       Width="16" Height="16" Margin="0,0,12,0"
                                       VerticalAlignment="Center"
                                       ToolTip="小数桁数"/>
                                <Slider Width="70" Minimum="0" Maximum="5"
                                    Value="{Binding DecimalPlaces, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Width="35" HorizontalContentAlignment="Right" Margin="4,0,0,0"
                                     Text="{Binding DecimalPlaces, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                     KeyDown="TextBox_KeyDown"/>
                            </StackPanel>
                        </StackPanel>

                        <Separator Margin="0,2" Background="#DDD" Width="1" HorizontalAlignment="Center"/>

                        <!-- ===== 2 列目: 値表示チェック群 / 上面図モードチェック群 (最大 2 行) ===== -->
                        <StackPanel Orientation="Vertical" Margin="10,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Content="値表示" IsChecked="{Binding IsResultValueVisible}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox Width="105"
                                          ItemsSource="{Binding ResultValueDisplayModeOptions}"
                                          SelectedItem="{Binding SelectedResultValueDisplayMode}"
                                          IsEnabled="{Binding IsResultValueVisible}"
                                          ToolTip="表示する値の範囲: 全表示 / 要素中間のみ / 杭頭のみ / 各杭MaxMinのみ"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Image Source="pack://application:,,,/Icons/LoadForceScale.png"
                                       Width="14" Height="14" Margin="0,0,4,0"
                                       VerticalAlignment="Center"
                                       ToolTip="応力表示"/>
                                <CheckBox Content="杭"
                                          IsChecked="{Binding IsPileStressVisible}"
                                          ToolTip="杭体・RigidLink の応力ダイアグラムを表示。OFF で非表示 (上面図モードと併用で基礎梁応力だけが見える)。"
                                          Margin="0,0,6,0"/>
                                <CheckBox Content="基礎梁"
                                          IsChecked="{Binding IsFoundationBeamStressVisible}"
                                          ToolTip="基礎梁の応力ダイアグラムを表示。OFF で非表示。"
                                          Margin="0,0,4,0"/>
                                <CheckBox Content="水平"
                                          IsChecked="{Binding IsFoundationBeamStressRotatedToHorizontal}"
                                          ToolTip="基礎梁の鉛直方向成分 (My/Qz など) を梁軸まわりに 90° 回転して水平面に表示。上面図 (+Z) で確認しやすくなります。"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Image Source="pack://application:,,,/Icons/DisplacementScale.png"
                                       Width="14" Height="14" Margin="0,0,4,0"
                                       VerticalAlignment="Center"
                                       ToolTip="変位表示"/>
                                <CheckBox Content="杭"
                                          IsChecked="{Binding IsPileDisplacementVisible}"
                                          ToolTip="杭体・RigidLink・根入れ部の変位ダイアグラムを表示。OFF で非表示。"
                                          Margin="0,0,6,0"/>
                                <CheckBox Content="基礎梁"
                                          IsChecked="{Binding IsFoundationBeamDisplacementVisible}"
                                          ToolTip="基礎梁の変位ダイアグラムを表示。OFF で非表示。"/>
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>
                </Fluent:RibbonGroupBox>

                <!-- ダイアグラムスケール（応力 / 変位） -->
                <Fluent:RibbonGroupBox Header="ダイアグラムスケール"
                                    ToolTip="ダイアグラムスケール"
                                    LargeIcon="pack://application:,,,/Icons/LoadForceScale.png"
                                    Icon="pack://application:,,,/Icons/LoadForceScale.png">
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Icons/LoadForceScale.png"
                                   Width="16" Height="16" Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   ToolTip="ダイアグラムスケール（応力）"/>
                            <Slider Width="70" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                    TickFrequency="0.1" IsSnapToTickEnabled="False"
                                    Value="{Binding ForceDiagramRatio}"
                                    ToolTip="モデル範囲に対する最大ダイアグラム長の比率"/>
                            <TextBox Text="{Binding ForceDiagramRatio, StringFormat=N2, UpdateSourceTrigger=LostFocus}"
                                     VerticalAlignment="Center" Width="35" Margin="4,0,0,0" HorizontalContentAlignment="Right"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                Visibility="{Binding IsDisplacementDiagramRatioApplicable, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Image Source="pack://application:,,,/Icons/DisplacementScale.png"
                                   Width="16" Height="16" Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   ToolTip="ダイアグラムスケール（変位）"/>
                            <Slider Width="70" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                    TickFrequency="0.1" IsSnapToTickEnabled="False"
                                    Value="{Binding DisplacementDiagramRatio}"
