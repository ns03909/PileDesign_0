<Fluent:RibbonWindow x:Class="PileDesign.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PileDesign.ViewModels"
        xmlns:conv="clr-namespace:PileDesign.Converters"
        xmlns:h="clr-namespace:HelixToolkit.Wpf;assembly=HelixToolkit.Wpf"
        xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:linq="clr-namespace:System.Linq;assembly=System.Core"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:svg="http://sharpvectors.codeplex.com/runtime/"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        xmlns:views="clr-namespace:PileDesign.Views"
        xmlns:common="clr-namespace:PileDesign.Common"
        xmlns:models="clr-namespace:PileDesign.Models.InputData"
        xmlns:Fluent="urn:fluent-ribbon"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Closed="Window_Closed"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        Drop="Window_Drop"
        Title="{Binding WindowTitle}" Height="800" Width="1200" WindowState="Maximized"
        AutomationProperties.Name="杭基礎検討プログラム"
        x:Name="MainWin"
        >

    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewInputModelFileCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenInputModelFileCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveInputModelFileCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveInputModelFileAsCommand}" />
        <KeyBinding Key="W" Modifiers="Control+Shift" Command="{Binding OpenDocxOutputWindowCommand}" />
        <!-- 杭要素分割 / 水平解析。フォーカスが Ribbon ComboBox 等にあると WPF ComboBox 自身が F4 を
             ドロップダウン開閉に消費するため、KeyDown ハンドラだけではファイル開いた直後等に
             効かない。Window.InputBindings ならフォーカス位置に関わらず発火する。
             コマンド名は MVVM Toolkit が生成するもの (Async を除いた名前)。
             ここを間違えるとバインドが無言で失敗し、キーだけ効かなくなる。
             また、コマンド経由にすることでボタンと同じ IsEnabled 判定が効く
             (KeyDown から VM のメソッドを直接呼ぶと判定を迂回してしまう)。 -->
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding OpenElementDivisionWindowCommand}" />
        <KeyBinding Key="F4" Command="{Binding OpenElementDivisionWindowCommand}" />
        <KeyBinding Key="F5" Command="{Binding OpenLateralLoadAnalysisWindowCommand}" />
        <KeyBinding Key="F6" Command="{Binding OpenSettlementWindowCommand}" />
    </Window.InputBindings>

    <Window.DataContext>
        <local:MainWindowViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <conv:BooleanToContentConverter x:Key="BooleanToContentConverter"/>
        <conv:VisibilityConverter x:Key="VisibilityConverter"/>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:BooleanNegationConverter x:Key="BooleanNegationConverter" />
        <conv:SubscriptConverter x:Key="SubscriptConverter" />
        <conv:LoadCaseNameInSeismicCasesToVisibilityConverter x:Key="LoadCaseNameInSeismicCasesToVisibilityConverter"/>
        <conv:AnalysisResultContentEqualsToVisibilityConverter x:Key="AnalysisResultContentEqualsToVisibilityConverter"/>
        <conv:ResultSymbolDescriptionConverter x:Key="ResultSymbolDescription"/>

        <!-- 解析結果の選択肢は表示幅の都合で記号だけになっているので、
             一覧の各項目に意味をツールチップで出す。 -->
        <Style x:Key="ResultSymbolItemStyle" TargetType="ComboBoxItem">
            <Setter Property="ToolTip"
                    Value="{Binding Converter={StaticResource ResultSymbolDescription}}"/>
        </Style>
        <conv:AnalysisContentCategoryConverter x:Key="AnalysisContentCategoryConverter"/>
        <conv:MidSpanAndPileTopVisibilityConverter x:Key="MidSpanAndPileTopVisibilityConverter"/>
        <conv:ResultValueAndMidSpanAndPileTopVisibilityConverter x:Key="ResultValueAndMidSpanAndPileTopVisibilityConverter"/>
        <conv:LogSliderConverter x:Key="LogSliderConverter" LogMin="0.1" LogMax="1000"/>
        <conv:OutOfRangeToBoolConverter x:Key="OutOfRangeToBoolConverter"/>
        <conv:AnyBoolToVisibilityConverter x:Key="AnyBoolToVisibilityConverter"/>
        <conv:AnyBoolConverter x:Key="AnyBoolConverter"/>

        <conv:GreaterThanZeroConverter x:Key="GreaterThanZeroConverter"/>
        <conv:EnumToBooleanConverter x:Key="EnumToBoolConverter"/>
        <conv:NodeReferenceDisplayConverter x:Key="NodeReferenceDisplayConverter"/>
        <conv:NodeOptionFilterConverter x:Key="NodeOptionFilterConverter"/>
        <conv:StressUnitConverter x:Key="StressUnitConverter"/>
        <conv:LoadCaseAnalyzedConverter x:Key="LoadCaseAnalyzedConverter"/>
        <conv:LoadCaseNameToColorConverter x:Key="LoadCaseNameToColorConverter"/>
        <conv:LoadCaseNameToDisplayConverter x:Key="LoadCaseNameToDisplayConverter"/>
        <conv:LoadCombinationAnalyzedConverter x:Key="LoadCombinationAnalyzedConverter"/>
        <conv:SettlementAnalyzedConverter x:Key="SettlementAnalyzedConverter"/>
        <conv:GroupSettlementAnalyzedConverter x:Key="GroupSettlementAnalyzedConverter"/>

        <ContextMenu x:Key="NodeContextMenu">
            <MenuItem Header="コピー／移動" Command="{Binding MoveCopyPilesCommand}"/>
            <MenuItem Header="杭配置プロパティ変更／追加" Command="{Binding EditAddPilesCommand}"/>
            <MenuItem Header="削除" Command="{Binding DeletePilesCommand}"/>
            <MenuItem Header="一般節点⇔杭接合節点" Command="{Binding ConvertNodeTypeCommand}"/>
            <MenuItem Header="選択解除" Command="{Binding DeselectPilesCommand}"/>
            <Separator/>
            <MenuItem Header="画像コピー(x1.0)" Command="{Binding ImageCopyCommand}" CommandParameter="1.0"/>
            <MenuItem Header="画像コピー(x2.0)" Command="{Binding ImageCopyCommand}" CommandParameter="2.0"/>
            <MenuItem Header="画像保存(x1.0)" Command="{Binding ImageSaveCommand}" CommandParameter="1.0"/>
            <MenuItem Header="画像保存(x2.0)" Command="{Binding ImageSaveCommand}" CommandParameter="2.0"/>
        </ContextMenu>

        <ContextMenu x:Key="InputNodeContextMenu">
            <MenuItem Header="コピー" Command="{Binding CopyInputNodeCommand}" CommandParameter="{Binding SelectedInputNode}"/>
            <MenuItem Header="削除" Command="{Binding DeleteInputNodeCommand}" CommandParameter="{Binding SelectedInputNode}"/>
            <MenuItem Header="一般節点⇔杭接合節点" Command="{Binding ConvertNodeTypeCommand}"/>
        </ContextMenu>

        <ContextMenu x:Key="BeamElementContextMenu">
            <MenuItem Header="コピー／移動" Command="{Binding MoveCopyPilesCommand}"/>
            <MenuItem Header="梁要素プロパティの変更" Command="{Binding EditBeamElementsCommand}"/>
            <MenuItem Header="削除" Command="{Binding DeleteBeamsCommand}"/>
            <MenuItem Header="選択解除" Command="{Binding DeselectBeamsCommand}"/>
            <Separator/>
            <MenuItem Header="画像コピー(x1.0)" Command="{Binding ImageCopyCommand}" CommandParameter="1.0"/>
            <MenuItem Header="画像コピー(x2.0)" Command="{Binding ImageCopyCommand}" CommandParameter="2.0"/>
            <MenuItem Header="画像保存(x1.0)" Command="{Binding ImageSaveCommand}" CommandParameter="1.0"/>
            <MenuItem Header="画像保存(x2.0)" Command="{Binding ImageSaveCommand}" CommandParameter="2.0"/>
        </ContextMenu>

        <ContextMenu x:Key="CommonDataGridContextMenu" Opened="ContextMenu_Opened">
            <MenuItem Click="ExportCsvFromContextMenu_Click">
                <MenuItem.Icon>
                    <svgc:SvgViewbox Source="/Icons/CSVFileOutput.svg" Style="{DynamicResource SvgIconStyle16}"/>
                </MenuItem.Icon>
                <MenuItem.Header>
                    <TextBlock Text="CSVファイル出力"/>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem Header="コピー" Command="{Binding CopyDataGridSelectionCommand}"
                      CommandParameter="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </ContextMenu>

        <!-- 共通のスタイルを定義 -->
        <Style x:Key="RightAlignedTextBlockStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <Style x:Key="ReadOnlyRightAlignedTextBlockStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="Gray"/>
        </Style>

        <Style x:Key="CenterAlignedTextBlockStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RightAlignedDataCellStyle" TargetType="DataGridCell">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <!-- Style for ComboBox elements to right-align text -->
        <Style x:Key="RightAlignedComboBoxStyle" TargetType="ComboBox"
               BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <!-- Style for ComboBox items to right-align text -->
        <Style x:Key="RightAlignedComboBoxItemStyle" TargetType="ComboBoxItem"
               BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <Style x:Key="OpenElementDivisionWindowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsElementSplit}" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryAccentBrush}"/>
                    <Setter Property="Foreground" Value="White"/>

                </DataTrigger>
                <DataTrigger Binding="{Binding IsElementSplit}" Value="False">
                    <Setter Property="Background" Value="{StaticResource NikkenYellowBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Style for VerticalAnalyseButtonStyle -->
        <Style x:Key="VerticalAnalyseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsElementSplit}" Value="False">
                    <Setter Property="Background" Value="LightGray"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsElementSplit}" Value="True"/>
                        <Condition Binding="{Binding IsVerticalAnalysisDone}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource NikkenYellowBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsElementSplit}" Value="True"/>
                        <Condition Binding="{Binding IsVerticalAnalysisDone}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource PrimaryAccentBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Style for HorizontalAnalyseButtonStyle -->
        <Style x:Key="HorizontalAnalyseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsElementSplit}" Value="False">
                    <Setter Property="Background" Value="LightGray"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsElementSplit}" Value="True"/>
                        <Condition Binding="{Binding IsHorizontalAnalysisDone}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource NikkenYellowBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsElementSplit}" Value="True"/>
                        <Condition Binding="{Binding IsHorizontalAnalysisDone}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource PrimaryAccentBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OpenGroupPileSettlementWindowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGroupPileSettlementAnalysisDone}" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryAccentBrush}"/>
                    <Setter Property="Foreground" Value="White"/>

                </DataTrigger>
                <DataTrigger Binding="{Binding IsGroupPileSettlementAnalysisDone}" Value="False">
                    <Setter Property="Background" Value="{StaticResource NikkenYellowBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Imageコントロール用のスタイルを定義 -->
        <Style x:Key="IconImageStyle" TargetType="Image">
            <Setter Property="Width" Value="16px"/>
            <Setter Property="Height" Value="16px"/>
        </Style>

        <!-- SvgViewboxコントロール用のスタイルを定義
             SvgViewbox 自身の IsEnabled が False のとき (UIElement.IsEnabled は親から自動継承されるため、
             親 Button の IsEnabled=False が伝播する) に薄く表示する。
             RelativeSource AncestorType=ButtonBase 方式 (旧実装) は SvgViewbox が Button 外で使われた
             場合に「源が見つからない」警告を出すが、本方式は警告ゼロかつ意図する挙動が得られる。 -->
        <Style x:Key="SvgIconStyle16" TargetType="svgc:SvgViewbox">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="StretchDirection" Value="DownOnly"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SvgIconStyle24" TargetType="svgc:SvgViewbox">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="StretchDirection" Value="DownOnly"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SvgIconStyle32" TargetType="svgc:SvgViewbox">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="StretchDirection" Value="DownOnly"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ToolTipのスタイルを定義 -->
        <Style TargetType="ToolTip" x:Key="DeepBlueToolTipStyle">
            <Setter Property="Foreground" Value="{StaticResource NikkenDeepBlueBrush}"/>
            <!-- フォントの色を赤に設定 -->
        </Style>

        <!-- ToolTipのスタイルを定義 -->
        <Style TargetType="ToolTip" x:Key="BrownToolTipStyle">
            <Setter Property="Foreground" Value="Brown"/>
            <!-- フォントの色を赤に設定 -->
        </Style>

        <!-- 特定の列ヘッダーの色を変更するスタイル
             BasedOn で Styles.xaml の暗黙 DataGridColumnHeader Style (FontWeight=SemiBold) を継承 -->
        <Style x:Key="GreenHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="Foreground" Value="{StaticResource NikkenGreenBrush}"/>
        </Style>
        <Style x:Key="YellowHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="Foreground" Value="{StaticResource NikkenYellowBrush}"/>
        </Style>
        <Style x:Key="DeepBlueHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="Foreground" Value="{StaticResource NikkenDeepBlueBrush}"/>
        </Style>
        <Style x:Key="PaleRedHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="Foreground" Value="{StaticResource NikkenPaleRedBrush}"/>
        </Style>
        <Style x:Key="CrimsonHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="Foreground" Value="{StaticResource NikkenPaleRedBrush}"/>
        </Style>

        <!--RibbonToggleButton 用: 大アイコン ToolTip スタイル-->
        <Style x:Key="LargeIconToolTipRibbonToggleButtonStyle" TargetType="Fluent:ToggleButton">
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="ToolTip">
                <Setter.Value>
                    <ToolTip Placement="Mouse" HasDropShadow="True">
                        <StackPanel Orientation="Horizontal" Margin="6">
                            <!--LargeImageSource -> SmallImageSource を優先-->
                            <Image Width="48" Height="48" Stretch="Uniform">
                                <Image.Source>
                                    <PriorityBinding>
                                        <Binding Path="PlacementTarget.LargeImageSource" RelativeSource="{RelativeSource AncestorType=ToolTip}"/>
                                        <Binding Path="PlacementTarget.SmallImageSource" RelativeSource="{RelativeSource AncestorType=ToolTip}"/>
                                    </PriorityBinding>
                                </Image.Source>
                            </Image>

                            <!--フォールバック: PlacementTarget.Content が SvgViewbox / Image のとき複製して表示-->
                            <ContentPresenter Content="{Binding PlacementTarget.Content, RelativeSource={RelativeSource AncestorType=ToolTip}}">
                                <ContentPresenter.ContentTemplate>
                                    <DataTemplate>
                                        <ContentControl>
                                            <ContentControl.Resources>
                                                <DataTemplate DataType="{x:Type svgc:SvgViewbox}">
                                                    <svgc:SvgViewbox Source="{Binding Source}" Width="48" Height="48" Stretch="Uniform"/>
                                                </DataTemplate>
                                                <DataTemplate DataType="{x:Type Image}">
                                                    <Image Source="{Binding Source}" Width="48" Height="48" Stretch="Uniform"/>
                                                </DataTemplate>
                                                <DataTemplate DataType="{x:Type sys:String}">
                                                    <TextBlock Text="{Binding}" FontSize="14" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </ContentControl.Resources>
                                            <ContentControl Content="{Binding}"/>
                                        </ContentControl>
                                    </DataTemplate>
                                </ContentPresenter.ContentTemplate>
                            </ContentPresenter>

                            <TextBlock Text="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ToolTip}}"
                                 Margin="12,0,0,0"
                                 VerticalAlignment="Center"
                                 TextWrapping="Wrap"/>
                        </StackPanel>
                    </ToolTip>
                </Setter.Value>
            </Setter>
        </Style>

        <!--RibbonButton 用: 大アイコンToolTip スタイル（LargeImageSource を優先し、なければ SmallImageSource。さらに Content が Svg の場合も対応）-->
        <Style x:Key="LargeIconToolTipRibbonButtonStyle" TargetType="Fluent:Button">
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="ToolTip">
                <Setter.Value>
                    <ToolTip Placement="Mouse" HasDropShadow="True">
                        <StackPanel Orientation="Horizontal" Margin="6">
                            <!--まずは Ribbon の Large/SmallImageSource を優先-->
                            <Image Width="48" Height="48" Stretch="Uniform">
                                <Image.Source>
                                    <PriorityBinding>
                                        <Binding Path="PlacementTarget.LargeImageSource" RelativeSource="{RelativeSource AncestorType=ToolTip}"/>
                                        <Binding Path="PlacementTarget.SmallImageSource" RelativeSource="{RelativeSource AncestorType=ToolTip}"/>
                                        <!--最後に PlacementTarget.Content が Svg/Image の場合をフォールバックで試す-->
                                    </PriorityBinding>
                                </Image.Source>
                            </Image>

                            <!--フォールバック：もし PlacementTarget.Content が SvgViewbox の場合は再描画-->
                            <ContentControl Visibility="Collapsed" x:Name="__SvgFallback">
                                <ContentControl.Content>
                                    <Binding RelativeSource="{RelativeSource AncestorType=ToolTip}" Path="PlacementTarget.Content"/>
                                </ContentControl.Content>
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <svgc:SvgViewbox Source="{Binding Path=Source}" Width="48" Height="48" Stretch="Uniform"/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>

                            <TextBlock Text="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ToolTip}}"
                                 Margin="12,0,0,0"
                                 VerticalAlignment="Center"
                                 TextWrapping="Wrap"/>
                        </StackPanel>
                    </ToolTip>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 大アイコンToolTip汎用スタイル
             BasedOn で Styles.xaml 側の暗黙 Button Style (フラット見た目) を継承し、
             ここでは ToolTip / Hover 時の大アイコン表示だけ追加する。
             BasedOn を外すと OS デフォルトの灰色グラデ見た目に戻ってしまう。-->
        <Style x:Key="LargeIconToolTipButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <!-- 追加 -->
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="ToolTip">
                <Setter.Value>
                    <ToolTip Placement="Mouse" HasDropShadow="True">
                        <StackPanel Orientation="Horizontal" Margin="6">
                            <!-- 元の UIElement を再利用せず DataTemplateで複製 -->
                            <ContentPresenter Content="{Binding RelativeSource={RelativeSource AncestorType=ToolTip}, Path=PlacementTarget.Content}">
                                <ContentPresenter.ContentTemplate>
                                    <!-- ボタン Content が SvgViewbox の場合に新しいインスタンスを生成 -->
                                    <DataTemplate DataType="{x:Type svgc:SvgViewbox}">
                                        <svgc:SvgViewbox Source="{Binding Source}" Width="48" Height="48"/>
                                    </DataTemplate>
                                </ContentPresenter.ContentTemplate>
                            </ContentPresenter>

                            <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=ToolTip}, Path=PlacementTarget.Tag}"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </ToolTip>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ToggleButton用: 大アイコンToolTip汎用スタイル
             BasedOn で Styles.xaml 側の暗黙 ToggleButton Style (フラット見た目 + IsChecked accent) を継承 -->
        <Style x:Key="LargeIconToolTipToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="ToolTip">
                <Setter.Value>
                    <ToolTip Placement="Mouse" HasDropShadow="True">
                        <StackPanel Orientation="Horizontal" Margin="6">
                            <ContentPresenter Content="{Binding RelativeSource={RelativeSource AncestorType=ToolTip}, Path=PlacementTarget.Content}">
                                <ContentPresenter.ContentTemplate>
                                    <DataTemplate DataType="{x:Type svgc:SvgViewbox}">
                                        <svgc:SvgViewbox Source="{Binding Source}" Width="48" Height="48"/>
                                    </DataTemplate>
                                </ContentPresenter.ContentTemplate>
                            </ContentPresenter>
                            <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=ToolTip}, Path=PlacementTarget.Tag}"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </ToolTip>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- セグメントボタン風RadioButtonスタイル（液状化切替用） -->
        <Style x:Key="SegmentedButtonStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                BorderBrush="#999"
                                BorderThickness="1"
                                Padding="6,2"
                                Background="{StaticResource SurfaceMutedBrush}"
                                CornerRadius="2">
                            <TextBlock x:Name="text"
                                       Text="{TemplateBinding Content}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="11"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0078D7"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#005A9E"/>
                                <Setter TargetName="text" Property="Foreground" Value="White"/>
                                <Setter TargetName="text" Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="{StaticResource SurfaceBorderBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 荷重ケースComboBox用 ItemTemplate（解析済みインジケータ付き） -->
        <DataTemplate x:Key="LoadCaseItemTemplate">
            <StackPanel Orientation="Horizontal">
                <!-- 水平解析済み (Green) -->
                <Ellipse Width="5" Height="5" Fill="{StaticResource StatusSuccessBrush}" Margin="0,0,1,0" VerticalAlignment="Center">
                    <Ellipse.Visibility>
                        <MultiBinding Converter="{StaticResource LoadCaseAnalyzedConverter}">
                            <Binding/>
                            <Binding Path="DataContext.CurrentModel"
                                     RelativeSource="{RelativeSource AncestorType=Window}"/>
                        </MultiBinding>
                    </Ellipse.Visibility>
                </Ellipse>
                <!-- 単杭沈下解析済み (Blue) -->
                <Ellipse Width="5" Height="5" Fill="{StaticResource StatusInfoBrush}" Margin="0,0,1,0" VerticalAlignment="Center">
                    <Ellipse.Visibility>
                        <MultiBinding Converter="{StaticResource SettlementAnalyzedConverter}">
                            <Binding/>
                            <Binding Path="DataContext.IsVerticalAnalysisDone"
                                     RelativeSource="{RelativeSource AncestorType=Window}"/>
                        </MultiBinding>
                    </Ellipse.Visibility>
                </Ellipse>
                <!-- 群杭沈下解析済み (Orange) - VLのみ -->
                <Ellipse Width="5" Height="5" Fill="{StaticResource StatusWarningDarkBrush}" Margin="0,0,3,0" VerticalAlignment="Center">
                    <Ellipse.Visibility>
                        <MultiBinding Converter="{StaticResource GroupSettlementAnalyzedConverter}">
                            <Binding/>
                            <Binding Path="DataContext.IsGroupPileSettlementAnalysisDone"
                                     RelativeSource="{RelativeSource AncestorType=Window}"/>
                        </MultiBinding>
                    </Ellipse.Visibility>
                </Ellipse>
                <TextBlock ToolTip="{Binding}">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource LoadCaseNameToDisplayConverter}">
                            <Binding/>
                            <Binding Path="DataContext.CurrentInputModel.LoadCasesInput.AllSeismicLoadCases"
                                     RelativeSource="{RelativeSource AncestorType=Window}"/>
                        </MultiBinding>
                    </TextBlock.Text>
                    <TextBlock.Foreground>
                        <MultiBinding Converter="{StaticResource LoadCaseNameToColorConverter}">
                            <Binding/>
                            <Binding Path="DataContext.CurrentInputModel.LoadCasesInput.AllSeismicLoadCases"
                                     RelativeSource="{RelativeSource AncestorType=Window}"/>
                        </MultiBinding>
                    </TextBlock.Foreground>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <!-- 荷重組合せComboBox用 ItemTemplate（解析済みインジケータ付き） -->
        <DataTemplate x:Key="LoadCombinationItemTemplate">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="6" Height="6" Fill="{StaticResource StatusSuccessBrush}" Margin="0,0,4,0" VerticalAlignment="Center">
                    <Ellipse.Visibility>
                        <MultiBinding Converter="{StaticResource LoadCombinationAnalyzedConverter}">
                            <Binding/>
                            <Binding Path="DataContext.SelectedLoadCaseName"
                                     RelativeSource="{RelativeSource AncestorType=Window}"/>
                            <Binding Path="DataContext.CurrentModel"
                                     RelativeSource="{RelativeSource AncestorType=Window}"/>
                        </MultiBinding>
                    </Ellipse.Visibility>
                </Ellipse>
                <TextBlock Text="{Binding}"/>
            </StackPanel>
        </DataTemplate>

        <!-- 解析済みインジケータ付きセグメントボタンスタイル -->
        <Style x:Key="AnalyzedSegmentedButtonStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                BorderBrush="#999"
                                BorderThickness="1"
                                Padding="6,2"
                                Background="{StaticResource SurfaceMutedBrush}"
                                CornerRadius="2">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource StatusSuccessBrush}"
                                         Margin="0,0,3,0" VerticalAlignment="Center"
                                         Visibility="{Binding Tag, RelativeSource={RelativeSource TemplatedParent},
                                                      Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBlock x:Name="text"
                                           Text="{TemplateBinding Content}"
                                           VerticalAlignment="Center"
                                           FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0078D7"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#005A9E"/>
                                <Setter TargetName="text" Property="Foreground" Value="White"/>
                                <Setter TargetName="text" Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="{StaticResource SurfaceBorderBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- LoadingType 用アイコン付きアイテムテンプレート -->
        <DataTemplate x:Key="LoadingTypeItemTemplate">
            <StackPanel Orientation="Horizontal">
                <svgc:SvgViewbox Width="24" Height="24" Stretch="Uniform">
                    <svgc:SvgViewbox.Style>
                        <Style TargetType="svgc:SvgViewbox">
                            <!-- 既定アイコン（該当なし時） -->
                            <Setter Property="Source" Value="/Icons/NoPressure.svg"/>
                            <!-- 項目文字列で切替 -->
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="任意矩形">
                                    <Setter Property="Source" Value="/Icons/AnyFormPressure.svg"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding}" Value="個別矩形">
                                    <Setter Property="Source" Value="/Icons/SquareFormPressure.svg"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding}" Value="個別矩形（基礎梁考慮）">
                                    <Setter Property="Source" Value="/Icons/BeamedSquareFormPressure.svg"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding}" Value="個別十字">
                                    <Setter Property="Source" Value="/Icons/CrossFormPressure.svg"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding}" Value="個別十字（基礎梁反力）">
                                    <Setter Property="Source" Value="/Icons/BeamedCrossFormPressure.svg"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </svgc:SvgViewbox.Style>
                </svgc:SvgViewbox>
                <TextBlock Text="{Binding}" Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <!-- 杭要素分割ボタン専用: 大アイコンToolTip + 動的アイコン切替 -->
        <Style x:Key="ElementDivisionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource LargeIconToolTipButtonStyle}">
            <!-- 既定アイコン -->
            <Setter Property="Content">
                <Setter.Value>
                    <svgc:SvgViewbox Source="/Icons/ElementDivisionWindow.svg"
                                     Style="{StaticResource SvgIconStyle24}"/>
                </Setter.Value>
            </Setter>
            <!-- 既定タグ（ToolTip文言） -->
            <Setter Property="Tag" Value="杭要素分割(未) (F4/Ctrl+D)"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsElementSplit}" Value="True">
                    <Setter Property="Content">
                        <Setter.Value>
                            <svgc:SvgViewbox Source="/Icons/ElementDivisionWindowDone.svg"
                                             Style="{StaticResource SvgIconStyle24}"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Tag" Value="杭要素分割(済) (F4/Ctrl+D)"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 水平解析ボタン専用: 動的アイコン切替 -->
        <Style x:Key="LateralLoadAnalysisButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource LargeIconToolTipButtonStyle}">
            <Setter Property="Content">
                <Setter.Value>
                    <svgc:SvgViewbox Source="/Icons/LateralLoadAnalysisWindow.svg"
                                     Style="{StaticResource SvgIconStyle24}"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Tag" Value="水平解析 (F5)"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHorizontalAnalysisDone}" Value="True">
                    <Setter Property="Content">
                        <Setter.Value>
                            <svgc:SvgViewbox Source="/Icons/LateralLoadAnalysisWindowDone.svg"
                                             Style="{StaticResource SvgIconStyle24}"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Tag" Value="水平解析 ✓ (F5)"/>
                    <Setter Property="Foreground" Value="{StaticResource StatusSuccessBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 単杭沈下解析ボタン専用: 動的アイコン切替 -->
        <Style x:Key="SettlementAnalysisButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource LargeIconToolTipButtonStyle}">
            <Setter Property="Content">
                <Setter.Value>
                    <svgc:SvgViewbox Source="/Icons/SettlementWindow.svg"
                                     Style="{StaticResource SvgIconStyle24}"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Tag" Value="荷重沈下関係解析 (F6)"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsVerticalAnalysisDone}" Value="True">
                    <Setter Property="Content">
                        <Setter.Value>
                            <svgc:SvgViewbox Source="/Icons/SettlementWindowDone.svg"
                                             Style="{StaticResource SvgIconStyle24}"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Tag" Value="荷重沈下関係解析 ✓ (F6)"/>
                    <Setter Property="Foreground" Value="{StaticResource StatusInfoBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 群杭沈下解析ボタン専用: 動的アイコン切替 -->
        <Style x:Key="GroupPileSettlementButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource LargeIconToolTipButtonStyle}">
            <Setter Property="Content">
                <Setter.Value>
                    <svgc:SvgViewbox Source="/Icons/GroupPileSettlement.svg"
                                     Style="{StaticResource SvgIconStyle24}"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Tag" Value="群杭沈下解析 (F8)"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGroupPileSettlementAnalysisDone}" Value="True">
                    <Setter Property="Content">
                        <Setter.Value>
                            <svgc:SvgViewbox Source="/Icons/GroupPileSettlementDone.svg"
                                             Style="{StaticResource SvgIconStyle24}"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Tag" Value="群杭沈下解析 ✓ (F8)"/>
                    <Setter Property="Foreground" Value="{StaticResource StatusWarningDarkBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 旧 ribbon:RibbonQuickAccessToolBar リソースは Fluent:Ribbon.QuickAccessItems に移行済 (下方参照) -->

    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Fluent:Ribbon Grid.Row="0"
               Margin="0"
               Padding="0"
               BorderThickness="0"
               CanCustomizeQuickAccessToolBar="False"
               IsMinimized="{Binding IsRibboNMinimized}"
               Visibility="{Binding IsRibbonVisible, Converter={StaticResource BooleanToVisibilityConverter}}">

            <!-- リボン右端のボタンは削除（画面右下のボタンは維持） -->

            <!-- QuickAccessToolBar (タイトルバー上の Undo/Redo 等) -->
            <Fluent:Ribbon.ToolBarItems>
                <Fluent:Button ToolTip="{Binding UndoToolTip}"
                               Command="{Binding UndoCommand}"
                               Icon="pack://application:,,,/Icons/Undo.png"
                               Size="Small"/>
                <Fluent:Button ToolTip="{Binding RedoToolTip}"
                               Command="{Binding RedoCommand}"
                               Icon="pack://application:,,,/Icons/Redo.png"
                               Size="Small"/>
            </Fluent:Ribbon.ToolBarItems>

            <!-- Backstage (旧 RibbonApplicationMenu の置換、Office 365 風の全画面メニュー) -->
            <Fluent:Ribbon.Menu>
                <Fluent:Backstage x:Name="MainBackstage" Header="ファイル(F)" KeyTip="F"
                                  AreAnimationsEnabled="False">
                    <Fluent:BackstageTabControl UseLayoutRounding="True"
                                                SnapsToDevicePixels="True"
                                                TextOptions.TextFormattingMode="Display"
                                                RenderOptions.BitmapScalingMode="HighQuality">
                        <Fluent:BackstageTabControl.Resources>
                            <!-- BackstageTabItem は Style 経由で IconSize=Large を一括指定。
                                 Fluent:Button 側は Style が効かないため属性で個別指定する。 -->
                            <Style TargetType="{x:Type Fluent:BackstageTabItem}">
                                <Setter Property="Fluent:RibbonProperties.IconSize" Value="Large"/>
                            </Style>
                        </Fluent:BackstageTabControl.Resources>

                        <!-- 新規 -->
                        <Fluent:Button Header="新規 (Ctrl+N)" Command="{Binding NewInputModelFileCommand}"
                                       Icon="pack://application:,,,/Icons/NewFile.png"
                                       LargeIcon="pack://application:,,,/Icons/NewFile.png"
                                       Fluent:RibbonProperties.IconSize="Large"
                                       KeyTip="N"/>

                        <!-- 開く -->
                        <Fluent:Button Header="開く (Ctrl+O)" Command="{Binding OpenInputModelFileCommand}"
                                       Icon="pack://application:,,,/Icons/OpenFile.png"
                                       LargeIcon="pack://application:,,,/Icons/OpenFile.png"
                                       Fluent:RibbonProperties.IconSize="Large"
                                       KeyTip="O"/>

                        <!-- 最近使ったファイル -->
                        <Fluent:BackstageTabItem Header="最近使ったファイル" KeyTip="R"
                                                 Icon="pack://application:,,,/Icons/RecentFiles.png">
                            <Border Padding="20">
                                <StackPanel>
                                    <TextBlock Text="最近使ったファイル" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>
                                    <ItemsControl ItemsSource="{Binding MruItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                        Padding="12,8" Margin="0,2"
                                                        Command="{Binding DataContext.OpenFromMruCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding FilePath}"
                                                        ToolTip="{Binding FilePath}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding FilePath}" FontSize="11" Foreground="Gray"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Fluent:BackstageTabItem>

                        <Fluent:SeparatorTabItem/>

                        <!-- 上書き保存 -->
                        <Fluent:Button Header="上書き保存 (Ctrl+S)" Command="{Binding SaveInputModelFileCommand}"
                                       Icon="pack://application:,,,/Icons/SaveFile.png"
                                       LargeIcon="pack://application:,,,/Icons/SaveFile.png"
                                       Fluent:RibbonProperties.IconSize="Large"
                                       KeyTip="S"/>

                        <!-- 名前を付けて保存 -->
                        <Fluent:Button Header="名前を付けて保存 (Ctrl+Shift+S)" Command="{Binding SaveInputModelFileAsCommand}"
                                       Icon="pack://application:,,,/Icons/SaveFileAs.png"
                                       LargeIcon="pack://application:,,,/Icons/SaveFileAs.png"
                                       Fluent:RibbonProperties.IconSize="Large"
                                       KeyTip="A"/>

                        <Fluent:SeparatorTabItem/>

                        <!-- 計算例 -->
                        <Fluent:BackstageTabItem x:Name="BackstageExamplesTab" Header="計算例" KeyTip="E"
                                                 Icon="pack://application:,,,/Icons/Examples.png">
                            <Border Padding="20">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="計算例の読み込み" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

                                        <!-- 建築基礎構造設計指針 2019 -->
                                        <TextBlock Text="建築基礎構造設計指針 2019" FontWeight="Bold" Foreground="#3271AD" Margin="0,8,0,4" FontSize="14"/>
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" Margin="0,2"
                                                Command="{Binding Example5PileCommand}"
                                                ToolTip="基礎指針'19 計算例5 直接基礎の即時沈下量（PHC杭φ600 L=14m 12本付き）">
                                            <StackPanel Orientation="Horizontal"><Image Source="pack://application:,,,/Icons/cover.png" Width="32" Height="32" Margin="0,0,12,0" Stretch="Uniform"/><TextBlock Text="計算例5　直接基礎の即時沈下量" VerticalAlignment="Center"/></StackPanel></Button>
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" Margin="0,2"
                                                Command="{Binding Example7Command}"
                                                ToolTip="基礎指針'19 計算例7 杭の限界鉛直支持力および限界引抜き抵抗力">
                                            <StackPanel Orientation="Horizontal"><Image Source="pack://application:,,,/Icons/cover.png" Width="32" Height="32" Margin="0,0,12,0" Stretch="Uniform"/><TextBlock Text="計算例7　杭の限界鉛直支持力および限界引抜き抵抗力" VerticalAlignment="Center"/></StackPanel></Button>
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" Margin="0,2"
                                                Command="{Binding Example9Command}"
                                                ToolTip="基礎指針'19 計算例9 地下室の影響を考慮した杭の地震時水平抵抗">
                                            <StackPanel Orientation="Horizontal"><Image Source="pack://application:,,,/Icons/cover.png" Width="32" Height="32" Margin="0,0,12,0" Stretch="Uniform"/><TextBlock Text="計算例9　地下室の影響を考慮した杭の地震時水平抵抗" VerticalAlignment="Center"/></StackPanel></Button>
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" Margin="0,2"
                                                Command="{Binding Example10Command}"
                                                ToolTip="基礎指針'19 計算例10 場所打ち鉄筋コンクリート杭φ1500 L=37.5m">
                                            <StackPanel Orientation="Horizontal"><Image Source="pack://application:,,,/Icons/cover.png" Width="32" Height="32" Margin="0,0,12,0" Stretch="Uniform"/><TextBlock Text="計算例10　液状化の可能性がある場所打ち杭の水平抵抗" VerticalAlignment="Center"/></StackPanel></Button>

                                        <!-- 設計例集 -->
                                        <TextBlock Text="建築基礎構造設計例集 2024" FontWeight="Bold" Foreground="#3271AD" Margin="0,16,0,4" FontSize="14"/>
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" Margin="0,2"
                                                Command="{Binding Example3_1Command}"
                                                ToolTip="日本建築学会　建築基礎構造設計例集 2024　3.1　非液状化地盤に建つ建物のPHC杭基礎">
                                            <StackPanel Orientation="Horizontal"><Image Source="pack://application:,,,/Icons/316kZCPgkUL._SY291_BO1,204,203,200_QL40_ML2_.jpg" Width="32" Height="32" Margin="0,0,12,0" Stretch="Uniform"/><TextBlock Text="3.1　非液状化地盤に建つ建物のPRC杭基礎" VerticalAlignment="Center"/></StackPanel></Button>
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" Margin="0,2"
                                                Command="{Binding Example3_2Command}"
                                                ToolTip="日本建築学会　建築基礎構造設計例集 2024　3.2　砂地盤に建つ建物のPHC節杭基礎">
                                            <StackPanel Orientation="Horizontal"><Image Source="pack://application:,,,/Icons/316kZCPgkUL._SY291_BO1,204,203,200_QL40_ML2_.jpg" Width="32" Height="32" Margin="0,0,12,0" Stretch="Uniform"/><TextBlock Text="3.2　砂地盤に建つ建物のPHC節杭基礎" VerticalAlignment="Center"/></StackPanel></Button>
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" Margin="0,2"
                                                Command="{Binding Example3_3Command}"
                                                ToolTip="日本建築学会　建築基礎構造設計例集 2024　3.3　粘性土地盤に建つ免振建物の場所打ち鉄筋コンクリート杭基礎">
                                            <StackPanel Orientation="Horizontal"><Image Source="pack://application:,,,/Icons/316kZCPgkUL._SY291_BO1,204,203,200_QL40_ML2_.jpg" Width="32" Height="32" Margin="0,0,12,0" Stretch="Uniform"/><TextBlock Text="3.3　粘性土地盤に建つ免震建物の場所打ち鉄筋コンクリート杭基礎" VerticalAlignment="Center"/></StackPanel></Button>
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" Margin="0,2"
                                                Command="{Binding Example3_4Command}"
                                                ToolTip="日本建築学会　建築基礎構造設計例集 2024　3.4　液状化の可能性がある地盤に建つ建物のSC杭基礎">
                                            <StackPanel Orientation="Horizontal"><Image Source="pack://application:,,,/Icons/316kZCPgkUL._SY291_BO1,204,203,200_QL40_ML2_.jpg" Width="32" Height="32" Margin="0,0,12,0" Stretch="Uniform"/><TextBlock Text="3.4　液状化の可能性がある地盤に建つ建物のSC杭基礎" VerticalAlignment="Center"/></StackPanel></Button>
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" Margin="0,2"
                                                Command="{Binding Example3_5Command}"
                                                ToolTip="日本建築学会　建築基礎構造設計例集 2024　3.5　鋼管杭基礎">
                                            <StackPanel Orientation="Horizontal"><Image Source="pack://application:,,,/Icons/316kZCPgkUL._SY291_BO1,204,203,200_QL40_ML2_.jpg" Width="32" Height="32" Margin="0,0,12,0" Stretch="Uniform"/><TextBlock Text="3.5　液状化の可能性がある地盤に建つ建物の鋼管杭基礎" VerticalAlignment="Center"/></StackPanel></Button>
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" Margin="0,2"
                                                Command="{Binding Example3_8Command}"
                                                ToolTip="日本建築学会　建築基礎構造設計例集 2024　3.8　場所打ち鋼管コンクリート杭基礎 (9 杭体 / 9 地盤 / 42 本杭)">
                                            <StackPanel Orientation="Horizontal"><Image Source="pack://application:,,,/Icons/316kZCPgkUL._SY291_BO1,204,203,200_QL40_ML2_.jpg" Width="32" Height="32" Margin="0,0,12,0" Stretch="Uniform"/><TextBlock Text="3.8　支持層が傾斜した地盤に建つ建物の場所打ち鋼管コンクリート杭基礎" VerticalAlignment="Center"/></StackPanel></Button>

                                        <!-- 関東支部 -->
                                        <TextBlock Text="基礎構造の設計 2023（関東支部）" FontWeight="Bold" Foreground="#3271AD" Margin="0,16,0,4" FontSize="14"/>
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" Margin="0,2"
                                                Command="{Binding ExampleK7Command}"
                                                ToolTip="日本建築学会　関東支部　基礎構造の設計 2023　学びやすい構造設計 設計例7（直接基礎）を実行">
                                            <StackPanel Orientation="Horizontal"><Image Source="pack://application:,,,/Icons/332-8002.jpg" Width="32" Height="32" Margin="0,0,12,0" Stretch="Uniform"/><TextBlock Text="7. 直接基礎の設計例 (関東支部 設計例7)" VerticalAlignment="Center"/></StackPanel></Button>
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" Margin="0,2"
                                                Command="{Binding ExampleK8Command}"
                                                ToolTip="日本建築学会　関東支部　基礎構造の設計 2023　学びやすい構造設計 計算例8（杭基礎）を実行">
                                            <StackPanel Orientation="Horizontal"><Image Source="pack://application:,,,/Icons/332-8002.jpg" Width="32" Height="32" Margin="0,0,12,0" Stretch="Uniform"/><TextBlock Text="8. 杭基礎の設計例 (関東支部 計算例8)" VerticalAlignment="Center"/></StackPanel></Button>

                                        <!-- キャプテンパイル工法計算例 -->
                                        <TextBlock Text="キャプテンパイル工法 計算例" FontWeight="Bold" Foreground="#3271AD" Margin="0,16,0,4" FontSize="14"/>
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" Margin="0,2"
