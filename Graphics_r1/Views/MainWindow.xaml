                                                                      HorizontalContentAlignment="Right" VerticalAlignment="Center"
                                                                      Padding="0"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTemplateColumn Width="*" MinWidth="60">
