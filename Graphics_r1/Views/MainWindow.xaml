<ribbon:RibbonWindow x:Class="PileDesign.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PileDesign.ViewModels"
        xmlns:conv="clr-namespace:PileDesign.Converters"
        xmlns:h="clr-namespace:HelixToolkit.Wpf;assembly=HelixToolkit.Wpf"
        xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:linq="clr-namespace:System.Linq;assembly=System.Core"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:svg="http://sharpvectors.codeplex.com/runtime/"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        xmlns:views="clr-namespace:PileDesign.Views"
        xmlns:common="clr-namespace:PileDesign.Common"
        xmlns:models="clr-namespace:PileDesign.Models.InputData"
        xmlns:ribbon="clr-namespace:System.Windows.Controls.Ribbon;assembly=System.Windows.Controls.Ribbon"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Closed="Window_Closed"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        Drop="Window_Drop"
        Title="{Binding WindowTitle}" Height="800" Width="1200" WindowState="Maximized"
        x:Name="MainWin"
        >

    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveInputModelFileCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveInputModelFileAsCommand}" />
    </Window.InputBindings>

    <Window.DataContext>
        <local:MainWindowViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <conv:BooleanToContentConverter x:Key="BooleanToContentConverter"/>
        <conv:VisibilityConverter x:Key="VisibilityConverter"/>
        <conv:PileTopAltitudeConverter x:Key="PileTopAltitudeConverterInstance" />
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:BooleanNegationConverter x:Key="BooleanNegationConverter" />
        <conv:SubscriptConverter x:Key="SubscriptConverter" />
        <conv:LoadCaseNameInSeismicCasesToVisibilityConverter x:Key="LoadCaseNameInSeismicCasesToVisibilityConverter"/>
        <conv:AnalysisResultContentEqualsToVisibilityConverter x:Key="AnalysisResultContentEqualsToVisibilityConverter"/>
        <conv:AnalysisContentCategoryConverter x:Key="AnalysisContentCategoryConverter"/>
        <conv:MidSpanAndPileTopVisibilityConverter x:Key="MidSpanAndPileTopVisibilityConverter"/>
        <conv:ResultValueAndMidSpanAndPileTopVisibilityConverter x:Key="ResultValueAndMidSpanAndPileTopVisibilityConverter"/>
        <conv:LogSliderConverter x:Key="LogSliderConverter" LogMin="0.1" LogMax="1000"/>
        <conv:OutOfRangeToBoolConverter x:Key="OutOfRangeToBoolConverter"/>
        <conv:AnyBoolToVisibilityConverter x:Key="AnyBoolToVisibilityConverter"/>

        <conv:GreaterThanZeroConverter x:Key="GreaterThanZeroConverter"/>
        <conv:EnumToBooleanConverter x:Key="EnumToBoolConverter"/>
        <conv:NodeReferenceDisplayConverter x:Key="NodeReferenceDisplayConverter"/>
        <conv:StressUnitConverter x:Key="StressUnitConverter"/>
        <conv:LoadCaseAnalyzedConverter x:Key="LoadCaseAnalyzedConverter"/>
        <conv:LoadCaseNameToColorConverter x:Key="LoadCaseNameToColorConverter"/>
        <conv:LoadCombinationAnalyzedConverter x:Key="LoadCombinationAnalyzedConverter"/>
        <conv:SettlementAnalyzedConverter x:Key="SettlementAnalyzedConverter"/>
        <conv:GroupSettlementAnalyzedConverter x:Key="GroupSettlementAnalyzedConverter"/>

        <ContextMenu x:Key="NodeContextMenu">
            <MenuItem Header="コピー／移動" Command="{Binding MoveCopyPilesCommand}"/>
            <MenuItem Header="杭配置プロパティ変更／追加" Command="{Binding EditAddPilesCommand}"/>
            <MenuItem Header="削除" Command="{Binding DeletePilesCommand}"/>
            <MenuItem Header="一般節点⇔杭接合節点" Command="{Binding ConvertNodeTypeCommand}"/>
            <MenuItem Header="選択解除" Command="{Binding DeselectPilesCommand}"/>
            <Separator/>
            <MenuItem Header="画像コピー(x1.0)" Command="{Binding ImageCopyCommand}" CommandParameter="1.0"/>
            <MenuItem Header="画像コピー(x2.0)" Command="{Binding ImageCopyCommand}" CommandParameter="2.0"/>
            <MenuItem Header="画像保存(x1.0)" Command="{Binding ImageSaveCommand}" CommandParameter="1.0"/>
            <MenuItem Header="画像保存(x2.0)" Command="{Binding ImageSaveCommand}" CommandParameter="2.0"/>
        </ContextMenu>

        <ContextMenu x:Key="InputNodeContextMenu">
            <MenuItem Header="コピー" Command="{Binding CopyInputNodeCommand}" CommandParameter="{Binding SelectedInputNode}"/>
            <MenuItem Header="削除" Command="{Binding DeleteInputNodeCommand}" CommandParameter="{Binding SelectedInputNode}"/>
            <MenuItem Header="一般節点⇔杭接合節点" Command="{Binding ConvertNodeTypeCommand}"/>
        </ContextMenu>

        <ContextMenu x:Key="BeamElementContextMenu">
            <MenuItem Header="梁要素プロパティの変更" Command="{Binding EditBeamElementsCommand}"/>
            <Separator/>
            <MenuItem Header="画像コピー(x1.0)" Command="{Binding ImageCopyCommand}" CommandParameter="1.0"/>
            <MenuItem Header="画像コピー(x2.0)" Command="{Binding ImageCopyCommand}" CommandParameter="2.0"/>
            <MenuItem Header="画像保存(x1.0)" Command="{Binding ImageSaveCommand}" CommandParameter="1.0"/>
            <MenuItem Header="画像保存(x2.0)" Command="{Binding ImageSaveCommand}" CommandParameter="2.0"/>
        </ContextMenu>

        <ContextMenu x:Key="CommonDataGridContextMenu" Opened="ContextMenu_Opened">
            <MenuItem Click="ExportCsvFromContextMenu_Click">
                <MenuItem.Icon>
                    <svgc:SvgViewbox Source="/Icons/CSVFileOutput.svg" Style="{DynamicResource SvgIconStyle16}"/>
                </MenuItem.Icon>
                <MenuItem.Header>
                    <TextBlock Text="CSVファイル出力"/>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem Header="コピー" Command="{Binding CopyDataGridSelectionCommand}"
                      CommandParameter="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </ContextMenu>

        <!-- 共通のスタイルを定義 -->
        <Style x:Key="RightAlignedTextBlockStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <Style x:Key="ReadOnlyRightAlignedTextBlockStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="Gray"/>
        </Style>

        <Style x:Key="RightAlignedDataCellStyle" TargetType="DataGridCell">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <!-- Style for ComboBox elements to right-align text -->
        <Style x:Key="RightAlignedComboBoxStyle" TargetType="ComboBox">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <!-- Style for ComboBox items to right-align text -->
        <Style x:Key="RightAlignedComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <Style x:Key="OpenElementDivisionWindowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsElementSplit}" Value="True">
                    <Setter Property="Background" Value="#62B0E2"/>
                    <Setter Property="Foreground" Value="White"/>

                </DataTrigger>
                <DataTrigger Binding="{Binding IsElementSplit}" Value="False">
                    <Setter Property="Background" Value="#F7B515"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Style for VerticalAnalyseButtonStyle -->
        <Style x:Key="VerticalAnalyseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsElementSplit}" Value="False">
                    <Setter Property="Background" Value="LightGray"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsElementSplit}" Value="True"/>
                        <Condition Binding="{Binding IsVerticalAnalysisDone}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#F7B515"/>
                    <Setter Property="Foreground" Value="White"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsElementSplit}" Value="True"/>
                        <Condition Binding="{Binding IsVerticalAnalysisDone}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#62B0E2"/>
                    <Setter Property="Foreground" Value="White"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Style for HorizontalAnalyseButtonStyle -->
        <Style x:Key="HorizontalAnalyseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsElementSplit}" Value="False">
                    <Setter Property="Background" Value="LightGray"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsElementSplit}" Value="True"/>
                        <Condition Binding="{Binding IsHorizontalAnalysisDone}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#F7B515"/>
                    <Setter Property="Foreground" Value="White"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsElementSplit}" Value="True"/>
                        <Condition Binding="{Binding IsHorizontalAnalysisDone}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#62B0E2"/>
                    <Setter Property="Foreground" Value="White"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OpenGroupPileSettlementWindowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGroupPileSettlementAnalysisDone}" Value="True">
                    <Setter Property="Background" Value="#62B0E2"/>
                    <Setter Property="Foreground" Value="White"/>

                </DataTrigger>
                <DataTrigger Binding="{Binding IsGroupPileSettlementAnalysisDone}" Value="False">
                    <Setter Property="Background" Value="#F7B515"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Imageコントロール用のスタイルを定義 -->
        <Style x:Key="IconImageStyle" TargetType="Image">
            <Setter Property="Width" Value="16px"/>
            <Setter Property="Height" Value="16px"/>
        </Style>

        <!-- SvgViewboxコントロール用のスタイルを定義 -->
        <Style x:Key="SvgIconStyle16" TargetType="svgc:SvgViewbox">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="StretchDirection" Value="DownOnly"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="SvgIconStyle24" TargetType="svgc:SvgViewbox">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="StretchDirection" Value="DownOnly"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="SvgIconStyle32" TargetType="svgc:SvgViewbox">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="StretchDirection" Value="DownOnly"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- ToolTipのスタイルを定義 -->
        <Style TargetType="ToolTip" x:Key="DeepBlueToolTipStyle">
            <Setter Property="Foreground" Value="#3271AD"/>
            <!-- フォントの色を赤に設定 -->
        </Style>

        <!-- ToolTipのスタイルを定義 -->
        <Style TargetType="ToolTip" x:Key="BrownToolTipStyle">
            <Setter Property="Foreground" Value="Brown"/>
            <!-- フォントの色を赤に設定 -->
        </Style>

        <!-- 特定の列ヘッダーの色を変更するスタイル -->
        <Style x:Key="GreenHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="#238966"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="YellowHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="#F7B515"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DeepBlueHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="#3271AD"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PaleRedHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="#E95541"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CrimsonHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="#D82531"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!--RibbonToggleButton 用: 大アイコン ToolTip スタイル-->
        <Style x:Key="LargeIconToolTipRibbonToggleButtonStyle" TargetType="ribbon:RibbonToggleButton">
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="ToolTip">
                <Setter.Value>
                    <ToolTip Placement="Mouse" HasDropShadow="True">
                        <StackPanel Orientation="Horizontal" Margin="6">
                            <!--LargeImageSource -> SmallImageSource を優先-->
                            <Image Width="48" Height="48" Stretch="Uniform">
                                <Image.Source>
                                    <PriorityBinding>
                                        <Binding Path="PlacementTarget.LargeImageSource" RelativeSource="{RelativeSource AncestorType=ToolTip}"/>
                                        <Binding Path="PlacementTarget.SmallImageSource" RelativeSource="{RelativeSource AncestorType=ToolTip}"/>
                                    </PriorityBinding>
                                </Image.Source>
                            </Image>

                            <!--フォールバック: PlacementTarget.Content が SvgViewbox / Image のとき複製して表示-->
                            <ContentPresenter Content="{Binding PlacementTarget.Content, RelativeSource={RelativeSource AncestorType=ToolTip}}">
                                <ContentPresenter.ContentTemplate>
                                    <DataTemplate>
                                        <ContentControl>
                                            <ContentControl.Resources>
                                                <DataTemplate DataType="{x:Type svgc:SvgViewbox}">
                                                    <svgc:SvgViewbox Source="{Binding Source}" Width="48" Height="48" Stretch="Uniform"/>
                                                </DataTemplate>
                                                <DataTemplate DataType="{x:Type Image}">
                                                    <Image Source="{Binding Source}" Width="48" Height="48" Stretch="Uniform"/>
                                                </DataTemplate>
                                                <DataTemplate DataType="{x:Type sys:String}">
                                                    <TextBlock Text="{Binding}" FontSize="14" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </ContentControl.Resources>
                                            <ContentControl Content="{Binding}"/>
                                        </ContentControl>
                                    </DataTemplate>
                                </ContentPresenter.ContentTemplate>
                            </ContentPresenter>

                            <TextBlock Text="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ToolTip}}"
                                 Margin="12,0,0,0"
                                 VerticalAlignment="Center"
                                 TextWrapping="Wrap"/>
                        </StackPanel>
                    </ToolTip>
                </Setter.Value>
            </Setter>
        </Style>

        <!--RibbonButton 用: 大アイコンToolTip スタイル（LargeImageSource を優先し、なければ SmallImageSource。さらに Content が Svg の場合も対応）-->
        <Style x:Key="LargeIconToolTipRibbonButtonStyle" TargetType="ribbon:RibbonButton">
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="ToolTip">
                <Setter.Value>
                    <ToolTip Placement="Mouse" HasDropShadow="True">
                        <StackPanel Orientation="Horizontal" Margin="6">
                            <!--まずは Ribbon の Large/SmallImageSource を優先-->
                            <Image Width="48" Height="48" Stretch="Uniform">
                                <Image.Source>
                                    <PriorityBinding>
                                        <Binding Path="PlacementTarget.LargeImageSource" RelativeSource="{RelativeSource AncestorType=ToolTip}"/>
                                        <Binding Path="PlacementTarget.SmallImageSource" RelativeSource="{RelativeSource AncestorType=ToolTip}"/>
                                        <!--最後に PlacementTarget.Content が Svg/Image の場合をフォールバックで試す-->
                                    </PriorityBinding>
                                </Image.Source>
                            </Image>

                            <!--フォールバック：もし PlacementTarget.Content が SvgViewbox の場合は再描画-->
                            <ContentControl Visibility="Collapsed" x:Name="__SvgFallback">
                                <ContentControl.Content>
                                    <Binding RelativeSource="{RelativeSource AncestorType=ToolTip}" Path="PlacementTarget.Content"/>
                                </ContentControl.Content>
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <svgc:SvgViewbox Source="{Binding Path=Source}" Width="48" Height="48" Stretch="Uniform"/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>

                            <TextBlock Text="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ToolTip}}"
                                 Margin="12,0,0,0"
                                 VerticalAlignment="Center"
                                 TextWrapping="Wrap"/>
                        </StackPanel>
                    </ToolTip>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 大アイコンToolTip汎用スタイル -->
        <Style x:Key="LargeIconToolTipButtonStyle" TargetType="Button">
            <!-- 追加 -->
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="ToolTip">
                <Setter.Value>
                    <ToolTip Placement="Mouse" HasDropShadow="True">
                        <StackPanel Orientation="Horizontal" Margin="6">
                            <!-- 元の UIElement を再利用せず DataTemplateで複製 -->
                            <ContentPresenter Content="{Binding RelativeSource={RelativeSource AncestorType=ToolTip}, Path=PlacementTarget.Content}">
                                <ContentPresenter.ContentTemplate>
                                    <!-- ボタン Content が SvgViewbox の場合に新しいインスタンスを生成 -->
                                    <DataTemplate DataType="{x:Type svgc:SvgViewbox}">
                                        <svgc:SvgViewbox Source="{Binding Source}" Width="48" Height="48"/>
                                    </DataTemplate>
                                </ContentPresenter.ContentTemplate>
                            </ContentPresenter>

                            <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=ToolTip}, Path=PlacementTarget.Tag}"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </ToolTip>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ToggleButton用: 大アイコンToolTip汎用スタイル -->
        <Style x:Key="LargeIconToolTipToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="ToolTip">
                <Setter.Value>
                    <ToolTip Placement="Mouse" HasDropShadow="True">
                        <StackPanel Orientation="Horizontal" Margin="6">
                            <ContentPresenter Content="{Binding RelativeSource={RelativeSource AncestorType=ToolTip}, Path=PlacementTarget.Content}">
                                <ContentPresenter.ContentTemplate>
                                    <DataTemplate DataType="{x:Type svgc:SvgViewbox}">
                                        <svgc:SvgViewbox Source="{Binding Source}" Width="48" Height="48"/>
                                    </DataTemplate>
                                </ContentPresenter.ContentTemplate>
                            </ContentPresenter>
                            <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=ToolTip}, Path=PlacementTarget.Tag}"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </ToolTip>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- セグメントボタン風RadioButtonスタイル（液状化切替用） -->
        <Style x:Key="SegmentedButtonStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                BorderBrush="#999"
                                BorderThickness="1"
                                Padding="6,2"
                                Background="#F0F0F0"
                                CornerRadius="2">
                            <TextBlock x:Name="text"
                                       Text="{TemplateBinding Content}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="11"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0078D7"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#005A9E"/>
                                <Setter TargetName="text" Property="Foreground" Value="White"/>
                                <Setter TargetName="text" Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="#E0E0E0"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 荷重ケースComboBox用 ItemTemplate（解析済みインジケータ付き） -->
        <DataTemplate x:Key="LoadCaseItemTemplate">
            <StackPanel Orientation="Horizontal">
                <!-- 水平解析済み (Green) -->
                <Ellipse Width="5" Height="5" Fill="#2E7D32" Margin="0,0,1,0" VerticalAlignment="Center">
                    <Ellipse.Visibility>
                        <MultiBinding Converter="{StaticResource LoadCaseAnalyzedConverter}">
                            <Binding/>
                            <Binding Path="DataContext.CurrentModel"
                                     RelativeSource="{RelativeSource AncestorType=Window}"/>
                        </MultiBinding>
                    </Ellipse.Visibility>
                </Ellipse>
                <!-- 単杭沈下解析済み (Blue) -->
                <Ellipse Width="5" Height="5" Fill="#1565C0" Margin="0,0,1,0" VerticalAlignment="Center">
                    <Ellipse.Visibility>
                        <MultiBinding Converter="{StaticResource SettlementAnalyzedConverter}">
                            <Binding/>
                            <Binding Path="DataContext.IsVerticalAnalysisDone"
                                     RelativeSource="{RelativeSource AncestorType=Window}"/>
                        </MultiBinding>
                    </Ellipse.Visibility>
                </Ellipse>
                <!-- 群杭沈下解析済み (Orange) - VLのみ -->
                <Ellipse Width="5" Height="5" Fill="#E65100" Margin="0,0,3,0" VerticalAlignment="Center">
                    <Ellipse.Visibility>
                        <MultiBinding Converter="{StaticResource GroupSettlementAnalyzedConverter}">
                            <Binding/>
                            <Binding Path="DataContext.IsGroupPileSettlementAnalysisDone"
                                     RelativeSource="{RelativeSource AncestorType=Window}"/>
                        </MultiBinding>
                    </Ellipse.Visibility>
                </Ellipse>
                <TextBlock Text="{Binding}">
                    <TextBlock.Foreground>
                        <MultiBinding Converter="{StaticResource LoadCaseNameToColorConverter}">
                            <Binding/>
                            <Binding Path="DataContext.CurrentInputModel.LoadCasesInput.AllSeismicLoadCases"
                                     RelativeSource="{RelativeSource AncestorType=Window}"/>
                        </MultiBinding>
                    </TextBlock.Foreground>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <!-- 荷重組み合わせComboBox用 ItemTemplate（解析済みインジケータ付き） -->
        <DataTemplate x:Key="LoadCombinationItemTemplate">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="6" Height="6" Fill="#2E7D32" Margin="0,0,4,0" VerticalAlignment="Center">
                    <Ellipse.Visibility>
                        <MultiBinding Converter="{StaticResource LoadCombinationAnalyzedConverter}">
                            <Binding/>
                            <Binding Path="DataContext.SelectedLoadCaseName"
                                     RelativeSource="{RelativeSource AncestorType=Window}"/>
                            <Binding Path="DataContext.CurrentModel"
                                     RelativeSource="{RelativeSource AncestorType=Window}"/>
                        </MultiBinding>
                    </Ellipse.Visibility>
                </Ellipse>
                <TextBlock Text="{Binding}"/>
            </StackPanel>
        </DataTemplate>

        <!-- 解析済みインジケータ付きセグメントボタンスタイル -->
        <Style x:Key="AnalyzedSegmentedButtonStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                BorderBrush="#999"
                                BorderThickness="1"
                                Padding="6,2"
                                Background="#F0F0F0"
                                CornerRadius="2">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="#2E7D32"
                                         Margin="0,0,3,0" VerticalAlignment="Center"
                                         Visibility="{Binding Tag, RelativeSource={RelativeSource TemplatedParent},
                                                      Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBlock x:Name="text"
                                           Text="{TemplateBinding Content}"
                                           VerticalAlignment="Center"
                                           FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0078D7"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#005A9E"/>
                                <Setter TargetName="text" Property="Foreground" Value="White"/>
                                <Setter TargetName="text" Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="#E0E0E0"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- LoadingType 用アイコン付きアイテムテンプレート -->
        <DataTemplate x:Key="LoadingTypeItemTemplate">
            <StackPanel Orientation="Horizontal">
                <svgc:SvgViewbox Width="24" Height="24" Stretch="Uniform">
                    <svgc:SvgViewbox.Style>
                        <Style TargetType="svgc:SvgViewbox">
                            <!-- 既定アイコン（該当なし時） -->
                            <Setter Property="Source" Value="/Icons/NoPressure.svg"/>
                            <!-- 項目文字列で切替 -->
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="任意矩形">
                                    <Setter Property="Source" Value="/Icons/AnyFormPressure.svg"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding}" Value="個別十字">
                                    <Setter Property="Source" Value="/Icons/CrossFormPressure.svg"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding}" Value="個別十字（基礎梁考慮）">
                                    <Setter Property="Source" Value="/Icons/BeamedCrossFormPressure.svg"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </svgc:SvgViewbox.Style>
                </svgc:SvgViewbox>
                <TextBlock Text="{Binding}" Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <!-- 要素分割ボタン専用: 大アイコンToolTip + 動的アイコン切替 -->
        <Style x:Key="ElementDivisionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource LargeIconToolTipButtonStyle}">
            <!-- 既定アイコン -->
            <Setter Property="Content">
                <Setter.Value>
                    <svgc:SvgViewbox Source="/Icons/ElementDivisionWindow.svg"
                                     Style="{StaticResource SvgIconStyle24}"/>
                </Setter.Value>
            </Setter>
            <!-- 既定タグ（ToolTip文言） -->
            <Setter Property="Tag" Value="要素分割(未) (F4/Ctrl+D)"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsElementSplit}" Value="True">
                    <Setter Property="Content">
                        <Setter.Value>
                            <svgc:SvgViewbox Source="/Icons/ElementDivisionWindowDone.svg"
                                             Style="{StaticResource SvgIconStyle24}"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Tag" Value="要素分割(済) (F4/Ctrl+D)"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 水平解析ボタン専用: 動的アイコン切替 -->
        <Style x:Key="LateralLoadAnalysisButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource LargeIconToolTipButtonStyle}">
            <Setter Property="Content">
                <Setter.Value>
                    <svgc:SvgViewbox Source="/Icons/LateralLoadAnalysisWindow.svg"
                                     Style="{StaticResource SvgIconStyle24}"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Tag" Value="水平解析 (F5)"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHorizontalAnalysisDone}" Value="True">
                    <Setter Property="Content">
                        <Setter.Value>
                            <svgc:SvgViewbox Source="/Icons/LateralLoadAnalysisWindowDone.svg"
                                             Style="{StaticResource SvgIconStyle24}"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Tag" Value="水平解析(済●) (F5)"/>
                    <Setter Property="Foreground" Value="#2E7D32"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 単杭沈下解析ボタン専用: 動的アイコン切替 -->
        <Style x:Key="SettlementAnalysisButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource LargeIconToolTipButtonStyle}">
            <Setter Property="Content">
                <Setter.Value>
                    <svgc:SvgViewbox Source="/Icons/SettlementWindow.svg"
                                     Style="{StaticResource SvgIconStyle24}"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Tag" Value="荷重沈下関係解析 (F6)"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsVerticalAnalysisDone}" Value="True">
                    <Setter Property="Content">
                        <Setter.Value>
                            <svgc:SvgViewbox Source="/Icons/SettlementWindowDone.svg"
                                             Style="{StaticResource SvgIconStyle24}"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Tag" Value="荷重沈下関係解析(済●) (F6)"/>
                    <Setter Property="Foreground" Value="#1565C0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 群杭沈下解析ボタン専用: 動的アイコン切替 -->
        <Style x:Key="GroupPileSettlementButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource LargeIconToolTipButtonStyle}">
            <Setter Property="Content">
                <Setter.Value>
                    <svgc:SvgViewbox Source="/Icons/GroupPileSettlement.svg"
                                     Style="{StaticResource SvgIconStyle24}"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Tag" Value="群杭沈下解析 (F8)"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGroupPileSettlementAnalysisDone}" Value="True">
                    <Setter Property="Content">
                        <Setter.Value>
                            <svgc:SvgViewbox Source="/Icons/GroupPileSettlementDone.svg"
                                             Style="{StaticResource SvgIconStyle24}"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Tag" Value="群杭沈下解析(済●) (F8)"/>
                    <Setter Property="Foreground" Value="#E65100"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <ribbon:RibbonQuickAccessToolBar x:Key="MainQAT" x:Shared="False">
            <ribbon:RibbonButton ToolTip="{Binding UndoToolTip}"
                           Command="{Binding UndoCommand}"
            SmallImageSource="pack://application:,,,/Icons/Undo.png"/>

            <ribbon:RibbonButton ToolTip="{Binding RedoToolTip}"
                           Command="{Binding RedoCommand}"
            SmallImageSource="pack://application:,,,/Icons/Redo.png"/>
        </ribbon:RibbonQuickAccessToolBar>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ribbon:Ribbon Grid.Row="0"
               Margin="0"
               Padding="0"
               BorderThickness="0"
               IsMinimized="{Binding IsRibboNMinimized}"
               Visibility="{Binding IsRibbonVisible, Converter={StaticResource BooleanToVisibilityConverter}}">

