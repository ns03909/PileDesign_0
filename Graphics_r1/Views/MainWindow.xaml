                        LargeIcon="pack://application:,,,/Icons/Dashboard.png"
                        Icon="pack://application:,,,/Icons/Dashboard.png"/>
                    <Fluent:Button Header="コマンド パレット"
                        ToolTip="コマンドパレット (Ctrl+Shift+P): 機能名で検索して実行"
