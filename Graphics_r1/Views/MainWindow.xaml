                                                        <Button Command="{Binding MoveForceActionPointToAverageCenterCommand}"
                                                                VerticalAlignment="Top">
                                                            <svgc:SvgViewbox Source="/Icons/MoveActionPointToCentroid.svg" Style="{StaticResource SvgIconStyle24}"/>
                                                            <Button.ToolTip>
                                                                <StackPanel>
                                                                    <TextBlock Text="慣性力作用点を接合節点図心へ移動" />
                                                                    <TextBlock Text="すべての地震荷重ケースに対して、慣性力作用点をすべての杭配置点の図心（杭による重みづけ無し）に移動します。"/>
