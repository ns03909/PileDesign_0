         <!--RibbonToggleButton 用: 大アイコン ToolTip スタイル--> 
        <Style x:Key="LargeIconToolTipRibbonToggleButtonStyle" TargetType="ribbon:RibbonToggleButton">
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="ToolTip">
                <Setter.Value>
                    <ToolTip Placement="Mouse" HasDropShadow="True">
                        <StackPanel Orientation="Horizontal" Margin="6">
                             <!--LargeImageSource -> SmallImageSource を優先--> 
                            <Image Width="48" Height="48" Stretch="Uniform">
                                <Image.Source>
                                    <PriorityBinding>
                                        <Binding Path="PlacementTarget.LargeImageSource" RelativeSource="{RelativeSource AncestorType=ToolTip}"/>
                                        <Binding Path="PlacementTarget.SmallImageSource" RelativeSource="{RelativeSource AncestorType=ToolTip}"/>
                                    </PriorityBinding>
                                </Image.Source>
                            </Image>

                             <!--フォールバック: PlacementTarget.Content が SvgViewbox / Image のとき複製して表示--> 
                            <ContentPresenter Content="{Binding PlacementTarget.Content, RelativeSource={RelativeSource AncestorType=ToolTip}}">
                                <ContentPresenter.ContentTemplate>
                                    <DataTemplate>
                                        <ContentControl>
                                            <ContentControl.Resources>
                                                <DataTemplate DataType="{x:Type svgc:SvgViewbox}">
                                                    <svgc:SvgViewbox Source="{Binding Source}" Width="48" Height="48" Stretch="Uniform"/>
                                                </DataTemplate>
                                                <DataTemplate DataType="{x:Type Image}">
                                                    <Image Source="{Binding Source}" Width="48" Height="48" Stretch="Uniform"/>
                                                </DataTemplate>
                                                <DataTemplate DataType="{x:Type sys:String}">
                                                    <TextBlock Text="{Binding}" FontSize="14" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </ContentControl.Resources>
                                            <ContentControl Content="{Binding}"/>
                                        </ContentControl>
                                    </DataTemplate>
                                </ContentPresenter.ContentTemplate>
                            </ContentPresenter>

                            <TextBlock Text="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ToolTip}}"
                     Margin="12,0,0,0"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap"/>
                        </StackPanel>
                    </ToolTip>
                </Setter.Value>
            </Setter>
        </Style>
        
         <!--RibbonButton 用: 大アイコンToolTip スタイル（LargeImageSource を優先し、なければ SmallImageSource。さらに Content が Svg の場合も対応）--> 
        <Style x:Key="LargeIconToolTipRibbonButtonStyle" TargetType="ribbon:RibbonButton">
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="ToolTip">
                <Setter.Value>
                    <ToolTip Placement="Mouse" HasDropShadow="True">
                        <StackPanel Orientation="Horizontal" Margin="6">
                             <!--まずは Ribbon の Large/SmallImageSource を優先--> 
                            <Image Width="48" Height="48" Stretch="Uniform">
                                <Image.Source>
                                    <PriorityBinding>
                                        <Binding Path="PlacementTarget.LargeImageSource" RelativeSource="{RelativeSource AncestorType=ToolTip}"/>
                                        <Binding Path="PlacementTarget.SmallImageSource" RelativeSource="{RelativeSource AncestorType=ToolTip}"/>
                                         <!--最後に PlacementTarget.Content が Svg/Image の場合をフォールバックで試す--> 
                                    </PriorityBinding>
                                </Image.Source>
                            </Image>

                             <!--フォールバック：もし PlacementTarget.Content が SvgViewbox の場合は再描画--> 
                            <ContentControl Visibility="Collapsed" x:Name="__SvgFallback">
                                <ContentControl.Content>
                                    <Binding RelativeSource="{RelativeSource AncestorType=ToolTip}" Path="PlacementTarget.Content"/>
                                </ContentControl.Content>
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <svgc:SvgViewbox Source="{Binding Path=Source}" Width="48" Height="48" Stretch="Uniform"/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>

                            <TextBlock Text="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ToolTip}}"
                     Margin="12,0,0,0"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap"/>
                        </StackPanel>
                    </ToolTip>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 大アイコンToolTip汎用スタイル -->
        <Style x:Key="LargeIconToolTipButtonStyle" TargetType="Button">
            <!-- 追加 -->
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="ToolTip">
                <Setter.Value>
                    <ToolTip Placement="Mouse" HasDropShadow="True">
                        <StackPanel Orientation="Horizontal" Margin="6">
                            <!-- 元の UIElement を再利用せず DataTemplateで複製 -->
                            <ContentPresenter Content="{Binding RelativeSource={RelativeSource AncestorType=ToolTip}, Path=PlacementTarget.Content}">
                                <ContentPresenter.ContentTemplate>
                                    <!-- ボタン Content が SvgViewbox の場合に新しいインスタンスを生成 -->
                                    <DataTemplate DataType="{x:Type svgc:SvgViewbox}">
                                        <svgc:SvgViewbox Source="{Binding Source}" Width="48" Height="48"/>
                                    </DataTemplate>
                                </ContentPresenter.ContentTemplate>
                            </ContentPresenter>

                            <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=ToolTip}, Path=PlacementTarget.Tag}"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </ToolTip>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ToggleButton用: 大アイコンToolTip汎用スタイル -->
        <Style x:Key="LargeIconToolTipToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="ToolTip">
                <Setter.Value>
                    <ToolTip Placement="Mouse" HasDropShadow="True">
                        <StackPanel Orientation="Horizontal" Margin="6">
                            <ContentPresenter Content="{Binding RelativeSource={RelativeSource AncestorType=ToolTip}, Path=PlacementTarget.Content}">
                                <ContentPresenter.ContentTemplate>
                                    <DataTemplate DataType="{x:Type svgc:SvgViewbox}">
                                        <svgc:SvgViewbox Source="{Binding Source}" Width="48" Height="48"/>
                                    </DataTemplate>
                                </ContentPresenter.ContentTemplate>
                            </ContentPresenter>
                            <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=ToolTip}, Path=PlacementTarget.Tag}"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </ToolTip>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- LoadingType 用アイコン付きアイテムテンプレート -->
        <DataTemplate x:Key="LoadingTypeItemTemplate">
            <StackPanel Orientation="Horizontal">
                <svgc:SvgViewbox Width="24" Height="24" Stretch="Uniform">
                    <svgc:SvgViewbox.Style>
                        <Style TargetType="svgc:SvgViewbox">
                            <!-- 既定アイコン（該当なし時） -->
                            <Setter Property="Source" Value="/Icons/NoPressure.svg"/>
                            <!-- 項目文字列で切替 -->
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="任意矩形">
                                    <Setter Property="Source" Value="/Icons/AnyFormPressure.svg"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding}" Value="個別十字">
                                    <Setter Property="Source" Value="/Icons/CrossFormPressure.svg"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </svgc:SvgViewbox.Style>
                </svgc:SvgViewbox>
                <TextBlock Text="{Binding}" Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
        
        <!-- 要素分割ボタン専用: 大アイコンToolTip + 動的アイコン切替 -->
        <Style x:Key="ElementDivisionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource LargeIconToolTipButtonStyle}">
            <!-- 既定アイコン -->
            <Setter Property="Content">
                <Setter.Value>
                    <svgc:SvgViewbox Source="/Icons/ElementDivisionWindow.svg"
                                     Style="{StaticResource SvgIconStyle16}"/>
                </Setter.Value>
            </Setter>
            <!-- 既定タグ（ToolTip文言） -->
            <Setter Property="Tag" Value="要素分割(未)"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsElementSplit}" Value="True">
                    <Setter Property="Content">
                        <Setter.Value>
                            <svgc:SvgViewbox Source="/Icons/ElementDivisionWindowDone.svg"
                                             Style="{StaticResource SvgIconStyle16}"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Tag" Value="要素分割(済)"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

