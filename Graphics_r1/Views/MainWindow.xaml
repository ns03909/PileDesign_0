<Window x:Class="PileDesign.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PileDesign.ViewModels"
        xmlns:conv="clr-namespace:PileDesign.Converters"
        xmlns:h="clr-namespace:HelixToolkit.Wpf;assembly=HelixToolkit.Wpf"
        xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:linq="clr-namespace:System.Linq;assembly=System.Core"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:svg="http://sharpvectors.codeplex.com/runtime/"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        xmlns:views="clr-namespace:PileDesign.Views"
        xmlns:common="clr-namespace:PileDesign.Common"
        xmlns:ribbon="clr-namespace:System.Windows.Controls.Ribbon;assembly=System.Windows.Controls.Ribbon"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        Title="杭検討プログラム プレプロト-0.1" Height="800" Width="1200" WindowState="Maximized"
        x:Name="MainWin"
        ToolTipService.InitialShowDelay="10">

    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
    </Window.InputBindings>

    <Window.DataContext>
        <local:MainWindowViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <conv:BooleanToContentConverter x:Key="BooleanToContentConverter"/>
        <conv:VisibilityConverter x:Key="VisibilityConverter"/>
        <conv:PileTopAltitudeConverter x:Key="PileTopAltitudeConverterInstance" />
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:BooleanNegationConverter x:Key="BooleanNegationConverter" />
        <conv:SubscriptConverter x:Key="SubscriptConverter" />
        <conv:LoadCaseNameInSeismicCasesToVisibilityConverter x:Key="LoadCaseNameInSeismicCasesToVisibilityConverter"/>
        <conv:AnalysisResultContentEqualsToVisibilityConverter x:Key="AnalysisResultContentEqualsToVisibilityConverter"/>
        <conv:MidSpanAndPileTopVisibilityConverter x:Key="MidSpanAndPileTopVisibilityConverter"/>
        <conv:ResultValueAndMidSpanAndPileTopVisibilityConverter x:Key="ResultValueAndMidSpanAndPileTopVisibilityConverter"/>
        <conv:LogSliderConverter x:Key="LogSliderConverter" LogMin="0.1" LogMax="1000"/>
        <conv:OutOfRangeToBoolConverter x:Key="OutOfRangeToBoolConverter"/>
        <!--<FrameworkElement x:Key="ProxyElement" DataContext="{Binding ElementName=MainWin, Path=DataContext}"/>-->

        <ContextMenu x:Key="NodeContextMenu">
            <MenuItem Header="コピー／平面移動" Command="{Binding MoveCopyPilesCommand}"/>
            <MenuItem Header="プロパティ変更／追加" Command="{Binding EditAddPilesCommand}"/>
            <MenuItem Header="削除" Command="{Binding DeletePilesCommand}"/>
            <MenuItem Header="選択解除" Command="{Binding DeselectPilesCommand}"/>
            <MenuItem Header="画像保存" Command="{Binding ImageSaveCommand}"/>
        </ContextMenu>

        <ContextMenu x:Key="CommonDataGridContextMenu" Opened="ContextMenu_Opened">
            <MenuItem Click="ExportCsvFromContextMenu_Click">
                <MenuItem.Icon>
                    <svgc:SvgViewbox Source="/Icons/CSVFileOutput.svg" Style="{DynamicResource SvgIconStyle16}"/>
                </MenuItem.Icon>
                <MenuItem.Header>
                    <TextBlock Text="CSVファイル出力"/>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem Header="コピー" Command="{Binding CopyDataGridSelectionCommand}"
                      CommandParameter="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </ContextMenu>
        <!-- DataGridCellのスタイルを定義 -->
        <!--<Style x:Key="CustomDataGridCellStyle" TargetType="DataGridCell">
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#62B0E2"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="White"/>
                    <Setter Property="BorderThickness" Value="0.75"/>
                </Trigger>
            </Style.Triggers>
        </Style>-->


        <!-- 共通のスタイルを定義 -->
        <Style x:Key="RightAlignedTextBlockStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <Style x:Key="RightAlignedDataCellStyle" TargetType="DataGridCell">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <!-- Style for ComboBox elements to right-align text -->
        <Style x:Key="RightAlignedComboBoxStyle" TargetType="ComboBox">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <!-- Style for ComboBox items to right-align text -->
        <Style x:Key="RightAlignedComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <Style x:Key="OpenElementDivisionWindowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsElementSplit}" Value="True">
                    <Setter Property="Background" Value="#62B0E2"/>
                    <Setter Property="Foreground" Value="White"/>

                </DataTrigger>
                <DataTrigger Binding="{Binding IsElementSplit}" Value="False">
                    <Setter Property="Background" Value="#F7B515"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Style for VerticalAnalyseButtonStyle -->
        <Style x:Key="VerticalAnalyseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsElementSplit}" Value="False">
                    <Setter Property="Background" Value="LightGray"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsElementSplit}" Value="True"/>
                        <Condition Binding="{Binding IsVerticalAnalysisDone}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#F7B515"/>
                    <Setter Property="Foreground" Value="White"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsElementSplit}" Value="True"/>
                        <Condition Binding="{Binding IsVerticalAnalysisDone}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#62B0E2"/>
                    <Setter Property="Foreground" Value="White"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Style for HorizontalAnalyseButtonStyle -->
        <Style x:Key="HorizontalAnalyseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsElementSplit}" Value="False">
                    <Setter Property="Background" Value="LightGray"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsElementSplit}" Value="True"/>
                        <Condition Binding="{Binding IsHorizontalAnalysisDone}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#F7B515"/>
                    <Setter Property="Foreground" Value="White"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsElementSplit}" Value="True"/>
                        <Condition Binding="{Binding IsHorizontalAnalysisDone}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#62B0E2"/>
                    <Setter Property="Foreground" Value="White"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OpenGroupPileSettlementWindowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGroupPileSettlementAnalysisDone}" Value="True">
                    <Setter Property="Background" Value="#62B0E2"/>
                    <Setter Property="Foreground" Value="White"/>

                </DataTrigger>
                <DataTrigger Binding="{Binding IsGroupPileSettlementAnalysisDone}" Value="False">
                    <Setter Property="Background" Value="#F7B515"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Imageコントロール用のスタイルを定義 -->
        <Style x:Key="IconImageStyle" TargetType="Image">
            <Setter Property="Width" Value="16px"/>
            <Setter Property="Height" Value="16px"/>
        </Style>

        <!-- SvgViewboxコントロール用のスタイルを定義 -->
        <Style x:Key="SvgIconStyle16" TargetType="svgc:SvgViewbox">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="StretchDirection" Value="DownOnly"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        
        <Style x:Key="SvgIconStyle24" TargetType="svgc:SvgViewbox">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="StretchDirection" Value="DownOnly"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="SvgIconStyle32" TargetType="svgc:SvgViewbox">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="StretchDirection" Value="DownOnly"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- ToolTipのスタイルを定義 -->
        <Style TargetType="ToolTip" x:Key="DeepBlueToolTipStyle">
            <Setter Property="Foreground" Value="#3271AD"/>
            <!-- フォントの色を赤に設定 -->
        </Style>

        <!-- ToolTipのスタイルを定義 -->
        <Style TargetType="ToolTip" x:Key="BrownToolTipStyle">
            <Setter Property="Foreground" Value="Brown"/>
            <!-- フォントの色を赤に設定 -->
        </Style>


        <!-- 特定の列ヘッダーの色を変更するスタイル -->
        <Style x:Key="GreenHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="#238966"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="YellowHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="#F7B515"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DeepBlueHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="#3271AD"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PaleRedHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="#E95541"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CrimsonHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="#D82531"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Vertical"  Grid.Row="0" Margin="0,0,0,0">

            <Menu Margin="0,0,0,5">
                <MenuItem Header="ファイル">

                    <MenuItem Command="{Binding NewInputModelFileCommand}" InputGestureText="Ctrl+N">
                        <!--<MenuItem.Icon>
                            <svgc:SvgViewbox Source="/Icons/OpenFile.svg" Style="{StaticResource SvgIconStyle16}"/>
                        </MenuItem.Icon>-->
                        <MenuItem.Header>
                            <TextBlock Text="新規"/>
                        </MenuItem.Header>
                    </MenuItem>

                    <MenuItem Command="{Binding OpenInputModelFileCommand}" InputGestureText="Ctrl+O">
                        <MenuItem.Icon>
                            <svgc:SvgViewbox Source="/Icons/OpenFile.svg" Style="{StaticResource SvgIconStyle16}"/>
                        </MenuItem.Icon>
                        <MenuItem.Header>
                            <TextBlock Text="開く"/>
                        </MenuItem.Header>
                    </MenuItem>

                    <MenuItem Command="{Binding SaveInputModelFileCommand}" InputGestureText="Ctrl+S">
                        <MenuItem.Icon>
                            <svgc:SvgViewbox Source="/Icons/SaveFile.svg" Style="{StaticResource SvgIconStyle16}"/>
                        </MenuItem.Icon>
                        <MenuItem.Header>
                            <TextBlock Text="保存"/>
                        </MenuItem.Header>
                    </MenuItem>

                    <MenuItem Command="{Binding SaveInputModelFileAsCommand}" InputGestureText="Ctrl+Shift+S">
                        <MenuItem.Icon>
                            <svgc:SvgViewbox Source="/Icons/SaveFile.svg" Style="{StaticResource SvgIconStyle16}"/>
                        </MenuItem.Icon>
                        <MenuItem.Header>
                            <TextBlock Text="名前を付けて保存"/>
                        </MenuItem.Header>
                    </MenuItem>

                    <MenuItem Command="{Binding OpenDocxOutputWindowCommand}">
                        <MenuItem.Icon>
                            <svgc:SvgViewbox Source="/Icons/DocxFileOutput.svg" Style="{StaticResource SvgIconStyle16}"/>
                        </MenuItem.Icon>
                        <MenuItem.Header>
                            <TextBlock Text="Docxファイル出力"/>
                        </MenuItem.Header>
                    </MenuItem>
                </MenuItem>

                <MenuItem Header="編集">
                    <MenuItem Header="基本設定" Command="{Binding OpenFundamentalWindowCommand}">
                        <MenuItem.Icon>
                            <svgc:SvgViewbox Source="/Icons/FundamentalWindow.svg" Style="{StaticResource SvgIconStyle16}"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="荷重ケース編集" Command="{Binding OpenLoadCaseWindowCommand}" InputGestureText="Ctrl + L">
                        <MenuItem.Icon>
                            <svgc:SvgViewbox Source="/Icons/LoadCaseWindow.svg" Style="{StaticResource SvgIconStyle16}"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="地盤編集" Command="{Binding OpenGroundWindowCommand}" InputGestureText="Ctrl + G">
                        <MenuItem.Icon>
                            <svgc:SvgViewbox Source="/Icons/GroundWindow.svg" Style="{StaticResource SvgIconStyle16}"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="杭体編集" Command="{Binding OpenPileBodyWindowCommand}" InputGestureText="Ctrl + B">
                        <MenuItem.Icon>
                            <svgc:SvgViewbox Source="/Icons/PileBodyWindow.svg" Style="{StaticResource SvgIconStyle16}"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="軸力確認" Command="{Binding AxialForceCheckCommand}" InputGestureText="Ctrl + K">
                        <!--<MenuItem.Icon>
                            <svgc:SvgViewbox Source="/Icons/DocxFileOutput.svg" Style="{StaticResource SvgIconStyle16}"/>
                        </MenuItem.Icon>-->
                    </MenuItem>
                    <MenuItem Header="杭セット・根入部セット要素分割" Command="{Binding OpenElementDivisionWindowCommand}" InputGestureText="Ctrl + D">
                        <MenuItem.Icon>
                            <svgc:SvgViewbox Source="/Icons/ElementDivisionWindow.svg" Style="{StaticResource SvgIconStyle16}"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>

                <MenuItem Header="解析実行">
                    <MenuItem Header="水平解析" Command="{Binding OpenLateralLoadAnalysisWindowCommand}" InputGestureText="F5">
                        <MenuItem.Icon>
                            <svgc:SvgViewbox Source="/Icons/LateralLoadAnalysisWindow.svg" Style="{StaticResource SvgIconStyle16}"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="単杭沈下解析" Command="{Binding OpenSettlementWindowCommand}" InputGestureText="F6">
                        <MenuItem.Icon>
                            <svgc:SvgViewbox Source="/Icons/SettlementWindow.svg" Style="{StaticResource SvgIconStyle16}"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>

                <MenuItem Header="結果">
                    <MenuItem Header="グラフ表示" Command="{Binding OpenGraphWindowCommand}">
                        <svgc:SvgViewbox Source="/Icons/Graph.svg" Style="{StaticResource SvgIconStyle16}"/>
                    </MenuItem>
                    <MenuItem Header="テーブル表示">
                        <svgc:SvgViewbox Source="/Icons/Table.svg" Style="{StaticResource SvgIconStyle16}"/>
                    </MenuItem>
                </MenuItem>

                <MenuItem Header="計算例">
                    <MenuItem Header="基礎指針'19計算例5" Command="{Binding Example5Command}"/>
                    <MenuItem Header="基礎指針'19計算例9" Command="{Binding Example9Command}"/>
                </MenuItem>

                <!--<MenuItem Header="ツール">
                    <MenuItem Header="オプション" Command="{Binding OpenOptionWindowCommand}">
                    </MenuItem>
                </MenuItem>-->
                <MenuItem Header="ヘルプ">
                    <MenuItem Header="ヘルプ" Command="{Binding OpenHelpWindowCommand}" InputGestureText="F1"/>
                    <MenuItem Header="クイックヒント" Command="{Binding QuickHintCommand}" InputGestureText="Shift + F1"/>
                    <MenuItem Header="ショートカットキー一覧" Command="{Binding OpenShortcutKeysWindowCommand}" InputGestureText="Ctrl + /"/>
                </MenuItem>
                <!--<MenuItem Header="ヘルプ" Command="{Binding OpenHelpWindowCommand}" InputGestureText="F1">
                </MenuItem>-->
            </Menu>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0" Grid.ColumnSpan="2">

                    <Button x:Name="ButtonFundamental" ToolTip="基本設定" 
                            Command="{Binding OpenFundamentalWindowCommand}">
                        <svgc:SvgViewbox Source="/Icons/FundamentalWindow.svg" Style="{StaticResource SvgIconStyle32}"/>
                    </Button>

                    <Button x:Name="ButtonLoadCase" ToolTip="荷重条件"
                            Command="{Binding OpenLoadCaseWindowCommand}">
                        <svgc:SvgViewbox Source="/Icons/LoadCaseWindow.svg" Style="{StaticResource SvgIconStyle32}"/>
                    </Button>

                    <Button x:Name="ButtonGround" ToolTip="地盤" 
                            PreviewMouseDown="ButtonGround_PreviewMouseDown"
                            Command="{Binding OpenGroundWindowCommand}">
                        <svgc:SvgViewbox Source="/Icons/GroundWindow.svg" Style="{StaticResource SvgIconStyle32}"/>
                    </Button>

                    <Button x:Name="ButtonPileBody" ToolTip="杭体" 
                            PreviewMouseDown="ButtonPileBody_PreviewMouseDown"
                            Command="{Binding OpenPileBodyWindowCommand}">
                        <svgc:SvgViewbox Source="/Icons/PileBodyWindow.svg" Style="{StaticResource SvgIconStyle32}"/>
                    </Button>

                    <Rectangle Width="5" Height="18" Fill="LightGray"/>

                    <!--軸力-->
                    <Button x:Name="ButtonAxialForceCheck" Content="軸力確認" Width="70" Margin="5,0,5,0"
                            PreviewMouseDown="ButtonPileBody_PreviewMouseDown"
                            Command="{Binding AxialForceCheckCommand}"/>


                    <!--要素分割-->
                    <Button x:Name="ButtonExecuteAnalyse"
                            Content="{Binding IsElementSplit, UpdateSourceTrigger=LostFocus,
                            Converter={StaticResource BooleanToContentConverter}, ConverterParameter='要素分割(済),要素分割(未)'}"
                            Width="70" Margin="5,0,5,0"
                            Command="{Binding OpenElementDivisionWindowCommand}"
                            Style="{StaticResource OpenElementDivisionWindowButtonStyle}"/>

                    <Button x:Name="ButtonLateralLoadAnalysisSettlement" 
                            Content="{Binding IsHorizontalAnalysisDone, UpdateSourceTrigger=LostFocus,
                            Converter={StaticResource BooleanToContentConverter}, ConverterParameter='水平解析(済),水平解析(未)'}"
                            Width="100" Margin="5,0,5,0"
                            Command="{Binding OpenLateralLoadAnalysisWindowCommand}"
                            Style="{StaticResource HorizontalAnalyseButtonStyle}"
                            IsEnabled="{Binding IsElementSplit, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <Button x:Name="ButtonSettlement" 
                            Content="{Binding IsVerticalAnalysisDone, UpdateSourceTrigger=LostFocus,
                            Converter={StaticResource BooleanToContentConverter}, ConverterParameter='単杭沈下解析(済),単杭沈下解析(未)'}"
                            Width="100" Margin="5,0,5,0"
                            PreviewMouseDown="ButtonButtonSettlement_PreviewMouseDown"      
                            Command="{Binding OpenSettlementWindowCommand}"
                            Style="{StaticResource VerticalAnalyseButtonStyle}"
                            IsEnabled="{Binding IsElementSplit, Converter={StaticResource BooleanToVisibilityConverter}}"/>


                    <Separator Width="1" Height="24" Margin="5,5" 
                               BorderBrush="Black" BorderThickness="100"/>
                    <Rectangle Width="5" Height="18" Fill="LightGray"/>

                    <Button x:Name ="ButtonGroupPileSettlement"
                            Content="{Binding IsGroupPileSettlementAnalysisDone, UpdateSourceTrigger=LostFocus,
                            Converter={StaticResource BooleanToContentConverter}, ConverterParameter='群杭沈下解析(済),群杭沈下解析(未)'}"
                            Width="100" Margin="5,0,5,0"
                            Style="{StaticResource OpenGroupPileSettlementWindowButtonStyle}"
                            Click="ButtonGroupPileSettlement_Click"/>
                    <!--Command="{Binding OpenGroupPileSettlementAnalysisWindowCommand}"
                    Command="{Binding OpenPileBodyWindowCommand}"/>-->

                </StackPanel>
