                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <ComboBox DisplayMemberPath="Display"
                                                                      SelectedValuePath="Key"
                                                                      SelectedValue="{Binding NodeI_Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
