                                                        IsOpen="{Binding IsQuickHintVisible}"
                                                        StaysOpen="False"
                                                       AllowsTransparency="True"
                                                       PopupAnimation="Fade">
                                                    <views:QuickHintBubble HintText="Step 5 杭配置：右クリックメニューの「コピー/移動」で杭位置を移動"/>
                                                </Popup>

