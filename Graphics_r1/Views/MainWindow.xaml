                                                                <StackPanel>
                                                                    <TextBlock Text="X" TextAlignment="Center"/>
                                                                    <TextBlock Text="(m)" TextAlignment="Center"
                                                                   HorizontalAlignment="Center"/>
                                                                </StackPanel>
                                                            </DataGridTextColumn.Header>
                                                        </DataGridTextColumn>

                                                        <DataGridTextColumn  Width="*" IsReadOnly="True" Binding="{Binding Y, StringFormat=N3}"
