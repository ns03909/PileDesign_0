                    </ribbon:RibbonSplitButton>
                    <ribbon:RibbonToggleButton Label="要素縮小表示" ToolTip="要素の端点を縮小して節点が見やすくします。"
                                                IsChecked="{Binding IsShrinkElementMode}"
                                                SmallImageSource="pack://application:,,,/Icons/ShrinkElementMode.png"/>
                    <!-- 杭系 -->
                    <ribbon:RibbonToggleButton Label="根入部形状" ToolTip="根入部形状の表示／非表示を切り替えます。"
                                                IsChecked="{Binding IsEmbedmentBoxVisible}"
