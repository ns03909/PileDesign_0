                                                            <LineBreak/>
                                                            <Run Text="点と直線の重なりの判定は、その距離が分割距離以下か否かで行います。"/>
                                                        </TextBlock>
                                                    </TextBox.ToolTip>
                                                </TextBox>
                                                <Button ToolTip="選択要素を等分割し、分割点に一般節点を生成します"
                                                        Command="{Binding EqualDivideElementsCommand}" Margin="8,0,0,0">
