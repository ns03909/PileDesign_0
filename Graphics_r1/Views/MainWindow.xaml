                        LargeIcon="pack://application:,,,/Icons/CommandPalette.png"
                        Icon="pack://application:,,,/Icons/CommandPalette.png"/>
                    <Fluent:Button Header="編集履歴"
                        ToolTip="Undo/Redo 履歴の一覧表示・任意ジャンプ"
                        Click="OpenEditHistoryPanel_Click"
                        LargeIcon="pack://application:,,,/Icons/History.png"
                        Icon="pack://application:,,,/Icons/History.png"/>
                </Fluent:RibbonGroupBox>


            </Fluent:RibbonTabItem>

            <Fluent:RibbonTabItem Header="ウィンドウ(W)" KeyTip="W">
                <Fluent:RibbonGroupBox Header="パネル" ToolTip="パネル">
                    <Fluent:ToggleButton x:Name="LeftTabsToggle"
                                         Header="データ タブ"
                                         ToolTip="データタブ（一般節点～群杭荷重）の表示/非表示"
                                         IsChecked="True"
                                         Click="ToggleLeftTabs_Click"
                                         LargeIcon="pack://application:,,,/Icons/DataTabVisible.png"
                                         Icon="pack://application:,,,/Icons/DataTabVisible.png"/>
                    <Fluent:ToggleButton x:Name="PropertiesPanelToggle"
                                         Header="プロパティ"
                                         ToolTip="プロパティパネルの表示/非表示"
                                         IsChecked="True"
                                         Click="TogglePropertiesPanel_Click"
                                         LargeIcon="pack://application:,,,/Icons/PropertyVisible.png"
                                         Icon="pack://application:,,,/Icons/PropertyVisible.png"/>
                    <Fluent:ToggleButton x:Name="MinimapPanelToggle"
                                         Header="ミニ マップ"
                                         ToolTip="ミニマップパネルの表示/非表示"
                                         IsChecked="True"
                                         Click="ToggleMinimapPanel_Click"
                                         LargeIcon="pack://application:,,,/Icons/MiniMapVisible.png"
                                         Icon="pack://application:,,,/Icons/MiniMapVisible.png"/>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="3Dビュー" ToolTip="3Dビュー">
                    <Fluent:ToggleButton Header="ビュー キューブ"
                                                ToolTip="ビューキューブの表示/非表示"
                                                IsChecked="{Binding IsViewCubeVisible}"
