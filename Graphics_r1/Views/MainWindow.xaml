                                                    <svgc:SvgViewbox Source="/Icons/SwapBeamIJ.svg" Style="{StaticResource SvgIconStyle24}"/>
                                                </Button>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="4,2">
                                                <Button ToolTip="選択要素を重なる一般節点で分割します (Alt + 7)"
