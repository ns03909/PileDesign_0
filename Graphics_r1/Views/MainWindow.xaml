                        <ribbon:RibbonApplicationMenuItem.ItemContainerStyle>
                            <Style TargetType="ribbon:RibbonApplicationMenuItem">
                                <Setter Property="Header" Value="{Binding DisplayName}"/>
                                <Setter Property="ToolTip" Value="{Binding FilePath}"/>
                                <Setter Property="Command" Value="{Binding DataContext.OpenFromMruCommand, RelativeSource={RelativeSource AncestorType=ribbon:Ribbon}}"/>
                                <Setter Property="CommandParameter" Value="{Binding FilePath}"/>
                            </Style>
                        </ribbon:RibbonApplicationMenuItem.ItemContainerStyle>
                    </ribbon:RibbonApplicationMenuItem>
                    <ribbon:RibbonSeparator/>

                    <ribbon:RibbonApplicationMenuItem Command="{Binding SaveInputModelFileCommand}" ImageSource="pack://application:,,,/Icons/SaveFile.png">
                        <ribbon:RibbonApplicationMenuItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="保存"/>
                                <TextBlock Text="Ctrl+S" Foreground="Gray" Margin="12,0,0,0"/>
                            </StackPanel>
                        </ribbon:RibbonApplicationMenuItem.Header>
                    </ribbon:RibbonApplicationMenuItem>

                    <ribbon:RibbonApplicationMenuItem Command="{Binding SaveInputModelFileAsCommand}" ImageSource="pack://application:,,,/Icons/SaveFile.png">
                        <ribbon:RibbonApplicationMenuItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="名前を付けて保存"/>
                                <TextBlock Text="Ctrl+Shift+S" Foreground="Gray" Margin="12,0,0,0"/>
                            </StackPanel>
                        </ribbon:RibbonApplicationMenuItem.Header>
                    </ribbon:RibbonApplicationMenuItem>

                    <ribbon:RibbonApplicationMenuItem Command="{Binding OpenDocxOutputWindowCommand}" ImageSource="pack://application:,,,/Icons/DocxFileOutput.png">
                        <ribbon:RibbonApplicationMenuItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Docxファイル出力"/>
                                <TextBlock Text="(なし)" Foreground="Gray" Margin="12,0,0,0"/>
                            </StackPanel>
                        </ribbon:RibbonApplicationMenuItem.Header>
                    </ribbon:RibbonApplicationMenuItem>

                    <!-- ダミー項目（メニューの高さ確保用） -->
                    <ribbon:RibbonApplicationMenuItem IsEnabled="False" Focusable="False">
                        <!-- 中身は透明なボーダー。Height を変更して高さを調整 -->
                        <Border Height="120" Background="Transparent" IsHitTestVisible="False"/>
                    </ribbon:RibbonApplicationMenuItem>

                    <!-- ダミー項目（メニューの高さ確保用） -->
                    <ribbon:RibbonApplicationMenuItem IsEnabled="False" Focusable="False">

                        <!-- 中身は透明なボーダー。Height を変更して高さを調整 -->
                        <Border Height="120" Background="Transparent" IsHitTestVisible="False"/>
                    </ribbon:RibbonApplicationMenuItem>

                    <ribbon:RibbonApplicationMenuItem IsEnabled="False" Focusable="False">
                        <!-- 中身は透明なボーダー。Height を変更して高さを調整 -->
                        <Border Height="120" Background="Transparent" IsHitTestVisible="False"/>
                    </ribbon:RibbonApplicationMenuItem>

                    <ribbon:RibbonApplicationMenuItem IsEnabled="False" Focusable="False">
                        <!-- 中身は透明なボーダー。Height を変更して高さを調整 -->
                        <Border Height="120" Background="Transparent" IsHitTestVisible="False"/>
                    </ribbon:RibbonApplicationMenuItem>

                    <ribbon:RibbonApplicationMenuItem IsEnabled="False" Focusable="False">
                        <!-- 中身は透明なボーダー。Height を変更して高さを調整 -->
                        <Border Height="120" Background="Transparent" IsHitTestVisible="False"/>
                    </ribbon:RibbonApplicationMenuItem>

                    <!-- 計算例: 右側補助ペイン -->
                    <ribbon:RibbonApplicationMenu.AuxiliaryPaneContent >
                        <Border BorderBrush="Gray" BorderThickness="0" Background="White" MinWidth="320" Padding="6" ClipToBounds="True">
