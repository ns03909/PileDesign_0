                                                                    <MultiBinding Converter="{StaticResource NodeOptionFilterConverter}">
                                                                        <Binding Path="DataContext.CurrentInputModel.AvailableNodeReferenceOptions" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                        <Binding Path="NodeJ_Key"/>
                                                                    </MultiBinding>
                                                                </ComboBox.ItemsSource>
                                                            </ComboBox>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

