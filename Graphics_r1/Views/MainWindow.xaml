                        </TabControl>
                    </avalonDock:LayoutDocument>

                            <avalonDock:LayoutDocument Title="杭" CanClose="False" x:Name="PileLayoutDocument" IsSelected="True">
                                <TabControl x:Name="PileTabControl">
