        <avalonDock:DockingManager x:Name="dockingManager" Grid.Row="1">
            <avalonDock:LayoutRoot>
                <avalonDock:LayoutPanel Orientation="Horizontal">
                    <avalonDock:LayoutAnchorablePane DockWidth="Auto">
                        <avalonDock:LayoutAnchorable x:Name="inputDataAnchorable" Title="入力データ"
                                                     CanClose="False" CanHide="False" CanAutoHide="True" AutoHideWidth="250">
                            <TreeView x:Name="TreeViewControl" ItemsSource="{Binding CTreeViewDatas}">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate DataType="{x:Type local:CTreeViewData}"
                                                              ItemsSource="{Binding Children}">
                                        <TextBlock Text="{Binding Name}" Foreground="{Binding TextColor}"/>
                                        <HierarchicalDataTemplate.ItemTemplate>
                                            <HierarchicalDataTemplate DataType="{x:Type local:CTreeViewData}"
                                                                      ItemsSource="{Binding Children}">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{Binding TextColor}"/>

                                                <HierarchicalDataTemplate.ItemTemplate>
                                                    <HierarchicalDataTemplate DataType="{x:Type local:CTreeViewData}"                      
                                                                  ItemsSource="{Binding Children}">
                                                        <TextBlock Text="{Binding Name}"
                                                                    Foreground="{Binding TextColor}"/>

                                                    </HierarchicalDataTemplate>
                                                </HierarchicalDataTemplate.ItemTemplate>
                                            </HierarchicalDataTemplate>
                                        </HierarchicalDataTemplate.ItemTemplate>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </avalonDock:LayoutAnchorable>
                    </avalonDock:LayoutAnchorablePane>

                    <avalonDock:LayoutDocumentPaneGroup DockWidth="1*">
                        <avalonDock:LayoutDocumentPane>
                            <avalonDock:LayoutDocument Title="杭"
                                                       CanClose="False"
                                                       x:Name="PileLayoutDocument">
                                <TabControl x:Name="PileTabControl">
                                    <TabItem Header="配置" ToolTip="杭配置を編集します">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!--<ToolBar>-->
                                            <StackPanel Grid.Row="0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                                                        <Button x:Name="ButtonAddPile"
                                                            ToolTip="杭配置追加"
                                                            Foreground="white"
                                                            Background="#62B0E2"
                                                            Command="{Binding AddPileCommand}" VerticalAlignment="Top">
                                                            <svgc:SvgViewbox Source="/Icons/AddPileLoc.svg" Style="{StaticResource SvgIconStyle24}"/>
                                                        </Button>
                                                        <Button  Command="{Binding MoveForceActionPointToAverageCenterCommand}" >
                                                            <svgc:SvgViewbox Source="/Icons/MoveActionPointToCentroid.svg" Style="{StaticResource SvgIconStyle24}"/>
                                                            <Button.ToolTip>
                                                                <StackPanel>
                                                                    <TextBlock Text="慣性力作用点杭配置図心移動" />
                                                                    <TextBlock Text="慣性力作用点をすべての杭配置点の図心（杭による重みづけなし）に移動します"/>
                                                                </StackPanel>
                                                            </Button.ToolTip>
                                                        </Button>

                                                        <Button 
                                                            Command="{Binding GroupPileFactorCommand}" >
                                                            <svgc:SvgViewbox Source="/Icons/GroupPileGraph.svg" Style="{StaticResource SvgIconStyle24}"/>
                                                            <Button.ToolTip>
                                                                <StackPanel>
                                                                    <TextBlock Text="群杭係数グラフ確認（基礎指針'19）" />
                                                                    <TextBlock Text="群杭係数、杭間隔比を設定するために参照します"/>
                                                                </StackPanel>
                                                            </Button.ToolTip>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <Popup x:Name="QuickHintPopup1"
                                                        PlacementTarget="{Binding ElementName=ButtonAddPile}"
                                                        Placement="Bottom"
                                                        IsOpen="{Binding IsQuickHintVisible}"
                                                        StaysOpen="False">
                                                    <views:QuickHintBubble HintText="①[杭配置追加」ボタンで杭を追加" />
                                                </Popup>
                                                
                                                <Popup x:Name="QuickHintPopup2"
                                                        PlacementTarget="{Binding ElementName=Canvas3DLayout}"
                                                        Placement="Center"
                                                        IsOpen="{Binding IsQuickHintVisible}"
                                                        StaysOpen="False">
                                                    <views:QuickHintBubble HintText="②右クリックメニューから「コピー/移動」で杭位置を移動" />
                                                </Popup>

                                                <Popup x:Name="QuickHintPopup0"
                                                        PlacementTarget="{Binding ElementName=Canvas3DLayout}"
                                                        Placement="Top"
                                                        IsOpen="{Binding IsQuickHintVisible}"
                                                        StaysOpen="False">
                                                    <views:QuickHintBubble HintText="最短の実行手順" FontSize="20"/>
                                                </Popup>


                                                <Popup x:Name="QuickHintPopup4"
                                                        PlacementTarget="{Binding ElementName=TabItemAxialForce}"
                                                        Placement="Right"
                                                        IsOpen="{Binding IsQuickHintVisible}"
                                                        StaysOpen="False">
                                                    <views:QuickHintBubble HintText="③「軸力」タブのテーブルで各荷重時の杭軸力を入力" />
                                                </Popup>

                                                <Popup x:Name="QuickHintPopup3"
                                                        PlacementTarget="{Binding ElementName=ButtonFundamentalWindow0}"
                                                        Placement="Left"
                                                        IsOpen="{Binding IsQuickHintVisible}"
                                                        StaysOpen="False">
                                                    <views:QuickHintBubble HintText="④基本情報；⑤慣性力設定；⑥地盤設定；⑦杭体設定；⑧軸力チェック；⑨杭要素分割&#x0A;⑩水平解析；⑪単杭沈下解析；⑫群杭沈下解析" />
                                                </Popup>

                                                <Popup x:Name="QuickHintPopup10"
                                                        PlacementTarget="{Binding ElementName=ButtonAnalysisResult}"
                                                        Placement="Bottom"
                                                        IsOpen="{Binding IsQuickHintVisible}"
                                                        StaysOpen="False">
                                                    <views:QuickHintBubble HintText="⑩結果確認" />
                                                </Popup>

                                            </StackPanel>
                                            <!--</ToolBar>-->

                                            <common:EnhancedDataGrid x:Name="DataGridPileLayout" ItemsSource="{Binding CurrentInputModel.PileLayoutItems, UpdateSourceTrigger=LostFocus}"
                                                    SelectionChanged="DataGridPileLayout_SelectionChanged"
                                                    AutoGenerateColumns="False"
                                                    CanUserAddRows="False"
                                                    CanUserSortColumns="False"
                                                    VerticalScrollBarVisibility="Auto"
                                                    HorizontalScrollBarVisibility="Auto"
                                                    LoadingRow="DataGridPileLayout_LoadingRow_Numbering"
                                                    CellEditEnding="DataGridPileLayout_CellEditEnding"
                                                    BeginningEdit="DataGridPileLayout_BeginningEdit"
                                                    FrozenColumnCount="2"
                                                    Grid.Row="1"
                                                    VerticalAlignment="Top"
                                                    CellStyle="{StaticResource CustomDataGridCellStyle}">
                                                <DataGrid.AlternatingRowBackground>
                                                    <ImageBrush/>
                                                </DataGrid.AlternatingRowBackground>
                                                <DataGrid.Style>
                                                    <Style/>
                                                </DataGrid.Style>

                                                <!--CSVファイル出力等-->
                                                <DataGrid.ContextMenu>
                                                    <StaticResource ResourceKey="CommonDataGridContextMenu"/>
                                                </DataGrid.ContextMenu>

                                                <DataGrid.ColumnHeaderStyle>
                                                    <Style TargetType="DataGridColumnHeader">
                                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                        <Setter Property="Foreground" Value="#62B0E2" />
                                                    </Style>
                                                </DataGrid.ColumnHeaderStyle>

                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Width="*" Binding="{Binding X, StringFormat=N3, Mode=TwoWay}" ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50">
                                                        <DataGridTextColumn.Header>
                                                            <StackPanel>
                                                                <TextBlock Text="X"
                                                                   TextAlignment="Center"/>
                                                                <TextBlock Text="(m)"
                                                                   TextAlignment="Center"
                                                                   HorizontalAlignment="Center"/>
                                                            </StackPanel>
                                                        </DataGridTextColumn.Header>
                                                    </DataGridTextColumn>

                                                    <DataGridTextColumn Width="*"
                                                                Binding="{Binding Y, StringFormat=N3, Mode=TwoWay}"
                                                                ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50">
                                                        <DataGridTextColumn.Header>
                                                            <StackPanel>
                                                                <TextBlock Text="Y" TextAlignment="Center"/>
                                                                <TextBlock Text="(m)"
                                                                   TextAlignment="Center"
                                                                   HorizontalAlignment="Center"/>
                                                            </StackPanel>
                                                        </DataGridTextColumn.Header>
                                                    </DataGridTextColumn>

                                                    <DataGridTextColumn Binding="{Binding Z, StringFormat={}{0:+0.00;-0.00;+0.00}, Mode=TwoWay}"
                                                            Width="*"
                                                            ElementStyle="{StaticResource RightAlignedTextBlockStyle}"
                                                            MinWidth="50">
                                                        <DataGridTextColumn.Header>
                                                            <StackPanel>
                                                                <TextBlock Text="杭頭" TextAlignment="Center"/>
                                                                <!--<TextBlock Text="標高" TextAlignment="Center"
                                                                   HorizontalAlignment="Center"/>-->
                                                                <TextBlock Text="Z" TextAlignment="Center"
                                                                    HorizontalAlignment="Center"/>
                                                                <!--<TextBlock x:Name="TextBlockRefLevel"/>-->
                                                                <!--DataContext="{Binding Source={StaticResource ProxyElement}}"
                                                                    Text="{Binding DataContext.CurrentInputModel.FundamentalInput.RefLevel, UpdateSourceTrigger=LostFocus}"-->
                                                                <!--TextAlignment="Center"/>-->
                                                                <TextBlock Text="(m)" TextAlignment="Center"
                                                                   HorizontalAlignment="Center"/>
                                                            </StackPanel>
                                                        </DataGridTextColumn.Header>
                                                    </DataGridTextColumn>

                                                    <DataGridComboBoxColumn Width="*" x:Name="ColumnPileBodyNo" SelectedItemBinding="{Binding PileBodyNo}" MinWidth="50">
                                                        <DataGridComboBoxColumn.ElementStyle>
                                                            <Style TargetType="ComboBox">
                                                                <Setter Property="ItemsSource" Value="{Binding DataContext.CurrentInputModel.PileBodiesCountList, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                                            </Style>
                                                        </DataGridComboBoxColumn.ElementStyle>
                                                        <DataGridComboBoxColumn.EditingElementStyle>
                                                            <Style TargetType="ComboBox">
                                                                <Setter Property="ItemsSource" Value="{Binding DataContext.CurrentInputModel.PileBodiesCountList, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                                            </Style>
                                                        </DataGridComboBoxColumn.EditingElementStyle>
                                                        <DataGridComboBoxColumn.Header>
                                                            <StackPanel>
                                                                <TextBlock Text="杭体" TextAlignment="Center"/>
                                                                <TextBlock Text="番号" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                            </StackPanel>
                                                        </DataGridComboBoxColumn.Header>
                                                    </DataGridComboBoxColumn>

                                                    <DataGridComboBoxColumn Width="*" x:Name="ColumnGroundNo" SelectedItemBinding="{Binding GroundNo}" MinWidth="50">
                                                        <DataGridComboBoxColumn.ElementStyle>
                                                            <Style TargetType="ComboBox">
                                                                <Setter Property="ItemsSource" Value="{Binding DataContext.CurrentInputModel.GroundsInputCountList, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                                            </Style>
                                                        </DataGridComboBoxColumn.ElementStyle>
                                                        <DataGridComboBoxColumn.EditingElementStyle>
                                                            <Style TargetType="ComboBox">
                                                                <Setter Property="ItemsSource" Value="{Binding DataContext.CurrentInputModel.GroundsInputCountList, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                                            </Style>
                                                        </DataGridComboBoxColumn.EditingElementStyle>
                                                        <DataGridComboBoxColumn.Header>
                                                            <StackPanel>
                                                                <TextBlock Text="地盤" TextAlignment="Center"/>
                                                                <TextBlock Text="番号" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                            </StackPanel>
