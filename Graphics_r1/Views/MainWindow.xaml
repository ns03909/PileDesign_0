            <!--SmallImageSource="pack://application:,,,/Icons/ZoomFit.png"/>-->
        </ribbon:RibbonQuickAccessToolBar>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ribbon:Ribbon Grid.Row="0"
               Margin="0"
               Padding="0"
               BorderThickness="0"
               IsMinimized="{Binding IsRibbonMinimized}"
               Visibility="{Binding IsRibbonVisible, Converter={StaticResource BooleanToVisibilityConverter}}">

            <ribbon:Ribbon.HelpPaneContent>
                <StackPanel Orientation="Horizontal">
                    <ribbon:RibbonToggleButton ToolTip="リボン最小化 (タブのみ表示)"
                                               IsChecked="{Binding IsRibbonMinimized}"
                                               Visibility="{Binding IsRibbonVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               SmallImageSource="pack://application:,,,/Icons/RibbonMinimize.png"/>
                    <ribbon:RibbonToggleButton ToolTip="リボン表示/非表示"
                                               IsChecked="{Binding IsRibbonVisible}"
                                               SmallImageSource="pack://application:,,,/Icons/RibbonVisible.png"/>
                </StackPanel>
            </ribbon:Ribbon.HelpPaneContent>

            <ribbon:Ribbon.QuickAccessToolBar>
                <!--リソースを 1 回だけ使用-->
                <StaticResource ResourceKey="MainQAT"/>
            </ribbon:Ribbon.QuickAccessToolBar>

            <!-- ApplicationMenu で左上濃紺領域を活用 -->
            <ribbon:Ribbon.ApplicationMenu>
                <ribbon:RibbonApplicationMenu SmallImageSource="pack://application:,,,/Icons/OpenFile.png">

                    <ribbon:RibbonApplicationMenuItem Command="{Binding NewInputModelFileCommand}" ImageSource="pack://application:,,,/Icons/NewFile.png">
                        <ribbon:RibbonApplicationMenuItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="新規"/>
                                <TextBlock Text="Ctrl+N" Foreground="Gray" Margin="12,0,0,0"/>
                            </StackPanel>
                        </ribbon:RibbonApplicationMenuItem.Header>
                    </ribbon:RibbonApplicationMenuItem>

                    <ribbon:RibbonApplicationMenuItem Command="{Binding OpenInputModelFileCommand}" ImageSource="pack://application:,,,/Icons/OpenFile.png">
                        <ribbon:RibbonApplicationMenuItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="開く"/>
                                <TextBlock Text="Ctrl+O" Foreground="Gray" Margin="12,0,0,0"/>
                            </StackPanel>
                        </ribbon:RibbonApplicationMenuItem.Header>
                    </ribbon:RibbonApplicationMenuItem>

                    <ribbon:RibbonApplicationMenuItem Command="{Binding SaveInputModelFileCommand}" ImageSource="pack://application:,,,/Icons/SaveFile.png">
                        <ribbon:RibbonApplicationMenuItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="保存"/>
                                <TextBlock Text="Ctrl+S" Foreground="Gray" Margin="12,0,0,0"/>
                            </StackPanel>
                        </ribbon:RibbonApplicationMenuItem.Header>
                    </ribbon:RibbonApplicationMenuItem>

                    <ribbon:RibbonApplicationMenuItem Command="{Binding SaveInputModelFileAsCommand}" ImageSource="pack://application:,,,/Icons/SaveFile.png">
                        <ribbon:RibbonApplicationMenuItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="名前を付けて保存"/>
                                <TextBlock Text="Ctrl+Shift+S" Foreground="Gray" Margin="12,0,0,0"/>
                            </StackPanel>
                        </ribbon:RibbonApplicationMenuItem.Header>
                    </ribbon:RibbonApplicationMenuItem>

                    <ribbon:RibbonApplicationMenuItem Command="{Binding OpenDocxOutputWindowCommand}" ImageSource="pack://application:,,,/Icons/DocxFileOutput.png">
                        <ribbon:RibbonApplicationMenuItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Docxファイル出力"/>
                                <TextBlock Text="(なし)" Foreground="Gray" Margin="12,0,0,0"/>
                            </StackPanel>
                        </ribbon:RibbonApplicationMenuItem.Header>
                    </ribbon:RibbonApplicationMenuItem>

                    <!-- 計算例: 右側補助ペイン -->
                    <ribbon:RibbonApplicationMenu.AuxiliaryPaneContent>
                        <StackPanel Margin="12" Width="260">
                            <TextBlock Text="計算例" FontWeight="Bold" Margin="0,0,0,8"/>
                            <ribbon:RibbonApplicationMenuItem Header="基礎指針'19 計算例5 直接基礎の即時沈下量"
                                              KeyTip="5"
                                              Command="{Binding Example5Command}"
                                              ToolTip="基礎指針'19 計算例9 地下室の影響を考慮した杭の地震時水平抵抗"/>
                            <ribbon:RibbonApplicationMenuItem Header="基礎指針'19 計算例9"
                                              KeyTip="9"
                                              Command="{Binding Example9Command}"
                                              ToolTip="基礎指針'19 計算例9を実行"/>
                            <ribbon:RibbonApplicationMenuItem Header="基礎構造の設計 7. 直接基礎の設計例"
                                              KeyTip="9"
                                              Command="{Binding ExampleK7Command}"
                                              ToolTip="日本建築学会　関東支部　基礎構造の設計　学びやすい構造設計 計算例7を実行"/>
                            <ribbon:RibbonApplicationMenuItem Header="基礎構造の設計 8. 杭基礎の設計例"
                                              KeyTip="9"
                                              Command="{Binding ExampleK8Command}"
                                              ToolTip="日本建築学会　関東支部　基礎構造の設計　学びやすい構造設計 計算例8を実行"/>
                            <ribbon:RibbonApplicationMenuItem Header="設計例集3.1"
                                              KeyTip="9"
                                              Command="{Binding Example3_1Command}"
                                              ToolTip="日本建築学会　建築基礎構造設計例集3.1　非液状化地盤に建つ建物のPHC杭基礎"/>

                            <!-- 追加計算例が増える場合はここに同様に列挙 -->
                        </StackPanel>
                    </ribbon:RibbonApplicationMenu.AuxiliaryPaneContent>

                    <!-- 任意: 下端フッター -->
                    <ribbon:RibbonApplicationMenu.FooterPaneContent>
                        <TextBlock Text="Version α-0.1" Foreground="Gray" Margin="8,0,8,4"/>
                    </ribbon:RibbonApplicationMenu.FooterPaneContent>
                </ribbon:RibbonApplicationMenu>
            </ribbon:Ribbon.ApplicationMenu>

            <ribbon:RibbonTab Header="設定・解析(S)" KeyTip="S">
                <ribbon:RibbonGroup Header="設定">
                    <ribbon:RibbonButton x:Name="ButtonFundamental"
                         Label="基本設定"
                         Command="{Binding OpenFundamentalWindowCommand}"
                         LargeImageSource="pack://application:,,,/Icons/FundamentalWindow.png"
                         SmallImageSource="pack://application:,,,/Icons/FundamentalWindow.png"/>

                    <ribbon:RibbonButton x:Name="RibbonButtonLoadCase"
                         Label="荷重条件"
                         Command="{Binding OpenLoadCaseWindowCommand}"
                         LargeImageSource="pack://application:,,,/Icons/LoadCaseWindow.png"
                         SmallImageSource="pack://application:,,,/Icons/LoadCaseWindow.png"/>

                    <ribbon:RibbonButton x:Name="RibbonButtonGround"
                         Label="地盤"
                         PreviewMouseDown="ButtonGround_PreviewMouseDown"
                         Command="{Binding OpenGroundWindowCommand}"
                         LargeImageSource="pack://application:,,,/Icons/GroundWindow.png"
                         SmallImageSource="pack://application:,,,/Icons/GroundWindow.png"/>

                    <ribbon:RibbonButton x:Name="RibbonButtonPileBody"
                         Label="杭体"
                         PreviewMouseDown="ButtonPileBody_PreviewMouseDown"
                         Command="{Binding OpenPileBodyWindowCommand}"
                         LargeImageSource="pack://application:,,,/Icons/PileBodyWindow.png"
                         SmallImageSource="pack://application:,,,/Icons/PileBodyWindow.png"/>

                    <ribbon:RibbonButton x:Name="RibbonButtonAxialForceCheck"
                         Label="軸力確認"
                         PreviewMouseDown="ButtonPileBody_PreviewMouseDown"
                         Command="{Binding AxialForceCheckCommand}"
                         LargeImageSource="pack://application:,,,/Icons/AxialForceVeirification.png"
                         SmallImageSource="pack://application:,,,/Icons/AxialForceVeirification.png"/>
                    
                    <ribbon:RibbonButton x:Name="RibbonButtonExecuteAnalyse"
                             Label="{Binding IsElementSplit, Converter={StaticResource BooleanToContentConverter}, ConverterParameter='要素分割(済),要素分割(未)'}"
                             Command="{Binding OpenElementDivisionWindowCommand}">
                        <ribbon:RibbonButton.Style>
                            <Style TargetType="ribbon:RibbonButton">
                                <!-- 未分割時（既定） -->
                                <Setter Property="LargeImageSource" Value="pack://application:,,,/Icons/ElementDivisionWindow.png"/>
                                <Setter Property="SmallImageSource" Value="pack://application:,,,/Icons/ElementDivisionWindow.png"/>
                                <Style.Triggers>
                                    <!-- 分割済み時に差し替え -->
                                    <DataTrigger Binding="{Binding IsElementSplit}" Value="True">
                                        <Setter Property="LargeImageSource" Value="pack://application:,,,/Icons/ElementDivisionWindowDone.png"/>
                                        <Setter Property="SmallImageSource" Value="pack://application:,,,/Icons/ElementDivisionWindowDone.png"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ribbon:RibbonButton.Style>
                    </ribbon:RibbonButton>
                </ribbon:RibbonGroup>

                <ribbon:RibbonGroup Header="解析">


                    <ribbon:RibbonButton x:Name="RibbonButtonLateralLoadAnalysisSettlement"
                         Label="{Binding IsHorizontalAnalysisDone, Converter={StaticResource BooleanToContentConverter}, ConverterParameter='水平解析(済),水平解析(未)'}"
                         Command="{Binding OpenLateralLoadAnalysisWindowCommand}"
                         IsEnabled="{Binding IsElementSplit, Converter={StaticResource BooleanToVisibilityConverter}}"
                         LargeImageSource="pack://application:,,,/Icons/LateralLoadAnalysisWindow.png"
                         SmallImageSource="pack://application:,,,/Icons/LateralLoadAnalysisWindow.png"/>

                    <ribbon:RibbonButton x:Name="RibbonButtonSettlement"
                         Label="{Binding IsVerticalAnalysisDone, Converter={StaticResource BooleanToContentConverter}, ConverterParameter='単杭沈下解析(済),単杭沈下解析(未)'}"
                         PreviewMouseDown="ButtonButtonSettlement_PreviewMouseDown"
                         Command="{Binding OpenSettlementWindowCommand}"
                         IsEnabled="{Binding IsElementSplit, Converter={StaticResource BooleanToVisibilityConverter}}"
                         LargeImageSource="pack://application:,,,/Icons/SettlementWindow.png"
                         SmallImageSource="pack://application:,,,/Icons/SettlementWindow.png"/>
                <!--</ribbon:RibbonGroup>

                <ribbon:RibbonGroup Header="群杭">-->
                    <ribbon:RibbonButton x:Name="RibbonButtonGroupPileSettlement"
                     Label="{Binding IsGroupPileSettlementAnalysisDone, Converter={StaticResource BooleanToContentConverter}, ConverterParameter='群杭沈下解析(済),群杭沈下解析(未)'}"
                     Click="ButtonGroupPileSettlement_Click"
                     LargeImageSource="pack://application:,,,/Icons/GroupPileSettlement.png"
                     SmallImageSource="pack://application:,,,/Icons/GroupPileSettlement.png"/>
                </ribbon:RibbonGroup>


            </ribbon:RibbonTab>

            <ribbon:RibbonTab Header="解析結果(R)" KeyTip="R">
                <ribbon:RibbonGroup Header="ウィンドウ表示">
                    <ribbon:RibbonButton x:Name="RibbonButtonGraph"
                             Label="グラフ出力"
                             Command="{Binding OpenGraphWindowCommand}"
                             LargeImageSource="pack://application:,,,/Icons/Graph.png"
                             SmallImageSource="pack://application:,,,/Icons/Graph.png"/>
                    <ribbon:RibbonButton x:Name="RibbonButtonTable"
                             Label="テーブル出力"
                             Command="{Binding OpenTableWindowCommand}"
                             LargeImageSource="pack://application:,,,/Icons/Table.png"
                             SmallImageSource="pack://application:,,,/Icons/Table.png"/>
                </ribbon:RibbonGroup>

                <ribbon:RibbonGroup Header="メイン画面表示">
                    <ribbon:RibbonToggleButton Label="解析結果表示"
                               ToolTip="解析結果全体の表示/非表示"
                               IsChecked="{Binding IsAnalysisResultVisible}"/>

                    <ComboBox Width="120"
                          ItemsSource="{Binding AnalysisResultContentOption}"
                          SelectedItem="{Binding AnalysisResultContent}"
                          ribbon:RibbonControlService.Label="内容"
                             Visibility="{Binding IsAnalysisResultVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding ComboBox3DAnalysisResultContent_OnSelectionChangedCommand}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </ComboBox>

                    <!-- 沈下種別 -->
                    <ComboBox Width="100"
                          ItemsSource="{Binding AnalysisResultSettlementOption}"
                          SelectedItem="{Binding AnalysisResultSettlementType}"
                          ribbon:RibbonControlService.Label="沈下種別">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox">
                                <!-- 既定は非表示 -->
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsAnalysisResultVisible}" Value="True"/>
                                            <Condition Binding="{Binding AnalysisResultContent}" Value="沈下"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding ComboBox3DAnalysisResultContent_OnSelectionChangedCommand}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </ComboBox>

                    <!-- 梁応力 -->
                    <ComboBox Width="100"
                          ItemsSource="{Binding AnalysisResultBeamForceOption}"
                          SelectedItem="{Binding AnalysisResultBeamForceType}"
                          ribbon:RibbonControlService.Label="梁応力">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsAnalysisResultVisible}" Value="True"/>
                                            <Condition Binding="{Binding AnalysisResultContent}" Value="梁応力"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding ComboBox3DAnalysisResultContent_OnSelectionChangedCommand}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </ComboBox>

                    <!-- 節点変位 -->
                    <ComboBox Width="110"
                          ItemsSource="{Binding AnalysisResultNodeDisplacementOption}"
                          SelectedItem="{Binding AnalysisResultNodeDisplacementType}"
                          ribbon:RibbonControlService.Label="節点変位">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsAnalysisResultVisible}" Value="True"/>
                                            <Condition Binding="{Binding AnalysisResultContent}" Value="節点変位"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding ComboBox3DAnalysisResultContent_OnSelectionChangedCommand}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </ComboBox>

                    <!-- 地盤ばね -->
                    <ComboBox Width="100"
                          ItemsSource="{Binding AnalysisResultSoilSpringOption}"
                          SelectedItem="{Binding AnalysisResultSoilSpringType}"
                          ribbon:RibbonControlService.Label="地盤ばね">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsAnalysisResultVisible}" Value="True"/>
                                            <Condition Binding="{Binding AnalysisResultContent}" Value="地盤ばね"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding ComboBox3DAnalysisResultContent_OnSelectionChangedCommand}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </ComboBox>
                </ribbon:RibbonGroup>

                <ribbon:RibbonGroup Header="値表示">
                    <CheckBox Content="値表示" IsChecked="{Binding IsResultValueVisible}"/>
                    <CheckBox Content="中間のみ" IsChecked="{Binding IsMidSpanResultValueVisibleOnly}"
                        Visibility="{Binding IsResultValueVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <CheckBox Content="杭頭のみ" IsChecked="{Binding IsPileTopResultValueVisibleOnly}"
                        Visibility="{Binding IsResultValueVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="位置" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Slider Width="50" Minimum="0" Maximum="20"
                            Value="{Binding TextPosiitonAdjuster, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Width="45" HorizontalContentAlignment="Right"
                             Text="{Binding TextPosiitonAdjuster, StringFormat=N1, UpdateSourceTrigger=PropertyChanged}"
                             PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                             KeyDown="TextBox_KeyDown"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="小数" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Slider Width="50" Minimum="0" Maximum="5"
                            Value="{Binding DecimalPlaces, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Width="45" HorizontalContentAlignment="Right"
                             Text="{Binding DecimalPlaces, UpdateSourceTrigger=PropertyChanged}"
                             PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                             KeyDown="TextBox_KeyDown"/>
                    </StackPanel>
                </ribbon:RibbonGroup>

                <ribbon:RibbonGroup Header="ダイアグラムスケール">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="応力" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Slider Width="50" Minimum="0.5" Maximum="10.0"
                            Value="{Binding ForceDiagramMultiplier, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Width="45" HorizontalContentAlignment="Right"
                             Text="{Binding ForceDiagramMultiplier, StringFormat=N1, UpdateSourceTrigger=PropertyChanged}"
                             PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                             KeyDown="TextBox_KeyDown"/>
                    </StackPanel>
                    <!--<CheckBox Content="変位スケール適用" IsChecked="{Binding IsDispDiagramMultiplierApplicable}"/>-->
                    <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsDispDiagramMultiplierApplicable, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="変位" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Slider Width="50" Minimum="0" Maximum="1000.0"
                            Value="{Binding DispDiagramMultiplier, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Width="45" HorizontalContentAlignment="Right"
                             Text="{Binding DispDiagramMultiplier, StringFormat=N1, UpdateSourceTrigger=PropertyChanged}"
                             PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                             KeyDown="TextBox_KeyDown"/>
                    </StackPanel>
                </ribbon:RibbonGroup>

                <!--<ribbon:RibbonGroup Header="バブル">
                    <ribbon:RibbonToggleButton Label="バブル表示" IsChecked="{Binding IsBubbleVisible}"
                               SmallImageSource="pack://application:,,,/Icons/BubbleVisible.png"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="径" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Slider Width="70" Minimum="0" Maximum="200"
                            Value="{Binding BubbleDia, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Width="40" HorizontalContentAlignment="Right"
                             Text="{Binding BubbleDia, StringFormat=N0, UpdateSourceTrigger=LostFocus}"
                             PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                             KeyDown="TextBox_KeyDown"/>
                    </StackPanel>
                </ribbon:RibbonGroup>-->
                <ribbon:RibbonGroup Header="バブル">
                    <StackPanel Orientation="Horizontal">
                        <ribbon:RibbonToggleButton Label="バブル表示"
                                   IsChecked="{Binding IsBubbleVisible}"
                                   SmallImageSource="pack://application:,,,/Icons/BubbleVisible.png"/>
                        <ribbon:RibbonToggleButton Label="🔽"
                                   ToolTip="バブル設定展開/折りたたみ"
                                   IsChecked="{Binding IsBubbleSettingExpanded}"/>
                    </StackPanel>

                    <!-- 詳細設定（径調整） -->
                    <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsBubbleSettingExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="径" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Slider Width="70" Minimum="0" Maximum="200"
                            Value="{Binding BubbleDia, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Width="40" HorizontalContentAlignment="Right"
                             Text="{Binding BubbleDia, StringFormat=N0, UpdateSourceTrigger=LostFocus}"
                             PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                             KeyDown="TextBox_KeyDown"/>
                    </StackPanel>
                </ribbon:RibbonGroup>


                <!--<ribbon:RibbonGroup Header="矢印">
                    <ribbon:RibbonToggleButton Label="矢印表示" IsChecked="{Binding IsArrowVisible}"
                               SmallImageSource="pack://application:,,,/Icons/ArrowVisible.png"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="全長" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Slider Width="70" Minimum="0" Maximum="200"
