                                                            Command="{Binding ViewXYPlaneCommand}">
                                                        <svgc:SvgViewbox Source="/Icons/TopView.svg" Style="{StaticResource SvgIconStyle16}"/>
                                                    </Button>
                                                    <Button Grid.Row="0" Grid.Column="2"
                                                            Padding="0"
                                                            Style="{StaticResource LargeIconToolTipButtonStyle}"
                                                            Tag="正面 (Ctrl + Shift + F)"
                                                            Command="{Binding ViewXZPlaneCommand}">
                                                        <svgc:SvgViewbox Source="/Icons/FrontView.svg" Style="{StaticResource SvgIconStyle16}"/>
                                                    </Button>
                                                    <Button Grid.Row="0" Grid.Column="3"
                                                            Padding="0"
                                                            Style="{StaticResource LargeIconToolTipButtonStyle}"
                                                            Tag="右面 (Ctrl + Shift + R)"
                                                            Command="{Binding ViewYZPlaneCommand}">
                                                        <svgc:SvgViewbox Source="/Icons/RightView.svg" Style="{StaticResource SvgIconStyle16}"/>
                                                    </Button>
                                                    <Button Grid.Row="0" Grid.Column="4"
                                                            Padding="0"
                                                            Style="{StaticResource LargeIconToolTipButtonStyle}"
                                                            Tag="アイソメ (Ctrl + Shift + I)"
                                                            Command="{Binding ViewIsometricCommand}">
                                                        <svgc:SvgViewbox Source="/Icons/IsometricView.svg" Style="{StaticResource SvgIconStyle16}"/>
                                                    </Button>
                                                    <!--<Button Grid.Row="0" Grid.Column="1" Padding="0" ToolTip="平面 (Ctrl + Shift + T)" Command="{Binding ViewXYPlaneCommand}">
                                                        <svgc:SvgViewbox Source="/Icons/TopView.svg" Style="{StaticResource SvgIconStyle16}"/>
                                                    </Button>-->
                                                    <!--<Button Grid.Row="0" Grid.Column="2" Padding="0" ToolTip="正面 (Ctrl + Shift + F)" Command="{Binding ViewXZPlaneCommand}">
                                                        <svgc:SvgViewbox Source="/Icons/FrontView.svg" Style="{StaticResource SvgIconStyle16}"/>
                                                    </Button>-->
                                                    <!--<Button Grid.Row="0" Grid.Column="3" Padding="0" ToolTip="右面 (Ctrl + Shift + R)" Command="{Binding ViewYZPlaneCommand}">
                                                        <svgc:SvgViewbox Source="/Icons/RightView.svg" Style="{StaticResource SvgIconStyle16}"/>
                                                    </Button>-->
                                                    <!--<Button Grid.Row="0" Grid.Column="4" Padding="0" ToolTip="アイソメ (Ctrl + Shift + I)" Command="{Binding ViewIsometricCommand}">
                                                        <svgc:SvgViewbox Source="/Icons/IsometricView.svg" Style="{StaticResource SvgIconStyle16}"/>
                                                    </Button>-->

                                                    <!-- 行1: アクティブ操作 -->
                                                    <Button Grid.Row="1" Grid.Column="0"
                                                        Padding="0"
                                                        Style="{StaticResource LargeIconToolTipButtonStyle}"
