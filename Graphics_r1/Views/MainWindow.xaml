                                                            <StackPanel>
                                                                <TextBlock Text="X"
                                                                   TextAlignment="Center"/>
                                                                <TextBlock Text="(m)"
                                                                   TextAlignment="Center"
                                                                   HorizontalAlignment="Center"/>
                                                            </StackPanel>
                                                        </DataGridTextColumn.Header>
                                                    </DataGridTextColumn>

                                                    <DataGridTextColumn Width="*"
                                                                Binding="{Binding Y, StringFormat=N3, Mode=TwoWay}"
                                                                ElementStyle="{StaticResource RightAlignedTextBlockStyle}"
                                                                EditingElementStyle="{StaticResource SignedDecimalEditingTextBoxStyle}" MinWidth="50">
                                                        <DataGridTextColumn.Header>
