                             Icon="pack://application:,,,/Icons/SavePicture2.png"
                             CommandParameter="2.0"/>
                </Fluent:RibbonGroupBox>

                <Fluent:RibbonGroupBox Header="サブプログラム" ToolTip="サブプログラム">
                    <Fluent:Button Header="Chang" ToolTip="Chang"
