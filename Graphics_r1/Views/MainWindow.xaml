                                                </Popup>

                                                <Popup x:Name="QuickHintPopup3"
                                                        PlacementTarget="{Binding ElementName=ButtonFundamentalWindow0}"
                                                        Placement="Left"
                                                        IsOpen="{Binding IsQuickHintVisible}"
                                                        StaysOpen="False"
                                                        AllowsTransparency="True"
                                                       PopupAnimation="Fade">
                                                    <views:QuickHintBubble HintText="この行のボタンで左から順に進みます&#x0A;　基本設定 → Step 2 荷重条件 → Step 3 地盤条件 → Step 4 杭体 → 軸力確認&#x0A;　Step 7 杭要素分割 (F4) → Step 8 水平解析 (F5)&#x0A;　沈下を見る場合：単杭沈下解析 (F6) ／ 群杭沈下解析 (F8)" />
                                                </Popup>

                                                <Popup x:Name="QuickHintPopup10"
                                                        PlacementTarget="{Binding ElementName=ButtonAnalysisResult}"
                                                        Placement="Bottom"
                                                        IsOpen="{Binding IsQuickHintVisible}"
                                                        StaysOpen="False"
                                                       AllowsTransparency="True"
                                                       PopupAnimation="Fade">
                                                    <views:QuickHintBubble HintText="解析後：ここで結果を確認します（グラフ・テーブル・計算書）" />
                                                </Popup>

                                            </StackPanel>
                                            <!--</ToolBar>-->

                                            <common:EnhancedDataGrid x:Name="DataGridPileLayout" CanUserSortColumns="False" ItemsSource="{Binding CurrentInputModel.PileLayoutItems, UpdateSourceTrigger=LostFocus}"
                                                    SelectionChanged="DataGridPileLayout_SelectionChanged"
