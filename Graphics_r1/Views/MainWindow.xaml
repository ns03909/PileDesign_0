                                        </TabItem>

                                        <TabItem Header="解析（一般）" x:Name="TabItemLoadNonBeam"
                                                 ToolTip="基礎梁を考慮しない単発スタインブレナー解析。任意矩形 / 個別矩形 / 個別十字 などの荷重定義で 1 回計算。">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1*" />
                                                </Grid.ColumnDefinitions>

                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>


                                                <Grid Grid.Row="0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 一回解析 用の荷重面標高 -->
                                                    <TextBlock Text="荷重面 Z (m)" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,2,4,2"/>
                                                    <TextBox Text="{Binding LoadingPlaneAltitudeNonBeamProxy, StringFormat={}{0:+0.00;-0.00;+0.00}, UpdateSourceTrigger=LostFocus}"
                                                             Grid.Row="0" Grid.Column="1"
                                                             HorizontalContentAlignment="Right" Margin="0,2"
                                                             GotFocus="TextBox_GotFocus"
                                                             PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                             KeyDown="TextBox_KeyDown">
                                                        <TextBox.ToolTip>
                                                            <TextBlock>
                                                                <Run Text="一回解析 (基礎梁無し) で使用される荷重面標高。"/>
                                                                <LineBreak/>
                                                                <Run Text="杭周面抵抗に対する荷重面の例：杭先端から(1/3)Lの高さ"/>
                                                                <LineBreak/>
                                                                <Run Text="杭先端荷重に対する荷重面の例：杭先端"/>
                                                                <LineBreak/>
                                                                <Run Text="(基礎指針'19 図6.3.11 p230)"/>
                                                            </TextBlock>
                                                        </TextBox.ToolTip>
                                                    </TextBox>
                                                    <TextBlock Text="標高 (m)" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="8,2,4,2"/>
                                                    <TextBox Grid.Row="0" Grid.Column="3" IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}"
                                                             HorizontalContentAlignment="Right" Margin="0,2">
                                                        <TextBox.Text>
                                                            <MultiBinding StringFormat="{}{0:+0.00;-0.00;+0.00}" Mode="OneWay">
                                                                <Binding Path="CurrentInputModel.PileGroupSettlement.LoadingPlaneAltitudeNonBeam"/>
                                                                <Binding Path="CurrentInputModel.FundamentalInput.ReferenceAltitude"/>
                                                                <MultiBinding.Converter>
                                                                    <conv:SumConverter/>
                                                                </MultiBinding.Converter>
                                                            </MultiBinding>
                                                        </TextBox.Text>
                                                    </TextBox>

                                                    <TextBlock Text="荷重タイプ" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,2,4,2"/>

                                                    <ComboBox x:Name="ComboBoxLoadingType"
                                                          Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                                          ItemsSource="{Binding AvailableLoadingTypeOptionsNonBeam}"
                                                          SelectedItem="{Binding CurrentInputModel.PileGroupSettlement.LoadingType, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                          ItemTemplate="{StaticResource LoadingTypeItemTemplate}"
                                                          MinWidth="200" HorizontalAlignment="Left" Margin="0,2"

                                                          SelectionChanged="ComboBoxLoadingType_SelectionChanged">
                                                        <ComboBox.ToolTip>
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="auto"/>
                                                                    <RowDefinition Height="auto"/>
                                                                </Grid.RowDefinitions>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="auto"/>
                                                                    <ColumnDefinition Width="auto"/>
                                                                    <ColumnDefinition Width="auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="任意矩形"/>
                                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="："/>
                                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="任意の大きさの矩形荷重を任意の位置に配置します。"/>
                                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="個別十字"/>
                                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="："/>
                                                                <TextBlock Grid.Row="1" Grid.Column="2" Text="それぞれの杭に円形の等分布荷重面を想定し、合計面積が等しい5つの矩形荷重でモデル化します。"/>
                                                            </Grid>
                                                        </ComboBox.ToolTip>
                                                    </ComboBox>
                                                    <Separator Grid.Row="2" Grid.ColumnSpan="4"/>
                                                </Grid>

                                                <Grid Grid.Row="2" Visibility="{Binding CurrentInputModel.PileGroupSettlement.LoadingType,
                                                        Converter={StaticResource VisibilityConverter},
                                                        ConverterParameter='任意矩形,個別矩形,個別矩形（基礎梁考慮）,個別十字,個別十字（基礎梁反力）'}">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>

                                                    <GroupBox Grid.Row="0" Header="建物下面全体矩形荷重自動生成"
                                                              Visibility="{Binding CurrentInputModel.PileGroupSettlement.LoadingType,
                                                                  Converter={StaticResource VisibilityConverter},
                                                                  ConverterParameter='任意矩形'}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Text="杭心～矩形荷重境界(m)" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                                            <TextBox Text="{Binding RectLoadPileDistance}" Grid.Row="0" Grid.Column="1" Margin="4,0"
                                                                      PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                                     KeyDown="TextBox_KeyDown"
                                                                     HorizontalContentAlignment="Right"/>

                                                            <Button Grid.Row="0" Grid.Column="2"
                                                                    Padding="0"
                                                                    Style="{StaticResource LargeIconToolTipButtonStyle}"
                                                                    Tag="自動生成"
                                                                    Command="{Binding AdjustRectLoadPlanCommand}">
                                                                <svgc:SvgViewbox Source="/Icons/CreateAutoUniformlyDistributedLoad.svg" Style="{StaticResource SvgIconStyle24}"/>
                                                            </Button>

                                                        </Grid>
                                                    </GroupBox>

                                                    <Button Grid.Row="1" Padding="0" HorizontalAlignment="Left"
                                                        Style="{StaticResource LargeIconToolTipButtonStyle}"
                                                        Tag="矩形荷重面追加 (個別矩形（基礎梁考慮）では無効)"
                                                        Command="{Binding AddRectLoadCommand}"
                                                        IsEnabled="{Binding IsManualRectLoadEditingEnabled}">
                                                        <svgc:SvgViewbox Source="/Icons/AddRectLoad.svg" Style="{StaticResource SvgIconStyle24}"/>
                                                    </Button>

                                                    <common:EnhancedDataGrid Grid.Row="2" ItemsSource="{Binding CurrentInputModel.PileGroupSettlement.RectLoads, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                                                        AutoGenerateColumns="False"
                                                        CanUserAddRows="False"
                                                        CanUserSortColumns="True"
                                                        LoadingRow="DataGrid_LoadingRow_Numbering"
                                                        CellEditEnding="DataGridRectLoads_CellEditEnding"
                                                        EnableRowVirtualization="True"
                                                        EnableColumnVirtualization="False"
                                                        VirtualizingPanel.IsVirtualizing="True"
                                                        VirtualizingPanel.VirtualizationMode="Recycling"
                                                        ScrollViewer.CanContentScroll="True"
                                                        CellStyle="{StaticResource CustomDataGridCellStyle}">

                                                        <DataGrid.AlternatingRowBackground>
                                                            <ImageBrush/>
                                                        </DataGrid.AlternatingRowBackground>
                                                        <DataGrid.Style>
                                                            <Style/>
                                                        </DataGrid.Style>

                                                        <!--CSVファイル出力-->
                                                        <DataGrid.ContextMenu>
                                                            <StaticResource ResourceKey="CommonDataGridContextMenu"/>
                                                        </DataGrid.ContextMenu>

                                                        <DataGrid.ColumnHeaderStyle>
                                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                                <Setter Property="Foreground" Value="{StaticResource PrimaryAccentBrush}" />
                                                            </Style>
                                                        </DataGrid.ColumnHeaderStyle>

                                                        <DataGrid.Columns>

                                                            <DataGridTemplateColumn Width="*" Header="削除" MinWidth="50">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <Button
                                                                    x:Name="ButtonRectLoadDelete"
                                                                    Content="削除"
                                                                    Tag="{Binding}"
                                                                    Command="{Binding DataContext.DeleteRectLoadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    IsEnabled="{Binding DataContext.IsManualRectLoadEditingEnabled, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                            </DataGridTemplateColumn>

                                                            <DataGridTextColumn Width="*" Binding="{Binding X1, StringFormat=N3}"
                                                                        ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50">
                                                                <DataGridTextColumn.Header>
                                                                    <StackPanel>
                                                                        <TextBlock Text="X1"
                                                                    TextAlignment="Center"/>
                                                                        <TextBlock Text="(m)"
                                                                    TextAlignment="Center"
                                                                    HorizontalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </DataGridTextColumn.Header>
                                                            </DataGridTextColumn>

                                                            <DataGridTextColumn Width="*" Binding="{Binding Y1, StringFormat=N3}"
                                                                        ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50">
                                                                <DataGridTextColumn.Header>
                                                                    <StackPanel>
                                                                        <TextBlock Text="Y1"
                                                                    TextAlignment="Center"/>
                                                                        <TextBlock Text="(m)"
                                                                    TextAlignment="Center"
                                                                    HorizontalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </DataGridTextColumn.Header>
                                                            </DataGridTextColumn>

                                                            <DataGridTextColumn Width="*" Binding="{Binding X2, StringFormat=N3}"
                                                                        ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50">
                                                                <DataGridTextColumn.Header>
                                                                    <StackPanel>
                                                                        <TextBlock Text="X2"
                                                                    TextAlignment="Center"/>
                                                                        <TextBlock Text="(m)"
                                                                    TextAlignment="Center"
                                                                    HorizontalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </DataGridTextColumn.Header>
                                                            </DataGridTextColumn>


                                                            <DataGridTextColumn Width="*" Binding="{Binding Y2, StringFormat=N3}"
                                                                        ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50">
                                                                <DataGridTextColumn.Header>
                                                                    <StackPanel>
                                                                        <TextBlock Text="Y2"
                                                                    TextAlignment="Center"/>
                                                                        <TextBlock Text="(m)"
                                                                    TextAlignment="Center"
                                                                    HorizontalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </DataGridTextColumn.Header>
                                                            </DataGridTextColumn>

                                                            <DataGridTextColumn Width="*" Binding="{Binding QA, StringFormat=N0}"
                                                                        ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50">
                                                                <DataGridTextColumn.Header>
                                                                    <StackPanel>
                                                                        <TextBlock Text="荷重"
                                                                    TextAlignment="Center"/>
                                                                        <TextBlock Text="(kN)"
                                                                    TextAlignment="Center"
                                                                    HorizontalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </DataGridTextColumn.Header>
                                                            </DataGridTextColumn>

                                                            <DataGridTextColumn Width="*" Binding="{Binding DX, StringFormat=N3}"
                                                                        ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50">
                                                                <DataGridTextColumn.Header>
                                                                    <StackPanel>
                                                                        <TextBlock Text="DX"
                                                                    TextAlignment="Center"/>
                                                                        <TextBlock Text="(m)"
                                                                    TextAlignment="Center"
                                                                    HorizontalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </DataGridTextColumn.Header>
                                                            </DataGridTextColumn>

                                                            <DataGridTextColumn Width="*" Binding="{Binding DY, StringFormat=N3}"
                                                                        ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50">
                                                                <DataGridTextColumn.Header>
                                                                    <StackPanel>
                                                                        <TextBlock Text="DY"
                                                                    TextAlignment="Center"/>
                                                                        <TextBlock Text="(m)"
                                                                    TextAlignment="Center"
                                                                    HorizontalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </DataGridTextColumn.Header>
                                                            </DataGridTextColumn>

                                                            <DataGridTextColumn Width="*" Binding="{Binding A, Mode=OneWay, StringFormat=N3}"
                                                                        ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50"
                                                                        IsReadOnly="true" Foreground="Gray">
                                                                <DataGridTextColumn.Header>
                                                                    <StackPanel>
                                                                        <TextBlock Text="面積"
                                                                    TextAlignment="Center"/>
                                                                        <TextBlock TextAlignment="Center" HorizontalAlignment="Center"><Run Text="(m"/><Run Text="2" BaselineAlignment="Superscript" FontSize="9"/><Run Text=")"/></TextBlock>
                                                                    </StackPanel>
                                                                </DataGridTextColumn.Header>
                                                            </DataGridTextColumn>

                                                            <DataGridTextColumn Width="*" Binding="{Binding Q, Mode=OneWay, StringFormat=N3}"
                                                                        ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50"
                                                                        IsReadOnly="true" Foreground="Gray">
                                                                <DataGridTextColumn.Header>
                                                                    <StackPanel>
                                                                        <TextBlock Text="単位面積荷重"
                                                                    TextAlignment="Center"/>
                                                                        <TextBlock TextAlignment="Center" HorizontalAlignment="Center"><Run Text="(kN/m"/><Run Text="2" BaselineAlignment="Superscript" FontSize="9"/><Run Text=")"/></TextBlock>
                                                                    </StackPanel>
                                                                </DataGridTextColumn.Header>
                                                            </DataGridTextColumn>

                                                        </DataGrid.Columns>
                                                    </common:EnhancedDataGrid>
                                                </Grid>

                                                <StackPanel Grid.Row="1">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="{Binding CurrentInputModel.PileGroupSettlement.LoadingType,
                                                                Converter={StaticResource VisibilityConverter},
                                                                ConverterParameter='個別矩形,個別矩形（基礎梁考慮）,個別十字,個別十字（基礎梁反力）'}"/>
                                                            <Style.Triggers>
                                                                <!-- 個別矩形系で矩形が編集済みの場合は非表示 (荷重面等価径の値を変えても整合しないため) -->
                                                                <DataTrigger Binding="{Binding IsRectLoadFreshFromAutoGen}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>

                                                    <common:EnhancedDataGrid ItemsSource="{Binding CurrentInputModel.ElementDivision.SoilPiles}"
                                                            AutoGenerateColumns="False"
                                                            CanUserAddRows="False"
                                                            CanUserSortColumns="True"
                                                            LoadingRow="DataGrid_LoadingRow_Numbering"
                                                            CellEditEnding="DataGridSoilPile_CellEditEnding"
                                                              BeginningEdit="DataGridGrid_BeginningEdit"
                                                              EnableRowVirtualization="True"
                                                              EnableColumnVirtualization="False"
                                                              VirtualizingPanel.IsVirtualizing="True"
                                                              VirtualizingPanel.VirtualizationMode="Recycling"
                                                              ScrollViewer.CanContentScroll="True"
                                                            CellStyle="{StaticResource CustomDataGridCellStyle}">

                                                        <DataGrid.AlternatingRowBackground>
                                                            <ImageBrush/>
                                                        </DataGrid.AlternatingRowBackground>
                                                        <DataGrid.Style>
                                                            <Style/>
                                                        </DataGrid.Style>

                                                        <!--CSVファイル出力等-->
                                                        <DataGrid.ContextMenu>
                                                            <StaticResource ResourceKey="CommonDataGridContextMenu"/>
                                                        </DataGrid.ContextMenu>

                                                        <DataGrid.ColumnHeaderStyle>
                                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                                <Setter Property="Foreground" Value="{StaticResource PrimaryAccentBrush}" />
                                                            </Style>
                                                        </DataGrid.ColumnHeaderStyle>

                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Width="*" Binding="{Binding No}"
                                                                    ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="70"
                                                                    IsReadOnly=" true" Foreground="Gray">
                                                                <DataGridTextColumn.Header>
                                                                    <StackPanel>
                                                                        <TextBlock Text="地盤・杭" TextAlignment="Center"/>
                                                                        <TextBlock Text="・レベル" TextAlignment="Center"/>
                                                                        <TextBlock Text="セット" TextAlignment="Center"/>
                                                                        <TextBlock Text="番号" TextAlignment="Center"
                                                                            HorizontalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </DataGridTextColumn.Header>
                                                            </DataGridTextColumn>

                                                            <DataGridTextColumn Width="*" Binding="{Binding GroundNo}"
                                                                    ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50"
                                                                    IsReadOnly=" true" Foreground="Gray">
                                                                <DataGridTextColumn.Header>
                                                                    <StackPanel>
                                                                        <TextBlock Text="地盤"
                                                                            TextAlignment="Center"/>
                                                                        <TextBlock Text="番号"
                                                                            TextAlignment="Center"
                                                                            HorizontalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </DataGridTextColumn.Header>
                                                            </DataGridTextColumn>

                                                            <DataGridTextColumn Width="*" Binding="{Binding PileBodyNo}"
                                                                    ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50"
                                                                    IsReadOnly=" true" Foreground="Gray">
                                                                <DataGridTextColumn.Header>
                                                                    <StackPanel>
                                                                        <TextBlock Text="杭体"
                                                                    TextAlignment="Center"/>
                                                                        <TextBlock Text="番号"
                                                                    TextAlignment="Center"
                                                                    HorizontalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </DataGridTextColumn.Header>
                                                            </DataGridTextColumn>

                                                            <DataGridTextColumn Width="*" Binding="{Binding Z, StringFormat=N3}"
                                                                    ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50"
                                                                    IsReadOnly=" true" Foreground="Gray">
                                                                <DataGridTextColumn.Header>
                                                                    <StackPanel>
                                                                        <TextBlock Text="杭頭"
                                                                            TextAlignment="Center"/>
                                                                        <TextBlock Text="Z"
                                                                            TextAlignment="Center"/>
                                                                        <TextBlock Text="(m)"
                                                                            TextAlignment="Center"
                                                                            HorizontalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </DataGridTextColumn.Header>
                                                            </DataGridTextColumn>

                                                            <DataGridTextColumn Width="*" Binding="{Binding PileBottomAltitude, StringFormat=N3}"
                                                                    ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50"
                                                                    IsReadOnly=" true" Foreground="Gray">
                                                                <DataGridTextColumn.Header>
                                                                    <StackPanel>
                                                                        <TextBlock Text="杭先端"
                                                                            TextAlignment="Center"/>
                                                                        <TextBlock Text="Z"
                                                                            TextAlignment="Center"/>
                                                                        <TextBlock Text="(m)"
                                                                            TextAlignment="Center"
                                                                            HorizontalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </DataGridTextColumn.Header>
                                                            </DataGridTextColumn>

                                                            <DataGridTextColumn Width="*" Binding="{Binding GroupPileLoadDia, StringFormat=N3}"
                                                                    ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50">
                                                                <DataGridTextColumn.Header>
                                                                    <StackPanel>
                                                                        <TextBlock Text="荷重面"
                                                                            TextAlignment="Center"/>
                                                                        <TextBlock Text="等価径"
                                                                            TextAlignment="Center"/>
                                                                        <TextBlock Text="(m)"
                                                                            TextAlignment="Center"
                                                                            HorizontalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </DataGridTextColumn.Header>
                                                            </DataGridTextColumn>
                                                        </DataGrid.Columns>
                                                    </common:EnhancedDataGrid>
                                                </StackPanel>

                                                <!-- 一回解析実行ボタン -->
                                                <Button Grid.Row="3" Width="240" HorizontalAlignment="Left" Margin="0,8,0,0"
                                                        Command="{Binding PileGroupSettlementAnalysisCommand}"
                                                        ToolTip="基礎梁を考慮しない単発のスタインブレナー解析を実行します。">
                                                    <StackPanel Orientation="Horizontal">
                                                        <svgc:SvgViewbox Source="/Icons/GroupPileSettlement.svg"
                                                                         Style="{StaticResource SvgIconStyle24}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="一般解析実行" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </TabItem>

                                        <!-- 解析（反復）サブタブ: 基礎梁の剛性を考慮した反復スタインブレナー解析 -->
                                        <TabItem Header="解析（反復）" x:Name="TabItemLoadBeamAware"
                                                 ToolTip="基礎梁を含むモデルで、矩形荷重 (個別矩形) を反復で再分配しながらスタインブレナー沈下を解く解析です。">
                                            <Grid Margin="8">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- 重要: 適用範囲の注記 -->
                                                <Border Grid.Row="0" Margin="0,0,0,8" Padding="8,6"
                                                        Background="#FFFFF4D6" BorderBrush="#FFE3B341" BorderThickness="1"
                                                        CornerRadius="2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="⚠" FontSize="14" Foreground="#FFC97A00"
                                                                   VerticalAlignment="Top" Margin="0,0,6,0"/>
                                                        <TextBlock TextWrapping="Wrap" Foreground="#FF6B4A00">
                                                            <Run FontWeight="Bold" Text="解析（反復）"/>
                                                            <Run Text="は、基礎指針'19 図5.3.2 連続梁・格子梁モデルによる沈下量の算定例の方法です。"/>
                                                            <LineBreak/>
                                                            <Run Text="杭基礎の計算では使いません。"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>

                                                <!-- 反復解析 用の荷重面標高 -->
                                                <Grid Grid.Row="1" Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="荷重面 Z (m)" Grid.Column="0" VerticalAlignment="Center" Margin="0,2,4,2"/>
                                                    <TextBox Text="{Binding LoadingPlaneAltitudeBeamAwareProxy, StringFormat={}{0:+0.00;-0.00;+0.00}, UpdateSourceTrigger=LostFocus}"
                                                             Grid.Column="1"
                                                             HorizontalContentAlignment="Right" Margin="0,2"
                                                             GotFocus="TextBox_GotFocus"
                                                             PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                             KeyDown="TextBox_KeyDown">
                                                        <TextBox.ToolTip>
                                                            <TextBlock Text="反復解析 (基礎梁考慮) で使用される荷重面標高。一回解析と独立に設定できます。"/>
                                                        </TextBox.ToolTip>
                                                    </TextBox>
                                                    <TextBlock Text="標高 (m)" Grid.Column="2" VerticalAlignment="Center" Margin="8,2,4,2"/>
                                                    <TextBox Grid.Column="3" IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}"
                                                             HorizontalContentAlignment="Right" Margin="0,2">
                                                        <TextBox.Text>
                                                            <MultiBinding StringFormat="{}{0:+0.00;-0.00;+0.00}" Mode="OneWay">
                                                                <Binding Path="CurrentInputModel.PileGroupSettlement.LoadingPlaneAltitudeBeamAware"/>
                                                                <Binding Path="CurrentInputModel.FundamentalInput.ReferenceAltitude"/>
                                                                <MultiBinding.Converter>
                                                                    <conv:SumConverter/>
                                                                </MultiBinding.Converter>
                                                            </MultiBinding>
                                                        </TextBox.Text>
                                                    </TextBox>
                                                </Grid>

                                                <TextBlock Grid.Row="2" TextWrapping="Wrap" Margin="0,0,0,8"
                                                           Text="基礎梁を考慮した群杭沈下解析 (反復スタインブレナー法) を実行します。&#x0A;荷重タイプは「個別矩形」固定で、矩形荷重は反復計算により自動収束されます (DX/DY/QA は事前に手動上書き可)。"/>

                                                <!-- 基礎梁が無い場合の注意書き -->
                                                <TextBlock Grid.Row="3" Margin="0,4" Foreground="{StaticResource ErrorBrush}"
                                                           Text="※ 基礎梁が定義されていません。梁要素タブで基礎梁を追加してから実行してください。">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CurrentInputModel.FoundationBeamInput.Beams.Count}" Value="0">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- 保存中の解析結果の有無 -->
                                                <TextBlock Grid.Row="4" Margin="0,8,0,0"
                                                           Visibility="{Binding HasGroupSettlementBeamAwareCases, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                           Foreground="{StaticResource PrimaryAccentDarkBrush}"
                                                           Text="✓ 基礎梁考慮の解析結果が保存されています (詳細は 解析結果 → 沈下量タブ → 結果タイプ で確認)。"/>

                                                <!-- 矩形荷重 (DX/DY/QA は編集可、X1/Y1/X2/Y2 と 連結杭No は派生値のため読取専用) -->
                                                <GroupBox Grid.Row="5" Header="矩形荷重 (個別矩形)" Margin="0,8,0,0">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Grid.Row="0" Margin="4" TextWrapping="Wrap" Foreground="Gray" FontSize="11"
                                                                   Text="X1/Y1/X2/Y2、DX/DY、QA いずれも編集できます。DX/DY を編集すると中心位置を保ったまま X1/X2/Y1/Y2 が対称に再計算されます。&#x0A;行番号は杭 No と一致します。反復解析を実行すると QA は収束値で更新されます。"/>

                                                        <!-- リセットボタン: 個別矩形 (杭ごとに1矩形) を再生成 -->
                                                        <Button Grid.Row="1" HorizontalAlignment="Left" Margin="4,2,4,4" Padding="8,2"
                                                                Command="{Binding ResetBeamAwareRectLoadsCommand}"
                                                                ToolTip="現在の矩形荷重を破棄し、各杭に対して個別矩形 (1 矩形/杭) を再生成します。&#x0A;DX/DY は荷重面等価径から、QA は VL 軸力から自動算出。">
                                                            <StackPanel Orientation="Horizontal">
                                                                <svgc:SvgViewbox Source="/Icons/CreateAutoUniformlyDistributedLoad.svg" Style="{StaticResource SvgIconStyle24}" Margin="0,0,4,0"/>
                                                                <TextBlock Text="リセット (個別矩形を再生成)" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <common:EnhancedDataGrid Grid.Row="2"
                                                                ItemsSource="{Binding CurrentInputModel.PileGroupSettlement.RectLoads, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                                                                AutoGenerateColumns="False"
                                                                CanUserAddRows="False"
                                                                CanUserSortColumns="False"
                                                                LoadingRow="DataGrid_LoadingRow_Numbering"
                                                                CellEditEnding="DataGridRectLoads_CellEditEnding"
                                                                EnableRowVirtualization="True"
                                                                ScrollViewer.CanContentScroll="True"
                                                                CellStyle="{StaticResource CustomDataGridCellStyle}">
                                                            <DataGrid.ContextMenu>
                                                                <StaticResource ResourceKey="CommonDataGridContextMenu"/>
                                                            </DataGrid.ContextMenu>
                                                            <DataGrid.ColumnHeaderStyle>
                                                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource PrimaryAccentBrush}"/>
                                                                </Style>
                                                            </DataGrid.ColumnHeaderStyle>
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="X1 (m)" Binding="{Binding X1, StringFormat=N3, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                                                                                    ElementStyle="{StaticResource RightAlignedTextBlockStyle}"
                                                                                    EditingElementStyle="{StaticResource SignedDecimalEditingTextBoxStyle}" Width="*" MinWidth="60"/>
                                                                <DataGridTextColumn Header="Y1 (m)" Binding="{Binding Y1, StringFormat=N3, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                                                                                    ElementStyle="{StaticResource RightAlignedTextBlockStyle}"
                                                                                    EditingElementStyle="{StaticResource SignedDecimalEditingTextBoxStyle}" Width="*" MinWidth="60"/>
                                                                <DataGridTextColumn Header="X2 (m)" Binding="{Binding X2, StringFormat=N3, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                                                                                    ElementStyle="{StaticResource RightAlignedTextBlockStyle}"
                                                                                    EditingElementStyle="{StaticResource SignedDecimalEditingTextBoxStyle}" Width="*" MinWidth="60"/>
                                                                <DataGridTextColumn Header="Y2 (m)" Binding="{Binding Y2, StringFormat=N3, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                                                                                    ElementStyle="{StaticResource RightAlignedTextBlockStyle}"
                                                                                    EditingElementStyle="{StaticResource SignedDecimalEditingTextBoxStyle}" Width="*" MinWidth="60"/>
                                                                <DataGridTextColumn Header="DX (m)" Binding="{Binding DX, StringFormat=N3, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                                                                                    ElementStyle="{StaticResource RightAlignedTextBlockStyle}"
                                                                                    EditingElementStyle="{StaticResource SignedDecimalEditingTextBoxStyle}" Width="*" MinWidth="60"/>
                                                                <DataGridTextColumn Header="DY (m)" Binding="{Binding DY, StringFormat=N3, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                                                                                    ElementStyle="{StaticResource RightAlignedTextBlockStyle}"
                                                                                    EditingElementStyle="{StaticResource SignedDecimalEditingTextBoxStyle}" Width="*" MinWidth="60"/>
                                                                <DataGridTextColumn Header="QA (kN)" Binding="{Binding QA, StringFormat=N1, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                                                                                    ElementStyle="{StaticResource RightAlignedTextBlockStyle}"
                                                                                    EditingElementStyle="{StaticResource SignedDecimalEditingTextBoxStyle}" Width="*" MinWidth="70"/>
                                                                <!-- 連結杭 No 列は撤去: 反復解析タブでは行番号 = 杭 No と一致するため冗長 (内部データは LinkedPileNo として保持) -->
                                                            </DataGrid.Columns>
                                                        </common:EnhancedDataGrid>
                                                    </Grid>
                                                </GroupBox>

                                                <!-- 反復解析実行ボタン (タブ最下段) -->
                                                <Button Grid.Row="6" Width="240" HorizontalAlignment="Left" Margin="0,8,0,0"
                                                        Command="{Binding OpenGroupSettlementWithBeamWindowCommand}"
                                                        ToolTip="基礎梁の剛性を考慮した反復スタインブレナー解析を実行します。">
                                                    <StackPanel Orientation="Horizontal">
                                                        <svgc:SvgViewbox Source="/Icons/GroupPileSettlementWithBeamWindow.svg"
                                                                         Style="{StaticResource SvgIconStyle24}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="反復解析実行" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </TabItem>


                                    </TabControl>

                                    <!-- 旧: 群杭沈下解析実行ボタン (タブ全体下) は撤去。
                                         一回解析タブの下部 / 反復解析タブの下部 にそれぞれ専用ボタンを配置。 -->
                                </Grid>
                            </avalonDock:LayoutDocument>

                        </avalonDock:LayoutDocumentPane>
                    </avalonDock:LayoutDocumentPaneGroup>

                    <avalonDock:LayoutDocumentPaneGroup DockWidth="2*">
                        <avalonDock:LayoutDocumentPane>
                            <avalonDock:LayoutDocument Title="編集ビュー" CanClose="False" >
                                <Grid>
                                    <Grid >
                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="120"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- B.6: Canvas 背景 (奥行き感のある薄いグラデーション) -->
                                        <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="3"
                                                Panel.ZIndex="-1" IsHitTestVisible="False">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Offset="0" Color="#FBFCFD"/>
                                                    <GradientStop Offset="1" Color="#EFF2F5"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <Canvas x:Name="Canvas3DLayout"
                                                Grid.Row="0"
                                                Grid.RowSpan="3"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="3"
                                                HorizontalAlignment="Left"
                                                Background="Transparent"
                                                Opacity="1"
                                                Focusable="True"
                                                FocusVisualStyle="{x:Null}"
                                                Cursor="{Binding CanvasCursor}"
                                                PreviewKeyDown="Canvas3DLayout_PreviewKeyDown"
                                               
                                                MouseLeftButtonDown="Canvas3DLayout_MouseLeftButtonDown"
                                                MouseLeftButtonUp="Canvas3DLayout_MouseLeftButtonUp"
                                                MouseMove="Canvas3DLayout_MouseMove"
                                                MouseRightButtonDown="Canvas3DLayout_MouseRightButtonDown"
                                                MouseRightButtonUp=" Canvas3DLayout_MouseRightButtonUp"
                                                MouseLeave="Canvas3DLayout_MouseLeave"
                                                MouseWheel="Canvas3DLayout_MouseWheel"
                                                MouseDown="Canvas3DLayout_MouseDown"
                                                
                                                PreviewMouseUp="Canvas3DLayout_PreviewMouseUp"
                                                LostMouseCapture="Canvas3DLayout_LostMouseCapture"
                                                SizeChanged="Canvas3DLayout_SizeChanged"
                                                Panel.ZIndex="0">
                                        </Canvas>

                                        <!-- ミニマップはAvalonDockパネルに移動 -->

                                        <Canvas x:Name="ColorBarCanvas"
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Visibility="Visible"
                                                Margin="10"
                                                Width="20"
                                                Height="200"
                                                Background="Transparent"
                                                Panel.ZIndex="20">
                                        </Canvas>

                                        <StackPanel Grid.Column="2" Grid.Row="0" Grid.RowSpan="3"
                                                    VerticalAlignment="Top" HorizontalAlignment="Right"
                                                    Panel.ZIndex="10">
                                            <Grid Width="140" Height="120"
                                                  Visibility="{Binding IsViewCubeVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Canvas x:Name="CanvasCube"
                                                    VerticalAlignment="Top"
                                                    HorizontalAlignment="Center"
                                            Background="Transparent"
                                            Visibility="Visible"
                                            Width="100"
                                            Height="100"
                                            Panel.ZIndex="10"
                                            MouseLeftButtonDown="CanvasCube_MouseLeftButtonDown"
                                            MouseMove="CanvasCube_MouseMove"
                                            MouseLeave="CanvasCube_MouseLeave"
                                            MouseLeftButtonUp="CanvasCube_MouseLeftButtonUp">
                                        </Canvas>

                                                <Slider HorizontalAlignment="Center"
                                                        VerticalAlignment="Bottom"
                                                        Minimum="-180" Maximum="180" ToolTip="左右回転θ(°)" Orientation="Horizontal" Width="100"
                                                        Value="{Binding CanvasThreeDView.Tht, UpdateSourceTrigger=PropertyChanged}"
                                                        Panel.ZIndex="10" />
                                                <Slider HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Minimum="-90" Maximum="90" ToolTip="上下回転φ(°)" Orientation="Vertical" Height="80"
                                                        Value="{Binding CanvasThreeDView.Phi, UpdateSourceTrigger=PropertyChanged}"
                                                        Panel.ZIndex="10"/>
                                            </Grid>

                                            <Grid Width="140"
                                                  Visibility="{Binding IsRightToolbarVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Grid HorizontalAlignment="Right"
                                                      VerticalAlignment="Top"
                                                      Margin="0,0,2,0"
                                                      Panel.ZIndex="10">
                                            <!-- 行高さに合わせて明示 -->

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>

                                            <!-- ビュー/選択/アクティブ関連アイコンパネル -->
                                            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" 
                                                Margin="0,5,0,0"
                                                Padding="0"
                                                Background="#12DCDCDC"
                                                
                                                BorderThickness="0"
                                                CornerRadius="0"
                                                Panel.ZIndex="12">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition/>
                                                        <RowDefinition/>
                                                        <RowDefinition/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 行0: ビュー切替 -->
                                                    <Button Grid.Row="0" Grid.Column="0"
                                                            Padding="0"
                                                            Style="{StaticResource LargeIconToolTipButtonStyle}"
                                                            Tag="ズームフィット (Ctrl + 0)"
                                                            Command="{Binding ZoomFitCommand}">
                                                        <svgc:SvgViewbox Source="/Icons/ZoomFit.svg" Style="{StaticResource SvgIconStyle24}"/>
                                                    </Button>
                                                    <Button Grid.Row="0" Grid.Column="1"
                                                            Padding="0"
                                                            Style="{StaticResource LargeIconToolTipButtonStyle}"
                                                            Tag="平面 (Ctrl + Shift + T)"
                                                            Command="{Binding ViewXYPlaneCommand}">
                                                        <svgc:SvgViewbox Source="/Icons/TopView.svg" Style="{StaticResource SvgIconStyle24}"/>
                                                    </Button>
                                                    <Button Grid.Row="0" Grid.Column="2"
                                                            Padding="0"
                                                            Style="{StaticResource LargeIconToolTipButtonStyle}"
                                                            Tag="正面 (Ctrl + Shift + F)"
                                                            Command="{Binding ViewXZPlaneCommand}">
                                                        <svgc:SvgViewbox Source="/Icons/FrontView.svg" Style="{StaticResource SvgIconStyle24}"/>
                                                    </Button>
                                                    <Button Grid.Row="0" Grid.Column="3"
                                                            Padding="0"
                                                            Style="{StaticResource LargeIconToolTipButtonStyle}"
                                                            Tag="右面 (Ctrl + Shift + R)"
                                                            Command="{Binding ViewYZPlaneCommand}">
                                                        <svgc:SvgViewbox Source="/Icons/RightView.svg" Style="{StaticResource SvgIconStyle24}"/>
                                                    </Button>
                                                    <Button Grid.Row="0" Grid.Column="4"
                                                            Padding="0"
                                                            Style="{StaticResource LargeIconToolTipButtonStyle}"
                                                            Tag="アイソメ (Ctrl + Shift + I)"
                                                            Command="{Binding ViewIsometricCommand}">
                                                        <svgc:SvgViewbox Source="/Icons/IsometricView.svg" Style="{StaticResource SvgIconStyle24}"/>
                                                    </Button>

                                                    <!-- 行1: アクティブ操作 -->
                                                    <Button Grid.Row="1" Grid.Column="0"
                                                        Padding="0"
                                                        Style="{StaticResource LargeIconToolTipButtonStyle}"
                                                        Tag="すべてアクティブ (Ctrl + Shift + A)"
                                                        Click="ShowAllNodesButton_Click">
                                                        <svgc:SvgViewbox Source="/Icons/ActiveAll.svg" Style="{StaticResource SvgIconStyle24}"/>
                                                    </Button>
                                                    <Button Grid.Row="1" Grid.Column="1"
                                                        Padding="0"
                                                        Style="{StaticResource LargeIconToolTipButtonStyle}"
                                                        Tag="アクティブ (F2)"
                                                        Click="ShowSelectedNodesButton_Click">
                                                        <svgc:SvgViewbox Source="/Icons/SelectedActive.svg" Style="{StaticResource SvgIconStyle24}"/>
                                                    </Button>
                                                    <Button Grid.Row="1" Grid.Column="2"
                                                        Padding="0"
                                                        Style="{StaticResource LargeIconToolTipButtonStyle}"
                                                        Tag="非アクティブ (Shift + F2)"
                                                        Click="ShowUnselectedNodesButton_Click">
                                                        <svgc:SvgViewbox Source="/Icons/SelectedInactive.svg" Style="{StaticResource SvgIconStyle24}"/>
                                                    </Button>
                                                    <Button Grid.Row="1" Grid.Column="3"
                                                        Padding="0"
                                                        Style="{StaticResource LargeIconToolTipButtonStyle}"
                                                        Tag="アクティブ反転"
                                                        Click="InvertActiveNodesButton_click">
                                                        <svgc:SvgViewbox Source="/Icons/InvertActive.svg" Style="{StaticResource SvgIconStyle24}"/>
                                                    </Button>

                                                    <!-- 行2: 選択操作 -->
                                                    <Button Grid.Row="2" Grid.Column="0"
                                                        Padding="0"
                                                        Style="{StaticResource LargeIconToolTipButtonStyle}"
                                                        Tag="すべて選択 (Ctrl + A)"
                                                        Click="SelectAllNodesButton_Click">
                                                        <svgc:SvgViewbox Source="/Icons/SelectAll.svg" Style="{StaticResource SvgIconStyle24}"/>
                                                    </Button>
                                                    <Button Grid.Row="2" Grid.Column="1"
                                                        Padding="0"
                                                        Style="{StaticResource LargeIconToolTipButtonStyle}"
                                                        Tag="全選択解除 (Esc)"
                                                        Click="DeselectAllNodesButton_Click">
                                                        <svgc:SvgViewbox Source="/Icons/DeselectAll.svg" Style="{StaticResource SvgIconStyle24}"/>
                                                    </Button>
                                                </Grid>
                                            </Border>


                                            <!-- ウィンドウ関連ミニパネル -->
                                            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" 
                                                    Margin="0,5,0,0"
                                                    Padding="0"
                                                    Background="#12DCDCDC"
                                                    BorderThickness="0"
                                                    CornerRadius="0"
                                                    Panel.ZIndex="15">
                                                <Grid>
                                                    <!-- 行定義拡張: 0=荷重ケース,1=組合せ,2=液状化トグル,3=解析結果トグル,4=解析内容選択 -->
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition />
                                                        <RowDefinition />
                                                        <RowDefinition />
                                                        <RowDefinition />
                                                        <RowDefinition />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition />
                                                        <ColumnDefinition />
                                                        <ColumnDefinition />
                                                        <ColumnDefinition />
                                                        <ColumnDefinition />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- 行0: 入力 -->
                                                    <Button x:Name="ButtonFundamentalWindow0" Grid.Row="0" Grid.Column="0"
                                                        Padding="0"
                                                        Style="{StaticResource LargeIconToolTipButtonStyle}"
                                                        Tag="基本設定 (Ctrl + E)"
                                                        Command="{Binding OpenFundamentalWindowCommand}">
                                                        <svgc:SvgViewbox Source="/Icons/FundamentalWindow.svg" Style="{StaticResource SvgIconStyle24}"/>
                                                    </Button>
                                                    <Button Grid.Row="0" Grid.Column="1"
                                                        Padding="0"
                                                        Style="{StaticResource LargeIconToolTipButtonStyle}"
                                                        Tag="荷重条件編集 (Ctrl + L)"
                                                        Command="{Binding OpenLoadCaseWindowCommand}">
                                                        <svgc:SvgViewbox Source="/Icons/LoadCaseWindow.svg" Style="{StaticResource SvgIconStyle24}"/>
                                                    </Button>
                                                    <Button Grid.Row="0" Grid.Column="2"
                                                        Padding="0"
                                                        Style="{StaticResource LargeIconToolTipButtonStyle}"
                                                        Tag="地盤編集 (Ctrl + G)"
                                                        Command="{Binding OpenGroundWindowCommand}">
                                                        <svgc:SvgViewbox Source="/Icons/GroundWindow.svg" Style="{StaticResource SvgIconStyle24}"/>
                                                    </Button>
                                                    <Button Grid.Row="0" Grid.Column="3"
                                                        Padding="0"
                                                        Style="{StaticResource LargeIconToolTipButtonStyle}"
                                                        Tag="杭体編集 (Ctrl + B)"
                                                        Command="{Binding OpenPileBodyWindowCommand}">
                                                        <svgc:SvgViewbox Source="/Icons/PileBodyWindow.svg" Style="{StaticResource SvgIconStyle24}"/>
                                                    </Button>
                                                    <Button x:Name="ButtonAxialVerification0" Grid.Row="0" Grid.Column="4"
                                                        Padding="0"
                                                        Style="{StaticResource LargeIconToolTipButtonStyle}"
                                                        Tag="軸力確認 (Ctrl + K)"
                                                        Command="{Binding AxialForceCheckCommand}">
                                                        <svgc:SvgViewbox Source="/Icons/AxialForceVeirification.svg" Style="{StaticResource SvgIconStyle24}"/>
                                                    </Button>

                                                    <!-- 追加: 杭要素分割（状態でアイコン切替） -->

                                                    <!-- 行1: 杭要素分割 -->
                                                    <Button Grid.Row="1" Grid.Column="0"
                                                        Padding="0"
                                                        Style="{StaticResource ElementDivisionButtonStyle}"
                                                        Command="{Binding OpenElementDivisionWindowCommand}"/>

                                                    <!-- 行1: 水平解析（状態でアイコン切替） -->
                                                    <Button Grid.Row="1" Grid.Column="1"
                                                        Padding="0"
                                                        Style="{StaticResource LateralLoadAnalysisButtonStyle}"
                                                        Command="{Binding OpenLateralLoadAnalysisWindowCommand}"/>

                                                    <!-- 行1: 単杭沈下解析（状態でアイコン切替） -->
                                                    <Button Grid.Row="1" Grid.Column="2"
                                                        Padding="0"
                                                        Style="{StaticResource SettlementAnalysisButtonStyle}"
                                                        Command="{Binding OpenSettlementWindowCommand}"/>

                                                    <!-- 行1: 基礎梁考慮沈下解析 -->
                                                    <Button Grid.Row="1" Grid.Column="3"
                                                        Padding="0"
                                                        Style="{StaticResource LargeIconToolTipButtonStyle}"
                                                        Tag="基礎梁の剛性を考慮した沈下解析です。基礎梁を含むモデルで荷重沈下関係解析を実行したときに押下可能となります。"
                                                        Command="{Binding OpenVerticalBeamCalculationCommand}">
                                                        <svgc:SvgViewbox Source="/Icons/SettlementWithBeamWindow.svg" Style="{StaticResource SvgIconStyle24}"/>
                                                    </Button>

                                                    <!-- 行1: 群杭沈下解析（状態でアイコン切替） -->
                                                    <Button Grid.Row="1" Grid.Column="4"
                                                        Padding="0"
                                                        Style="{StaticResource GroupPileSettlementButtonStyle}"
                                                        Command="{Binding PileGroupSettlementAnalysisCommand}"/>
                                                </Grid>
                                            </Border>

                                            <!-- 荷重関連ミニパネル -->
                                            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" 
                                                    Margin="0,5,0,0"
                                                    Padding="0"
                                                    Background="#12DCDCDC"
                                                    BorderThickness="0"
                                                    CornerRadius="0"
                                                    Panel.ZIndex="15">
                                                <Grid>
                                                    <!-- 行定義拡張: 0=荷重ケース,1=組合せ,2=液状化トグル,3=群杭沈下切替,4=解析結果トグル,5=解析内容選択 -->
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- 荷重ケース -->
                                                    <Fluent:ComboBox Header="荷重ケース" Grid.Row="0"
                                                          HorizontalAlignment="Stretch"
                                                          ItemsSource="{Binding LoadCaseNameOption}"
                                                          SelectedItem="{Binding SelectedLoadCaseName}"
                                                          ItemTemplate="{StaticResource LoadCaseItemTemplate}"
                                                          ToolTip="荷重ケース">
                                                        <Fluent:ComboBox.Foreground>
                                                            <MultiBinding Converter="{StaticResource LoadCaseNameToColorConverter}">
                                                                <Binding Path="SelectedLoadCaseName"/>
                                                                <Binding Path="CurrentInputModel.LoadCasesInput.AllSeismicLoadCases"/>
                                                            </MultiBinding>
                                                        </Fluent:ComboBox.Foreground>
                                                        <Fluent:ComboBox.HeaderTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}" Foreground="#555555"/>
                                                            </DataTemplate>
                                                        </Fluent:ComboBox.HeaderTemplate>
                                                        <i:Interaction.Triggers>
                                                            <i:EventTrigger EventName="SelectionChanged">
                                                                <i:InvokeCommandAction Command="{Binding UpdateViewCommand}"/>
                                                            </i:EventTrigger>
                                                        </i:Interaction.Triggers>
                                                    </Fluent:ComboBox>

                                                    <!-- 組合せケース -->
                                                    <Fluent:ComboBox Header="組合せ" Grid.Row="1"
                                                              HorizontalAlignment="Stretch"
                                                              ItemsSource="{Binding LoadCombinationNameOption}"
                                                              SelectedItem="{Binding SelectedLoadCombinationName}"
                                                              ItemTemplate="{StaticResource LoadCombinationItemTemplate}">
                                                        <Fluent:ComboBox.ToolTip>
                                                            <TextBlock>
                                                                <Run Text="組合せケース α"/>
                                                                <Run Text="L" BaselineAlignment="Subscript" FontSize="10"/>
                                                                <Run Text="/β"/>
                                                                <Run Text="U" BaselineAlignment="Subscript" FontSize="10"/>
                                                                <Run Text="/β"/>
                                                                <Run Text="L" BaselineAlignment="Subscript" FontSize="10"/>
                                                            </TextBlock>
                                                        </Fluent:ComboBox.ToolTip>
                                                        <Fluent:ComboBox.Visibility>
                                                            <MultiBinding Converter="{StaticResource LoadCaseNameInSeismicCasesToVisibilityConverter}">
                                                                <Binding Path="SelectedLoadCaseName"/>
                                                                <Binding Path="CurrentInputModel.LoadCasesInput.AllSeismicLoadCases"/>
                                                            </MultiBinding>
                                                        </Fluent:ComboBox.Visibility>
                                                        <i:Interaction.Triggers>
                                                            <i:EventTrigger EventName="SelectionChanged">
                                                                <i:InvokeCommandAction Command="{Binding UpdateViewCommand}"/>
                                                            </i:EventTrigger>
                                                        </i:Interaction.Triggers>
                                                    </Fluent:ComboBox>

                                                    <!-- 液状化・非液状化 セグメントボタン -->
                                                    <UniformGrid Grid.Row="2" Rows="1" Margin="0,2,0,0"
                                                                ToolTip="液状化・非液状化の切替">
                                                        <UniformGrid.Visibility>
                                                            <MultiBinding Converter="{StaticResource LoadCaseNameInSeismicCasesToVisibilityConverter}">
                                                                <Binding Path="SelectedLoadCaseName"/>
                                                                <Binding Path="CurrentInputModel.LoadCasesInput.AllSeismicLoadCases"/>
                                                            </MultiBinding>
                                                        </UniformGrid.Visibility>
                                                        <RadioButton Content="非液状化" GroupName="PaneLiquefaction"
                                                                     Style="{StaticResource AnalyzedSegmentedButtonStyle}"
                                                                     IsChecked="{Binding IsLiquefaction, Converter={StaticResource BooleanNegationConverter}}"
                                                                     Tag="{Binding IsCurrentNonLiquefactionAnalyzed}"
                                                                     Margin="0,0,1,0"/>
                                                        <RadioButton Content="液状化" GroupName="PaneLiquefaction"
                                                                     Style="{StaticResource AnalyzedSegmentedButtonStyle}"
                                                                     IsChecked="{Binding IsLiquefaction}"
                                                                     Tag="{Binding IsCurrentLiquefactionAnalyzed}"
                                                                     Margin="1,0,0,0"/>
                                                    </UniformGrid>

                                                    <!-- 群杭沈下 一般 / 反復 切替 (常時表示: 荷重描画と解析結果の両方で使う) -->
                                                    <Fluent:ComboBox Header="群杭沈下" Grid.Row="3"
                                                                     HorizontalAlignment="Stretch"
                                                                     ItemsSource="{Binding GroupSettlementRouteOptions}"
                                                                     SelectedItem="{Binding GroupSettlementRouteSelector, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     ToolTip="一般 / 反復 解析の切替 (荷重描画 + 解析結果 共通)"
                                                                     Margin="0,4,0,0"/>

                                                    <!-- 解析結果表示トグル (Primary Action: アクセント色で目立たせる) -->
                                                    <ToggleButton x:Name= "ButtonAnalysisResult" Grid.Row="4"
                                                          Content="杭・梁要素 解析結果"
                                                          ToolTip="解析結果の表示/非表示 (主要操作)"
                                                          IsChecked="{Binding IsAnalysisResultVisible}"
                                                          IsEnabled="{Binding HasAnyAnalysisResult}"
                                                          Margin="0,6,0,0"
                                                          Height="30"
                                                          Padding="8,0"
                                                          FontWeight="SemiBold"
                                                          FontSize="12"
                                                          BorderThickness="1.5"
                                                          BorderBrush="{StaticResource PrimaryAccentBrush}"
                                                          Foreground="{StaticResource PrimaryAccentBrush}"
                                                          HorizontalContentAlignment="Center"
                                                          VerticalContentAlignment="Center">
                                                        <ToggleButton.Style>
                                                            <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                                                <Style.Triggers>
                                                                    <!-- 無効時: 薄くする (チェック時の見た目はグローバル ToggleButton Style に委譲) -->
                                                                    <Trigger Property="IsEnabled" Value="False">
                                                                        <Setter Property="Opacity" Value="0.45"/>
                                                                        <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource SurfaceBorderBrush}"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ToggleButton.Style>
                                                    </ToggleButton>

                                                    <!-- 解析結果内容選択 -->
                                                    <StackPanel Grid.Row="5" Orientation="Vertical" Margin="0,4,0,0"
                                                        Visibility="{Binding IsAnalysisResultVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <!-- 内容 -->
                                                        <Fluent:ComboBox Header="内容" 
                                                              ItemsSource="{Binding AnalysisResultContentOption}"
                                                              SelectedItem="{Binding AnalysisResultContent}">
                                                            <Fluent:ComboBox.ToolTip>
                                                                <TextBlock Text="解析結果の種類選択"/>
                                                            </Fluent:ComboBox.ToolTip>
                                                            <i:Interaction.Triggers>
                                                                <i:EventTrigger EventName="SelectionChanged">
                                                                    <i:InvokeCommandAction Command="{Binding ComboBox3DAnalysisResultContent_OnSelectionChangedCommand}"/>
                                                                </i:EventTrigger>
                                                            </i:Interaction.Triggers>
                                                        </Fluent:ComboBox>

                                                        <!-- 沈下種別 -->
                                                        <Fluent:ComboBox Header="沈下種別" 
                                                              ItemsSource="{Binding AnalysisResultSettlementOption}"
                                                              SelectedItem="{Binding AnalysisResultSettlementType}"
                                                              Visibility="{Binding AnalysisResultContent, Converter={StaticResource AnalysisResultContentEqualsToVisibilityConverter}, ConverterParameter=沈下量|沈下部材角|沈下反力|沈下応力}">
                                                            <i:Interaction.Triggers>
                                                                <i:EventTrigger EventName="SelectionChanged">
                                                                    <i:InvokeCommandAction Command="{Binding ComboBox3DAnalysisResultContent_OnSelectionChangedCommand}"/>
                                                                </i:EventTrigger>
                                                            </i:Interaction.Triggers>
                                                        </Fluent:ComboBox>

                                                        <!-- 梁応力種別 -->
                                                        <Fluent:ComboBox Header="梁応力"
                                                              ItemsSource="{Binding AnalysisResultBeamForceOption}"
                                                              SelectedItem="{Binding AnalysisResultBeamForceType}"
                                                              ItemContainerStyle="{StaticResource ResultSymbolItemStyle}"
                                                              Visibility="{Binding AnalysisResultContent, Converter={StaticResource AnalysisResultContentEqualsToVisibilityConverter}, ConverterParameter=梁応力（水平）|沈下応力}">
                                                            <i:Interaction.Triggers>
                                                                <i:EventTrigger EventName="SelectionChanged">
                                                                    <i:InvokeCommandAction Command="{Binding ComboBox3DAnalysisResultContent_OnSelectionChangedCommand}"/>
                                                                </i:EventTrigger>
                                                            </i:Interaction.Triggers>
                                                        </Fluent:ComboBox>

                                                        <!-- 節点変位種別 -->
                                                        <Fluent:ComboBox Header="節点変位" 
                                                              ItemsSource="{Binding AnalysisResultNodeDisplacementOption}"
                                                              SelectedItem="{Binding AnalysisResultNodeDisplacementType}"
                                                              ItemContainerStyle="{StaticResource ResultSymbolItemStyle}"
                                                              Visibility="{Binding AnalysisResultContent, Converter={StaticResource AnalysisResultContentEqualsToVisibilityConverter}, ConverterParameter=節点変位（水平）}">
                                                            <i:Interaction.Triggers>
                                                                <i:EventTrigger EventName="SelectionChanged">
                                                                    <i:InvokeCommandAction Command="{Binding ComboBox3DAnalysisResultContent_OnSelectionChangedCommand}"/>
                                                                </i:EventTrigger>
                                                            </i:Interaction.Triggers>
                                                        </Fluent:ComboBox>

                                                        <!-- 地盤反力種別 -->
                                                        <Fluent:ComboBox Header="地盤反力"
                                                              ItemsSource="{Binding AnalysisResultSoilSpringOption}"
                                                              SelectedItem="{Binding AnalysisResultSoilSpringType}"
                                                              ItemContainerStyle="{StaticResource ResultSymbolItemStyle}"
                                                              Visibility="{Binding AnalysisResultContent, Converter={StaticResource AnalysisResultContentEqualsToVisibilityConverter}, ConverterParameter=地盤反力（水平）}">
                                                            <i:Interaction.Triggers>
                                                                <i:EventTrigger EventName="SelectionChanged">
                                                                    <i:InvokeCommandAction Command="{Binding ComboBox3DAnalysisResultContent_OnSelectionChangedCommand}"/>
                                                                </i:EventTrigger>
                                                            </i:Interaction.Triggers>
                                                        </Fluent:ComboBox>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- 基礎梁編集モードパネル -->
                                            <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5"
                                                    Margin="0,0,0,0"
                                                    Padding="0"
                                                    Background="#12DCDCDC"
                                                    BorderThickness="0"
                                                    CornerRadius="0"
                                                    Panel.ZIndex="15">
                                                <StackPanel Orientation="Vertical">
                                                    <UniformGrid Rows="1">
                                                        <RadioButton Content="選択" GroupName="EditMode"
                                                                     Style="{StaticResource SegmentedButtonStyle}"
                                                                     IsChecked="{Binding CurrentEditMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=None}"
                                                                     Margin="0,0,1,0" ToolTip="選択モード(Esc)"/>
                                                        <RadioButton Content="要素追加" GroupName="EditMode"
                                                                     Style="{StaticResource SegmentedButtonStyle}"
                                                                     IsChecked="{Binding CurrentEditMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=AddElement}"
                                                                     Margin="1,0,0,0" ToolTip="梁要素追加モード(Alt+1)：杭接合節点、一般節点をクリックし、梁要素を追加します。"/>
                                                    </UniformGrid>
                                                </StackPanel>
                                            </Border>

                                        </Grid>
                                            </Grid>
                                        </StackPanel>

                                    </Grid>
                                </Grid>
                            </avalonDock:LayoutDocument>

                            <!--
                                形状確認ビュー（HelixViewport3D）は一時的に機能凍結中。
                                名前付きフィールドは維持したまま、UpdatePerspectiveView 側のフラグ (IsHelixViewFrozen) で描画をスキップしています。
                                再有効化する場合: Grid の Visibility を Visible に戻し、MainWindow.VIewPort3D.cs の IsHelixViewFrozen を false にしてください。
                            -->
                            <avalonDock:LayoutDocument x:Name="FrozenShapeViewDocument" Title="形状確認ビュー（凍結中）" CanClose="False">
                                <Grid Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <ToolBar Grid.Row="0">
                                        <ComboBox x:Name="HelixViewComboBox" SelectionChanged="HelixViewComboBox_SelectionChanged">
                                            <ComboBoxItem Content="平行投影図法"/>
                                            <ComboBoxItem Content="透視図法" IsSelected="True"/>
                                        </ComboBox>

                                        <ToggleButton Content="XYZ軸" IsChecked="True"
                                                      Checked="ToggleButtonXYZAxes_Checked" Unchecked="ToggleButtonXYZAxes_UnClicked"></ToggleButton>
                                        <ToggleButton Content="XYグリッド" IsChecked="True"
                                                      Checked="ToggleButtonXYGrid_Checked" Unchecked="ToggleButtonXYGrid_UnClicked"></ToggleButton>

                                        <Button x:Name="HelixViewportSaveImage"   Content="画像保存" Margin="0" Click="HelixViewportSaveImageButton_Click" />

                                        <CheckBox Content="レベル1共通慣性力作用点" x:Name="CheckBoxCommonActionPoint3D" IsChecked="True"
                                                          Click="CheckBoxCommonActionPoint3D_Click"></CheckBox>
                                    </ToolBar>

                                    <h:HelixViewport3D x:Name="HelixViewport"
                                                       ShowCoordinateSystem="True"
                                                       Grid.Row="1"
                                                       MouseLeftButtonDown="HelixViewport_MouseLeftButtonDown" />
                                </Grid>
                            </avalonDock:LayoutDocument>

                        </avalonDock:LayoutDocumentPane>
                    </avalonDock:LayoutDocumentPaneGroup>

                    <!-- プロパティ・ミニマップパネル（右側） -->
                    <avalonDock:LayoutAnchorablePaneGroup DockWidth="220" Orientation="Vertical">
                        <avalonDock:LayoutAnchorablePane DockHeight="*">
                            <avalonDock:LayoutAnchorable x:Name="propertiesAnchorable"
                                                         Title="プロパティ"
                                                         CanClose="False"
                                                         CanHide="True"
                                                         CanAutoHide="True"
                                                         AutoHideWidth="220">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- ヘッダー: 1 行目はタイトル、2 行目は杭選択時のみモード/合計トグル群 -->
                                    <Border Grid.Row="0" Background="{StaticResource SurfaceMutedBrush}" Padding="8,4">
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock Text="{Binding SelectedItemHeader}"
                                                       FontWeight="SemiBold" FontSize="13"
                                                       Foreground="#333"/>
                                            <!-- サブ行: 杭選択時のみ。軸力モード (絶対/変動) と複数選択時の合計/各値 を、
                                                 それぞれ角丸ボーダーで囲んでグループであることを視覚化する。 -->
                                            <StackPanel Orientation="Horizontal"
                                                        Margin="0,4,0,0"
                                                        Visibility="{Binding IsAnyPileSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <!-- 軸力モード: 絶対 / 変動 (軸力タブと IsAxialForceVariationMode を共有) -->
                                                <Border BorderBrush="{StaticResource SurfaceBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="4,2"
                                                        Background="White">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton Content="絶対" FontSize="11" Padding="3,1"
                                                                     VerticalAlignment="Center"
                                                                     GroupName="AxialModePanel"
                                                                     IsChecked="{Binding IsAxialForceVariationMode, Mode=TwoWay, Converter={StaticResource BooleanNegationConverter}}"
                                                                     ToolTip="絶対モード: 軸力 1-1 等に絶対値 (VL+地震時) を表示・編集"/>
                                                        <RadioButton Content="変動" FontSize="11" Padding="3,1" Margin="6,0,0,0"
                                                                     VerticalAlignment="Center"
                                                                     GroupName="AxialModePanel"
                                                                     IsChecked="{Binding IsAxialForceVariationMode, Mode=TwoWay}"
                                                                     ToolTip="変動モード: ΔN 1-1 等に変動値 (= 絶対 − VL) を表示・編集"/>
                                                    </StackPanel>
                                                </Border>
                                                <!-- 複数選択時のみ表示する合計/各値 -->
                                                <Border BorderBrush="{StaticResource SurfaceBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="4,2"
                                                        Margin="6,0,0,0"
                                                        Background="White"
                                                        Visibility="{Binding IsMultipleSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton Content="合計" FontSize="11" Padding="3,1"
                                                                     VerticalAlignment="Center"
                                                                     GroupName="PropDisplayMode"
                                                                     IsChecked="{Binding PropertyDisplayIsTotal, Mode=TwoWay}"
                                                                     ToolTip="複数杭の合計値を表示"/>
                                                        <RadioButton Content="各値" FontSize="11" Padding="3,1" Margin="6,0,0,0"
                                                                     VerticalAlignment="Center"
                                                                     GroupName="PropDisplayMode"
                                                                     IsChecked="{Binding PropertyDisplayIsTotal, Mode=TwoWay, Converter={StaticResource BooleanNegationConverter}}"
                                                                     ToolTip="各杭の値 (異なれば (various)) を表示"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- プロパティ一覧（スクロール可能） -->
                                    <ScrollViewer Grid.Row="1"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  x:Name="PropertyPanelScrollViewer"
                                                  PreviewKeyDown="PropertyPanel_PreviewKeyDown">
                                        <ItemsControl ItemsSource="{Binding SelectedItemProperties}"
                                                      Margin="0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="8,4" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="0,0,0,1"
                                                            Background="Transparent"
                                                            ToolTip="{Binding Description}"
                                                            ToolTipService.IsEnabled="{Binding HasDescription}"
                                                            ToolTipService.InitialShowDelay="500"
                                                            ToolTipService.ShowDuration="20000">
                                                        <Grid Background="Transparent">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" MinWidth="70"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- 項目名（NameColor指定がある場合はその色で表示） -->
                                                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                                       Foreground="{Binding NameColor, TargetNullValue=#666, FallbackValue=#666}"
                                                                       FontSize="12"
                                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>

                                                            <!-- 読み取り専用 TextBlock。Unit を separate に渡している場合はここで値だけ、
                                                                 単位は下の Unit ラベルで描画。Unit が空の場合は ColumnSpan=2 で値が拡張. -->
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Value}"
                                                                       Foreground="#222" FontSize="12" FontWeight="Medium"
                                                                       VerticalAlignment="Center"
                                                                       HorizontalAlignment="Right" TextAlignment="Right">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Setter Property="Grid.ColumnSpan" Value="2"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding InputType}" Value="Number">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding InputType}" Value="ComboBox">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <!-- ReadOnly でも Unit が空でなければ value 列だけに収め、Unit ラベルを別で描画 -->
                                                                            <DataTrigger Binding="{Binding HasUnit}" Value="True">
                                                                                <Setter Property="Grid.ColumnSpan" Value="1"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>

                                                            <!-- 編集用 TextBox（Number） -->
                                                            <TextBox Grid.Column="1"
                                                                     Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                                                                     FontSize="12" FontWeight="Medium"
                                                                     HorizontalContentAlignment="Right"
                                                                     VerticalAlignment="Center"
                                                                     BorderThickness="0,0,0,1" BorderBrush="{StaticResource PrimaryAccentBrush}"
                                                                     Background="Transparent" Padding="0"
                                                                     GotFocus="PropertyPanel_TextBox_GotFocus">
                                                                <TextBox.Style>
                                                                    <Style TargetType="TextBox">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding InputType}" Value="Number">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBox.Style>
                                                            </TextBox>

                                                            <!-- 単位ラベル: Number で Unit が非空、または ReadOnly で Unit が非空のとき表示。
                                                                 ComboBox では非表示 (ComboBox 自体が ColumnSpan=2 で領域を占有) -->
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding Unit}"
                                                                       Foreground="#888" FontSize="11"
                                                                       VerticalAlignment="Center" Margin="3,0,0,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding InputType}" Value="Number"/>
                                                                                    <Condition Binding="{Binding HasUnit}" Value="True"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </MultiDataTrigger>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding InputType}" Value="ReadOnly"/>
                                                                                    <Condition Binding="{Binding HasUnit}" Value="True"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>

                                                            <!-- 編集用 ComboBox -->
                                                            <ComboBox Grid.Column="1" Grid.ColumnSpan="2"
                                                                      SelectedItem="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                      ItemsSource="{Binding Options}"
                                                                      FontSize="12" VerticalAlignment="Center"
                                                                      HorizontalContentAlignment="Right"
                                                                      BorderThickness="0,0,0,1" BorderBrush="{StaticResource PrimaryAccentBrush}"
                                                                      ToolTip="{Binding Description}"
                                                                      ToolTipService.IsEnabled="{Binding HasDescription}"
                                                                      ToolTipService.InitialShowDelay="500"
                                                                      ToolTipService.ShowDuration="20000">
                                                                <ComboBox.Style>
                                                                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding InputType}" Value="ComboBox">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ComboBox.Style>
                                                            </ComboBox>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </avalonDock:LayoutAnchorable>
                        </avalonDock:LayoutAnchorablePane>

                        <avalonDock:LayoutAnchorablePane DockHeight="180">
                            <avalonDock:LayoutAnchorable x:Name="minimapAnchorable"
                                                         Title="ミニマップ"
                                                         CanClose="False"
                                                         CanHide="True"
                                                         CanAutoHide="True"
                                                         AutoHideWidth="220">
                                <Border Background="White">
                                    <Canvas x:Name="MinimapCanvas"
                                            ClipToBounds="True"
                                            Background="Transparent"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            SizeChanged="MinimapCanvas_SizeChanged"
                                            MouseLeftButtonDown="MinimapCanvas_MouseLeftButtonDown"
                                            MouseMove="MinimapCanvas_MouseMove"
                                            MouseLeftButtonUp="MinimapCanvas_MouseLeftButtonUp"/>
                                </Border>
                            </avalonDock:LayoutAnchorable>
                        </avalonDock:LayoutAnchorablePane>
                    </avalonDock:LayoutAnchorablePaneGroup>

                </avalonDock:LayoutPanel >
            </avalonDock:LayoutRoot>
        </avalonDock:DockingManager>

        <!-- トースト通知 -->
        <Border x:Name="ToastBorder"
                Grid.Row="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,24,24"
                Padding="16,10"
                CornerRadius="6"
                Background="#E6333333"
                Visibility="Collapsed"
                Panel.ZIndex="9999"
                IsHitTestVisible="False"
                RenderTransformOrigin="1,1">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastTranslate" X="0" Y="0"/>
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ToastIcon" Text="&#x2714;" Foreground="#4CAF50" FontSize="14"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="ToastText" Text="" Foreground="White" FontSize="13"
                           VerticalAlignment="Center" MaxWidth="400" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ステータスバーの定義 -->
        <Grid Grid.Row="2" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="4,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding StatusMessageColor}" Margin="0,0,16,0"/>
                <TextBlock Text="{Binding SelectionCountText}" Foreground="{StaticResource NikkenPaleRedBrush}" Margin="0,0,16,0"/>
                <TextBlock Text="{Binding PileCountText}" Foreground="DarkBlue" Margin="0,0,16,0"/>
                <!-- 解析結果セットの状態: 入力を変更しても結果は破棄されないので、
                     表示中の結果がいつの入力によるものかを常に示す -->
                <TextBlock Text="{Binding ResultSetStatusText}" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="DarkGreen"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding InputChangedSinceAnalysis}" Value="True">
                                    <Setter Property="Foreground" Value="DarkOrange"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- 解析項目別ステータス: リボンの ✓ 色と統一 (Success=緑/Info=青/Warning=橙) -->
                <ItemsControl ItemsSource="{Binding AnalysisStatusItems}" Margin="0,0,16,0"
                              ToolTip="{Binding AnalysisStatusText}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}" Margin="0,0,12,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="Gray"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Color}" Value="Success">
                                                <Setter Property="Foreground" Value="{DynamicResource StatusSuccessBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Color}" Value="Info">
                                                <Setter Property="Foreground" Value="{DynamicResource StatusInfoBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Color}" Value="Warning">
                                                <Setter Property="Foreground" Value="{DynamicResource StatusWarningDarkBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Color}" Value="SkyBlue">
                                                <Setter Property="Foreground" Value="{DynamicResource NikkenSkyBlueBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding LastAnalysisTimeText}" Foreground="{StaticResource NikkenDeepBlueBrush}" Margin="0,0,16,0"
                           ToolTip="直近で完了した解析の時刻"/>
                <TextBlock Text="{Binding LastAutoSaveText}" Foreground="{Binding LastAutoSaveBrush}" Margin="0,0,16,0"
                           ToolTip="自動保存の最終結果（失敗時は赤）"/>
                <TextBlock Text="{Binding MouseCoordinateText}" Foreground="#555" Margin="0,0,16,0"/>
                <TextBlock Text="{Binding ZoomText}" Foreground="Gray" Margin="0,0,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">

                <!-- ショートカット一覧ヒント (パワーユーザー機能の発見性向上, Ctrl+/ でショートカットキー一覧) -->
                <Button Click="ShortcutHintButton_Click"
                        Background="Transparent" BorderThickness="0"
                        Padding="6,2" Margin="4,0,4,0"
                        VerticalAlignment="Center"
                        ToolTip="クリックまたは Ctrl+/ でショートカットキー一覧を表示 (F1 はヘルプ)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x2328;" Foreground="#666" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="ショートカット (Ctrl+/)" Foreground="#666" FontSize="11"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 入力ビジュアライザーはフロートウィンドウ (InputVisualizerWindow) に移動 -->

                <!-- 右余白（無描画帯）コントロール -->
                <Separator Width="8" Opacity="0"/>
                <TextBlock Text="メインキャンバス右余白" VerticalAlignment="Center" Margin="12,0,4,0"/>
                <Slider Width="50" Minimum="0" Maximum="250" IsDirectionReversed="True"
                Value="{Binding RightBlankWidthPx, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding RightBlankWidthPx, StringFormat={}{0:N0}px}"
                   VerticalAlignment="Center" Width="40"  Margin="4,0,4,0" TextAlignment="Right"/>

                <ToggleButton Style="{StaticResource LargeIconToolTipToggleButtonStyle}"
                              Tag="リボンメニュー最小化" IsChecked="{Binding IsRibboNMinimized}"
                                  Visibility="{Binding IsRibbonVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <svgc:SvgViewbox Source="/Icons/RibboNMinimize.svg" Style="{StaticResource SvgIconStyle24}"/>
                </ToggleButton>
                <ToggleButton Style="{StaticResource LargeIconToolTipToggleButtonStyle}"
                              Tag="リボン表示/非表示" IsChecked="{Binding IsRibbonVisible}">
                    <svgc:SvgViewbox Source="/Icons/RibbonVisible.svg" Style="{StaticResource SvgIconStyle24}"/>
                </ToggleButton>


            </StackPanel>
        </Grid>
    </Grid>
</Fluent:RibbonWindow>
