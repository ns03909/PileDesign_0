                                    <ribbon:RibbonApplicationMenuItem Header="計算例10　場所打ちRC杭"
                                              KeyTip="E2b"
                                              Command="{Binding Example10Command}"
                                              ToolTip="基礎指針'19 計算例10 場所打ち鉄筋コンクリート杭φ1500 L=37.5m"
                                              ImageSource="pack://application:,,,/Icons/cover.png"/>

                                    <Separator Margin="0,4"/>

                                    <!-- 関東支部 -->
                                    <TextBlock Text="基礎構造の設計（関東支部）" FontWeight="Bold" Foreground="#3271AD" Margin="0,2,0,2"/>
                                    <ribbon:RibbonApplicationMenuItem Header="7. 直接基礎の設計例"
                                              KeyTip="E3"
                                              Command="{Binding ExampleK7Command}"
                                              ToolTip="日本建築学会　関東支部　基礎構造の設計　学びやすい構造設計 計算例7を実行"
                                              ImageSource="pack://application:,,,/Icons/332-8002.jpg"/>
                                    <ribbon:RibbonApplicationMenuItem Header="8. 杭基礎の設計例"
                                              KeyTip="E4"
                                              Command="{Binding ExampleK8Command}"
                                              ToolTip="日本建築学会　関東支部　基礎構造の設計　学びやすい構造設計 計算例8を実行"
                                              ImageSource="pack://application:,,,/Icons/332-8002.jpg"/>

                                    <Separator Margin="0,4"/>

                                    <!-- 設計例集 -->
                                    <TextBlock Text="建築基礎構造設計例集" FontWeight="Bold" Foreground="#3271AD" Margin="0,2,0,2"/>
                                    <ribbon:RibbonApplicationMenuItem Header="3.1　SC杭, PRC杭"
                                              KeyTip="E5"
                                              Command="{Binding Example3_1Command}"
                                              ToolTip="日本建築学会　建築基礎構造設計例集3.1　非液状化地盤に建つ建物のPHC杭基礎"
                                              ImageSource="pack://application:,,,/Icons/316kZCPgkUL._SY291_BO1,204,203,200_QL40_ML2_.jpg"/>
                                    <ribbon:RibbonApplicationMenuItem Header="3.2　PHC杭"
                                              KeyTip="E6"
                                              Command="{Binding Example3_2Command}"
                                              ToolTip="日本建築学会　建築基礎構造設計例集3.2　砂地盤に建つ建物のPHC節杭基礎"
                                              ImageSource="pack://application:,,,/Icons/316kZCPgkUL._SY291_BO1,204,203,200_QL40_ML2_.jpg"/>
                                    <ribbon:RibbonApplicationMenuItem Header="3.3　場所打ち杭"
                                              KeyTip="E7"
                                              Command="{Binding Example3_3Command}"
                                              ToolTip="日本建築学会　建築基礎構造設計例集3.3　粘性土地盤に建つ免振建物の場所打ち鉄筋コンクリート杭基礎"
                                              ImageSource="pack://application:,,,/Icons/316kZCPgkUL._SY291_BO1,204,203,200_QL40_ML2_.jpg"/>
                                    <ribbon:RibbonApplicationMenuItem Header="3.4　SC杭"
                                              KeyTip="E8"
                                              Command="{Binding Example3_4Command}"
                                              ToolTip="日本建築学会　建築基礎構造設計例集3.4　液状化の可能性がある地盤に建つ建物のSC杭基礎"
                                              ImageSource="pack://application:,,,/Icons/316kZCPgkUL._SY291_BO1,204,203,200_QL40_ML2_.jpg"/>

                                    <!-- 追加計算例が増える場合はここに同様に列挙 -->
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </ribbon:RibbonApplicationMenu.AuxiliaryPaneContent>

                    <!-- 任意: 下端フッター -->
                    <ribbon:RibbonApplicationMenu.FooterPaneContent>
                        <TextBlock Text="{Binding WindowTitle}" Foreground="Gray" Margin="8,0,8,4"/>
                    </ribbon:RibbonApplicationMenu.FooterPaneContent>
                </ribbon:RibbonApplicationMenu>
            </ribbon:Ribbon.ApplicationMenu>

            <ribbon:RibbonTab Header="表示(V)" KeyTip="V">
                <!-- よく使う: 荷重ケース -->
                <ribbon:RibbonGroup Header="荷重ケース" SmallImageSource="pack://application:,,,/Icons/LoadCaseWindow.png">
                    <ComboBox Width="120"
                          ItemsSource="{Binding LoadCaseNameOption}"
                          SelectedItem="{Binding SelectedLoadCaseName}"
                          ItemTemplate="{StaticResource LoadCaseItemTemplate}"
                          ribbon:RibbonControlService.Label="荷重ケース"
                          ToolTip="荷重ケース">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding UpdateViewCommand}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        
                    </ComboBox>
                    <!--<TextBlock Margin="0,4,0,0">
                        <TextBlock.Visibility>
                            <MultiBinding Converter="{StaticResource LoadCaseNameInSeismicCasesToVisibilityConverter}">
                                <Binding Path="SelectedLoadCaseName"/>
                                <Binding Path="CurrentInputModel.LoadCasesInput.AllSeismicLoadCases"/>
                            </MultiBinding>
                        </TextBlock.Visibility>
                        <Run Text="組合せケース α"/>
                        <Run Text="L" BaselineAlignment="Subscript" FontSize="10"/>
                        <Run Text="/β"/>
                        <Run Text="U" BaselineAlignment="Subscript" FontSize="10"/>
                        <Run Text="/β"/>
                        <Run Text="L" BaselineAlignment="Subscript" FontSize="10"/>
                    </TextBlock>-->
                    <ComboBox Width="120"
