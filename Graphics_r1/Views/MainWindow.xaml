                                                </ComboBox>

                                                <ComboBox MinWidth="50"
                                                        SelectedItem="{Binding AnalysisResultNodeDisplacementType}" ItemsSource="{Binding AnalysisResultNodeDisplacementOption}"
                                                        Visibility="{Binding AnalysisResultContent, Converter={StaticResource AnalysisResultContentEqualsToVisibilityConverter}, ConverterParameter=節点変位}">

                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="SelectionChanged">
                                                            <i:InvokeCommandAction Command="{Binding ComboBox3DAnalysisResultContent_OnSelectionChangedCommand}" />
                                                        </i:EventTrigger>
                                                    </i:Interaction.Triggers>
                                                </ComboBox>


                                                <Separator/>

                                                <!--<StackPanel Orientation="Horizontal">
                                                    <svgc:SvgViewbox Source="/Icons/IsLoadingVisible.svg" Style="{StaticResource SvgIconStyle16}"/>
                                                    <CheckBox Content="軸力・慣性力表示" IsChecked="{Binding IsLoadingVisible, UpdateSourceTrigger=PropertyChanged}"/>
                                                </StackPanel>-->
                                                <StackPanel Orientation="Horizontal">
                                                    
                                                    <ToggleButton ToolTip="慣性力表示" IsChecked="{Binding IsMassLoadingVisible, UpdateSourceTrigger=PropertyChanged}">
                                                        <svgc:SvgViewbox Source="/Icons/IsActionPointLoadVisible.svg" Style="{StaticResource SvgIconStyle24}"/>
                                                    </ToggleButton>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal">

                                                    <ToggleButton ToolTip="軸力表示" IsChecked="{Binding IsAxialLoadingVisible, UpdateSourceTrigger=PropertyChanged}">
                                                        <svgc:SvgViewbox Source="/Icons/IsAxialLoadVisible.svg" Style="{StaticResource SvgIconStyle24}"/>
                                                    </ToggleButton>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal">

                                                    <ToggleButton ToolTip="地盤変位表示" IsChecked="{Binding IsForcedDisplacementVisible, UpdateSourceTrigger=PropertyChanged}">
                                                        <svgc:SvgViewbox Source="/Icons/IsForcedDispVisible.svg" Style="{StaticResource SvgIconStyle24}"/>
                                                    </ToggleButton>
                                                </StackPanel>

                                                <Separator/>

                                                <CheckBox MinWidth="50" Content="値表示"
                                                          IsChecked="{Binding IsResultValueVisible, UpdateSourceTrigger=PropertyChanged}">
                                                    <!--Visibility="{Binding IsAnalysisResultVisible, Converter={StaticResource BooleanToVisibilityConverter}}">-->
                                                </CheckBox>

                                                <CheckBox MinWidth="50" Content="要素中間のみ" Margin="10,0,0,0"
                                                            IsChecked="{Binding IsMidSpanResultValueVisibleOnly, UpdateSourceTrigger=PropertyChanged}"
                                                            Visibility="{Binding IsResultValueVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                                <CheckBox MinWidth="50" Content="杭頭のみ" Margin="10,0,0,0"
                                                            IsChecked="{Binding IsPileTopResultValueVisibleOnly, UpdateSourceTrigger=PropertyChanged}"
                                                            Visibility="{Binding IsResultValueVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                                <Separator/>

                                                <!-- テキスト位置調整 -->
                                                <StackPanel Orientation="Horizontal">
                                                    <!--<StackPanel.Visibility>
                                            <MultiBinding Converter="{StaticResource ResultValueAndMidSpanAndPileTopVisibilityConverter}">
                                                <Binding Path="IsResultValueVisible"/>
                                                <Binding Path="IsPileTopResultValueVisibleOnly"/>
                                                <Binding Path="IsMidSpanResultValueVisibleOnly"/>
                                            </MultiBinding>
                                        </StackPanel.Visibility>-->
                                                    <!--Visibility="{Binding IsResultValueVisible, Converter={StaticResource BooleanToVisibilityConverter}}">-->
                                                    <svgc:SvgViewbox Source="/Icons/AdjustTextPositions.svg" Style="{StaticResource SvgIconStyle24}" ToolTip="テキスト位置"/>
                                                   
                                                    <Slider Value="{Binding TextPosiitonAdjuster, UpdateSourceTrigger=PropertyChanged}"
                                                            Minimum="0" Maximum="20" TickFrequency="0.1" Grid.Row="1" Grid.Column="0"
                                                            VerticalAlignment="Center" Width="70"  
                                                             IsSnapToTickEnabled="True"/>
                                                    <TextBox Text="{Binding TextPosiitonAdjuster,StringFormat=N1, UpdateSourceTrigger=PropertyChanged}" 
                                                                 Width="30" HorizontalContentAlignment="Right" 
                                                             PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                             KeyDown="TextBox_KeyDown"/>
                                                </StackPanel>

                                                <!-- テキスト小数点位置 -->
                                                <!--<StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding IsResultValueVisible, Converter={StaticResource BooleanToVisibilityConverter}}">-->
                                                <StackPanel Orientation="Horizontal">
                                                    <svgc:SvgViewbox Source="/Icons/DecimalPoint.svg" Style="{StaticResource SvgIconStyle24}" ToolTip="小数点以下桁数"/>
                                                   
                                                    <Slider Value="{Binding DecimalPlaces, UpdateSourceTrigger=PropertyChanged}"
                                                            Minimum="0" Maximum="5" TickFrequency="0.1" Grid.Row="1" Grid.Column="0"
                                                            VerticalAlignment="Center" Width="70"  
                                                             IsSnapToTickEnabled="True"/>
                                                    <TextBox Text="{Binding DecimalPlaces, UpdateSourceTrigger=PropertyChanged}" 
                                                                 Width="30" HorizontalContentAlignment="Right" 
                                                             PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                             KeyDown="TextBox_KeyDown"/>
                                                </StackPanel>

                                                <!-- 応力用スケール -->
                                                <StackPanel Orientation="Horizontal">
                                                    <!--<StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding IsAnalysisResultVisible, Converter={StaticResource BooleanToVisibilityConverter}}">-->
                                                    <svgc:SvgViewbox Source="/Icons/LoadForceScale.svg" Style="{StaticResource SvgIconStyle24}" ToolTip="荷重応力スケール"/>
                                                    <Slider Value="{Binding ForceDiagramMultiplier, UpdateSourceTrigger=PropertyChanged}"
                                                        Minimum="0.5" Maximum="10.0" TickFrequency="0.1" Grid.Row="1" Grid.Column="0"
                                                        VerticalAlignment="Center" Width="70"  
                                                         IsSnapToTickEnabled="True"/>
                                                    <TextBox Text="{Binding ForceDiagramMultiplier,StringFormat=N1, UpdateSourceTrigger=PropertyChanged}" 
                                                                 Width="30" HorizontalContentAlignment="Right" 
                                                             PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                             KeyDown="TextBox_KeyDown"/>
                                                </StackPanel>

                                                <CheckBox Content="変位スケール適用" IsChecked="{Binding IsDispDiagramMultiplierApplicable}" />
                                                <!-- 変位用スケール -->
                                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsDispDiagramMultiplierApplicable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <!--<StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding IsAnalysisResultVisible, Converter={StaticResource BooleanToVisibilityConverter}}">-->
                                                    <svgc:SvgViewbox Source="/Icons/DisplacementScale.svg" Style="{StaticResource SvgIconStyle24}" ToolTip="変位スケール"/>
                                                    <Slider Value="{Binding DispDiagramMultiplier, Converter={StaticResource LogSliderConverter}, UpdateSourceTrigger=PropertyChanged}"
                                                            Minimum="0.1" Maximum="1000.0" TickFrequency="0.1" Grid.Row="1" Grid.Column="0"
                                                            VerticalAlignment="Center" Width="60"  
                                                            IsSnapToTickEnabled="True"/>
                                                    <TextBox Text="{Binding DispDiagramMultiplier,StringFormat=N1, UpdateSourceTrigger=PropertyChanged}" 
                                                                 Width="30" HorizontalContentAlignment="Right" 
                                                             PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                             KeyDown="TextBox_KeyDown"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </TabItem>

                                    <TabItem>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                
                                                <ToggleButton ToolTip="バブル" IsChecked="{Binding IsBubbleVisible, UpdateSourceTrigger=PropertyChanged}">
                                                    <svgc:SvgViewbox Source="/Icons/BubbleVisible.svg" Style="{StaticResource SvgIconStyle24}"/>
                                                </ToggleButton>
                                            </StackPanel>

                                            <!-- バブル径グループ -->
                                            <StackPanel Orientation="Horizontal" >
                                                
                                                    <svgc:SvgViewbox Source="/Icons/BubbleDia.svg" Style="{StaticResource SvgIconStyle24}" ToolTip="バブル径"/>
                                                
                                                <Slider  Minimum="0" Maximum="200"
                                                    Value="{Binding BubbleDia, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                                <TextBox Text="{Binding BubbleDia, StringFormat=N0, UpdateSourceTrigger=LostFocus}"
                                                    Width="30" HorizontalContentAlignment="Right" 
                                                         PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                         KeyDown="TextBox_KeyDown"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal">
                                                
                                                <ToggleButton ToolTip="矢印" IsChecked="{Binding IsArrowVisible, UpdateSourceTrigger=PropertyChanged}" >
                                                    <svgc:SvgViewbox Source="/Icons/ArrowVisible.svg" Style="{StaticResource SvgIconStyle24}"/>
                                                </ToggleButton>
                                            </StackPanel>

                                            <!-- 矢印全長グループ -->
                                            <StackPanel Orientation="Horizontal" >
                                                
                                                    <svgc:SvgViewbox Source="/Icons/ArrowLength.svg" Style="{StaticResource SvgIconStyle24}" ToolTip="矢印全長"/>
                                            
                                                <Slider Minimum="0" Maximum="200"
                                                    Value="{Binding ArrowLength, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                                <TextBox Text="{Binding ArrowLength, StringFormat=N0, UpdateSourceTrigger=LostFocus}"
                                                    Width="30" HorizontalContentAlignment="Right" 
                                                         PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                         KeyDown="TextBox_KeyDown"/>
                                            </StackPanel>

                                            <!-- 矢印頭長グループ -->
                                            <StackPanel Orientation="Horizontal" >
                                   
                                                    <svgc:SvgViewbox Source="/Icons/ArrowHeadLength.svg" Style="{StaticResource SvgIconStyle24}" ToolTip="矢印頭長"/>
                                  
                                                <Slider Minimum="0" Maximum="50"
                                                    Value="{Binding ArrowHeadLength, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                                <TextBox Text="{Binding ArrowHeadLength, StringFormat=N0, UpdateSourceTrigger=LostFocus}"
                                                    Width="30" HorizontalContentAlignment="Right" 
                                                         PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                         KeyDown="TextBox_KeyDown"/>
                                            </StackPanel>

                                            <!-- 矢印頭径グループ -->
                                            <StackPanel Orientation="Horizontal" >
                              
                                                    <svgc:SvgViewbox Source="/Icons/ArrowHeadDia.svg" Style="{StaticResource SvgIconStyle24}" ToolTip="矢印頭径"/>
                              
                                                <Slider Minimum="0" Maximum="20"
                                                    Value="{Binding ArrowHeadDia, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                                <TextBox Text="{Binding ArrowHeadDia, StringFormat=N0, UpdateSourceTrigger=LostFocus}"
                                                    Width="30" HorizontalContentAlignment="Right" 
                                                         PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                         KeyDown="TextBox_KeyDown"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal">
                                                <ToggleButton ToolTip="変形後要素" IsChecked="{Binding IsDeformedElementVisible, UpdateSourceTrigger=PropertyChanged}">
                                                    <svgc:SvgViewbox Source="/Icons/DeformedElementVisible.svg" Style="{StaticResource SvgIconStyle24}"/>
                                                </ToggleButton>
                                            </StackPanel>
                                        </StackPanel>
                                    </TabItem>
                                </TabControl>
                                <StackPanel Grid.Row="2">
                                </StackPanel>
                            </Grid>
                        </LayoutAnchorable>
                    </avalonDock:LayoutAnchorablePane>
                </avalonDock:LayoutPanel >
            </avalonDock:LayoutRoot>
        </avalonDock:DockingManager>

        <!-- ステータスバーの定義 -->
        <StatusBar Grid.Row="2">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding StatusMessageColor}" />
        </StatusBar>

    </Grid>
</Window>