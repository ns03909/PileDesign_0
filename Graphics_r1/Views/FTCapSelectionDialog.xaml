<Window x:Class="PileDesign.Views.FTCapSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FT キャップの選定"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,12">
            F.T.Pile 構法の杭体で FT キャップが選ばれていません。キャップを選ばないと、杭頭の曲げモーメント－回転角関係と許容回転角を求められません。<LineBreak/>
            杭径に合うキャップを選んであります。確かめて「選定して続行」を押してください。
        </TextBlock>

        <ItemsControl Grid.Row="1" x:Name="RowsList" ItemsSource="{Binding}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding PileBodyName}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding PileDiameter, StringFormat=杭径 {0:N0} mm}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="2" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedPhi, Mode=TwoWay}"
                                  ItemStringFormat="FT キャップ φ{0:N0}" ToolTip="FT キャップの杭径 (mm)"/>
                        <TextBlock Grid.Column="3" Text="杭径と違います" Foreground="Red" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DiffersFromPileDiameter}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Content="選定して続行" Width="110" Margin="0,0,8,0" IsDefault="True" Click="OnOk"/>
            <Button Content="キャンセル" Width="90" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
