<Window x:Class="PileDesign.Views.HorizontalCalculationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PileDesign.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:common="clr-namespace:PileDesign.Common"
        xmlns:conv="clr-namespace:PileDesign.Converters"
        d:DataContext="{d:DesignInstance Type=local:HorizontalCalculationViewModel}"
        mc:Ignorable="d"
        Title="水平解析" Height="700" Width="1200" WindowState="Maximized"
        x:Name="LateralCalcWin"
        PreviewKeyDown="Window_PreviewKeyDown">
    
    <!-- TextBoxの標準機能でCtrl+A（全選択）/ Ctrl+C（コピー）が動作 -->

    <Window.InputBindings>
        <!--<KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />-->
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding OkCommand}" />
        <KeyBinding Key="F5" Command="{Binding ExecuteAnalysisCommand}" />
        <KeyBinding Key="F5" Modifiers="Control" Command="{Binding ExecuteAdditiveAnalysisCommand}" />
    </Window.InputBindings>
    
    <Window.Resources>

        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <FrameworkElement x:Key="ProxyElement" DataContext="{Binding ElementName=MainWin, Path=DataContext}"/>

        <!-- 共通のスタイルを定義 -->
        <Style x:Key="RightAlignedTextBlockStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <Style x:Key="RightAlignedDataCellStyle" TargetType="DataGridCell">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <!-- Style for ComboBox elements to right-align text -->
        <Style x:Key="RightAlignedComboBoxStyle" TargetType="ComboBox">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <!-- Style for ComboBox items to right-align text -->
        <Style x:Key="RightAlignedComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <!-- 共通のスタイル定義 -->
        <Style x:Key="DataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        
        <!-- 特定の列ヘッダーの色を変更するスタイル -->
        <Style x:Key="GreenHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="#238966"/>
        </Style>
        
        <Style x:Key="YellowHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="#F7B515"/>
        </Style>
        
        <Style x:Key="DeepBlueHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="#3271AD"/>
        </Style>
        
        <Style x:Key="PaleRedHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="#E95541"/>
        </Style>
        
        <Style x:Key="CrimsonHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="#D82531"/>
        </Style>

        <!-- 読み取り専用数値列の共通スタイル（灰色・右寄せ） -->
        <Style x:Key="ReadOnlyNumericCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="Gray"/>
        </Style>

        <conv:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
        <conv:BooleanNegationConverter x:Key="BooleanNegationConverter"/>
        <conv:LoadCaseLevelToColorConverter x:Key="LoadCaseLevelToColorConverter"/>
        <conv:CompletedCaseToCheckMarkConverter x:Key="CompletedCaseToCheckMarkConverter"/>

        <!-- 列タイトル中央寄せ -->
        <Style x:Key="CenteredColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />

            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 上部コントロール (ウィンドウが小さい時は縦スクロール) -->

        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.Resources>
                <!-- セクションヘッダ (左ペインのセクション見出し) -->
                <Style x:Key="SectionHeader" TargetType="TextBlock">
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Foreground" Value="{StaticResource PrimaryAccentBrush}"/>
                    <Setter Property="Margin" Value="0,10,0,4"/>
                    <Setter Property="Padding" Value="0,0,0,2"/>
                </Style>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- v29 (2026-04-27): 左ペインを 2 タブに分割し、情報密度過多 (40+ 要素縦並び) を緩和。
                 タブ 1「荷重」: モデル情報 + 設計条件 + 解析対象 + 荷重ステップ
                 タブ 2「収束・並列」: 収束計算 + 並列処理 + 解析条件
                 ■ 実行 はタブ外で常時表示 (Grid.Row=1)。-->
            <TabControl Grid.Row="0" Padding="4">
                <TabItem Header="荷重">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Vertical" Margin="2">

            <!-- ========== モデル情報 ========== -->
            <TextBlock Text="■ モデル情報" Style="{StaticResource SectionHeader}"/>

            <Grid >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="節点数" Width="100" HorizontalAlignment="Left"/>
                <TextBox Text="{Binding NodesCount, UpdateSourceTrigger=PropertyChanged}"
                         Width="50" HorizontalContentAlignment="Right" IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}" HorizontalAlignment="Right"/>
            </Grid>

            <Grid >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="要素数" Width="100" HorizontalAlignment="Left"/>
                <TextBox Text="{Binding BeamsCount, UpdateSourceTrigger=PropertyChanged}"
                         Width="50" HorizontalContentAlignment="Right" IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}" HorizontalAlignment="Right"/>
            </Grid>

            <!-- ========== 設計条件 ========== -->
            <TextBlock Text="■ 設計条件" Style="{StaticResource SectionHeader}"/>

            <!-- 接続方式 -->
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <TextBlock Text="接続方式:" Width="60" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                <RadioButton Content="剛体連結" GroupName="ConnectionMode" Margin="0,0,12,0" VerticalAlignment="Center"
                             IsChecked="{Binding ConnectionMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=RigidBody}"
                             ToolTip="全杭を代表点に全6DOFで剛体連結"/>
                <RadioButton Content="剛床連結" GroupName="ConnectionMode" VerticalAlignment="Center"
                             IsChecked="{Binding ConnectionMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=RigidFloor}"
                             IsEnabled="{Binding HasFoundationBeamElements}"
                             ToolTipService.ShowOnDisabled="True">
                    <RadioButton.ToolTip>
                        <StackPanel>
                            <TextBlock Text="全杭を代表点にDOFをX,Y併進、Z回転を拘束"/>
                            <TextBlock Text="各杭頭接続節点を一般梁要素で連結している場合に適用可"/>
                            <TextBlock Text="{Binding FoundationBeamValidationMessage}" Foreground="Red">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasFoundationBeamElements}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </RadioButton.ToolTip>
                </RadioButton>
            </StackPanel>

            <!-- 杭軸力モード -->
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <TextBlock Text="杭軸力:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Width="60"/>
                <RadioButton Content="入力値" GroupName="AxialForceMode" Margin="0,0,12,0" VerticalAlignment="Center"
                             IsChecked="{Binding UseAnalysisAxialForce, Mode=TwoWay, Converter={StaticResource BooleanNegationConverter}}"
                             ToolTip="入力された軸力値のみを使用"/>
                <RadioButton Content="入力値＋応力解析結果" GroupName="AxialForceMode" VerticalAlignment="Center"
                             IsChecked="{Binding UseAnalysisAxialForce, Mode=TwoWay}"
                             ToolTip="入力軸力に解析で得られた軸力Fxiを加算&#x0a;（各荷重ステップ開始時に更新）"/>
            </StackPanel>

            <!-- ========== 解析対象 ========== -->
            <TextBlock Text="■ 解析対象" Style="{StaticResource SectionHeader}"/>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="液状化" Width="100"/>
                <RadioButton Content="あり" GroupName="Liquefaction"
                IsChecked="{Binding LiquefactionOption, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Yes}" Margin="0,0,10,0"/>
                <RadioButton Content="なし" GroupName="Liquefaction"
                IsChecked="{Binding LiquefactionOption, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=None}" Margin="0,0,10,0"/>
                <RadioButton Content="両方" GroupName="Liquefaction"
                IsChecked="{Binding LiquefactionOption, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Both}"/>
            </StackPanel>

            <TextBlock Text="荷重ケース レベル1" Margin="0,10,0,0"/>

            <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                <Button Content="すべて対象" Command="{Binding ApplyAllLoadCasesLevel1Command}" Width="80" Margin="0,0,5,0"/>
                <Button Content="すべて除外" Command="{Binding UnapplyAllLoadCasesLevel1Command}" Width="80"/>
            </StackPanel>

            <common:EnhancedDataGrid x:Name="DataGridLoadCasesLevel1"
                      ItemsSource="{Binding InputModel.LoadCasesInput.LoadCasesLevel1}" AutoGenerateColumns="False" HeadersVisibility="Column"
                      CanUserAddRows="False" CanUserResizeRows="False"
                      SelectionUnit="FullRow"
                      ColumnHeaderStyle="{StaticResource CenteredColumnHeaderStyle}">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="クリップボードにコピー" Click="CopyToClipboardFromContextMenu_Click" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SumH}" Value="0">
                                <Setter Property="Background" Value="#F0F0F0"/>
                                <Setter Property="Foreground" Value="Silver"/>
                                <Setter Property="FontStyle" Value="Italic"/>
                                <Setter Property="ToolTip" Value="荷重がゼロのため解析時にスキップされます"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <common:EnhancedDataGrid.Columns>
                    <DataGridTextColumn Header="ケース" Binding="{Binding LoadName}" Width="*" IsReadOnly="True">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Foreground" Value="{Binding Level, Converter={StaticResource LoadCaseLevelToColorConverter}}"/>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="ΣV(kN)" Binding="{Binding SumV, Mode=OneWay, StringFormat=N0}" Width="Auto" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource ReadOnlyNumericCellStyle}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="ΣH(kN)" Binding="{Binding SumH, Mode=OneWay, StringFormat=N0}" Width="Auto" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource ReadOnlyNumericCellStyle}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="ΣH/ΣV" Binding="{Binding SumHOverSumVText, Mode=OneWay}" Width="Auto" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource ReadOnlyNumericCellStyle}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="済" Width="32" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="11" Foreground="#238966" FontWeight="Bold"
                                           ToolTip="このロードケースに 1 件以上の解析結果あり">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource CompletedCaseToCheckMarkConverter}">
                                            <Binding Path="LoadName"/>
                                            <Binding Path="DataContext.CompletedCaseKeys"
                                                     RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridCheckBoxColumn Binding="{Binding IsAnalysisTarget, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="Auto"/>
                </common:EnhancedDataGrid.Columns>
            </common:EnhancedDataGrid>

            <TextBlock Text="荷重ケース レベル2" Margin="0,10,0,0"/>

            <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                <Button Content="すべて対象" Command="{Binding ApplyAllLoadCasesLevel2Command}" Width="80" Margin="0,0,5,0"/>
                <Button Content="すべて除外" Command="{Binding UnapplyAllLoadCasesLevel2Command}" Width="80"/>
            </StackPanel>

            <common:EnhancedDataGrid x:Name="DataGridLoadCasesLevel2"
                      ItemsSource="{Binding InputModel.LoadCasesInput.LoadCasesLevel2}" AutoGenerateColumns="False" HeadersVisibility="Column"
                      CanUserAddRows="False" CanUserResizeRows="False"
                      SelectionUnit="FullRow"
                      ColumnHeaderStyle="{StaticResource CenteredColumnHeaderStyle}">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="クリップボードにコピー" Click="CopyToClipboardFromContextMenu_Click" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SumH}" Value="0">
                                <Setter Property="Background" Value="#F0F0F0"/>
                                <Setter Property="Foreground" Value="Silver"/>
                                <Setter Property="FontStyle" Value="Italic"/>
                                <Setter Property="ToolTip" Value="荷重がゼロのため解析時にスキップされます"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <common:EnhancedDataGrid.Columns>
                    <DataGridTextColumn Header="ケース" Binding="{Binding LoadName}" Width="*" IsReadOnly="True">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Foreground" Value="{Binding Level, Converter={StaticResource LoadCaseLevelToColorConverter}}"/>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="ΣV(kN)" Binding="{Binding SumV, Mode=OneWay, StringFormat=N0}" Width="Auto" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource ReadOnlyNumericCellStyle}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="ΣH(kN)" Binding="{Binding SumH, Mode=OneWay, StringFormat=N0}" Width="Auto" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource ReadOnlyNumericCellStyle}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="ΣH/ΣV" Binding="{Binding SumHOverSumVText, Mode=OneWay}" Width="Auto" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource ReadOnlyNumericCellStyle}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="済" Width="32" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="11" Foreground="#238966" FontWeight="Bold"
                                           ToolTip="このロードケースに 1 件以上の解析結果あり">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource CompletedCaseToCheckMarkConverter}">
                                            <Binding Path="LoadName"/>
                                            <Binding Path="DataContext.CompletedCaseKeys"
                                                     RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridCheckBoxColumn Binding="{Binding IsAnalysisTarget, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="Auto" />
                </common:EnhancedDataGrid.Columns>
            </common:EnhancedDataGrid>

            <TextBlock Text="荷重組み合わせ"
                       ToolTip="水平荷重 = αL×D + βU×Ps + βL×Pf  (D:地盤変位, Ps:上部慣性力, Pf:基礎慣性力)。詳細はヘルプ参照。"/>

            <common:EnhancedDataGrid ItemsSource="{Binding InputModel.LoadCasesInput.LoadCombinations}" AutoGenerateColumns="False" HeadersVisibility="None"
                      CanUserAddRows="False"
                      SelectionUnit="FullRow">
                <common:EnhancedDataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Name, Mode=OneWay}" Width="*" IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}"/>
                    <DataGridCheckBoxColumn Binding="{Binding IsApplicable, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="Auto" />
                </common:EnhancedDataGrid.Columns>
            </common:EnhancedDataGrid>

            <!-- ========== 荷重ステップ (旧解析設定タブから移動) ========== -->
            <TextBlock Text="■ 荷重ステップ" Style="{StaticResource SectionHeader}"
                       ToolTip="入力値は初期 nStep。収束失敗時は ×2 倍で最大 3 回再試行。逆方向組合せ (βU×βL&lt;0) は max(入力×2, 12) を初期値。詳細ルールはヘルプ参照。"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Level1 1荷重あたり計算ステップ数" Grid.Column="0"  HorizontalAlignment="Left"/>
                <TextBox Text="{Binding Level1CalculationStepsCount, UpdateSourceTrigger=LostFocus}" Grid.Column="1" Width="50"
                         HorizontalAlignment="Right"
                         Style="{StaticResource IntegerTextBoxStyle}"
                         common:NumericInput.Min="1" common:NumericInput.Max="64"/>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Level2 1荷重あたり計算ステップ数" Grid.Column="0" HorizontalAlignment="Left"/>
                <TextBox Text="{Binding Level2CalculationStepsCount, UpdateSourceTrigger=LostFocus}" Grid.Column="1"
                         Width="50" HorizontalAlignment="Right"
                         Style="{StaticResource IntegerTextBoxStyle}"
                         common:NumericInput.Min="1" common:NumericInput.Max="128"/>
            </Grid>

            <DockPanel Margin="0,6,0,0">
                <TextBlock Text="全解析ステップ数："/>
                <TextBlock Text="{Binding TotalCalculationCount}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Right"/>
            </DockPanel>
            <TextBlock Text="荷重ケース × 組合せ × 液状化 × ステップ数 の総数。各ステップで収束計算を行います。" Foreground="Gray" FontSize="11" TextWrapping="Wrap"/>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="収束・並列">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Vertical" Margin="2">

            <!-- ========== 収束計算 ========== -->
            <TextBlock Text="■ 収束計算" Style="{StaticResource SectionHeader}"/>

            <!-- Newton-Raphson設定 -->
            <StackPanel Orientation="Vertical">
                <!-- NR法の種類（排他的） -->
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="NR法:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Width="60"/>
                    <RadioButton Content="Full NR" GroupName="NRMethod" Margin="0,0,12,0" VerticalAlignment="Center"
                                 IsChecked="{Binding UseModifiedNewtonRaphson, Mode=TwoWay, Converter={StaticResource BooleanNegationConverter}}"
                                 ToolTip="Full Newton-Raphson法&#x0a;反復中も接線剛性を更新（高速だが不安定な場合あり）"/>
                    <RadioButton Content="Full→Modified NR" GroupName="NRMethod" VerticalAlignment="Center"
                                 IsChecked="{Binding UseModifiedNewtonRaphson, Mode=TwoWay}"
                                 ToolTip="最初の N 回を Full NR で実行し、以降は Modified NR（K行列再利用）に移行&#x0a;Full NR の回数は下の「Full NR初期反復」で設定"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2"
                            Visibility="{Binding UseModifiedNewtonRaphson, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="" Width="60" Margin="0,0,8,0"/>
                    <TextBlock Text="Full NR初期反復:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Text="{Binding FullNRIterations, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="30" VerticalAlignment="Center"
                             Style="{StaticResource IntegerTextBoxStyle}"
                             common:NumericInput.Min="0" common:NumericInput.Max="50"
                             ToolTip="Modified NR 時に最初の N 回を Full NR で実行&#x0a;大きいほど収束が速いが反復あたりのコスト増&#x0a;デフォルト: 5"/>
                </StackPanel>

                <!-- 収束安定化手法（排他的） -->
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="安定化:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Width="60"/>
                    <RadioButton Content="固定ω" GroupName="ConvergenceMethod" Margin="0,0,4,0" VerticalAlignment="Center"
                                 IsChecked="{Binding SelectedConvergenceMethod, Mode=TwoWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=FixedRelaxation}"
                                 ToolTip="固定緩和係数を使用（標準）"/>
                    <TextBox Width="40" VerticalAlignment="Center" Margin="0,0,12,0"
                             Text="{Binding RelaxationFactor, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}"
                             Style="{StaticResource DecimalTextBoxStyle}"
                             common:NumericInput.Min="0.1" common:NumericInput.Max="1.0"
                             ToolTip="緩和係数ω（0.1-1.0）&#x0a;小さいほど安定だが収束に時間がかかる"/>
                    <RadioButton Content="適応的ω" GroupName="ConvergenceMethod" Margin="0,0,12,0" VerticalAlignment="Center"
                                 IsChecked="{Binding SelectedConvergenceMethod, Mode=TwoWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=AdaptiveRelaxation}"
                                 ToolTip="適応的緩和係数&#x0a;残差の変化に応じてωを自動調整"/>
                    <RadioButton Content="ラインサーチ" GroupName="ConvergenceMethod" VerticalAlignment="Center"
                                 IsChecked="{Binding SelectedConvergenceMethod, Mode=TwoWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=LineSearch}"
                                 ToolTip="ラインサーチ法&#x0a;Newton方向に沿って最適なステップ長を自動探索&#x0a;発散やリミットサイクルを防ぐ効果がある"/>
                </StackPanel>

                <!-- 反復なし（独立オプション） -->
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="特殊:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Width="60"/>
                    <CheckBox Content="反復なし（各ステップ1回解析）" VerticalAlignment="Center"
                              IsChecked="{Binding SkipIteration, Mode=TwoWay}"
                              ToolTip="各ステップで1回のみ解析（最も安定）&#x0a;荷重ステップ数を32～64に増やしてください"/>
                </StackPanel>
            </StackPanel>

            <!-- ========== 並列処理 ========== -->
            <TextBlock Text="■ 並列処理" Style="{StaticResource SectionHeader}"/>

            <StackPanel Orientation="Horizontal" Margin="0,2">
                <TextBlock Text="同時実行ケース数:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                <TextBox Width="40" VerticalAlignment="Center" Margin="0,0,4,0"
                         Text="{Binding MaxCaseDegreeOfParallelism, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         Style="{StaticResource IntegerTextBoxStyle}"
                         common:NumericInput.Min="1"
                         common:NumericInput.Max="{Binding ProcessorCount}"
                         ToolTip="複数の荷重ケースを同時に並行して計算する数 (並列処理)&#x0a;1 = 逐次 (1 ケースずつ順に)&#x0a;2 以上 = 並列 (N ケースを同時に CPU で処理)&#x0a;最大は PC の論理プロセッサ数&#x0a;メモリ不足やハングする場合は値を小さくしてください"/>
                <TextBlock Text="{Binding ProcessorCount, StringFormat='(1=逐次, 最大={0})'}"
                           Foreground="Gray" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Foreground="Gray" FontSize="11" Margin="0,0,0,2"
                       TextWrapping="Wrap"
                       Text="2 以上でケース単位の並列実行が有効。CPU コアを活用して解析時間を短縮します。"/>

            <!-- ========== 解析条件 (旧解析設定タブから移動) ========== -->
            <TextBlock Text="■ 解析条件" Style="{StaticResource SectionHeader}"/>

            <StackPanel Orientation="Horizontal" Margin="0,2" VerticalAlignment="Center" x:Name="DisplacementThresholdPanel">
                <CheckBox Content="変位閾値で解析中止"
                      IsChecked="{Binding StopONMaxDisplacement, Mode=TwoWay}"
                      VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="閾値 (m):" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox Width="60" VerticalAlignment="Center"
                         Text="{Binding MaxAllowedDisplacement, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N3, ValidatesOnExceptions=True, ValidatesOnDataErrors=True}"
                         Style="{StaticResource DecimalTextBoxStyle}"
                         common:NumericInput.Min="0.001"
                         ToolTip="最大許容代表変位（m）。この値を超えると解析が停止します。"/>
            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- 実行はタブ外で常時表示 (どのタブからでもアクセス可能) -->
            <StackPanel Grid.Row="1" Orientation="Vertical" Margin="2,4,2,2">

            <!-- ========== 実行 ========== -->
            <TextBlock Text="■ 実行" Style="{StaticResource SectionHeader}"/>

            <Button Content="水平解析実行 (F5)" Command="{Binding ExecuteAnalysisCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TotalCalculationCount}" Value="0">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="追加実行 (Ctrl+F5)" Command="{Binding ExecuteAdditiveAnalysisCommand}"
                    Margin="0,4,0,0"
                    ToolTip="既存結果を保持し、選択中ケースのうち未計算分のみ計算します。&#x0a;前回と異なる解析設定 (ステップ数等) の場合は実行できません。"/>

            <!--<Button Content="一時停止" Command="{Binding PauseAnalysisCommand}" IsEnabled="{Binding IsAnalysisRunning}" />
            <Button Content="再開" Command="{Binding ResumeAnalysisCommand}" IsEnabled="{Binding IsAnalysisRunning}" />-->
            <Button Content="水平解析キャンセル (Esc)" Command="{Binding CancelAnalysisCommand}" IsEnabled="{Binding IsAnalysisRunning}" />

            <Button Content="サマリーをコピー" Command="{Binding CopySummaryToClipboardCommand}"
                    IsEnabled="{Binding IsAnalysisExecuted}" Margin="0,4,0,0"
                    ToolTip="解析サマリーレポートを TSV (Excel 貼付可) でクリップボードにコピー"/>
            <Button Content="サマリーを CSV 出力" Command="{Binding ExportSummaryToCsvCommand}"
                    IsEnabled="{Binding IsAnalysisExecuted}" Margin="0,2,0,0"
                    ToolTip="解析サマリーレポートを CSV ファイルに保存"/>

            </StackPanel>
        </Grid>

        <!-- メイン表示部: TabControlでタブ切替 -->
        <StatusBar Grid.Row="2" Grid.ColumnSpan="2" Height="30"  VerticalAlignment="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
            <StatusBarItem>
                <ProgressBar
                    x:Name="ProgressBarMain"
                    Minimum="0"
                    Maximum="{Binding EffectiveProgressTotal, Mode=OneWay}"
                    Value="{Binding EffectiveProgress, Mode=OneWay}"
                    Height="18"
                    Width="200"
                    Margin="10,0,0,0" Foreground="{StaticResource PrimaryAccentBrush}"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding ProgressText}" Margin="10,0,0,0"/>
            </StatusBarItem>
        </StatusBar>
        
        <Grid Grid.Row="0" Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="計算ログ" Grid.Row="0"/>
            <!-- Option B: TabControl で「すべて」タブ + ケースごとのタブ (並列実行時にケース単位でログを追跡可能に)
                 - All タブ: 全ログを混在 (x:Name="LogTextBox")
                 - ケースタブ: 動的追加、case tag [L2-1.C1.Liq] を header にする
                 - 1 行増える毎に AppendText で増分追記 (Text binding 廃止) -->
            <TabControl x:Name="LogTabControl" Grid.Row="1">
                <TabItem Header="すべて" x:Name="LogTabAll">
                    <TextBox x:Name="LogTextBox"
                             IsReadOnly="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas, MS Gothic"
                             FontSize="12"
                             FontWeight="Normal"
                             Background="#FAFAFA"
                             AcceptsReturn="True">
                        <TextBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="コピー (Ctrl+C)" Command="ApplicationCommands.Copy"/>
                                <MenuItem Header="全選択 (Ctrl+A)" Command="ApplicationCommands.SelectAll"/>
                            </ContextMenu>
                        </TextBox.ContextMenu>
                    </TextBox>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- 下部ボタン -->
        <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Right">
            <!--<Button x:Name="ButtonOk" Content="Ok 解析結果登録" Height="30" Width="200" Command="{Binding OkCommand}"
                    Visibility="{Binding IsAnalysisExecuted, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Button x:Name="ButtonCancel" Content="Cancel" Height="30" Width="100" Command="{Binding CancelCommand}"/>-->
            <Button x:Name="ButtonOk" Content="保存 (Ctrl+Enter)" HorizontalAlignment="Left"
                    VerticalAlignment="Top" Height="30" Width="150" Command="{Binding OkCommand}" Visibility="{Binding IsAnalysisExecuted, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Button x:Name="ButtonCancel" Content="キャンセル (Esc)" HorizontalAlignment="Left"
                    VerticalAlignment="Top" Height="30" Width="150" Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</Window>

