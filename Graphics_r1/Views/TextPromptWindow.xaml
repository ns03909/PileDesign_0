<Window x:Class="PileDesign.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="名前を付けて保存" SizeToContent="Height" Width="380"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- 名前を 1 つ聞くだけの小さなダイアログ (表示プリセットの保存など) -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="PromptText" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,6"/>
        <TextBox x:Name="AnswerBox" Grid.Row="1" Margin="0,0,0,12"
                 AutomationProperties.Name="名前"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OkButton" Content="OK(_O)" Style="{StaticResource PrimaryDialogButtonStyle}"
                    IsDefault="True" Click="OkButton_Click"/>
            <Button Content="キャンセル(_C)" Style="{StaticResource DialogCancelButtonStyle}" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
