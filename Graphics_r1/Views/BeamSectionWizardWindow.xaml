<Window x:Class="PileDesign.Views.BeamSectionWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PileDesign.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:BeamSectionWizardViewModel}"
        xmlns:common="clr-namespace:PileDesign.Common"
        Title="断面ウィザード" Height="800" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        PreviewKeyDown="Window_PreviewKeyDown"
        common:EscapeKeyBehavior.Enable="True">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 断面No選択 -->
        <GroupBox Grid.Row="0" Header="編集対象" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="5">
                <Label Content="断面No" Width="80" HorizontalContentAlignment="Right"/>
                <ComboBox x:Name="ComboBoxSectionNo" Width="100"
                          SelectionChanged="ComboBoxSectionNo_SelectionChanged"/>
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="1">
            <GroupBox Header="断面寸法" Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Label Content="名称" Width="200" HorizontalContentAlignment="Right"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalContentAlignment="Right"
                                 GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Label Content="幅 b (m)" Width="200" HorizontalContentAlignment="Right"/>
                        <TextBox x:Name="TextBoxWidth" Text="{Binding Width, StringFormat=N3}" Width="100" HorizontalContentAlignment="Right"
                                 GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                 TextChanged="TextBox_TextChanged"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Label Content="高さ h (m)" Width="200" HorizontalContentAlignment="Right"/>
                        <TextBox x:Name="TextBoxHeight" Text="{Binding Height, StringFormat=N3}" Width="100" HorizontalContentAlignment="Right"
                                 GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                 TextChanged="TextBox_TextChanged"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="増減係数" Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Label Content="断面積係数 A" Width="200" HorizontalContentAlignment="Right"/>
                        <TextBox Text="{Binding AFactor, StringFormat=N3}" Width="100" HorizontalContentAlignment="Right"
                                 GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                 TextChanged="TextBox_TextChanged"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Label Content="せん断断面積係数 Ay" Width="200" HorizontalContentAlignment="Right"/>
                        <TextBox Text="{Binding AyFactor, StringFormat=N3}" Width="100" HorizontalContentAlignment="Right"
                                 GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                 TextChanged="TextBox_TextChanged"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Label Content="せん断断面積係数 Az" Width="200" HorizontalContentAlignment="Right"/>
                        <TextBox Text="{Binding AzFactor, StringFormat=N3}" Width="100" HorizontalContentAlignment="Right"
                                 GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                 TextChanged="TextBox_TextChanged"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Label Content="ねじりモーメント係数 Ixx" Width="200" HorizontalContentAlignment="Right"/>
                        <TextBox Text="{Binding IxxFactor, StringFormat=N3}" Width="100" HorizontalContentAlignment="Right"
                                 GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                 TextChanged="TextBox_TextChanged"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Label Content="断面二次モーメント係数 Iyy" Width="200" HorizontalContentAlignment="Right"/>
                        <TextBox Text="{Binding IyyFactor, StringFormat=N3}" Width="100" HorizontalContentAlignment="Right"
                                 GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                 TextChanged="TextBox_TextChanged"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Label Content="断面二次モーメント係数 Izz" Width="200" HorizontalContentAlignment="Right"/>
                        <TextBox Text="{Binding IzzFactor, StringFormat=N3}" Width="100" HorizontalContentAlignment="Right"
                                 GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                 TextChanged="TextBox_TextChanged"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="計算結果" Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Label Content="断面積 A (m²)" Width="200" HorizontalContentAlignment="Right"/>
                        <TextBox Text="{Binding Area, StringFormat=N6, Mode=OneWay}" Width="100" HorizontalContentAlignment="Right"
                                 IsReadOnly="True" Background="LightGray"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Label Content="せん断断面積 Ay (m²)" Width="200" HorizontalContentAlignment="Right"/>
                        <TextBox Text="{Binding ShearAreaY, StringFormat=N6, Mode=OneWay}" Width="100" HorizontalContentAlignment="Right"
                                 IsReadOnly="True" Background="LightGray"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Label Content="せん断断面積 Az (m²)" Width="200" HorizontalContentAlignment="Right"/>
                        <TextBox Text="{Binding ShearAreaZ, StringFormat=N6, Mode=OneWay}" Width="100" HorizontalContentAlignment="Right"
                                 IsReadOnly="True" Background="LightGray"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Label Content="ねじりモーメント Ixx (m⁴)" Width="200" HorizontalContentAlignment="Right"/>
                        <TextBox Text="{Binding TorsionalMoment, StringFormat=E3, Mode=OneWay}" Width="100" HorizontalContentAlignment="Right"
                                 IsReadOnly="True" Background="LightGray"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Label Content="断面二次モーメント Iyy (m⁴)" Width="200" HorizontalContentAlignment="Right"/>
                        <TextBox Text="{Binding MomentOfInertiaYY, StringFormat=E3, Mode=OneWay}" Width="100" HorizontalContentAlignment="Right"
                                 IsReadOnly="True" Background="LightGray"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Label Content="断面二次モーメント Izz (m⁴)" Width="200" HorizontalContentAlignment="Right"/>
                        <TextBox Text="{Binding MomentOfInertiaZZ, StringFormat=E3, Mode=OneWay}" Width="100" HorizontalContentAlignment="Right"
                                 IsReadOnly="True" Background="LightGray"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="2" Margin="0,10,0,0">
            <Button Content="適用" Width="80" Click="ApplyButton_Click" Margin="0,0,5,0"
                    ToolTip="現在の設定を適用して編集を続けます"/>
            <Button Content="OK" Width="80" Click="OkButton_Click" IsDefault="True" Margin="0,0,5,0"
                    ToolTip="現在の設定を適用して閉じます"/>
            <Button Content="キャンセル (Esc)" Width="100" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
