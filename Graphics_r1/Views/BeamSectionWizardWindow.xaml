<Window x:Class="PileDesign.Views.BeamSectionWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PileDesign.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:BeamSectionWizardViewModel}"
        xmlns:common="clr-namespace:PileDesign.Common"
        Title="断面ウィザード" Height="540" Width="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        PreviewKeyDown="Window_PreviewKeyDown"
        common:EscapeKeyBehavior.Enable="True">

    <Window.Resources>
        <!-- 1 行あたりの共通スタイル -->
        <Style x:Key="FieldRowStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="Label">
            <Setter Property="Width" Value="160"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
        <Style x:Key="FieldInputStyle" TargetType="TextBox" BasedOn="{StaticResource DecimalTextBoxStyle}">
            <Setter Property="Width" Value="80"/>
        </Style>
        <Style x:Key="FieldReadOnlyStyle" TargetType="TextBox">
            <Setter Property="Width" Value="80"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="LightGray"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 断面No選択 -->
        <GroupBox Grid.Row="0" Header="編集対象" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Margin="5">
                <Label Content="断面No" Width="60" HorizontalContentAlignment="Right"/>
                <ComboBox x:Name="ComboBoxSectionNo" Width="100"
                          SelectionChanged="ComboBoxSectionNo_SelectionChanged"/>
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="1">
            <!-- 断面寸法: 1 行に 3 項目を横並び -->
            <GroupBox Header="断面寸法" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" Margin="5,3">
                    <Label Content="名称" Width="40" HorizontalContentAlignment="Right" Padding="4,2"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,12,0" HorizontalContentAlignment="Left"
                             GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"/>
                    <Label Content="幅 b (m)" Width="70" HorizontalContentAlignment="Right" Padding="4,2"/>
                    <TextBox x:Name="TextBoxWidth" Text="{Binding Width, StringFormat=N3}" Width="80" Margin="0,0,12,0"
                             Style="{StaticResource DecimalTextBoxStyle}" common:NumericInput.Min="0.01"
                             GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                             TextChanged="TextBox_TextChanged"/>
                    <Label Content="高さ h (m)" Width="70" HorizontalContentAlignment="Right" Padding="4,2"/>
                    <TextBox x:Name="TextBoxHeight" Text="{Binding Height, StringFormat=N3}" Width="80"
                             Style="{StaticResource DecimalTextBoxStyle}" common:NumericInput.Min="0.01"
                             GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                             TextChanged="TextBox_TextChanged"/>
                </StackPanel>
            </GroupBox>

            <!-- 増減係数: 2 列 × 3 行 -->
            <GroupBox Header="増減係数" Margin="0,0,0,8">
                <Grid Margin="5,3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldRowStyle}">
                        <Label Content="断面積係数 A" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding AFactor, StringFormat=N3}" Style="{StaticResource FieldInputStyle}"
                                 common:NumericInput.Min="0" common:NumericInput.Max="10"
                                 GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                 TextChanged="TextBox_TextChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldRowStyle}">
                        <Label Content="ねじりモーメント係数 Ixx" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding IxxFactor, StringFormat=N3}" Style="{StaticResource FieldInputStyle}"
                                 common:NumericInput.Min="0" common:NumericInput.Max="10"
                                 GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                 TextChanged="TextBox_TextChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldRowStyle}">
                        <Label Content="せん断断面積係数 Ay" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding AyFactor, StringFormat=N3}" Style="{StaticResource FieldInputStyle}"
                                 common:NumericInput.Min="0" common:NumericInput.Max="10"
                                 GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                 TextChanged="TextBox_TextChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldRowStyle}">
                        <Label Content="断面二次モーメント係数 Iyy" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding IyyFactor, StringFormat=N3}" Style="{StaticResource FieldInputStyle}"
                                 common:NumericInput.Min="0" common:NumericInput.Max="10"
                                 GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                 TextChanged="TextBox_TextChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldRowStyle}">
                        <Label Content="せん断断面積係数 Az" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding AzFactor, StringFormat=N3}" Style="{StaticResource FieldInputStyle}"
                                 common:NumericInput.Min="0" common:NumericInput.Max="10"
                                 GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                 TextChanged="TextBox_TextChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldRowStyle}">
                        <Label Content="断面二次モーメント係数 Izz" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding IzzFactor, StringFormat=N3}" Style="{StaticResource FieldInputStyle}"
                                 common:NumericInput.Min="0" common:NumericInput.Max="10"
                                 GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                 TextChanged="TextBox_TextChanged"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- 計算結果: 2 列 × 3 行 -->
            <GroupBox Header="計算結果" Margin="0,0,0,8">
                <Grid Margin="5,3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldRowStyle}">
                        <Label Content="断面積 A (m²)" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding Area, StringFormat=N6, Mode=OneWay}" Style="{StaticResource FieldReadOnlyStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldRowStyle}">
                        <Label Content="ねじりモーメント Ixx (m⁴)" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding TorsionalMoment, StringFormat=E3, Mode=OneWay}" Style="{StaticResource FieldReadOnlyStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldRowStyle}">
                        <Label Content="せん断断面積 Ay (m²)" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding ShearAreaY, StringFormat=N6, Mode=OneWay}" Style="{StaticResource FieldReadOnlyStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldRowStyle}">
                        <Label Content="断面二次モーメント Iyy (m⁴)" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding MomentOfInertiaYY, StringFormat=E3, Mode=OneWay}" Style="{StaticResource FieldReadOnlyStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldRowStyle}">
                        <Label Content="せん断断面積 Az (m²)" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding ShearAreaZ, StringFormat=N6, Mode=OneWay}" Style="{StaticResource FieldReadOnlyStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldRowStyle}">
                        <Label Content="断面二次モーメント Izz (m⁴)" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding MomentOfInertiaZZ, StringFormat=E3, Mode=OneWay}" Style="{StaticResource FieldReadOnlyStyle}"/>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="2" Margin="0,8,0,0">
            <Button Content="適用(_A)" Width="80" Click="ApplyButton_Click" Margin="0,0,5,0"
                    ToolTip="現在の設定を適用して編集を続けます (Alt+A)"/>
            <Button x:Name="OkButton" Content="OK(_O)" Width="80" Click="OkButton_Click" IsDefault="True" Margin="0,0,5,0"
                    ToolTip="現在の設定を適用して閉じます (Enter / Alt+O)"/>
            <Button Content="キャンセル(_C)" Width="100" Click="CancelButton_Click" IsCancel="True"
                    ToolTip="変更を破棄して閉じます (Esc / Alt+C)"/>
        </StackPanel>
    </Grid>
</Window>
