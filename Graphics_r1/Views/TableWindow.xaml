<Window x:Class="PileDesign.Views.TableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:viewmodels="clr-namespace:PileDesign.ViewModels" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:TableWindowViewModel}"
        xmlns:common="clr-namespace:PileDesign.Common"
        xmlns:conv="clr-namespace:PileDesign.Converters"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        Title="解析結果テーブル" Width="1150" Height="680"
        common:EscapeKeyBehavior.Enable="True">
    
    <Window.Resources>
        <ContextMenu x:Key="CommonDataGridContextMenu" Opened="ContextMenu_Opened">
            <MenuItem Click="ExportCsvFromContextMenu_Click">
                <MenuItem.Icon>
                    <svgc:SvgViewbox Source="/Icons/CSVFileOutput.svg" Style="{DynamicResource SvgIconStyle16}"/>
                </MenuItem.Icon>
                <MenuItem.Header>
                    <TextBlock Text="CSVファイル出力"/>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem Header="コピー"
              Command="{Binding PlacementTarget.DataContext.CopyDataGridSelectionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
              CommandParameter="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>

        </ContextMenu>
        <conv:LoadCaseNameToColorConverter x:Key="LoadCaseNameToColorConverter"/>
        <conv:LoadCaseAnalyzedConverter x:Key="LoadCaseAnalyzedConverter"/>
        <conv:LiquefactionAnalyzedConverter x:Key="LiquefactionAnalyzedConverter"/>
    </Window.Resources>
    
    <DockPanel>
        <StackPanel Width="220" Margin="6" DockPanel.Dock="Left">
            <TextBlock Text="テーブル一覧" FontWeight="Bold" Margin="0,0,0,4"/>
            <ListBox ItemsSource="{Binding FilteredTables}"
                     DisplayMemberPath="DisplayName"
                     SelectedItem="{Binding SelectedTable}"
                     SelectionChanged="ListBox_SelectionChanged"
                     Height="280"/>

            <Separator Margin="0,8,0,8"/>

            <TextBlock Text="荷重条件フィルタ" Margin="0,0,0,2"/>
            <ComboBox ItemsSource="{Binding LoadCaseFilterOptions}"
                      SelectedItem="{Binding SelectedLoadCaseFilter}"
                      Margin="0,0,0,6">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="5" Height="5" Fill="#2E7D32" Margin="0,0,3,0" VerticalAlignment="Center">
                                <Ellipse.Visibility>
                                    <MultiBinding Converter="{StaticResource LoadCaseAnalyzedConverter}">
                                        <Binding/>
                                        <Binding Path="DataContext.AnaModel"
                                                 RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    </MultiBinding>
                                </Ellipse.Visibility>
                            </Ellipse>
                            <TextBlock Text="{Binding}">
                                <TextBlock.Foreground>
                                    <MultiBinding Converter="{StaticResource LoadCaseNameToColorConverter}">
                                        <Binding/>
                                        <Binding Path="DataContext.AllSeismicLoadCases"
                                                 RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    </MultiBinding>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Text="荷重組合せフィルタ" Margin="0,0,0,2"/>
            <ComboBox ItemsSource="{Binding LoadCombinationFilterOptions}"
                      SelectedItem="{Binding SelectedLoadCombinationFilter}"
                      Margin="0,0,0,6"/>

            <TextBlock Text="液状化フィルタ" Margin="0,0,0,2"/>
            <ComboBox ItemsSource="{Binding LiquefactionFilterOptions}"
                      SelectedItem="{Binding SelectedLiquefactionFilter}"
                      Margin="0,0,0,12">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="5" Height="5" Fill="#2E7D32" Margin="0,0,3,0" VerticalAlignment="Center">
                                <Ellipse.Visibility>
                                    <MultiBinding Converter="{StaticResource LiquefactionAnalyzedConverter}">
                                        <Binding/>
                                        <Binding Path="DataContext.AnaModel"
                                                 RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    </MultiBinding>
                                </Ellipse.Visibility>
                            </Ellipse>
                            <TextBlock Text="{Binding}"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Button Content="CSV出力"
                    Command="{Binding ExportCsvCommand}"
                    Height="32"/>
        </StackPanel>

        <common:EnhancedDataGrid x:Name="ResultGrid"
                  Margin="6"
                  AutoGenerateColumns="False"
                  ItemsSource="{Binding SelectedTable.Rows}"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  Loaded="ResultGrid_Loaded"
                  CellStyle="{StaticResource CustomDataGridCellStyle}">
            <DataGrid.AlternatingRowBackground>
                <ImageBrush/>
            </DataGrid.AlternatingRowBackground>
            <DataGrid.Style>
                <Style/>
            </DataGrid.Style>

            <!--CSVファイル出力等-->
            <DataGrid.ContextMenu>
                <StaticResource ResourceKey="CommonDataGridContextMenu"/>
            </DataGrid.ContextMenu>

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="Foreground" Value="#62B0E2" />
                </Style>
            </DataGrid.ColumnHeaderStyle>
        </common:EnhancedDataGrid>
    </DockPanel>
</Window>