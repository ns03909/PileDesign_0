<Window x:Class="PileDesign.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:common="clr-namespace:PileDesign.Common"
        mc:Ignorable="d"
        Title="解析ログ" Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        DataContextChanged="OnDataContextChanged"
        common:EscapeKeyBehavior.Enable="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ToolBar Grid.Row="0" Padding="5">
            <Button Content="コピー (Ctrl+C)" Command="{Binding CopyLogCommand}" Padding="10,2"/>
            <Separator/>
            <Button Content="ファイル出力" Command="{Binding ExportLogCommand}" Padding="10,2"/>
            <Separator/>
            <Button Content="クリア" Command="{Binding ClearLogCommand}" Padding="10,2"/>
            <Separator/>
            <CheckBox Content="自動スクロール" IsChecked="{Binding AutoScroll}" VerticalAlignment="Center" Margin="5,0"/>
        </ToolBar>

        <!-- Log Content -->
        <ScrollViewer Grid.Row="1" x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
            <TextBox Text="{Binding LogText, Mode=OneWay}"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     FontFamily="Consolas"
                     FontSize="12"
                     Background="#F5F5F5"
                     Foreground="#333333"
                     Padding="10"
                     BorderThickness="0"/>
        </ScrollViewer>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
