                                                                    <StackPanel>
                                                                        <TextBlock Text="地盤"
                                                                            TextAlignment="Center"/>
                                                                        <TextBlock Text="番号"
                                                                            TextAlignment="Center"
                                                                            HorizontalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </DataGridTextColumn.Header>
                                                            </DataGridTextColumn>

                                                            <DataGridTextColumn Width="*" Binding="{Binding PileBodyNo}"
                                                                    ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50"
                                                                    IsReadOnly=" true" Foreground="Gray">
                                                                <DataGridTextColumn.Header>
                                                                    <StackPanel>
                                                                        <TextBlock Text="杭体"
                                                                    TextAlignment="Center"/>
                                                                        <TextBlock Text="番号"
                                                                    TextAlignment="Center"
                                                                    HorizontalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </DataGridTextColumn.Header>
                                                            </DataGridTextColumn>

                                                            <DataGridTextColumn Width="*" Binding="{Binding Z, StringFormat=N3}"
                                                                    ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50"
                                                                    IsReadOnly=" true" Foreground="Gray">
                                                                <DataGridTextColumn.Header>
                                                                    <StackPanel>
                                                                        <TextBlock Text="杭頭"
                                                                            TextAlignment="Center"/>
                                                                        <TextBlock Text="Z"
                                                                            TextAlignment="Center"/>
                                                                        <TextBlock Text="(m)"
                                                                            TextAlignment="Center"
                                                                            HorizontalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </DataGridTextColumn.Header>
                                                            </DataGridTextColumn>

                                                            <DataGridTextColumn Width="*" Binding="{Binding PileBottomAltitude, StringFormat=N3}"
                                                                    ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50"
                                                                    IsReadOnly=" true" Foreground="Gray">
                                                                <DataGridTextColumn.Header>
                                                                    <StackPanel>
                                                                        <TextBlock Text="杭先端"
                                                                            TextAlignment="Center"/>
                                                                        <TextBlock Text="Z"
