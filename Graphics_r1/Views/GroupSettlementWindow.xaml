                                            </Grid>
                                        </TabItem>


                                        <!-- 解析: 荷重条件の荷重で、基礎梁を考慮しない / する解析を選んで実行する。
                                             以前の「一般 / 反復」は計算方法の名前で、利用者が選んでいるもの (基礎梁を考えるか) が読み取れなかった -->
                                        <TabItem Header="解析" x:Name="TabItemLoadBeamAware"
                                                 ToolTip="基礎梁を考慮しない解析 / 考慮する解析を選んで実行します。どちらも荷重条件タブの荷重を使います。">
                                            <StackPanel Margin="8">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <RadioButton Content="基礎梁なし" GroupName="GroupSettlementBeam" Margin="0,0,16,0"
                                                                 IsChecked="{Binding IsGroupSettlementWithBeamSelected, Mode=TwoWay, Converter={StaticResource BoolEqualsConverter}, ConverterParameter=False}"/>
                                                    <RadioButton Content="基礎梁あり" GroupName="GroupSettlementBeam"
                                                                 IsChecked="{Binding IsGroupSettlementWithBeamSelected, Mode=TwoWay, Converter={StaticResource BoolEqualsConverter}, ConverterParameter=True}"/>
                                                </StackPanel>

                                                <!-- 基礎梁なし -->
                                                <StackPanel Visibility="{Binding IsGroupSettlementWithBeamSelected, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                                               Text="基礎梁を考慮せず、荷重条件の矩形荷重から各杭の位置とグリッドの沈下をスタインブレナー法で 1 回計算します。"/>
                                                <!-- 基礎梁なしの解析の実行 (リボンの「群杭沈下 解析（基礎梁なし）」と同じ) -->
                                                <Button Width="240" HorizontalAlignment="Left" Margin="0,8,0,0"
                                                        Command="{Binding PileGroupSettlementAnalysisCommand}"
                                                        ToolTipService.ShowOnDisabled="True"
                                                        ToolTip="{Binding GroupSettlementAnalysisToolTip}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <svgc:SvgViewbox Source="/Icons/GroupPileSettlement.svg"
                                                                         Style="{StaticResource SvgIconStyle24}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="基礎梁なしで解析" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                </StackPanel>

                                                <!-- 基礎梁あり: 反復の条件と注意はこちらだけに出す -->
                                                <StackPanel Visibility="{Binding IsGroupSettlementWithBeamSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <!-- 重要: 適用範囲の注記 -->
                                                <Border Margin="0,0,0,8" Padding="8,6"
                                                        Background="#FFFFF4D6" BorderBrush="#FFE3B341" BorderThickness="1"
                                                        CornerRadius="2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="⚠" FontSize="14" Foreground="#FFC97A00"
                                                                   VerticalAlignment="Top" Margin="0,0,6,0"/>
                                                        <TextBlock TextWrapping="Wrap" Foreground="#FF6B4A00">
                                                            <Run FontWeight="Bold" Text="基礎梁ありの解析"/>
                                                            <Run Text="は、基礎指針'19 図5.3.2 連続梁・格子梁モデルによる沈下量の算定例の方法です。"/>
                                                            <LineBreak/>
                                                            <Run Text="杭基礎の計算では使いません。"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                                               Text="基礎梁を考慮し、荷重条件の矩形荷重 (杭ごとの矩形) を初期値に、杭の荷重を基礎梁で再配分しながら反復で沈下を求めます (反復スタインブレナー法)。&#x0A;収束した荷重・杭の反力・梁の断面力は解析結果として保存し、荷重条件の値は変えません。&#x0A;矩形荷重が杭ごとになっていないときは、荷重条件タブの「杭ごとの矩形を作り直す」で作ってください。"/>
                                                <!-- 基礎梁が無い場合の注意書き -->
                                                <TextBlock Margin="0,4" Foreground="{StaticResource ErrorBrush}"
                                                           Text="※ 基礎梁が定義されていません。梁要素タブで基礎梁を追加してから実行してください。">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CurrentInputModel.FoundationBeamInput.Beams.Count}" Value="0">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <!-- 保存中の解析結果の有無 -->
                                                <TextBlock Margin="0,8,0,0"
                                                           Visibility="{Binding HasGroupSettlementBeamAwareCases, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                           Foreground="{StaticResource PrimaryAccentDarkBrush}"
                                                           Text="✓ 基礎梁考慮の解析結果が保存されています (詳細は 解析結果 → 沈下量タブ → 結果タイプ で確認)。"/>
                                                <!-- 基礎梁ありの解析の実行 (リボンの「群杭沈下 解析（基礎梁あり）」と同じ) -->
                                                <Button Width="240" HorizontalAlignment="Left" Margin="0,8,0,0"
                                                        Command="{Binding OpenGroupSettlementWithBeamWindowCommand}"
                                                        ToolTip="基礎梁の剛性を考慮した反復スタインブレナー解析を実行します。" AutomationProperties.Name="基礎梁の剛性を考慮した反復スタインブレナー解析を実行します。">
                                                    <StackPanel Orientation="Horizontal">
                                                        <svgc:SvgViewbox Source="/Icons/GroupPileSettlementWithBeamWindow.svg"
                                                                         Style="{StaticResource SvgIconStyle24}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="基礎梁ありの解析設定へ…" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </TabItem>


                                    </TabControl>

                                    <!-- 旧: 群杭沈下解析実行ボタン (タブ全体下) は撤去。
                                         一回解析タブの下部 / 反復解析タブの下部 にそれぞれ専用ボタンを配置。 -->
                                </Grid>
</Window>
