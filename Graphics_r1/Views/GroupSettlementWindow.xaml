<Window x:Class="PileDesign.Views.GroupSettlementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:PileDesign.Converters"
        xmlns:common="clr-namespace:PileDesign.Common"
        xmlns:models="clr-namespace:PileDesign.Models.InputData"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        Title="群杭沈下" Height="700" Width="1000"
        MinHeight="440" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        common:EscapeKeyBehavior.Enable="True">
    <!--
        群杭沈下の入力。もとはメイン画面の左ペイン (データタブ) の 1 タブだったが、
        他の解析条件 (基本設定・荷重・地盤・杭体) がすべて独立したウィンドウなのに
        ここだけタブという不揃いを直すため、ウィンドウに移した (2026-09-06)。
        中身は移したときのまま。DataContext は MainWindowViewModel で、
        束縛先は移動前と同じ。
    -->
    <Window.Resources>
        <conv:VisibilityConverter x:Key="VisibilityConverter"/>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <DataTemplate x:Key="LoadingTypeItemTemplate">
            <StackPanel Orientation="Horizontal">
                <svgc:SvgViewbox Width="24" Height="24" Stretch="Uniform">
                    <svgc:SvgViewbox.Style>
                        <Style TargetType="svgc:SvgViewbox">
                            <!-- 既定アイコン（該当なし時） -->
                            <Setter Property="Source" Value="/Icons/NoPressure.svg"/>
                            <!-- 項目文字列で切替 -->
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="任意矩形">
                                    <Setter Property="Source" Value="/Icons/AnyFormPressure.svg"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding}" Value="個別矩形">
                                    <Setter Property="Source" Value="/Icons/SquareFormPressure.svg"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding}" Value="個別矩形（基礎梁考慮）">
                                    <Setter Property="Source" Value="/Icons/BeamedSquareFormPressure.svg"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding}" Value="個別十字">
                                    <Setter Property="Source" Value="/Icons/CrossFormPressure.svg"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding}" Value="個別十字（基礎梁反力）">
                                    <Setter Property="Source" Value="/Icons/BeamedCrossFormPressure.svg"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </svgc:SvgViewbox.Style>
                </svgc:SvgViewbox>
                <TextBlock Text="{Binding}" Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
    <ContextMenu x:Key="CommonDataGridContextMenu" Opened="ContextMenu_Opened">
        <MenuItem Click="ExportCsvFromContextMenu_Click">
            <MenuItem.Icon>
                <svgc:SvgViewbox Source="/Icons/CSVFileOutput.svg" Style="{DynamicResource SvgIconStyle16}"/>
            </MenuItem.Icon>
            <MenuItem.Header>
                <TextBlock Text="CSVファイル出力"/>
            </MenuItem.Header>
        </MenuItem>
        <MenuItem Header="コピー" Command="{Binding CopyDataGridSelectionCommand}"
                  CommandParameter="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
    </ContextMenu>
    </Window.Resources>


                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 共通の 荷重面 Z / 標高 行は撤去。代わりに 一回解析 / 反復解析 各タブ内で個別に編集する。 -->

                                    <TabControl x:Name="GroupPileTabControl" Grid.Row="1" SelectionChanged="GroupPileTabControl_SelectionChanged">

                                        <TabItem Header="土層" x:Name="TabItemSettlementSoilLayers">
                                            <Grid>
                                                <StackPanel Grid.Row=" 2">
                                                    <GroupBox Header="土層上端 (ボーリング孔口レベル)" Margin="0,0,0,4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="土層上端 Z (m)" Grid.Column="0" VerticalAlignment="Center" Margin="0,2,4,2"/>
                                                            <TextBox Text="{Binding CurrentInputModel.PileGroupSettlement.SoilLayersTopAltitude,
                                                                            StringFormat={}{0:+0.00;-0.00;+0.00}, UpdateSourceTrigger=LostFocus}"
                                                                     Grid.Column="1" Width="150" HorizontalContentAlignment="Right" Margin="0,2"
                                                                     GotFocus="TextBox_GotFocus"
                                                                     PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                                     KeyDown="TextBox_KeyDown"/>
                                                            <TextBlock Text="標高 (m)" Grid.Column="2" VerticalAlignment="Center" Margin="8,2,4,2"/>
                                                            <TextBox Grid.Column="3" IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}"
                                                                     Width="150" HorizontalContentAlignment="Right" Margin="0,2">
                                                                <TextBox.Text>
                                                                    <MultiBinding StringFormat="{}{0:+0.00;-0.00;+0.00}" Mode="OneWay">
                                                                        <Binding Path="CurrentInputModel.PileGroupSettlement.SoilLayersTopAltitude"/>
                                                                        <Binding Path="CurrentInputModel.FundamentalInput.ReferenceAltitude"/>
                                                                        <MultiBinding.Converter>
                                                                            <conv:SumConverter/>
                                                                        </MultiBinding.Converter>
                                                                    </MultiBinding>
                                                                </TextBox.Text>
                                                            </TextBox>
                                                        </Grid>
                                                    </GroupBox>

                                                    <GroupBox Header="登録済み土層のコピー">
                                                        <GroupBox.ToolTip>
                                                            <StackPanel>
                                                                <TextBlock Text="登録済みの土層の各下端Z、変形係数、ポアソン比をコピーします。"/>
                                                                <TextBlock Text="ポアソン比は以下の仮値とします。"/>
                                                                <TextBlock Text="　粘性土：0.4"/>
                                                                <TextBlock Text="　砂質土：0.3"/>
                                                                <TextBlock Text="　礫質土：0.3"/>
                                                                <TextBlock Text="沈下計算用の変形係数、ポアソン比の設定には基礎指針p146～149等を参照して入力してください。"/>
                                                            </StackPanel>
                                                            
                                                        </GroupBox.ToolTip>
                                                        
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="*"/>
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Text="地盤番号:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                                            <ComboBox ItemsSource="{Binding CurrentInputModel.GroundsInputCountList}"
                                                                  SelectedItem="{Binding SelectedGroundInputModelNo}"
                                                                  Width="60" Margin="4,0,8,0"
                                                                  Grid.Row="0" Grid.Column="1"/>
                                                            <Button Padding="0"  Grid.Row="0" Grid.Column="2" HorizontalAlignment="Left"
                                                                Style="{StaticResource LargeIconToolTipButtonStyle}"
                                                                Tag="コピー実行"
                                                                Command="{Binding GroundInputCopyToSettlementGroundLayersCommand}">
                                                                <svgc:SvgViewbox Source="/Icons/CopySoilLayer.svg" Style="{StaticResource SvgIconStyle24}"/>
                                                            </Button>

                                                        </Grid>
                                                    </GroupBox>

                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Padding="0"
                                                                Style="{StaticResource LargeIconToolTipButtonStyle}"
                                                                Tag="土層追加"
                                                                Command="{Binding AddSettlementSoilLayerCommand}">
                                                            <svgc:SvgViewbox Source="/Icons/AddSettlementSoilLayer.svg" Style="{StaticResource SvgIconStyle24}"/>
                                                        </Button>

                                                        <Button Padding="0"
                                                                Style="{StaticResource LargeIconToolTipButtonStyle}"
                                                                Tag="全土層削除"
                                                               Command="{Binding DeleteAllSettlementSoilLayersCommand}">
                                                            <svgc:SvgViewbox Source="/Icons/DeleteAllSettlementSoilLayers.svg" Style="{StaticResource SvgIconStyle24}"/>
                                                        </Button>
                                                    </StackPanel>


                                                    <common:EnhancedDataGrid ItemsSource="{Binding CurrentInputModel.PileGroupSettlement.SettlementSoilLayers, Mode=TwoWay,
                                                            UpdateSourceTrigger=LostFocus}"
                                                            HorizontalAlignment="Stretch"
                                                            AutoGenerateColumns="False"
                                                            CanUserAddRows="False"
                                                            CanUserSortColumns="True"
                                                            VerticalScrollBarVisibility="Auto"
                                                            HorizontalScrollBarVisibility="Auto"
                                                            LoadingRow="DataGrid_LoadingRow_Numbering"
                                                            CellEditEnding="DataGridSettlementSoilLayers_CellEditEnding"
                                                            BeginningEdit="DataGridGrid_BeginningEdit"
                                                            EnableRowVirtualization="True"
                                                            EnableColumnVirtualization="False"
                                                            VirtualizingPanel.IsVirtualizing="True"
                                                            VirtualizingPanel.VirtualizationMode="Recycling"
                                                            ScrollViewer.CanContentScroll="True"
                                                            CellStyle="{StaticResource CustomDataGridCellStyle}">

                                                        <DataGrid.AlternatingRowBackground>
                                                            <ImageBrush/>
                                                        </DataGrid.AlternatingRowBackground>
                                                        <DataGrid.Style>
                                                            <Style/>
                                                        </DataGrid.Style>

                                                        <!--CSVファイル出力-->
                                                        <DataGrid.ContextMenu>
                                                            <StaticResource ResourceKey="CommonDataGridContextMenu"/>
                                                        </DataGrid.ContextMenu>

                                                        <DataGrid.ColumnHeaderStyle>
                                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                                <Setter Property="Foreground" Value="{StaticResource PrimaryAccentBrush}" />
                                                            </Style>
                                                        </DataGrid.ColumnHeaderStyle>

                                                        <DataGrid.Columns>

                                                            <DataGridTemplateColumn Width="Auto" Header="削除" MinWidth="40">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <Button
                                                                            x:Name="ButtonRectLoadDelete"
                                                                            Content="削除"
                                                                            Padding="2,0"
                                                                            Tag="{Binding}"
                                                                            Command="{Binding DataContext.DeleteSettlementSoilLayerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}" />
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                            </DataGridTemplateColumn>

                                                            <DataGridTextColumn Binding="{Binding BottomAltitude, StringFormat={}{0:+0.00;-0.00;+0.00}, Mode=TwoWay,
                                                                    UpdateSourceTrigger=LostFocus}"
                                                                    Width="*"  ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="40" >
                                                                <DataGridTextColumn.Header>
                                                                    <StackPanel>
                                                                        <TextBlock Text="下端"   TextAlignment="Center" HorizontalAlignment="Center"/>
                                                                        <TextBlock Text="Z"  TextAlignment="Center" HorizontalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </DataGridTextColumn.Header>
                                                            </DataGridTextColumn>

                                                            <DataGridTemplateColumn Width="*" MinWidth="40" IsReadOnly="True">
                                                                <DataGridTemplateColumn.Header>
                                                                    <StackPanel>
                                                                        <TextBlock Text="下端" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                                        <TextBlock Text="標高" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </DataGridTemplateColumn.Header>
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock HorizontalAlignment="Right" Foreground="Gray">
                                                                            <TextBlock.Text>
                                                                                <MultiBinding StringFormat="{}{0:+0.00;-0.00;+0.00}" Mode="OneWay">
                                                                                    <Binding Path="BottomAltitude"/>
                                                                                    <Binding Path="DataContext.CurrentInputModel.FundamentalInput.ReferenceAltitude"
                                                                                             RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                                    <MultiBinding.Converter>
                                                                                        <conv:SumConverter/>
                                                                                    </MultiBinding.Converter>
                                                                                </MultiBinding>
                                                                            </TextBlock.Text>
                                                                        </TextBlock>
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                            </DataGridTemplateColumn>

                                                            <DataGridTextColumn Binding="{Binding Thickness, StringFormat=N3,
                                                                    UpdateSourceTrigger=LostFocus}"
                                                                    Width="*"
                                                                    ElementStyle="{StaticResource RightAlignedTextBlockStyle}"
                                                                    MinWidth="40"
                                                                    IsReadOnly="true"
                                                                    Foreground="Gray">
                                                                <DataGridTextColumn.Header>
                                                                    <StackPanel>
                                                                        <TextBlock Text="厚さ"   TextAlignment="Center" HorizontalAlignment="Center"/>
                                                                        <TextBlock Text="(m)"  TextAlignment="Center" HorizontalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </DataGridTextColumn.Header>
                                                            </DataGridTextColumn>

                                                            <DataGridTextColumn Binding="{Binding Ek, StringFormat=N0, Mode=TwoWay,
                                                                    UpdateSourceTrigger=LostFocus}"
                                                                    Width="*"  ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="60" >
                                                                <DataGridTextColumn.Header>
                                                                    <StackPanel>
                                                                        <TextBlock Text="変形係数"   TextAlignment="Center" HorizontalAlignment="Center"/>
                                                                        <TextBlock Text="Esk" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                                        <TextBlock TextAlignment="Center" HorizontalAlignment="Center"><Run Text="(kN/m"/><Run Text="2" BaselineAlignment="Superscript" FontSize="9"/><Run Text=")"/></TextBlock>
                                                                    </StackPanel>
                                                                </DataGridTextColumn.Header>
                                                            </DataGridTextColumn>

                                                            <DataGridTemplateColumn Width="*" MinWidth="80">
                                                                <DataGridTemplateColumn.Header>
                                                                    <StackPanel ToolTip="土層分類 (粘性土 / 砂質土 / 礫質土)。メイン画面の塗りつぶし色を決める。">
                                                                        <TextBlock Text="分類" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </DataGridTemplateColumn.Header>
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <ComboBox SelectedItem="{Binding GranularityClass, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                                                  ItemsSource="{Binding Source={x:Static models:GroundLayerInput.GranularityClassOption}}"
                                                                                  Style="{StaticResource GranularityClassComboBoxStyle}"
                                                                                  BorderThickness="0" Background="Transparent"
                                                                                  HorizontalContentAlignment="Center" VerticalAlignment="Center"
                                                                                  Padding="0"/>
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                            </DataGridTemplateColumn>

                                                            <DataGridTextColumn Binding="{Binding PoissonsRatio, StringFormat=N2, Mode=TwoWay,
                                                                    UpdateSourceTrigger=LostFocus}"
                                                                    Width="*"  ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="40" >
                                                                <DataGridTextColumn.Header>
                                                                    <StackPanel>
                                                                        <TextBlock Text="ポアソン" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                                        <TextBlock Text="比" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </DataGridTextColumn.Header>
                                                            </DataGridTextColumn>

                                                            <DataGridTextColumn Binding="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                    Width="2*" MinWidth="100"
                                                                    ElementStyle="{StaticResource CenterAlignedTextBlockStyle}">
                                                                <DataGridTextColumn.Header>
                                                                    <StackPanel>
                                                                        <TextBlock Text="備考" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </DataGridTextColumn.Header>
                                                            </DataGridTextColumn>
                                                        </DataGrid.Columns>
                                                    </common:EnhancedDataGrid>
                                                </StackPanel>
                                            </Grid>
                                        </TabItem>

                                        <TabItem Header="グリッド" x:Name="TabItemSettlementGrid" ToolTip = "各交差点において沈下計算を行うグリッドを定義します。">
                                            <StackPanel Margin="4">
                                                <!-- 杭配置範囲（読み取り専用） -->
                                                <GroupBox Header="杭配置範囲" Margin="0,0,0,4">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Text="Xmin(m)" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,2,4,2"/>
                                                        <TextBox Text="{Binding GroupPileSettlementXMin, Mode=OneWay, StringFormat=N3}"
                                                                 Grid.Row="0" Grid.Column="1" IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}" Width="150" HorizontalContentAlignment="Right" Margin="0,2"/>
                                                        <TextBlock Text="Xmax(m)" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="8,2,4,2"/>
                                                        <TextBox Text="{Binding GroupPileSettlementXMax, Mode=OneWay, StringFormat=N3}"
                                                                 Grid.Row="0" Grid.Column="3" IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}" Width="150" HorizontalContentAlignment="Right" Margin="0,2"/>

                                                        <TextBlock Text="Ymin(m)" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,2,4,2"/>
                                                        <TextBox Text="{Binding GroupPileSettlementYMin, Mode=OneWay, StringFormat=N3}"
                                                                 Grid.Row="1" Grid.Column="1" IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}" Width="150" HorizontalContentAlignment="Right" Margin="0,2"/>
                                                        <TextBlock Text="Ymax(m)" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="8,2,4,2"/>
                                                        <TextBox Text="{Binding GroupPileSettlementYMax, Mode=OneWay, StringFormat=N3}"
                                                                 Grid.Row="1" Grid.Column="3" IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}" Width="150" HorizontalContentAlignment="Right" Margin="0,2"/>
                                                    </Grid>
                                                </GroupBox>

                                                <!-- グリッド間隔 -->
                                                <GroupBox Header="グリッド間隔" Margin="0,0,0,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Text="X間隔(m)" Grid.Column="0" VerticalAlignment="Center" Margin="0,2,4,2"/>
                                                        <TextBox Text="{Binding GroupPileSettlementXSpacing, StringFormat=N3}"
                                                                 Grid.Column="1" Width="150" HorizontalContentAlignment="Right" Margin="0,2"
                                                                 PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"/>
                                                        <TextBlock Text="Y間隔(m)" Grid.Column="2" VerticalAlignment="Center" Margin="8,2,4,2"/>
                                                        <TextBox Text="{Binding GroupPileSettlementYSpacing, StringFormat=N3}"
                                                                 Grid.Column="3" Width="150" HorizontalContentAlignment="Right" Margin="0,2"
                                                                 PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"/>
                                                    </Grid>
                                                </GroupBox>

                                                <!-- グリッドオフセット -->
                                                <GroupBox Header="グリッドオフセット">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Text="Xオフセット(m)" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,2,4,2"/>
                                                        <TextBox Text="{Binding GroupPileSettlementXOffset, StringFormat=N3}"
                                                                 Grid.Row="0" Grid.Column="1" Width="150" HorizontalContentAlignment="Right" Margin="0,2"
                                                                 PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"/>
                                                        <Slider Value="{Binding GroupPileSettlementXOffset}"
                                                                Grid.Row="0" Grid.Column="2" Margin="4,2" Width="320" HorizontalAlignment="Left"
                                                                Minimum="0" Maximum="20" TickFrequency="2" IsSnapToTickEnabled="True"/>

                                                        <TextBlock Text="Yオフセット(m)" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,2,4,2"/>
                                                        <TextBox Text="{Binding GroupPileSettlementYOffset, StringFormat=N3}"
                                                                 Grid.Row="1" Grid.Column="1" Width="150" HorizontalContentAlignment="Right" Margin="0,2"
                                                                 PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"/>
                                                        <Slider Value="{Binding GroupPileSettlementYOffset}"
                                                                Grid.Row="1" Grid.Column="2" Margin="4,2" Width="320" HorizontalAlignment="Left"
                                                                Minimum="0" Maximum="20" TickFrequency="2" IsSnapToTickEnabled="True"/>
                                                    </Grid>
                                                </GroupBox>
                                            </StackPanel>
                                        </TabItem>

                                        <TabItem Header="解析（一般）" x:Name="TabItemLoadNonBeam"
                                                 ToolTip="基礎梁を考慮しない単発スタインブレナー解析。任意矩形 / 個別矩形 / 個別十字 などの荷重定義で 1 回計算。">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1*" />
                                                </Grid.ColumnDefinitions>

                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>


                                                <Grid Grid.Row="0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 一回解析 用の荷重面標高 -->
                                                    <TextBlock Text="荷重面 Z (m)" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,2,4,2"/>
                                                    <TextBox Text="{Binding LoadingPlaneAltitudeNonBeamProxy, StringFormat={}{0:+0.00;-0.00;+0.00}, UpdateSourceTrigger=LostFocus}"
                                                             Grid.Row="0" Grid.Column="1"
                                                             Width="150" HorizontalContentAlignment="Right" Margin="0,2"
                                                             GotFocus="TextBox_GotFocus"
                                                             PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                             KeyDown="TextBox_KeyDown">
                                                        <TextBox.ToolTip>
                                                            <TextBlock>
                                                                <Run Text="一回解析 (基礎梁無し) で使用される荷重面標高。"/>
                                                                <LineBreak/>
                                                                <Run Text="杭周面抵抗に対する荷重面の例：杭先端から(1/3)Lの高さ"/>
                                                                <LineBreak/>
                                                                <Run Text="杭先端荷重に対する荷重面の例：杭先端"/>
                                                                <LineBreak/>
                                                                <Run Text="(基礎指針'19 図6.3.11 p230)"/>
                                                            </TextBlock>
                                                        </TextBox.ToolTip>
                                                    </TextBox>
                                                    <TextBlock Text="標高 (m)" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="8,2,4,2"/>
                                                    <TextBox Grid.Row="0" Grid.Column="3" IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}"
                                                             Width="150" HorizontalContentAlignment="Right" Margin="0,2">
                                                        <TextBox.Text>
                                                            <MultiBinding StringFormat="{}{0:+0.00;-0.00;+0.00}" Mode="OneWay">
                                                                <Binding Path="CurrentInputModel.PileGroupSettlement.LoadingPlaneAltitudeNonBeam"/>
                                                                <Binding Path="CurrentInputModel.FundamentalInput.ReferenceAltitude"/>
                                                                <MultiBinding.Converter>
                                                                    <conv:SumConverter/>
                                                                </MultiBinding.Converter>
                                                            </MultiBinding>
                                                        </TextBox.Text>
                                                    </TextBox>

                                                    <TextBlock Text="荷重タイプ" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,2,4,2"/>

                                                    <ComboBox x:Name="ComboBoxLoadingType"
                                                          Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                                          ItemsSource="{Binding AvailableLoadingTypeOptionsNonBeam}"
                                                          SelectedItem="{Binding CurrentInputModel.PileGroupSettlement.LoadingType, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                          ItemTemplate="{StaticResource LoadingTypeItemTemplate}"
                                                          MinWidth="200" HorizontalAlignment="Left" Margin="0,2"

                                                          SelectionChanged="ComboBoxLoadingType_SelectionChanged">
                                                        <ComboBox.ToolTip>
                                                            <Grid>
                                                                <Grid.RowDefinitions>
