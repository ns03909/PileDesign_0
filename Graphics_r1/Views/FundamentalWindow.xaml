<Window x:Class="PileDesign.Views.FundamentalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PileDesign.ViewModels"
        xmlns:common="clr-namespace:PileDesign.Common"
        xmlns:conv="clr-namespace:PileDesign.Converters"
        xmlns:ctrl="clr-namespace:PileDesign.Views.Controls"
        d:DataContext="{d:DesignInstance Type=local:FundamentalViewModel}"
        mc:Ignorable="d"
        Title="基本設定" Height="700" Width="560"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <conv:BoolEqualsConverter x:Key="BoolEqualsConverter"/>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <!-- 追加: Ctrl+Enter で OkCommand を実行 -->
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding OkCommand}" />
        <!-- 追加: Esc で CancelCommand を実行 -->
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Grid Margin="20,20,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="性能グレード" HorizontalAlignment="Left" Grid.Column="0"/>
                <ComboBox ItemsSource="{Binding SeismicGradeOptions}" SelectedItem="{Binding SeismicGrade}"
                          Grid.Column="1"
                          SelectionChanged="ComboBoxSeismicGrade_SelectionChanged"
                          Margin="0,0,0,10"/>
                <!--<ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate> "-->
            </Grid>

            <GroupBox Header="杭頭の安全限界回転角" Margin="0,0,0,10" Padding="6">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                               Text="杭頭固定の場合、場所打ち鉄筋コンクリート杭に限り安全限界回転角 θu を照査します（既定 1/100 = 0.01 rad）。他の杭種にこの規定はありません。杭頭半固定は工法ごとの閾値によります。"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="安全限界回転角 θu (rad)" Grid.Column="0" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding InsituRcUltimateRotationAngleLimit, StringFormat={}{0:0.#####}, UpdateSourceTrigger=LostFocus}"
                                 Grid.Column="1" Margin="0,0,0,4"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="沈下検討の対象" Margin="0,0,0,10" Padding="6">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                               Text="沈下量の検討をどちらで行うかを決めます。杭頭 2 点間の変形角（沈下）の検定も、ここで選んだ沈下量の差で求めます。群杭沈下解析を実行していないときは群杭分が 0 なので、どちらを選んでも単杭沈下と同じになります。"/>
                    <!-- 正負 2 つの TwoWay ライターはウィンドウ再表示時に StackOverflow を起こすため、
                         「チェック時のみ書く」BoolEqualsConverter に統一する -->
                    <RadioButton Content="単杭沈下" GroupName="SettlementDesignBasis" Margin="0,2,0,0"
                                 IsChecked="{Binding SettlementDesignIncludesGroup, Mode=TwoWay, Converter={StaticResource BoolEqualsConverter}, ConverterParameter=False}"/>
                    <RadioButton Content="単杭＋群杭沈下" GroupName="SettlementDesignBasis" Margin="0,2,0,0"
                                 IsChecked="{Binding SettlementDesignIncludesGroup, Mode=TwoWay, Converter={StaticResource BoolEqualsConverter}, ConverterParameter=True}"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="杭頭 2 点間の変形角の限界値" Margin="0,0,0,10" Padding="6">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                               Text="すべての杭頭の組について「鉛直変位の差 ÷ 2 点間の水平距離」を求め、その最大値を下の値と比べます。長期は使用限界、レベル1 は損傷限界、レベル2 は終局限界（性能グレードS ではレベル2 も損傷限界）で照査します。"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="使用限界変形角 (rad)" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding ServiceDeformationAngleLimit, StringFormat={}{0:0.#####}, UpdateSourceTrigger=LostFocus}"
                                 Grid.Row="0" Grid.Column="1" Margin="0,0,0,4"/>

                        <TextBlock Text="損傷限界変形角 (rad)" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding DamageDeformationAngleLimit, StringFormat={}{0:0.#####}, UpdateSourceTrigger=LostFocus}"
                                 Grid.Row="1" Grid.Column="1" Margin="0,0,0,4"/>

                        <TextBlock Text="終局限界変形角 (rad)" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding UltimateDeformationAngleLimit, StringFormat={}{0:0.#####}, UpdateSourceTrigger=LostFocus}"
                                 Grid.Row="2" Grid.Column="1" Margin="0,0,0,4"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <ToggleButton x:Name="ButtonShowDeformationAngleGuide" Padding="6,2" FontSize="11"
                                      Background="Transparent" BorderThickness="0" Foreground="#666"
                                      ToolTip="基礎指針'19 表5.3.8 の設計用限界値の目安を表示" AutomationProperties.Name="基礎指針'19 表5.3.8 の設計用限界値の目安を表示">
                            <TextBlock><Run Text="設計用限界値の目安 (基礎指針'19 表5.3.8)"/><Run Text=" ▾"/></TextBlock>
                        </ToggleButton>
                        <Popup PlacementTarget="{Binding ElementName=ButtonShowDeformationAngleGuide}" Placement="Bottom"
                               IsOpen="{Binding IsChecked, ElementName=ButtonShowDeformationAngleGuide, Mode=TwoWay}"
                               StaysOpen="False" AllowsTransparency="True">
                            <Border Background="White" BorderBrush="#888" BorderThickness="1" Padding="14" SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.25"/>
                                </Border.Effect>
                                <StackPanel MinWidth="520">
                                    <TextBlock Text="基礎指針'19 表5.3.8 沈下の設計用限界値の目安" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Grid.Column="0" Padding="10,4" Background="{StaticResource SurfaceMutedBrush}" BorderBrush="#CCC" BorderThickness="1,1,0,1"><TextBlock Text="想定荷重" FontWeight="Bold"/></Border>
                                        <Border Grid.Row="0" Grid.Column="1" Padding="10,4" Background="{StaticResource SurfaceMutedBrush}" BorderBrush="#CCC" BorderThickness="1,1,0,1"><TextBlock Text="性能グレード" FontWeight="Bold"/></Border>
                                        <Border Grid.Row="0" Grid.Column="2" Padding="10,4" Background="{StaticResource SurfaceMutedBrush}" BorderBrush="#CCC" BorderThickness="1,1,0,1"><TextBlock Text="要求性能のレベル" FontWeight="Bold"/></Border>
                                        <Border Grid.Row="0" Grid.Column="3" Padding="10,4" Background="{StaticResource SurfaceMutedBrush}" BorderBrush="#CCC" BorderThickness="1"><TextBlock Text="変形角の設計用限界値の目安" FontWeight="Bold"/></Border>

                                        <Border Grid.Row="1" Grid.Column="0" Padding="10,4" BorderBrush="#CCC" BorderThickness="1,0,0,1"><TextBlock Text="常時荷重"/></Border>
                                        <Border Grid.Row="1" Grid.Column="1" Padding="10,4" BorderBrush="#CCC" BorderThickness="1,0,0,1"><TextBlock Text="—" HorizontalAlignment="Center"/></Border>
                                        <Border Grid.Row="1" Grid.Column="2" Padding="10,4" BorderBrush="#CCC" BorderThickness="1,0,0,1"><TextBlock Text="使用限界状態"/></Border>
                                        <Border Grid.Row="1" Grid.Column="3" Padding="10,4" BorderBrush="#CCC" BorderThickness="1,0,1,1"><TextBlock Text="即時沈下: 1×10⁻³ rad"/></Border>

                                        <Border Grid.Row="2" Grid.Column="0" Padding="10,4" BorderBrush="#CCC" BorderThickness="1,0,0,1"><TextBlock Text="常時荷重"/></Border>
                                        <Border Grid.Row="2" Grid.Column="1" Padding="10,4" BorderBrush="#CCC" BorderThickness="1,0,0,1"><TextBlock Text="—" HorizontalAlignment="Center"/></Border>
                                        <Border Grid.Row="2" Grid.Column="2" Padding="10,4" BorderBrush="#CCC" BorderThickness="1,0,0,1"><TextBlock Text="使用限界状態"/></Border>
                                        <Border Grid.Row="2" Grid.Column="3" Padding="10,4" BorderBrush="#CCC" BorderThickness="1,0,1,1"><TextBlock Text="圧密沈下: 2×10⁻³ rad"/></Border>

                                        <Border Grid.Row="3" Grid.Column="0" Padding="10,4" BorderBrush="#CCC" BorderThickness="1,0,0,1"><TextBlock Text="レベル1荷重"/></Border>
                                        <Border Grid.Row="3" Grid.Column="1" Padding="10,4" BorderBrush="#CCC" BorderThickness="1,0,0,1"><TextBlock Text="—" HorizontalAlignment="Center"/></Border>
                                        <Border Grid.Row="3" Grid.Column="2" Padding="10,4" BorderBrush="#CCC" BorderThickness="1,0,0,1"><TextBlock Text="損傷限界状態"/></Border>
                                        <Border Grid.Row="3" Grid.Column="3" Padding="10,4" BorderBrush="#CCC" BorderThickness="1,0,1,1"><TextBlock Text="5×10⁻³ rad"/></Border>

                                        <Border Grid.Row="4" Grid.Column="0" Padding="10,4" BorderBrush="#CCC" BorderThickness="1,0,0,1"><TextBlock Text="レベル2荷重"/></Border>
                                        <Border Grid.Row="4" Grid.Column="1" Padding="10,4" BorderBrush="#CCC" BorderThickness="1,0,0,1"><TextBlock Text="S" HorizontalAlignment="Center"/></Border>
                                        <Border Grid.Row="4" Grid.Column="2" Padding="10,4" BorderBrush="#CCC" BorderThickness="1,0,0,1"><TextBlock Text="損傷限界状態"/></Border>
                                        <Border Grid.Row="4" Grid.Column="3" Padding="10,4" BorderBrush="#CCC" BorderThickness="1,0,1,1"><TextBlock Text="5×10⁻³ rad"/></Border>

                                        <Border Grid.Row="5" Grid.Column="0" Padding="10,4" BorderBrush="#CCC" BorderThickness="1,0,0,1"><TextBlock Text="レベル2荷重"/></Border>
                                        <Border Grid.Row="5" Grid.Column="1" Padding="10,4" BorderBrush="#CCC" BorderThickness="1,0,0,1"><TextBlock Text="A" HorizontalAlignment="Center"/></Border>
                                        <Border Grid.Row="5" Grid.Column="2" Padding="10,4" BorderBrush="#CCC" BorderThickness="1,0,0,1"><TextBlock Text="終局限界状態"/></Border>
                                        <Border Grid.Row="5" Grid.Column="3" Padding="10,4" BorderBrush="#CCC" BorderThickness="1,0,1,1"><TextBlock Text="7×10⁻³ rad"/></Border>
                                    </Grid>
                                    <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#666" MaxWidth="520"
                                               Text="※ 圧密沈下は直接基礎を圧密層に載せる場合の目安です。杭基礎では圧密沈下は生じないため、常時荷重の使用限界には即時沈下の 1×10⁻³ rad を用います。"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <Grid Margin="10,10,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="0" BorderBrush="Gray" BorderThickness="0.5">
                    <TextBlock Text="性能グレード" HorizontalAlignment="Center"/>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" BorderBrush="Gray" BorderThickness="0.5">
                    <TextBlock Text="S" HorizontalAlignment="Center"/>
                </Border>

                <Border Grid.Row="2" Grid.Column="0" BorderBrush="Gray" BorderThickness="0.5">
                    <TextBlock Text="A" HorizontalAlignment="Center"/>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" BorderBrush="Gray" BorderThickness="0.5">
                    <TextBlock Text="レベル2荷重時基礎部材" HorizontalAlignment="Center"/>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" BorderBrush="Gray" BorderThickness="0.5">
                    <TextBlock Text="損傷限界状態を超えない" HorizontalAlignment="Center"/>
                </Border>

                <Border Grid.Row="2" Grid.Column="1" BorderBrush="Gray" BorderThickness="0.5">
                    <TextBlock Text="安全限界状態を超えない" HorizontalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- モデル化オプションの既定（基礎部材の強度と変形性能）の説明 -->
            <Border Background="#EEF3F8" BorderBrush="#B8CCE0" BorderThickness="1" CornerRadius="3"
                    Margin="0,10,0,0" Padding="8,6,8,6">
                <TextBlock TextWrapping="Wrap" FontSize="11">
                    <Run FontWeight="Bold">モデル化オプションについて</Run>
                    <LineBreak/>
                    <Run>以下の各項目の既定（上側の選択肢）は、日本建築学会「基礎部材の強度と変形性能」（第1版、2022年）に基づきます。</Run>
                    <Run>同書は、杭体を使用限界・損傷限界・安全限界の 3 つの限界状態で評価するための耐力式（N-M 曲線・せん断耐力）、</Run>
                    <Run>耐力の低減係数 β1・β2、解析用の M-φ 折線（Mcr-My-β1·Mu0）や杭頭の M-θ 関係を与える文献で、本プログラムの杭体評価の基本としています。</Run>
                    <Run>項目ごとに、告示1113(第8)・RC基礎構造部材の耐震設計指針(案)・ファイバーモデル等の代替オプションを選択できます。</Run>
                </TextBlock>
            </Border>

            <Border Background="#E4ECF5" BorderBrush="#9DB4CC" BorderThickness="0,0,0,1"
                    Margin="0,16,0,0" Padding="8,5,8,5">
                <TextBlock TextWrapping="Wrap">
                    <Run FontWeight="Bold" FontSize="13">解析に影響する項目</Run>
                    <LineBreak/>
                    <Run FontSize="11" Foreground="#40506A">杭体の構成則と解析用 M-φ を決めます。変更すると M-φ が変わるため、既存の解析結果は確認のうえ削除されます（杭要素分割は保持されます）。</Run>
                </TextBlock>
            </Border>

            <!-- 場所打ちコンクリート系 杭のコンクリートのモデル化オプション -->
            <GroupBox Header="場所打ちコンクリート杭のコンクリートのモデル化" Margin="0,6,0,0">
                <StackPanel Margin="6,4,6,4">

                    <ctrl:MaterialOptionRadioPair
                        Header="ヤング係数 Ec の算定" HelpAnchor="fund-opt-ec" GroupName="OptConcreteE"
                        IsAlternativeSelected="{Binding UseUnitGsiForConcreteE, Mode=TwoWay}"
                        DefaultText="σB=ξFc として Ec を算定する（「基礎部材の強度と変形性能」）"
                        DefaultFormula="Ec = 3.35×10⁴ · (γ/24)² · (σB/60)^(1/3)、σB = ξ·Fc"
                        DefaultToolTip="ξ には入力した施工品質管理係数をそのまま用います。"
                        AlternativeText="σB=Fc として Ec を算定する（Ec は ξ に影響を受けない）"
                        AlternativeFormula="Ec = 3.35×10⁴ · (γ/24)² · (Fc/60)^(1/3)"
                        AlternativeToolTip="コンクリートのヤング係数 Ec の算定式で ξ(=施工品質管理係数 Gsi) を 1.0 として計算します。&#x0a;ξ を 1 以外にしても Ec は ξ=1.0 で算定されます（強度側 Gsi·Fc 等には実際の ξ を使用）。&#x0a;Ec は M-φ・NM 曲線・EA/EI・諸元表示に影響します。"/>

                    <ctrl:MaterialOptionRadioPair
                        Header="引張側の扱い（バイリニア型コンクリート）" HelpAnchor="fund-opt-tension" GroupName="OptConcreteTension"
                        IsAlternativeSelected="{Binding IgnoreConcreteTensileStrength, Mode=TwoWay}"
                        DefaultText="ひび割れ強度まで引張を負担する（「基礎部材の強度と変形性能」）"
                        DefaultFormula="ft = 0.56·√(ξFc)、−ft/Ec ≤ ε &lt; 0 で σ = Ec·ε（それ以下は σ = 0）"
                        DefaultToolTip="曲げ引張強度 ft に対応するひび割れひずみまで、引張側を弾性で負担します。"
                        AlternativeText="引張を無視する"
                        AlternativeFormula="ε &lt; 0 で σ = 0"
                        AlternativeToolTip="場所打ち RC 系杭のバイリニア型コンクリートで、引張側のひび割れ強度を無視します（σ=0）。&#x0a;安全限界 NM 曲線と M-φ（→ 解析）の両方に適用されます。"/>

                    <ctrl:MaterialOptionRadioPair
                        Header="圧縮側の折れ点応力度" HelpAnchor="fund-opt-compression" GroupName="OptConcreteCompression"
                        AreRadiosEnabled="{Binding ConflictingMaterialOptionsEnabled}"
                        IsAlternativeSelected="{Binding UseReducedConcreteCompressiveStrength, Mode=TwoWay}"
                        DefaultText="ξ·Fc とする（「基礎部材の強度と変形性能」）"
                        DefaultFormula="σ = Ec·ε を ξ·Fc で頭打ち（0 ≤ ε ≤ εcu）"
                        DefaultToolTip="バイリニア型コンクリートの圧縮側折れ点応力度を ξ·Fc とします。&#x0a;εcu は終局（安全限界）の圧縮縁ひずみで、既定は 3,000μ、KCTB（TB 工法）を選んだ場所打ち鋼管コンクリート杭では 5,000μ です。"
                        AlternativeText="0.85·Fc とする（ξ は乗じない）"
                        AlternativeFormula="σ = Ec·ε を 0.85·Fc で頭打ち（0 ≤ ε ≤ εcu）"
                        AlternativeToolTip="圧縮側の折れ点応力度を、既定の Gsi·Fc に代えて 0.85·Fc とします（Gsi は乗じません）。&#x0a;安全限界 NM 曲線と M-φ（→ 解析）の両方に適用されます。"/>

                </StackPanel>
            </GroupBox>

            <!-- 鋼材（PC鋼材・鉄筋・鋼管）の構成則: ヤング係数の出所と降伏応力度 -->
            <GroupBox Header="鋼材のモデル化（PC鋼材・鉄筋・鋼管）" Margin="0,6,0,0">
                <StackPanel Margin="6,4,6,4">

                    <ctrl:MaterialOptionRadioPair
                        Header="既製コンクリート杭の PC鋼材・鉄筋・鋼管のヤング係数" HelpAnchor="fund-opt-steel-e" GroupName="OptSteelE"
                        IsAlternativeSelected="{Binding UseGuideYoungsModulus, Mode=TwoWay}"
                        DefaultText="製品カタログの値を用いる"
                        DefaultFormula="PHC・PRC: Ep = 200,000 ／ Er = 200,000（JIS・三谷セキサン）・205,000（ジャパンパイル） ／ SC: Es = 200,000（JIS）・205,000（三谷 Hi-SC105）"
                        DefaultToolTip="製品ライブラリに収録したメーカー公称値をそのまま使います。&#x0a;同じ材料でもメーカーで値が割れており、異形棒鋼は 200,000（JIS・三谷セキサン）と 205,000（ジャパンパイル）、&#x0a;鋼管は 200,000（JIS）と 205,000（三谷 Hi-SC105）に分かれます。"
                        AlternativeText="「基礎部材の強度と変形性能」の計算式による"
                        AlternativeFormula="PHC・PRC: ヤング係数比 n = 5 固定（Ep = Er = 5·Ec） ／ SC: Es = 205,000 N/mm²"
                        AlternativeToolTip="カタログに拠らず指針で統一します。&#x0a;PHC杭・PRC杭（節杭を含む）は、指針が E ではなく「ヤング係数比 n = 5 そのもの」を規定しているため、E = 5·Ec として与えます。&#x0a;換算断面二次モーメント Ie の式は (n−1) を含むので、n を Ep/Ec で計算するか 5 に固定するかで結果が変わります。&#x0a;Ec = 40,000 のカタログ品では 5·Ec = 200,000 となりカタログ値と一致し、差が出るのは Ec が 40,000 以外（Fc 105 級など）の製品と、Er = 205,000 のジャパンパイル JP-NPRC です。&#x0a;EA・EI だけでなく N-M 曲線・M-φ にも一貫して効きます。"/>

                    <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="24,0,0,6"
                               Text="※ 場所打ち系の鉄筋・鋼管は、カタログ・指針とも E = 205,000 N/mm² のため本項目では変わりません。"/>


                    <ctrl:MaterialOptionRadioPair
                        Header="鉄筋の降伏応力度（場所打ちRC杭・場所打ち鋼管コンクリート杭）" HelpAnchor="fund-opt-rebar11f" GroupName="OptRebarYield"
                        IsAlternativeSelected="{Binding RebarYieldAt11F, Mode=TwoWay}"
                        DefaultText="規格降伏点 σy で降伏する完全バイリニア型とする（「基礎部材の強度と変形性能」）"
                        DefaultFormula="σ = ±σy 頭打ち（SD345→345、SD390→390 N/mm² 等）"
                        DefaultToolTip="JIS 規格降伏点で降伏する完全弾塑性型（ひずみ硬化なし）とします。"
                        AlternativeText="1.1×F で降伏する完全バイリニア型とする"
                        AlternativeFormula="σ = ±1.1·σy 頭打ち（SD490 は対象外＝規格降伏点のまま）"
                        AlternativeToolTip="場所打ち RC 杭・場所打ち鋼管コンクリート杭の鉄筋について、降伏応力度を σy から 1.1×σy に引き上げます（完全バイリニア型）。&#x0a;安全限界 NM 曲線と M-φ（→ 解析）の両方に適用されます。"/>

                    <ctrl:MaterialOptionRadioPair
                        Header="鋼管の降伏応力度（場所打ち鋼管コンクリート杭）" HelpAnchor="fund-opt-pipe11f" GroupName="OptPipeYield"
                        AreRadiosEnabled="{Binding ConflictingMaterialOptionsEnabled}"
                        IsAlternativeSelected="{Binding SteelPipeYieldAt11F, Mode=TwoWay}"
                        DefaultText="1.1×F で降伏・ひずみ硬化と破断を考慮する（「基礎部材の強度と変形性能」）"
                        DefaultFormula="降伏 σy = 1.1·F、降伏後の勾配 E/30、±σu（引張強さ）で頭打ち"
                        DefaultToolTip="降伏後はひずみ硬化と破断応力（引張強さ）を考慮したモデルとします。"
                        AlternativeText="±1.1×F 頭打ちの完全バイリニア型とする"
                        AlternativeFormula="σ = ±1.1·F 頭打ち（ひずみ硬化・破断なし）"
                        AlternativeToolTip="場所打ち鋼管コンクリート杭の鋼管について、ひずみ硬化・破断を廃し ±1.1×F で頭打ちの完全バイリニア型とします。&#x0a;安全限界 NM 曲線と M-φ（→ 解析）の両方に適用されます（鋼管杭は対象外）。"/>

                </StackPanel>
            </GroupBox>

            <!-- 解析用 M-φ 関係の算定方式 -->
            <GroupBox Header="解析用 M-φ 関係" Margin="0,6,0,0">
                <StackPanel Margin="6,4,6,4">

                    <ctrl:MaterialOptionRadioPair
                        Header="解析用 M-φ 関係（コンクリート系杭）" HelpAnchor="fund-opt-fiber-mphi" GroupName="OptMPhi"
                        IsAlternativeSelected="{Binding UseFiberMPhi, Mode=TwoWay}"
                        DefaultText="杭種ごとのポリリニアで算定する（「基礎部材の強度と変形性能」）"
                        DefaultFormula="場所打ちRC: 折線 (0,0)-(φcr, Mcr)-(φy, My)-(φc, β₁·Mu0) 等、杭種ごとの折線（β₁・β₂ 低減込み）"
                        DefaultToolTip="ひび割れ (Mcr)・主筋降伏 (My)・安全限界 (β1·Mu0) を折れ点とする折線で解析用 M-φ を与えます（強度と変形性能 3.10〜3.12）。"
                        AlternativeText="ファイバーモデルで算定する（断面分割積分）"
                        AlternativeFormula="各 φ で N = ∫σ(ε₀−φ·z)dA = N₀ を解き、M = −∫σ·z dA（約50点、β₁·β₂ 低減なし。鋼管杭の鋼管部を除く全コンクリート系杭）"
                        AlternativeToolTip="コンクリート系杭の解析用 M-φ 関係を、「基礎部材の強度と変形性能」のポリリニア（折線）に代えて、&#x0a;ファイバーモデル（断面分割積分。各曲率で軸力つり合いを解き M を直接積分）で算定します。&#x0a;対象: 場所打ちRC杭・場所打ち鋼管コンクリート杭（RC部・鋼管コンクリート部）・PHC/PRC/SC杭・コンクリート充填鋼管部。&#x0a;指針の低減係数 β1・β2 は乗じない「素の」断面応答です（終局側はポリリニアより大きくなります）。&#x0a;掃引終点は各杭種の終局状態（場所打ち系: 圧縮縁ひずみ εcu、PHC/PRC: コンクリート圧壊 εcu）。材料構成則は解析用と同じバイリニアです。&#x0a;FEM で負勾配ばねとならないよう、曲線は単調非減少化（最小勾配床付き）して使用します。&#x0a;※ 鋼管杭の鋼管部は対象外（既に厳密な折線）。M-θ（杭頭回転ばね）も従来どおりです。"/>
                </StackPanel>
            </GroupBox>

            <!-- 鋼管杭の柱座屈 (曲げ座屈) -->
            <GroupBox Header="鋼管杭の柱座屈" Margin="0,6,0,0">
                <StackPanel Margin="6,4,6,4">

                    <ctrl:MaterialOptionRadioPair
                        Header="柱座屈（曲げ座屈）による許容圧縮応力度の低減" HelpAnchor="fund-opt-steelpipe-buckling" GroupName="OptPipeBuckling"
                        IsAlternativeSelected="{Binding ConsiderSteelPipeColumnBuckling, Mode=TwoWay}"
                        DefaultText="考慮しない（局部座屈のみ）"
                        DefaultFormula="sfc = sfc1（径厚比による局部座屈低減のみ）"
                        DefaultToolTip="柱としての曲げ座屈による低減を行わず、径厚比 D/t による局部座屈の低減だけを考慮します。&#x0a;液状化した鋼管杭の耐力を、この項目を入れる前の値と比べたいときに選びます。"
                        AlternativeText="液状化区間を座屈長として考慮する（既定）"
                        AlternativeFormula="lk = 液状化区間（β &lt; 1）の長さ、Nc = π²EI/lk²、sfc2 は (8.10)〜(8.12)"
                        AlternativeToolTip="「基礎部材の強度と変形性能」解説図 8.3 により、鋼管杭の座屈長を液状化区間（水平地盤反力係数の低減係数 β が 1 未満の範囲）の長さとします。&#x0a;連続する場合はその合計を 1 つの座屈長とし、区間が複数あるときは最も長いものを採ります。杭が通る範囲だけを数えます。&#x0a;β はレベル1・レベル2 で異なるため、長い方（厳しい方）を採ります。&#x0a;液状化区間が無ければ座屈長は 0 になり、局部座屈側の sfc1 が必ず支配するので低減は生じません。&#x0a;座屈長は液状化の判定を行った地盤でのみ求まります（地盤ウィンドウで FL・β を算定していない地盤では 0）。&#x0a;使用限界・損傷限界・安全限界の圧縮軸力（検定の耐力側）に効きます。"/>
                </StackPanel>
            </GroupBox>

            <Border Background="#EAF3E8" BorderBrush="#9DB4CC" BorderThickness="0,0,0,1"
                    Margin="0,16,0,0" Padding="8,5,8,5">
                <TextBlock TextWrapping="Wrap">
                    <Run FontWeight="Bold" FontSize="13">検定の耐力側だけに効く項目</Run>
                    <LineBreak/>
                    <Run FontSize="11" Foreground="#40506A">限界値（N-M 曲線・せん断耐力）の算定方法を決めます。解析（変位・応力）には影響しないため、既存の解析結果は保持されます。</Run>
                </TextBlock>
            </Border>

            <!-- 使用限界・損傷限界（長期・短期許容応力度）の準拠文献 -->
            <GroupBox Header="場所打ちコンクリート杭のコンクリートの使用限界・損傷限界強度（長期・短期許容応力度）" Margin="0,6,0,0">
                <StackPanel Margin="6,4,6,4">
                    <CheckBox IsChecked="{Binding UseGuideline2025Appendix13}"
                              FontWeight="Bold" Margin="0,2,0,2">
                        <CheckBox.Content>
                            <TextBlock TextWrapping="Wrap"
                                       Text="2025年版 建築物の構造関係技術基準解説書 付録1-3 コンクリート系くい体の許容耐力に従う（申請実務では必ずチェックを入れる）"/>
                        </CheckBox.Content>
                        <CheckBox.ToolTip>
                            <ToolTip>
                                <TextBlock>
                                    <Run>下記 2 項目を一括で切り替えます（ON = 告示1113(第8) 側、OFF = 基礎部材の強度と変形性能 側。個別に切替えると本チェックは自動追随します）。</Run>
                                    <LineBreak/>
                                    <Run>・場所打ち杭の許容圧縮応力度 → 告示1113(第8)</Run>
                                    <LineBreak/>
                                    <Run>・場所打ちRC杭の許容せん断 → 告示1113(第8)</Run>
                                    <LineBreak/>
                                    <Run>安全限界（終局強度）の算定方式は含みません（下の「安全限界の耐力」で個別に選択）。</Run>
                                    <LineBreak/>
                                    <Run>2025年版 解説書は許容応力度について告示1113(第8)によることとしているため、申請実務では本チェックを入れる想定です。</Run>
                                </TextBlock>
                            </ToolTip>
                        </CheckBox.ToolTip>
                    </CheckBox>
                    <Separator Margin="0,4,0,4"/>

                    <ctrl:MaterialOptionRadioPair
                        Header="場所打ち杭の許容圧縮応力度（使用限界・損傷限界）" HelpAnchor="fund-opt-1113comp" GroupName="OptCompressionCode"
                        IsAlternativeSelected="{Binding UseNotification1113Compression, Mode=TwoWay}"
                        DefaultText="基礎部材の強度と変形性能による"
                        DefaultFormula="使用限界（長期）= (1/3)·ξFc、損傷限界（短期）= (2/3)·ξFc"
                        DefaultToolTip="使用限界（長期）・損傷限界（短期）の許容圧縮応力度です。"
                        AlternativeText="告示1113(第8)による（使用限界=長期・損傷限界=短期）"
                        AlternativeFormula="長期 = [1] Fc/4 ／ [2] min(Fc/4.5, 6)（区分選択）、短期 = 長期×2"
                        AlternativeToolTip="場所打ち系杭コンクリートの使用限界・損傷限界の許容圧縮応力度を、基礎部材の (1/3)ξFc・(2/3)ξFc に代えて、告示 平13国交告第1113号(第8) の長期・短期許容圧縮応力度で算定します。&#x0a;使用限界・損傷限界の NM 曲線（検定の耐力側）のみに効き、解析・安全限界・せん断には影響しません。"/>

                    <ctrl:MaterialOptionRadioPair
                        Header="場所打ちRC杭の許容せん断（使用限界・損傷限界）" HelpAnchor="fund-opt-1113shear" GroupName="OptShearCode"
                        IsAlternativeSelected="{Binding UseNotification1113Shear, Mode=TwoWay}"
                        DefaultText="せん断耐力式による（「基礎部材の強度と変形性能」）"
                        DefaultFormula="Qd = β₁ · {0.065·kc·(49+ξFc) / (M/(Q·d)+1.7)} · (1+σ₀/14.7) · b·j、Qs = (2/3)·Qd"
                        DefaultToolTip="RC規準系のせん断耐力式（軸力・M/(Q·d) 依存）で使用限界・損傷限界のせん断耐力を算定します。kc は断面寸法による係数です。"
                        AlternativeText="告示1113(第8)の許容せん断応力度による"
                        AlternativeFormula="Q = fs·b·j、長期 fs = min(Fc/40 [区分2: Fc/45], (3/4)·(0.49+Fc/100))、短期 = 長期×1.5"
                        AlternativeToolTip="場所打ち鉄筋コンクリート杭のコンクリート許容せん断応力度を、基礎部材のせん断耐力式に代えて、告示 平13国交告第1113号(第8) の長期・短期許容せん断応力度 fs で算定します（許容せん断力 Q = fs·b·j、軸力・M/(Q·d) 非依存）。&#x0a;長期 fs = min(Fc/40 ［区分2 は Fc/45］, (3/4)(0.49+Fc/100))、短期 = その 1.5 倍。使用限界=長期・損傷限界=短期。&#x0a;使用限界・損傷限界の Q-N 曲線（検定の耐力側）のみに効き、解析・安全限界・M-φ には影響しません。&#x0a;※ 場所打ち鋼管コンクリート杭のせん断は鋼管が負担するため対象外です。"/>

                    <StackPanel Orientation="Horizontal" Margin="24,2,0,2"
                                IsEnabled="{Binding Notification1113CaseEnabled}">
                        <TextBlock Text="長期許容の区分（圧縮・せん断）：" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding Notification1113CompressionCaseOptions}"
                                  DisplayMemberPath="Display" SelectedValuePath="Value"
                                  SelectedValue="{Binding Notification1113CompressionCase}"
                                  Width="240" HorizontalContentAlignment="Left"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- 安全限界状態のひずみ度〜応力度関係 -->
            <GroupBox Header="場所打ちコンクリート杭の安全限界状態のひずみ度〜応力度関係" Margin="0,6,0,0">
                <StackPanel Margin="6,4,6,4">

                    <ctrl:MaterialOptionRadioPair
                        Header="コンクリートの応力度〜ひずみ度関係" HelpAnchor="fund-opt-ultimate" GroupName="OptUltimateCode"
                        IsAlternativeSelected="{Binding UseInsituUltimateEFunction, Mode=TwoWay}"
                        DefaultText="コンクリートをバイリニア近似で算定する"
                        DefaultFormula="σ = Ec·ε を ξ·Fc で頭打ち（β₁・β₂ 低減・軸力適用範囲あり）"
                        DefaultToolTip="安全限界曲げ強度をバイリニア型コンクリートで算定し、低減係数 β1・β2 と軸力適用範囲を適用します。&#x0a;εcu は終局（安全限界）の圧縮縁ひずみで、既定は 3,000μ、KCTB（TB 工法）を選んだ場所打ち鋼管コンクリート杭では 5,000μ です。"
                        AlternativeText="RC基礎構造部材の耐震設計指針(案) 5.4.1 による（e関数法）"
                        AlternativeFormula="σ/(ξ·Fc) = 6.75·{e^(−0.812·ε/εM) − e^(−1.218·ε/εM)}（β 低減・軸力制限なし）"
                        AlternativeToolTip="RC基礎構造部材の耐震設計指針(案) 5.4.1 に従い安全限界曲げ強度（安全限界 NM 曲線）等を算定します（既定はバイリニア近似）。&#x0a;・場所打ちRC杭: コンクリートを e関数法（圧縮材料強度 ξFc）。&#x0a;・場所打ち鋼管コンクリート杭: 鋼管内コンクリート=e関数法、鋼管=圧縮側 0.85×引張強さ・引張側 引張強さで頭打ちのトリリニア、主筋=バイリニア。せん断終局 Qu=sQ0·√(1-η²)·(scMu/sMu)。&#x0a;安全限界NM曲線は低減(β)・軸力制限を課さず1本の耐力包絡線として描きます（低減後=低減前）。σ0=-0.07ξFc〜0.15ξFc は適用範囲の目安（曲線は切りません）。&#x0a;安全限界の耐力側（NM・せん断 QN）のみに効きます。解析用 M-φ/M-θ は収束のため常にバイリニアで算定するため、解析結果・使用/損傷限界には影響せず、解析結果は保持されます。"/>
                    <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,4,0,0"
                               Text="※ 場所打ち鋼管コンクリート杭では、コンクリートに加えて鋼管の応力度〜ひずみ度関係と安全限界せん断の算定式も併せて切り替わります。"/>
                </StackPanel>
            </GroupBox>

            <Border Background="#F5EFE4" BorderBrush="#9DB4CC" BorderThickness="0,0,0,1"
                    Margin="0,16,0,0" Padding="8,5,8,5">
                <TextBlock TextWrapping="Wrap">
                    <Run FontWeight="Bold" FontSize="13">工法固有の設計法</Run>
                    <LineBreak/>
                    <Run FontSize="11" Foreground="#40506A">特定の工法の評定に従って、上記の項目をまとめて設定します。</Run>
                </TextBlock>
            </Border>

            <!-- BCJ評定-FD0356-08 が定めている項目 -->
            <GroupBox Header="KCTB 場所打ち鋼管コンクリート杭（TB 工法）— BCJ評定-FD0356-08 が定める項目" Margin="0,6,0,0">
                <StackPanel Margin="6,4,6,4">
                    <CheckBox IsChecked="{Binding FollowsKctbEvaluation}"
                              FontWeight="Bold" Margin="0,2,0,2">
                        <CheckBox.Content>
                            <TextBlock TextWrapping="Wrap"
                                       Text="BCJ評定-FD0356-08 が定める設計法に従う"/>
                        </CheckBox.Content>
                        <CheckBox.ToolTip>
                            <ToolTip>
                                <TextBlock>
                                    <Run>下記 2 項目を一括で切り替えます（個別に切替えると本チェックは自動追随します）。</Run>
                                    <LineBreak/>
                                    <Run>・コンクリートの許容応力度 → 告示1113(第8) 打設方法(一)（評定 5.(1)・表1.2、区分 1）</Run>
                                    <LineBreak/>
                                    <Run>・本体部の設計法 → 単純累加（評定 5.(3)、鉄骨鉄筋コンクリート構造計算規準 2014 4章2節）</Run>
                                    <LineBreak/>
                                    <Run>チェックを入れると、適用範囲（φ700〜2700・板厚下限・鋼管長・腐食しろ 1mm・Fc 18〜45）の検査も働きます。</Run>
                                </TextBlock>
                            </ToolTip>
                        </CheckBox.ToolTip>
                    </CheckBox>
                    <Border Background="#EEF3F8" BorderBrush="#B8CCE0" BorderThickness="1" CornerRadius="3"
                            Margin="0,6,0,0" Padding="8,6,8,6">
                        <TextBlock TextWrapping="Wrap" FontSize="11">
                            <Run FontWeight="Bold">このチェックを入れると変わること（この 3 つだけです）</Run>
                            <LineBreak/>
                            <Run>1. コンクリートの許容応力度 → 告示1113(第8) 第1項第一号 くい体の打設の方法(一)、長期許容の区分 1</Run>
                            <LineBreak/>
                            <Run>　 （評定 5.(1)・表1.2。長期 圧縮 Fc/4、短期 圧縮 Fc/2）</Run>
                            <LineBreak/>
                            <Run>2. 本体部の設計法 → 単純累加（評定 5.(3)、鉄骨鉄筋コンクリート構造計算規準 2014 4章2節）</Run>
                            <LineBreak/>
                            <Run>3. 適用範囲の検査が働く（鋼管外径 φ700〜2700・板厚の下限・鋼管長の上限・腐食しろ 1mm・Fc 18〜45）</Run>
                            <LineBreak/>
                            <Run FontWeight="Bold">これ以外の設定は変わりません。</Run>
                            <Run>とくに終局（安全限界）は評定書が定めていないため、このチェックでは動きません。</Run>
                        </TextBlock>
                    </Border>

                    <Separator Margin="0,8,0,4"/>

                    <ctrl:MaterialOptionRadioPair
                        Header="本体部の設計法（許容時 N-M の求め方）" HelpAnchor="fund-opt-kctb-nm" GroupName="OptKctbNM"
                        IsAlternativeSelected="{Binding UseFiberNMForSteelPipeConcrete, Mode=TwoWay}"
                        DefaultText="単純累加で算定する（評定 5.(3)・鉄骨鉄筋コンクリート構造計算規準 2014）"
                        DefaultFormula="rNt ≦ N ≦ rNc: M = sM₀ + rM ／ 範囲外: M = sZ·(sf − sN/sA)、sM₀ = sZ·sfₜ"
                        DefaultToolTip="評定書 5.(3) が定める本体部の設計法です。&#x0a;断面を積分せず、鋼管部の許容耐力と鉄筋コンクリート部の許容耐力を累加します。&#x0a;rNc = min(Ae·fc, Ae·mfc/n)、rNt = −mA·mfₜ、Ae はコンクリート断面に主筋断面積を n 倍して加算した換算断面積です。&#x0a;使用限界・損傷限界の NM 曲線（検定の耐力側）のみに効き、安全限界・M-φ・解析には影響しません。"
                        AlternativeText="断面を分割して積分する"
                        AlternativeFormula="断面の平面保持を解き、N = Σσᵢ·Aᵢ、M = Σσᵢ·Aᵢ·Lᵢ"
                        AlternativeToolTip="評定書には無い方法です（ジャパンパイル Technical Note Vol.1-5）。&#x0a;断面を中立軸に平行な微小要素に分割し、平面保持のもとで各材料の応力を積分します。鉄筋は等価な断面を持つ薄肉鋼管に置き換えます。&#x0a;本プログラムの他の杭種と同じ求め方で、これが既定です。"/>

                    <Border Background="#EEF3F8" BorderBrush="#B8CCE0" BorderThickness="1" CornerRadius="3"
                            Margin="0,8,0,0" Padding="8,6,8,6">
                        <TextBlock TextWrapping="Wrap" FontSize="11">
                            <Run FontWeight="Bold">単純累加を選んだときに効く設定・効かない設定</Run>
                            <LineBreak/>
                            <Run>単純累加は断面を積分せず、許容応力度と換算断面だけで許容 N-M を作ります。</Run>
                            <Run>そのため</Run><Run FontWeight="Bold">応力度〜ひずみ度関係は使いません</Run><Run>。</Run>
                            <LineBreak/>
                            <Run FontWeight="Bold">効く:</Run>
                            <Run>コンクリートの許容圧縮応力度（告示1113(第8) と長期許容の区分）／</Run>
                            <Run>ヤング係数 Ec（換算断面積 Ae とヤング係数比 n に入るため。「コンクリートのモデル化」の Ec の算定）</Run>
                            <LineBreak/>
                            <Run FontWeight="Bold">効かない:</Run>
                            <Run>コンクリートの引張の扱い／圧縮側の折れ点応力度／鉄筋・鋼管の 1.1F／</Run>
                            <Run>終局の圧縮縁ひずみ／許容時の判定材料</Run>
                            <Run>（いずれも断面を積分する計算に使う設定なので、安全限界と M-φ には効きます）</Run>
                            <LineBreak/>
                            <Run FontWeight="Bold">評定書が定めていない量:</Run>
                            <Run>ヤング係数 Ec の算定式と、主筋・鋼管の許容応力度。</Run>
                            <Run>前者は本プログラムが「基礎部材の強度と変形性能」の式を、</Run>
                            <Run>後者は主筋を「鉄筋コンクリート構造計算規準」（長期 min(σy/1.5, 215 または 195)、短期 σy）、</Run>
                            <Run>鋼管を 長期 F/1.5・短期 F として扱います（いずれも選択肢はありません）。</Run>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </GroupBox>

            <!-- 評定書では定めていない項目 -->
            <GroupBox Header="KCTB 場所打ち鋼管コンクリート杭（TB 工法）— 評定書に規定が無い項目" Margin="0,6,0,0">
                <StackPanel Margin="6,4,6,4">
                    <Border Background="#FBF3E4" BorderBrush="#E0CFA8" BorderThickness="1" CornerRadius="3"
                            Margin="0,0,0,6" Padding="8,6,8,6">
                        <TextBlock TextWrapping="Wrap" FontSize="11">
                            <Run FontWeight="Bold">評定書はこれらについて何も定めていません。</Run>
                            <LineBreak/>
                            <Run>評定申込事項は「コンクリートの許容応力度」「鋼管のコンクリートに対する許容支圧せん断応力度」「本体部の設計法」「継手部の設計法」「鋼管の材質・形状・寸法等」「掘削孔および鋼管の寸法範囲等」「鋼管の腐食しろ」の 7 項目で、終局（安全限界）は含まれません。</Run>
                            <LineBreak/>
                            <Run>したがって下記は「評定に従う／反する」という項目ではなく、</Run>
                            <Run FontWeight="Bold">どの文献に依るかを設計者が選ぶ項目</Run>
                            <Run>です。既定の 3,000μ も評定書の規定ではなく、「基礎部材の強度と変形性能」による場所打ち系共通の値です。</Run>
                        </TextBlock>
                    </Border>

                    <ctrl:MaterialOptionRadioPair
                        Header="終局の圧縮縁ひずみ εcu（場所打ち鋼管コンクリート杭）" HelpAnchor="fund-opt-kctb-ecu" GroupName="OptKctbEcu"
                        IsAlternativeSelected="{Binding UseUltimateStrain5000ForSteelPipeConcrete, Mode=TwoWay}"
                        DefaultText="3,000μ とする（「基礎部材の強度と変形性能」）"
                        DefaultFormula="εcu = 0.003（他の場所打ち系杭と同じ）"
                        DefaultToolTip="場所打ち系杭に共通の終局圧縮縁ひずみです。"
                        AlternativeText="5,000μ とする（鋼管の拘束効果を考慮）"
                        AlternativeFormula="εcu = 0.005"
                        AlternativeToolTip="出典: 建設省総合技術開発プロジェクト「新建築構造体系の開発」基礎WG 最終報告書（平成12年3月）資料4-7。&#x0a;φ800×t9（SKK400）の内面リブ・突起付き鋼管に現場施工でコンクリートを充填した実大試験体の正負交番繰り返し曲げ試験と断面解析の照合により、&#x0a;3,000μ では鋼管によるコンクリートの拘束効果が考慮されず限界曲率を過小評価し、7,000μ では実験値を上回るため、5,000μ が安全側と結論されています。&#x0a;安全限界 NM と M-φ の終点（→ 解析）に影響します。鋼管杭のコンクリート充填鋼管部は対象外です。"/>

                    <ctrl:MaterialOptionRadioPair
                        Header="許容時（使用限界・損傷限界）の判定材料（場所打ち鋼管コンクリート杭）" HelpAnchor="fund-opt-kctb-allowable" GroupName="OptKctbAllowable"
                        AreRadiosEnabled="{Binding AllowableJudgementEnabled}"
                        IsAlternativeSelected="{Binding ExcludeRebarFromAllowableLimitForSteelPipeConcrete, Mode=TwoWay}"
                        DefaultText="コンクリート・鉄筋・鋼管で判定する（「基礎部材の強度と変形性能」）"
                        DefaultFormula="3 材料のうち最初に許容ひずみに達したもので限界状態を決める"
                        DefaultToolTip="他の場所打ち系杭と同じく、断面内の全材料を判定に用います。"
                        AlternativeText="コンクリートと鋼管のみで判定する（鉄筋の許容応力度では決めない）"
                        AlternativeFormula="圧縮側コンクリートが σca に達する、または圧縮/引張側の鋼管が σsa = Fs に達する"
                        AlternativeToolTip="出典: ジャパンパイル Technical Note Vol.1-5 (2022年11月) p.2。&#x0a;「圧縮側のコンクリートの応力度が許容圧縮応力度 σca に達した時、もしくは圧縮側または引張側の鋼管の応力度が許容応力度 σsa（= 基準強度 Fs）に達した時」と定めています。&#x0a;鉄筋は限界状態の判定には用いませんが、耐力への寄与（断面積分）には従来どおり参入します。&#x0a;使用限界・損傷限界の NM 曲線のみに効き、安全限界・M-φ・解析には影響しません。"/>

                    <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="24,0,0,2"
                               Text="※ 判定材料は、上の「本体部の設計法」で断面を分割して積分するときだけ選べます。単純累加では断面を積分しないため、この選択は現れません。"/>

                    <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,4,0,0"
                               Text="※ εcu を変更すると M-φ の終点が変わるため、既存の解析結果は削除されます（杭要素分割は保持）。判定材料の切替は検定の耐力側のみのため解析結果は保持されます。"/>
                </StackPanel>
            </GroupBox>

        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="ButtonOk" Content="保存(_S)" HorizontalAlignment="Left"
                    VerticalAlignment="Top" Height="30" Width="150" Command="{Binding OkCommand}"
                    IsDefault="True"
                    ToolTip="変更を保存して閉じます (Enter / Ctrl+Enter / Alt+S)"/>
            <Button x:Name="ButtonCancel" Content="キャンセル(_C)" HorizontalAlignment="Left"
                    VerticalAlignment="Top" Height="30" Width="150" Command="{Binding CancelCommand}"
                    IsCancel="True"
                    ToolTip="変更を破棄して閉じます (Esc / Alt+C)"/>
        </StackPanel>
    </Grid>
</Window>
