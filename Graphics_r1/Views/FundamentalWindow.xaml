<Window x:Class="PileDesign.Views.FundamentalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PileDesign.ViewModels"
        xmlns:common="clr-namespace:PileDesign.Common"
        xmlns:conv="clr-namespace:PileDesign.Converters"
        xmlns:ctrl="clr-namespace:PileDesign.Views.Controls"
        d:DataContext="{d:DesignInstance Type=local:FundamentalViewModel}"
        mc:Ignorable="d"
        Title="基本設定" Height="700" Width="560"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterScreen">
    
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <!-- 追加: Ctrl+Enter で OkCommand を実行 -->
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding OkCommand}" />
        <!-- 追加: Esc で CancelCommand を実行 -->
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Grid Margin="20,20,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Text="プロジェクト番号" VerticalAlignment="Top" Grid.Column="0"
                       />
                <TextBox x:Name="textBoxProjectNo" Text="{Binding ProjectNo}"
                    TextWrapping="Wrap" VerticalAlignment="Top" Grid.Column="1"
                    GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                    KeyDown="TextBox_KeyDown"
                    common:TextBoxNavigationBehavior.Enable="True">
                </TextBox>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="プロジェクト名" HorizontalAlignment="Left" Grid.Column="0"
                       />
                <TextBox x:Name="textBoxProjectName" Text="{Binding ProjectName}"
                    TextWrapping="Wrap" Grid.Column="1"
                    GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                    KeyDown="TextBox_KeyDown"
                    common:TextBoxNavigationBehavior.Enable="True">
                </TextBox>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="標高記号" HorizontalAlignment="Left" Grid.Column="0"/>
                <TextBox x:Name="textBoxRefLevel0" 
                    TextWrapping="Wrap" Grid.Column="1"
                    GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                    KeyDown="TextBox_KeyDown">
                    <TextBox.Text>
                        <Binding Path="RefLevel" UpdateSourceTrigger="LostFocus">
                            <Binding.ValidationRules>
                                <local:StringMaxLengthValidationRule MaxLength="3" />
                            </Binding.ValidationRules>
                        </Binding>
                        
                    </TextBox.Text>
                    <TextBox.ToolTip>
                        <ToolTip>
                            <TextBlock>
                                <Run>3文字まで</Run>
                            </TextBlock>
                        </ToolTip>
                    </TextBox.ToolTip>
                </TextBox>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Z=0 の標高 (m)" HorizontalAlignment="Left" Grid.Column="0"/>
                <TextBox x:Name="textBoxReferenceAltitude"
                    Text="{Binding ReferenceAltitude, StringFormat=N3, UpdateSourceTrigger=LostFocus}"
                    TextWrapping="Wrap" Grid.Column="1"
                    GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                    KeyDown="TextBox_KeyDown"
                    common:TextBoxNavigationBehavior.Enable="True">
                    <TextBox.ToolTip>
                        <ToolTip>
                            <TextBlock>
                                <Run>Z=0 が絶対標高で何 m に相当するかを指定します (docx 出力時の標高表記に使用)</Run>
                            </TextBlock>
                        </ToolTip>
                    </TextBox.ToolTip>
                </TextBox>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="性能グレード" HorizontalAlignment="Left" Grid.Column="0"/>
                <ComboBox ItemsSource="{Binding SeismicGradeOptions}" SelectedItem="{Binding SeismicGrade}"
                          Grid.Column="1"
                          SelectionChanged="ComboBoxSeismicGrade_SelectionChanged"
                          Margin="0,0,0,10"/>
                <!--<ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate> "-->
            </Grid>

            <Grid Margin="10,10,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="0" BorderBrush="Gray" BorderThickness="0.5">
                    <TextBlock Text="性能グレード" HorizontalAlignment="Center"/>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" BorderBrush="Gray" BorderThickness="0.5">
                    <TextBlock Text="S" HorizontalAlignment="Center"/>
                </Border>

                <Border Grid.Row="2" Grid.Column="0" BorderBrush="Gray" BorderThickness="0.5">
                    <TextBlock Text="A" HorizontalAlignment="Center"/>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" BorderBrush="Gray" BorderThickness="0.5">
                    <TextBlock Text="レベル2荷重時基礎部材" HorizontalAlignment="Center"/>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" BorderBrush="Gray" BorderThickness="0.5">
                    <TextBlock Text="損傷限界状態を超えない" HorizontalAlignment="Center"/>
                </Border>

                <Border Grid.Row="2" Grid.Column="1" BorderBrush="Gray" BorderThickness="0.5">
                    <TextBlock Text="安全限界状態を超えない" HorizontalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- モデル化オプションの既定（基礎部材の強度と変形性能）の説明 -->
            <Border Background="#EEF3F8" BorderBrush="#B8CCE0" BorderThickness="1" CornerRadius="3"
                    Margin="0,10,0,0" Padding="8,6,8,6">
                <TextBlock TextWrapping="Wrap" FontSize="11">
                    <Run FontWeight="Bold">モデル化オプションについて</Run>
                    <LineBreak/>
                    <Run>以下の各項目の既定（上側の選択肢）は、日本建築学会「基礎部材の強度と変形性能」（第1版、2022年）に基づきます。</Run>
                    <Run>同書は、杭体を使用限界・損傷限界・安全限界の 3 つの限界状態で評価するための耐力式（N-M 曲線・せん断耐力）、</Run>
                    <Run>耐力の低減係数 β1・β2、解析用の M-φ 折線（Mcr-My-β1·Mu0）や杭頭の M-θ 関係を与える文献で、本プログラムの杭体評価の基本としています。</Run>
                    <Run>項目ごとに、告示1113(第8)・RC基礎構造部材の耐震設計指針(案)・ファイバーモデル等の代替オプションを選択できます。</Run>
                </TextBlock>
            </Border>

            <!-- 場所打ちコンクリート系 杭のコンクリートのモデル化オプション -->
            <GroupBox Header="コンクリートのモデル化" Margin="0,6,0,0">
                <StackPanel Margin="6,4,6,4">

                    <ctrl:MaterialOptionRadioPair
                        Header="ヤング係数 Ec の算定" HelpAnchor="fund-opt-ec" GroupName="OptConcreteE"
                        IsAlternativeSelected="{Binding UseUnitGsiForConcreteE, Mode=TwoWay}"
                        DefaultText="σB=ξFc として Ec を算定する（「基礎部材の強度と変形性能」）"
                        DefaultFormula="Ec = 3.35×10⁴ · (γ/24)² · (σB/60)^(1/3)、σB = ξ·Fc"
                        DefaultToolTip="ξ には入力した施工品質管理係数をそのまま用います。"
                        AlternativeText="σB=Fc として Ec を算定する（Ec は ξ に影響を受けない）"
                        AlternativeFormula="Ec = 3.35×10⁴ · (γ/24)² · (Fc/60)^(1/3)"
                        AlternativeToolTip="コンクリートのヤング係数 Ec の算定式で ξ(=施工品質管理係数 Gsi) を 1.0 として計算します。&#x0a;ξ を 1 以外にしても Ec は ξ=1.0 で算定されます（強度側 Gsi·Fc 等には実際の ξ を使用）。&#x0a;Ec は M-φ・NM 曲線・EA/EI・諸元表示に影響します。"/>

                    <ctrl:MaterialOptionRadioPair
                        Header="引張側の扱い（バイリニア型コンクリート）" HelpAnchor="fund-opt-tension" GroupName="OptConcreteTension"
                        IsAlternativeSelected="{Binding IgnoreConcreteTensileStrength, Mode=TwoWay}"
                        DefaultText="ひび割れ強度まで引張を負担する（「基礎部材の強度と変形性能」）"
                        DefaultFormula="ft = 0.56·√(ξFc)、−ft/Ec ≤ ε &lt; 0 で σ = Ec·ε（それ以下は σ = 0）"
                        DefaultToolTip="曲げ引張強度 ft に対応するひび割れひずみまで、引張側を弾性で負担します。"
                        AlternativeText="引張を無視する"
                        AlternativeFormula="ε &lt; 0 で σ = 0"
                        AlternativeToolTip="場所打ち RC 系杭のバイリニア型コンクリートで、引張側のひび割れ強度を無視します（σ=0）。&#x0a;安全限界 NM 曲線と M-φ（→ 解析）の両方に適用されます。"/>

                    <ctrl:MaterialOptionRadioPair
                        Header="圧縮側の折れ点応力度" HelpAnchor="fund-opt-compression" GroupName="OptConcreteCompression"
                        AreRadiosEnabled="{Binding ConflictingMaterialOptionsEnabled}"
                        IsAlternativeSelected="{Binding UseReducedConcreteCompressiveStrength, Mode=TwoWay}"
                        DefaultText="ξ·Fc とする（「基礎部材の強度と変形性能」）"
                        DefaultFormula="σ = Ec·ε を ξ·Fc で頭打ち（0 ≤ ε ≤ 0.003）"
                        DefaultToolTip="バイリニア型コンクリートの圧縮側折れ点応力度を ξ·Fc とします。"
                        AlternativeText="0.85·Fc とする（ξ は乗じない）"
                        AlternativeFormula="σ = Ec·ε を 0.85·Fc で頭打ち（0 ≤ ε ≤ 0.003）"
                        AlternativeToolTip="圧縮側の折れ点応力度を、既定の Gsi·Fc に代えて 0.85·Fc とします（Gsi は乗じません）。&#x0a;安全限界 NM 曲線と M-φ（→ 解析）の両方に適用されます。"/>

                    <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,4,0,0"
                               Text="※ 変更すると M-φ が変わるため、既存の解析結果は削除されます（杭要素分割は保持）。"/>
                </StackPanel>
            </GroupBox>

            <!-- 許容耐力・終局強度の準拠文献 -->
            <GroupBox Header="許容耐力・終局強度の準拠" Margin="0,6,0,0">
                <StackPanel Margin="6,4,6,4">
                    <CheckBox IsChecked="{Binding UseGuideline2025Appendix13}"
                              FontWeight="Bold" Margin="0,2,0,2">
                        <CheckBox.Content>
                            <TextBlock TextWrapping="Wrap"
                                       Text="2025年版 建築物の構造関係技術基準解説書 付録1-3 コンクリート系くい体の許容耐力に従う（申請実務では必ずチェックを入れる）"/>
                        </CheckBox.Content>
                        <CheckBox.ToolTip>
                            <ToolTip>
                                <TextBlock>
                                    <Run>下記 2 項目を一括で切り替えます（ON = 告示1113(第8) 側、OFF = 基礎部材の強度と変形性能 側。個別に切替えると本チェックは自動追随します）。</Run>
                                    <LineBreak/>
                                    <Run>・場所打ち杭の許容圧縮応力度 → 告示1113(第8)</Run>
                                    <LineBreak/>
                                    <Run>・場所打ちRC杭の許容せん断 → 告示1113(第8)</Run>
                                    <LineBreak/>
                                    <Run>安全限界（終局強度）の算定方式は含みません（下の「安全限界の耐力」で個別に選択）。</Run>
                                    <LineBreak/>
                                    <Run>2025年版 解説書は許容応力度について告示1113(第8)によることとしているため、申請実務では本チェックを入れる想定です。</Run>
                                </TextBlock>
                            </ToolTip>
                        </CheckBox.ToolTip>
                    </CheckBox>
                    <Separator Margin="0,4,0,4"/>

                    <ctrl:MaterialOptionRadioPair
                        Header="場所打ち杭の許容圧縮応力度（使用限界・損傷限界）" HelpAnchor="fund-opt-1113comp" GroupName="OptCompressionCode"
                        IsAlternativeSelected="{Binding UseNotification1113Compression, Mode=TwoWay}"
                        DefaultText="基礎部材の強度と変形性能による"
                        DefaultFormula="使用限界（長期）= (1/3)·ξFc、損傷限界（短期）= (2/3)·ξFc"
                        DefaultToolTip="使用限界（長期）・損傷限界（短期）の許容圧縮応力度です。"
                        AlternativeText="告示1113(第8)による（使用限界=長期・損傷限界=短期）"
                        AlternativeFormula="長期 = [1] Fc/4 ／ [2] min(Fc/4.5, 6)（区分選択）、短期 = 長期×2"
                        AlternativeToolTip="場所打ち系杭コンクリートの使用限界・損傷限界の許容圧縮応力度を、基礎部材の (1/3)ξFc・(2/3)ξFc に代えて、告示 平13国交告第1113号(第8) の長期・短期許容圧縮応力度で算定します。&#x0a;使用限界・損傷限界の NM 曲線（検定の耐力側）のみに効き、解析・安全限界・せん断には影響しません。"/>

                    <ctrl:MaterialOptionRadioPair
                        Header="場所打ちRC杭の許容せん断（使用限界・損傷限界）" HelpAnchor="fund-opt-1113shear" GroupName="OptShearCode"
                        IsAlternativeSelected="{Binding UseNotification1113Shear, Mode=TwoWay}"
                        DefaultText="せん断耐力式による（「基礎部材の強度と変形性能」）"
                        DefaultFormula="Qd = β₁ · {0.065·kc·(49+ξFc) / (M/(Q·d)+1.7)} · (1+σ₀/14.7) · b·j、Qs = (2/3)·Qd"
                        DefaultToolTip="RC規準系のせん断耐力式（軸力・M/(Q·d) 依存）で使用限界・損傷限界のせん断耐力を算定します。kc は断面寸法による係数です。"
                        AlternativeText="告示1113(第8)の許容せん断応力度による"
                        AlternativeFormula="Q = fs·b·j、長期 fs = min(Fc/40 [区分2: Fc/45], (3/4)·(0.49+Fc/100))、短期 = 長期×1.5"
                        AlternativeToolTip="場所打ち鉄筋コンクリート杭のコンクリート許容せん断応力度を、基礎部材のせん断耐力式に代えて、告示 平13国交告第1113号(第8) の長期・短期許容せん断応力度 fs で算定します（許容せん断力 Q = fs·b·j、軸力・M/(Q·d) 非依存）。&#x0a;長期 fs = min(Fc/40 ［区分2 は Fc/45］, (3/4)(0.49+Fc/100))、短期 = その 1.5 倍。使用限界=長期・損傷限界=短期。&#x0a;使用限界・損傷限界の Q-N 曲線（検定の耐力側）のみに効き、解析・安全限界・M-φ には影響しません。&#x0a;※ 場所打ち鋼管コンクリート杭のせん断は鋼管が負担するため対象外です。"/>

                    <StackPanel Orientation="Horizontal" Margin="24,2,0,2"
                                IsEnabled="{Binding Notification1113CaseEnabled}">
                        <TextBlock Text="長期許容の区分（圧縮・せん断）：" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding Notification1113CompressionCaseOptions}"
                                  DisplayMemberPath="Display" SelectedValuePath="Value"
                                  SelectedValue="{Binding Notification1113CompressionCase}"
                                  Width="240" HorizontalContentAlignment="Left"/>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,2,0,0"
                               Text="※ 使用/損傷限界のみ変更（検定の耐力側）。解析結果は保持されます。"/>

                    <Separator Margin="0,6,0,4"/>

                    <ctrl:MaterialOptionRadioPair
                        Header="安全限界の耐力（場所打ちRC杭／鋼管巻き杭）" HelpAnchor="fund-opt-ultimate" GroupName="OptUltimateCode"
                        IsAlternativeSelected="{Binding UseInsituUltimateEFunction, Mode=TwoWay}"
                        DefaultText="コンクリートをバイリニア近似で算定する"
                        DefaultFormula="σ = Ec·ε を ξ·Fc で頭打ち、εcu = 0.003（β₁・β₂ 低減・軸力適用範囲あり）"
                        DefaultToolTip="安全限界曲げ強度をバイリニア型コンクリート（εcu=0.003）で算定し、低減係数 β1・β2 と軸力適用範囲を適用します。"
                        AlternativeText="RC基礎構造部材の耐震設計指針(案) 5.4.1 による（e関数法）"
                        AlternativeFormula="σ/(ξ·Fc) = 6.75·{e^(−0.812·ε/εM) − e^(−1.218·ε/εM)}（β 低減・軸力制限なし）"
                        AlternativeToolTip="RC基礎構造部材の耐震設計指針(案) 5.4.1 に従い安全限界曲げ強度（安全限界 NM 曲線）等を算定します（既定はバイリニア近似）。&#x0a;・場所打ちRC杭: コンクリートを e関数法（εcu=0.003・圧縮材料強度 ξFc）。&#x0a;・場所打ち鋼管コンクリート杭: 鋼管内コンクリート=e関数法、鋼管=圧縮側 0.85×引張強さ・引張側 引張強さで頭打ちのトリリニア、主筋=バイリニア。せん断終局 Qu=sQ0·√(1-η²)·(scMu/sMu)。&#x0a;安全限界NM曲線は低減(β)・軸力制限を課さず1本の耐力包絡線として描きます（低減後=低減前）。σ0=-0.07ξFc〜0.15ξFc は適用範囲の目安（曲線は切りません）。&#x0a;安全限界の耐力側（NM・せん断 QN）のみに効きます。解析用 M-φ/M-θ は収束のため常にバイリニアで算定するため、解析結果・使用/損傷限界には影響せず、解析結果は保持されます。"/>
                    <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,2,0,0"
                               Text="※ 本グループは検定の耐力側のみ変更（許容圧縮/せん断=使用・損傷限界、指針(案)=安全限界）。解析結果は保持されます。"/>
                </StackPanel>
            </GroupBox>

            <!-- 鉄筋・鋼管の 1.1F 完全バイリニア型オプション -->
            <GroupBox Header="鉄筋・鋼管のモデル化" Margin="0,6,0,0">
                <StackPanel Margin="6,4,6,4">

                    <ctrl:MaterialOptionRadioPair
                        Header="鉄筋の降伏応力度（場所打ちRC杭・場所打ち鋼管コンクリート杭）" HelpAnchor="fund-opt-rebar11f" GroupName="OptRebarYield"
                        IsAlternativeSelected="{Binding RebarYieldAt11F, Mode=TwoWay}"
                        DefaultText="規格降伏点 σy で降伏する完全バイリニア型とする（「基礎部材の強度と変形性能」）"
                        DefaultFormula="σ = ±σy 頭打ち（SD345→345、SD390→390 N/mm² 等）"
                        DefaultToolTip="JIS 規格降伏点で降伏する完全弾塑性型（ひずみ硬化なし）とします。"
                        AlternativeText="1.1×F で降伏する完全バイリニア型とする"
                        AlternativeFormula="σ = ±1.1·σy 頭打ち（SD490 は対象外＝規格降伏点のまま）"
                        AlternativeToolTip="場所打ち RC 杭・場所打ち鋼管コンクリート杭の鉄筋について、降伏応力度を σy から 1.1×σy に引き上げます（完全バイリニア型）。&#x0a;安全限界 NM 曲線と M-φ（→ 解析）の両方に適用されます。"/>

                    <ctrl:MaterialOptionRadioPair
                        Header="鋼管の降伏応力度（場所打ち鋼管コンクリート杭）" HelpAnchor="fund-opt-pipe11f" GroupName="OptPipeYield"
                        AreRadiosEnabled="{Binding ConflictingMaterialOptionsEnabled}"
                        IsAlternativeSelected="{Binding SteelPipeYieldAt11F, Mode=TwoWay}"
                        DefaultText="1.1×F で降伏・ひずみ硬化と破断を考慮する（「基礎部材の強度と変形性能」）"
                        DefaultFormula="降伏 σy = 1.1·F、降伏後の勾配 E/30、±σu（引張強さ）で頭打ち"
                        DefaultToolTip="降伏後はひずみ硬化と破断応力（引張強さ）を考慮したモデルとします。"
                        AlternativeText="±1.1×F 頭打ちの完全バイリニア型とする"
                        AlternativeFormula="σ = ±1.1·F 頭打ち（ひずみ硬化・破断なし）"
                        AlternativeToolTip="場所打ち鋼管コンクリート杭の鋼管について、ひずみ硬化・破断を廃し ±1.1×F で頭打ちの完全バイリニア型とします。&#x0a;安全限界 NM 曲線と M-φ（→ 解析）の両方に適用されます（鋼管杭は対象外）。"/>

                    <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,4,0,0"
                               Text="※ 変更すると M-φ が変わるため、既存の解析結果は削除されます（杭要素分割は保持）。"/>
                </StackPanel>
            </GroupBox>

            <!-- 解析用 M-φ 関係の算定方式 -->
            <GroupBox Header="M-φ関係の算定" Margin="0,6,0,0">
                <StackPanel Margin="6,4,6,4">

                    <ctrl:MaterialOptionRadioPair
                        Header="解析用 M-φ 関係（コンクリート系杭）" HelpAnchor="fiber-mphi-option" GroupName="OptMPhi"
                        IsAlternativeSelected="{Binding UseFiberMPhi, Mode=TwoWay}"
                        DefaultText="杭種ごとのポリリニアで算定する（「基礎部材の強度と変形性能」）"
                        DefaultFormula="場所打ちRC: 折線 (0,0)-(φcr, Mcr)-(φy, My)-(φc, β₁·Mu0) 等、杭種ごとの折線（β₁・β₂ 低減込み）"
                        DefaultToolTip="ひび割れ (Mcr)・主筋降伏 (My)・安全限界 (β1·Mu0) を折れ点とする折線で解析用 M-φ を与えます（強度と変形性能 3.10〜3.12）。"
                        AlternativeText="ファイバーモデルで算定する（断面分割積分）"
                        AlternativeFormula="各 φ で N = ∫σ(ε₀−φ·z)dA = N₀ を解き、M = −∫σ·z dA（約50点、β₁·β₂ 低減なし。鋼管杭の鋼管部を除く全コンクリート系杭）"
                        AlternativeToolTip="コンクリート系杭の解析用 M-φ 関係を、「基礎部材の強度と変形性能」のポリリニア（折線）に代えて、&#x0a;ファイバーモデル（断面分割積分。各曲率で軸力つり合いを解き M を直接積分）で算定します。&#x0a;対象: 場所打ちRC杭・場所打ち鋼管コンクリート杭（RC部・鋼管コンクリート部）・PHC/PRC/SC杭・コンクリート充填鋼管部。&#x0a;指針の低減係数 β1・β2 は乗じない「素の」断面応答です（終局側はポリリニアより大きくなります）。&#x0a;掃引終点は各杭種の終局状態（場所打ち系: 圧縮縁ひずみ 0.003、PHC/PRC: コンクリート圧壊 εcu）。材料構成則は解析用と同じバイリニアです。&#x0a;FEM で負勾配ばねとならないよう、曲線は単調非減少化（最小勾配床付き）して使用します。&#x0a;※ 鋼管杭の鋼管部は対象外（既に厳密な折線）。M-θ（杭頭回転ばね）も従来どおりです。"/>
                    <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,4,0,0"
                               Text="※ 変更すると M-φ が変わるため、既存の解析結果は削除されます（杭要素分割は保持）。"/>
                </StackPanel>
            </GroupBox>

        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="ButtonOk" Content="保存(_S)" HorizontalAlignment="Left"
                    VerticalAlignment="Top" Height="30" Width="150" Command="{Binding OkCommand}"
                    IsDefault="True"
                    ToolTip="変更を保存して閉じます (Enter / Ctrl+Enter / Alt+S)"/>
            <Button x:Name="ButtonCancel" Content="キャンセル(_C)" HorizontalAlignment="Left"
                    VerticalAlignment="Top" Height="30" Width="150" Command="{Binding CancelCommand}"
                    IsCancel="True"
                    ToolTip="変更を破棄して閉じます (Esc / Alt+C)"/>
        </StackPanel>
    </Grid>
</Window>
