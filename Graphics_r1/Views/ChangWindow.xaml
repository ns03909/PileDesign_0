                                    <!-- 左: 数式説明（配置用） -->
                                    <ScrollViewer Grid.Column="0" Padding="8" VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <TextBlock Text="杭地盤セット配置" FontWeight="Bold" Margin="0,0,0,6"/>
                                            <controls:FormulaControl Formula="y = \frac{H}{4 E I \beta} e^{-\beta x}\left((2-\alpha_r)\cos(\beta x) + \alpha_r\sin(\beta x)\right)" Style="{StaticResource FormulaControlStyle}" />
                                            <controls:FormulaControl Formula="\delta = \frac{H}{4EI\beta^3} (2-\alpha_r)" Style="{StaticResource FormulaControlStyle}" />
                                            <controls:FormulaControl Formula="M_0=\frac{H}{2\beta}\alpha_r" Style="{StaticResource FormulaControlStyle}" />
                                            <controls:FormulaControl Formula="M_m=-\frac{H}{2\beta}\sqrt{(1-\alpha_r)^2+1}\,exp(-\tan^{-1}(\frac{1}{1-\alpha_r}))" Style="{StaticResource FormulaControlStyle}" />
                                            <controls:FormulaControl Formula="S=-H e^{-\beta x}(\cos\beta x - (1-\alpha_r)\sin\beta x)" Style="{StaticResource FormulaControlStyle}" />
                                        </StackPanel>
                                    </ScrollViewer>

