<Window x:Class="PileDesign.Views.ChangWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:app="clr-namespace:PileDesign"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        xmlns:local="clr-namespace:PileDesign.ViewModels"
        mc:Ignorable="d"
        xmlns:controls="clr-namespace:WpfMath.Controls;assembly=WpfMath"
        d:DataContext="{d:DesignInstance Type=local:ChangViewModel}"
        xmlns:common="clr-namespace:PileDesign.Common"
        xmlns:conv="clr-namespace:PileDesign.Converters"
        xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
        xmlns:svg="http://sharpvectors.codeplex.com/runtime/"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        PreviewKeyDown="Window_PreviewKeyDown"
        Title="杭頭水平力を受ける一様地盤中の長い杭の状態計算" Height="450" Width="800">

    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
    </Window.InputBindings>

    <!-- 右寄せ表示・編集中用の共通スタイルを追加 -->
    <Window.Resources>
        <Style x:Key="FormulaControlStyle" TargetType="controls:FormulaControl">
            <Setter Property="Scale" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 表示用: TextBlock を右寄せ -->
        <Style x:Key="RightAlignedTextBlockStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>


        <!-- 編集用: TextBox を右寄せ -->
        <Style x:Key="RightAlignedEditingTextBoxStyle" TargetType="TextBox">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>


        <!-- 編集用: TextBox を右寄せ + Bold (RightAlignedEditingTextBoxStyle に基づく) -->
        <Style x:Key="BoldRightAlignedEditingTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource RightAlignedEditingTextBoxStyle}">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- 表示用: TextBlock を右寄せ + Bold -->
        <Style x:Key="BoldRightAlignedTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource RightAlignedTextBlockStyle}">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <conv:MultiplyConverter x:Key="Multiply1000Converter" />
        <conv:VisibilityConverter x:Key="VisibilityConverter" />

        <ContextMenu x:Key="CommonDataGridContextMenu">
            <MenuItem Header="CSVエクスポート" Click="ExportCsvFromContextMenu_Click"/>
            <MenuItem Header="選択セルをコピー" Click="CopyDataGridSelection_Click"/>
        </ContextMenu>

        <!-- SvgViewboxコントロール用のスタイルを定義 -->
        <Style x:Key="SvgIconStyle16" TargetType="svgc:SvgViewbox">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="StretchDirection" Value="DownOnly"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- 特定の列ヘッダーの色を変更するスタイル -->
        <Style x:Key="GreenHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="#238966"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="YellowHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="#F7B515"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DeepBlueHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="#3271AD"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PaleRedHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="#E95541"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CrimsonHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="#D82531"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 上部: タイトル＋入力エリア（左右2カラム） -->
        <Border Grid.Row="0" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="8,4,8,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- タイトル行 -->
                <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                           Text="杭頭水平力を受ける一様地盤中の長い杭の状態計算"
                           FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>

                <!-- 左カラム: 説明＋全体水平力 -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Foreground="#888" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"
                               Text="Changの式による一様地盤中の長い杭の計算。杭の非線形性は非考慮。地盤は1mm以上で非線形性Hを考慮（塑性地盤反力pyは非考慮）。"/>

                    <GroupBox Header="全体水平力による解析" Padding="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="全体水平力(kN)" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox Grid.Column="1" HorizontalContentAlignment="Right"
                                     Text="{Binding TotalHorizontalLoad, StringFormat=N1, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="2" Content="解析実行" Command="{Binding AnalysisCommand}" Margin="8,0,0,0"/>
                        </Grid>
                    </GroupBox>
                </StackPanel>

                <!-- 区切り -->
                <GridSplitter Grid.Row="1" Grid.Column="1" Width="1" Background="#DDD" HorizontalAlignment="Center" VerticalAlignment="Stretch" IsEnabled="False"/>

                <!-- 右カラム: 全体モデル読み込み＋ファイル操作 -->
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="8,0,0,0">
                    <GroupBox Header="全体モデルからの読み込み" Padding="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="荷重条件" VerticalAlignment="Center" Margin="0,2,8,2"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,2"
                                      DisplayMemberPath="LoadName"
                                      SelectedItem="{Binding SelectedLoadCase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      ItemsSource="{Binding AllSeismicLoadCases}"
                                      ToolTip="地震荷重ケースを選択してください"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="上部・基礎組合せ" VerticalAlignment="Center" Margin="0,2,8,2"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,2"
                                      DisplayMemberPath="Name"
                                      SelectedItem="{Binding SelectedLoadCombination, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      ItemsSource="{Binding AllLoadCombinations}"
                                      ToolTip="荷重組合せを選択してください"/>

                            <CheckBox Grid.Row="2" Grid.Column="1" Content="液状化あり" IsChecked="{Binding IsLiquefaction, Mode=TwoWay}" Margin="0,2"/>

                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                <Button Content="読み込み" Command="{Binding ApplyInputModelCommand}"/>
                                <Button Click="SaveChangData_Click" ToolTip="Chang 入力をファイルに保存します (JSON)" Margin="8,0,0,0">
                                    <svgc:SvgViewbox Source="/Icons/SaveFile.svg" Style="{StaticResource SvgIconStyle16}"/>
                                </Button>
                                <Button Click="LoadChangData_Click" ToolTip="Chang 入力をファイルから読み込みます (JSON)" Margin="4,0,0,0">
                                    <svgc:SvgViewbox Source="/Icons/OpenFile.svg" Style="{StaticResource SvgIconStyle16}"/>
                                </Button>
                                <Button x:Name="HelpButton" ToolTip="ヘルプ" Click="HelpButton_Click" Margin="4,0,0,0">
                                    <svgc:SvgViewbox Source="/Icons/Help.svg" Style="{StaticResource SvgIconStyle16}"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- AvalonDock レイアウト -->
        <avalonDock:DockingManager x:Name="dockingManager" Grid.Row="1">
            <avalonDock:LayoutRoot>
                <!-- 横方向: 左 75% に上/下（定義/配置）、右 25% にグラフ -->
                <avalonDock:LayoutPanel Orientation="Horizontal">
                    <!-- 左側: 上下に分割 -->
                    <avalonDock:LayoutDocumentPaneGroup Orientation="Vertical" DockWidth="0.75*">
                        <avalonDock:LayoutDocumentPane >

                            <!-- 上: 杭地盤セット定義 -->
                            <avalonDock:LayoutAnchorable Title="杭地盤セット定義" CanClose="False" CanHide="False">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.45*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="0.55*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 左: 数式説明 -->
                                    <ScrollViewer Grid.Column="0" Padding="8" VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <TextBlock Text="杭地盤セット（EIとKH0の計算）" FontWeight="Bold" Margin="0,0,0,6"/>
                                            <controls:FormulaControl Formula="EI = [E_s (B^4-(B-2t_s)^4)+E_c((B-2t_s)^4-(B-2t)^4]\pi/64" Style="{StaticResource FormulaControlStyle}" />
                                            <controls:FormulaControl Formula="E_c=if(F_c \ge 85, 40000, 33500 (\frac{\gamma_c}{24})^2(\frac{F_c}{60})^{-1/3})" Style="{StaticResource FormulaControlStyle}" />
                                            <controls:FormulaControl Formula="k_{h0} = \alpha \xi E_0 (\frac{B}{B_0})^{-3/4}" Style="{StaticResource FormulaControlStyle}" />
                                        </StackPanel>
                                    </ScrollViewer>

                                    <!-- 可動式の区切り -->
                                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" ShowsPreview="True"/>

                                    <!-- 右: DataGrid -->
                                    <Grid Grid.Column="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Button Content="杭地盤セット追加" Command="{Binding AddChangSoilPileCommand}" 
                                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Grid.Row="0"/>

                                        <common:EnhancedDataGrid x:Name="DataGridSoilPile"
                                                                 ItemsSource="{Binding ChangSoilPiles, UpdateSourceTrigger=LostFocus}"
                                                                 AutoGenerateColumns="False"
                                                                 CanUserAddRows="False"
                                                                 CanUserDeleteRows="False"
                                                                 CanUserSortColumns="False"
                                                                 FrozenColumnCount="1"
                                                                 LoadingRow="DataGrid_LoadingRow"
                                                                 Grid.Row="1"
                                                                 PreparingCellForEdit="DataGrid_PreparingCellForEdit"
                                                                 common:DataGridNavigationBehavior.Enable="True"
                                                                    CellEditEnding="DataGrid_CellEditEnding">
                                            <DataGrid.AlternatingRowBackground>
                                                <ImageBrush/>
                                            </DataGrid.AlternatingRowBackground>
                                            <DataGrid.Style>
                                                <Style/>
                                            </DataGrid.Style>


                                            <DataGrid.ColumnHeaderStyle>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                    <Setter Property="Foreground" Value="#62B0E2" />
                                                </Style>
                                            </DataGrid.ColumnHeaderStyle>

                                            <!--CSVファイル出力等-->
                                            <DataGrid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="CSVエクスポート"
                                                          Click="ExportCsvFromContextMenu_Click"
                                                          CommandParameter="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <MenuItem Header="選択セルをコピー"
                                                          Click="CopyDataGridSelection_Click"
                                                          CommandParameter="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                </ContextMenu>
                                            </DataGrid.ContextMenu>

                                            <DataGrid.Columns>
                                                <!-- 先頭: 行削除ボタン -->
                                                <DataGridTemplateColumn Width="30" Header="">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="削除"
                                                                Command="{Binding DataContext.DeleteChangSoilPileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>


                                                <DataGridTextColumn Binding="{Binding OuterDiameter, UpdateSourceTrigger=LostFocus, Mode=TwoWay, StringFormat=N0}" Width="60"
                                                    ElementStyle="{StaticResource RightAlignedTextBlockStyle}"
                                                    EditingElementStyle="{StaticResource RightAlignedEditingTextBoxStyle}">
                                                    <DataGridTextColumn.Header>
                                                        <StackPanel>
                                                            <TextBlock Text="外径" HorizontalAlignment="Center"/>
                                                            <controls:FormulaControl Formula="B" Style="{StaticResource FormulaControlStyle}" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="(mm)" HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                                <DataGridTemplateColumn Header="中空部" Width="60">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <CheckBox IsChecked="{Binding IsHollow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Margin="2" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTextColumn Binding="{Binding Thickness, UpdateSourceTrigger=LostFocus, StringFormat=N1, Mode=TwoWay}" Width="60"
                                                      ElementStyle="{StaticResource RightAlignedTextBlockStyle}"
                                                      EditingElementStyle="{StaticResource RightAlignedEditingTextBoxStyle}">
                                                    <DataGridTextColumn.Header>
                                                        <StackPanel>
                                                            <TextBlock Text="総肉厚" HorizontalAlignment="Center"/>
                                                            <controls:FormulaControl Formula="t" Style="{StaticResource FormulaControlStyle}" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="(mm)" HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Binding="{Binding SteelThickness, UpdateSourceTrigger=LostFocus, StringFormat=N1, Mode=TwoWay}" Width="60"
                                                      ElementStyle="{StaticResource RightAlignedTextBlockStyle}"
                                                      EditingElementStyle="{StaticResource RightAlignedEditingTextBoxStyle}">
                                                    <DataGridTextColumn.Header>
                                                        <StackPanel>
                                                            <TextBlock Text="鋼板厚" HorizontalAlignment="Center"/>
                                                            <controls:FormulaControl Formula="t_s" Style="{StaticResource FormulaControlStyle}" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="(mm)" HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn  Binding="{Binding Es, StringFormat=N0, Mode=OneWay}" Foreground="Gray" Width="60"
                                                    ElementStyle="{StaticResource RightAlignedTextBlockStyle}">
                                                    <DataGridTextColumn.Header>
                                                        <StackPanel>
                                                            <TextBlock Text="鋼板" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="ヤング率" HorizontalAlignment="Center"/>
                                                            <controls:FormulaControl Formula="E_s" Style="{StaticResource FormulaControlStyle}" HorizontalAlignment="Center"/>
                                                            <TextBlock HorizontalAlignment="Center"><Run Text="(N/mm"/><Run Text="2" BaselineAlignment="Superscript" FontSize="9"/><Run Text=")"/></TextBlock>
                                                        </StackPanel>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Binding="{Binding Fc, UpdateSourceTrigger=LostFocus, StringFormat=N0, Mode=TwoWay}" Width="60"
                                                      ElementStyle="{StaticResource RightAlignedTextBlockStyle}"
                                                      EditingElementStyle="{StaticResource RightAlignedEditingTextBoxStyle}">
                                                    <DataGridTextColumn.Header>
                                                        <StackPanel>
                                                            <TextBlock Text="コンクリート" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="基準強度" HorizontalAlignment="Center"/>
                                                            <controls:FormulaControl Formula="F_c" Style="{StaticResource FormulaControlStyle}" HorizontalAlignment="Center"/>
                                                            <TextBlock HorizontalAlignment="Center"><Run Text="(N/mm"/><Run Text="2" BaselineAlignment="Superscript" FontSize="9"/><Run Text=")"/></TextBlock>
                                                        </StackPanel>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Binding="{Binding Gamma, UpdateSourceTrigger=LostFocus, StringFormat=N1, Mode=TwoWay}" Width="60"
                                                    ElementStyle="{StaticResource RightAlignedTextBlockStyle}"
                                                    EditingElementStyle="{StaticResource RightAlignedEditingTextBoxStyle}">
                                                    <DataGridTextColumn.Header>
                                                        <StackPanel>
                                                            <TextBlock Text="コンクリート" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="密度" HorizontalAlignment="Center"/>
                                                            <controls:FormulaControl Formula="\gamma_c" Style="{StaticResource FormulaControlStyle}" HorizontalAlignment="Center"/>
                                                            <TextBlock HorizontalAlignment="Center"><Run Text="(N/mm"/><Run Text="3" BaselineAlignment="Superscript" FontSize="9"/><Run Text=")"/></TextBlock>
                                                        </StackPanel>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Binding="{Binding Ec, StringFormat=N0, Mode=OneWay}" Foreground="Gray" Width="60"
                                                    ElementStyle="{StaticResource RightAlignedTextBlockStyle}">
                                                    <DataGridTextColumn.Header>
                                                        <StackPanel>
                                                            <TextBlock Text="コンクリート" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="ヤング率" HorizontalAlignment="Center"/>
                                                            <controls:FormulaControl Formula="E_c" Style="{StaticResource FormulaControlStyle}" HorizontalAlignment="Center"/>
                                                            <TextBlock HorizontalAlignment="Center"><Run Text="(N/mm"/><Run Text="2" BaselineAlignment="Superscript" FontSize="9"/><Run Text=")"/></TextBlock>
                                                        </StackPanel>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                                <!-- DataGridSoilPile 内の EI 列を編集可能に変更 -->
                                                <DataGridTextColumn Binding="{Binding EI, UpdateSourceTrigger=LostFocus, StringFormat=N0, Mode=TwoWay}" Width="60"
                                                        ElementStyle="{StaticResource BoldRightAlignedTextBlockStyle}"
                                                        EditingElementStyle="{StaticResource BoldRightAlignedEditingTextBoxStyle}">
                                                    <DataGridTextColumn.Header>
                                                        <StackPanel>
                                                            <TextBlock Text="曲げ剛性" HorizontalAlignment="Center"/>
                                                            <controls:FormulaControl Formula="EI" Style="{StaticResource FormulaControlStyle}" HorizontalAlignment="Center"/>
                                                            <TextBlock HorizontalAlignment="Center"><Run Text="(kNm"/><Run Text="2" BaselineAlignment="Superscript" FontSize="9"/><Run Text=")"/></TextBlock>
                                                        </StackPanel>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>


                                                <!-- DataGridSoilPile の Columns 内に下記の列を追加してください（適切な場所、たとえば外径やコンクリート列の後） -->
                                                <DataGridTemplateColumn Width="100">
                                                    <DataGridTemplateColumn.Header>
                                                        <TextBlock Text="杭頭タイプ" TextAlignment="Center"/>
                                                    </DataGridTemplateColumn.Header>
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding PileTopType, Mode=OneWay}" HorizontalAlignment="Center"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                    <DataGridTemplateColumn.CellEditingTemplate>
                                                        <DataTemplate>
                                                            <ComboBox SelectedItem="{Binding PileTopType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                    HorizontalAlignment="Stretch" MinWidth="80">
                                                                <ComboBoxItem Content="キャプテンパイル工法"/>
                                                                <ComboBoxItem Content="FT-Pile構法"/>
                                                                <ComboBoxItem Content="杭頭固定"/>
                                                            </ComboBox>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellEditingTemplate>
                                                </DataGridTemplateColumn>

                                                <!-- PCリング -->
                                                <DataGridTemplateColumn Header="PCリング" Width="120">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <ContentControl Visibility="{Binding PileTopType, Converter={StaticResource VisibilityConverter}, ConverterParameter='キャプテンパイル工法'}">
                                                                <ComboBox Width="100"
                                                                    HorizontalContentAlignment="Right"
                                                                    ItemsSource="{Binding DataContext.PileTop.CaptainPile.PCRingOption, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    SelectedItem="{Binding DataContext.PileTop.CaptainPile.SelectedPCRingName, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                    SelectionChanged="ComboBoxPCRingChanged"
                                                                    DropDownOpened="ComboBox_DropDownOpened"/>
                                                            </ContentControl>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                    <DataGridTemplateColumn.CellEditingTemplate>
                                                        <DataTemplate>
                                                            <ContentControl Visibility="{Binding PileTopType, Converter={StaticResource VisibilityConverter}, ConverterParameter='キャプテンパイル工法'}">
                                                                <ComboBox Width="100"
                                                                      HorizontalContentAlignment="Right"
                                                                      ItemsSource="{Binding DataContext.PileTop.CaptainPile.PCRingOption, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      SelectedItem="{Binding DataContext.PileTop.CaptainPile.SelectedPCRingName, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      SelectionChanged="ComboBoxPCRingChanged"
                                                                      DropDownOpened="ComboBox_DropDownOpened"/>
                                                            </ContentControl>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellEditingTemplate>
                                                </DataGridTemplateColumn>

                                                <!-- 絞り率ν -->
                                                <DataGridTemplateColumn Header="絞り率ν" Width="100">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <ContentControl Visibility="{Binding PileTopType, Converter={StaticResource VisibilityConverter}, ConverterParameter='キャプテンパイル工法'}">
                                                                <TextBlock Text="{Binding DataContext.PileTop.CaptainPile.Nu, RelativeSource={RelativeSource AncestorType=Window}, StringFormat={}{0:F2}}"
                                                                    HorizontalAlignment="Right" />
                                                            </ContentControl>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                    <DataGridTemplateColumn.CellEditingTemplate>
                                                        <DataTemplate>
                                                            <ContentControl Visibility="{Binding PileTopType, Converter={StaticResource VisibilityConverter}, ConverterParameter='キャプテンパイル工法'}">
                                                                <ComboBox Width="80"
                                                                      ItemsSource="{Binding DataContext.PileTop.CaptainPile.ContractionRatioOption, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      SelectedItem="{Binding DataContext.PileTop.CaptainPile.Nu, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      SelectionChanged="ComboBoxContractionRatioSelectionChanged"
                                                                      DropDownOpened="ComboBox_DropDownOpened"
                                                                      HorizontalContentAlignment="Right">
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding StringFormat={}{0:F2}}" />
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>
                                                            </ContentControl>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellEditingTemplate>
                                                </DataGridTemplateColumn>

                                                <!-- FTキャップ -->
                                                <DataGridTemplateColumn Header="FTキャップ" Width="100">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <ContentControl Visibility="{Binding PileTopType, Converter={StaticResource VisibilityConverter}, ConverterParameter='FT-Pile構法'}">
                                                                <TextBlock Text="{Binding DataContext.PileTop.SelectedFTCap, RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Center"/>
                                                            </ContentControl>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                    <DataGridTemplateColumn.CellEditingTemplate>
                                                        <DataTemplate>
                                                            <ContentControl Visibility="{Binding PileTopType, Converter={StaticResource VisibilityConverter}, ConverterParameter='FT-Pile構法'}">
                                                                <ComboBox Width="100"
