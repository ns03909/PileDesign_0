<Window x:Class="PileDesign.Views.PileTopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PileDesign.ViewModels"
        xmlns:conv="clr-namespace:PileDesign.Converters"
        xmlns:common="clr-namespace:PileDesign.Common"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        mc:Ignorable="d"
        xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
        d:DataContext="{d:DesignInstance Type=local:PileTopViewModel}"
        Title="杭頭" Height="800" Width="1200"
        Loaded="PileTopWindow_Loaded"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <!-- 追加: Ctrl+Enter で OkCommand を実行 -->
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding OkCommand}" />
        <!-- 追加: Esc で CancelCommand を実行 -->
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>
    
    <Window.Resources>
        <conv:VisibilityConverter x:Key="VisibilityConverter"/>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- DataGridCellのスタイルを定義 -->
        <!--<Style x:Key="CustomDataGridCellStyle" TargetType="DataGridCell">
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryAccentBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="White"/>
                    <Setter Property="BorderThickness" Value="0.75"/>
                </Trigger>
            </Style.Triggers>
        </Style>-->
        
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <avalonDock:DockingManager x:Name="dockingManager" Grid.Row="0">
            <avalonDock:LayoutRoot>
                <avalonDock:LayoutPanel Orientation="Horizontal" DockWidth="1.0*">
                    <avalonDock:LayoutDocumentPaneGroup Orientation="Vertical" DockWidth="0.5*">
                        <avalonDock:LayoutDocumentPane>
                            <avalonDock:LayoutAnchorable x:Name="InputTab" Title="入力" CanClose="False" CanHide="False">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="杭頭タイプ" Width="100"/>
                                        <TextBox Width="100" Text="{Binding PileTopType, UpdateSourceTrigger=PropertyChanged}"
                                            IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}"/>
                                    </StackPanel>

                                    <GroupBox Header="パイルキャップ">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Width="100" HorizontalAlignment="Right"><Run Text="F"/><Run Text="c" BaselineAlignment="Subscript" FontSize="9"/><Run Text=" (N/mm"/><Run Text="2" BaselineAlignment="Superscript" FontSize="9"/><Run Text=")"/></TextBlock>
                                                <TextBox x:Name="TextBoxPileCapFc" Width="50"
                                                         Text="{Binding PileTop.PileCapFc, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource DecimalTextBoxStyle}" common:NumericInput.Min="1" common:NumericInput.Max="200"
                                                         GotFocus="TextBox_GotFocus"
                                                         PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                         PreviewKeyDown="TextBox_PreviewKeyDown"
                                                         PreviewLostKeyboardFocus="TextBox_PreviewLostKeyboardFocus"/>
                                                <!--</StackPanel>
                                            <StackPanel Orientation="Horizontal">-->
                                                <TextBlock Width="100"  HorizontalAlignment="Right"><Run Text="γ (kN/m"/><Run Text="3" BaselineAlignment="Superscript" FontSize="9"/><Run Text=")"/></TextBlock>
                                                <TextBox x:Name="TextBoxPileCapGamma" Width="50"
                                                         Text="{Binding PileTop.PileCapGamma, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource DecimalTextBoxStyle}" common:NumericInput.Min="0.1" common:NumericInput.Max="100"
                                                         GotFocus="TextBox_GotFocus"
                                                         PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                         PreviewKeyDown="TextBox_PreviewKeyDown"
                                                         PreviewLostKeyboardFocus="TextBox_PreviewLostKeyboardFocus"/>
                                                <!--TextChanged="TextBoxPileCapGamma_TextChanged"-->
                                                <!--</StackPanel>
                                            <StackPanel Orientation="Horizontal">-->
                                                <TextBlock Width="100" HorizontalAlignment="Right"><Run Text="E"/><Run Text="c" BaselineAlignment="Subscript" FontSize="9"/><Run Text=" (N/mm"/><Run Text="2" BaselineAlignment="Superscript" FontSize="9"/><Run Text=")"/></TextBlock>
                                                <TextBox x:Name="TextBoxPileCapEc" Width="50"
                                                         Text="{Binding PileTop.PileCapEc, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:N0}'}"
                                                         IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}" 
                                                         HorizontalContentAlignment="Right"
                                                         PreviewKeyDown="TextBox_PreviewKeyDown"
                                                         PreviewLostKeyboardFocus="TextBox_PreviewLostKeyboardFocus"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </GroupBox>

                                    <GroupBox Header="定着筋工法" Visibility="{Binding PileTopType,
                                                Converter={StaticResource VisibilityConverter},
                                                ConverterParameter='定着筋工法'}">
                                        <StackPanel Visibility="{Binding PileBodyType,
                                                Converter={StaticResource VisibilityConverter},
                                                ConverterParameter='場所打ち鋼管コンクリート杭'}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="杭径"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </GroupBox>

                                    <!-- 最上部杭区間 サマリ表示: 半剛接合工法 (キャプテン / FT-Pile / キャプリング) で表示
                                         鋼管杭の場合は既存「鋼管 (最上部杭区間)」と重複するため非表示 (鋼管杭の杭径は腐食代考慮前のみなし径=ConcreteOutDia となり混乱を招く) -->
                                    <GroupBox Header="最上部杭区間">
                                        <GroupBox.Style>
                                            <Style TargetType="GroupBox">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <!-- 半剛接合 3 工法で表示候補にする -->
                                                    <DataTrigger Binding="{Binding PileTopType}" Value="キャプテンパイル工法">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PileTopType}" Value="FT-Pile構法">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PileTopType}" Value="キャプリングパイル工法">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <!-- 鋼管杭は既存「鋼管 (最上部杭区間)」 で十分 → 非表示に上書き -->
                                                    <DataTrigger Binding="{Binding PileBodyType}" Value="鋼管杭">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </GroupBox.Style>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="杭径 (mm)：" HorizontalAlignment="Right" Width="100"/>
                                                <TextBox Text="{Binding PileTop.ConcreteOutDia, StringFormat=N0}"
                                                         IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}"
                                                         Width="50" HorizontalContentAlignment="Right"/>

                                                <!-- 既製コンクリート杭: 肉厚 -->
                                                <TextBlock Text="肉厚 (mm)：" HorizontalAlignment="Right" Width="100"
                                                           Visibility="{Binding PileBodyType,
                                                                Converter={StaticResource VisibilityConverter},
                                                                ConverterParameter='既製コンクリート杭'}"/>
                                                <TextBox Text="{Binding PileTop.ConcreteThickness, StringFormat=N0}"
                                                         IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}"
                                                         Width="50" HorizontalContentAlignment="Right"
                                                         Visibility="{Binding PileBodyType,
                                                                Converter={StaticResource VisibilityConverter},
                                                                ConverterParameter='既製コンクリート杭'}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </GroupBox>

                                    <StackPanel Visibility="{Binding PileBodyType,
                                                     Converter={StaticResource VisibilityConverter},
                                                     ConverterParameter='場所打ち鋼管コンクリート杭'}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="杭径(mm)：" HorizontalAlignment="Right" Width="100"/>
                                            <TextBox Text="{Binding PileTop.ConcreteOutDia, StringFormat=N0}" HorizontalContentAlignment="Right" Width="50" IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}"/>
                                        </StackPanel>
                                        
                                        <GroupBox Header="鋼管（最上部杭区間）">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="鋼管外径(mm)×鋼管厚(mm)：" VerticalAlignment="Center"/>
                                                <TextBox Text="{Binding DisplayTopSectionPipeDia, StringFormat=N0}" HorizontalContentAlignment="Right" Width="50" IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}"/>
                                                <TextBlock Text="×" VerticalAlignment="Center"/>
                                                <TextBox Text="{Binding DisplayTopSectionPipeTs, StringFormat=N0}" HorizontalContentAlignment="Right" Width="50" IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}"/>
                                            </StackPanel>
                                        </GroupBox>

                                        <GroupBox Header="鉄筋（最上部杭区間）">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text ="本数-呼び径" Width="100" HorizontalAlignment="Right"/>
                                                    <TextBox  Text="{Binding PileTop.MainBarNum2, UpdateSourceTrigger=LostFocus}" Width="50" TextAlignment="Right"
                                                               IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}"
                                                              GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                              PreviewKeyDown="TextBox_PreviewKeyDown"
                                                              PreviewLostKeyboardFocus="TextBox_PreviewLostKeyboardFocus"/>
                                                    <TextBlock Text ="-" Width="20"  HorizontalAlignment="Center"/>
                                                    <ComboBox SelectedItem="{Binding PileTop.MainBarSize2, UpdateSourceTrigger=PropertyChanged}"
                                                              ItemsSource="{Binding PileTop.MainBarSizeOption}" Width="50" IsEnabled="False" Foreground="Gray"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text ="規格" Width="100"  HorizontalAlignment="Right"/>
                                                    <ComboBox  SelectedItem="{Binding PileTop.MainBarSpec2, UpdateSourceTrigger=PropertyChanged}"
                                                               ItemsSource="{Binding PileTop.MainBarSpecOption}" Width="100" IsEnabled="False" Foreground="Gray"/>

                                                    <TextBlock Text ="重心かぶり厚 (mm)" Width="150"  HorizontalAlignment="Right"/>
                                                    <TextBox  Text="{Binding PileTop.MainBarCenterCover2, UpdateSourceTrigger=LostFocus}" Width="50" TextAlignment="Right"
                                                              GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                              PreviewKeyDown="TextBox_PreviewKeyDown"
                                                              PreviewLostKeyboardFocus="TextBox_PreviewLostKeyboardFocus"
                                                              IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding PileBodyType,
                                                     Converter={StaticResource VisibilityConverter},
                                                     ConverterParameter='既製コンクリート杭'}">
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PileTopType}" Value="キャプリングパイル工法">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="杭径(mm)：" HorizontalAlignment="Right" Width="100"/>
                                            <TextBox Text="{Binding PileTop.ConcreteOutDia, StringFormat=N0}" HorizontalContentAlignment="Right" Width="50" IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}"/>
                                            <TextBlock Text="肉厚(mm)：" HorizontalAlignment="Right" Width="100"/>
                                            <TextBox Text="{Binding PileTop.ConcreteThickness, StringFormat=N0}" HorizontalContentAlignment="Right" Width="50" IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 鋼管杭 + 鉄筋定着工法 専用ペイン
                                         場所打ち鋼管コンクリート杭ペインと類似だが、以下が異なる:
                                           - 杭径 (= 下層 RC 径) は SteelPipePileLowerRcDiameter で自動算定 (read-only 表示)
                                           - 鉄筋(最上部杭区間) は editable (場所打ちは read-only)
                                           - 定着筋ペインは下方の共通ブロックで対応 (ConverterParameter に '鋼管杭' 追加済み) -->
                                    <StackPanel Visibility="{Binding PileBodyType,
                                                     Converter={StaticResource VisibilityConverter},
                                                     ConverterParameter='鋼管杭'}">
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PileTopType}" Value="キャプリングパイル工法">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="杭径(mm)：" HorizontalAlignment="Right" Width="100"/>
                                            <TextBox Text="{Binding PileTop.ConcreteOutDia, StringFormat=N0}" HorizontalContentAlignment="Right" Width="50" IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}"
                                                     ToolTip="最上部杭区間 (コンクリート充填鋼管部) の有効径から自動算定 (≤1200: ×1.25+100 / >1200: +200)"/>
                                        </StackPanel>

                                        <GroupBox Header="鋼管（最上部杭区間）">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="鋼管外径(mm)×鋼管厚(mm)：" VerticalAlignment="Center"/>
                                                <TextBox Text="{Binding DisplayTopSectionPipeDia, StringFormat=N0}" HorizontalContentAlignment="Right" Width="50" IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}"/>
                                                <TextBlock Text="×" VerticalAlignment="Center"/>
                                                <TextBox Text="{Binding DisplayTopSectionPipeTs, StringFormat=N0}" HorizontalContentAlignment="Right" Width="50" IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}"/>
                                            </StackPanel>
                                        </GroupBox>

                                        <!-- 鉄筋(最上部杭区間) — 鋼管杭では editable (2 重鉄筋の 1 つ目) -->
                                        <GroupBox Header="鉄筋（最上部杭区間）">
                                            <GroupBox.Style>
                                                <Style TargetType="GroupBox">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PileTopType}" Value="キャプリングパイル工法">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </GroupBox.Style>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text ="本数-呼び径" Width="100" HorizontalAlignment="Right"/>
                                                    <TextBox Text="{Binding PileTop.MainBarNum2, UpdateSourceTrigger=LostFocus}" Width="50"
                                                             Style="{StaticResource IntegerTextBoxStyle}" common:NumericInput.Min="0" common:NumericInput.Max="500"
                                                             GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                             PreviewKeyDown="TextBox_PreviewKeyDown"
                                                             PreviewLostKeyboardFocus="TextBox_PreviewLostKeyboardFocus"/>
                                                    <TextBlock Text ="-" Width="20" HorizontalAlignment="Center"/>
                                                    <ComboBox SelectedItem="{Binding PileTop.MainBarSize2, UpdateSourceTrigger=PropertyChanged}"
                                                              ItemsSource="{Binding PileTop.MainBarSizeOption}" Width="50"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text ="規格" Width="100" HorizontalAlignment="Right"/>
                                                    <ComboBox SelectedItem="{Binding PileTop.MainBarSpec2, UpdateSourceTrigger=PropertyChanged}"
                                                              ItemsSource="{Binding PileTop.MainBarSpecOption}" Width="100"/>

                                                    <TextBlock Text ="重心かぶり厚 (mm)" Width="150" HorizontalAlignment="Right"/>
                                                    <TextBox Text="{Binding PileTop.MainBarCenterCover2, UpdateSourceTrigger=LostFocus}" Width="50"
                                                             Style="{StaticResource IntegerTextBoxStyle}" common:NumericInput.Min="0" common:NumericInput.Max="1000"
                                                             GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                             PreviewKeyDown="TextBox_PreviewKeyDown"
                                                             PreviewLostKeyboardFocus="TextBox_PreviewLostKeyboardFocus"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding PileBodyType,
                                                     Converter={StaticResource VisibilityConverter},
                                                     ConverterParameter='場所打ち鋼管コンクリート杭,既製コンクリート杭,鋼管杭'}">
                                        <GroupBox Header="鉄筋（定着筋）">
                                            <GroupBox.Style>
                                                <Style TargetType="GroupBox">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <!-- 杭頭タイプが FT-Pile構法のときは非表示 -->
                                                        <DataTrigger Binding="{Binding PileTopType}" Value="FT-Pile構法">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <!-- 杭頭タイプがキャプリングパイル工法のときは非表示 (キャプリング側で独自の引張定着筋 UI を持つ) -->
                                                        <DataTrigger Binding="{Binding PileTopType}" Value="キャプリングパイル工法">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </GroupBox.Style>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text ="本数-呼び径" Width="100" HorizontalAlignment="Right"/>
                                                    <TextBox  Text="{Binding PileTop.MainBarNum1, UpdateSourceTrigger=LostFocus}" Width="50"
                                                              Style="{StaticResource IntegerTextBoxStyle}" common:NumericInput.Min="0" common:NumericInput.Max="500"
                                                              GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                              PreviewKeyDown="TextBox_PreviewKeyDown"
                                                              PreviewLostKeyboardFocus="TextBox_PreviewLostKeyboardFocus"/>
                                                    <TextBlock Text ="-" Width="20"  HorizontalAlignment="Center"/>
                                                    <ComboBox SelectedItem="{Binding PileTop.MainBarSize1, UpdateSourceTrigger=PropertyChanged}"
                                                              ItemsSource="{Binding PileTop.MainBarSizeOption}" Width="50"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text ="規格" Width="100"  HorizontalAlignment="Right"/>
                                                    <ComboBox  SelectedItem="{Binding PileTop.MainBarSpec1, UpdateSourceTrigger=PropertyChanged}"
                                                               ItemsSource="{Binding PileTop.MainBarSpecOption}" Width="100"/>

                                                    <TextBlock Text ="重心かぶり厚 (mm)" Width="150"  HorizontalAlignment="Right"/>
                                                    <TextBox  Text="{Binding PileTop.MainBarCenterCover1, UpdateSourceTrigger=LostFocus}" Width="50"
                                                              Style="{StaticResource IntegerTextBoxStyle}" common:NumericInput.Min="0" common:NumericInput.Max="1000"
                                                              GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                              PreviewKeyDown="TextBox_PreviewKeyDown"
                                                              PreviewLostKeyboardFocus="TextBox_PreviewLostKeyboardFocus"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </GroupBox>
                                        <!--<GroupBox Header="鉄筋（定着筋）">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text ="本数-呼び径" Width="100" HorizontalAlignment="Right"/>
                                                    <TextBox  Text="{Binding PileTop.MainBarNum1, UpdateSourceTrigger=LostFocus}" Width="50" TextAlignment="Right"
                                                              GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                              PreviewKeyDown="TextBox_PreviewKeyDown"
                                                              PreviewLostKeyboardFocus="TextBox_PreviewLostKeyboardFocus"/>
                                                    <TextBlock Text ="-" Width="20"  HorizontalAlignment="Center"/>
                                                    <ComboBox SelectedItem="{Binding PileTop.MainBarSize1, UpdateSourceTrigger=PropertyChanged}"
                                                              ItemsSource="{Binding PileTop.MainBarSizeOption}" Width="50"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text ="規格" Width="100"  HorizontalAlignment="Right"/>
                                                    <ComboBox  SelectedItem="{Binding PileTop.MainBarSpec1, UpdateSourceTrigger=PropertyChanged}"
                                                               ItemsSource="{Binding PileTop.MainBarSpecOption}" Width="100"/>

                                                    <TextBlock Text ="重心かぶり厚 (mm)" Width="150"  HorizontalAlignment="Right"/>
                                                    <TextBox  Text="{Binding PileTop.MainBarCenterCover1, UpdateSourceTrigger=LostFocus}" Width="50" TextAlignment="Right"
                                                              GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                              PreviewKeyDown="TextBox_PreviewKeyDown"
                                                              PreviewLostKeyboardFocus="TextBox_PreviewLostKeyboardFocus"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </GroupBox>-->

                                    </StackPanel>

                                    <!--<StackPanel  Visibility="{Binding PileBodyType,
                                          Converter={StaticResource VisibilityConverter},
                                          ConverterParameter='場所打ち鋼管コンクリート杭'}">

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text ="本数-呼び径" Width="100" HorizontalAlignment="Right"/>
                                            <TextBox  Text="{Binding PileTop.MainBarNum1, UpdateSourceTrigger=LostFocus}" Width="50" TextAlignment="Right"
                                                          GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                          PreviewKeyDown="TextBox_PreviewKeyDown"
                                                          PreviewLostKeyboardFocus="TextBox_PreviewLostKeyboardFocus"/>
                                            <TextBlock Text ="-" Width="20"  HorizontalAlignment="Center"/>
                                            <ComboBox SelectedItem="{Binding PileTop.MainBarSize1, UpdateSourceTrigger=PropertyChanged}"
                                                          ItemsSource="{Binding PileTop.MainBarSizeOption}" Width="50"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text ="規格" Width="100"  HorizontalAlignment="Right"/>
                                            <ComboBox  SelectedItem="{Binding PileTop.MainBarSpec1, UpdateSourceTrigger=PropertyChanged}"
                                                           ItemsSource="{Binding PileTop.MainBarSpecOption}" Width="100"/>

                                            <TextBlock Text ="重心かぶり厚 (mm)" Width="150"  HorizontalAlignment="Right"/>
                                            <TextBox  Text="{Binding PileTop.MainBarCenterCover1, UpdateSourceTrigger=LostFocus}" Width="50" TextAlignment="Right"
                                                          GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                          PreviewKeyDown="TextBox_PreviewKeyDown"
                                                          PreviewLostKeyboardFocus="TextBox_PreviewLostKeyboardFocus"/>
                                        </StackPanel>
                                    </StackPanel>-->


                                    <GroupBox Header="キャプテンパイル" Visibility="{Binding PileTopType,
                                                Converter={StaticResource VisibilityConverter},
                                                ConverterParameter='キャプテンパイル工法'}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="PCリング" Width="100"  HorizontalAlignment="Right"/>
                                                <ComboBox x:Name="ComboBoxPCRing" Width="100"
                                                          ItemsSource="{Binding PileTop.CaptainPile.PCRingOption}"
                                                          SelectedItem="{Binding PileTop.CaptainPile.SelectedPCRingName, UpdateSourceTrigger=PropertyChanged}"
                                                          SelectionChanged="ComboBoxPCRingChanged"  HorizontalContentAlignment="Right" DropDownOpened="ComboBox_DropDownOpened">
                                                </ComboBox>
                                                <!--</StackPanel>
                                            <StackPanel Orientation="Horizontal">-->
                                                <TextBlock Text="絞り率ν" Width="50" HorizontalAlignment="Right"/>
                                                <ComboBox x:Name="ComboBoxContractionRatio" Width="50" ItemsSource="{Binding PileTop.CaptainPile.ContractionRatioOption}"
                                                            SelectedItem="{Binding PileTop.CaptainPile.Nu, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalContentAlignment="Right"
                                                          SelectionChanged="ComboBoxContractionRatioSelectionChanged" DropDownOpened="ComboBox_DropDownOpened">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding StringFormat={}{0:F2}}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>

                                            <!-- PC リング径 ≠ 杭径 の警告 -->
                                            <TextBlock Text="{Binding RingDiameterWarning}"
                                                       Foreground="Red" FontWeight="Bold" TextWrapping="Wrap"
                                                       Margin="20,2,0,2">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RingDiameterWarning}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <CheckBox x:Name="CheckBoxHasTensionAnchors" Content= "引張定着筋"
                                                        IsChecked="{Binding PileTop.CaptainPile.CTPTensionRebars.HasTensionRebars, UpdateSourceTrigger=PropertyChanged}"
                                                              Checked="CheckBoxHasTensionAnchorsChecked" Unchecked="CheckBoxHasTensionAnchorsUnchecked"/>

                                            <GroupBox Header="引張定着筋" Visibility="{Binding ElementName=CheckBoxHasTensionAnchors, Path=IsChecked,
                                                        Converter={StaticResource BooleanToVisibilityConverter}}">

                                                <StackPanel>
                                                    <GroupBox Header="配置">
                                                        <StackPanel>
                                                            <RadioButton x:Name="RadioButtonSquare" Content="正方形配置" IsChecked="True"
                                                                         Checked="RadioButton_Checked" Unchecked="RadioButton_Unchecked"/>
                                                            <RadioButton x:Name="RadioButtonCircle" Content="円形配置" IsChecked="False"
                                                                         Checked="RadioButton_Checked" Unchecked="RadioButton_Unchecked"/>
                                                        </StackPanel>
                                                    </GroupBox>

                                                    <StackPanel Orientation="Horizontal">
                                                        <ComboBox x:Name="ComboBoxBarNumberSquare" Width="100"
                                                                ItemsSource="{Binding PileTop.CaptainPile.CTPTensionRebars.CaptainPileTensionBarNumberOption_square,
                                                            UpdateSourceTrigger=PropertyChanged}"
                                                                SelectedItem="{Binding PileTop.CaptainPile.CTPTensionRebars.SelectedBarNumberSquare}"
                                                                Visibility="Collapsed"  SelectionChanged="ComboBoxSelectionChanged" DropDownOpened="ComboBox_DropDownOpened">
                                                        </ComboBox>

                                                        <ComboBox x:Name="ComboBoxBarNumberCircle" Width="100"
                                                                ItemsSource="{Binding PileTop.CaptainPile.CTPTensionRebars.CaptainPileTensionBarNumberOption_circle,
                                                            UpdateSourceTrigger=PropertyChanged}"
                                                                SelectedItem="{Binding PileTop.CaptainPile.CTPTensionRebars.SelectedBarNumberCircle}"
                                                                Visibility="Collapsed" SelectionChanged="ComboBoxSelectionChanged" DropDownOpened="ComboBox_DropDownOpened">
                                                        </ComboBox>

                                                        <TextBlock Text="-"/>

                                                        <ComboBox x:Name="ComboBoxTensionAnchorDia" Width="100"
                                                                ItemsSource="{Binding PileTop.CaptainPile.CTPTensionRebars.TensionAnchorDiaOption}"
                                                                SelectedItem="{Binding PileTop.CaptainPile.CTPTensionRebars.SelectedTensionAnchorDia,
                                                            UpdateSourceTrigger=PropertyChanged}" SelectionChanged="ComboBoxSelectionChanged" DropDownOpened="ComboBox_DropDownOpened">
                                                        </ComboBox>
                                                        <ComboBox x:Name="ComboBoxTensionAnchoGrade" Width="100"
                                                                ItemsSource="{Binding PileTop.CaptainPile.CTPTensionRebars.TensionAnchorGradeOption}"
                                                                SelectedItem="{Binding PileTop.CaptainPile.CTPTensionRebars.SelectedTensionAnchorGrade,
                                                            UpdateSourceTrigger=PropertyChanged}" SelectionChanged="ComboBoxSelectionChanged" DropDownOpened="ComboBox_DropDownOpened">
                                                        </ComboBox>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">

                                                        <TextBlock Text="配置辺長tB (mm)" Width="150" HorizontalAlignment="Right"
                                                               Visibility="{Binding PileTop.CaptainPile.CTPTensionRebars.IsSquareArrangement,
                                                                Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        <TextBlock Text="配置直径tD (mm)" Width="150" HorizontalAlignment="Right"
                                                               Visibility="{Binding PileTop.CaptainPile.CTPTensionRebars.IsCircleArrangement,
                                                                Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        <TextBox x:Name="TextBoxTDorTB" Width="50"
                                                                 Text="{Binding PileTop.CaptainPile.CTPTensionRebars.TDorTB, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource IntegerTextBoxStyle}" common:NumericInput.Min="0" common:NumericInput.Max="10000"
                                                                 TextChanged="TextBoxTDorTBTextChanged"
                                                                 GotFocus="TextBox_GotFocus"
                                                                 PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                                                 PreviewKeyDown="TextBox_PreviewKeyDown"
                                                                 PreviewLostKeyboardFocus="TextBox_PreviewLostKeyboardFocus"/>
                                                        <TextBlock Width="150" HorizontalAlignment="Right"
                                                               Visibility="{Binding PileTop.CaptainPile.CTPTensionRebars.IsSquareArrangement,
                                                                Converter={StaticResource BooleanToVisibilityConverter}}"><Run Text="配置辺長tB"/><Run Text="max" BaselineAlignment="Subscript" FontSize="9"/><Run Text=" (mm)"/></TextBlock>
                                                        <TextBlock Width="150" HorizontalAlignment="Right"
                                                               Visibility="{Binding PileTop.CaptainPile.CTPTensionRebars.IsCircleArrangement,
                                                                Converter={StaticResource BooleanToVisibilityConverter}}"><Run Text="配置直径tD"/><Run Text="max" BaselineAlignment="Subscript" FontSize="9"/><Run Text=" (mm)"/></TextBlock>
                                                        <TextBox x:Name="TextBoxTDorTBmax" Width="50"
                                                                 Text="{Binding PileTop.CaptainPile.CTPTensionRebars.TDorTBmax, UpdateSourceTrigger=PropertyChanged}"
                                                                IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}" HorizontalAlignment="Right" 
                                                                 PreviewKeyDown="TextBox_PreviewKeyDown"
                                                                 PreviewLostKeyboardFocus="TextBox_PreviewLostKeyboardFocus"
                                                                 />
                                                    </StackPanel>
                                                </StackPanel>
                                            </GroupBox>
                                        </StackPanel>
                                    </GroupBox>

                                    <GroupBox Header="キャプリングパイル" Visibility="{Binding PileTopType,
                                                Converter={StaticResource VisibilityConverter},
                                                ConverterParameter='キャプリングパイル工法'}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="PCリング" Width="100" HorizontalAlignment="Right"/>
                                                <ComboBox x:Name="ComboBoxCapringPCRing" Width="120"
                                                          ItemsSource="{Binding PileTop.CapringPile.PCRingOption}"
                                                          SelectedItem="{Binding PileTop.CapringPile.SelectedPCRingName, UpdateSourceTrigger=PropertyChanged}"
                                                          SelectionChanged="ComboBoxCapringPCRingChanged"
                                                          HorizontalContentAlignment="Right"
                                                          DropDownOpened="ComboBox_DropDownOpened"/>
                                            </StackPanel>

                                            <!-- PC リング径 ≠ 杭径 の警告 (RingDiameterWarning が空のときは非表示) -->
                                            <TextBlock Text="{Binding RingDiameterWarning}"
                                                       Foreground="Red" FontWeight="Bold" TextWrapping="Wrap"
                                                       Margin="20,2,0,2">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RingDiameterWarning}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <CheckBox x:Name="CheckBoxCapringHasTensionBars" Content="引張定着筋"
                                                      IsChecked="{Binding PileTop.CapringPile.HasTensionBars, UpdateSourceTrigger=PropertyChanged}"
                                                      Checked="CheckBoxCapringHasTensionBarsChecked"
                                                      Unchecked="CheckBoxCapringHasTensionBarsUnchecked"/>

                                            <!-- 適用最小杭径 > 杭径 の場合の警告 (TensionBarWarning が空のときは表示なし) -->
                                            <TextBlock Text="{Binding PileTop.CapringPile.TensionBarWarning}"
                                                       Foreground="Red" FontWeight="Bold" TextWrapping="Wrap"
                                                       Margin="20,2,0,2">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PileTop.CapringPile.TensionBarWarning}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <GroupBox Header="引張定着筋" Visibility="{Binding ElementName=CheckBoxCapringHasTensionBars, Path=IsChecked,
                                                        Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="標準配筋" Width="100" HorizontalAlignment="Right"/>
                                                        <ComboBox x:Name="ComboBoxCapringTensionBar" Width="100"
                                                                  ItemsSource="{Binding PileTop.CapringPile.TensionBarOption}"
                                                                  SelectedItem="{Binding PileTop.CapringPile.SelectedTensionBarName, UpdateSourceTrigger=PropertyChanged}"
                                                                  SelectionChanged="ComboBoxCapringTensionBarChanged"
                                                                  DropDownOpened="ComboBox_DropDownOpened"/>
                                                        <TextBlock Text="鋼種" Width="40" HorizontalAlignment="Right" Margin="10,0,0,0"/>
                                                        <ComboBox x:Name="ComboBoxCapringTensionBarGrade" Width="80"
                                                                  ItemsSource="{Binding PileTop.CapringPile.TensionBarGradeOption}"
                                                                  SelectedItem="{Binding PileTop.CapringPile.TensionBarGrade, UpdateSourceTrigger=PropertyChanged}"
                                                                  SelectionChanged="ComboBoxCapringTensionBarChanged"
                                                                  DropDownOpened="ComboBox_DropDownOpened"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="配置径Dc (mm)" Width="100" HorizontalAlignment="Right"/>
                                                        <TextBox Width="50" Text="{Binding PileTop.CapringPile.EffectiveDc, Mode=OneWay, StringFormat=N0}"
                                                                 IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}" HorizontalContentAlignment="Right"
                                                                 ToolTip="3-D19 + 杭径 D ≥ 400 mm の場合は 180 mm (例外ルール)"/>
                                                        <TextBlock Text="帯筋外径 (mm)" Width="100" HorizontalAlignment="Right"/>
                                                        <TextBox Width="50" Text="{Binding PileTop.CapringPile.EffectiveHoopOutDia, Mode=OneWay, StringFormat=N0}"
                                                                 IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}" HorizontalContentAlignment="Right"
                                                                 ToolTip="3-D19 + 杭径 D ≥ 400 mm の場合は 220 mm (例外ルール)"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="定着長さ (キャップ側) 定着版あり (mm)" HorizontalAlignment="Right"/>
                                                        <TextBox Width="50" Text="{Binding PileTop.CapringPile.TensionBar.AnchorLengthCapWithPlate, StringFormat=N0}"
                                                                 IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}" HorizontalContentAlignment="Right"/>
                                                        <TextBlock Text="定着版なし (mm)" Width="100" HorizontalAlignment="Right"/>
                                                        <TextBox Width="50" Text="{Binding PileTop.CapringPile.TensionBar.AnchorLengthCapWithoutPlate, StringFormat=N0}"
                                                                 IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}" HorizontalContentAlignment="Right"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="定着長さ (杭体側) (mm)" Width="200" HorizontalAlignment="Right"/>
                                                        <TextBox Width="50" Text="{Binding PileTop.CapringPile.TensionBar.AnchorLengthPileSide, StringFormat=N0}"
                                                                 IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}" HorizontalContentAlignment="Right"/>
                                                        <TextBlock Text="適用最小杭径 (mm)" Width="120" HorizontalAlignment="Right"/>
                                                        <TextBox Width="50" Text="{Binding PileTop.CapringPile.TensionBar.MinPileDia, StringFormat=N0}"
                                                                 IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}" HorizontalContentAlignment="Right"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </GroupBox>
                                        </StackPanel>
                                    </GroupBox>

                                    <GroupBox Header="FTパイル" Visibility="{Binding PileTopType,
                                                Converter={StaticResource VisibilityConverter},
                                                ConverterParameter='FT-Pile構法'}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="FTキャップ"/>
                                                <ComboBox x:Name="ComboBoxFTCap" Width="100" HorizontalContentAlignment="Right"
                                                    ItemsSource="{Binding PileTop.FTPile.FTCapOption}"
                                                    SelectedItem="{Binding PileTop.FTPile.SelectedFTCapName, UpdateSourceTrigger=PropertyChanged}"
                                                    SelectionChanged="ComboBoxFTCapChanged" />
                                            </StackPanel>

                                            <!-- FT キャップ径 ≠ 杭径 の警告 -->
                                            <TextBlock Text="{Binding RingDiameterWarning}"
                                                       Foreground="Red" FontWeight="Bold" TextWrapping="Wrap"
                                                       Margin="20,2,0,2">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RingDiameterWarning}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <CheckBox x:Name="CheckBoxHasFTTensionAnchors" Content="引張定着筋"
                                                      IsChecked="{Binding PileTop.FTPile.FTPileTensionBars.IsTensionType, UpdateSourceTrigger=PropertyChanged}"
                                                      Checked="CheckBoxHasFTTensionAnchorsChecked" Unchecked="CheckBoxHasFTTensionAnchorsUnchecked"/>

                                            <GroupBox Header="引張定着筋" Visibility="{Binding ElementName=CheckBoxHasFTTensionAnchors, Path=IsChecked,
                                                        Converter={StaticResource BooleanToVisibilityConverter}}">

                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBox x:Name="TextBoxFTTensionNum"
                                                                 Text="{Binding PileTop.FTPile.FTPileTensionBars.TensionAnchorNum, UpdateSourceTrigger=LostFocus}"
                                                                 Width="50"
                                                                 Style="{StaticResource IntegerTextBoxStyle}" common:NumericInput.Min="0" common:NumericInput.Max="500"
                                                                 TextChanged="TextBoxFTTensionNumChanged"
                                                                 GotFocus="TextBox_GotFocus"
                                                                 PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown" PreviewKeyDown="TextBox_PreviewKeyDown"/>
                                                        <TextBlock Text="-"/>
                                                        <ComboBox x:Name="ComboBoxFTTensionBar" Width="150" HorizontalContentAlignment="Right"
                                                                ItemsSource="{Binding PileTop.FTPile.FTPileTensionBars.TensionAnchorGradeOption}"
                                                                SelectedItem="{Binding PileTop.FTPile.FTPileTensionBars.SelectedTensionAnchorGrade, UpdateSourceTrigger=LostFocus}">
                                                        </ComboBox>
                                                    </StackPanel>
                                                </StackPanel>
                                            </GroupBox>
                                        </StackPanel>
                                    </GroupBox>
                                </StackPanel>
                                </ScrollViewer>
                            </avalonDock:LayoutAnchorable>
                        </avalonDock:LayoutDocumentPane>
                        <avalonDock:LayoutDocumentPane>
                            <avalonDock:LayoutAnchorable x:Name="SpecsTab" Title="諸元" CanClose="False" CanHide="False">
                                <!--<TextBlock Text="諸元"/>-->
                                <common:EnhancedDataGrid x:Name="DrawGridSpecifications" CanUserSortColumns="False"
                                          ItemsSource="{Binding PileTop.SelectedPileTopSpecification}"
                                          AutoGenerateColumns="False"
                                          CellStyle="{StaticResource CustomDataGridCellStyle}"
                                          >

                                    <DataGrid.ContextMenu>
                                        <ContextMenu Opened="ContextMenu_Opened">
                                            <MenuItem Header="クリップボードにコピー" Click="CopyToClipboardFromContextMenu_Click" />
                                            <MenuItem Header="CSVエクスポート" Click="ExportCsvFromContextMenu_Click" />
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>

                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryAccentBrush}" />
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="項目" Width="2*" Binding="{Binding Item}" IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}"/>
                                        <DataGridTextColumn Header="記号" Width="*" Binding="{Binding Mark}" IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}"/>
                                        <DataGridTextColumn Header="値" Width="*" Binding="{Binding Value}" IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="単位" Width="*" Binding="{Binding Unit}" IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}"/>
                                    </DataGrid.Columns>
                                </common:EnhancedDataGrid>
                                <!--</StackPanel>-->
                            </avalonDock:LayoutAnchorable>
                        </avalonDock:LayoutDocumentPane>
                    </avalonDock:LayoutDocumentPaneGroup>

                    <avalonDock:LayoutDocumentPaneGroup Orientation="Vertical" DockWidth="0.5*">
                        <avalonDock:LayoutDocumentPane>
                            <avalonDock:LayoutAnchorable x:Name="TopViewTab" Title="上面図" CanClose="False" CanHide="False">
                                <Canvas x:Name="Canvas" Background="Transparent" Opacity="0.5" MouseRightButtonDown="Canvas_MouseRightButtonDown">
                                    <Canvas.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="画像コピー" Click="ImageCopyMenuItem_Click"/>
                                            <MenuItem Header="画像保存" Click="ImageSaveMenuItem_Click"/>
                                        </ContextMenu>
                                    </Canvas.ContextMenu>
                                </Canvas>
                            </avalonDock:LayoutAnchorable>
                        </avalonDock:LayoutDocumentPane>
                        <avalonDock:LayoutDocumentPane>
                            <avalonDock:LayoutAnchorable x:Name="MNInteractionPane" Title="MNインタラクション" CanClose="False" CanHide="True">
                                <!--<lvc:CartesianChart Grid.Row="1" AutoUpdateEnabled="True"
                                        Series="{Binding ChartMNSeries, UpdateSourceTrigger=PreviewLostKeyboardFocus}"
                                        XAxes="{Binding ChartNAxes, UpdateSourceTrigger=PreviewLostKeyboardFocus}"
                                        YAxes="{Binding ChartMAxes, UpdateSourceTrigger=PreviewLostKeyboardFocus}"
                                        TooltipFindingStrategy="CompareAll">
                                </lvc:CartesianChart>-->
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <ScottPlot:WpfPlot x:Name="wpfPlotMN" Grid.Row="0"/>
                                    <TextBlock Text="{Binding CrosshairPositionText_MN}" Margin="10" FontSize="14" Grid.Row="1"/>

                                </Grid>
                            </avalonDock:LayoutAnchorable>
                            <avalonDock:LayoutAnchorable x:Name="ThetaMInteractionTab" Title="θMインタラクション" CanClose="False" CanHide="False">
                                <!--<lvc:CartesianChart Grid.Row="1" AutoUpdateEnabled="True"
                                        Series="{Binding ChartThetaMSeries, UpdateSourceTrigger=PreviewLostKeyboardFocus}"
                                        XAxes="{Binding ChartThetaAxes, UpdateSourceTrigger=PreviewLostKeyboardFocus}"
                                        YAxes="{Binding ChartMAxes, UpdateSourceTrigger=PreviewLostKeyboardFocus}"
                                        LegendPosition="Right"
                                        LegendTextSize="8"
                                        TooltipFindingStrategy="CompareAll">
                                </lvc:CartesianChart>-->
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <ScottPlot:WpfPlot x:Name="wpfPlotThetaM" Grid.Row="0"/>
                                    <TextBlock Text="{Binding CrosshairPositionText_ThetaM}" Margin="10" FontSize="14" Grid.Row="1"/>

                                </Grid>
                            </avalonDock:LayoutAnchorable>
                        </avalonDock:LayoutDocumentPane>
                    </avalonDock:LayoutDocumentPaneGroup>
                </avalonDock:LayoutPanel>
            </avalonDock:LayoutRoot>
        </avalonDock:DockingManager>
        <Grid Grid.Row="1" Margin="8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ペイン最大化ボタン (左側) -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="アンドック・最大化:" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                <Button x:Name="ButtonMaximizeInput" Content="入力" Height="26" Padding="8,0" Margin="0,0,4,0"
                        ToolTip="入力ペインをアンドックして最大化 / もう一度押すと元の位置にドック"/>
                <Button x:Name="ButtonMaximizeSpecs" Content="諸元" Height="26" Padding="8,0" Margin="0,0,4,0"
                        ToolTip="諸元ペインをアンドックして最大化 / もう一度押すと元の位置にドック"/>
                <Button x:Name="ButtonMaximizeTopView" Content="上面図" Height="26" Padding="8,0" Margin="0,0,4,0"
                        ToolTip="上面図ペインをアンドックして最大化 / もう一度押すと元の位置にドック"/>
                <Button x:Name="ButtonMaximizeMN" Content="MN" Height="26" Padding="8,0" Margin="0,0,4,0"
                        ToolTip="MNインタラクションペインをアンドックして最大化 / もう一度押すと元の位置にドック"/>
                <Button x:Name="ButtonMaximizeThetaM" Content="θM" Height="26" Padding="8,0" Margin="0,0,4,0"
                        ToolTip="θMインタラクションペインをアンドックして最大化 / もう一度押すと元の位置にドック"/>
            </StackPanel>

            <!-- OK / キャンセルボタン (右側) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ButtonOk" Content="保存(_S)" HorizontalAlignment="Left"
                        VerticalAlignment="Top" Height="30" Width="150" Command="{Binding OkCommand}"
                        IsDefault="True"
                        ToolTip="変更を保存して閉じます (Enter / Ctrl+Enter / Alt+S)"/>
                <Button x:Name="ButtonCancel" Content="キャンセル(_C)" HorizontalAlignment="Left"
                        VerticalAlignment="Top" Height="30" Width="150" Command="{Binding CancelCommand}"
                        IsCancel="True"
                        ToolTip="変更を破棄して閉じます (Esc / Alt+C)"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
