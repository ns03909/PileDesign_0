                                CanUserAddRows="False"
                                CanUserSortColumns="False"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Auto"
                                Grid.Row="3"
                                Grid.Column="0"
                                common:DataGridNavigationBehavior.Enable="True"
                                Grid.ColumnSpan="2"
                                SelectionUnit="FullRow"
                                SelectionChanged="DataGridLoadDisplacement_SelecitonChanged"
                                PreviewMouseDown="DataGridLoadDisplacement_PreviewMouseDown"
                                CellStyle="{StaticResource CustomDataGridCellStyle}"
                                   ColumnHeaderStyle="{StaticResource CenterHeaderStyle}"
                                    IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}">
                            <common:EnhancedDataGrid.AlternatingRowBackground>
                                <ImageBrush/>
                            </common:EnhancedDataGrid.AlternatingRowBackground>
                            
                            <common:EnhancedDataGrid.Style>
                                <Style/>
                            </common:EnhancedDataGrid.Style>
                            
                            <!--CSVファイル出力等-->
                            <common:EnhancedDataGrid.ContextMenu>
                                <StaticResource ResourceKey="CommonDataGridContextMenu"/>
                            </common:EnhancedDataGrid.ContextMenu>
                            
