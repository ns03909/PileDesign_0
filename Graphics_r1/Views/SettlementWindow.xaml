                                        <StackPanel>
                                            <TextBlock Text="杭自重" TextAlignment="Center"/>
                                            <TextBlock Text="(kN)"
                                                TextAlignment="Center"
                                                HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <DataGridTextColumn Width="*"
                                        Binding="{Binding DD0s, StringFormat=N2, Mode=TwoWay}"
                                        MinWidth="50"
                                        ElementStyle="{StaticResource RightAlignTextBlockStyle}">
                                    <DataGridTextColumn.Header>
                                        <StackPanel>
