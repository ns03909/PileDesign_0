                                <DataGridTextColumn Width="*"
                                        Binding="{Binding PileTopLoad, StringFormat=N0, Mode=TwoWay}"
                                        MinWidth="50"
                                        ElementStyle="{StaticResource RightAlignTextBlockStyle}"
                                        HeaderStyle="{StaticResource SkyBlueHeaderStyle}">
                                    <DataGridTextColumn.Header>
                                        <StackPanel>
                                            <TextBlock Text="杭頭荷重" TextAlignment="Center"/>
                                            <TextBlock Text="(kN)"
                                                TextAlignment="Center"
                                                HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <DataGridTextColumn Width="*"
                                        Binding="{Binding RzToe, StringFormat=N0, Mode=TwoWay}"
                                        MinWidth="50"
                                        ElementStyle="{StaticResource RightAlignTextBlockStyle}"
                                        HeaderStyle="{StaticResource LineOrangeHeaderStyle}">
                                    <DataGridTextColumn.Header>
                                        <StackPanel>
                                            <TextBlock Text="杭先端支持力" TextAlignment="Center"/>
                                            <TextBlock Text="(kN)"
                                                TextAlignment="Center"
                                                HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <DataGridTextColumn Width="*"
                                        Binding="{Binding RzCircum, StringFormat=N0, Mode=TwoWay}"
                                        MinWidth="50"
                                        ElementStyle="{StaticResource RightAlignTextBlockStyle}"
                                        HeaderStyle="{StaticResource YellowHeaderStyle}">
                                    <DataGridTextColumn.Header>
                                        <StackPanel>
                                            <TextBlock Text="杭周面抵抗力" TextAlignment="Center"/>
                                            <TextBlock Text="(kN)"
                                                TextAlignment="Center"
                                                HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <DataGridTextColumn Width="*"
                                        Binding="{Binding Weight, StringFormat=N0, Mode=TwoWay}"
                                        MinWidth="50"
                                        ElementStyle="{StaticResource RightAlignTextBlockStyle}"
                                        HeaderStyle="{StaticResource LineSlateHeaderStyle}">
                                    <DataGridTextColumn.Header>
                                        <StackPanel>
                                            <TextBlock Text="杭自重" TextAlignment="Center"/>
                                            <TextBlock Text="(kN)"
                                                TextAlignment="Center"
                                                HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <DataGridTextColumn Width="*"
                                        Binding="{Binding DD0s, StringFormat=N2, Mode=TwoWay}"
                                        MinWidth="50"
                                        ElementStyle="{StaticResource RightAlignTextBlockStyle}">
                                    <DataGridTextColumn.Header>
                                        <StackPanel>
                                            <TextBlock Text="杭頭変位" TextAlignment="Center"/>
                                            <TextBlock Text="(mm)"
                                                TextAlignment="Center"
                                                HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <DataGridTextColumn Width="*"
                                        Binding="{Binding DDns, StringFormat=N2, Mode=TwoWay}"
                                        MinWidth="50"
                                        ElementStyle="{StaticResource RightAlignTextBlockStyle}">
                                    <DataGridTextColumn.Header>
                                        <StackPanel>
                                            <TextBlock Text="杭先端変位" TextAlignment="Center"/>
                                            <TextBlock Text="(mm)"
                                                TextAlignment="Center"
                                                HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                            </common:EnhancedDataGrid.Columns>
                        </common:EnhancedDataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Grid.Column="2" HorizontalAlignment="Right">
            <Button x:Name="ButtonOk" Content="保存 (Ctrl+Enter)" HorizontalAlignment="Left"
                    VerticalAlignment="Top" Height="30" Width="150" Command="{Binding OkCommand}"/>
            <Button x:Name="ButtonCancel" Content="キャンセル (Esc)" HorizontalAlignment="Left"
                    VerticalAlignment="Top" Height="30" Width="150" Command="{Binding CancelCommand}"/>
        </StackPanel>

    </Grid>
</Window>
