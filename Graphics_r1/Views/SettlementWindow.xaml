                                        <StackPanel>
                                            <TextBlock Text="杭頭荷重" TextAlignment="Center"/>
                                            <TextBlock Text="(kN)"
                                                TextAlignment="Center"
                                                HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <DataGridTextColumn Width="*"
                                        Binding="{Binding RzToe, StringFormat=N0, Mode=TwoWay}"
