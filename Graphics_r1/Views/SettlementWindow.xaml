                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                CanUserSortColumns="False"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Auto"
                                Grid.Row="3"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                SelectionChanged="DataGridLoadDisplacement_SelecitonChanged"
                                CellStyle="{StaticResource CustomDataGridCellStyle}"
                                   ColumnHeaderStyle="{StaticResource CenterHeaderStyle}"
                                    IsReadOnly="True" Foreground="Gray">
                            <common:EnhancedDataGrid.AlternatingRowBackground>
                                <ImageBrush/>
                            </common:EnhancedDataGrid.AlternatingRowBackground>
                            
                            <common:EnhancedDataGrid.Style>
                                <Style/>
                            </common:EnhancedDataGrid.Style>
                            
                            <!--CSVファイル出力等-->
                            <common:EnhancedDataGrid.ContextMenu>
                                <StaticResource ResourceKey="CommonDataGridContextMenu"/>
                            </common:EnhancedDataGrid.ContextMenu>
                            
                            <common:EnhancedDataGrid.Columns>
                                <DataGridTextColumn Width="*"
                                        Binding="{Binding PileTopLoad, StringFormat=N0, Mode=TwoWay}"
                                        MinWidth="50"
                                        ElementStyle="{StaticResource RightAlignTextBlockStyle}"
                                        HeaderStyle="{StaticResource SkyBlueHeaderStyle}">
