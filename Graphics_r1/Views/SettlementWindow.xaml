<Window x:Class="PileDesign.Views.SettlementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        xmlns:local="clr-namespace:PileDesign.ViewModels"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        d:DataContext="{d:DesignInstance Type=local:SettlementViewModel}"
        mc:Ignorable="d"
        xmlns:svg="http://sharpvectors.codeplex.com/runtime/"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        xmlns:conv="clr-namespace:PileDesign.Converters"
        xmlns:common="clr-namespace:PileDesign.Common"
        xmlns:controls="clr-namespace:WpfMath.Controls;assembly=WpfMath"
        xmlns:models="clr-namespace:PileDesign.Models"
        Title="単杭沈下" Height="600" Width="800"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <!-- 追加: Ctrl+Enter で OkCommand を実行 -->
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding OkCommand}" />
        <!-- 追加: Esc で CancelCommand を実行 -->
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- FormulaControlに適用するスタイルを定義 -->
        <Style x:Key="FormulaControlStyle" TargetType="controls:FormulaControl">
            <Setter Property="Scale" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        
        <!-- 特定の列ヘッダーの色を変更するスタイル -->
        <Style x:Key="GreenHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="{StaticResource NikkenGreenBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="YellowHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="{StaticResource NikkenYellowBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DeepBlueHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="{StaticResource NikkenDeepBlueBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PaleRedHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="{StaticResource NikkenPaleRedBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CrimsonHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="{StaticResource NikkenPaleRedBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SkyBlueHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="{StaticResource PrimaryAccentBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- グラフのライン系列専用色 (限界状態色と衝突しない) -->
        <Style x:Key="LineOrangeHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="#D2691E"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="LineSlateHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="#708090"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RightAlignTextBlockStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <!-- 共通のスタイル定義 -->
        <Style x:Key="DataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CenterHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <conv:HeightToMaxHeightConverter x:Key="HeightToMaxHeightConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:BoolToBrushConverter x:Key="BoolToBrushConverter" />
        <conv:ZElevationConverter x:Key="ZElevationConverter"/>

        <ContextMenu x:Key="CommonDataGridContextMenu" Opened="ContextMenu_Opened">
            <MenuItem Click="ExportCsvFromContextMenu_Click">
                <MenuItem.Icon>
                    <svgc:SvgViewbox Source="/Icons/CSVFileOutput.svg" Style="{StaticResource SvgIconStyle}"/>
                </MenuItem.Icon>
                <MenuItem.Header>
                    <TextBlock Text="CSVファイル出力"/>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem Header="コピー" Command="{Binding CopyDataGridSelectionCommand}"
                      CommandParameter="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </ContextMenu>
        
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ランプ群 + 一括解析ボタン -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="8" VerticalAlignment="Center" HorizontalAlignment="Left">
            <ItemsControl ItemsSource="{Binding SoilPileLampStates}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:LampState}">
                        <Button Width="18" Height="18" Margin="2" Click="SoilPileLamp_Click" ToolTip="土層-杭セットを選択">
                            <Ellipse Width="14" Height="14" Fill="{Binding IsOn, Converter={StaticResource BoolToBrushConverter}}" Stroke="Black" StrokeThickness="0.5"/>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding WarningMessage}" Foreground="Red" FontWeight="Bold" Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Visibility="{Binding HasAnyRedLamp, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <!-- Col 0: 左ペイン（ラベル・入力）— 最短でもラベルが潰れない MinWidth を保証 -->
                <ColumnDefinition Width="*" MinWidth="300" />
                <!-- Col 1: 左⇔中央スプリッタ -->
                <ColumnDefinition Width="4" />
                <!-- Col 2: 杭側面プロット -->
                <ColumnDefinition Width="*" MinWidth="120" />
                <!-- Col 3: 中央⇔右スプリッタ -->
                <ColumnDefinition Width="4" />
                <!-- Col 4: 右ペイン（結果タブ） -->
                <ColumnDefinition Width="2*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- 分割バー（ドラッグで各ペイン幅を調整可能） -->
            <GridSplitter Grid.Row="0" Grid.Column="1" Width="4"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="#DDD" ShowsPreview="True"/>
            <GridSplitter Grid.Row="0" Grid.Column="3" Width="4"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="#DDD" ShowsPreview="True"/>

            <!-- 左側のプロット (高さが足りないとき縦スクロール) -->
            <ScrollViewer Grid.Row="0" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <!-- 28,29,30: 使用/損傷/終局 限界支持力時の杭頭沈下量 -->
                    <RowDefinition Height="Auto" />
                    <!-- 上下 2 行構成 (標高/Z) のため +3 行 -->
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <!-- Col 0: ラベル（余剰を吸収して最長ラベルを表示） -->
                    <ColumnDefinition Width="*" />
                    <!-- Col 1: 数式記号（最広 R_{t,UL} 等に合わせた固定幅） -->
                    <ColumnDefinition Width="40" />
                    <!-- Col 2: 入力テキストボックス（6 桁数値 + パディングが収まる幅） -->
                    <ColumnDefinition Width="50" />
                    <!-- Col 3: 単位（最長 kN/m2） -->
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="SoilPileNo"/>

                <ComboBox Grid.Row="0" Grid.Column="2"
                          x:Name="ComboBoxSoilPileNo"

                      ItemsSource="{Binding SoilPilesCountList}"
                      SelectedValue="{Binding SoilPileNo, UpdateSourceTrigger=LostFocus}"
                      SelectionChanged = "ComboBoxSoilPileBodyNo_SelectionChanged"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="杭工法"/>
                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                         Text="{Binding SoilPile.PileConstructionType, Mode=OneWay}"
                         IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}"
                         HorizontalContentAlignment="Right"
                         ToolTip="{Binding SoilPile.PileConstructionType, Mode=OneWay}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="地盤番号"/>
                <TextBox Grid.Row="2" Grid.Column="2"
                         Text="{Binding SoilPile.GroundNo, UpdateSourceTrigger=LostFocus}"
                             HorizontalContentAlignment="Right"
                             IsReadOnly="true" Foreground="Gray"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="杭上端レベル"/>
                <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding SoilPile.Z, UpdateSourceTrigger=LostFocus}"
                             HorizontalContentAlignment="Right"
                             IsReadOnly="true" Foreground="Gray"/>
                <TextBlock Grid.Row="3" Grid.Column="3" Text="m"/>


                <TextBlock Grid.Row="4" Grid.Column="0" Text="杭体番号"/>
                <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding SoilPile.PileBodyNo, UpdateSourceTrigger=LostFocus}"
                             HorizontalContentAlignment="Right"
                             IsReadOnly="true" Foreground="Gray"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="杭体符号"/>
                <TextBox Grid.Row="5" Grid.Column="2" x:Name="TextBoxPileBodyRef"
                             Text="{Binding PileBody.PileBodyRef, UpdateSourceTrigger=LostFocus}"
                             HorizontalContentAlignment="Right"
                            IsReadOnly="true" Foreground="Gray"/>


                <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="4" Text="プリセット沈下パラメータ"/>
                <ComboBox Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="4"
                           Name="ComboBoxPresetSettlementParameters"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{Binding PileBody.PileTipSettlementPresetParameterNames}"
                            SelectionChanged = "ComboBoxPresetSettlementParameters_SelectionChanged"/>

                <TextBlock Grid.Row="8" Grid.Column="0"
                            Text="杭先端沈下曲線パラメータ"/>
                <!--<TextBlock Grid.Row="8" Grid.Column="1"
                            Text="α" HorizontalAlignment="Right"/>-->
                <controls:FormulaControl Grid.Row="8" Grid.Column="1" Formula="\alpha" Style="{StaticResource FormulaControlStyle}" HorizontalContentAlignment="Right"/>
                <TextBox Grid.Row="8" Grid.Column="2" x:Name="TextBoxSettleAlpha"
                            HorizontalContentAlignment="Right"
                            LostFocus="OnPileBodyLostFocus"
                             PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                             KeyDown="TextBox_KeyDown">
                    <Binding Path="PileBody.SettleAlpha" UpdateSourceTrigger="LostFocus" StringFormat="N2">
                        <Binding.ValidationRules>
                            <common:RangeValidationRule Min="0.05" Max="0.5" />
                        </Binding.ValidationRules>
                    </Binding>
                    <TextBox.ToolTip>
                        "適用範囲：0.05 ≦ α ≦ 0.50"
                    </TextBox.ToolTip>
                </TextBox>

                <TextBlock Grid.Row="9" Grid.Column="0" Text="杭先端沈下曲線パラメータ"/>
                <!--<TextBlock Grid.Row="9" Grid.Column="1" Text="n" HorizontalAlignment="Right"/>-->
                <controls:FormulaControl Grid.Row="9" Grid.Column="1" Formula="n" Style="{StaticResource FormulaControlStyle}" HorizontalContentAlignment="Right"/>
                <TextBox Grid.Row="9" Grid.Column="2"
                    x:Name="TextBoxSettleN"
                            HorizontalContentAlignment="Right"
                            LostFocus="OnPileBodyLostFocus"
                            PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                            KeyDown="TextBox_KeyDown">
                    <Binding Path="PileBody.SettleN" UpdateSourceTrigger="LostFocus" StringFormat="N1">
                        <Binding.ValidationRules>
                            <common:RangeValidationRule Min="1" Max="10" />
                        </Binding.ValidationRules>
                    </Binding>
                    <TextBox.ToolTip>
                        "適用範囲：1.0 ≦ α ≦ 10.0"
                    </TextBox.ToolTip>
                </TextBox>
                <TextBlock Grid.Row="10" Grid.Column="0" Text="沈下検討用杭先端径"/>
                <!--<TextBlock Grid.Row="10" Grid.Column="1" Text="dp" HorizontalAlignment="Right"/>-->
                <controls:FormulaControl Grid.Row="10" Grid.Column="1" Formula="d_p" Style="{StaticResource FormulaControlStyle}" HorizontalContentAlignment="Right"/>
                <TextBox Grid.Row="10" Grid.Column="2"
                         x:Name="TextBoxSettlePileToeDia"
                         Text="{Binding SettlePileToeDiaM, UpdateSourceTrigger=LostFocus, StringFormat=N3}"
                         Style="{StaticResource DecimalTextBoxStyle}" common:NumericInput.Min="0.01"
                         PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                         KeyDown="TextBox_KeyDown"/>
                <TextBlock Grid.Row="10" Grid.Column="3" Text="m"/>

                <!-- 杭先端閉塞率（回転貫入杭、打込み杭の場合のみ表示） -->
                <TextBlock Grid.Row="11" Grid.Column="0" Text="杭先端閉塞率"
                           Visibility="{Binding UsesPileToeEta, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBox Grid.Row="11" Grid.Column="2"
                         x:Name="TextBoxPileTipNonPermeability"
                         Text="{Binding PileBody.TipNonPermability, UpdateSourceTrigger=LostFocus}"
                         Style="{StaticResource DecimalTextBoxStyle}"
                         common:NumericInput.Min="0" common:NumericInput.Max="1"
                         LostFocus="OnPileBodyLostFocus"
                         PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                         KeyDown="TextBox_KeyDown"
                         Visibility="{Binding UsesPileToeEta, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <TextBlock Grid.Row="12" Grid.Column="0" Text="杭先端径"/>
                <!--<TextBlock Grid.Row="12" Grid.Column="1" Text="D" HorizontalAlignment="Right"/>-->
                <controls:FormulaControl Grid.Row="12" Grid.Column="1" Formula="D" Style="{StaticResource FormulaControlStyle}" HorizontalContentAlignment="Right"/>
                <TextBox Grid.Row="12" Grid.Column="2"
                         x:Name="TextBoxPileToeDiaD"
                         Text="{Binding SoilPile.D, UpdateSourceTrigger=LostFocus, StringFormat=N3}"
                         Style="{StaticResource DecimalTextBoxStyle}" common:NumericInput.Min="0.01"
                         LostFocus="OnPileBodyLostFocus"
                         PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                         KeyDown="TextBox_KeyDown"
                         PreviewLostKeyboardFocus="TextBox_PreviewLostKeyboartFocus"/>
                <TextBlock Grid.Row="12" Grid.Column="3" Text="m"/>


                <TextBlock Grid.Row="13" Grid.Column="0"
                            Text="杭先端平均N値"/>
                <!--<TextBlock Grid.Row="13" Grid.Column="1"
                                Text="Nbar" HorizontalAlignment="Right"/>-->
                <controls:FormulaControl Grid.Row="13" Grid.Column="1" Formula="\overline{N}" Style="{StaticResource FormulaControlStyle}" HorizontalContentAlignment="Right"/>
                
                <TextBox Grid.Row="13" Grid.Column="2"
                             Text="{Binding SoilPile.PileToeNValue,
                        Mode=OneWay, StringFormat=N1}" IsReadOnly="True"
                        Foreground="Gray"
                        HorizontalContentAlignment="Right"/>


                <!-- 平均N値算定範囲 上端: ラベル RowSpan=2 + 標高 / Z= の 2 サブ行 -->
                <TextBlock Grid.Row="14" Grid.RowSpan="2" Grid.Column="0"
                            Text="平均N値算定範囲 上端" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="14" Grid.Column="1" Text="標高=" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
                <TextBox Grid.Row="14" Grid.Column="2" IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}" HorizontalContentAlignment="Right" FontSize="11">
                    <TextBox.Text>
                        <MultiBinding Converter="{StaticResource ZElevationConverter}" StringFormat="{}{0:N3}" Mode="OneWay">
                            <Binding Path="SoilPile.PileToeNValueAverageRangeUpperAltitude"/>
                            <Binding Path="InputModel.FundamentalInput.ReferenceAltitude"/>
                        </MultiBinding>
                    </TextBox.Text>
                </TextBox>
                <TextBlock Grid.Row="14" Grid.Column="3" Text="m" FontSize="11" Margin="2,0,0,0"/>
                <TextBlock Grid.Row="15" Grid.Column="1" Text="Z=" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
                <TextBox Grid.Row="15" Grid.Column="2" Text="{Binding SoilPile.PileToeNValueAverageRangeUpperAltitude, Mode=OneWay, StringFormat=N3}" IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}" HorizontalContentAlignment="Right" FontSize="11"/>
                <TextBlock Grid.Row="15" Grid.Column="3" Text="m" FontSize="11" Margin="2,0,0,0"/>

                <!-- 杭先端: ラベル RowSpan=2 + 標高 / Z= -->
                <TextBlock Grid.Row="16" Grid.RowSpan="2" Grid.Column="0" Text="杭先端" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="16" Grid.Column="1" Text="標高=" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
                <TextBox Grid.Row="16" Grid.Column="2" IsReadOnly="true" Foreground="Gray" HorizontalContentAlignment="Right" FontSize="11">
                    <TextBox.Text>
                        <MultiBinding Converter="{StaticResource ZElevationConverter}" StringFormat="{}{0:N3}" Mode="OneWay">
                            <Binding Path="SoilPile.PileBottomAltitude"/>
                            <Binding Path="InputModel.FundamentalInput.ReferenceAltitude"/>
                        </MultiBinding>
                    </TextBox.Text>
                </TextBox>
                <TextBlock Grid.Row="16" Grid.Column="3" Text="m" FontSize="11" Margin="2,0,0,0"/>
                <TextBlock Grid.Row="17" Grid.Column="1" Text="Z=" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
                <TextBox Grid.Row="17" Grid.Column="2" Text="{Binding SoilPile.PileBottomAltitude, Mode=OneWay, StringFormat=N3}" IsReadOnly="true" Foreground="Gray" HorizontalContentAlignment="Right" FontSize="11"/>
                <TextBlock Grid.Row="17" Grid.Column="3" Text="m" FontSize="11" Margin="2,0,0,0"/>

                <!-- 平均N値算定範囲 下端: ラベル RowSpan=2 + 標高 / Z= -->
                <TextBlock Grid.Row="18" Grid.RowSpan="2" Grid.Column="0"
                            Text="平均N値算定範囲 下端" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="18" Grid.Column="1" Text="標高=" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
                <TextBox Grid.Row="18" Grid.Column="2" IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}" HorizontalContentAlignment="Right" FontSize="11">
                    <TextBox.Text>
                        <MultiBinding Converter="{StaticResource ZElevationConverter}" StringFormat="{}{0:N3}" Mode="OneWay">
                            <Binding Path="SoilPile.PileToeNValueAverageRangeLowerAltitude"/>
                            <Binding Path="InputModel.FundamentalInput.ReferenceAltitude"/>
                        </MultiBinding>
                    </TextBox.Text>
                </TextBox>
                <TextBlock Grid.Row="18" Grid.Column="3" Text="m" FontSize="11" Margin="2,0,0,0"/>
                <TextBlock Grid.Row="19" Grid.Column="1" Text="Z=" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
                <TextBox Grid.Row="19" Grid.Column="2" Text="{Binding SoilPile.PileToeNValueAverageRangeLowerAltitude, Mode=OneWay, StringFormat=N3}" IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}" HorizontalContentAlignment="Right" FontSize="11"/>
                <TextBlock Grid.Row="19" Grid.Column="3" Text="m" FontSize="11" Margin="2,0,0,0"/>



                <TextBlock Grid.Row="20" Grid.Column="0"
                                Text="極限先端支持力度"/>
                <controls:FormulaControl Grid.Row="20" Grid.Column="1" Formula="q_{pu}" Style="{StaticResource FormulaControlStyle}" HorizontalContentAlignment="Right"/>
                <TextBox Grid.Row="20" Grid.Column="2"
                             Text="{Binding SoilPile.Qpu, Mode=OneWay, StringFormat=N0}"
                        IsReadOnly="True"
                        Foreground="Gray"
                        HorizontalContentAlignment="Right"/>
                <TextBlock Grid.Row="20" Grid.Column="3"><Run Text="kN/m"/><Run Text="2" BaselineAlignment="Superscript" FontSize="9"/></TextBlock>

                <TextBlock Grid.Row="21" Grid.Column="0"
                                Text="沈下検討用極限先端支持力度"/>
                <controls:FormulaControl Grid.Row="21" Grid.Column="1" Formula="q_{pu(s)}" Style="{StaticResource FormulaControlStyle}" HorizontalContentAlignment="Right"/>
                <TextBox Grid.Row="21" Grid.Column="2"
                         x:Name="TextBoxSettleQpu"
                         Text="{Binding SoilPile.SettleQpu, UpdateSourceTrigger=LostFocus, StringFormat=N0}"
                         Style="{StaticResource DecimalTextBoxStyle}" common:NumericInput.Min="0"
                         LostFocus="OnPileBodyLostFocus"
                         PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                         KeyDown="TextBox_KeyDown"
                         PreviewLostKeyboardFocus="TextBox_PreviewLostKeyboartFocus"/>
                <TextBlock Grid.Row="21" Grid.Column="3"><Run Text="kN/m"/><Run Text="2" BaselineAlignment="Superscript" FontSize="9"/></TextBlock>

                <TextBlock Grid.Row="22" Grid.Column="0"
                            Text="杭先端面積"/>
                <!--<TextBlock Grid.Row="22" Grid.Column="1"
                            Text="Ap" HorizontalAlignment="Right"/>-->
                <controls:FormulaControl Grid.Row="22" Grid.Column="1" Formula="A_p" Style="{StaticResource FormulaControlStyle}" HorizontalContentAlignment="Right"/>
                <TextBox Grid.Row="22" Grid.Column="2"
                             Text="{Binding SoilPile.Ap, Mode=OneWay, StringFormat=N3}"
                        IsReadOnly="True"
                        Foreground="Gray"
                        HorizontalContentAlignment="Right"/>
                <TextBlock Grid.Row="22" Grid.Column="3"><Run Text="m"/><Run Text="2" BaselineAlignment="Superscript" FontSize="9"/></TextBlock>

                <TextBlock Grid.Row="23" Grid.Column="0"
                            Text="極限先端支持力"/>
                <!--<TextBlock Grid.Row="23" Grid.Column="1"
                            Text="Rpu" HorizontalAlignment="Right"/>-->
                <controls:FormulaControl Grid.Row="23" Grid.Column="1" Formula="R_{pu}" Style="{StaticResource FormulaControlStyle}" HorizontalContentAlignment="Right"/>
                <TextBox Grid.Row="23" Grid.Column="2"
                             Text="{Binding SoilPile.Rpu, Mode=OneWay, StringFormat=N0}"
                        IsReadOnly="True"
                        Foreground="Gray"
                        HorizontalContentAlignment="Right"/>
                <TextBlock Grid.Row="23" Grid.Column="3"
                            Text="kN"/>


                <TextBlock Grid.Row="24" Grid.Column="0" Text="極限周面抵抗力"/>
                <!--<TextBlock Grid.Row="24" Grid.Column="1" Text="Rfu" HorizontalAlignment="Right"/>-->
                <controls:FormulaControl Grid.Row="24" Grid.Column="1" Formula="R_{fu}" Style="{StaticResource FormulaControlStyle}" HorizontalContentAlignment="Right"/>

                <TextBox Grid.Row="24" Grid.Column="2"
                             Text="{Binding SoilPile.Rfu, Mode=OneWay, StringFormat=N0}" IsReadOnly="True"
                        Foreground="Gray"
                        HorizontalContentAlignment="Right"/>
                <TextBlock Grid.Row="24" Grid.Column="3" Text="kN"/>


                <TextBlock Grid.Row="25" Grid.Column="0" Text="終局限界引抜力" Foreground="{StaticResource UltimateLimitBrush}"/>
                <controls:FormulaControl Grid.Row="25" Grid.Column="1" Formula="R_{t,UL}" Style="{StaticResource FormulaControlStyle}" HorizontalContentAlignment="Right" Foreground="{StaticResource UltimateLimitBrush}"/>
                <TextBox Grid.Row="25" Grid.Column="2"
