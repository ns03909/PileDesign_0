                        HorizontalContentAlignment="Right"/>
                <TextBlock Grid.Row="26" Grid.Column="3"
                            Text="kN" Foreground="{StaticResource DamageLimitBrush}"/>

                <TextBlock Grid.Row="27" Grid.Column="0"
                            Text="使用限界引抜力" Foreground="{StaticResource ServiceLimitBrush}"/>
                <controls:FormulaControl Grid.Row="27" Grid.Column="1" Formula="R_{t,SL}" Style="{StaticResource FormulaControlStyle}" HorizontalContentAlignment="Right" Foreground="{StaticResource ServiceLimitBrush}"/>
                <TextBox Grid.Row="27" Grid.Column="2"
                             Text="{Binding SoilPile.Rt_SLS, Mode=OneWay, StringFormat=N0}" IsReadOnly="True"
                        Foreground="{StaticResource ServiceLimitBrush}"
                        HorizontalContentAlignment="Right"/>
                <TextBlock Grid.Row="27" Grid.Column="3"
                            Text="kN" Foreground="{StaticResource ServiceLimitBrush}"/>


                <TextBlock Grid.Row="28" Grid.Column="0" Text="使用限界支持力" Foreground="{StaticResource ServiceLimitBrush}"/>
                <controls:FormulaControl Grid.Row="28" Grid.Column="1" Formula="R_{SL}" Style="{StaticResource FormulaControlStyle}" HorizontalContentAlignment="Right" Foreground="{StaticResource ServiceLimitBrush}"/>
                <TextBox Grid.Row="28" Grid.Column="2"
                             Text="{Binding SoilPile.R_SLS, Mode=OneWay, StringFormat=N0}" IsReadOnly="True"
                        Foreground="{StaticResource ServiceLimitBrush}"
                        HorizontalContentAlignment="Right"/>
                <TextBlock Grid.Row="28" Grid.Column="3" Text="kN" Foreground="{StaticResource ServiceLimitBrush}"/>


                <TextBlock Grid.Row="29" Grid.Column="0" Text="損傷限界支持力" Foreground="{StaticResource DamageLimitBrush}"/>
                <controls:FormulaControl Grid.Row="29" Grid.Column="1" Formula="R_{DL}" Style="{StaticResource FormulaControlStyle}" HorizontalContentAlignment="Right" Foreground="{StaticResource DamageLimitBrush}"/>
                <TextBox Grid.Row="29" Grid.Column="2"
                             Text="{Binding SoilPile.R_DLS, Mode=OneWay, StringFormat=N0}" IsReadOnly="True"
                        Foreground="{StaticResource DamageLimitBrush}"
                        HorizontalContentAlignment="Right"/>
                <TextBlock Grid.Row="29" Grid.Column="3" Text="kN" Foreground="{StaticResource DamageLimitBrush}"/>


                <TextBlock Grid.Row="30" Grid.Column="0" Text="終局限界支持力" Foreground="{StaticResource UltimateLimitBrush}"/>
                <controls:FormulaControl Grid.Row="30" Grid.Column="1" Formula="R_{UL}" Style="{StaticResource FormulaControlStyle}" HorizontalContentAlignment="Right" Foreground="{StaticResource UltimateLimitBrush}"/>
                <TextBox Grid.Row="30" Grid.Column="2"
                             Text="{Binding SoilPile.R_ULS, Mode=OneWay, StringFormat=N0}" IsReadOnly="True"
                        Foreground="{StaticResource UltimateLimitBrush}"
                        HorizontalContentAlignment="Right"/>
                <TextBlock Grid.Row="30" Grid.Column="3" Text="kN" Foreground="{StaticResource UltimateLimitBrush}"/>

                <!-- 使用限界支持力時杭頭沈下量 -->
                <TextBlock Grid.Row="31" Grid.Column="0" Grid.ColumnSpan="2" Text="使用限界支持力時杭頭沈下量" Foreground="{StaticResource ServiceLimitBrush}"/>
                <TextBox Grid.Row="31" Grid.Column="2"
                             Text="{Binding SoilPile.SettlementAtR_SLS, Mode=OneWay, StringFormat=N1}" IsReadOnly="True"
                        Foreground="{StaticResource ServiceLimitBrush}"
                        HorizontalContentAlignment="Right"/>
                <TextBlock Grid.Row="31" Grid.Column="3" Text="mm" Foreground="{StaticResource ServiceLimitBrush}"/>

                <!-- 損傷限界支持力時杭頭沈下量 -->
                <TextBlock Grid.Row="32" Grid.Column="0" Grid.ColumnSpan="2" Text="損傷限界支持力時杭頭沈下量" Foreground="{StaticResource DamageLimitBrush}"/>
                <TextBox Grid.Row="32" Grid.Column="2"
                             Text="{Binding SoilPile.SettlementAtR_DLS, Mode=OneWay, StringFormat=N1}" IsReadOnly="True"
                        Foreground="{StaticResource DamageLimitBrush}"
                        HorizontalContentAlignment="Right"/>
                <TextBlock Grid.Row="32" Grid.Column="3" Text="mm" Foreground="{StaticResource DamageLimitBrush}"/>

                <!-- 終局限界支持力時杭頭沈下量 -->
                <TextBlock Grid.Row="33" Grid.Column="0" Grid.ColumnSpan="2" Text="終局限界支持力時杭頭沈下量" Foreground="{StaticResource UltimateLimitBrush}"/>
                <TextBox Grid.Row="33" Grid.Column="2"
                             Text="{Binding SoilPile.SettlementAtR_ULS, Mode=OneWay, StringFormat=N1}" IsReadOnly="True"
                        Foreground="{StaticResource UltimateLimitBrush}"
                        HorizontalContentAlignment="Right"/>
                <TextBlock Grid.Row="33" Grid.Column="3" Text="mm" Foreground="{StaticResource UltimateLimitBrush}"/>

                <!--<Button Grid.Row="31" Grid.Column="0" Grid.ColumnSpan="4"
                         Content="杭の荷重沈下関係解析実行" Command="{Binding ExecuteAnalysisCommand}"/>-->

            </Grid>
            </ScrollViewer>

            <Canvas x:Name="Canvas"  Grid.Row="0" Grid.Column="2" Width="Auto" Height="Auto" Background="AliceBlue"/>

            <!-- 右側のプロット -->
            <TabControl x:Name="ResultTabControl" Grid.Row="0" Grid.Column="4"
                        SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
                <!--<TabControl Grid.Row="0" Grid.Column="2" 
                        MaxHeight="{Binding RelativeSource={RelativeSource AncestorType=Window}, 
                Path=ActualHeight, 
                Converter={StaticResource HeightToMaxHeightConverter}}">-->
                <TabItem Header="杭先端沈下・杭周面抵抗力">
                    <Grid >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="杭先端沈下" FontWeight="Bold" Grid.Row="0" Grid.Column="0"/>
                        <ScottPlot:WpfPlot x:Name="wpfPlotPileToe" Grid.Row="1" Grid.Column="0" />
                        <TextBlock Text="{Binding CrosshairPositionText_PileToe}" Margin="10" FontSize="14" Grid.Row="2" Grid.Column="0"/>

                        <TextBlock Text="土層の杭周面抵抗力" FontWeight="Bold" Grid.Row="0" Grid.Column="1" />
                        <ScottPlot:WpfPlot x:Name="wpfPlotCircum" Grid.Row="1" Grid.Column="1" />
                        <TextBlock Text="{Binding CrosshairPositionText_PileCircumstance}" Margin="10" FontSize="14" Grid.Row="2" Grid.Column="1"/>

                        <common:EnhancedDataGrid x:Name="DataGridCircum" CanUserSortColumns="False"
                            Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                            ItemsSource="{Binding SoilPile.PileCircumVerticals}"
                                  SelectedItem="{Binding SelectedPileCircumstanceVertical}"
                                  AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                SelectionUnit="FullRow"
                                SelectionChanged="DataGridCircum_SelecitonChanged"
                                PreviewMouseDown="DataGridCircum_PreviewMouseDown"
                                CellStyle="{StaticResource CustomDataGridCellStyle}"
                                common:DataGridNavigationBehavior.Enable="True"
                                  ColumnHeaderStyle="{StaticResource CenterHeaderStyle}" IsReadOnly="True" Foreground="{StaticResource ReadOnlyBrush}">
                            <common:EnhancedDataGrid.AlternatingRowBackground>
                                <ImageBrush/>
                            </common:EnhancedDataGrid.AlternatingRowBackground>
                            
                            <common:EnhancedDataGrid.Style>
                                <Style/>
                            </common:EnhancedDataGrid.Style>

                            <!--CSVファイル出力等-->
                            <common:EnhancedDataGrid.ContextMenu>
                                <StaticResource ResourceKey="CommonDataGridContextMenu"/>
                            </common:EnhancedDataGrid.ContextMenu>
                            
                            <common:EnhancedDataGrid.Columns>
                                <DataGridTextColumn Width="*"
                                Binding="{Binding Top, StringFormat=N3}"
                                MinWidth="50" ElementStyle="{StaticResource RightAlignTextBlockStyle}">
                                    <DataGridTextColumn.Header>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="上端" TextAlignment="Center" />
                                            <TextBlock Text="Z" TextAlignment="Center" />
                                        </StackPanel>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <DataGridTextColumn Width="*"
                                Binding="{Binding Bottom, StringFormat=N3}"
                                MinWidth="50" ElementStyle="{StaticResource RightAlignTextBlockStyle}">
                                    <DataGridTextColumn.Header>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="下端" TextAlignment="Center" />
                                            <TextBlock Text="Z" TextAlignment="Center" />
                                        </StackPanel>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>


                                <DataGridTextColumn Width="*"
                                Binding="{Binding L, StringFormat=N3}"
                                MinWidth="50" ElementStyle="{StaticResource RightAlignTextBlockStyle}">
                                    <DataGridTextColumn.Header>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="長さ" TextAlignment="Center"/>
                                            <TextBlock Text="L" TextAlignment="Center"/>
                                            <TextBlock Text="(m)"
                                            TextAlignment="Center"
                                            HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <DataGridTextColumn Width="*"
                                Binding="{Binding Psi, StringFormat=N3}"
                                MinWidth="50" ElementStyle="{StaticResource RightAlignTextBlockStyle}">
                                    <DataGridTextColumn.Header>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="周長" TextAlignment="Center"/>
                                            <TextBlock Text="ψ" TextAlignment="Center"/>
                                            <TextBlock Text="(m)"
                                            TextAlignment="Center"
                                            HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <DataGridTextColumn Width="*"
                                Binding="{Binding PsiL, StringFormat=N3}"
                                MinWidth="50" ElementStyle="{StaticResource RightAlignTextBlockStyle}">
                                    <DataGridTextColumn.Header>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="周面" TextAlignment="Center"/>
                                            <TextBlock Text="面積" TextAlignment="Center"/>
                                            <TextBlock TextAlignment="Center"><Run Text="ψ"/><Run Text="L" BaselineAlignment="Subscript" FontSize="9"/></TextBlock>
                                            <TextBlock TextAlignment="Center" HorizontalAlignment="Center"><Run Text="(m"/><Run Text="2" BaselineAlignment="Superscript" FontSize="9"/><Run Text=")"/></TextBlock>
                                        </StackPanel>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <DataGridTextColumn Width="1.8*" MinWidth="90"
                                Binding="{Binding GroundLayer.Name}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                            <Setter Property="Margin" Value="4,2"/>
                                            <Setter Property="ToolTip" Value="{Binding GroundLayer.Name}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.Header>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="土層名" TextAlignment="Center" />
                                        </StackPanel>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Width="*" MinWidth="50">
                                    <DataGridTemplateColumn.Header>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="押込み" TextAlignment="Center"/>
                                            <TextBlock Text="周面" TextAlignment="Center" HorizontalAlignment="Center"/>
                                            <TextBlock Text="抵抗" TextAlignment="Center" HorizontalAlignment="Center"/>
                                            <TextBlock Text="考慮" TextAlignment="Center" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsPositiveCircumResistance, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Click="CircumResistanceCheckBox_Changed"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="*" MinWidth="50">
                                    <DataGridTemplateColumn.Header>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="引抜き" TextAlignment="Center"/>
                                            <TextBlock Text="周面" TextAlignment="Center" HorizontalAlignment="Center"/>
                                            <TextBlock Text="抵抗" TextAlignment="Center" HorizontalAlignment="Center"/>
                                            <TextBlock Text="考慮" TextAlignment="Center" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsNegativeCircumResistance, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Click="CircumResistanceCheckBox_Changed"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Width="*"
                                Binding="{Binding S1, StringFormat=N1}"
                                MinWidth="50" ElementStyle="{StaticResource RightAlignTextBlockStyle}">
                                    <DataGridTextColumn.Header>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock TextAlignment="Center"><Run Text="S"/><Run Text="1" BaselineAlignment="Subscript" FontSize="9"/></TextBlock>
                                            <TextBlock Text="(mm)"
                                            TextAlignment="Center"
                                            HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <DataGridTextColumn Width="*"
                                Binding="{Binding S2, StringFormat=N1}"
                                MinWidth="50" ElementStyle="{StaticResource RightAlignTextBlockStyle}">
                                    <DataGridTextColumn.Header>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock TextAlignment="Center"><Run Text="S"/><Run Text="2" BaselineAlignment="Subscript" FontSize="9"/></TextBlock>
                                            <TextBlock Text="(mm)"
                                            TextAlignment="Center"
                                            HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <DataGridTextColumn Width="*"
                                Binding="{Binding Tau1, StringFormat=N1}"
                                MinWidth="50" ElementStyle="{StaticResource RightAlignTextBlockStyle}">
                                    <DataGridTextColumn.Header>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock TextAlignment="Center"><Run Text="τ"/><Run Text="1" BaselineAlignment="Subscript" FontSize="9"/></TextBlock>
                                            <TextBlock TextAlignment="Center" HorizontalAlignment="Center"><Run Text="(kN/m"/><Run Text="2" BaselineAlignment="Superscript" FontSize="9"/><Run Text=")"/></TextBlock>
                                        </StackPanel>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <DataGridTextColumn Width="*"
                                Binding="{Binding Tau2, StringFormat=N1}"
                                MinWidth="50" ElementStyle="{StaticResource RightAlignTextBlockStyle}">
                                    <DataGridTextColumn.Header>
                                        <StackPanel>
                                            <TextBlock TextAlignment="Center"><Run Text="τ"/><Run Text="2" BaselineAlignment="Subscript" FontSize="9"/></TextBlock>
                                            <TextBlock TextAlignment="Center" HorizontalAlignment="Center"><Run Text="(kN/m"/><Run Text="2" BaselineAlignment="Superscript" FontSize="9"/><Run Text=")"/></TextBlock>
                                        </StackPanel>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <DataGridTextColumn Width="*"
                                Binding="{Binding TauT, StringFormat=N1}"
                                MinWidth="50" ElementStyle="{StaticResource RightAlignTextBlockStyle}">
                                    <DataGridTextColumn.Header>
                                        <StackPanel HorizontalAlignment="Center">

                                            <TextBlock TextAlignment="Center"><Run Text="τ"/><Run Text="T" BaselineAlignment="Subscript" FontSize="9"/></TextBlock>
                                            <TextBlock TextAlignment="Center" HorizontalAlignment="Center"><Run Text="(kN/m"/><Run Text="2" BaselineAlignment="Superscript" FontSize="9"/><Run Text=")"/></TextBlock>
                                        </StackPanel>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <DataGridTextColumn Width="*"
                                Binding="{Binding Rf, StringFormat=N1}"
                                MinWidth="50" ElementStyle="{StaticResource RightAlignTextBlockStyle}">
                                    <DataGridTextColumn.Header>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="極限" TextAlignment="Center"/>
                                            <TextBlock Text="周面" TextAlignment="Center"/>
                                            <TextBlock Text="抵抗力" TextAlignment="Center"/>
                                            <TextBlock TextAlignment="Center"><Run Text="R"/><Run Text="f" BaselineAlignment="Subscript" FontSize="9"/></TextBlock>
                                            <TextBlock Text="(kN)"
                                            TextAlignment="Center"
                                            HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                            </common:EnhancedDataGrid.Columns>
                        </common:EnhancedDataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="杭の荷重沈下解析結果　沈下曲線">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Row="0" Grid.Column="1" Content="凡例表示"
                                 IsChecked="{Binding IsSettlementLegendVisible}"
                                 HorizontalAlignment="Right" Margin="0,2,10,2"/>
                        <ScottPlot:WpfPlot  Grid.Row="1" Grid.Column="0" x:Name="wpfPlotSettlement"/>
                        <TextBlock Text="{Binding CrosshairPositionText_PileTopSettlement}" Margin="10" FontSize="14" Grid.Row="2" Grid.Column="0"/>

                        <!--<TextBlock Grid.Row="0" Grid.Column="1" Text="杭先端沈下曲線" FontWeight="Bold"/>-->
                        <ScottPlot:WpfPlot Grid.Row="1" Grid.Column="1" x:Name="wpfPlotSettlementToe"/>
                        <TextBlock Text="{Binding CrosshairPositionText_PileToeSettlement}" Margin="10" FontSize="14" Grid.Row="2" Grid.Column="1"/>

                        <common:EnhancedDataGrid x:Name="DataGridLoadDisplacement"
