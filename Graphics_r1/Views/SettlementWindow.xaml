                                        <StackPanel>
                                            <TextBlock Text="杭周面抵抗力" TextAlignment="Center"/>
                                            <TextBlock Text="(kN)"
                                                TextAlignment="Center"
                                                HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

