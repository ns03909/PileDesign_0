        <DataTemplate x:Key="DcyToolTipTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Dcy=γcyH"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text=":" HorizontalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="液状化の程度"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="0mm"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text=":" HorizontalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="なし"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="0～5mm" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text=":"  HorizontalAlignment="Center"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="軽微" />
                <TextBlock Grid.Row="3" Grid.Column="0" Text="5～10mm" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text=":" HorizontalAlignment="Center"/>
                <TextBlock Grid.Row="3" Grid.Column="2" Text="小"/>
                <TextBlock Grid.Row="4" Grid.Column="0" Text="10～20mm"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text=":"  HorizontalAlignment="Center"/>
                <TextBlock Grid.Row="4" Grid.Column="2" Text="中" />
                <TextBlock Grid.Row="5" Grid.Column="0" Text="20～40mm" />
                <TextBlock Grid.Row="5" Grid.Column="1" Text=":" HorizontalAlignment="Center"/>
                <TextBlock Grid.Row="5" Grid.Column="2" Text="大"/>
                <TextBlock Grid.Row="6" Grid.Column="0" Text="40mm～" />
                <TextBlock Grid.Row="6" Grid.Column="1" Text=":" HorizontalAlignment="Center"/>
                <TextBlock Grid.Row="6" Grid.Column="2" Text="甚大" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Vertical" Grid.Row="0" Grid.Column="0">
            <Grid>
                <Grid.ToolTip>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>  
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" SharedSizeGroup="LabelCol"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="地盤番号" HorizontalAlignment="Center" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"/>
                        <TextBlock Text="#" Grid.Row="1" Grid.Column="0"/>
                        <TextBlock Text=": 既存データ" Grid.Row="1" Grid.Column="1"/>
                        <TextBlock Text="#(New)" Grid.Row="2" Grid.Column="0"/>
                        <TextBlock Text=": 新規データ" Grid.Row="2" Grid.Column="1"/>
                    </Grid>
                </Grid.ToolTip>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol"/>
                    <!-- ラベル幅を他と揃える -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- ComboBox -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- separator -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- 削除ボタン -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- separator -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- 地盤符号ラベル -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- 地盤符号 TextBox -->
                    <ColumnDefinition Width="*" />
                    <!-- 可変スペース -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- 計算例ボタン（右端） -->
                </Grid.ColumnDefinitions>
                
                <!--<TextBlock Grid.Column="0" Text="地盤番号" Style="{StaticResource FormLabelStyle}"/>-->
                <!-- Label を使うと Alt+アクセスや Target による関連付けができる -->
                <Label Grid.Column="0" Target="{Binding ElementName=ComboBoxGroundNo}"
                        Content="_地盤番号"  VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" x:Name="ComboBoxGroundNo"
                        Style="{StaticResource FormComboBoxStyle}"
                        Width="110"
                        SelectedIndex="{Binding GroundNo, Converter={StaticResource IntToZeroBasedIndexConverter}, Mode=TwoWay}"
                        ItemsSource="{Binding GroundCountPlusOneList}"
                        SelectionChanged="ComboBoxGroundNo_SelectionChanged"
                        ToolTip="地盤番号を選択します。新規は '#(New)' と表示されます。">
                    <!-- 新規項目の色や太字を変えて視認性を向上 -->
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="#(New)">
                                    <Setter Property="Foreground" Value="DarkOrange"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>

                <!-- セパレータ -->
                <Border Grid.Column="2" Style="{StaticResource VerticalSeparatorStyle}"/>

                <!--<TextBlock Text="地盤符号"  Style="{StaticResource FormLabelStyle}"/>-->
                <Label Grid.Column="3" Target="{Binding ElementName=TextBoxGroundRef}"
                        Content="_地盤符号"  VerticalAlignment="Center"/>
                <TextBox Grid.Column="4" x:Name="TextBoxGroundRef" HorizontalAlignment="Left" Height="25" VerticalAlignment="Top" Width="100" VerticalContentAlignment="Center"
                         Text="{Binding GroundInput.GroundRef}" 
                         PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown" 
                         KeyDown="TextBox_Common_KeyDown"/>

                <!-- セパレータ -->
                <Border Grid.Column="5" Style="{StaticResource VerticalSeparatorStyle}"/>
                <Button Grid.Column="6" Content="削除" Command="{Binding GroundDeleteCommand}" Style="{StaticResource FormButtonStyle}"/>
                <!-- セパレータ -->
                <!--<Border Grid.Column="7" Style="{StaticResource VerticalSeparatorStyle}"/>-->
                
                <!--<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">-->
                <Button Grid.Column="7" x:Name="ButtonExamples"
                            Content="計算例 ▼"
                            Width="75"
                            Height="26"
                            VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                            Click="ButtonExamples_Click"
                           
                            ToolTip="計算例を選択">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="ContextMenuExamples" ItemsSource="{Binding ExampleItems}">
                                <ContextMenu.ItemContainerStyle>
                                    <Style TargetType="MenuItem" >
                                        <!-- 表示 -->
                                        <Setter Property="Header" Value="{Binding Display}" />
