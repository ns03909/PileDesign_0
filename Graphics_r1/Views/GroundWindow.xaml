                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="2" Grid.Column="1">
                        <TextBlock Text="ゆるい" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="3" Grid.Column="1">
                        <TextBlock Text="（やわらかい）" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="4" Grid.Column="1">
                        <TextBlock Text="18"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="5" Grid.Column="1">
                        <TextBlock Text="16"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="6" Grid.Column="1">
                        <TextBlock Text="14"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="7" Grid.Column="1">
                        <TextBlock Text="13"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="8" Grid.Column="1">
                        <TextBlock Text="12"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="9" Grid.Column="1">
                        <TextBlock Text="9"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="2" Grid.Column="2">
                        <TextBlock Text="密な" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="3" Grid.Column="2">
                        <TextBlock Text="（かたい）" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="4" Grid.Column="2">
                        <TextBlock Text="20"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="5" Grid.Column="2">
                        <TextBlock Text="18"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="6" Grid.Column="2">
                        <TextBlock Text="16"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="7" Grid.Column="2">
                        <TextBlock Text="15"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="8" Grid.Column="2">
                        <TextBlock Text="14"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="9" Grid.Column="2">
                        <TextBlock Text="12"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2">
                        <TextBlock Text="飽和単位体積重量" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2">
                        <TextBlock Text="（地下水位以深）" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="2" Grid.Column="3">
                        <TextBlock Text="ゆるい" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="3" Grid.Column="3">
                        <TextBlock Text="（やわらかい）" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="4" Grid.Column="3">
                        <TextBlock Text="19"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="5" Grid.Column="3">
                        <TextBlock Text="17"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="6" Grid.Column="3">
                        <TextBlock Text="15"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="7" Grid.Column="3">
                        <TextBlock Text="14"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="8" Grid.Column="3">
                        <TextBlock Text="13"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="9" Grid.Column="3">
                        <TextBlock Text="10"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="2" Grid.Column="4">
                        <TextBlock Text="密な" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="3" Grid.Column="4">
                        <TextBlock Text="（かたい）" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="4" Grid.Column="4">
                        <TextBlock Text="21"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="5" Grid.Column="4">
                        <TextBlock Text="19"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="6" Grid.Column="4">
                        <TextBlock Text="17"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="7" Grid.Column="4">
                        <TextBlock Text="16"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="8" Grid.Column="4">
                        <TextBlock Text="15"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="9" Grid.Column="4">
                        <TextBlock Text="13"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="0" Grid.Column="5" Grid.ColumnSpan="2">
                        <TextBlock Text="水中単位体積重量" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="1" Grid.Column="5" Grid.ColumnSpan="2">
                        <TextBlock Text="（地下水位以深）" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="2" Grid.Column="5">
                        <TextBlock Text="ゆるい" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="3" Grid.Column="5">
                        <TextBlock Text="（やわらかい）" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="4" Grid.Column="5">
                        <TextBlock Text="9"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="5" Grid.Column="5">
                        <TextBlock Text="7"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="6" Grid.Column="5">
                        <TextBlock Text="5"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="7" Grid.Column="5">
                        <TextBlock Text="4"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="8" Grid.Column="5">
                        <TextBlock Text="3"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="9" Grid.Column="5">
                        <TextBlock Text="0"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="2" Grid.Column="6">
                        <TextBlock Text="密な" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="3" Grid.Column="6">
                        <TextBlock Text="（かたい）" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="4" Grid.Column="6">
                        <TextBlock Text="11"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="5" Grid.Column="6">
                        <TextBlock Text="9"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="6" Grid.Column="6">
                        <TextBlock Text="7"/>
                    </Border>
                    <Border Style="{StaticResource GridCellBorderStyle}" Grid.Row="7" Grid.Column="6">
