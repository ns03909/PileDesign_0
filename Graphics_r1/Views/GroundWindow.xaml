<Window x:Class="PileDesign.Views.GroundWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PileDesign.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
        xmlns:conv="clr-namespace:PileDesign.Converters"
        d:DataContext="{d:DesignInstance Type=local:GroundLayerViewModel}"
        mc:Ignorable="d"
        Title="地盤入力" WindowState="Maximized"
        Closing="Window_Closing"
        xmlns:common="clr-namespace:PileDesign.Common"
        PreviewKeyDown="GroundWindow_PreviewKeyDown">
    
    <Window.InputBindings>
        <!-- 追加: Ctrl+Enter で OkCommand を実行 -->
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding OkCommand}" />
        <!-- 追加: Esc で CancelCommand を実行 -->
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <local:DoubleLessThanConverter x:Key="DoubleLessThanConverter"/>
        <conv:IntToZeroBasedIndexConverter x:Key="IntToZeroBasedIndexConverter"/>

        <!-- 共通フォームスタイル（Window.Resources に追加） -->
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
          <Setter Property="Width" Value="100"/>
          <Setter Property="VerticalAlignment" Value="Center"/>
          <Setter Property="Background" Value="#62B0E2"/>
          <Setter Property="Foreground" Value="White"/>
          <Setter Property="Padding" Value="6,3"/>
          <Setter Property="TextAlignment" Value="Center"/>
          <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
          <Setter Property="Height" Value="26"/>
          <Setter Property="VerticalContentAlignment" Value="Center"/>
          <Setter Property="Margin" Value="0,0,8,0"/>
          <Setter Property="MinWidth" Value="70"/>
        </Style>

        <Style x:Key="FormComboBoxStyle" TargetType="ComboBox">
          <Setter Property="Height" Value="26"/>
          <Setter Property="VerticalContentAlignment" Value="Center"/>
          <Setter Property="Margin" Value="0,0,8,0"/>
          <Setter Property="MinWidth" Value="70"/>
        </Style>

        <Style x:Key="FormButtonStyle" TargetType="Button">
          <Setter Property="Height" Value="26"/>
          <Setter Property="Padding" Value="8,3"/>
          <Setter Property="Margin" Value="0,0,8,0"/>
          <Setter Property="MinWidth" Value="70"/>
        </Style>

        <!-- 追加: セパレータ用スタイル（Window.Resources 内） -->
        <Style x:Key="VerticalSeparatorStyle" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="Background" Value="#DDDDDD"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Height" Value="28"/>
        </Style>

        <!-- 小さな横間隔を統一するための簡易スタイル -->
        <Style x:Key="SmallRightMargin" TargetType="FrameworkElement">
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        
        <!-- GranularityClassComboBoxのスタイルを定義 -->
        <Style x:Key="AgeCategoryComboBoxStyle" TargetType="ComboBox">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedItem, RelativeSource={RelativeSource Self}}" Value="沖積層">
                    <Setter Property="Foreground" Value="DarkSlateGray"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedItem, RelativeSource={RelativeSource Self}}" Value="洪積層">
                    <Setter Property="Foreground" Value="Black"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- AgeCategoryTextBlockStyleの定義 -->
        <Style x:Key="AgeCategoryTextBlockStyle" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding AgeCategory}" Value="沖積層">
                    <Setter Property="Foreground" Value="DarkSlateGray"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding AgeCategory}" Value="洪積層">
                    <Setter Property="Foreground" Value="Black"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- GranularityClassTextBlockStyleの定義 -->
        <Style x:Key="GranularityClassTextBlockStyle" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding GranularityClass}" Value="粘性土">
                    <Setter Property="Foreground" Value="SaddleBrown"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding GranularityClass}" Value="砂質土">
                    <Setter Property="Foreground" Value="SandyBrown"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding GranularityClass}" Value="礫質土">
                    <Setter Property="Foreground" Value="DarkGreen"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- GranularityClassComboBoxのスタイルを定義 -->
        <Style x:Key="GranularityClassComboBoxStyle" TargetType="ComboBox">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedValue, RelativeSource={RelativeSource Self}}" Value="粘性土">
                    <Setter Property="Foreground" Value="SaddleBrown"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedValue, RelativeSource={RelativeSource Self}}" Value="砂質土">
                    <Setter Property="Foreground" Value="SandyBrown"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedValue, RelativeSource={RelativeSource Self}}" Value="礫質土">
                    <Setter Property="Foreground" Value="DarkGreen"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ShallowSoilType 用スタイル -->
        <Style x:Key="ShallowSoilTypeComboBoxStyle" TargetType="ComboBox">
            <!--<Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0,4,0"/>-->
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedValue, RelativeSource={RelativeSource Self}}" Value="粘性土">
                    <Setter Property="Foreground" Value="DarkRed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedValue, RelativeSource={RelativeSource Self}}" Value="砂質土">
                    <Setter Property="Foreground" Value="DarkOrange"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="RightAlignTextBlockStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <!-- 共通のスタイル定義 -->
        <Style x:Key="DataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 特定の列ヘッダーの色を変更するスタイル -->
        <Style x:Key="GreenHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="#238966"/>
        </Style>
        <Style x:Key="YellowHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="#F7B515"/>
        </Style>
        <Style x:Key="DeepBlueHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="#3271AD"/>
        </Style>
        <Style x:Key="PaleRedHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="#E95541"/>
        </Style>
        <Style x:Key="CrimsonHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="#D82531"/>
        </Style>

        <Style x:Key="GrayCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="IsEnabled" Value="False"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ErrorCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource CustomDataGridCellStyle}">
            <Style.Triggers>

                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Background" Value="Red"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GridCellBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="DarkGray"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

