                                                <Border Grid.Row="4" Grid.Column="1" Padding="10,4" BorderBrush="#CCC" BorderThickness="1,0,1,1"><TextBlock Text="大"/></Border>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </StackPanel>
                        </StackPanel>
