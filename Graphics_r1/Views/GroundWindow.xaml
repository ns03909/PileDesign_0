                                </Grid>
                            </avalonDock:LayoutAnchorable>

                            <avalonDock:LayoutAnchorable x:Name="CuValueTab" Title="粘着力" CanClose="False" CanHide="False">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <ToolBar Grid.Row="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="内容" HorizontalAlignment="Left" Height="25" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ToolBar>

                                    <ScottPlot:WpfPlot x:Name="wpfPlotCu" Grid.Row="1"/>

                                </Grid>
                            </avalonDock:LayoutAnchorable>

                            <avalonDock:LayoutAnchorable x:Name="VsValueTab" Title="S波速度" CanClose="False" CanHide="False">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <ToolBar Grid.Row="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="内容" HorizontalAlignment="Left" Height="25" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ToolBar>

                                    <ScottPlot:WpfPlot x:Name="wpfPlotVs" Grid.Row="1"/>

                                </Grid>
                            </avalonDock:LayoutAnchorable>

                            <avalonDock:LayoutAnchorable x:Name="EsValueTab" Title="変形係数" CanClose="False" CanHide="False">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <ToolBar Grid.Row="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="内容" HorizontalAlignment="Left" Height="25" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ToolBar>

                                    <ScottPlot:WpfPlot x:Name="wpfPlotEs" Grid.Row="1"/>

                                </Grid>
                            </avalonDock:LayoutAnchorable>

                            <avalonDock:LayoutAnchorable x:Name="CustomDispTab" Title="任意地盤変位" CanClose="False" CanHide="False">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 全ケース一括コピーボタン (4 ケース共通の自動計算値を一気に流し込む) -->
                                    <Button Grid.Row="0" Content="基礎指針'19 4.5 自動計算を全ケースにコピー"
                                            Margin="4,4,4,2" Padding="8,4" HorizontalAlignment="Stretch"
                                            Click="CustomDispCopyAutoAll_Click"
                                            ToolTip="基礎指針2019 4.5節の自動計算結果 (土質点ごとの DmaxU* または DmaxU*+ΣγcyH) を、4 ケース全て (L1 非液状化 / L1 液状化 / L2 非液状化 / L2 液状化) に一括コピーします&#x0a;※既存データはクリアされます"/>

                                    <ComboBox Grid.Row="1" x:Name="CustomDispCaseCombo" Margin="4"
                                              ItemsSource="{Binding CustomDispCaseOptions}"
                                              SelectedIndex="{Binding SelectedCustomDispCaseIndex, Mode=TwoWay}"
                                              SelectionChanged="CustomDispCase_SelectionChanged"/>

                                    <WrapPanel Grid.Row="2" Margin="4,0,4,4">
                                        <Button Content="行追加" Padding="8,2" Margin="0,0,4,2"
                                                Click="CustomDispAddRow_Click"
                                                ToolTip="末尾に新しい行を追加"/>
                                        <Button Content="選択行下行追加" Padding="8,2" Margin="0,0,4,2"
                                                Click="CustomDispInsertBelowRow_Click"
                                                ToolTip="選択行の下に新しい行を挿入"/>
                                        <Button Content="選択行削除" Padding="8,2" Margin="0,0,4,2"
                                                Click="CustomDispDeleteRow_Click"/>
                                        <Button Content="全削除" Padding="8,2" Margin="0,0,4,2"
                                                Click="CustomDispClearAll_Click"/>
                                        <Button Content="標高整列" Padding="8,2" Margin="0,0,4,2"
                                                Click="CustomDispSortAndDedupe_Click"
                                                ToolTip="標高Zの重複を削除し、上から単調減少するように並び替えます"/>
                                        <Separator Margin="4,0,4,0" Width="1" Background="#CCC"/>
                                        <!-- 変位係数スケーラー: スライダーで 0~2.0 倍を選び、適用ボタンで現状の変位値に乗算する -->
                                        <TextBlock Text="変位係数" VerticalAlignment="Center" Margin="0,0,4,2"/>
                                        <Slider x:Name="SliderCustomDispScale" Width="120" Minimum="0" Maximum="2" Value="1"
                                                TickFrequency="0.1" TickPlacement="BottomRight" IsSnapToTickEnabled="False"
                                                VerticalAlignment="Center" Margin="0,0,4,2"
                                                ToolTip="現在のケースの変位値に乗ずる係数 (0 ~ 2.0)。「適用」ボタンで反映"/>
                                        <TextBox x:Name="TextBoxCustomDispScale" Width="50" VerticalAlignment="Center" Margin="0,0,4,2"
                                                 HorizontalContentAlignment="Right"
                                                 Text="{Binding ElementName=SliderCustomDispScale, Path=Value, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Content="適用" Padding="8,2" Margin="0,0,4,2"
                                                Click="CustomDispApplyScale_Click"
                                                ToolTip="現在表示中のケースの全変位値にスライダー値を乗算します。&#x0a;適用後スライダーは 1.0 にリセット。&#x0a;Undo (Ctrl+Z) で元に戻せます。"/>
                                    </WrapPanel>

                                    <common:EnhancedDataGrid x:Name="DataGridCustomDisplacement" CanUserSortColumns="False" Grid.Row="3"
                                        ItemsSource="{Binding SelectedCustomDispProfile}"
                                        CellEditEnding="CustomDispDataGrid_CellEditEnding"
                                        PasteCompleted="CustomDispDataGrid_PasteCompleted"
                                        AutoGenerateColumns="False"
                                        CanUserAddRows="False"
                                        CanUserDeleteRows="False"
                                        HeadersVisibility="All"
                                        RowHeaderWidth="30"
                                        GridLinesVisibility="All"
                                        HorizontalGridLinesBrush="{StaticResource SurfaceBorderBrush}"
                                        VerticalGridLinesBrush="{StaticResource SurfaceBorderBrush}"
                                        LoadingRow="DataGrid_LoadingRow_Numbering"
                                        ToolTip="Excelから標高(m)・変位(mm)の2列をコピーしてCtrl+Vでペースト可能">
                                        <common:EnhancedDataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            </Style>
                                        </common:EnhancedDataGrid.ColumnHeaderStyle>
                                        <common:EnhancedDataGrid.Columns>
                                            <DataGridTextColumn Width="*" MinWidth="100">
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="標高 Z" TextAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                                        <TextBlock Text="(m)" TextAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                                    </StackPanel>
                                                    
                                                </DataGridTextColumn.Header>
                                                <DataGridTextColumn.Binding>
                                                    <Binding Path="Z" StringFormat="N3" UpdateSourceTrigger="LostFocus"/>
                                                </DataGridTextColumn.Binding>
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                        <Setter Property="Padding" Value="4,2"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                                <DataGridTextColumn.EditingElementStyle>
                                                    <Style TargetType="TextBox">
                                                        <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                                    </Style>
                                                </DataGridTextColumn.EditingElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Width="*" MinWidth="100">
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="変位" TextAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                                        <TextBlock Text="(mm)" TextAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                                    </StackPanel>
                                                </DataGridTextColumn.Header>
                                                <DataGridTextColumn.Binding>
                                                    <Binding Path="Displacement" StringFormat="N2" UpdateSourceTrigger="LostFocus"/>
                                                </DataGridTextColumn.Binding>
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                        <Setter Property="Padding" Value="4,2"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                                <DataGridTextColumn.EditingElementStyle>
                                                    <Style TargetType="TextBox">
                                                        <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                                    </Style>
                                                </DataGridTextColumn.EditingElementStyle>
                                            </DataGridTextColumn>
                                        </common:EnhancedDataGrid.Columns>
                                    </common:EnhancedDataGrid>

                                    <StackPanel Grid.Row="4" Margin="4,4">
                                        <TextBlock Foreground="#888" FontSize="11" TextWrapping="Wrap"
                                                   Text="※任意地盤変位を適用するには、「地盤変位」タブ中「地盤変位」で「任意入力」を選択してください。"/>
                                        <TextBlock Foreground="#888" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Text="※データ作成に関する注意&#x0a;土質点入力範囲をカバーする標高Z範囲のデータが必要です。"/>
                                        <Border Margin="0,4,0,0" Padding="4" Background="#FFF3E0" BorderBrush="#FF9800" BorderThickness="1" CornerRadius="3"
                                                Visibility="{Binding HasCustomDispWarnings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <TextBlock Text="⚠ Warning" FontWeight="Bold" Foreground="{StaticResource StatusWarningDarkBrush}" FontSize="12"/>
                                                <TextBlock Text="{Binding CustomDispWarnings}" Foreground="#BF360C" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </avalonDock:LayoutAnchorable>

                        </avalonDock:LayoutDocumentPane>

                        <avalonDock:LayoutDocumentPane>
                            <avalonDock:LayoutAnchorable x:Name="DefTab" Title="地盤変位" CanClose="False" CanHide="False">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <ToolBar Grid.Row="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="内容" HorizontalAlignment="Left" Height="25" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="ComboBoxChartDispContent"
                                                SelectedValue="{Binding ChartDispContent, UpdateSourceTrigger=PropertyChanged}"
                                                ItemsSource ="{Binding ChartDispContentOption}" VerticalAlignment="Center" Height="25" Width="200"
                                                SelectionChanged="GroundComboBox_SelectionChanged"/>
                                        </StackPanel>
                                    </ToolBar>

                                    <ScottPlot:WpfPlot x:Name="wpfPlotDisplacement" Grid.Row="1"/>

                                </Grid>
                            </avalonDock:LayoutAnchorable>
                            <avalonDock:LayoutAnchorable x:Name="FsTab" Title="液状化安全率" CanClose="False" CanHide="False">

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <ToolBar Grid.Row="0">
                                        <StackPanel Orientation="Horizontal">
                                            <!--<Expander Content="FLが1以下となる土層は液状化発生の可能性がある"/>-->
                                            <TextBlock Text="内容" HorizontalAlignment="Left" Height="25" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="ComboBoxChartFLContent" SelectedValue="{Binding ChartFLContent, UpdateSourceTrigger=PropertyChanged}"
                                        ItemsSource ="{Binding ChartFLContentOption}" VerticalAlignment="Center" Height="25" Width="200"
                                        SelectionChanged="GroundComboBox_SelectionChanged"/>
                                        </StackPanel>
                                    </ToolBar>

                                    <ScottPlot:WpfPlot x:Name="wpfPlotFL" Grid.Row="1"/>

                                </Grid>
                            </avalonDock:LayoutAnchorable>

                            <avalonDock:LayoutAnchorable x:Name="SaTab" Title="応答スペクトル" CanClose="False" CanHide="False">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 固有値解析結果: T1, T2, β, ξe, αE, Gs1, Gs2 (収束後) — レベルごと 2 行表示 -->
                                    <StackPanel Grid.Row="0" Orientation="Vertical" Margin="4,2">
                                        <!-- Level 1 -->
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="L1: " VerticalAlignment="Center" FontWeight="Bold" Margin="2,0"/>
                                            <TextBlock VerticalAlignment="Center" Margin="2,0"><Run Text="T"/><Run Text="1" BaselineAlignment="Subscript" FontSize="9"/><Run Text="="/></TextBlock>
                                            <TextBlock Text="{Binding GroundInput.NaturalPeriods[0], StringFormat='{}{0:F3}s'}" VerticalAlignment="Center" FontWeight="Bold" Margin="2,0"/>
                                            <TextBlock VerticalAlignment="Center" Margin="6,0,2,0"><Run Text="T"/><Run Text="2" BaselineAlignment="Subscript" FontSize="9"/><Run Text="="/></TextBlock>
                                            <TextBlock Text="{Binding GroundInput.T2Levels[0], StringFormat='{}{0:F3}s'}" VerticalAlignment="Center" FontWeight="Bold" Margin="2,0"/>
                                            <TextBlock Text=" β=" VerticalAlignment="Center" Margin="6,0,2,0"/>
                                            <TextBlock Text="{Binding GroundInput.BetaLevels[0], StringFormat='{}{0:F3}'}" VerticalAlignment="Center" FontWeight="Bold" Margin="2,0"/>
                                            <TextBlock VerticalAlignment="Center" Margin="6,0,2,0"><Run Text=" ξ"/><Run Text="e" BaselineAlignment="Subscript" FontSize="9"/><Run Text="="/></TextBlock>
                                            <TextBlock Text="{Binding GroundInput.XiELevels[0], StringFormat='{}{0:F3}'}" VerticalAlignment="Center" FontWeight="Bold" Margin="2,0"/>
                                            <TextBlock VerticalAlignment="Center" Margin="6,0,2,0"><Run Text=" α"/><Run Text="E" BaselineAlignment="Subscript" FontSize="9"/><Run Text="="/></TextBlock>
                                            <TextBlock Text="{Binding GroundInput.ImpedanceLevels[0], StringFormat='{}{0:F3}'}" VerticalAlignment="Center" FontWeight="Bold" Margin="2,0"/>
                                            <TextBlock Text=" Gs1=" VerticalAlignment="Center" Margin="6,0,2,0"/>
                                            <TextBlock Text="{Binding GroundInput.Gs1Levels[0], StringFormat='{}{0:F2}'}" VerticalAlignment="Center" FontWeight="Bold" Margin="2,0"/>
                                            <TextBlock Text=" Gs2=" VerticalAlignment="Center" Margin="6,0,2,0"/>
                                            <TextBlock Text="{Binding GroundInput.Gs2Levels[0], StringFormat='{}{0:F2}'}" VerticalAlignment="Center" FontWeight="Bold" Margin="2,0"/>
                                        </StackPanel>
                                        <!-- Level 2 -->
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="L2: " VerticalAlignment="Center" FontWeight="Bold" Margin="2,0"/>
                                            <TextBlock VerticalAlignment="Center" Margin="2,0"><Run Text="T"/><Run Text="1" BaselineAlignment="Subscript" FontSize="9"/><Run Text="="/></TextBlock>
                                            <TextBlock Text="{Binding GroundInput.NaturalPeriods[1], StringFormat='{}{0:F3}s'}" VerticalAlignment="Center" FontWeight="Bold" Margin="2,0"/>
                                            <TextBlock VerticalAlignment="Center" Margin="6,0,2,0"><Run Text="T"/><Run Text="2" BaselineAlignment="Subscript" FontSize="9"/><Run Text="="/></TextBlock>
                                            <TextBlock Text="{Binding GroundInput.T2Levels[1], StringFormat='{}{0:F3}s'}" VerticalAlignment="Center" FontWeight="Bold" Margin="2,0"/>
                                            <TextBlock Text=" β=" VerticalAlignment="Center" Margin="6,0,2,0"/>
                                            <TextBlock Text="{Binding GroundInput.BetaLevels[1], StringFormat='{}{0:F3}'}" VerticalAlignment="Center" FontWeight="Bold" Margin="2,0"/>
                                            <TextBlock VerticalAlignment="Center" Margin="6,0,2,0"><Run Text=" ξ"/><Run Text="e" BaselineAlignment="Subscript" FontSize="9"/><Run Text="="/></TextBlock>
                                            <TextBlock Text="{Binding GroundInput.XiELevels[1], StringFormat='{}{0:F3}'}" VerticalAlignment="Center" FontWeight="Bold" Margin="2,0"/>
                                            <TextBlock VerticalAlignment="Center" Margin="6,0,2,0"><Run Text=" α"/><Run Text="E" BaselineAlignment="Subscript" FontSize="9"/><Run Text="="/></TextBlock>
                                            <TextBlock Text="{Binding GroundInput.ImpedanceLevels[1], StringFormat='{}{0:F3}'}" VerticalAlignment="Center" FontWeight="Bold" Margin="2,0"/>
                                            <TextBlock Text=" Gs1=" VerticalAlignment="Center" Margin="6,0,2,0"/>
                                            <TextBlock Text="{Binding GroundInput.Gs1Levels[1], StringFormat='{}{0:F2}'}" VerticalAlignment="Center" FontWeight="Bold" Margin="2,0"/>
                                            <TextBlock Text=" Gs2=" VerticalAlignment="Center" Margin="6,0,2,0"/>
                                            <TextBlock Text="{Binding GroundInput.Gs2Levels[1], StringFormat='{}{0:F2}'}" VerticalAlignment="Center" FontWeight="Bold" Margin="2,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <ScottPlot:WpfPlot x:Name="wpfPlotResponseSpectrum" Grid.Row="1"/>
                                </Grid>
                            </avalonDock:LayoutAnchorable>
                        </avalonDock:LayoutDocumentPane>
                    </avalonDock:LayoutDocumentPaneGroup>
                </avalonDock:LayoutPanel>
            </avalonDock:LayoutRoot>
        </avalonDock:DockingManager>

        <Grid Grid.Row="2" Margin="8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ペイン最大化ボタン (左側): 左 2 タブはアンドック+最大化 / 右ペインは幅トグル -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="アンドック・最大化:" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                <Button x:Name="ButtonMaximizeGroundLayer" Content="土層入力" Height="26" Padding="8,0" Margin="0,0,4,0"
                        ToolTip="土層入力ペインをアンドックして最大化 / もう一度押すと元の位置にドック"/>
                <Button x:Name="ButtonMaximizeGroundMass" Content="土質点入力" Height="26" Padding="8,0" Margin="0,0,4,0"
                        ToolTip="土質点入力ペインをアンドックして最大化 / もう一度押すと元の位置にドック"/>
                <Button x:Name="ButtonToggleRightMaximize" Content="グラフ" Height="26" Padding="8,0" Margin="0,0,8,0"
                        ToolTip="グラフペイン (N値 / 粘着力 / S波速度 / 変形係数 / 任意地盤変位 / 地盤変位 / 液状化安全率 / 応答スペクトル) を最大化 / 元に戻す"
                        Click="ButtonToggleRightMaximize_Click"/>
            </StackPanel>

            <!-- OK / キャンセルボタン (右側) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ButtonOk" Content="保存(_S)" HorizontalAlignment="Left"
                        VerticalAlignment="Top" Height="30" Width="150" Command="{Binding OkCommand}"
                        IsDefault="True"
                        ToolTip="変更を保存して閉じます (Enter / Ctrl+Enter / Alt+S)"/>
                <Button x:Name="ButtonCancel" Content="キャンセル(_C)" HorizontalAlignment="Left"
                        VerticalAlignment="Top" Height="30" Width="150" Command="{Binding CancelCommand}"
                        IsCancel="True"
                        ToolTip="変更を破棄して閉じます (Esc / Alt+C)"/>
            </StackPanel>
        </Grid>

        <!-- グラフ上のマーカー近傍にマウスを置いた時、最近接マーカーの詳細を表示するポップアップ -->
        <Popup x:Name="GroundHoverPopup"
               Placement="Relative" AllowsTransparency="True" StaysOpen="False">
            <Border Background="#F8FFFFFF" BorderBrush="#888" BorderThickness="1" Padding="6" CornerRadius="2">
                <TextBlock x:Name="GroundHoverText" FontSize="11" TextWrapping="Wrap" MaxWidth="320"/>
            </Border>
        </Popup>
    </Grid>
</Window>