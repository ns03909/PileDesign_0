                                        <StackPanel MaxWidth="500">
                                            <TextBlock FontWeight="Bold" Text="液状化指標 PL (岩崎ら 1982)"/>
                                            <TextBlock Margin="0,4,0,0">
                                                <Run Text="PL = Σ F(z)·W(z)·H"/><LineBreak/>
                                                <Run Text="  F(z) = max(0, 1 − FL)　液状化危険度の重み"/><LineBreak/>
                                                <Run Text="  W(z) = max(0, 10 − 0.5z)　深さの重み (z はGL深さ m)"/><LineBreak/>
                                                <Run Text="  H    = 土質点の有効厚 (m)"/><LineBreak/>
                                                <Run Text="  深さ z ∈ [0, 20m] のみ算入"/>
                                            </TextBlock>
                                            <TextBlock Margin="0,8,0,0" FontWeight="Bold" Text="判定目安"/>
                                            <TextBlock>
                                                <Run Text="PL = 0       液状化危険度なし"/><LineBreak/>
                                                <Run Text="0 &lt; PL ≤ 5   軽微"/><LineBreak/>
                                                <Run Text="5 &lt; PL ≤ 15  中程度"/><LineBreak/>
                                                <Run Text="15 &lt; PL      大"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </TextBox.ToolTip>
                                </TextBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
