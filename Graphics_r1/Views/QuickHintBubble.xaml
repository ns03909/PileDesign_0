<UserControl x:Class="PileDesign.Views.QuickHintBubble"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="Auto" Height="Auto"
             Background="Transparent">
    <Grid Margin="6">
        <!-- シャドウのため余白を確保 -->
        <!-- 角丸矩形 + シャドウ（これが影本体） -->
        <Rectangle RadiusX="8" RadiusY="8"
                   Fill="{Binding BubbleBackground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   SnapsToDevicePixels="True">
            <Rectangle.Effect>
                <DropShadowEffect Color="#44000000" BlurRadius="8" ShadowDepth="3" Opacity="0.6" RenderingBias="Quality"/>
            </Rectangle.Effect>
        </Rectangle>

        <!-- コンテンツは上に重ね、角丸で内部をクリップする場合は Border を使う -->
        <Border Background="Transparent" CornerRadius="8" Padding="10">
            <StackPanel Orientation="Vertical" MaxWidth="420" MinWidth="200">
                <TextBlock x:Name="PART_Title"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="{Binding BubbleForeground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Margin="0,0,0,2"
                           Opacity="0.8"
                           TextTrimming="CharacterEllipsis"
                           FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ContentPresenter Content="{Binding ExtraContent, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  Margin="0,0,0,6">
                    <ContentPresenter.Style>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ExtraContent, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentPresenter.Style>
                </ContentPresenter>

                <TextBlock Text="{Binding HintText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="{Binding BubbleForeground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           TextWrapping="Wrap"
                           Opacity="0.8"
                           FontSize="16"
                           FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                <TextBlock x:Name="PART_Footer"
                           Text=""
                           Foreground="{Binding BubbleForeground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="11"
                           Opacity="0.8"
                           Margin="0,8,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>