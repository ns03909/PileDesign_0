<UserControl x:Class="PileDesign.Views.QuickHintBubble"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="Auto" Height="Auto">
    <Grid>
        <Border Background="{Binding BubbleBackground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                BorderBrush="{Binding BubbleBackground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                BorderThickness="0"
                CornerRadius="8"
                Padding="2"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect Color="#44000000" BlurRadius="3" ShadowDepth="2" Opacity="0.6"/>
            </Border.Effect>

            <StackPanel Orientation="Vertical" MaxWidth="420" MinWidth="200">
                <!-- タイトル行（自分のスタイルで非表示制御） -->
                <TextBlock x:Name="PART_Title"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="{Binding BubbleForeground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="12"
                           Margin="0,0,0,2"
                           Opacity="0.8"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- ExtraContent（個別で非表示制御） -->
                <ContentPresenter Content="{Binding ExtraContent, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  Margin="0,0,0,6">
                    <ContentPresenter.Style>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ExtraContent, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentPresenter.Style>
                </ContentPresenter>

                <!-- 本文 -->
                <TextBlock Text="{Binding HintText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="{Binding BubbleForeground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           TextWrapping="Wrap"
                           LineHeight="18"
                           Opacity="0.8"
                           FontSize="12"/>

                <TextBlock x:Name="PART_Footer"
                           Text=""
                           Foreground="{Binding BubbleForeground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="11"
                           Opacity="0.8"
                           Margin="0,8,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>