<UserControl x:Class="PileDesign.Views.QuickHintBubble"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="Auto" Height="Auto">
    <Grid>
        <Border Background="#F7B515"  BorderBrush="#F7B515" BorderThickness="1" >
            <StackPanel Orientation="Horizontal">
                <!--<Polygon Points="0,30 20,20 0,10" Fill="#F7B515" VerticalAlignment="Center"/>-->
                <TextBlock Text="{Binding HintText, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="Black" FontWeight="Bold" Margin="0,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>