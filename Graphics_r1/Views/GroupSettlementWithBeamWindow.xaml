<Window x:Class="PileDesign.Views.GroupSettlementWithBeamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:common="clr-namespace:PileDesign.Common"
        mc:Ignorable="d"
        Title="基礎梁考慮 群杭沈下解析 (反復)" Height="700" Width="1100"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <Style x:Key="RightAlignedCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ 左パネル: 設定 ═══ -->
        <ScrollViewer Grid.Row="0" Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="8">
            <StackPanel>
                <!-- 荷重源 -->
                <GroupBox Header="荷重源 (Pi)" Margin="0,0,0,8">
                    <StackPanel Margin="4">
                        <ComboBox ItemsSource="{Binding LoadSourceOptions}"
                                  SelectedItem="{Binding LoadSource}"
                                  Margin="0,2"/>
                        <TextBlock Text="矩形荷重: 各 RectLoad の QA を Pi として使用 (VL のみ)"
                                   FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock Text="杭軸力: 各杭の AxialForce を Pi として使用 (VL/L1/L2 選択可)"
                                   FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </GroupBox>

                <!-- 荷重ケース選択 (杭軸力ソース時のみ) -->
                <GroupBox Header="荷重ケース" Margin="0,0,0,8">
                    <StackPanel Margin="4">
                        <CheckBox Content="VL (常時+追加)" IsChecked="{Binding AnalyzeVL}" Margin="0,2"
                                  FontWeight="Bold"/>
                        <Separator Margin="0,4"/>
                        <CheckBox Content="レベル1地震時 (L1-1～L1-N)"
                                  IsChecked="{Binding AnalyzeLevel1}"
                                  IsEnabled="{Binding IsAxialSource}"
                                  Margin="0,2"/>
                        <CheckBox Content="レベル2地震時 (L2-1～L2-N)"
                                  IsChecked="{Binding AnalyzeLevel2}"
                                  IsEnabled="{Binding IsAxialSource}"
                                  Margin="0,2"/>
                    </StackPanel>
                </GroupBox>

                <!-- 解析パラメータ -->
                <GroupBox Header="反復パラメータ" Margin="0,0,0,8">
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="最大反復回数:" VerticalAlignment="Center" Margin="0,2"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MaxIterations, UpdateSourceTrigger=PropertyChanged}"
                                 Width="80" HorizontalAlignment="Right" Margin="0,2"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="収束許容誤差:" VerticalAlignment="Center" Margin="0,2"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ConvergenceTolerance, UpdateSourceTrigger=PropertyChanged, StringFormat=E1}"
                                 Width="80" HorizontalAlignment="Right" Margin="0,2"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="ばね下限 k_min:" VerticalAlignment="Center" Margin="0,2"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding KMin, UpdateSourceTrigger=PropertyChanged, StringFormat=E1}"
                                 Width="80" HorizontalAlignment="Right" Margin="0,2"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="ばね上限 k_max:" VerticalAlignment="Center" Margin="0,2"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding KMax, UpdateSourceTrigger=PropertyChanged, StringFormat=E1}"
                                 Width="80" HorizontalAlignment="Right" Margin="0,2"/>
                    </Grid>
                </GroupBox>

                <!-- 実行ボタン -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8">
                    <Button Content="解析実行 (F9)" Command="{Binding ExecuteAnalysisCommand}"
                            Width="120" Height="32" Margin="0,0,8,0"
                            FontWeight="Bold" Background="{StaticResource PrimaryAccentDarkBrush}" Foreground="White">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAnalysisRunning}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="キャンセル" Command="{Binding CancelAnalysisCommand}"
                            IsEnabled="{Binding IsAnalysisRunning}"
                            Width="100" Height="32"/>
                </StackPanel>

                <!-- プログレスバー -->
                <StackPanel Margin="0,4,0,8">
                    <TextBlock Text="{Binding StatusText}" Margin="0,2"/>
                    <ProgressBar Value="{Binding CurrentProgress}" Minimum="0" Maximum="100" Height="18" Margin="0,2"/>
                </StackPanel>

                <!-- 結果ケース選択 -->
                <GroupBox Header="結果" Visibility="{Binding IsAnalysisExecuted, Converter={StaticResource BoolToVisConverter}}"
                          Margin="0,0,0,8">
                    <StackPanel Margin="4">
                        <TextBlock Text="荷重ケース:" Margin="0,2"/>
                        <ComboBox ItemsSource="{Binding CaseResults}"
                                  SelectedItem="{Binding SelectedCaseResult}"
                                  DisplayMemberPath="LoadCaseName"
                                  Margin="0,2,0,8"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══ 右パネル: ログ＋結果 ═══ -->
        <Grid Grid.Row="0" Grid.Column="1" Margin="0,8,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 計算ログ -->
            <GroupBox Grid.Row="0" Header="計算ログ">
                <ListBox x:Name="LogListBox" ItemsSource="{Binding CalculationLog}"
                         SelectionMode="Extended" FontFamily="Consolas" FontSize="11"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
            </GroupBox>

            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                          VerticalAlignment="Center" ResizeDirection="Rows"
                          Background="Transparent"/>

            <!-- 結果 DataGrid -->
            <TabControl Grid.Row="2"
                        Visibility="{Binding IsAnalysisExecuted, Converter={StaticResource BoolToVisConverter}}">
                <!-- 杭結果 -->
                <TabItem Header="杭結果">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <common:EnhancedDataGrid Grid.Row="0"
                                  ItemsSource="{Binding SelectedCaseResult.PileResults}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserSortColumns="True" CanUserReorderColumns="False"
                                  HeadersVisibility="Column" GridLinesVisibility="All"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <common:EnhancedDataGrid.Columns>
                                <DataGridTextColumn Header="杭No" Binding="{Binding PileNo}" Width="60"/>
                                <DataGridTextColumn Header="X [m]" Binding="{Binding X, StringFormat=F3}" Width="80"
                                                    ElementStyle="{StaticResource RightAlignedCell}"/>
                                <DataGridTextColumn Header="Y [m]" Binding="{Binding Y, StringFormat=F3}" Width="80"
                                                    ElementStyle="{StaticResource RightAlignedCell}"/>
                                <DataGridTextColumn Header="荷重 Pp [kN]" Binding="{Binding InputLoad_kN, StringFormat=F1}" Width="110"
                                                    ElementStyle="{StaticResource RightAlignedCell}"/>
                                <DataGridTextColumn Header="基礎反力 [kN]" Binding="{Binding Reaction_kN, StringFormat=F1}" Width="110"
                                                    ElementStyle="{StaticResource RightAlignedCell}"/>
                                <DataGridTextColumn Header="ばね [kN/m]" Binding="{Binding SpringStiffness_kN_per_m, StringFormat=E2}" Width="110"
                                                    ElementStyle="{StaticResource RightAlignedCell}"/>
                                <DataGridTextColumn Header="沈下量 [mm]" Binding="{Binding Settlement_mm, StringFormat=F2}" Width="100"
                                                    ElementStyle="{StaticResource RightAlignedCell}"/>
                            </common:EnhancedDataGrid.Columns>
                        </common:EnhancedDataGrid>

                        <!-- 合計・収束情報 -->
                        <Border Grid.Row="1" BorderBrush="#CCC" BorderThickness="0,1,0,0" Padding="6" Background="#F8F8F8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="合計（平衡確認）" FontWeight="Bold" Margin="0,0,12,4"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="荷重合計 ΣPp:" Margin="0,0,12,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{Binding SelectedCaseResult.TotalInputLoad_kN, StringFormat={}{0:N1} kN}"
                                           HorizontalAlignment="Right" Margin="0,0,0,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="2"
                                           Text="{Binding SelectedCaseResult.MaxSettlement_mm, StringFormat=最大沈下 {0:F2} mm}"
                                           Margin="12,0,0,2" Foreground="#666"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="反力合計 ΣPi:" Margin="0,0,12,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                           Text="{Binding SelectedCaseResult.TotalReaction_kN, StringFormat={}{0:N1} kN}"
                                           HorizontalAlignment="Right" Margin="0,0,0,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="2"
                                           Text="{Binding SelectedCaseResult.MinSettlement_mm, StringFormat=最小沈下 {0:F2} mm}"
                                           Margin="12,0,0,2" Foreground="#666"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="差 (ΣPi − ΣPpi):" Margin="0,0,12,0"/>
                                <TextBlock Grid.Row="3" Grid.Column="1"
                                           Text="{Binding SelectedCaseResult.BalanceDifference_kN, StringFormat={}{0:+0.0;-0.0;0.0} kN}"
                                           HorizontalAlignment="Right" Foreground="#666"/>
                                <TextBlock Grid.Row="3" Grid.Column="2"
                                           Margin="12,0,0,0" Foreground="#666">
                                    <Run Text="反復"/><Run Text="{Binding SelectedCaseResult.IterationCount}"/><Run Text="回, 残差="/><Run Text="{Binding SelectedCaseResult.FinalResidual, StringFormat=E2}"/>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- 確定矩形荷重 -->
                <TabItem Header="確定矩形荷重">
                    <common:EnhancedDataGrid ItemsSource="{Binding SelectedCaseResult.ConvergedRectLoads}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserSortColumns="True" CanUserReorderColumns="False"
                              HeadersVisibility="Column" GridLinesVisibility="All"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <common:EnhancedDataGrid.Columns>
                            <DataGridTextColumn Header="杭No" Binding="{Binding LinkedPileNo}" Width="60"/>
                            <DataGridTextColumn Header="X1 [m]" Binding="{Binding X1, StringFormat=F3}" Width="80"
                                                ElementStyle="{StaticResource RightAlignedCell}"/>
                            <DataGridTextColumn Header="Y1 [m]" Binding="{Binding Y1, StringFormat=F3}" Width="80"
                                                ElementStyle="{StaticResource RightAlignedCell}"/>
                            <DataGridTextColumn Header="X2 [m]" Binding="{Binding X2, StringFormat=F3}" Width="80"
                                                ElementStyle="{StaticResource RightAlignedCell}"/>
                            <DataGridTextColumn Header="Y2 [m]" Binding="{Binding Y2, StringFormat=F3}" Width="80"
                                                ElementStyle="{StaticResource RightAlignedCell}"/>
                            <DataGridTextColumn Header="DX [m]" Binding="{Binding DX, StringFormat=F3}" Width="70"
                                                ElementStyle="{StaticResource RightAlignedCell}"/>
                            <DataGridTextColumn Header="DY [m]" Binding="{Binding DY, StringFormat=F3}" Width="70"
                                                ElementStyle="{StaticResource RightAlignedCell}"/>
                            <DataGridTextColumn Header="QA [kN]" Binding="{Binding QA, StringFormat=F1}" Width="90"
                                                ElementStyle="{StaticResource RightAlignedCell}"/>
                            <DataGridTextColumn Header="Q [kN/m²]" Binding="{Binding Q, StringFormat=F2}" Width="100"
                                                ElementStyle="{StaticResource RightAlignedCell}"/>
                        </common:EnhancedDataGrid.Columns>
                    </common:EnhancedDataGrid>
                </TabItem>

                <!-- 節点変位 -->
                <TabItem Header="節点変位">
                    <common:EnhancedDataGrid ItemsSource="{Binding SelectedCaseResult.NodeResults}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserSortColumns="True" CanUserReorderColumns="False"
                              HeadersVisibility="Column" GridLinesVisibility="All"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <common:EnhancedDataGrid.Columns>
                            <DataGridTextColumn Header="節点名" Binding="{Binding NodeName}" Width="160"/>
                            <DataGridTextColumn Header="X [m]" Binding="{Binding X, StringFormat=F3}" Width="80"
                                                ElementStyle="{StaticResource RightAlignedCell}"/>
                            <DataGridTextColumn Header="Y [m]" Binding="{Binding Y, StringFormat=F3}" Width="80"
                                                ElementStyle="{StaticResource RightAlignedCell}"/>
                            <DataGridTextColumn Header="Z [m]" Binding="{Binding Z, StringFormat=F3}" Width="80"
                                                ElementStyle="{StaticResource RightAlignedCell}"/>
                            <DataGridTextColumn Header="Uz [mm]" Binding="{Binding Uz_mm, StringFormat=F3}" Width="90"
                                                ElementStyle="{StaticResource RightAlignedCell}"/>
                            <DataGridTextColumn Header="Rx [rad]" Binding="{Binding Rx_rad, StringFormat=E3}" Width="100"
                                                ElementStyle="{StaticResource RightAlignedCell}"/>
                            <DataGridTextColumn Header="Ry [rad]" Binding="{Binding Ry_rad, StringFormat=E3}" Width="100"
                                                ElementStyle="{StaticResource RightAlignedCell}"/>
                        </common:EnhancedDataGrid.Columns>
                    </common:EnhancedDataGrid>
                </TabItem>

                <!-- 梁断面力 -->
                <TabItem Header="梁断面力">
                    <common:EnhancedDataGrid ItemsSource="{Binding SelectedCaseResult.BeamResults}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserSortColumns="True" CanUserReorderColumns="False"
                              HeadersVisibility="Column" GridLinesVisibility="All"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <common:EnhancedDataGrid.Columns>
                            <DataGridTextColumn Header="梁名" Binding="{Binding BeamName}" Width="150"/>
                            <DataGridTextColumn Header="Ni [kN]" Binding="{Binding Ni, StringFormat=F1}" Width="80"
                                                ElementStyle="{StaticResource RightAlignedCell}"/>
                            <DataGridTextColumn Header="Qyi [kN]" Binding="{Binding Qyi, StringFormat=F1}" Width="80"
                                                ElementStyle="{StaticResource RightAlignedCell}"/>
                            <DataGridTextColumn Header="Qzi [kN]" Binding="{Binding Qzi, StringFormat=F1}" Width="80"
                                                ElementStyle="{StaticResource RightAlignedCell}"/>
                            <DataGridTextColumn Header="Myi [kNm]" Binding="{Binding Myi, StringFormat=F1}" Width="90"
                                                ElementStyle="{StaticResource RightAlignedCell}"/>
                            <DataGridTextColumn Header="Mzi [kNm]" Binding="{Binding Mzi, StringFormat=F1}" Width="90"
                                                ElementStyle="{StaticResource RightAlignedCell}"/>
                            <DataGridTextColumn Header="Nj [kN]" Binding="{Binding Nj, StringFormat=F1}" Width="80"
                                                ElementStyle="{StaticResource RightAlignedCell}"/>
                            <DataGridTextColumn Header="Qzj [kN]" Binding="{Binding Qzj, StringFormat=F1}" Width="80"
                                                ElementStyle="{StaticResource RightAlignedCell}"/>
                            <DataGridTextColumn Header="Myj [kNm]" Binding="{Binding Myj, StringFormat=F1}" Width="90"
                                                ElementStyle="{StaticResource RightAlignedCell}"/>
                            <DataGridTextColumn Header="Mzj [kNm]" Binding="{Binding Mzj, StringFormat=F1}" Width="90"
                                                ElementStyle="{StaticResource RightAlignedCell}"/>
                        </common:EnhancedDataGrid.Columns>
                    </common:EnhancedDataGrid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- ═══ 下部ボタン ═══ -->
        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="8">
            <Button Content="保存(_S)" Command="{Binding OkCommand}"
                    Width="180" Height="28" Margin="0,4,8,4"
                    IsDefault="True"
                    ToolTip="変更を保存して閉じます (Enter / Ctrl+Enter / Alt+S)"
                    Visibility="{Binding IsAnalysisExecuted, Converter={StaticResource BoolToVisConverter}}"/>
            <Button Content="キャンセル(_C)" Command="{Binding CancelCommand}"
                    Width="150" Height="28" Margin="0,4,8,4"
                    IsCancel="True"
                    ToolTip="変更を破棄して閉じます (Esc / Alt+C)"/>
        </StackPanel>
    </Grid>
</Window>
