<UserControl x:Class="PileDesign.Views.InputVisualizer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="40" d:DesignWidth="220"
             Background="Transparent">

    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <!-- マウスイラスト -->
        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="8" Padding="4" Margin="2">
            <Grid Width="40" Height="32">
                <!-- マウス本体 -->
                <Border Background="#F0F0F0" CornerRadius="6" BorderBrush="DarkGray" BorderThickness="1"
                        Width="30" HorizontalAlignment="Left"/>

                <!-- 左ボタン -->
                <Border x:Name="LeftMouseButton"
                        Width="12" Height="12"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="2,2,0,0"
                        CornerRadius="3"
                        Background="#E0E0E0" BorderBrush="Gray" BorderThickness="1"/>

                <!-- 右ボタン -->
                <Border x:Name="RightMouseButton"
                        Width="12" Height="12"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="16,2,0,0"
                        CornerRadius="3"
                        Background="#E0E0E0" BorderBrush="Gray" BorderThickness="1"/>

                <!-- 中ボタン（ホイール） -->
                <Border x:Name="MiddleMouseButton"
                        Width="6" Height="10"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="12,3,0,0"
                        CornerRadius="2"
                        Background="#C0C0C0" BorderBrush="Gray" BorderThickness="1"/>

                <!-- ホイール回転表示（上矢印） -->
                <TextBlock x:Name="WheelUpArrow"
                           Text="▲" FontSize="10" Foreground="#E0E0E0"
                           HorizontalAlignment="Right" VerticalAlignment="Top"
                           Margin="0,2,2,0"/>

                <!-- ホイール回転表示（下矢印） -->
                <TextBlock x:Name="WheelDownArrow"
                           Text="▼" FontSize="10" Foreground="#E0E0E0"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Margin="0,0,2,2"/>
            </Grid>
        </Border>

        <!-- キーボードイラスト -->
        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="2" Margin="2">
            <StackPanel Orientation="Horizontal">
                <!-- Ctrl キー -->
                <Border x:Name="CtrlKey"
                        MinWidth="28" Height="18"
                        Margin="1"
                        CornerRadius="2"
                        Background="#E0E0E0" BorderBrush="Gray" BorderThickness="1">
                    <TextBlock Text="Ctrl" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Shift キー -->
                <Border x:Name="ShiftKey"
                        MinWidth="28" Height="18"
                        Margin="1"
                        CornerRadius="2"
                        Background="#E0E0E0" BorderBrush="Gray" BorderThickness="1">
                    <TextBlock Text="Shift" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Alt キー -->
                <Border x:Name="AltKey"
                        MinWidth="24" Height="18"
                        Margin="1"
                        CornerRadius="2"
                        Background="#E0E0E0" BorderBrush="Gray" BorderThickness="1">
                    <TextBlock Text="Alt" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- 現在のキー表示 -->
                <Border x:Name="CurrentKeyBorder"
                        MinWidth="24" Height="18"
                        Margin="1"
                        CornerRadius="2"
                        Background="#E0E0E0" BorderBrush="Gray" BorderThickness="1"
                        Visibility="Collapsed">
                    <TextBlock x:Name="CurrentKeyText" FontSize="9" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
