<Window x:Class="PileDesign.Views.LoadingMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PileDesign" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Width="580" Height="360">
    <Border CornerRadius="10" Margin="16">
        <Border.Background>
            <SolidColorBrush Color="White"/>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="4" Opacity="0.18" Color="#333333"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ロゴ（中央） -->
            <Image Grid.Row="0"
                   Source="pack://application:,,,/NikkenLogo/170703_Nikken_Brandmark_Tagline.jpg"
                   Height="140" Stretch="Uniform"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <!-- 下部: プログラム名 + バージョン -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,24">
                <TextBlock Text="杭基礎検討プログラム"
                           FontSize="13" Foreground="#888888"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="VersionText"
                           FontSize="10.5" Foreground="#BBBBBB"
                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
