<Window x:Class="PileDesign.Views.WelcomeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PileDesign.ViewModels"
        d:DataContext="{d:DesignInstance Type=local:WelcomeDialogViewModel}"
        mc:Ignorable="d"
        Title="杭基礎検討プログラム"
        Width="500" Height="350"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="White" CornerRadius="8"
            BorderBrush="#62B0E2" BorderThickness="2"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.3"/>
        </Border.Effect>

        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- タイトル -->
            <TextBlock Grid.Row="0" Text="杭基礎検討プログラム"
                       FontSize="24" FontWeight="Bold"
                       Foreground="#333333"
                       HorizontalAlignment="Center" Margin="0,10,0,5"/>

            <!-- サブタイトル -->
            <TextBlock Grid.Row="1" Text="作業を開始してください"
                       FontSize="14" Foreground="Gray"
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <!-- ボタン -->
            <StackPanel Grid.Row="2" VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                <!-- 新規プロジェクト -->
                <Button Command="{Binding NewProjectCommand}"
                        Width="320" Height="50" Margin="0,6"
                        Background="#62B0E2" Foreground="White"
                        FontSize="16" Cursor="Hand"
                        BorderThickness="0">
                    <TextBlock Text="新規プロジェクト" VerticalAlignment="Center"/>
                </Button>

                <!-- 既存ファイルを開く -->
                <Button Command="{Binding OpenExistingCommand}"
                        Width="320" Height="50" Margin="0,6"
                        Background="White" Foreground="#333333"
                        FontSize="16" Cursor="Hand"
                        BorderBrush="#62B0E2" BorderThickness="1.5">
                    <TextBlock Text="既存ファイルを開く" VerticalAlignment="Center"/>
                </Button>

                <!-- サンプルプロジェクトを開く（未実装のため非表示） -->
                <Button Command="{Binding OpenSampleCommand}"
                        Width="320" Height="50" Margin="0,6"
                        Background="White" Foreground="#333333"
                        FontSize="16" Cursor="Hand"
                        BorderBrush="#F7B515" BorderThickness="1.5"
                        Visibility="Collapsed">
                    <TextBlock Text="サンプルプロジェクトを開く" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>

            <!-- 次回から表示しない -->
            <CheckBox Grid.Row="3"
                      Content="次回から表示しない"
                      IsChecked="{Binding DoNotShowAgain}"
                      HorizontalAlignment="Center"
                      Margin="0,15,0,0" Foreground="Gray"/>
        </Grid>
    </Border>
</Window>
