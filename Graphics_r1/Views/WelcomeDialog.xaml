<Window x:Class="PileDesign.Views.WelcomeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PileDesign.ViewModels"
        d:DataContext="{d:DesignInstance Type=local:WelcomeDialogViewModel}"
        mc:Ignorable="d"
        Title="杭基礎検討プログラム"
        Width="700" Height="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0,8"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="text"
                                       Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="text" Property="Foreground" Value="#3271AD"/>
                                <Setter TargetName="text" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="text" Property="Foreground" Value="#62B0E2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="10" Margin="16">
        <Border.Background>
            <SolidColorBrush Color="White"/>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="4" Opacity="0.18" Color="#333333"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 左: NIKKENロゴ（大きく中央配置） -->
            <Border Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/NikkenLogo/170703_Nikken_Brandmark_Tagline.jpg"
                       Height="180" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <!-- 右: プログラム名 + 選択肢 + フッター -->
            <Border Grid.Column="1" Width="220" Padding="0,32,32,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: プログラム名 + 選択肢（中央揃え） -->
                    <StackPanel Grid.Row="0" VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock Text="杭基礎検討プログラム"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="#333333"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding AppVersion, Source={x:Static local:WelcomeDialogViewModel.Instance}}"
                                   FontSize="10.5" Foreground="#BBBBBB"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,24"/>

                        <Button Content="新規プロジェクト"
                                Command="{Binding NewProjectCommand}"
                                Style="{StaticResource LinkButtonStyle}"
                                HorizontalAlignment="Center"/>
                        <Button Content="ファイルを開く"
                                Command="{Binding OpenExistingCommand}"
                                Style="{StaticResource LinkButtonStyle}"
                                HorizontalAlignment="Center"/>
                        <Button Content="サンプルを開く"
                                Command="{Binding OpenSampleCommand}"
                                Style="{StaticResource LinkButtonStyle}"
                                HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Row 1: セパレータ -->
                    <Separator Grid.Row="1" Margin="0,8,0,8" Background="#EEEEEE"/>

                    <!-- Row 2: フッター（中央揃え） -->
                    <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                        <CheckBox Content="次回から表示しない"
                                  IsChecked="{Binding DoNotShowAgain}"
                                  Foreground="#BBBBBB" FontSize="10.5"
                                  HorizontalAlignment="Center"/>
                        <TextBlock Text="基礎地盤研究会"
                                   Foreground="#CCCCCC" FontSize="10"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
