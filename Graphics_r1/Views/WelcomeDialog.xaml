<Window x:Class="PileDesign.Views.WelcomeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PileDesign.ViewModels"
        d:DataContext="{d:DesignInstance Type=local:WelcomeDialogViewModel}"
        mc:Ignorable="d"
        Title="杭基礎検討プログラム"
        Width="640" Height="460"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <!-- テキストリンク風ボタン -->
        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="text"
                                       Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="text" Property="Foreground" Value="#3271AD"/>
                                <Setter TargetName="text" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="text" Property="Foreground" Value="#62B0E2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="10" Margin="16">
        <Border.Background>
            <SolidColorBrush Color="White"/>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="4" Opacity="0.18" Color="#333333"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: NIKKENロゴ（大きく、空間の中心） -->
            <Border Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="40,0">
                <Image Source="pack://application:,,,/NikkenLogo/170703_Nikken_Brandmark_Tagline.jpg"
                       Height="120" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <!-- Row 1: プログラム名 + バージョン（控えめ） -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,24">
                <TextBlock Text="杭基礎検討プログラム"
                           FontSize="14" FontWeight="Normal"
                           Foreground="#888888" HorizontalAlignment="Center"
                           LetterSpacing="0.5"/>
                <TextBlock Text="{Binding AppVersion, Source={x:Static local:WelcomeDialogViewModel.Instance}}"
                           FontSize="10.5" Foreground="#BBBBBB"
                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
            </StackPanel>

            <!-- Row 2: 選択肢（横並びテキストリンク） -->
            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,0,0,20">

                <Button Content="新規プロジェクト"
                        Command="{Binding NewProjectCommand}"
                        Style="{StaticResource LinkButtonStyle}"/>

                <TextBlock Text="|" Foreground="#DDDDDD" FontSize="14"
                           VerticalAlignment="Center" Margin="4,0"/>

                <Button Content="ファイルを開く"
                        Command="{Binding OpenExistingCommand}"
                        Style="{StaticResource LinkButtonStyle}"/>

                <TextBlock Text="|" Foreground="#DDDDDD" FontSize="14"
                           VerticalAlignment="Center" Margin="4,0"/>

                <Button Content="サンプル"
                        Command="{Binding OpenSampleCommand}"
                        Style="{StaticResource LinkButtonStyle}"/>
            </StackPanel>

            <!-- Row 3: フッター -->
            <Border Grid.Row="3" Padding="28,0,28,16">
                <StackPanel>
                    <Separator Margin="0,0,0,10" Background="#EEEEEE"/>
                    <Grid>
                        <CheckBox Content="次回から表示しない"
                                  IsChecked="{Binding DoNotShowAgain}"
                                  HorizontalAlignment="Left"
                                  Foreground="#BBBBBB" FontSize="11"/>
                        <TextBlock Text="基礎地盤研究会"
                                   HorizontalAlignment="Right"
                                   Foreground="#CCCCCC" FontSize="10.5"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
