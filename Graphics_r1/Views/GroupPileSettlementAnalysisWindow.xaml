<Window x:Class="PileDesign.Views.GroupPileSettlementAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PileDesign.ViewModels"
        xmlns:conv="clr-namespace:PileDesign.Converters"
        xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
        mc:Ignorable="d"
        xmlns:linq="clr-namespace:System.Linq;assembly=System.Core"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:svg="http://sharpvectors.codeplex.com/runtime/"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        xmlns:common="clr-namespace:PileDesign.Common"
        Title="GroupPileSettlementAnalysisWindow" Height="450" Width="800">

    <Window.DataContext>
        <local:MainWindowViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <conv:BooleanToContentConverter x:Key="BooleanToContentConverter"/>
        <conv:VisibilityConverter x:Key="VisibilityConverter"/>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:BooleanNegationConverter x:Key="BooleanNegationConverter" />
        <conv:SubscriptConverter x:Key="SubscriptConverter" />
        <conv:LoadCaseNameInSeismicCasesToVisibilityConverter x:Key="LoadCaseNameInSeismicCasesToVisibilityConverter"/>
        <conv:AnalysisResultContentEqualsToVisibilityConverter x:Key="AnalysisResultContentEqualsToVisibilityConverter"/>
        <conv:MidSpanAndPileTopVisibilityConverter x:Key="MidSpanAndPileTopVisibilityConverter"/>
        <conv:ResultValueAndMidSpanAndPileTopVisibilityConverter x:Key="ResultValueAndMidSpanAndPileTopVisibilityConverter"/>

        <!--<FrameworkElement x:Key="ProxyElement" DataContext="{Binding ElementName=MainWin, Path=DataContext}"/>-->

        <ContextMenu x:Key="NodeContextMenu">
            <MenuItem Header="コピー／移動" Command="{Binding MoveCopyPilesCommand}"/>
            <MenuItem Header="プロパティ変更／追加" Command="{Binding EditAddPilesCommand}"/>
            <MenuItem Header="削除" Command="{Binding DeletePilesCommand}"/>
            <MenuItem Header="選択解除" Command="{Binding DeselectPilesCommand}"/>
            <MenuItem Header="画像保存" Command="{Binding ImageSaveCommand}"/>
        </ContextMenu>

        <ContextMenu x:Key="CommonDataGridContextMenu" Opened="ContextMenu_Opened">
            <MenuItem Click="ExportCsvFromContextMenu_Click">
                <MenuItem.Icon>
                    <svgc:SvgViewbox Source="/Icons/CSVFileOutput.svg" Style="{StaticResource SvgIconStyle}"/>
                </MenuItem.Icon>
                <MenuItem.Header>
                    <TextBlock Text="CSVファイル出力"/>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem Header="コピー" Command="{Binding CopyDataGridSelectionCommand}"
                      CommandParameter="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </ContextMenu>

        <Style x:Key="RightAlignedTextBlockStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <Style x:Key="CenterAlignedTextBlockStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RightAlignedDataCellStyle" TargetType="DataGridCell">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <!-- Style for ComboBox elements to right-align text -->
        <Style x:Key="RightAlignedComboBoxStyle" TargetType="ComboBox">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <!-- Style for ComboBox items to right-align text -->
        <Style x:Key="RightAlignedComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <Style x:Key="OpenElementDivisionWindowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsElementSplit}" Value="True">
                    <Setter Property="Background" Value="#62B0E2"/>
                    <Setter Property="Foreground" Value="White"/>

                </DataTrigger>
                <DataTrigger Binding="{Binding IsElementSplit}" Value="False">
                    <Setter Property="Background" Value="#F7B515"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Style for VerticalAnalyseButtonStyle -->
        <Style x:Key="VerticalAnalyseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsElementSplit}" Value="False">
                    <Setter Property="Background" Value="LightGray"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsElementSplit}" Value="True"/>
                        <Condition Binding="{Binding IsVerticalAnalysisDone}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#F7B515"/>
                    <Setter Property="Foreground" Value="White"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsElementSplit}" Value="True"/>
                        <Condition Binding="{Binding IsVerticalAnalysisDone}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#62B0E2"/>
                    <Setter Property="Foreground" Value="White"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>



        <!-- Style for HorizontalAnalyseButtonStyle -->
        <Style x:Key="HorizontalAnalyseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsElementSplit}" Value="False">
                    <Setter Property="Background" Value="LightGray"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsElementSplit}" Value="True"/>
                        <Condition Binding="{Binding IsHorizontalAnalysisDone}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#F7B515"/>
                    <Setter Property="Foreground" Value="White"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsElementSplit}" Value="True"/>
                        <Condition Binding="{Binding IsHorizontalAnalysisDone}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#62B0E2"/>
                    <Setter Property="Foreground" Value="White"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OpenGroupPileSettlementWindowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGroupPileSettlementAnalysisDone}" Value="True">
                    <Setter Property="Background" Value="#62B0E2"/>
                    <Setter Property="Foreground" Value="White"/>

                </DataTrigger>
                <DataTrigger Binding="{Binding IsGroupPileSettlementAnalysisDone}" Value="False">
                    <Setter Property="Background" Value="#F7B515"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Imageコントロール用のスタイルを定義 -->
        <Style x:Key="IconImageStyle" TargetType="Image">
            <Setter Property="Width" Value="16px"/>
            <Setter Property="Height" Value="16px"/>
        </Style>

        <!-- SvgViewboxコントロール用のスタイルを定義 -->
        <Style x:Key="SvgIconStyle" TargetType="svgc:SvgViewbox">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
        </Style>

        <!-- ToolTipのスタイルを定義 -->
        <Style TargetType="ToolTip" x:Key="DeepBlueToolTipStyle">
            <Setter Property="Foreground" Value="#3271AD"/>
            <!-- フォントの色を赤に設定 -->
        </Style>

        <!-- ToolTipのスタイルを定義 -->
        <Style TargetType="ToolTip" x:Key="BrownToolTipStyle">
            <Setter Property="Foreground" Value="Brown"/>
            <!-- フォントの色を赤に設定 -->
        </Style>
        
    </Window.Resources>
    
    <Grid>
        <avalonDock:DockingManager x:Name="dockingManager" Grid.Row="1">
            <avalonDock:LayoutRoot>
                <avalonDock:LayoutPanel Orientation="Horizontal">
                    <avalonDock:LayoutAnchorablePane DockWidth="Auto">
                    </avalonDock:LayoutAnchorablePane>

                    <avalonDock:LayoutDocumentPaneGroup DockWidth="1*">
                        <avalonDock:LayoutDocumentPane>
                            <avalonDock:LayoutDocument Title="群杭荷重" CanClose="False">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <ToolBar Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="荷重タイプ"/>
                                        <ComboBox ItemsSource="{Binding AvailableLoadingTypeOptions, UpdateSourceTrigger=LostFocus}"
                                                  SelectedItem="{Binding CurrentInputModel.PileGroupSettlement.LoadingType, UpdateSourceTrigger=LostFocus}"
                                                  Width="150"
                                                  SelectionChanged="ComboBoxLoadingType_SelectionChanged"/>
                                        <TextBlock Text="荷重面Z"/>
                                        <TextBox x:Name="TextBoxGroupPileLoadingPlaneAltitude"
                                                 Text="{Binding CurrentInputModel.PileGroupSettlement.LoadingPlaneAltitude, StringFormat={}{0:+0.00;-0.00;+0.00}, UpdateSourceTrigger=LostFocus}"
                                                 GotFocus="TextBox_GotFocus"
                                                 PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown" 
                                                 TextChanged="TextBoxAltitude_TextChanged"
                                                 PreviewMouseDown="TextBoxBottomAltitude_PreviewMouseDown"/>
                                    </ToolBar>

                                    <StackPanel Grid.Row="1" Visibility="{Binding CurrentInputModel.PileGroupSettlement.LoadingType,
                                        Converter={StaticResource VisibilityConverter},
                                        ConverterParameter='任意矩形,個別十字,個別十字（基礎梁考慮）'}">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="矩形荷重面追加" Width="100" HorizontalAlignment="Left" Command="{Binding AddRectLoadCommand}"/>
                                            <Button Content="基礎指針'19計算例5" Width="100" HorizontalAlignment="Left" Command="{Binding Example5Command}"/>

                                        </StackPanel>

                                        <Expander>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="杭心～矩形荷重面(m)"/>
                                                    <TextBox Text="{Binding RectLoadPileDistance}" Width="100"/>
                                                    <Button Content="全体矩形荷重面自動生成" Command="{ Binding AdjustRectLoadPlanCommand}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Expander>

                                        <common:EnhancedDataGrid ItemsSource="{Binding CurrentInputModel.PileGroupSettlement.RectLoads, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                                            AutoGenerateColumns="False"
                                            CanUserAddRows="False"
                                            CanUserSortColumns="False"
                                            LoadingRow="DataGrid_LoadingRow_Numbering"
                                            CellEditEnding="DataGridRectLoads_CellEditEnding">

                                            <common:EnhancedDataGrid.AlternatingRowBackground>
                                                <ImageBrush/>
                                            </common:EnhancedDataGrid.AlternatingRowBackground>
                                            <common:EnhancedDataGrid.Style>
                                                <Style/>
                                            </common:EnhancedDataGrid.Style>


                                            <!--CSVファイル出力-->
                                            <common:EnhancedDataGrid.ContextMenu>
                                                <StaticResource ResourceKey="CommonDataGridContextMenu"/>
                                            </common:EnhancedDataGrid.ContextMenu>

                                            <common:EnhancedDataGrid.ColumnHeaderStyle>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                    <Setter Property="Foreground" Value="#62B0E2" />
                                                </Style>
                                            </common:EnhancedDataGrid.ColumnHeaderStyle>

                                            <common:EnhancedDataGrid.Columns>

                                                <DataGridTemplateColumn Width="*" Header="削除" MinWidth="50">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button
                                                                x:Name="ButtonRectLoadDelete"
                                                                Content="削除"
                                                                Tag="{Binding}"
                                                                Command="{Binding DataContext.DeleteRectLoadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTextColumn Width="*" Binding="{Binding X1, StringFormat=N3}"
                                                                    ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50">
                                                    <DataGridTextColumn.Header>
                                                        <StackPanel>
                                                            <TextBlock Text="X1"
                                                                TextAlignment="Center"/>
                                                            <TextBlock Text="(m)"
                                                                TextAlignment="Center"
                                                                HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Width="*" Binding="{Binding X2, StringFormat=N3}"
                                                                    ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50">
                                                    <DataGridTextColumn.Header>
                                                        <StackPanel>
                                                            <TextBlock Text="X2"
                                                                TextAlignment="Center"/>
                                                            <TextBlock Text="(m)"
                                                                TextAlignment="Center"
                                                                HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Width="*" Binding="{Binding Y1, StringFormat=N3}"
                                                                    ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50">
                                                    <DataGridTextColumn.Header>
                                                        <StackPanel>
                                                            <TextBlock Text="Y1"
                                                                TextAlignment="Center"/>
                                                            <TextBlock Text="(m)"
                                                                TextAlignment="Center"
                                                                HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Width="*" Binding="{Binding Y2, StringFormat=N3}"
                                                                    ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50">
                                                    <DataGridTextColumn.Header>
                                                        <StackPanel>
                                                            <TextBlock Text="Y2"
                                                                TextAlignment="Center"/>
                                                            <TextBlock Text="(m)"
                                                                TextAlignment="Center"
                                                                HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Width="*" Binding="{Binding QA, StringFormat=N0}"
                                                                    ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50">
                                                    <DataGridTextColumn.Header>
                                                        <StackPanel>
                                                            <TextBlock Text="荷重"
                                                                TextAlignment="Center"/>
                                                            <TextBlock Text="(kN)"
                                                                TextAlignment="Center"
                                                                HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Width="*" Binding="{Binding DX, StringFormat=N3}"
                                                                    ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50"
                                                                    IsReadOnly="true" Foreground="Gray">
                                                    <DataGridTextColumn.Header>
                                                        <StackPanel>
                                                            <TextBlock Text="DX"
                                                                TextAlignment="Center"/>
                                                            <TextBlock Text="(m)"
                                                                TextAlignment="Center"
                                                                HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Width="*" Binding="{Binding DY, StringFormat=N3}"
                                                                    ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50"
                                                                    IsReadOnly="true" Foreground="Gray">
                                                    <DataGridTextColumn.Header>
                                                        <StackPanel>
                                                            <TextBlock Text="DY"
                                                                TextAlignment="Center"/>
                                                            <TextBlock Text="(m)"
                                                                TextAlignment="Center"
                                                                HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Width="*" Binding="{Binding A, StringFormat=N3}"
                                                                    ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50"
                                                                    IsReadOnly="true" Foreground="Gray">
                                                    <DataGridTextColumn.Header>
                                                        <StackPanel>
                                                            <TextBlock Text="面積"
                                                                TextAlignment="Center"/>
                                                            <TextBlock TextAlignment="Center" HorizontalAlignment="Center"><Run Text="(m"/><Run Text="2" BaselineAlignment="Superscript" FontSize="9"/><Run Text=")"/></TextBlock>
                                                        </StackPanel>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Width="*" Binding="{Binding Q, StringFormat=N3}"
                                                                    ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50"
                                                                    IsReadOnly="true" Foreground="Gray">
                                                    <DataGridTextColumn.Header>
                                                        <StackPanel>
                                                            <TextBlock Text="単位面積荷重"
                                                                TextAlignment="Center"/>
                                                            <TextBlock TextAlignment="Center" HorizontalAlignment="Center"><Run Text="(kN/m"/><Run Text="2" BaselineAlignment="Superscript" FontSize="9"/><Run Text=")"/></TextBlock>
                                                        </StackPanel>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                            </common:EnhancedDataGrid.Columns>
                                        </common:EnhancedDataGrid>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Visibility="{Binding CurrentInputModel.PileGroupSettlement.LoadingType,
                                        Converter={StaticResource VisibilityConverter},
                                        ConverterParameter='個別十字,個別十字（基礎梁考慮）'}">

                                        <common:EnhancedDataGrid ItemsSource="{Binding CurrentInputModel.ElementDivision.SoilPiles, UpdateSourceTrigger=LostFocus}"
                                            AutoGenerateColumns="False"
                                            CanUserAddRows="False"
                                            CanUserSortColumns="False"
                                            LoadingRow="DataGrid_LoadingRow_Numbering"
                                            CellEditEnding="DataGridSoilPile_CellEditEnding">

                                            <common:EnhancedDataGrid.AlternatingRowBackground>
                                                <ImageBrush/>
                                            </common:EnhancedDataGrid.AlternatingRowBackground>
                                            <common:EnhancedDataGrid.Style>
                                                <Style/>
                                            </common:EnhancedDataGrid.Style>

                                            <!--CSVファイル出力-->
                                            <common:EnhancedDataGrid.ContextMenu>
                                                <StaticResource ResourceKey="CommonDataGridContextMenu"/>
                                            </common:EnhancedDataGrid.ContextMenu>

                                            <common:EnhancedDataGrid.ColumnHeaderStyle>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                    <Setter Property="Foreground" Value="#62B0E2" />
                                                </Style>
                                            </common:EnhancedDataGrid.ColumnHeaderStyle>

                                            <common:EnhancedDataGrid.Columns>
                                                <DataGridTextColumn Width="*" Binding="{Binding GroundNo}"
                                                        ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50"
                                                        IsReadOnly=" true" Foreground="Gray">
                                                    <DataGridTextColumn.Header>
                                                        <StackPanel>
                                                            <TextBlock Text="地盤"
                                                                TextAlignment="Center"/>
                                                            <TextBlock Text="番号"
                                                                TextAlignment="Center"
                                                                HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Width="*" Binding="{Binding PileBodyNo}"
                                                        ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50"
                                                        IsReadOnly=" true" Foreground="Gray">
                                                    <DataGridTextColumn.Header>
                                                        <StackPanel>
                                                            <TextBlock Text="杭体"
                                                                TextAlignment="Center"/>
                                                            <TextBlock Text="番号"
                                                                TextAlignment="Center"
                                                                HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Width="*" Binding="{Binding Z, StringFormat=N3}"
                                                        ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50"
                                                        IsReadOnly=" true" Foreground="Gray">
                                                    <DataGridTextColumn.Header>
                                                        <StackPanel>
                                                            <TextBlock Text="杭頭Z"
                                                                TextAlignment="Center"/>
                                                            <TextBlock Text="(m)"
                                                                TextAlignment="Center"
                                                                HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Width="*" Binding="{Binding PileBottomAltitude, StringFormat=N3}"
                                                        ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50"
                                                        IsReadOnly=" true" Foreground="Gray">
                                                    <DataGridTextColumn.Header>
                                                        <StackPanel>
                                                            <TextBlock Text="杭先端Z"
                                                                TextAlignment="Center"/>
                                                            <TextBlock Text="(m)"
                                                                TextAlignment="Center"
                                                                HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Width="*" Binding="{Binding GroupPileLoadDia, StringFormat=N3}"
                                                    ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="50">
                                                    <DataGridTextColumn.Header>
                                                        <StackPanel>
                                                            <TextBlock Text="荷重面径"
                                                                TextAlignment="Center"/>
                                                            <TextBlock Text="(m)"
                                                                TextAlignment="Center"
                                                                HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>
                                            </common:EnhancedDataGrid.Columns>
                                        </common:EnhancedDataGrid>
                                    </StackPanel>

                                    <StackPanel Grid.Row=" 2">

                                        <Button Content="群杭即時沈下検討用土層追加" Width="200" HorizontalAlignment="Left" Command="{Binding AddSettlementSoilLayerCommand}"/>

                                        <common:EnhancedDataGrid ItemsSource="{Binding CurrentInputModel.PileGroupSettlement.SettlementSoilLayers, Mode=TwoWay,
                                            UpdateSourceTrigger=LostFocus}"
                                            HorizontalAlignment="Left"
                                            AutoGenerateColumns="False"
                                            CanUserAddRows="False"
                                            CanUserSortColumns="False"  
                                            VerticalScrollBarVisibility="Auto"
                                            HorizontalScrollBarVisibility="Auto" 
                                            LoadingRow="DataGrid_LoadingRow_Numbering"
                                            CellEditEnding="DataGridSettlementSoilLayers_CellEditEnding">

                                            <common:EnhancedDataGrid.AlternatingRowBackground>
                                                <ImageBrush/>
                                            </common:EnhancedDataGrid.AlternatingRowBackground>
                                            <common:EnhancedDataGrid.Style>
                                                <Style/>
                                            </common:EnhancedDataGrid.Style>

                                            <!--<common:EnhancedDataGrid.ContextMenu>
                                                <ContextMenu Opened="ContextMenu_Opened">
                                                    <MenuItem Click="ExportCsvFromContextMenu_Click">
                                                        <MenuItem.Icon>
                                                            <svgc:SvgViewbox Source="/Icons/CSVFileOutput.svg" Style="{StaticResource SvgIconStyle}"/>
                                                        </MenuItem.Icon>
                                                        <MenuItem.Header>
                                                            <TextBlock Text="CSVファイル出力"/>
                                                        </MenuItem.Header>
                                                    </MenuItem>

                                                    <MenuItem Header="コピー" Command="{Binding CopyDataGridSelectionCommand}" CommandParameter="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>

                                                </ContextMenu>
                                            </common:EnhancedDataGrid.ContextMenu>-->

                                            <common:EnhancedDataGrid.ContextMenu>
                                                <StaticResource ResourceKey="CommonDataGridContextMenu"/>
                                            </common:EnhancedDataGrid.ContextMenu>

                                            <common:EnhancedDataGrid.ColumnHeaderStyle>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                    <Setter Property="Foreground" Value="#62B0E2" />
                                                </Style>
                                            </common:EnhancedDataGrid.ColumnHeaderStyle>

                                            <common:EnhancedDataGrid.Columns>

                                                <DataGridTemplateColumn Width="*" Header="削除" MinWidth="50">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button
                                                                x:Name="ButtonRectLoadDelete"
                                                                Content="削除"
                                                                Tag="{Binding}"
                                                                Command="{Binding DataContext.DeleteSettlementSoilLayerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTextColumn Binding="{Binding BottomAltitude, StringFormat={}{0:+0.00;-0.00;+0.00}, Mode=TwoWay,
                                                        UpdateSourceTrigger=LostFocus}"
                                                        Width="*"  ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="60" >
                                                    <DataGridTextColumn.Header>
                                                        <StackPanel>
                                                            <TextBlock Text="下端Z"   TextAlignment="Center" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="(m)"  TextAlignment="Center" HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Binding="{Binding Thickness, StringFormat=N3,
                                                        UpdateSourceTrigger=LostFocus}"
                                                        Width="*"  
                                                        ElementStyle="{StaticResource RightAlignedTextBlockStyle}" 
                                                        MinWidth="60" 
                                                        IsReadOnly="true"
                                                        Foreground="Gray">
                                                    <DataGridTextColumn.Header>
                                                        <StackPanel>
                                                            <TextBlock Text="厚さ"   TextAlignment="Center" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="(m)"  TextAlignment="Center" HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Binding="{Binding Ek, StringFormat=N0, Mode=TwoWay,
                                                UpdateSourceTrigger=LostFocus}"
                                                                Width="*"  ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="60" >
                                                    <DataGridTextColumn.Header>
                                                        <StackPanel>
                                                            <TextBlock Text="変形係数"   TextAlignment="Center" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="Esk" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                            <TextBlock TextAlignment="Center" HorizontalAlignment="Center"><Run Text="(kN/m"/><Run Text="3" BaselineAlignment="Superscript" FontSize="9"/><Run Text=")"/></TextBlock>
                                                        </StackPanel>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Binding="{Binding PoissonsRatio, StringFormat=N2, Mode=TwoWay,
                                                UpdateSourceTrigger=LostFocus}"
                                                                Width="*"  ElementStyle="{StaticResource RightAlignedTextBlockStyle}" MinWidth="60" >
                                                    <DataGridTextColumn.Header>
                                                        <StackPanel>
                                                            <TextBlock Text="ポアソン比"   TextAlignment="Center" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="νsk" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Binding="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                Width="2*" MinWidth="100"
                                                                ElementStyle="{StaticResource CenterAlignedTextBlockStyle}">
                                                    <DataGridTextColumn.Header>
                                                        <StackPanel>
                                                            <TextBlock Text="備考" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                            </common:EnhancedDataGrid.Columns>
                                        </common:EnhancedDataGrid>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Grid.Row="3">
                                        <Button Content="群杭即時沈下解析実行" Width="200" Command="{Binding PileGroupSettlementAnalysisCommand}"/>
                                    </StackPanel>
                                </Grid>
                            </avalonDock:LayoutDocument>

                            <avalonDock:LayoutDocument Title="杭沈下"
                                                       CanClose="False"
                                                       x:Name="PileSettlementDocument">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <common:EnhancedDataGrid x:Name="DataGridPileSettlement"
