                                                    </MenuItem.Icon>
                                                    <MenuItem.Header>
                                                        <TextBlock Text="CSVファイル出力"/>
                                                    </MenuItem.Header>

                                                    <MenuItem Header="コピー" Command="{Binding CopyDataGridSelectionCommand}" CommandParameter="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>

                                                </MenuItem>
                                            </ContextMenu>
                                        </common:EnhancedDataGrid.ContextMenu>-->

                                        <common:EnhancedDataGrid.ContextMenu>
                                            <StaticResource ResourceKey="CommonDataGridContextMenu"/>
                                        </common:EnhancedDataGrid.ContextMenu>

                                        <common:EnhancedDataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                <Setter Property="Foreground" Value="#62B0E2" />
                                            </Style>
                                        </common:EnhancedDataGrid.ColumnHeaderStyle>
                                        <common:EnhancedDataGrid.Columns>

                                            <DataGridTextColumn Width="*" IsReadOnly="True"
                                                                Binding="{Binding X, StringFormat=N3}"
                                                                ElementStyle="{StaticResource RightAlignedTextBlockStyle}" Foreground="Gray" MinWidth="50">
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="X" TextAlignment="Center"/>
                                                        <TextBlock Text="(m)" TextAlignment="Center"
                                                                   HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn  Width="*" IsReadOnly="True" Binding="{Binding Y, StringFormat=N3}"
                                                                 ElementStyle="{StaticResource RightAlignedTextBlockStyle}" Foreground="Gray" MinWidth="50">
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="Y" TextAlignment="Center"/>
                                                        <TextBlock Text="(m)" TextAlignment="Center"
                                                                   HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Width="*" IsReadOnly="True" Binding="{Binding GroupPileSettlement, StringFormat=N3}"
                                                                ElementStyle="{StaticResource RightAlignedTextBlockStyle}" Foreground="Gray" MinWidth="50">
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="群杭沈下" TextAlignment="Center"/>
                                                        <TextBlock Text="(mm)" TextAlignment="Center"
                                                                   HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                        </common:EnhancedDataGrid.Columns>
                                    </common:EnhancedDataGrid>
                                </Grid>
                            </avalonDock:LayoutDocument>
                        </avalonDock:LayoutDocumentPane>
                    </avalonDock:LayoutDocumentPaneGroup>
                </avalonDock:LayoutPanel>
            </avalonDock:LayoutRoot>
        </avalonDock:DockingManager>
    </Grid>
</Window>
