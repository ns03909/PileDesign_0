                                            AutoGenerateColumns="False"
                                            CanUserAddRows="False"
                                            CanUserSortColumns="False"
                                            LoadingRow="DataGridPileSettlement_LoadingRow_Numbering"
                                            CellEditEnding="DataGridPileSettlement_CellEditEnding"
                                            MouseRightButtonDown="DataGridPileSettlement_MouseRightButtonDown"
                                            AutoGeneratingColumn="DataGridPileSettlement_AutoGeneratingColumn"
                                            FrozenColumnCount="2"
                                            Grid.Row="1"
                                            VerticalAlignment="Top"
                                              CellStyle="{StaticResource CustomDataGridCellStyle}"
                                            common:DataGridNavigationBehavior.Enable="True">

                                        <common:EnhancedDataGrid.AlternatingRowBackground>
                                            <ImageBrush/>
                                        </common:EnhancedDataGrid.AlternatingRowBackground>
                                        <common:EnhancedDataGrid.Style>
                                            <Style/>
                                        </common:EnhancedDataGrid.Style>

                                        <!--<common:EnhancedDataGrid.ContextMenu>
                                            <ContextMenu Opened="ContextMenu_Opened">
                                                <MenuItem Click="ExportCsvFromContextMenu_Click">
                                                    <MenuItem.Icon>
