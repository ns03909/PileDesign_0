<Window x:Class="PileDesign.Views.ResultDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="clr-namespace:PileDesign.Common"
        Title="解析結果ダッシュボード"
        Width="540" SizeToContent="Height"
        MinHeight="200"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        common:EscapeKeyBehavior.Enable="True">
    <Window.Resources>
        <!-- カードコンテナ -->
        <Style x:Key="DashCardStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="DashSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryAccentBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="DashLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <Style x:Key="DashValueStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <Style x:Key="DashOkStyle" TargetType="TextBlock" BasedOn="{StaticResource DashValueStyle}">
            <Setter Property="Foreground" Value="{StaticResource NikkenGreenBrush}"/>
        </Style>

        <Style x:Key="DashWarnStyle" TargetType="TextBlock" BasedOn="{StaticResource DashValueStyle}">
            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
        </Style>

        <Style x:Key="DashMutedStyle" TargetType="TextBlock" BasedOn="{StaticResource DashValueStyle}">
            <Setter Property="Foreground" Value="#999"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="解析結果ダッシュボード" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryAccentBrush}"/>
            <TextBlock Grid.Column="1" x:Name="LastUpdateText" Text="" Foreground="#888" FontSize="11"
                       VerticalAlignment="Center"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- ▍解析モデル -->
                <Border Style="{StaticResource DashCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource DashSectionTitleStyle}" Text="解析モデル"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DashLabelStyle}" Text="杭本数"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource DashValueStyle}" x:Name="PileCountText"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource DashLabelStyle}" Text="一般節点数"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource DashValueStyle}" x:Name="InputNodeCountText"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource DashLabelStyle}" Text="FEM 節点数"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource DashValueStyle}" x:Name="FemNodeCountText"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource DashLabelStyle}" Text="FEM 要素数"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource DashValueStyle}" x:Name="FemBeamCountText"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ▍水平解析 -->
                <Border Style="{StaticResource DashCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource DashSectionTitleStyle}" Text="水平解析"/>
                        <Grid x:Name="HorizontalAnalysisGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DashLabelStyle}" Text="状態"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="HorizontalStatusText"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource DashLabelStyle}" Text="ケース数"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource DashValueStyle}" x:Name="HorizontalCaseCountText"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource DashLabelStyle}" Text="総ステップ"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource DashValueStyle}" x:Name="HorizontalStepCountText"/>

                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource DashLabelStyle}" Text="平均反復"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource DashValueStyle}" x:Name="HorizontalAvgIterText"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource DashLabelStyle}" Text="最大反復"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource DashValueStyle}" x:Name="HorizontalMaxIterText"/>

                            <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource DashLabelStyle}" Text="最悪残差"/>
                            <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource DashValueStyle}" x:Name="HorizontalWorstResidualText"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource DashLabelStyle}" Text="代表変位 (m)"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource DashValueStyle}" x:Name="HorizontalMaxDispText"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ▍沈下解析 -->
                <Border Style="{StaticResource DashCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource DashSectionTitleStyle}" Text="沈下解析"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource DashLabelStyle}" Text="状態"/>
                            <TextBlock Grid.Column="1" x:Name="SettlementStatusText"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ▍基礎梁考慮鉛直解析 -->
                <Border Style="{StaticResource DashCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource DashSectionTitleStyle}" Text="基礎梁考慮鉛直解析"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource DashLabelStyle}" Text="状態"/>
                            <TextBlock Grid.Column="1" x:Name="VerticalBeamStatusText"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource DashLabelStyle}" Text="ケース数"/>
                            <TextBlock Grid.Column="3" Style="{StaticResource DashValueStyle}" x:Name="VerticalBeamCaseCountText"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ▍ファイル -->
                <Border Style="{StaticResource DashCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource DashSectionTitleStyle}" Text="ファイル"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DashLabelStyle}" Text="現在のファイル"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource DashValueStyle}" x:Name="CurrentFileText"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource DashLabelStyle}" Text="最終解析"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource DashValueStyle}" x:Name="LastAnalysisText"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- フッター -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="再計算(_R)" Click="RefreshButton_Click" Padding="12,4" Margin="0,0,8,0"
                    ToolTip="ダッシュボードを再計算します (Alt+R)"/>
            <Button Grid.Column="2" Content="閉じる(_C)" IsCancel="True" Padding="12,4"
                    ToolTip="ウィンドウを閉じます (Esc / Alt+C)"/>
        </Grid>
    </Grid>
</Window>
