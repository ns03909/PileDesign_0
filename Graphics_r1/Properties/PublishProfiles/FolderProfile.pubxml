<?xml version="1.0" encoding="utf-8"?>
<!-- https://go.microsoft.com/fwlink/?LinkID=208121. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <!-- 発行先はプロジェクトからの相対 (どの PC・どの置き場所に取り出しても同じ場所に出る)。
         tools/release-check.ps1 もここを読んで発行した exe を探す。 -->
    <PublishDir>bin\Release\net10.0-windows10.0.19041.0\publish\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <!-- 発行の前に発行先を空にする (Visual Studio の「既存のファイルをすべて削除する」)。前の発行の残りを配らない -->
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- win-x86 (32-bit) は 2GB メモリ上限のため、大規模モデル + 並列ケース実行 (8 並列) で
         AnaModel.MapOnKmat の Sparse 行列構築中に OutOfMemoryException が出る。
         win-x64 (64-bit) なら 4GB 超のヒープを使えるため安全。 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- ネイティブ DLL (WPF の wpfgfx_cor3.dll・SkiaSharp・WebView2Loader など) は exe に入れず、横に置く。
         IncludeNativeLibrariesForSelfExtract=true にすると exe に入り、版ごとの初回起動で %TEMP%\.net へ取り出す
         (版ごとに 30 MB 溜まる・一時フォルダーに書けない PC で起動できない)。しかも exe の横に置くはずの
         MicrosoftEdgeWebview2Setup.exe まで exe に入り、WebView2RuntimeChecker が見つけられなくなる
         (1.0.38-beta の発行物がそうなっていた)。.NET 10 でも横に置く形で起動の確認 (self-check) は通る (2026-10-25)。 -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>