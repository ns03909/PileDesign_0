<?xml version="1.0" encoding="utf-8"?>
<!-- https://go.microsoft.com/fwlink/?LinkID=208121. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <!-- 発行先はプロジェクトからの相対 (どの PC・どの置き場所に取り出しても同じ場所に出る)。
         tools/release-check.ps1 もここを読んで発行した exe を探す。 -->
    <PublishDir>bin\Release\net10.0-windows10.0.19041.0\publish\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- win-x86 (32-bit) は 2GB メモリ上限のため、大規模モデル + 並列ケース実行 (8 並列) で
         AnaModel.MapOnKmat の Sparse 行列構築中に OutOfMemoryException が出る。
         win-x64 (64-bit) なら 4GB 超のヒープを使えるため安全。 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- .NET 10 からは WPF のネイティブ DLL (wpfgfx_cor3.dll など) が exe の中に入り、横に出なくなった。
         そのままでは起動直後に DllNotFoundException で落ちる (ビルドと全体テストでは見えない)。
         初回起動時に一時フォルダーへ取り出させる。release-check の self-check で確かめること (2026-10-25)。 -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>